; Iterative Fibonacci mod 1_000_000_007 — tight integer loop, no overflow.
(defn fibmod [n :- i64 m :- i64] :- i64
  (loop [a :- i64 0 b :- i64 1 i :- i64 0]
    (if (>= i n)
      b
      (let [s (+ a b)]
        (recur b (if (>= s m) (- s m) s) (+ i 1))))))

(defn main [] :- i32
  (do (print-i64 (fibmod 100000000 1000000007)) 0))
