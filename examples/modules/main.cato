; main.cato — Phase 19 reference program: namespaces & require.
;
; (ns my.app) declares this file's namespace; (require [...] :as m)
; loads geom.cato relative to this file and exposes its defns as m/name.

(ns my.app)
(require ["geom.cato" :as m])

(defn main [] :- i64
  (do
    (print-i64 (m/square 7))         ; 49
    (print-i64 (m/hypot-sq 3 4))     ; 25 (uses geom's own square)
    (print-i64 (m/square (m/square 2))))) ; 16
