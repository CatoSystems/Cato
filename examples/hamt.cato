; hamt.cato — Phase 15 reference program: persistent HAMT maps.
; Small maps stay flat sorted arrays; assoc beyond the 8-entry budget
; converts to a 16-way persistent hash trie with structural sharing.

(defn main []
  (let [m0 {1 10}
        m1 (assoc m0 2 100)
        m2 (assoc m1 3 200)
        m3 (assoc m2 4 300)
        m4 (assoc m3 5 400)
        m5 (assoc m4 6 500)
        m6 (assoc m5 7 600)
        m7 (assoc m6 8 700)
        m8 (assoc m7 9 800)
        m9 (assoc m8 10 900)
        m10 (assoc m9 11 1000)
        m11 (assoc m10 12 1100)
        m12 (assoc m11 13 1200)
        m13 (assoc m12 14 1300)
        m14 (assoc m13 15 1400)
        m15 (assoc m14 16 1500)
        m16 (assoc m15 17 1600)
        m17 (assoc m16 18 1700)
        m18 (assoc m17 19 1800)
        m19 (assoc m18 20 1900)
        m20 (assoc m19 21 2000)
        m21 (assoc m20 22 2100)
        m22 (assoc m21 23 2200)
        m23 (assoc m22 24 2300)
        m24 (assoc m23 25 2400)
        m25 (assoc m24 26 2500)
        m26 (assoc m25 27 2600)
        m27 (assoc m26 28 2700)
        m28 (assoc m27 29 2800)
        m29 (assoc m28 30 2900)
        m30 (assoc m29 31 3000)
        m31 (assoc m30 32 3100)
        m32 (assoc m31 33 3200)
        m33 (assoc m32 34 3300)
        m34 (assoc m33 35 3400)
        m35 (assoc m34 36 3500)
        m36 (assoc m35 37 3600)
        m37 (assoc m36 38 3700)
        m38 (assoc m37 39 3800)
        m39 (assoc m38 40 3900)
        m40 (assoc m39 41 4000)
           ]
    (do
      (print-i64 (get m0 1 0))
      (print-i64 (get m5 6 0))
      (print-i64 (get m20 21 0))
      (print-i64 (get m40 41 0))
      (print-i64 (get m40 999 42))
      (print-i64 (count m40)))))
