;; E301: a loop variable is an owned binding like any other. Handing it to
;; a function that keeps it (here: stores it) ends the binding; reading it
;; again in the same `recur` is a use after move.
(deftype Pair (P [a :- str b :- i64]))
(deftype Hold (H [p :- Pair]))
(defn stash [p :- Pair] :- Hold (H p))
(defn pb [p :- &Pair] :- i64 (match p (P [a b] (count a))))
(defn bad [n :- i64] :- i64
  (loop [i :- i64 0 p :- Pair (P (str "s" 7) 7) k :- i64 0]
    (if (>= i n) k
      (recur (+ i 1) p (+ k (match (stash p) (H [q] (pb p))))))))
(defn main [] :- i64 0)
