;; E301: a moved vector binding is used again. `keep` stores its argument
;; (a parameter that only read it would merely lend it), so the first call
;; hands xs over and the second uses it after the move.
(deftype Box (B [xs :- (Vector i64)]))
(defn keep [xs :- (Vector i64)] :- Box (B xs))
(defn bad [xs :- (Vector i64)] :- i64
  (do (keep xs) (count xs)))
(defn main [] :- i64 0)
