; widths.cato — Phase 9b reference program: narrow integer widths.
;
; i32 is a closed width: arithmetic stays 32-bit (wrapping), mixing with
; i64 requires explicit casts (i32 e) / (i64 e). No silent promotions.

(defn narrow [x :- i64] :- i32 (i32 x))
(defn widen [x :- i32] :- i64 (i64 x))

(defn clamp32 [x :- i32 lo :- i32 hi :- i32] :- i32
  (min (max x lo) hi))

(defn main []
  (print (widen (narrow 7)))              ; 7
  (let [a (i32 10)
        b (i32 3)]
    (print (i64 (* a b)))                 ; 30
    (print (i64 (clamp32 (i32 500) b a))) ; 10
    (print (i64 (abs (i32 -42))))))       ; 42
