(ns cato.cli)

(require ["reader/read.cato" :as read])
(require ["hir/expand.cato" :as expand])
(require ["hir/modules.cato" :as modules])
(require ["lib/ast.cato" :as ast])
(require ["reader/dump.cato" :as rdump])
(require ["hir/lower.cato" :as lower])
(require ["hir/forms.cato" :as forms])
(require ["hir/moveck.cato" :as moveck])
(require ["emit/emit.cato" :as emit])
(require ["lib/args.cato" :as argm])
(require ["lib/driver.cato" :as driver])
(require ["lib/compile.cato" :as compile])

; cli.cato — the kernel entry point (the only `main`).
;
;   cato1 compile <file.cato> [-o out] [options] [-- cc-args...]
;
; read → compile → write IR → spawn cc → native binary. Exit codes match
; the seed: 0 success, 1 compile error or toolchain failure, 2 usage error.
; Diagnostics go to stderr; help and --emit-ir output go to stdout.
; `main` ends in `exit` because a returned value is not the process status.

(defn usage-text [] :- str
  "usage: cato1 compile <file.cato> [-o out] [-O0..3|--opt-level n] [-g] [--asan]
                     [--target T] [--emit-ir] [--emit-ll F] [--cc CC]
                     [--runtime RT] [--rtlib N] [-- cc-args...]
       cato1 help | cato1 --version")

(defn version-text [] :- str "cato1 (kernel)")

(defn main []
  (let [a (args)]
    (exit (dispatch a))))

(defn dispatch [a :- (Vector str)] :- i64
  (let [cmd (get a 0 "")]
    (cond
      (or (= cmd "help") (= cmd "--help") (= cmd "-h")) (do (print-string (usage-text)) 0)
      (or (= cmd "--version") (= cmd "-V")) (do (print-string (version-text)) 0)
      (= cmd "compile") (compile-cmd a)
      (= cmd "build") (do (driver/eprint "'build' was renamed to 'compile' (cato1 compile <file> [-o out])") 2)
      (or (= cmd "format") (= cmd "repl") (= cmd "lsp"))
        (do (driver/eprint (str cmd " is not available in cato1 (use the seed: cato " cmd ")")) 2)
      (= cmd "") (do (usage-err) 2)
      (do (driver/eprint (str "unknown command '" cmd "' (see 'cato1 help')")) 2))))

(defn usage-err [] :- i64
  (driver/eprint (usage-text)))

(defn compile-cmd [a :- (Vector str)] :- i64
  (let [res (argm/parse a)]
    (match res
      (ArgErr [msg] (do (driver/eprint msg) 2))
      (ArgOk [file out cc runtime target opt debug asan emit-ir emit-ll rtlib help rest]
        (compile-one file out cc runtime target opt debug asan emit-ir emit-ll rtlib help rest)))))

(defn compile-one [file :- str out :- str cc :- str runtime :- str target :- str opt :- i64 debug :- i64 asan :- i64 emit-ir :- i64 emit-ll :- str rtlib :- str help :- i64 rest :- (Vector str)] :- i64
  (cond
    (= help 1) (do (print-string (usage-text)) 0)
    (= file "") (do (driver/eprint "compile requires an input file (.cato)") 2)
    (= target "wasm32") (do (driver/eprint "--target wasm32 is not supported by cato1 (use the seed: cato compile --target wasm32)") 2)
    (< (driver/target-index target) 0)
      (do (driver/eprint (str "unknown --target '" target "' (known: " (driver/target-names) ")")) 2)
    (and (= emit-ir 1) (/= emit-ll ""))
      (do (driver/eprint "--emit-ir stops before linking; --emit-ll only applies when linking") 2)
    (not (driver/file-exists file)) (do (driver/eprint (str "no such file " file)) 2)
    (run-compile file out cc runtime (driver/target-index target) opt debug asan emit-ir emit-ll rtlib rest)))

(defn report [file :- str msg :- str line :- i64 col :- i64] :- i64
  (do
    (if (= line 0)
      (driver/eprint (str "error: " file ": " msg))
      (driver/eprint (str "error: " file ":" line ":" (+ col 1) ": " msg)))
    1))

(defn run-compile [file :- str out :- str cc :- str runtime :- str ti :- i64 opt :- i64 debug :- i64 asan :- i64 emit-ir :- i64 emit-ll :- str rtlib :- str rest :- (Vector str)] :- i64
  (match (compile/compile-text file (slurp file))
    (CRErr [msg line col len] (report file msg line col))
    (CROk [ir]
      (if (= emit-ir 1)
        ; --emit-ir: IR to -o, or stdout (the seed's contract).
        (if (= out "")
          (do (print-string ir) 0)
          (do (spit out ir) 0))
        (link ir out cc runtime ti opt debug asan emit-ll rtlib rest file)))))

(defn link [ir :- str out :- str cc :- str runtime :- str ti :- i64 opt :- i64 debug :- i64 asan :- i64 emit-ll :- str rtlib :- str rest :- (Vector str) file :- str] :- i64
  (let [cc (driver/resolve-cc cc)
        rt (driver/resolve-runtime runtime)
        out2 (if (= out "") (driver/default-out ti file) out)
        triple (driver/target-triple ti)]
    (cond
      (not (driver/file-exists rt))
        (do (driver/eprint (str "cannot locate runtime " rt " (pass --runtime or set CATO_RUNTIME)")) 1)
      (and (/= triple "") (not (driver/cc-supports-triple cc triple)))
        (do (driver/eprint (str cc " does not support target " triple " (pass a cross-capable --cc)")) 1)
      ; The IR goes to --emit-ll (kept) or <out>.ll (removed after linking).
      (let [ll (if (= emit-ll "") (str out2 ".ll") emit-ll)]
        (do
          (spit ll ir)
          (let [status (driver/spawn (driver/build-argv ti opt debug asan rtlib rest cc ll rt out2))]
            (do
              (if (= emit-ll "") (driver/remove-file ll) 0)
              (cond
                (= status 0) 0
                (= status 127) (do (driver/eprint (str "cannot run C compiler '" cc "' (pass --cc or set CATO_CC)")) 1)
                (do (driver/eprint (str "link failed: " cc " exited with status " status)) 1)))))))))
