(ns cato.lib.stdlib_ref)
(require ["ast.cato" :as ast])
(require ["sym.cato" :as sym])
(require ["span.cato" :as span])
(require ["strbuf.cato" :as strbuf])
(require ["alist.cato" :as alist])
(require ["result.cato" :as result])

; stdlib_ref.cato — S4 reference driver.
;
; Concatenated after the lib files by the test harness (one namespace);
; this file defines the only `main`. Output is the S4 acceptance artifact:
; interpreter and clang-compiled LLVM must print it byte-identically.
;
; Sections exercise every module: interning (with a duplicate hit), span
; rendering, the string builder, sid-keyed assoc-lists over two value
; types, a hand-built Ast walk, and the Result contract.

; The empty env for the vector-valued section: `(Vector str)` cannot be
; written inside a let ascription (resolve_ann_ty gap), so the nullary
; ctor gets its type from this defn's return annotation.
(defn words-env [] :- (AList (Vector str)) (ALNil))

(defn main []
  (let [st0 (sym/intern-new)
        r1 (sym/intern2 st0 "defn")
        st1 (sym/ires-st (clone r1))
        sid-defn (sym/ires-sid r1)
        r2 (sym/intern2 st1 "let")
        st2 (sym/ires-st (clone r2))
        sid-let (sym/ires-sid r2)
        r3 (sym/intern2 st2 "defn")
        st3 (sym/ires-st (clone r3))
        sid-defn-again (sym/ires-sid r3)
        cnt3 (sym/intern-count (clone st3))
        tab3 (sym/intern-tab (clone st3))
        sp (Span 3 7 4)
        buf0 (strbuf/sb-new)
        buf1 (strbuf/sb-add-line buf0 "cato")
        buf2 (strbuf/sb-add-line buf1 "s4")
        buf3 (strbuf/sb-add buf2 "end")
        env0 :- (AList str) (ALNil)
        env1 (alist/al-put env0 sid-defn "defn-key")
        env2 (alist/al-put env1 sid-let "let-key")
        kids (ast/ast-cons (ast/ast-int 42 2 8)
               (ast/ast-cons (ast/ast-str "hi" 2 12)
               (ast/ast-cons (ast/ast-sym sid-defn-again 2 16) (KNil))))
        tree (ast/ast-list (clone kids) 2 2)
        okr :- (Result i64) (Ok 41)
        errr :- (Result i64) (Err "boom")]
    (do
      (print sid-defn)                              ; 0
      (print sid-let)                               ; 1
      (print sid-defn-again)                        ; 0 (dup hit)
      (print cnt3)                                  ; 2
      (print (sym/intern-find tab3 "let" 1))            ; 1
      (print-string (sym/sym-name (clone st3) sid-let)) ; let
      (print-string (span/sp-str (clone sp)))           ; 3:7+4
      (print (span/sp-len (clone sp)))                   ; 4
      (print (strbuf/sb-count (clone buf3)))               ; 5
      (print (strbuf/sb-len (clone buf3)))                 ; 11
      (print (count (strbuf/sb-str (clone buf3))))         ; 11
      (print-string (strbuf/sb-str (clone buf3)))          ; cato \n s4 \n end
      (print (alist/al-depth (clone env2)))               ; 2
      (print-string (alist/al-get (clone env2) sid-let "?"))  ; let-key
      (print-string (alist/al-get (clone env2) 99 "?"))       ; ?
      (print (alist/al-has (clone env2) sid-defn))        ; 1
      (let [envW (words-env)
            words (alist/al-put envW 7 (split "kernel,words" ","))
            ws (alist/al-get (clone words) 7 (split "," ","))]
        (do
          (print (alist/al-depth (clone words)))          ; 1
          (print (count (clone ws)))                ; 2
          (print-string (join "-" ws))))           ; kernel-words
      (print (ast/ast-count (clone tree)))              ; 4 (list + 3 kids)
      (print (ast/ast-tag tree))                ; 5
      (print (ast/ast-child-count (clone tree)))        ; 3
      (print (ast/ast-tag (ast/asts-first kids)))   ; 2 (int)
      (print (result/unwrap-or (clone okr) -1))                    ; 41
      (print (result/unwrap-or (clone errr) -1))                   ; -1
      (print (if (result/is-ok okr) 1 0))                  ; 1
      (print-string (result/err-msg errr)))))
