; sym.cato — S4: symbol interning.
;
; str -> i64 sid over a (Vector str) table. Cato has no globals, so the
; intern table is explicit state threaded through calls: `intern2` returns
; the updated state alongside the sid, and callers keep threading one
; value. Sids are table indices; the scan is linear from the top — kernel
; tables are small, and first-match-wins matches the reader's needs.

(deftype Intern (I [tab :- (Vector str) next :- i64]))

; Two results in one value: the updated state to keep threading and the
; sid the string resolved to.
(deftype IRes (IRes [st :- Intern sid :- i64]))

(defn intern-new [] :- Intern (I [] 0))

(defn intern-tab [st :- Intern] :- (Vector str)
  (match st
    (I [tab next] (clone tab))))

(defn intern-count [st :- Intern] :- i64
  (match st
    (I [tab next] (count tab))))

; Back-to-front scan; `i` is the next index to test. Misses report -1.
(defn intern-find [tab :- (Vector str) s :- str i :- i64] :- i64
  (if (< i 0)
    -1
    (if (= (get tab i "") s)
      i
      (intern-find tab s (- i 1)))))

(defn intern2 [st :- Intern s :- str] :- IRes
  (let [tab (intern-tab (clone st))
        n (count tab)
        sid (intern-find (clone tab) s (- n 1))]
    (if (< sid 0)
      (IRes (I (conj tab s) (+ 1 n)) n)
      (IRes st sid))))

; Str results are caller-freed, so return an owned copy of the element.
(defn sym-name [st :- Intern sid :- i64] :- str
  (match st
    (I [tab next] (clone (get tab sid "")))))

; IRes accessors: callers clone the result they still hold — a match
; consumes its scrutinee, so reading both fields means two clones.
(defn ires-st [r :- IRes] :- Intern
  (match r
    (IRes [st sid] (clone st))))

(defn ires-sid [r :- IRes] :- i64
  (match r
    (IRes [st sid] sid)))
