(ns cato.emit.emit)
(require ["../hir/forms.cato" :as forms])
(require ["state.cato" :as state])
(require ["../lib/strbuf.cato" :as strbuf])
(require ["../hir/types.cato" :as types])
(require ["scalars.cato" :as scalars])
(require ["../hir/hexpr.cato" :as hexpr])
(require ["heap.cato" :as heap])
(require ["adt.cato" :as adt])
(require ["closures.cato" :as closures])

; emit.cato — S7: module assembly — the port of the seed emitter's
; mod.rs + funcs.rs + the adt.rs glue generators. Output shape: header,
; %VecI64/%Closure/ADT types, the deduplicated declare chain (fixed
; runtime declares are seeded before emission), literal globals,
; clone/drop glue, plain defns (main keeps the i32 ABI with argv
; plumbing), extern declares, lambda bodies + their drop glue.

(defn facts-owns-of [adts :- AdtTab] :- Sids
  (match
    (forms/facts-compute adts)
    (Facts [owns] owns)))

(defn md-seed-decls [m :- Mdl] :- Mdl
  (
    state/md-decl
    (
      state/md-decl
      (
        state/md-decl
        (
          state/md-decl
          (
            state/md-decl
            (
              state/md-decl
              (
                state/md-decl
                (
                  state/md-decl
                  (
                    state/md-decl
                    (
                      state/md-decl
                      (
                        state/md-decl
                        (
                          state/md-decl
                          (
                            state/md-decl
                            (
                              state/md-decl
                              (
                                state/md-decl
                                (state/md-decl m "declare void @cato_args_init(i32, ptr)")
                                "declare ptr @cato_args(ptr)"
                              )
                              "declare ptr @malloc(i64)"
                            )
                            "declare void @free(ptr)"
                          )
                          "declare ptr @strdup(ptr)"
                        )
                        "declare ptr @cato_str_vec_copy(ptr, i64, i64)"
                      )
                      "declare void @cato_str_vec_free(ptr, i64)"
                    )
                    "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1, i1)"
                  )
                  "declare i64 @strlen(ptr)"
                )
                "declare i32 @strcmp(ptr, ptr)"
              )
              "declare void @cato_print_f64(double)"
            )
            "declare void @cato_print_i64(i64)"
          )
          "declare void @cato_print_string(ptr)"
        )
        "declare void @cato_print_str_raw(ptr)"
      )
      "declare ptr @cato_slurp(ptr)"
    )
    "declare void @cato_spit(ptr, ptr)"
  ))

(defn md-globals [m :- &Mdl] :- StrBuf
  (match m (Mdl [tab g globals decls adts owns csigs] (clone globals))))

(defn adt-name-at [adts :- AdtTab i :- i64 tab :- i64] :- str
  (match
    (forms/adts-at adts i)
    (AdtInfo [name tps variants tpl tplargs] (forms/sym-str (clone tab) name))))

(defn adt-type-lines [adts :- AdtTab owns :- Sids i :- i64 tab :- i64 sb :- StrBuf] :- StrBuf
  (if
    (>= i (forms/adts-depth adts))
    sb
    (let [nm (adt-name-at (clone adts) i (clone (clone tab))) n (state/fs-total adts owns i)]
      (
        adt-type-lines
        adts
        owns
        (+ i 1)
        tab
        (strbuf/sb-add-line sb (str "%" nm " = type { i64, [" n " x i64] }"))
      ))))

(defn adt-glue [adts :- AdtTab owns :- Sids i :- i64 tab :- i64 sb :- StrBuf] :- StrBuf
  (if
    (>= i (forms/adts-depth adts))
    sb
    (let [sb1
      (if
        (= (types/sids-idx owns i) 1)
        (
          strbuf/sb-add-line
          (
            strbuf/sb-add-line
            (
              strbuf/sb-add-line
              (
                strbuf/sb-add-line
                sb
                (adt-clone-text (clone adts) (clone owns) i (clone (clone tab)))
              )
              (adt-drop-text (clone adts) (clone owns) i (clone (clone tab)))
            )
            ""
          )
          ""
        )
        sb)]
      (adt-glue adts owns (+ i 1) (clone tab) sb1))))

(defn glue-switch [adts :- AdtTab i :- i64 vi :- i64 dflt :- str] :- str
  (if
    (>= vi (forms/vlist-depth (forms/adts-variants-at adts i)))
    (if
      (> vi 0)
      (str "  ]\n")
      "")
    (
      str
      (if
        (= vi 0)
        (str "  switch i64 %tag, label %" dflt " [\n")
        "")
      "    i64 "
      vi
      ", label %v"
      vi
      "\n"
      (glue-switch adts i (+ vi 1) dflt)
    )))

(defn adt-clone-text [adts :- AdtTab owns :- Sids i :- i64 tab :- i64] :- str
  (let [nm (adt-name-at (clone adts) i (clone (clone tab)))
    slots (state/fs-total adts owns i)
    nv (forms/vlist-depth (forms/adts-variants-at adts i))]
    (
      str
      "define ptr @clone__"
      nm
      "(ptr %src) {\n"
      "entry:\n"
      "  %box = call ptr @malloc(i64 "
      (* 8 (+ slots 1))
      ")\n"
      "  %tag = load i64, ptr %src\n"
      "  store i64 %tag, ptr %box\n"
      (glue-switch (clone adts) i 0 "merge")
      (if
        (> nv 0)
        "bad:\n  unreachable\n\n"
        "")
      (adt-clone-variants adts owns i 0 (clone (clone tab)))
      "merge:\n  ret ptr %box\n}\n"
    )))

(defn adt-clone-variants [adts :- AdtTab owns :- Sids i :- i64 vi :- i64 tab :- i64] :- str
  (if
    (>= vi (forms/vlist-depth (forms/adts-variants-at adts i)))
    ""
    (
      str
      "v"
      vi
      ":\n"
      (adt-clone-fields (clone adts) (clone owns) i vi 0 0 (clone tab) "")
      "  br label %merge\n\n"
      (adt-clone-variants adts owns i (+ vi 1) (clone tab))
    )))

(defn adt-clone-fields [adts :- AdtTab
  owns :- Sids
  i :- i64
  vi :- i64
  k :- i64
  serial :- i64
  tab :- i64
  acc :- str
] :- str
  (if
    (>= k (types/tys-depth (forms/varnt-fields-at adts i vi)))
    acc
    (let [fty (state/fs-field-ty adts i vi k)
      off (state/fs-off adts owns i vi k)
      nm (adt-name-at (clone adts) i (clone tab))
      tg (types/ty-tag fty)]
      (
        adt-clone-fields
        (clone adts)
        (clone owns)
        i
        vi
        (+ k 1)
        (+ serial 1)
        (clone tab)
        (str acc (clone-field-text fty off nm adts owns vi serial tg (clone tab)))
      ))))

(defn clone-field-text [fty :- Ty
  off :- i64
  nm :- str
  adts :- AdtTab
  owns :- Sids
  vi :- i64
  serial :- i64
  tg :- i64
  tab :- i64
] :- str
  (let [u (str "v" vi "f" serial)]
    (cond
      (= tg 12)
      (
        str
        "  %sp"
        u
        " = getelementptr inbounds %"
        nm
        ", ptr %src, i32 0, i32 1, i32 "
        off
        "\n"
        "  %sl"
        u
        " = load i64, ptr %sp"
        u
        "\n"
        "  %sptr"
        u
        " = inttoptr i64 %sl"
        u
        " to ptr\n"
        "  %sdup"
        u
        " = call ptr @strdup(ptr %sptr"
        u
        ")\n"
        "  %dp"
        u
        " = getelementptr inbounds %"
        nm
        ", ptr %box, i32 0, i32 1, i32 "
        off
        "\n"
        "  %ni"
        u
        " = ptrtoint ptr %sdup"
        u
        " to i64\n"
        "  store i64 %ni"
        u
        ", ptr %dp"
        u
        "\n"
      )
      (= tg 15)
      (let [el (types/ty-arg fty)
        cp
        (if
          (= el 2)
          (
            str
            "  %vcp"
            u
            " = call ptr @cato_str_vec_copy(ptr %vptr"
            u
            ", i64 %vl"
            u
            "k1, i64 %vl"
            u
            "k2)\n"
          )
          (
            str
            "  %vnb"
            u
            " = mul i64 %vl"
            u
            "k2, 8\n"
            "  %vcp"
            u
            " = call ptr @malloc(i64 %vnb"
            u
            ")\n"
            "  %vcb"
            u
            " = mul i64 %vl"
            u
            "k1, 8\n"
            "  call void @llvm.memcpy.p0.p0.i64(ptr %vcp"
            u
            ", ptr %vptr"
            u
            ", i64 %vcb"
            u
            ", i1 false, i1 false)\n"
          ))]
        (
          str
          "  %vp"
          u
          " = getelementptr inbounds %"
          nm
          ", ptr %src, i32 0, i32 1, i32 "
          off
          "\n"
          "  %vl"
          u
          "k0 = load i64, ptr %vp"
          u
          "\n"
          "  %vf"
          u
          "k1 = getelementptr inbounds %"
          nm
          ", ptr %src, i32 0, i32 1, i32 "
          (+ off 1)
          "\n"
          "  %vl"
          u
          "k1 = load i64, ptr %vf"
          u
          "k1\n"
          "  %vf"
          u
          "k2 = getelementptr inbounds %"
          nm
          ", ptr %src, i32 0, i32 1, i32 "
          (+ off 2)
          "\n"
          "  %vl"
          u
          "k2 = load i64, ptr %vf"
          u
          "k2\n"
          "  %vptr"
          u
          " = inttoptr i64 %vl"
          u
          "k0 to ptr\n"
          cp
          "  %vd"
          u
          "k0 = getelementptr inbounds %"
          nm
          ", ptr %box, i32 0, i32 1, i32 "
          off
          "\n"
          "  %vni"
          u
          "k0 = ptrtoint ptr %vcp"
          u
          " to i64\n"
          "  store i64 %vni"
          u
          "k0, ptr %vd"
          u
          "k0\n"
          "  %vd"
          u
          "k1 = getelementptr inbounds %"
          nm
          ", ptr %box, i32 0, i32 1, i32 "
          (+ off 1)
          "\n"
          "  store i64 %vl"
          u
          "k1, ptr %vd"
          u
          "k1\n"
          "  %vd"
          u
          "k2 = getelementptr inbounds %"
          nm
          ", ptr %box, i32 0, i32 1, i32 "
          (+ off 2)
          "\n"
          "  store i64 %vl"
          u
          "k2, ptr %vd"
          u
          "k2\n"
        ))
      (= tg 16)
      (let [j (types/ty-arg fty)]
        (if
          (= (types/sids-idx owns j) 1)
          (let [child (adt-name-at (clone adts) j (clone tab))]
            (
              str
              "  %sp"
              u
              " = getelementptr inbounds %"
              nm
              ", ptr %src, i32 0, i32 1, i32 "
              off
              "\n"
              "  %sl"
              u
              " = load i64, ptr %sp"
              u
              "\n"
              "  %sc"
              u
              " = inttoptr i64 %sl"
              u
              " to ptr\n"
              "  %nc"
              u
              " = call ptr @clone__"
              child
              "(ptr %sc"
              u
              ")\n"
              "  %dp"
              u
              " = getelementptr inbounds %"
              nm
              ", ptr %box, i32 0, i32 1, i32 "
              off
              "\n"
              "  %ni"
              u
              " = ptrtoint ptr %nc"
              u
              " to i64\n"
              "  store i64 %ni"
              u
              ", ptr %dp"
              u
              "\n"
            ))
          (adt-clone-words nm off (state/fs-count (clone fty) owns adts) u)))
      (adt-clone-words nm off (state/fs-count fty owns adts) u))))

(defn adt-clone-words [nm :- str off :- i64 cnt :- i64 u :- str] :- str
  (if
    (= cnt 0)
    ""
    (
      str
      "  %sp"
      u
      "k"
      (- cnt 1)
      " = getelementptr inbounds %"
      nm
      ", ptr %src, i32 0, i32 1, i32 "
      (+ off (- cnt 1))
      "\n"
      "  %sl"
      u
      "k"
      (- cnt 1)
      " = load i64, ptr %sp"
      u
      "k"
      (- cnt 1)
      "\n"
      "  %dp"
      u
      "k"
      (- cnt 1)
      " = getelementptr inbounds %"
      nm
      ", ptr %box, i32 0, i32 1, i32 "
      (+ off (- cnt 1))
      "\n"
      "  store i64 %sl"
      u
      "k"
      (- cnt 1)
      ", ptr %dp"
      u
      "k"
      (- cnt 1)
      "\n"
      (adt-clone-words nm off (- cnt 1) u)
    )))

(defn adt-drop-text [adts :- AdtTab owns :- Sids i :- i64 tab :- i64] :- str
  (let [nm
    (adt-name-at (clone adts) i (clone tab))
    ; A nulled slot (an arm-exit free skipping a transferred child, or
    ; a child that was never set) is simply not ours to free: the
    ; boxed glue guards the entry. Inline storage is never null.
    head
    (if
      (= (types/sids-idx owns i) 1)
      (
        str
        "entry:\n"
        "  %nz = icmp ne ptr %src, null\n"
        "  br i1 %nz, label %live, label %nul\n"
        "nul:\n  ret void\n\n"
        "live:\n"
      )
      "entry:\n")
  ]
    (
      str
      "define void @drop__"
      nm
      "(ptr %src) {\n"
      head
      "  %tag = load i64, ptr %src\n"
      (glue-switch (clone adts) i 0 "bad")
      "bad:\n  unreachable\n\n"
      (adt-drop-variants adts owns i 0 (clone tab))
      "freebox:\n  call void @free(ptr %src)\n  ret void\n"
      "done:\n  ret void\n"
      "}\n"
    )))

(defn adt-drop-variants [adts :- AdtTab owns :- Sids i :- i64 vi :- i64 tab :- i64] :- str
  (if
    (>= vi (forms/vlist-depth (forms/adts-variants-at adts i)))
    ""
    (let [tail
      (if
        (> (forms/vlist-depth (forms/adts-variants-at adts i)) 0)
        "freebox"
        "done")]
      (
        str
        "v"
        vi
        ":\n"
        (adt-drop-fields (clone adts) (clone owns) i vi 0 0 (clone tab) "")
        "  br label %"
        tail
        "\n\n"
        (adt-drop-variants adts owns i (+ vi 1) (clone tab))
      ))))

(defn adt-drop-fields [adts :- AdtTab
  owns :- Sids
  i :- i64
  vi :- i64
  k :- i64
  serial :- i64
  tab :- i64
  acc :- str
] :- str
  (if
    (>= k (types/tys-depth (forms/varnt-fields-at adts i vi)))
    acc
    (let [fty (state/fs-field-ty adts i vi k)
      off (state/fs-off adts owns i vi k)
      nm (adt-name-at (clone adts) i (clone tab))
      tg (types/ty-tag fty)]
      (
        adt-drop-fields
        (clone adts)
        (clone owns)
        i
        vi
        (+ k 1)
        (+ serial 1)
        (clone tab)
        (str acc (drop-field-text fty off nm adts owns vi serial tg (clone tab)))
      ))))

(defn drop-field-text [fty :- Ty
  off :- i64
  nm :- str
  adts :- AdtTab
  owns :- Sids
  vi :- i64
  serial :- i64
  tg :- i64
  tab :- i64
] :- str
  (let [u (str "v" vi "f" serial)]
    (cond
      (= tg 12)
      (
        str
        "  %fp"
        u
        " = getelementptr inbounds %"
        nm
        ", ptr %src, i32 0, i32 1, i32 "
        off
        "\n"
        "  %fl"
        u
        " = load i64, ptr %fp"
        u
        "\n"
        "  %fv"
        u
        " = inttoptr i64 %fl"
        u
        " to ptr\n"
        "  call void @free(ptr %fv"
        u
        ")\n"
      )
      (= tg 15)
      (let [el (types/ty-arg fty)]
        (
          str
          "  %vp"
          u
          " = getelementptr inbounds %"
          nm
          ", ptr %src, i32 0, i32 1, i32 "
          off
          "\n"
          "  %vl"
          u
          " = load i64, ptr %vp"
          u
          "\n"
          "  %vv"
          u
          " = inttoptr i64 %vl"
          u
          " to ptr\n"
          (if
            (= el 2)
            (
              str
              "  %vn"
              u
              " = getelementptr inbounds %"
              nm
              ", ptr %src, i32 0, i32 1, i32 "
              (+ off 1)
              "\n"
              "  %vc"
              u
              " = load i64, ptr %vn"
              u
              "\n"
              "  call void @cato_str_vec_free(ptr %vv"
              u
              ", i64 %vc"
              u
              ")\n"
            )
            (str "  call void @free(ptr %vv" u ")\n"))
        ))
      (= tg 16)
      (let [j (types/ty-arg fty)]
        (if
          (= (types/sids-idx owns j) 1)
          (let [child (adt-name-at adts j (clone tab))]
            (
              str
              "  %cp"
              u
              " = getelementptr inbounds %"
              nm
              ", ptr %src, i32 0, i32 1, i32 "
              off
              "\n"
              "  %cl"
              u
              " = load i64, ptr %cp"
              u
              "\n"
              "  %cv"
              u
              " = inttoptr i64 %cl"
              u
              " to ptr\n"
              "  call void @drop__"
              child
              "(ptr %cv"
              u
              ")\n"
            ))
          ""))
      "")))

(deftype EOut (EOut [sb :- StrBuf]))
(deftype EORes (EORes [st :- Emit out :- EOut]))

(defn emit-program [adts :- AdtTab defs :- Defns lams :- Lams csigs :- Sigs tab :- i64] :- str
  (do
    (let [owns (facts-owns-of (clone adts))
      sigs (state/sigs-build (clone defs) (ESTNil))
      st0
      (match
        (state/em-new (clone tab) (clone adts) (clone owns) csigs sigs)
        (Emit [c m s] (Emit c (md-seed-decls m) s)))]
      (match
        (emit-defns defs st0 (EOut (strbuf/sb-new)))
        (
          EORes
          [st1 out1]
          (do
            (match
              (emit-lams lams st1 out1)
              (
                EORes
                [st2 out2]
                (do
                  (let [mdl (match st2 (Emit [c m s] m))
                    sb1 (strbuf/sb-add-line (strbuf/sb-new) "; cato: kernel LLVM IR (S7)")
                    sb2 (strbuf/sb-add-line sb1 "%VecI64 = type { ptr, i64, i64 }")
                    sb3 (strbuf/sb-add-line sb2 "%Closure = type { ptr, ptr, ptr }")
                    sb4 (adt-type-lines (clone adts) (clone owns) 0 (clone tab) sb3)
                    sb5 (state/md-decls-lines mdl sb4)
                    sb6 (strbuf/sb-add-line sb5 (strbuf/sb-str (md-globals mdl)))
                    sb7 (adt-glue adts owns 0 (clone tab) sb6)]
                    (do (strbuf/sb-str (strbuf/sb-add-line sb7 (strbuf/sb-str (out2-sb out2)))))))
              )))
        )))))

(defn out2-sb [o :- EOut] :- StrBuf (match o (EOut [sb] sb)))

(defn extern-ret-ll [ret :- Ty] :- str
  (let [tg (types/ty-tag ret)]
    (cond
      (= tg 0)
      "i64"
      (= tg 9)
      "double"
      (= tg 11)
      "i1"
      (= tg 12)
      "ptr"
      (do
        (state/cg-fail-i "extern return must be i64, f64, bool or str")
        "i64"))))

(defn extern-params [params :- PList] :- str
  (match params
    (PNil [] "")
    (
      PCons
      [h t]
      (match h
        (
          Param
          [name ty _pb]
          (let [tg (types/ty-tag ty)]
            (cond
              (= tg 15)
              (extern-params-rest (clone t) "ptr noalias nocapture readonly %data, i64 %len")
              (= tg 9)
              (extern-params-rest (clone t) "double")
              (= tg 11)
              (extern-params-rest (clone t) "i1")
              (= tg 12)
              (extern-params-rest (clone t) "ptr")
              (< tg 12)
              (extern-params-rest t (state/ll-scalar ty))
              (do
                (state/cg-fail-i "extern params must be scalars, strings or vectors")
                "")))
        ))
    )))

(defn extern-params-rest [params :- PList acc :- str] :- str
  (match params
    (PNil [] acc)
    (
      PCons
      [h t]
      (match h
        (
          Param
          [name ty _pb]
          (let [tg (types/ty-tag ty)]
            (cond
              (= tg 15)
              (
                extern-params-rest
                (clone t)
                (str acc ", ptr noalias nocapture readonly %data, i64 %len")
              )
              (= tg 9)
              (extern-params-rest (clone t) (str acc ", double"))
              (= tg 11)
              (extern-params-rest (clone t) (str acc ", i1"))
              (= tg 12)
              (extern-params-rest (clone t) (str acc ", ptr"))
              (< tg 12)
              (extern-params-rest t (str acc ", " (state/ll-scalar ty)))
              (do
                (state/cg-fail-i "extern params must be scalars, strings or vectors")
                acc)))
        ))
    )))

(deftype EDRes (EDRes [st :- Emit text :- str]))
(deftype ELPR (ELPR [mdl :- Mdl text :- str drop-text :- str]))

(defn fn-text [header :- str c :- FnCtx tail :- str] :- str
  (match c
    (
      FnCtx
      [tmpc blkc cur body pre sc ve gr lfr]
      (str header "entry:\n" (strbuf/sb-str pre) (strbuf/sb-str body) tail)
    )))

(defn emit-defns [ds :- Defns st :- Emit out :- EOut] :- EORes
  (match ds
    (DNil [] (EORes st out))
    (
      DCons
      [h t]
      (match h
        (
          Defn
          [name params ret isextern body rb]
          (match st
            (
              Emit
              [c mdl sigs]
              (if
                (= isextern 1)
                ; externs join the deduplicated up-front declares block
                ; (the seed's Vec::contains chain), not the function text.
                (let [line
                  (
                    str
                    "declare "
                    (extern-ret-ll ret)
                    " @"
                    (state/mangle (state/md-sym mdl name))
                    "("
                    (extern-params params)
                    ")"
                  )]
                  (emit-defns t (scalars/em-decl st line) out))
                (match
                  (emit-plain name params (clone ret) body (Emit (state/fn-new) mdl sigs))
                  (
                    EDRes
                    [st2 text]
                    (
                      emit-defns
                      t
                      st2
                      (EOut (strbuf/sb-add-line (strbuf/sb-add-line (out2-sb out) text) ""))
                    )
                  )))
            ))
        ))
    )))

(defn param-scalar [t :- PList pname :- i64 pty :- Ty r :- str ll :- str acc :- str st :- Emit] :- ET2Res
  (let [p2
    (if
      (> (count acc) 0)
      (str acc ", " ll " " r)
      (str acc ll " " r))]
    (match
      (defn-params t (scalars/em-sc-put st pname r pty) p2)
      (ET2Res [st2 acc2 _] (ET2Res st2 acc2 "")))))

(defn defn-params [ps :- PList st :- Emit acc :- str] :- ET2Res
  (match ps
    (PNil [] (ET2Res st acc ""))
    (
      PCons
      [h t]
      (match h
        (
          Param
          [pname pty _pb]
          (match st
            (
              Emit
              [c mdl sigs]
              (let [nstr (state/md-sym mdl pname)
                r (str "%" (state/mangle nstr))
                tg (types/ty-tag pty)]
                (cond
                  (= tg 15)
                  (let [el (types/ty-arg pty)
                    d (str "%" (state/mangle nstr) "_data")
                    l (str "%" (state/mangle nstr) "_len")
                    p2
                    (if
                      (> (count acc) 0)
                      (str acc ", ptr noalias nocapture readonly " d ", i64 " l)
                      (str acc "ptr noalias nocapture readonly " d ", i64 " l))]
                    (match
                      (defn-params (clone t) (scalars/em-vc-put st pname d l el) p2)
                      (ET2Res [st2 acc2 _] (ET2Res st2 acc2 ""))))
                  (= tg 17)
                  (let [p2
                    (if
                      (> (count acc) 0)
                      (str acc ", %Closure " r)
                      (str acc "%Closure " r))]
                    (match
                      (scalars/em-temp st)
                      (
                        ETRes
                        [st1 slot]
                        (match
                          (scalars/em-ins st1 (str "~ = alloca %Closure, align 8"))
                          (
                            ETRes
                            [st2 slot2]
                            (let [st3
                              (
                                scalars/em-line
                                st2
                                (str "  store %Closure " r ", ptr " slot2 ", align 8")
                              )]
                              (match
                                (defn-params (clone t) (scalars/em-sc-put st3 pname slot2 pty) p2)
                                (ET2Res [st4 acc2 _] (ET2Res st4 acc2 ""))))
                          ))
                      )))
                  (= tg 16)
                  (let [boxed (state/md-owns-at mdl (types/ty-arg pty))]
                    (if
                      (= boxed 1)
                      (let [p2
                        (if
                          (> (count acc) 0)
                          (str acc ", ptr " r)
                          (str acc "ptr " r))]
                        (match
                          (defn-params (clone t) (scalars/em-sc-put st pname r pty) p2)
                          (ET2Res [st2 acc2 _] (ET2Res st2 acc2 ""))))
                      (let [nm (state/md-adt-name mdl (types/ty-arg pty))
                        p2
                        (if
                          (> (count acc) 0)
                          (str acc ", %" nm " " r)
                          (str acc "%" nm " " r))]
                        (match
                          (scalars/em-temp st)
                          (
                            ETRes
                            [st1 slot]
                            (let [st2 (scalars/em-pre st1 (str slot " = alloca %" nm ", align 8"))
                              st3
                              (
                                scalars/em-line
                                st2
                                (str "  store %" nm " " r ", ptr " slot ", align 8")
                              )]
                              (match
                                (defn-params (clone t) (scalars/em-sc-put st3 pname slot pty) p2)
                                (ET2Res [st4 acc2 _] (ET2Res st4 acc2 ""))))
                          )))))
                  (= tg 9)
                  (param-scalar (clone t) pname pty r "double" acc st)
                  (= tg 10)
                  (param-scalar (clone t) pname pty r "float" acc st)
                  (= tg 11)
                  (param-scalar (clone t) pname pty r "i1" acc st)
                  (= tg 12)
                  (param-scalar (clone t) pname pty r "ptr" acc st)
                  (< tg 12)
                  (param-scalar t pname pty r (state/ll-scalar pty) acc st)
                  (
                    ET2Res
                    (do
                      (state/cg-fail-i "unresolved type parameter in params")
                      st)
                    ""
                    ""
                  )))
            ))
        ))
    )))

(defn defn-ret-ll [ret :- Ty mdl :- &Mdl] :- str
  (let [tg (types/ty-tag ret)]
    (cond
      (= tg 9)
      "double"
      (= tg 10)
      "float"
      (= tg 11)
      "i1"
      (= tg 12)
      "ptr"
      (= tg 15)
      "%VecI64"
      (= tg 16)
      (if
        (= (state/md-owns-at mdl (types/ty-arg ret)) 1)
        "ptr"
        (str "%" (state/md-adt-name mdl (types/ty-arg ret))))
      (< tg 12)
      (state/ll-scalar ret)
      "i64")))

(defn emit-plain [name :- i64 params :- PList ret :- Ty body :- HExpr st :- Emit] :- EDRes
  (match st
    (
      Emit
      [c mdl sigs]
      (let [nm-str (state/md-sym mdl name) fname (state/mangle nm-str) ismain (= nm-str "main")]
        (match
          (defn-params params st "")
          (
            ET2Res
            [st1 pstr _]
            (let [ps2
              (if ismain
                (if
                  (> (count pstr) 0)
                  (str pstr ", i32 %argc, ptr %argv")
                  (str pstr "i32 %argc, ptr %argv"))
                pstr)]
              (match
                (defn-body ismain (clone ret) body st1)
                (
                  ET2Res
                  [st2 bres _]
                  (match st2
                    (
                      Emit
                      [c2 m2 s2]
                      (let [ret-ll
                        (if ismain
                          "i32"
                          (defn-ret-ll ret m2))
                        header (str "define " ret-ll " @" fname "(" ps2 ") {\n")
                        tail
                        (if ismain
                          "\n  ret i32 0\n}\n"
                          "\n}\n")]
                        (EDRes (Emit (state/fn-new) m2 s2) (fn-text header c2 tail)))
                    ))
                )))
          )))
    )))

(defn defn-body [ismain :- bool ret :- Ty body :- HExpr st :- Emit] :- ET2Res
  (if ismain
    (let [st1 (scalars/em-line st "  call void @cato_args_init(i32 %argc, ptr %argv)")
      forms
      (match body
        (HSeq [es] es)
        (_ (HECons (clone body) (HENil))))]
      (ET2Res (scalars/emit-stmts forms st1) "" ""))
    (let [tg (types/ty-tag ret)]
      (cond
        (= tg 15)
        (match
          (heap/emit-vec-pair body st)
          (
            EVRes
            [st1 p l el]
            (match
              (
                state/em-ins2
                st1
                (str "~ = insertvalue %VecI64 undef, ptr " p ", 0")
                (str "~ = insertvalue %VecI64 ^1, i64 " l ", 1")
              )
              (
                ET2Res
                [st2 s0 s1]
                (let [st3 (scalars/em-line st2 (str "  ret %VecI64 " s1))] (ET2Res st3 "" ""))
              ))
          ))
        (= tg 16)
        (let [ai (types/ty-arg ret) boxed (state/em-boxed-at st ai)]
          (match
            (adt/emit-adt body st)
            (
              ESRes
              [st1 v]
              (if
                (= boxed 1)
                (let [st2 (scalars/em-line st1 (str "  ret ptr " v))] (ET2Res st2 "" ""))
                (let [nm (state/em-adt-name st1 ai)]
                  (match
                    (scalars/em-ins st1 (str "~ = load %" nm ", ptr " v ", align 8"))
                    (
                      ETRes
                      [st2 lv]
                      (let [st3 (scalars/em-line st2 (str "  ret %" nm " " lv))] (ET2Res st3 "" ""))
                    ))))
            )))
        (match
          (scalars/emit-typed body (clone ret) st)
          (
            ESRes
            [st1 v]
            (let [ret-ll
              (cond
                (= tg 11)
                "i1"
                (= tg 12)
                "ptr"
                (< tg 12)
                (state/ll-scalar ret)
                "i64")
              st2 (scalars/em-line st1 (str "  ret " ret-ll " " v))]
              (ET2Res st2 "" ""))
          ))))))

(defn lambda-ll [ty :- Ty] :- str
  (let [tg (types/ty-tag ty)]
    (cond
      (= tg 9)
      "double"
      (= tg 10)
      "float"
      (= tg 11)
      "i1"
      (= tg 12)
      "ptr"
      (< tg 12)
      (state/ll-scalar ty)
      (do
        (state/cg-fail-i "lambda param type not supported")
        "i64"))))

(defn lambda-ret-ll [ret :- Ty] :- str
  (let [tg (types/ty-tag ret)]
    (cond
      (= tg 9)
      "double"
      (= tg 10)
      "float"
      (= tg 11)
      "i1"
      (= tg 12)
      "ptr"
      (< tg 12)
      (state/ll-scalar ret)
      (do
        (state/cg-fail-i "lambda ret type not supported")
        "i64"))))

(defn lambda-params [ps :- PList mdl :- &Mdl] :- str
  (match ps
    (PNil [] "")
    (
      PCons
      [h t]
      (match h
        (
          Param
          [pname pty _pb]
          (
            str
            ", "
            (lambda-ll pty)
            " %"
            (state/mangle (state/md-sym mdl pname))
            (lambda-params t mdl)
          )
        ))
    )))

(defn lambda-bind-params [ps :- PList st :- Emit] :- EURes
  (match ps
    (PNil [] (EURes st))
    (
      PCons
      [h t]
      (match h
        (
          Param
          [pname pty _pb]
          (match st
            (
              Emit
              [c mdl sigs]
              (let [r (str "%" (state/mangle (state/md-sym mdl pname)))]
                (match
                  (lambda-bind-params t (scalars/em-sc-put st pname r pty))
                  (EURes [st2] (EURes st2))))
            ))
        ))
    )))

(defn lambda-cap-vec-word [at :- i64 k :- i64 slot :- str st :- Emit] :- EURes
  (match
    (
      state/em-ins3
      st
      (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
      (str "~ = load i64, ptr ^1, align 8")
      (str "~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 " k)
    )
    (
      ET3Res
      [st1 f raw dst]
      (if
        (= k 0)
        (match
          (scalars/em-ins st1 (str "~ = inttoptr i64 " raw " to ptr"))
          (
            ETRes
            [st2 p]
            (EURes (scalars/em-line st2 (str "  store ptr " p ", ptr " dst ", align 8")))
          ))
        (EURes (scalars/em-line st1 (str "  store i64 " raw ", ptr " dst ", align 8"))))
    )))

(defn lambda-cap-clo-word [at :- i64 k :- i64 slot :- str st :- Emit] :- EURes
  (match
    (
      state/em-ins4
      st
      (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
      (str "~ = load i64, ptr ^1, align 8")
      (str "~ = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 " k)
      (str "~ = inttoptr i64 ^2 to ptr")
    )
    (
      ET4Res
      [st1 f raw dst p]
      (EURes (scalars/em-line st1 (str "  store ptr " p ", ptr " dst ", align 8")))
    )))

(deftype EPR2 (EPR2 [st :- Emit v :- str]))

(defn lambda-load-caps [cs :- Caps at :- i64 st :- Emit] :- ET2Res
  (match cs
    (CNil [] (ET2Res st (str at) ""))
    (
      CCons
      [cname ty own next]
      (match st
        (
          Emit
          [c mdl sigs]
          (let [tg (types/ty-tag ty)]
            (cond
              (= tg 15)
              (match
                (scalars/em-temp st)
                (
                  ETRes
                  [st1 slot]
                  (let [st2 (scalars/em-pre st1 (str slot " = alloca %VecI64, align 8"))]
                    (match
                      (lambda-cap-vec-word at 0 slot st2)
                      (
                        EURes
                        [st3]
                        (match
                          (lambda-cap-vec-word (+ at 1) 1 slot st3)
                          (
                            EURes
                            [st4]
                            (match
                              (lambda-cap-vec-word (+ at 2) 2 slot st4)
                              (
                                EURes
                                [st5]
                                (match
                                  (
                                    lambda-load-caps
                                    (clone next)
                                    (+ at 3)
                                    (scalars/em-gr-put st5 cname slot (heap/vec-elem-of ty))
                                  )
                                  (ET2Res [st6 at6 _] (ET2Res st6 at6 "")))
                              ))
                          ))
                      )))
                ))
              (= tg 17)
              (match
                (scalars/em-temp st)
                (
                  ETRes
                  [st1 slot]
                  (let [st2 (scalars/em-pre st1 (str slot " = alloca %Closure, align 8"))]
                    (match
                      (lambda-cap-clo-word at 0 slot st2)
                      (
                        EURes
                        [st3]
                        (match
                          (lambda-cap-clo-word (+ at 1) 1 slot st3)
                          (
                            EURes
                            [st4]
                            (match
                              (lambda-cap-clo-word (+ at 2) 2 slot st4)
                              (
                                EURes
                                [st5]
                                (match
                                  (
                                    lambda-load-caps
                                    (clone next)
                                    (+ at 3)
                                    (scalars/em-sc-put st5 cname slot ty)
                                  )
                                  (ET2Res [st6 at6 _] (ET2Res st6 at6 "")))
                              ))
                          ))
                      )))
                ))
              (= tg 11)
              (match
                (
                  state/em-ins2
                  st
                  (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
                  (str "~ = load i8, ptr ^1, align 8")
                )
                (
                  ET2Res
                  [st1 f v]
                  (match
                    (scalars/em-ins st1 (str "~ = trunc i8 " v " to i1"))
                    (
                      ETRes
                      [st2 b]
                      (match
                        (lambda-load-caps (clone next) (+ at 1) (scalars/em-sc-put st2 cname b ty))
                        (ET2Res [st3 at3 _] (ET2Res st3 at3 "")))
                    ))
                ))
              (match
                (
                  state/em-ins2
                  st
                  (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
                  (str "~ = load i64, ptr ^1, align 8")
                )
                (
                  ET2Res
                  [st1 f raw]
                  (let [r2
                    (cond
                      (= tg 12)
                      (match
                        (scalars/em-ins st1 (str "~ = inttoptr i64 " raw " to ptr"))
                        (ETRes [st3 p] (EPR2 st3 p)))
                      (= tg 16)
                      (match
                        (scalars/em-ins st1 (str "~ = inttoptr i64 " raw " to ptr"))
                        (ETRes [st3 p] (EPR2 st3 p)))
                      (EPR2 st1 raw))]
                    (match r2
                      (
                        EPR2
                        [st3 v]
                        (match
                          (
                            lambda-load-caps
                            next
                            (+ at (closures/capture-slots ty))
                            (scalars/em-sc-put st3 cname v ty)
                          )
                          (ET2Res [st4 at4 _] (ET2Res st4 at4 "")))
                      )))
                ))))
        ))
    )))

(defn lambda-body [mname :- str caps :- Caps params :- PList ret :- Ty body :- HExpr st :- Emit] :- ET2Res
  (match
    (lambda-bind-params params st)
    (
      EURes
      [st1]
      (match
        (lambda-load-caps caps 1 st1)
        (
          ET2Res
          [st2 at2 _]
          (match
            (scalars/emit-typed body (clone ret) st2)
            (
              ESRes
              [st3 v]
              (let [ll (lambda-ret-ll ret)
                st4
                (if
                  (= ll "double")
                  (scalars/em-line st3 (str "  %retv = fadd double " v ", 0.000000e+00"))
                  (if
                    (= ll "i1")
                    (scalars/em-line st3 (str "  %retv = xor i1 " v ", false"))
                    (scalars/em-line st3 (str "  %retv = add " ll " " v ", 0"))))]
                (ET2Res st4 "" ""))
            ))
        ))
    )))

(defn emit-lambda-pair [mangled :- i64
  caps :- Caps
  params :- PList
  ret :- Ty
  body :- HExpr
  mdl :- Mdl
  sigs :- ESigTab
] :- ELPR
  (let [mname (state/md-sym mdl mangled) st0 (Emit (state/fn-new) mdl sigs)]
    (match
      (lambda-body mname (clone caps) (clone params) (clone ret) body st0)
      (
        ET2Res
        [st1 btext _]
        (match st1
          (
            Emit
            [c1 m1 s1]
            (let [ret-ll (lambda-ret-ll ret)
              header
              (
                str
                "define "
                ret-ll
                " @"
                mname
                "(ptr noalias nocapture readonly %env"
                (lambda-params params m1)
                ") {\n"
              )
              text (fn-text header c1 (str "\n  ret " ret-ll " %retv\n}\n"))
              dt (lambda-drop-text mname caps (clone m1))]
              (ELPR m1 text dt))
          ))
      ))))

(defn emit-lams [ls :- Lams st :- Emit out :- EOut] :- EORes
  (match ls
    (LMNil [] (EORes st out))
    (
      LMCons
      [h t]
      (match h
        (
          Lam
          [mangled caps params ret body]
          (match st
            (
              Emit
              [c mdl sigs]
              (match
                (emit-lambda-pair mangled caps params ret body mdl (clone sigs))
                (
                  ELPR
                  [mdl2 text drop-text]
                  (
                    emit-lams
                    t
                    (Emit (state/fn-new) mdl2 sigs)
                    (
                      EOut
                      (
                        strbuf/sb-add-line
                        (strbuf/sb-add-line (strbuf/sb-add-line (out2-sb out) text) drop-text)
                        ""
                      )
                    )
                  )
                ))
            ))
        ))
    )))

(deftype ECapSlot (ECapSlot [ty :- Ty own :- i64 off :- i64 bit :- i64]))
(deftype ECapSlots
  (CSxNil)
  (CSxCons [h :- ECapSlot t :- ECapSlots]))

(defn caps-with-slots [cs :- Caps at :- i64 bit :- i64] :- ECapSlots
  (match cs
    (CNil [] (CSxNil))
    (
      CCons
      [name ty own next]
      (
        CSxCons
        (ECapSlot ty own at bit)
        (caps-with-slots next (+ at (closures/capture-slots ty)) (+ bit 1))
      )
    )))

(defn lambda-drop-one [ty :- Ty off :- i64 mdl :- &Mdl] :- str
  (let [tg (types/ty-tag ty)]
    (cond
      (= tg 12)
      (
        str
        "  %fp"
        off
        " = getelementptr inbounds i64, ptr %env, i64 "
        off
        "\n"
        "  %fv"
        off
        " = load ptr, ptr %fp"
        off
        ", align 8\n"
        "  call void @free(ptr %fv"
        off
        ")\n"
      )
      (= tg 15)
      (
        str
        "  %vp"
        off
        " = getelementptr inbounds i64, ptr %env, i64 "
        off
        "\n"
        "  %vv"
        off
        " = load ptr, ptr %vp"
        off
        ", align 8\n"
        (if
          (= (types/ty-arg ty) 2)
          (
            str
            "  %vn"
            off
            " = getelementptr inbounds i64, ptr %env, i64 "
            (+ off 1)
            "\n"
            "  %vc"
            off
            " = load i64, ptr %vn"
            off
            ", align 8\n"
            "  call void @cato_str_vec_free(ptr %vv"
            off
            ", i64 %vc"
            off
            ")\n"
          )
          (str "  call void @free(ptr %vv" off ")\n"))
      )
      (= tg 16)
      (let [j (types/ty-arg ty)]
        (if
          (= (state/md-owns-at mdl j) 1)
          (let [nm (state/md-adt-name mdl j)]
            (
              str
              "  %cp"
              off
              " = getelementptr inbounds i64, ptr %env, i64 "
              off
              "\n"
              "  %cv"
              off
              " = load ptr, ptr %cp"
              off
              ", align 8\n"
              "  call void @drop__"
              nm
              "(ptr %cv"
              off
              ")\n"
            ))
          ""))
      (= tg 17)
      (
        str
        "  %ep"
        off
        " = getelementptr inbounds i64, ptr %env, i64 "
        (+ off 1)
        "\n"
        "  %ev"
        off
        " = load ptr, ptr %ep"
        off
        ", align 8\n"
        "  %dp"
        off
        " = getelementptr inbounds i64, ptr %env, i64 "
        (+ off 2)
        "\n"
        "  %dv"
        off
        " = load ptr, ptr %dp"
        off
        ", align 8\n"
        "  call void %dv"
        off
        "(ptr %ev"
        off
        ")\n"
      )
      "")))

(defn lambda-drop-caps [slots :- ECapSlots label :- i64 mdl :- &Mdl] :- str
  (match slots
    (CSxNil [] "")
    (
      CSxCons
      [h t]
      (match h
        (
          ECapSlot
          [ty own off bit]
          (let [mask (str "%m" label)
            cond (str "%c" label)
            free-l (str "own" label)
            done-l (str "done" label)
            own-blk (lambda-drop-one ty off mdl)]
            (
              str
              "  "
              mask
              " = and i64 %bm, "
              (closures/shl1 bit)
              "\n"
              "  "
              cond
              " = icmp ne i64 "
              mask
              ", 0\n"
              "  br i1 "
              cond
              ", label %"
              free-l
              ", label %"
              done-l
              "\n"
              free-l
              ":\n"
              own-blk
              "  br label %"
              done-l
              "\n"
              done-l
              ":\n"
              (lambda-drop-caps t (+ label 1) mdl)
            ))
        ))
    )))

(defn lambda-drop-text [mname :- str caps :- Caps mdl :- Mdl] :- str
  (let [head (str "define void @drop__" mname "(ptr %env) {\nentry:\n  %bm = load i64, ptr %env\n")]
    (
      str
      head
      (lambda-drop-caps (caps-with-slots caps 1 0) 0 mdl)
      "  call void @free(ptr %env)\n  ret void\n}\n"
    )))
