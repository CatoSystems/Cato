; emit_ref.cato — S7 reference driver.
;
; Concatenated after the lib, reader, hir and emit files by the test
; harness (one namespace); this file defines the only `main`. The
; driver runs the full pipeline and prints the emitted LLVM IR:
;
;   <file> — read (S5) → expand (S6) → build (forms → lower → moveck)
;            → emit (S7) — the module text on stdout
;
; Build/moveck errors print `err ...` as in S6; the emitter's
; impossible states exit loudly (the seed's panic path).

(defn emit-print-lines [s :- str]
  (if (> (count s) 0)
    ; the module text ends with \n; print-string appends the final one,
    ; so the body sheds its trailing newline.
    (print-string (subs s 0 (- (count s) 1)))
    0))

(defn emit-build [tab :- (Vector str) forms :- Asts]
  (match (build-program forms tab)
    (PErr [msg] (print-string (str "err " msg)))
    (POk [tab2 adts defs lams sigs]
      (let [facts (facts-compute (adts-templates (clone adts)))]
        (match (check-program defs lams facts (clone tab2))
          (CKErr [msg] (print-string (str "err " msg)))
          (CKOk [defs2 lams2]
            (emit-print-lines (emit-program adts defs2 lams2 sigs tab2))))))))

; shared with the S6 driver (hir_ref.cato), which is not part of this
; concat — emit_ref defines the only main.
(defn read-all-with [src :- str tab :- (Vector str)] :- RRes
  (scan src 0 1 0 0 1 0 (RSNil) (KNil) tab))

(defn main []
  (let [a (args)
        path (get a 0 "")
        src (slurp path)
        r (read-all-with src (magic-table))]
    (match r
      (ROk [forms tab]
        (match (expand-all (clone forms) (KNil))
          (EOk [xforms] (emit-build (clone tab) xforms))
          (EErr [msg at]
            (print-string (str "err " (spat (clone at)) " " (clone msg))))))
      (RErr [msg at]
        (print-string (str "err " (spat (clone at)) " " (clone msg)))))))
