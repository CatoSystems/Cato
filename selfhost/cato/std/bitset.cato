(ns cato.std.bitset)
(require ["num.cato" :as num])

; bitset.cato — Layer B: 64-bit bitset helpers.

(defn bs-empty [] :- i64 0)
(defn bs-full [] :- i64 -1)
(defn bs-set [b :- i64 i :- i64] :- i64
  (num/bit-or b (num/shl 1 i)))
(defn bs-clear [b :- i64 i :- i64] :- i64
  (num/bit-and b (num/bit-not (num/shl 1 i))))
(defn bs-test [b :- i64 i :- i64] :- bool
  (not (= (num/bit-and b (num/shl 1 i)) 0)))
(defn bs-toggle [b :- i64 i :- i64] :- i64
  (num/bit-xor b (num/shl 1 i)))
(defn bs-count [b :- i64] :- i64 (num/popcount b))