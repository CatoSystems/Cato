(ns cato.std.std_ref)
(require ["core.cato" :as core])
(require ["num.cato" :as num])
(require ["math.cato" :as math])
(require ["str.cato" :as str])
(require ["vec.cato" :as vec])
(require ["map.cato" :as map])
(require ["set.cato" :as set])
(require ["list.cato" :as list])
(require ["bitset.cato" :as bs])
(require ["path.cato" :as path])
(require ["env.cato" :as env])
(require ["fs.cato" :as fs])
(require ["io.cato" :as io])
(require ["process.cato" :as proc])
(require ["error.cato" :as err])
(require ["test.cato" :as t])
(require ["log.cato" :as log])

(defn main []
  (do
    (print (core/i64-max))
    (print (num/sat-add 9223372036854775807 1))
    (print (num/popcount 255))
    (print (math/gcd 12 8))
    (print (math/factorial 5))
    (io/println (str/upper "abc"))
    (io/println (str/trim "  hi  "))
    (print (vec/sum-vec [1 2 3]))
    (print (vec/first (vec/sort-asc [3 1 2])))
    (print (map/map-count {1 10 2 20}))
    (print (set/set-count #{1 2 3}))
    (print (list/lst-count (list/vec-to-lst [1 2 3])))
    (print (bs/bs-count (bs/bs-set 0 5)))
    (io/println (path/path-base "/a/b.c"))
    (io/println (env/getenv-or "CATO_NOPE" "default"))
    (t/check "eq" (= 1 1))
    (log/log-info "hello")
    0))