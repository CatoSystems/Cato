(ns cato.hir.hir_ref)
(require ["expand.cato" :as expand])
(require ["../lib/ast.cato" :as ast])
(require ["../lib/span.cato" :as span])
(require ["../lib/strbuf.cato" :as strbuf])
(require ["../reader/dump.cato" :as rdump])
(require ["lower.cato" :as lower])
(require ["forms.cato" :as forms])
(require ["moveck.cato" :as moveck])
(require ["dump.cato" :as hdump])
(require ["../reader/read.cato" :as read])

; hir_ref.cato — S6 reference driver.
;
; Concatenated after the lib, reader and hir files by the test harness
; (one namespace); this file defines the only `main`. The path to read
; comes from `(args)` index 0 (S3); the second positional selects the
; wire format:
;
;   <file> ast   — the expanded forms, serialized with the S5 node
;                  grammar (the expander's differential mode)
;   <file>       — the typed-IR dump (the build's differential mode):
;                  expand → build (forms → lower → move check) → dump
;
; The driver seeds the reader's intern table with the kernel's magic
; names before reading (see expand.cato), so special-form dispatch is a
; sid compare. Errors print `err @line:col+len msg` — reader errors with
; the reader's span, expansion errors with the enclosing top-level
; form's span, build errors bare.

; read-all-with lives in reader/read.cato (this concat includes it).

(defn print-lines [s :- str]
  (if
    (> (count s) 0)
    ; dump lines end with \n; print-string appends the final one, so the
    ; body sheds its trailing newline.
    (print-string (subs s 0 (- (count s) 1)))
    0))

(defn dump-ast-mode [tab :- i64 forms :- Asts]
  (match
    (expand/expand-all (clone forms) (KNil))
    (
      EOk
      [xforms]
      (print-lines (strbuf/sb-str (rdump/dump-forms (clone tab) (clone xforms) (strbuf/sb-new))))
    )
    (EErr [msg at] (print-string (str "err " (rdump/spat (clone at)) " " (clone msg))))))

(defn dump-hir-mode [tab :- i64 forms :- Asts]
  (match
    (expand/expand-all (clone forms) (KNil))
    (EOk [xforms] (build-and-dump tab xforms))
    (EErr [msg at] (print-string (str "err " (rdump/spat (clone at)) " " (clone msg))))))

(defn build-and-dump [tab :- i64 forms :- Asts]
  (match
    (lower/build-program forms tab)
    (PErr [msg] (print-string (str "err " (span/err-text msg))))
    (
      POk
      [tab2 adts defs lams sigs]
      (let [facts (forms/facts-compute (clone adts))]
        (match
          (moveck/check-program defs lams facts (clone tab2) (clone adts))
          (CKErr [msg] (print-string (str "err " (span/err-text msg))))
          (CKOk [defs2 lams2] (print-lines (hdump/dump-program adts defs2 lams2 sigs tab2)))))
    )))

(defn main []
  (let [a (args)
    path (get a 0 "")
    mode (get a 1 "")
    src (slurp path)
    r (read/read-all-with src (expand/magic-table))]
    (match r
      (
        ROk
        [forms tab]
        (if
          (= mode "ast")
          (dump-ast-mode (clone tab) (clone forms))
          (dump-hir-mode (clone tab) (clone forms)))
      )
      (RErr [msg at] (print-string (str "err " (rdump/spat (clone at)) " " (clone msg)))))))
