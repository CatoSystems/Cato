; hexpr.cato — S6: the kernel's typed IR.
;
; One recursive HExpr ADT mirroring the seed's `HExpr` arms for the subset.
; Children ride chains (the deftype field grammar allows no vectors of
; ADTs); optional children are `HENil`; optional types are `t-none`.
;
;   HExprs — ordered children (call args, str args, Seq, ctor args)
;   Binds  — let/loop bindings: (name sid, value, ty)
;   HArms  — match arms: (variant, binders, body); variant -1 is `_`
;   Caps   — closure captures: (name, ty, own)
;
; The move checker rebuilds nodes (functional rewrite) to fill the
; seed's post-`plan_drops` annotations: `HLet` frees, `HConj` in_place,
; `HClosure` capture own-bits.

(deftype HExprs (HENil) (HECons [kid :- HExpr next :- HExprs]))

(deftype Binds (BNil) (BCons [name :- i64 v :- HExpr ty :- Ty next :- Binds]))

(deftype HArms (HANil) (HACons [variant :- i64 binders :- Sids body :- HExpr next :- HArms]))

(deftype Caps (CNil) (CCons [name :- i64 ty :- Ty own :- i64 next :- Caps]))

(deftype VVals (VVNil)
  (VVI64 [v :- i64 next :- VVals])
  (VVF64 [v :- f64 next :- VVals]))

(deftype HExpr
  (HConstI64 [v :- i64])
  (HConstF64 [v :- f64])
  (HConstB [v :- i64])
  (HVar [name :- i64])
  (HStrLit [v :- str])
  (HVecLit [el :- i64 vals :- VVals])
  (HBinW [op :- i64 a :- HExpr b :- HExpr ty :- Ty])
  (HBinF [op :- i64 a :- HExpr b :- HExpr])
  (HCmpW [op :- i64 a :- HExpr b :- HExpr ty :- Ty])
  (HStrCmp [pol :- i64 a :- HExpr b :- HExpr])
  (HStrOrd [op :- i64 a :- HExpr b :- HExpr])
  (HICast [e :- HExpr from :- Ty to :- Ty])
  (HCount [e :- HExpr])
  (HToStr [e :- HExpr ty :- Ty])
  (HStrCat [args :- HExprs])
  (HSubs [s :- HExpr a :- HExpr b :- HExpr])
  (HSplit [s :- HExpr sep :- HExpr])
  (HJoin [sep :- HExpr xs :- HExpr])
  (HStrNth [s :- HExpr idx :- HExpr res :- Ty])
  (HCharStr [e :- HExpr])
  (HGet [src :- HExpr idx :- HExpr dflt :- HExprs ty :- Ty res :- Ty])
  (HConj [v :- HExpr x :- HExpr el :- i64 inplace :- i64])
  (HIf [c :- HExpr t :- HExpr e :- HExpr ty :- Ty])
  (HAnd [a :- HExpr b :- HExpr])
  (HOr [a :- HExpr b :- HExpr])
  (HNot [e :- HExpr])
  (HAbs [e :- HExpr ty :- Ty])
  (HMin [a :- HExpr b :- HExpr ty :- Ty])
  (HMax [a :- HExpr b :- HExpr ty :- Ty])
  (HSeq [es :- HExprs])
  (HLet [binds :- Binds body :- HExpr frees :- Sids])
  (HLoop [binds :- Binds ty :- Ty body :- HExpr])
  (HRecur [args :- HExprs])
  (HCtor [adt :- i64 variant :- i64 args :- HExprs])
  (HMatch [scrut :- HExpr arms :- HArms ty :- Ty])
  (HClone [e :- HExpr])
  (HDrop [e :- HExpr])
  (HClosure [sig :- i64 mangled :- i64 params :- PList caps :- Caps body :- HExpr])
  (HClosureCall [f :- HExpr args :- HExprs sig :- i64])
  (HCall [name :- i64 args :- HExprs])
  (HSlurp [p :- HExpr])
  (HSpit [path :- HExpr data :- HExpr])
  (HArgs)
  (HExit [e :- HExpr])
  (HParseNum [s :- HExpr int :- i64 res :- Ty]))

; --- chains -----------------------------------------------------------------

(defn hes-null [ks :- HExprs] :- bool
  (match ks
    (HENil [] true)
    (HECons [kid next] false)))

(defn hes-depth [ks :- HExprs] :- i64
  (match ks
    (HECons [kid next] (+ 1 (hes-depth (clone next))))
    (HENil [] 0)))

(defn hes-rev [ks :- HExprs acc :- HExprs] :- HExprs
  (match ks
    (HECons [kid next] (hes-rev (clone next) (HECons kid acc)))
    (HENil [] acc)))

(defn binds-depth [ks :- Binds] :- i64
  (match ks
    (BCons [name v ty next] (+ 1 (binds-depth (clone next))))
    (BNil [] 0)))

(defn binds-rev [ks :- Binds acc :- Binds] :- Binds
  (match ks
    (BCons [name v ty next] (binds-rev (clone next) (BCons name (clone v) ty acc)))
    (BNil [] acc)))

(defn arms-depth [ks :- HArms] :- i64
  (match ks
    (HACons [variant binders body next] (+ 1 (arms-depth (clone next))))
    (HANil [] 0)))

(defn caps-depth [ks :- Caps] :- i64
  (match ks
    (CCons [name ty own next] (+ 1 (caps-depth (clone next))))
    (CNil [] 0)))

(defn vvals-depth [ks :- VVals] :- i64
  (match ks
    (VVI64 [v next] (+ 1 (vvals-depth (clone next))))
    (VVF64 [v next] (+ 1 (vvals-depth (clone next))))
    (VVNil [] 0)))

(defn arms-rev [ks :- HArms acc :- HArms] :- HArms
  (match ks
    (HACons [variant binders body next] (arms-rev (clone next) (HACons variant binders (clone body) acc)))
    (HANil [] acc)))

; Get's optional default (absent = HENil)
(defn hget-dflt [e :- HExpr] :- HExprs
  (match e
    (HConstI64 [_] (HENil))
    (HConstF64 [_] (HENil))
    (HConstB [_] (HENil))
    (HVar [_] (HENil))
    (HStrLit [_] (HENil))
    (HVecLit [_ _] (HENil))
    (HBinW [_ _ _ _] (HENil))
    (HBinF [_ _ _] (HENil))
    (HCmpW [_ _ _ _] (HENil))
    (HStrCmp [_ _ _] (HENil))
    (HStrOrd [_ _ _] (HENil))
    (HICast [_ _ _] (HENil))
    (HCount [_] (HENil))
    (HToStr [_ _] (HENil))
    (HStrCat [_] (HENil))
    (HSubs [_ _ _] (HENil))
    (HSplit [_ _] (HENil))
    (HJoin [_ _] (HENil))
    (HStrNth [_ _ _] (HENil))
    (HCharStr [_] (HENil))
    (HGet [src idx dflt ty res] (clone dflt))
    (HConj [_ _ _ _] (HENil))
    (HIf [_ _ _ _] (HENil))
    (HAnd [_ _] (HENil))
    (HOr [_ _] (HENil))
    (HNot [_] (HENil))
    (HAbs [_ _] (HENil))
    (HMin [_ _ _] (HENil))
    (HMax [_ _ _] (HENil))
    (HSeq [_] (HENil))
    (HLet [_ _ _] (HENil))
    (HLoop [_ _ _] (HENil))
    (HRecur [_] (HENil))
    (HCtor [_ _ _] (HENil))
    (HMatch [_ _ _] (HENil))
    (HClone [_] (HENil))
    (HDrop [_] (HENil))
    (HClosure [_ _ _ _ _] (HENil))
    (HClosureCall [_ _ _] (HENil))
    (HCall [_ _] (HENil))
    (HSlurp [_] (HENil))
    (HSpit [_ _] (HENil))
    (HArgs [] (HENil))
    (HExit [_] (HENil))
    (HParseNum [_ _ _] (HENil))))

(defn o-hgd [] :- HExprs
  (HENil))

; --- payload accessors used by the lowering and the move checker -------------
; Cato matches are exhaustive, so a field read is a full-arm walk.

(defn vvals-depth-of [e :- HExpr] :- i64
  (match e
    (HVecLit [el vals] (vvals-depth (clone vals)))
    (HConstI64 [_] 0)
    (HConstF64 [_] 0)
    (HConstB [_] 0)
    (HVar [_] 0)
    (HStrLit [_] 0)
    (HBinW [_ _ _ _] 0)
    (HBinF [_ _ _] 0)
    (HCmpW [_ _ _ _] 0)
    (HStrCmp [_ _ _] 0)
    (HStrOrd [_ _ _] 0)
    (HICast [_ _ _] 0)
    (HCount [_] 0)
    (HToStr [_ _] 0)
    (HStrCat [_] 0)
    (HSubs [_ _ _] 0)
    (HSplit [_ _] 0)
    (HJoin [_ _] 0)
    (HStrNth [_ _ _] 0)
    (HCharStr [_] 0)
    (HGet [_ _ _ _ _] 0)
    (HConj [_ _ _ _] 0)
    (HIf [_ _ _ _] 0)
    (HAnd [_ _] 0)
    (HOr [_ _] 0)
    (HNot [_] 0)
    (HAbs [_ _] 0)
    (HMin [_ _ _] 0)
    (HMax [_ _ _] 0)
    (HSeq [_] 0)
    (HLet [_ _ _] 0)
    (HLoop [_ _ _] 0)
    (HRecur [_] 0)
    (HCtor [_ _ _] 0)
    (HMatch [_ _ _] 0)
    (HClone [_] 0)
    (HDrop [_] 0)
    (HClosure [_ _ _ _ _] 0)
    (HClosureCall [_ _ _] 0)
    (HCall [_ _] 0)
    (HSlurp [_] 0)
    (HSpit [_ _] 0)
    (HArgs [] 0)
    (HExit [_] 0)
    (HParseNum [_ _ _] 0)))

