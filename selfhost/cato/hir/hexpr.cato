(defn hvec-vals [e :- HExpr] :- VVals
  (match e
    (HVecLit [el vals] (clone vals))
    (HConstI64 [_] (VVNil))
    (HConstF64 [_] (VVNil))
    (HConstB [_] (VVNil))
    (HVar [_] (VVNil))
    (HStrLit [_] (VVNil))
    (HBinW [_ _ _ _] (VVNil))
    (HBinF [_ _ _] (VVNil))
