; forms.cato — S6: top-level forms — tables, defn/extern/deftype parsing,
; representation facts.
;
; A port of `hir/parse.rs` + the table shapes of `hir/build.rs`: pass 0a
; collects deftype headers (field types may reference any template,
; regardless of order), pass 0b parses variants, pass 1 parses
; defn/extern headers — registering `Fn` signatures and instantiating
; applied ADTs eagerly in form order, which is the creation order the
; dump pins. The prelude's `(Option a)` template is seeded as adt 0 (the
; seed's PRELUDE after the print multimethod strips away).
;
; Parser state threads the intern table (instance names intern on mint),
; the tables they grow, the current form's type parameters, and the first
; error. `err` = "" means ok.

; --- program tables ---------------------------------------------------------

(deftype Param (Param [name :- i64 ty :- Ty borrowed :- i64]))
(deftype PList (PNil) (PCons [h :- Param t :- PList]))

(deftype RawDefn (RawDefn [name :- i64 params :- PList ret :- Ty
                          typarams :- Sids isextern :- i64 body :- Ast]))
(deftype Raws (RNil) (RCons [h :- RawDefn t :- Raws]))

(deftype Varnt (Varnt [name :- i64 fields :- TyList]))
(deftype VList (VNil) (VCons [h :- Varnt t :- VList]))

; tpl = -1 for declared templates; else the template index (an instance).
; tplargs pins the instantiation key; dedup walks the table.
(deftype AdtInfo (AdtInfo [name :- i64 typarams :- Sids variants :- VList
                          tpl :- i64 tplargs :- TyList]))
(deftype AdtTab (ATNil) (ATCons [h :- AdtInfo t :- AdtTab]))

(deftype Defn (Defn [name :- i64 params :- PList ret :- Ty isextern :- i64
                    body :- HExpr]))
(deftype Defns (DNil) (DCons [h :- Defn t :- Defns]))

(deftype Sig (Sig [params :- TyList ret :- Ty]))
(deftype Sigs (SGNil) (SGCons [h :- Sig t :- Sigs]))

(deftype Lam (Lam [mangled :- i64 caps :- Caps params :- PList ret :- Ty
                  body :- HExpr]))
(deftype Lams (LMNil) (LMCons [h :- Lam t :- Lams]))

; deftype header table: name sid -> (combined index, type parameters).
; Keyed chains are hand-rolled per value type: the field grammar admits no
; `(AList V)` fields (an applied template must apply a deftype's OWN
; parameters), so the S4 AList only appears in defn signatures.
(deftype Decl (Decl [idx :- i64 typarams :- Sids]))
(deftype Decls (DLNil) (DLCons [k :- i64 v :- Decl next :- Decls]))
(deftype TyEnv (TENil) (TECons [k :- i64 v :- Ty next :- TyEnv]))
(deftype IMap (MNil) (MCons [k :- i64 v :- i64 next :- IMap]))

(defn dl-put [e :- Decls k :- i64 v :- Decl] :- Decls
  (DLCons k (clone v) (clone e)))

(defn dl-get [e :- Decls k :- i64] :- Decl
  (match e
    (DLCons [ek ev next] (if (= ek k) (clone ev) (dl-get (clone next) k)))
    (DLNil [] (Decl -1 (SNil)))))

(defn dl-has [e :- Decls k :- i64] :- bool
  (match e
    (DLCons [ek ev next] (if (= ek k) true (dl-has (clone next) k)))
    (DLNil [] false)))

(defn te-put [e :- TyEnv k :- i64 v :- Ty] :- TyEnv
  (TECons k (clone v) (clone e)))

(defn te-get [e :- TyEnv k :- i64] :- Ty
  (match e
    (TECons [ek ev next] (if (= ek k) (clone ev) (te-get (clone next) k)))
    (TENil [] (t-none))))

(defn te-has [e :- TyEnv k :- i64] :- bool
  (match e
    (TECons [ek ev next] (if (= ek k) true (te-has (clone next) k)))
    (TENil [] false)))

(defn im-put [e :- IMap k :- i64 v :- i64] :- IMap
  (MCons k v (clone e)))

(defn im-get [e :- IMap k :- i64 d :- i64] :- i64
  (match e
    (MCons [ek ev next] (if (= ek k) ev (im-get (clone next) k d)))
    (MNil [] d)))

(defn im-has [e :- IMap k :- i64] :- bool
  (match e
    (MCons [ek ev next] (if (= ek k) true (im-has (clone next) k)))
    (MNil [] false)))

; representation facts per combined-table index. Post-revision the model
; gives owns ⊇ boxed and boxed := owns at convergence — one array serves
; both (the seed's two converge to equality).
(deftype Facts (Facts [owns :- Sids]))

(defn facts-owns-at [f :- Facts i :- i64] :- i64
  (match f
    (Facts [owns] (sids-idx (clone owns) i))))

(defn facts-boxed-at [f :- Facts i :- i64] :- i64
  (facts-owns-at (clone f) i))

; --- table helpers ----------------------------------------------------------

(defn raws-depth [rs :- Raws] :- i64
  (match rs
    (RCons [h t] (+ 1 (raws-depth (clone t))))
    (RNil [] 0)))

(defn raws-at [rs :- Raws i :- i64] :- RawDefn
  (match rs
    (RCons [h t] (if (= i 0) (clone h) (raws-at (clone t) (- i 1))))
    (RNil [] (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))))

(defn raws-append [rs :- Raws r :- RawDefn] :- Raws
  (match rs
    (RNil [] (RCons (clone r) (RNil)))
    (RCons [h t] (RCons (clone h) (raws-append (clone t) (clone r))))))

(defn adts-depth [ts :- AdtTab] :- i64
  (match ts
    (ATCons [h t] (+ 1 (adts-depth (clone t))))
    (ATNil [] 0)))

(defn adts-at [ts :- AdtTab i :- i64] :- AdtInfo
  (match ts
    (ATCons [h t] (if (= i 0) (clone h) (adts-at (clone t) (- i 1))))
    (ATNil [] (AdtInfo -1 (SNil) (VNil) -1 (TyNil)))))

(defn adts-set [ts :- AdtTab i :- i64 info :- AdtInfo] :- AdtTab
  (match ts
    (ATCons [h t]
      (if (= i 0)
        (ATCons (clone info) (clone t))
        (ATCons (clone h) (adts-set (clone t) (- i 1) (clone info)))))
    (ATNil [] (ATNil))))

(defn adts-append-info [ts :- AdtTab info :- AdtInfo] :- AdtTab
  (match ts
    (ATNil [] (ATCons (clone info) (ATNil)))
    (ATCons [h t] (ATCons (clone h) (adts-append-info (clone t) (clone info))))))

(defn sigs-depth [ss :- Sigs] :- i64
  (match ss
    (SGCons [h t] (+ 1 (sigs-depth (clone t))))
    (SGNil [] 0)))

(defn sigs-at [ss :- Sigs i :- i64] :- Sig
  (match ss
    (SGCons [h t] (if (= i 0) (clone h) (sigs-at (clone t) (- i 1))))
    (SGNil [] (Sig (TyNil) (t-none)))))

(defn lams-depth [ls :- Lams] :- i64
  (match ls
    (LMCons [h t] (+ 1 (lams-depth (clone t))))
    (LMNil [] 0)))

(defn lams-append [ls :- Lams l :- Lam] :- Lams
  (match ls
    (LMNil [] (LMCons (clone l) (LMNil)))
    (LMCons [h t] (LMCons (clone h) (lams-append (clone t) (clone l))))))

(defn plist-depth [ps :- PList] :- i64
  (match ps
    (PCons [h t] (+ 1 (plist-depth (clone t))))
    (PNil [] 0)))

(defn plist-rev [ps :- PList acc :- PList] :- PList
  (match ps
    (PCons [h t] (plist-rev (clone t) (PCons (clone h) (clone acc))))
    (PNil [] (clone acc))))

(defn vlist-depth [vs :- VList] :- i64
  (match vs
    (VCons [h t] (+ 1 (vlist-depth (clone t))))
    (VNil [] 0)))

(defn vlist-at [vs :- VList i :- i64] :- Varnt
  (match vs
    (VCons [h t] (if (= i 0) (clone h) (vlist-at (clone t) (- i 1))))
    (VNil [] (Varnt -1 (TyNil)))))

(defn vlist-rev [vs :- VList acc :- VList] :- VList
  (match vs
    (VCons [h t] (vlist-rev (clone t) (VCons (clone h) (clone acc))))
    (VNil [] (clone acc))))

(defn defns-depth [ds :- Defns] :- i64
  (match ds
    (DCons [h t] (+ 1 (defns-depth (clone t))))
    (DNil [] 0)))

(defn defns-append [ds :- Defns d :- Defn] :- Defns
  (match ds
    (DNil [] (DCons (clone d) (DNil)))
    (DCons [h t] (DCons (clone h) (defns-append (clone t) (clone d))))))

; --- parser state -----------------------------------------------------------

(deftype PS (PS [tab :- (Vector str) decls :- Decls adts :- AdtTab
                sigs :- Sigs typarams :- Sids err :- str]))

(defn ps-failed [ps :- PS] :- bool
  (match ps
    (PS [tab decls adts sigs typarams err] (> (count err) 0))))

(defn ps-err [ps :- PS msg :- str] :- PS
  (match ps
    (PS [tab decls adts sigs typarams err]
      (if (> (count err) 0)
        (clone ps)
        (PS (clone tab) (clone decls) (clone adts) (clone sigs) (clone typarams) (clone msg))))))

(defn ps-tab [ps :- PS] :- (Vector str)
  (match ps (PS [tab decls adts sigs typarams err] (clone tab))))

(defn ps-with-tab [ps :- PS tab :- (Vector str)] :- PS
  (match ps
    (PS [t decls adts sigs typarams err]
      (PS tab (clone decls) (clone adts) (clone sigs) (clone typarams) (clone err)))))

(defn ps-adts [ps :- PS] :- AdtTab
  (match ps (PS [tab decls adts sigs typarams err] (clone adts))))

(defn ps-with-adts [ps :- PS adts :- AdtTab] :- PS
  (match ps
    (PS [tab decls a sigs typarams err]
      (PS (clone tab) (clone decls) (clone adts) (clone sigs) (clone typarams) (clone err)))))

(defn ps-sigs [ps :- PS] :- Sigs
  (match ps (PS [tab decls adts sigs typarams err] (clone sigs))))

(defn ps-with-sigs [ps :- PS sigs :- Sigs] :- PS
  (match ps
    (PS [tab decls adts s typarams err]
      (PS (clone tab) (clone decls) (clone adts) (clone sigs) (clone typarams) (clone err)))))

(defn ps-with-err [ps :- PS err :- str] :- PS
  (match ps
    (PS [tab decls adts sigs typarams e]
      (PS (clone tab) (clone decls) (clone adts) (clone sigs) (clone typarams) err))))

(defn sym-str [tab :- (Vector str) sid :- i64] :- str
  (get tab sid ""))

(defn ps-str-of [ps :- PS sid :- i64] :- str
  (sym-str (ps-tab (clone ps)) sid))

; One-shot intern over a bare table: the sid, plus the grown table.
(deftype I1Res (I1Res [tab :- (Vector str) sid :- i64]))

(defn intern1 [tab :- (Vector str) s :- str] :- I1Res
  (let [n (count tab)
        sid (intern-find (clone tab) s (- n 1))]
    (if (< sid 0) (I1Res (conj tab s) n) (I1Res tab sid))))

(defn sids-idx-of [ks :- Sids x :- i64 i :- i64] :- i64
  (match ks
    (SCons [h t] (if (= h x) i (sids-idx-of (clone t) x (+ i 1))))
    (SNil [] -1)))

(defn register-ty-param [ps :- PS name :- i64] :- PS
  (match ps
    (PS [tab decls adts sigs typarams err]
      (if (sids-has (clone typarams) name)
        (PS (clone tab) (clone decls) (clone adts) (clone sigs) (clone typarams) (clone err))
        (PS (clone tab) (clone decls) (clone adts) (clone sigs) (sids-append (clone typarams) name) (clone err))))))

(defn typaram-index [ps :- PS name :- i64] :- i64
  (match ps
    (PS [tab decls adts sigs typarams err] (sids-idx-of (clone typarams) name 0))))

(defn is-upper [s :- str] :- bool
  (if (= (count s) 0)
    false
    (let [c (nth s 0 0)]
      (and (>= c 65) (<= c 90)))))

; The prelude: `(deftype (Option a) (Some [v :- a]) (None))` as adt 0.
; "Option"/"Some"/"None"/"a" are magic sids 85..88.
(defn ps-new [tab :- (Vector str)] :- PS
  (let [vs (VCons (Varnt (s-some) (TyCons (t-param 0) (TyNil)))
            (VCons (Varnt (s-nonevar) (TyNil)) (VNil)))
        adts (ATCons (AdtInfo (s-option) (SCons (s-aparam) (SNil)) vs -1 (TyNil)) (ATNil))]
    (PS tab (DLNil) adts (SGNil) (SNil) "")))

; --- type parsing -----------------------------------------------------------

(deftype PTyRes (PTyRes [ps :- PS ty :- Ty]))

; A type annotation symbol (parse_ty_sym): scalars by spelling, the
; legacy `vec` alias, map/set (they parse; their ops are rejected at
; lowering), declared ADT names, uppercase type parameters.
(defn parse-ty-sym-str [ps :- PS s :- str] :- PTyRes
  (cond
    (= s "i64")    (PTyRes (clone ps) (t-i64))
    (= s "i32")    (PTyRes (clone ps) (t-i32))
    (= s "i8")     (PTyRes (clone ps) (t-i8))
    (= s "i16")    (PTyRes (clone ps) (t-i16))
    (= s "u8")     (PTyRes (clone ps) (t-u8))
    (= s "u16")    (PTyRes (clone ps) (t-u16))
    (= s "u32")    (PTyRes (clone ps) (t-u32))
    (= s "u64")    (PTyRes (clone ps) (t-u64))
    (= s "usize")  (PTyRes (clone ps) (t-usize))
    (= s "f64")    (PTyRes (clone ps) (t-f64))
    (= s "f32")    (PTyRes (clone ps) (t-f32))
    (= s "vec")    (PTyRes (clone ps) (t-vec 0))
    (= s "bool")   (PTyRes (clone ps) (t-bool))
    (= s "str")    (PTyRes (clone ps) (t-str))
    (= s "string") (PTyRes (clone ps) (t-str))
    (= s "map")    (PTyRes (clone ps) (t-map))
    (= s "set")    (PTyRes (clone ps) (t-set))
    (parse-ty-sym-name (clone ps) s)))

; A declared ADT name, or an (uppercase) type parameter — lowercase
; unknowns are typos, not variables, and are rejected.
(defn parse-ty-sym-name [ps :- PS s :- str] :- PTyRes
  (match ps
    (PS [tab decls adts sigs typarams err]
      (let [r (intern1 (clone tab) s)]
        (match r
          (I1Res [tab2 sid]
            (if (dl-has (clone decls) sid)
              (let [d (dl-get (clone decls) sid)]
                (match d
                  (Decl [idx tps]
                    (PTyRes (PS (clone tab2) (clone decls) (clone adts) (clone sigs) (clone typarams) (clone err))
                            (t-adt idx)))))
              (if (is-upper s)
                (let [ps0 (PS (clone tab2) (clone decls) (clone adts) (clone sigs) (clone typarams) (clone err))
                      ps2 (register-ty-param (clone ps0) sid)]
                  (match ps2
                    (PS [t3 d3 a3 s3 y3 e3]
                      (PTyRes (clone ps2) (t-param (sids-idx-of (clone y3) sid 0))))))
                (let [ps0 (PS (clone tab2) (clone decls) (clone adts) (clone sigs) (clone typarams) (clone err))]
                  (PTyRes (ps-err (clone ps0) (str "unknown type name " s)) (t-none)))))))))))

; (Vector el) element spelling.
(defn parse-vec-elem-str [ps :- PS s :- str] :- PTyRes
  (cond
    (= s "i64") (PTyRes (clone ps) (t-vec 0))
    (= s "f64") (PTyRes (clone ps) (t-vec 1))
    (= s "str") (PTyRes (clone ps) (t-vec 2))
    (if (is-upper s)
      (let [r (intern1 (ps-tab (clone ps)) s)]
        (match r
          (I1Res [tab2 sid]
            (let [ps2 (register-ty-param (ps-with-tab (clone ps) (clone tab2)) sid)]
              (match ps2
                (PS [t d a sg y e]
                  (PTyRes (clone ps2) (t-vec (+ 100 (sids-idx-of (clone y) sid 0))))))))))
      (PTyRes (ps-err (clone ps) (str "unknown type name " s)) (t-none)))))

; Fn-annotation element types: scalars/ADT names via the sym grammar, or
; a full (Vector ty) (parse_scalar_or_vec).
(defn parse-fn-elem [a :- Ast ps :- PS] :- PTyRes
  (let [tag (ast-tag (clone a))]
    (if (= tag 1)
      (parse-ty-sym-str (clone (clone ps)) (sym-str (ps-tab (clone (clone ps))) (ast-sid-of (clone (clone a)))))
      (if (= tag 5)
        (parse-ty (clone a) (clone ps))
        (PTyRes (ps-err (clone ps) "Fn param/ret types must be scalars, str, or (Vector ty)") (t-none))))))

; Register a closure signature (deduped structurally); the index — its
; table position — is the `Ty::Fn` payload.
(defn register-sig [ps :- PS params :- TyList ret :- Ty] :- PTyRes
  (let [i (sigs-find (ps-sigs (clone ps)) (clone params) (clone ret) 0)]
    (if (>= i 0)
      (PTyRes (clone ps) (t-fn i))
      (match ps
        (PS [tab decls adts sigs typarams err]
          (PTyRes (PS (clone tab) (clone decls) (clone adts) (SGCons (Sig (clone (clone params)) (clone ret)) (clone sigs)) (clone typarams) (clone err))
                  (t-fn (sigs-depth (clone sigs)))))))))

(defn sigs-find [ss :- Sigs params :- TyList ret :- Ty i :- i64] :- i64
  (match ss
    (SGCons [h t]
      (match h
        (Sig [hp hr]
          (if (and (tys-eq (clone hp) (clone (clone params))) (ty-eq (clone hr) (clone ret)))
            i
            (sigs-find (clone t) (clone (clone params)) (clone ret) (+ i 1))))))
    (SGNil [] -1)))

; The string of an atom node (only symbol/string position is queried).
(defn node-str [a :- Ast tab :- (Vector str)] :- str
  (match a
    (ANil [at] "")
    (ASym [sid at] (sym-str tab sid))
    (AInt [v at] (str v))
    (AF64 [v at] (str v))
    (ABool [v at] (str v))
    (AStr [v at] (clone v))
    (AList [ks at] "")
    (AVec [ks at] "")
    (AMap [ks at] "")
    (ASet [ks at] "")))

; A type annotation expression (parse_ty).
(defn parse-ty [a :- Ast ps :- PS] :- PTyRes
  (let [tag (ast-tag (clone a))]
    (cond
      (= tag 1) (parse-ty-sym-str (clone (clone ps)) (sym-str (ps-tab (clone (clone ps))) (ast-sid-of (clone (clone a)))))
      (= tag 5) (parse-ty-list (clone (clone a)) (clone (clone ps)))
      (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))))

(defn parse-ty-list [a :- Ast ps :- PS] :- PTyRes
  (match a
    (AList [kids at]
      (let [h (asts-head-sid (clone kids))
            n (asts-depth (clone kids))]
        (cond
          (= h (s-vec))
          (if (not (= n 2))
            (PTyRes (ps-err (clone ps) (str "unsupported type annotation (expected (Vector ty), got " (- n 1) " elements)")) (t-none))
            (let [el-node (asts-idx (clone kids) 1)
                  el-str (node-str (clone el-node) (ps-tab (clone ps)))]
              (parse-vec-elem-str (clone ps) (clone el-str))))

          (= h (s-fnty))
          (parse-ty-fn (asts-drop (clone kids) 1) (clone ps))

          (parse-ty-applied (clone kids) n (clone ps)))))
    (ANil [at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (ASym [sid at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AInt [v at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AF64 [v at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (ABool [v at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AStr [v at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AVec [ks at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AMap [ks at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))
    (ASet [ks at] (PTyRes (ps-err (clone ps) "type annotation must be a symbol or (Vector ty)") (t-none)))))

; (Fn [t1 ...] ret) — rest is the chain AFTER the `Fn` head: the params
; vector then the ret form chain
(defn parse-ty-fn [rest :- Asts ps :- PS] :- PTyRes
  (match rest
    (KNil [] (PTyRes (ps-err (clone ps) "Fn params must be a vector") (t-none)))
    (KCons [pvec pret]
      (let [t1 (ast-tag (clone pvec))]
        (if (not (= t1 6))
          (PTyRes (ps-err (clone ps) "Fn params must be a vector") (t-none))
          (if (asts-null (clone pret))
            (PTyRes (ps-err (clone ps) "Fn annotation expects a return type") (t-none))
            (let [ret (asts-idx (clone pret) 0)]
              (parse-fn-elems (ast-kids-of (clone pvec)) (TyNil) (clone ret) (clone ps)))))))))

(defn parse-fn-elems [els :- Asts acc :- TyList ret :- Ast ps :- PS] :- PTyRes
  (match els
    (KCons [e rest]
      (let [r (parse-fn-elem (clone e) (clone ps))]
        (match r
          (PTyRes [ps2 ty]
            (if (ps-failed (clone ps2))
              (PTyRes (clone ps2) (t-none))
              (parse-fn-elems (clone rest) (TyCons ty (clone acc)) (clone ret) (clone ps2)))))))
    (KNil []
      (let [r (parse-fn-elem (clone ret) (clone ps))]
        (match r
          (PTyRes [ps2 rty]
            (if (ps-failed (clone ps2))
              (PTyRes (clone ps2) (t-none))
              (register-sig (clone ps2) (tys-rev (clone acc) (TyNil)) rty))))))))

; Applied ADT annotation: (Name arg ...) — instantiate the template
; eagerly. The name must be a generic declared template.
(defn parse-ty-applied [kids :- Asts n :- i64 ps :- PS] :- PTyRes
  (let [h (asts-head-sid (clone kids))]
    (if (and (= h (s-vec)) (not (= n 2)))
      (PTyRes (ps-err (clone ps) (str "unsupported type annotation (expected (Vector ty), got " (- n 1) " elements)")) (t-none))
      (match ps
        (PS [tab decls adts sigs typarams err]
          (if (dl-has (clone decls) h)
            (let [d (dl-get (clone decls) h)]
              (match d
                (Decl [idx tps]
                  (if (= (sids-depth (clone tps)) 0)
                    (PTyRes (ps-err (clone ps) (str (sym-str (clone tab) h) " takes no type parameters")) (t-none))
                    (let [rargs (parse-ty-args (asts-drop (clone kids) 1) (TyNil) (clone ps))]
                      (match rargs
                        (PArgsRes [ps2 args]
                          (if (ps-failed (clone ps2))
                            (PTyRes (clone ps2) (t-none))
                            (let [ri (instantiate-adt idx (clone args) (clone ps2))]
                              (match ri
                                (PIARes [ps3 idx2] (PTyRes (clone ps3) (t-adt idx2)))))))))))))
            (PTyRes (ps-err (clone ps) (str "unknown type name " (sym-str (clone tab) h))) (t-none))))))))

(deftype PArgsRes (PArgsRes [ps :- PS args :- TyList]))

(defn parse-ty-args [els :- Asts acc :- TyList ps :- PS] :- PArgsRes
  (match els
    (KCons [e rest]
      (let [r (parse-ty (clone e) (clone ps))]
        (match r
          (PTyRes [ps2 ty]
            (if (ps-failed (clone ps2))
              (PArgsRes (clone ps2) (TyNil))
              (parse-ty-args (clone rest) (TyCons ty (clone acc)) (clone ps2)))))))
    (KNil [] (PArgsRes (clone ps) (tys-rev (clone acc) (TyNil))))))

; --- ADT instantiation (the combined-table rule of `instantiate_adt`) -------

(deftype PIARes (PIARes [ps :- PS idx :- i64]))

(defn instantiate-adt [tpl :- i64 args :- TyList ps :- PS] :- PIARes
  (let [td (adts-at (ps-adts (clone ps)) tpl)]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (if (not (= (sids-depth (clone tps)) (tys-depth (clone (clone args)))))
          (let [msg (str (ps-str-of (clone ps) name)
                         " expects " (sids-depth (clone tps))
                         " type argument(s), got " (tys-depth (clone args)))]
            (PIARes (ps-err (clone ps) msg) -1))
          (let [hit (adts-find-inst (ps-adts (clone ps)) tpl (clone args) 0)]
            (if (>= (clone hit) 0)
              (PIARes (clone ps) (clone hit))
              (instantiate-adt-new tpl (clone args) (clone ps)))))))))

(defn adts-find-inst [ts :- AdtTab tpl :- i64 args :- TyList i :- i64] :- i64
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [name tps variants vtpl vtargs]
          (if (and (= vtpl tpl) (tys-eq (clone vtargs) (clone (clone args))))
            i
            (adts-find-inst (clone t) tpl (clone args) (+ i 1))))))
    (ATNil [] -1)))

; The instance registers (empty) before its fields resolve, so recursive
; templates hit the cache — the seed's termination rule.
(defn instantiate-adt-new [tpl :- i64 args :- TyList ps :- PS] :- PIARes
  (let [td (adts-at (ps-adts (clone ps)) tpl)
        nm (adt-inst-name (ps-adts (clone ps)) (ps-tab (clone ps)) tpl (clone args))]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (match nm
          (I1Res [tab2 nsid]
            (let [ps1 (ps-with-tab (clone ps) (clone tab2))
                  idx (adts-depth (ps-adts (clone ps1)))
                  ps2 (ps-with-adts (clone ps1) (adts-append-info (ps-adts (clone ps1)) (AdtInfo nsid (SNil) (VNil) tpl (clone args))))
                  rv (fill-variants tpl (clone args) 0 (VNil) (clone ps2))]
              (match rv
                (PVRes [ps3 vs]
                  (PIARes (ps-with-adts (clone ps3) (adts-set (ps-adts (clone ps3)) (clone idx) (AdtInfo nsid (SNil) (clone vs) tpl (clone args))))
                          (clone idx)))))))))))

; `Name__arg1_arg2` — the seed's adt_arg_suffix join.
(defn adt-inst-name [adts :- AdtTab tab :- (Vector str) tpl :- i64 args :- TyList] :- I1Res
  (let [td (adts-at (clone adts) tpl)]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (inst-name-loop (clone adts) (clone tab) (sym-str (clone tab) name) (clone args) 1)))))

(defn inst-name-loop [adts :- AdtTab tab :- (Vector str) acc :- str args :- TyList first :- i64] :- I1Res
  (match args
    (TyNil [] (intern1 tab acc))
    (TyCons [h t]
      (let [suf (ty-mangle-str (clone adts) (clone tab) (clone h))
            acc2 (if (= first 1) (str acc "__" suf) (str acc "_" suf))]
        (inst-name-loop (clone adts) (clone tab) acc2 (clone t) 0)))))

(defn ty-mangle-str [adts :- AdtTab tab :- (Vector str) x :- Ty] :- str
  (let [suf (ty-suffix (clone x))]
    (if (not (= suf "?"))
      suf
      (let [t (ty-tag (clone x))]
        (cond
          (= t 16)
          (let [td (adts-at (clone adts) (ty-arg (clone x)))]
            (match td
              (AdtInfo [name tps variants vtpl vargs] (sym-str (clone tab) name))))
          (= t 18) (str "t" (ty-arg (clone x)))
          "unk")))))

; A template's variants with the instantiation's arguments substituted:
; TParam(k) -> args[k]; a field naming a generic template re-applies the
; same arguments (the positional-parameter rule).
(deftype PVRes (PVRes [ps :- PS vs :- VList]))
(deftype PVRes2 (PVRes2 [ps :- PS vs :- VList]))
(deftype PVOne (PVOne [ps :- PS v :- Varnt]))
(deftype PFRes (PFRes [ps :- PS fs :- TyList]))

(defn fill-variants [tpl :- i64 args :- TyList vi :- i64 acc :- VList ps :- PS] :- PVRes
  (let [td (adts-at (ps-adts (clone ps)) tpl)]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (if (>= vi (vlist-depth (clone variants)))
          (PVRes (clone ps) (vlist-rev (clone acc) (VNil)))
          (let [v (vlist-at (clone variants) vi)]
            (match v
              (Varnt [vn fields]
                (let [rf (fill-fields (clone fields) (TyNil) (clone args) (clone ps))]
                  (match rf
                    (PFRes [ps2 fs]
                      (if (ps-failed (clone ps2))
                        (PVRes (clone ps2) (VNil))
                        (fill-variants tpl (clone args) (+ vi 1) (VCons (Varnt vn (clone fs)) (clone acc)) (clone ps2))))))))))))))

(defn fill-fields [fs :- TyList acc :- TyList args :- TyList ps :- PS] :- PFRes
  (match fs
    (TyCons [h t]
      (let [r (subst-field-ty h (clone args) (clone ps))]
        (match r
          (PTyRes [ps2 ty]
            (if (ps-failed (clone ps2))
              (PFRes (clone ps2) (TyNil))
              (fill-fields (clone t) (TyCons ty (clone acc)) (clone args) (clone ps2)))))))
    (TyNil [] (PFRes (clone ps) (tys-rev (clone acc) (TyNil))))))

(defn subst-field-ty [f :- Ty args :- TyList ps :- PS] :- PTyRes
  (let [t (ty-tag (clone f))]
    (cond
      (= t 18)
      (if (>= (ty-arg (clone f)) (tys-depth (clone args)))
        (PTyRes (ps-err (clone ps) (str "unresolved type parameter " (ty-arg (clone f)) " in ADT field")) (t-none))
        (PTyRes (clone ps) (tys-idx (clone args) (ty-arg (clone f)))))
      (= t 16)
      (let [j (ty-arg (clone f))
            td (adts-at (ps-adts (clone ps)) j)]
        (match td
          (AdtInfo [name tps variants vtpl vargs]
            (if (> (sids-depth (clone tps)) 0)
              (let [ri (instantiate-adt j (clone args) (clone ps))]
                (match ri
                  (PIARes [ps2 idx] (PTyRes (clone ps2) (t-adt idx)))))
              (PTyRes (clone ps) (clone f))))))
      (PTyRes (clone ps) (clone f)))))

; --- deftype parsing --------------------------------------------------------

; Header: Name, or (Name p1 p2 ...).
(deftype HDRRes (HDRRes [ps :- PS name :- i64 typarams :- Sids]))

(defn parse-deftype-header [a :- Ast ps :- PS] :- HDRRes
  (match a
    (AList [kids at]
      (let [n (asts-depth (clone kids))]
        (if (< n 2)
          (HDRRes (ps-err (clone ps) "deftype expects a name and at least one variant") -1 (SNil))
          (let [h (asts-idx (clone kids) 1)
                ht (ast-tag (clone h))]
            (cond
              (= ht 1)
              (HDRRes (clone ps) (ast-sid-of (clone h)) (SNil))

              (= ht 5)
              (match (asts-idx (ast-kids-of (clone h)) 0)
                (AList [hks hat] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (ASym [nsid nat]
                  (parse-typarams (asts-drop (ast-kids-of (clone h)) 1) (SNil) nsid (clone ps)))
                (AInt [v at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (AF64 [v at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (ABool [v at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (AStr [v at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (AVec [ks at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (AMap [ks at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (ASet [ks at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))
                (ANil [at] (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil))))

              (HDRRes (ps-err (clone ps) "deftype name must be a symbol") -1 (SNil)))))))
    (ANil [at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (ASym [sid at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (AInt [v at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (AF64 [v at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (ABool [v at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (AStr [v at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (AVec [ks at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (AMap [ks at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))
    (ASet [ks at] (HDRRes (ps-err (clone ps) "expected (deftype ...)") -1 (SNil)))))

; The header's type-parameter list (symbols; duplicates rejected).
(defn parse-typarams [els :- Asts acc :- Sids name :- i64 ps :- PS] :- HDRRes
  (match els
    (KCons [p rest]
      (match p
        (ASym [pn pat]
          (if (sids-has (clone (clone acc)) pn)
            (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " repeats type parameter " (ps-str-of (clone ps) pn)))
                    -1 (SNil))
            (parse-typarams (clone rest) (SCons pn (clone acc)) name (clone ps))))
        (ANil [at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (AInt [v at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (AF64 [v at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (ABool [v at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (AStr [v at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (AList [ks at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (AVec [ks at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (AMap [ks at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))
        (ASet [ks at] (HDRRes (ps-err (clone ps) (str "deftype " (ps-str-of (clone ps) name) " type parameter must be a symbol")) -1 (SNil)))))
    (KNil [] (HDRRes (clone ps) name (sids-rev (clone acc) (SNil))))))

; Variants (pass 0b): (VName [field :- ty ...]) per variant. `ps`'s
; typarams carry THIS deftype's parameters (the caller resets them).
(defn parse-deftype-variants [a :- Ast ps :- PS] :- PVRes2
  (match a
    (AList [kids at]
      (parse-variants-1 (asts-drop (clone kids) 2) (VNil) (clone ps)))
    (ANil [at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (ASym [sid at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (AInt [v at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (AF64 [v at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (ABool [v at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (AStr [v at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (AVec [ks at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (AMap [ks at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))
    (ASet [ks at] (PVRes2 (ps-err (clone ps) "expected (deftype ...)") (VNil)))))

(defn parse-variants-1 [els :- Asts acc :- VList ps :- PS] :- PVRes2
  (match els
    (KCons [v rest]
      (let [r (parse-variant (clone v) (clone ps))]
        (match r
          (PVOne [ps2 vt]
            (if (ps-failed (clone ps2))
              (PVRes2 (clone ps2) (VNil))
              (parse-variants-1 (clone rest) (VCons (clone vt) (clone acc)) (clone ps2)))))))
    (KNil [] (PVRes2 (clone ps) (vlist-rev (clone acc) (VNil))))))

; One variant: name + optional fields vector.
(defn parse-variant [v :- Ast ps :- PS] :- PVOne
  (match v
    (AList [vitems at]
      (let [vn (asts-head-sid (clone vitems))
            n (asts-depth (clone vitems))]
        (if (< vn 0)
          (PVOne (ps-err (clone ps) "deftype variant name must be a symbol") (Varnt -1 (TyNil)))
          (if (> n 1)
            (let [fvec (asts-idx (clone vitems) 1)
                  ft (ast-tag (clone fvec))]
              (if (not (= ft 6))
                (PVOne (ps-err (clone ps) (str "variant " (ps-str-of (clone ps) vn) " fields must be a vector")) (Varnt -1 (TyNil)))
                (if (> n 2)
                  (PVOne (ps-err (clone ps) (str "variant " (ps-str-of (clone ps) vn) " takes only a fields vector")) (Varnt -1 (TyNil)))
                  (let [rf (parse-fields (ast-kids-of (clone fvec)) 0 (TyNil) vn (clone ps))]
                    (match rf
                      (PFRes [ps2 fs] (PVOne (clone ps2) (Varnt vn (clone fs)))))))))
             (PVOne (clone ps) (Varnt vn (TyNil)))))))
    (ANil [at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (ASym [sid at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AInt [v at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AF64 [v at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (ABool [v at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AStr [v at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AVec [ks at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AMap [ks at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))
    (ASet [ks at] (PVOne (ps-err (clone ps) "deftype variant must be a list") (Varnt -1 (TyNil))))))

; `name :- ty` triples.
(defn parse-fields [fs :- Asts i :- i64 acc :- TyList vn :- i64 ps :- PS] :- PFRes
  (let [n (asts-depth (clone fs))]
    (if (>= i n)
      (PFRes (clone ps) (tys-rev (clone acc) (TyNil)))
      (let [fn-node (asts-idx (clone fs) i)
            fnt (ast-tag (clone fn-node))]
        (if (not (= fnt 1))
          (PFRes (ps-err (clone ps) (str "variant " (ps-str-of (clone ps) vn) " field name must be a symbol")) (TyNil))
          (let [sep-node (asts-idx (clone fs) (+ i 1))
                sept (ast-tag (clone sep-node))]
            (if (not (= sept 1))
              (PFRes (ps-err (clone ps) (str "variant " (ps-str-of (clone ps) vn) " field " (node-str (clone fn-node) (ps-tab (clone ps))) " expects (name :- ty)")) (TyNil))
              (if (not (= (ast-sid-of (clone sep-node)) (s-sep)))
                (PFRes (ps-err (clone ps) (str "variant " (ps-str-of (clone ps) vn) " field " (node-str (clone fn-node) (ps-tab (clone ps))) " expects (name :- ty)")) (TyNil))
                (let [ty-node (asts-idx (clone fs) (+ i 2))
                      rt (parse-field-ty (clone ty-node) (clone ps))]
                  (match rt
                    (PTyRes [ps2 ty]
                      (if (ps-failed (clone ps2))
                        (PFRes (clone ps2) (TyNil))
                        (parse-fields (clone fs) (+ i 3) (TyCons ty (clone acc)) vn (clone ps2))))))))))))))

; A deftype field type (parse_field_ty): scalars, this deftype's own
; parameters, concrete ADT names, (Vector el), or an applied template
; whose arguments are this deftype's parameters in order.
(defn parse-field-ty [e :- Ast ps :- PS] :- PTyRes
  (let [tag (ast-tag (clone e))]
    (cond
      (= tag 1)
      (let [s (node-str (clone e) (ps-tab (clone ps)))]
        (cond
          (= (clone s) "i64")  (PTyRes (clone ps) (t-i64))
          (= (clone s) "i32")  (PTyRes (clone ps) (t-i32))
          (= (clone s) "f64")  (PTyRes (clone ps) (t-f64))
          (= (clone s) "bool") (PTyRes (clone ps) (t-bool))
          (= (clone s) "str")  (PTyRes (clone ps) (t-str))
          (let [sid (ast-sid-of (clone e))
                k (typaram-index (clone ps) sid)]
            (if (>= (clone k) 0)
              (PTyRes (clone ps) (t-param (clone k)))
              (parse-field-adt-name (clone ps) (clone s) sid)))))

      (= tag 5)
      (parse-field-applied (clone e) (clone ps))

      (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))))

(defn parse-field-adt-name [ps :- PS s :- str sid :- i64] :- PTyRes
  (if (dl-has (ps-decls (clone ps)) sid)
    (let [d (dl-get (ps-decls (clone ps)) sid)]
      (match d
        (Decl [idx tps]
          (if (= (sids-depth (clone tps)) 0)
            (PTyRes (clone ps) (t-adt idx))
            (let [msg (str "generic ADT " s " needs type arguments in a field type — apply it to this deftype's parameters: (" s " ...)")]
              (PTyRes (ps-err (clone ps) msg) (t-none)))))))
    (let [msg (str "ADT field type must be i64, i32, f64, bool, str, a type parameter of this deftype, or a declared ADT name, got '" s "'")]
      (PTyRes (ps-err (clone ps) msg) (t-none)))))

(defn ps-decls [ps :- PS] :- Decls
  (match ps (PS [tab decls adts sigs typarams err] (clone decls))))

; (Name a b ...) field: the arguments must be this deftype's parameters
; in order, so instantiation can pass its own arguments through.
(defn parse-field-applied [e :- Ast ps :- PS] :- PTyRes
  (match e
    (AList [items at]
      (let [h (asts-head-sid (clone items))
            n (asts-depth (clone items))]
        (if (and (= h (s-vec)) (= n 2))
          (let [el-node (asts-idx (clone items) 1)
                el-str (node-str (clone el-node) (ps-tab (clone ps)))]
            (cond
              (= (clone el-str) "i64") (PTyRes (clone ps) (t-vec 0))
              (= (clone el-str) "f64") (PTyRes (clone ps) (t-vec 1))
              (= (clone el-str) "str") (PTyRes (clone ps) (t-vec 2))
              (let [k (typaram-index (clone ps) (ast-sid-of (clone el-node)))]
                (if (>= (clone k) 0)
                  (PTyRes (clone ps) (t-vec (+ 100 (clone k))))
                  (PTyRes (ps-err (clone ps) "(Vector ...) element must be i64, f64, str or a type parameter of this deftype") (t-none))))))
          (if (dl-has (ps-decls (clone ps)) h)
            (let [d (dl-get (ps-decls (clone ps)) h)]
              (match d
                (Decl [idx tps]
                  (let [args (asts-drop (clone items) 1)]
                    (if (not (= (asts-depth (clone args)) (sids-depth (clone tps))))
                      (let [msg (str (ps-str-of (clone ps) h) " expects " (sids-depth (clone tps)) " type argument(s) in a field type, got " (asts-depth (clone args)))]
                        (PTyRes (ps-err (clone ps) msg) (t-none)))
                      (check-positional (clone args) (clone tps) 0 (clone ps) h idx))))))
            (PTyRes (ps-err (clone ps) (str "unknown ADT name " (ps-str-of (clone ps) h) " in field type")) (t-none))))))
    (ANil [at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (ASym [sid at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (AInt [v at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (AF64 [v at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (ABool [v at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (AStr [v at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (AVec [ks at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (AMap [ks at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))
    (ASet [ks at] (PTyRes (ps-err (clone ps) "field type must be a symbol or an applied ADT name") (t-none)))))

(defn check-positional [args :- Asts tps :- Sids i :- i64 ps :- PS h :- i64 idx :- i64] :- PTyRes
  (if (>= i (asts-depth (clone (clone args))))
    (PTyRes (clone ps) (t-adt idx))
    (let [a (asts-idx (clone args) i)
          at (ast-tag (clone a))]
      (if (not (= at 1))
        (PTyRes (ps-err (clone ps) (str (ps-str-of (clone ps) h) " type argument must be a parameter name of this deftype")) (t-none))
        (let [asid (ast-sid-of (clone a))
            p (sids-idx (clone tps) i)]
          (if (not (= asid p))
            (let [msg (str "field type (" (ps-str-of (clone ps) h) " ...) must apply " (ps-str-of (clone ps) h) " to this deftype's parameters in order (expected " (ps-str-of (clone ps) p) ")")]
              (PTyRes (ps-err (clone ps) msg) (t-none)))
            (check-positional (clone args) (clone tps) (+ i 1) (clone ps) h idx)))))))

; --- defn / extern parsing --------------------------------------------------

(deftype PParRes (PParRes [ps :- PS params :- PList]))
(deftype RawRes (RawRes [ps :- PS raw :- RawDefn]))

(defn borrow-sigil [s :- str] :- bool
  (and (> (count s) 0) (= (nth s 0 0) 38)))

; `(name :- ty)` triples. `&` borrows are outside the kernel contract and
; fail as unsupported; everything else mirrors parse_params.
(defn parse-params [ks :- Asts i :- i64 acc :- PList ps :- PS] :- PParRes
  (let [n (asts-depth (clone ks))]
    (if (>= i n)
      (PParRes (clone ps) (plist-rev (clone acc) (PNil)))
      (let [nm-node (asts-idx (clone ks) i)
            nm-str (node-str (clone nm-node) (ps-tab (clone ps)))]
        (cond
          (borrow-sigil (clone nm-str))
          ; the sigil on the NAME would need re-interning of the stripped
          ; symbol; borrows are written on the annotation (`ks :- &Asts`).
          (PParRes (ps-err (clone ps) (str "unsupported borrow parameter " (clone nm-str))) (PNil))

          (not (= (ast-tag (clone nm-node)) 1))
          (PParRes (ps-err (clone ps) "param must be a symbol") (PNil))

          (let [sep-node (asts-idx (clone ks) (+ i 1))]
            (not (and (= (ast-tag (clone sep-node)) 1) (= (ast-sid-of (clone sep-node)) (s-sep)))))
          (PParRes (ps-err (clone ps) (str "function parameter '" (clone nm-str) "' must have a type annotation (param :- ty)")) (PNil))

          (let [ty-node (asts-idx (clone ks) (+ i 2))
                ty-tag2 (ast-tag (clone ty-node))]
            (if (not (= ty-tag2 1))
              (let [rt (parse-ty (clone ty-node) (clone ps))]
                (match rt
                  (PTyRes [ps2 ty]
                    (if (ps-failed (clone ps2))
                      (PParRes (clone ps2) (PNil))
                      (let [p (Param (ast-sid-of (clone nm-node)) ty 0)]
                        (parse-params (clone ks) (+ i 3) (PCons (clone p) (clone acc)) (clone ps2)))))))
              (let [ty-str (node-str (clone ty-node) (ps-tab (clone ps)))
                    ; `ks :- &Asts` — a borrowed parameter: the caller keeps
                    ; ownership, the callee only reads (S8: the query
                    ; helpers over boxed chains take & so traversals cost
                    ; no clones).
                    borrowed (borrow-sigil (clone ty-str))
                    bare (if borrowed (subs (clone ty-str) 1 (count (clone ty-str))) (clone ty-str))
                    rt (parse-ty-sym-str (clone ps) bare)]
                (match rt
                  (PTyRes [ps2 ty]
                    (if (ps-failed (clone ps2))
                      (PParRes (clone ps2) (PNil))
                      (let [p (Param (ast-sid-of (clone nm-node)) ty (if borrowed 1 0))]
                        (parse-params (clone ks) (+ i 3) (PCons (clone p) (clone acc)) (clone ps2))))))))))))))

; (defn name [params] [:- ret] body...) / (extern name [params] [:- ret])
(defn parse-defn [a :- Ast ps :- PS isextern :- i64] :- RawRes
  (match a
    (AList [items at]
      (let [n (asts-depth (clone items))]
        (if (< n 3)
          (RawRes (ps-err (clone ps) "defn expects a name and a params vector") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))
          (let [name-node (asts-idx (clone items) 1)
                pvec (asts-idx (clone items) 2)]
            (if (not (= (ast-tag (clone name-node)) 1))
              (RawRes (ps-err (clone ps) "defn name must be a symbol") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))
              (if (not (= (ast-tag (clone pvec)) 6))
                (RawRes (ps-err (clone ps) "defn params must be a vector") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))
                (let [name-sid (ast-sid-of (clone name-node))
                      ; each form starts with its own type-parameter scope
                      ps0 (ps-reset-typarams (clone ps))
                      rp (parse-params (ast-kids-of (clone pvec)) 0 (PNil) (clone ps0))]
                  (match rp
                    (PParRes [ps1 params]
                      (if (ps-failed (clone ps1))
                        (RawRes (clone ps1) (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))
                        (parse-defn-ret (clone items) n 3 (clone params) name-sid isextern (clone ps1))))))))))))
    (ANil [at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (ASym [sid at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (AInt [v at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (AF64 [v at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (ABool [v at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (AStr [v at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (AVec [ks at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (AMap [ks at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))
    (ASet [ks at] (RawRes (ps-err (clone ps) "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))))

(defn ps-reset-typarams [ps :- PS] :- PS
  (match ps
    (PS [tab decls adts sigs typarams err]
      (PS (clone tab) (clone decls) (clone adts) (clone sigs) (SNil) (clone err)))))

(defn parse-defn-ret [items :- Asts n :- i64 i :- i64 params :- PList
                     name-sid :- i64 isextern :- i64 ps :- PS] :- RawRes
  (let [has-ret (and (> n (+ i 1))
                     (= (ast-tag (asts-idx (clone items) i)) 1)
                     (= (ast-sid-of (asts-idx (clone items) i)) (s-sep)))]
    (if has-ret
      (let [rt (parse-ty (asts-idx (clone items) (+ i 1)) (clone ps))]
        (match rt
          (PTyRes [ps2 ret]
            (if (ps-failed (clone ps2))
              (RawRes (clone ps2) (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))
              (parse-defn-body (clone items) n (+ i 2) (clone params) name-sid ret isextern (clone ps2))))))
      (parse-defn-body (clone items) n i (clone params) name-sid (t-i64) isextern (clone ps)))))

(defn parse-defn-body [items :- Asts n :- i64 i :- i64 params :- PList
                      name-sid :- i64 ret :- Ty isextern :- i64 ps :- PS] :- RawRes
  (match ps
    (PS [tab decls adts sigs typarams err]
      (cond
        (and (= isextern 1) (> (sids-depth (clone typarams)) 0))
        (RawRes (ps-err (clone ps) "extern declarations must have concrete types")
                (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))

        (= isextern 1)
        (if (< i n)
          (RawRes (ps-err (clone ps) "extern declarations take no body")
                  (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))
          (RawRes (clone ps) (RawDefn name-sid (clone params) (clone ret) (clone typarams) 1 (AList (KNil) (Span 0 0 0)))))

        (>= i n)
        (RawRes (ps-err (clone ps) "defn body required")
                (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0))))

        (= (- n i) 1)
        (RawRes (clone ps) (RawDefn name-sid (clone params) (clone ret) (clone typarams) 0 (asts-idx (clone (clone items)) i)))

        (let [doform (AList (KCons (ASym (s-do) (asts-at-of (clone items) i)) (asts-drop (clone items) i)) (asts-at-of (clone items) i))]
          (RawRes (clone ps) (RawDefn name-sid (clone params) (clone ret) (clone typarams) 0 doform)))))))

(defn asts-at-of [ks :- Asts i :- i64] :- Span
  (ast-at (asts-idx (clone ks) i)))

; --- flat boolean matrix helpers (n*n over a sid chain) ---------------------

(defn mk-zeros [n :- i64] :- Sids
  (if (= n 0) (SNil) (SCons 0 (mk-zeros (- n 1)))))

(defn sids-set [ks :- Sids i :- i64 v :- i64] :- Sids
  (match ks
    (SCons [h t] (if (= i 0) (SCons v (clone t)) (SCons h (sids-set (clone t) (- i 1) v))))
    (SNil [] (SNil))))

(defn mat-set [ks :- Sids i :- i64 j :- i64 n :- i64 v :- i64] :- Sids
  (sids-set (clone ks) (+ (* i n) j) v))

(defn mat-get [ks :- Sids i :- i64 j :- i64 n :- i64] :- i64
  (sids-idx (clone ks) (+ (* i n) j)))

; --- representation facts ---------------------------------------------------

; Warshall closure over the ADT-field edge matrix; boxed = on a cycle;
; owns fixes out from boxed; in the revised model owning implies boxed,
; so the two converge and one array serves both.

(defn facts-compute [adts :- AdtTab] :- Facts
  (let [n (adts-depth (clone adts))
        edge0 (facts-edges (clone adts) n 0 (mk-zeros (* n n)))
        boxed0 (facts-diag (clone edge0) n 0 (SNil))]
    (Facts (facts-owns-rounds (clone adts) n (+ n 2) (sids-rev (clone boxed0) (SNil))))))

; The declared-template prefix of the combined table. The seed's
; build-stage plan_drops runs on facts computed BEFORE ADT instances
; exist, so instance indices read out of bounds (owns=false) — the
; kernel mirrors that by computing facts over templates only.
(defn adts-templates [ts :- AdtTab] :- AdtTab
  (match ts
    (ATCons [h t]
      (match (clone h)
        (AdtInfo [name tps variants tpl tplargs]
          (if (= tpl -1)
            (ATCons (clone h) (adts-templates (clone t)))
            (ATNil)))))
    (ATNil [] (ATNil))))

(defn facts-edges [adts :- AdtTab n :- i64 t :- i64 edge :- Sids] :- Sids
  (if (>= t n)
    (facts-closure (clone edge) n 0 0 0)
    (facts-edges-vi (clone adts) n t 0 (clone edge))))

(defn facts-edges-vi [adts :- AdtTab n :- i64 t :- i64 vi :- i64 edge :- Sids] :- Sids
  (if (>= vi (vlist-depth (adts-variants-at (clone adts) t)))
    (facts-edges (clone adts) n (+ t 1) (clone edge))
    (facts-edges-fs (varnt-fields-at (clone adts) t vi) (clone adts) n t vi (clone edge))))

(defn facts-edges-fs [fs :- TyList adts :- AdtTab n :- i64 t :- i64 vi :- i64 edge :- Sids] :- Sids
  (match fs
    (TyCons [h rest]
      (let [u (ty-arg h)]
        (if (and (= (ty-tag h) 16) (< u n))
          (facts-edges-fs (clone rest) (clone adts) n t vi (mat-set (clone edge) t u n 1))
          (facts-edges-fs (clone rest) (clone adts) n t vi (clone edge)))))
    (TyNil [] (facts-edges-vi (clone adts) n t (+ vi 1) (clone edge)))))

(defn facts-closure [edge :- Sids n :- i64 k :- i64 i :- i64 j :- i64] :- Sids
  (cond
    (>= k n) (clone edge)
    (>= i n) (facts-closure (clone edge) n (+ k 1) 0 0)
    (>= j n) (facts-closure (clone edge) n k (+ i 1) 0)
    (let [ij (mat-get (clone edge) i j n)
          ik (mat-get (clone edge) i k n)
          kj (mat-get (clone edge) k j n)]
      (if (or (= (clone ij) 1) (and (= (clone ik) 1) (= (clone kj) 1)))
        (facts-closure (mat-set (clone edge) i j n 1) n k i (+ j 1))
        (facts-closure (clone edge) n k i (+ j 1))))))

(defn facts-edges-wrap [edge :- Sids n :- i64 t :- i64] :- Sids
  (if (>= t n) (facts-closure (clone edge) n 0 0 0) (clone edge)))

(defn facts-diag [edge :- Sids n :- i64 i :- i64 acc :- Sids] :- Sids
  (if (>= i n)
    (clone acc)
    (facts-diag (clone edge) n (+ i 1) (SCons (mat-get (clone edge) i i n) (clone acc)))))

(defn facts-owns-rounds [adts :- AdtTab n :- i64 rounds :- i64 owns :- Sids] :- Sids
  (if (= rounds 0)
    (clone owns)
    (facts-owns-rounds (clone adts) n (- rounds 1) (owns-prop (clone adts) n 0 (clone owns)))))

(defn owns-prop [adts :- AdtTab n :- i64 t :- i64 owns :- Sids] :- Sids
  (if (>= t n)
    (clone owns)
    (let [owns2 (if (= (sids-idx (clone owns) t) 1)
                  (clone owns)
                  (if (own-via (clone adts) t 0 (clone owns)) (sids-set (clone owns) t 1) (clone owns)))]
      (owns-prop (clone adts) n (+ t 1) owns2))))

(defn own-via [adts :- AdtTab t :- i64 vi :- i64 owns :- Sids] :- bool
  (if (>= vi (vlist-depth (adts-variants-at (clone adts) t)))
    false
    (own-via-fs (varnt-fields-at (clone adts) t vi) (clone owns))))

(defn own-via-fs [fs :- TyList owns :- Sids] :- bool
  (match fs
    (TyCons [h rest]
      (let [tg (ty-tag h)]
        (if (or (= tg 12) (= tg 15) (= tg 13) (= tg 14))
          true
          (if (and (= tg 16) (= (sids-idx (clone owns) (ty-arg h)) 1))
            true
            (own-via-fs (clone rest) (clone owns))))))
    (TyNil [] false)))

(defn adts-variants-at [ts :- AdtTab i :- i64] :- VList
  (match (adts-at (clone ts) i)
    (AdtInfo [name tps variants tpl tplargs] (clone variants))))

(defn varnt-fields-at [adts :- AdtTab t :- i64 vi :- i64] :- TyList
  (match (vlist-at (adts-variants-at (clone adts) t) vi)
    (Varnt [vn fields] (clone fields))))
