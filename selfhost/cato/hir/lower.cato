; STATUS: WIP — the lowering core (NOT yet in the test concat). In place:
; the LRes threading shape (state returns inside results; nothing global),
; ty_of (exhaustive, mirrors the seed's typing incl. the i64 fallback for
; print-* calls), arithmetic/cmp promotion, unify (scalar + vector-element
; parameters; ADT-typed parameters fail with a clear diagnostic — kernel
; restriction, see the spec), substitution, instantiate (cache-before-body
; so gensym numbering interleaves identically), destructuring let, if,
; match (+ :when guard rewrite), loop/recur (+ tail validation), closures
; (+ capture collection), the builtin arms, and the head dispatch.
; Remaining before this file joins CONCAT order in kernel_hir.rs:
;   - the call arm proper (closure calls, ctor resolution wiring, generic
;     dispatch through `instantiate`, even?, unknown-function errors) —
;     the ctor/variant lookup and `instantiate` exist, the dispatch arm
;     is a stub,
;   - conj's literal folds and nth's three-argument desugar,
;   - moveck.cato (BCheck port: frees/in_place/capture-own bits),
;   - dump.cato (the wire grammar from the spec),
;   - build wiring in the driver + the IR differential fixtures.

; lower.cato — S6: expression lowering + typing + monomorphization.
;
; A port of `hir/lower.rs` + `hir/mono.rs` over the kernel's tables. State
; threads as parameters; everything that can grow (intern table, ADT
; instances, mono instances, closure signatures, lambdas, call-ret table)
; returns inside `LRes`. The seed's observable order is mirrored exactly
; where the dump observes it:
; - `$d{n}` / `_wild{n}` gensyms number off `ncached` (the seed's mono
;   cache length), which advances at the call site BEFORE an instance
;   body lowers;
; - lambdas mint `lambda_{n}` after their body lowers (inner first);
; - `Fn` annotations register signatures during form parsing, closures
;   during lowering;
; - the three-argument `nth` desugars to a match with binder `$b`;
; - guard arms re-enter lowering with a rewritten arm list plus a routing
;   `_` arm (the scrutinee lowers twice on that path, as in the seed);
; - `Call` ret typing: the rets table (static + mono), else the i64
;   fallback (`print-i64` et al. are in no table — the fallback IS the
;   seed's answer).
;
; op codes: BinOp 0 Add 1 Sub 2 Mul 3 Div; CmpOp 0 Eq 1 Ne 2 Lt 3 Gt 4 Le 5 Ge.

(deftype LRes (LOk [tab :- (Vector str) adts :- AdtTab insts :- IMap
                   sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                   defs :- Defns e :- HExpr])
             (LErr [msg :- str]))

(defn lok [tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
          lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
          e :- HExpr] :- LRes
  (LOk tab adts insts sigs lams rets ncached defs e))

; --- ast atom accessors (typed reads off tag checks) ------------------------

(defn ast-int-of [a :- Ast] :- i64
  (match a
    (ANil [at] 0)
    (ASym [sid at] 0)
    (AInt [v at] v)
    (AF64 [v at] 0)
    (ABool [v at] 0)
    (AStr [v at] 0)
    (AList [ks at] 0)
    (AVec [ks at] 0)
    (AMap [ks at] 0)
    (ASet [ks at] 0)))

(defn ast-f64-of [a :- Ast] :- f64
  (match a
    (ANil [at] 0.0)
    (ASym [sid at] 0.0)
    (AInt [v at] 0.0)
    (AF64 [v at] v)
    (ABool [v at] 0.0)
    (AStr [v at] 0.0)
    (AList [ks at] 0.0)
    (AVec [ks at] 0.0)
    (AMap [ks at] 0.0)
    (ASet [ks at] 0.0)))

; payload accessors for tag-checked atoms (avoids 10-arm matches at
; every use)
(defn ast-bool-of [a :- Ast] :- i64
  (match a
    (ANil [at] 0)
    (ASym [sid at] 0)
    (AInt [v at] 0)
    (AF64 [v at] 0)
    (ABool [v at] v)
    (AStr [v at] 0)
    (AList [ks at] 0)
    (AVec [ks at] 0)
    (AMap [ks at] 0)
    (ASet [ks at] 0)))

(defn ast-str-of [a :- Ast] :- str
  (match a
    (ANil [at] "")
    (ASym [sid at] "")
    (AInt [v at] "")
    (AF64 [v at] "")
    (ABool [v at] "")
    (AStr [v at] (clone v))
    (AList [ks at] "")
    (AVec [ks at] "")
    (AMap [ks at] "")
    (ASet [ks at] "")))

(defn kids-all-int [ks :- Asts] :- bool
  (match ks
    (KNil [] true)
    (KCons [kid rest] (and (= (ast-tag (clone kid)) 2) (kids-all-int (clone rest))))))

(defn kids-all-num [ks :- Asts] :- bool
  (match ks
    (KNil [] true)
    (KCons [kid rest]
      (let [t (ast-tag (clone kid))]
        (and (or (= t 2) (= t 3)) (kids-all-num (clone rest)))))))

(defn kids-i64s [ks :- Asts acc :- VVals] :- VVals
  (match ks
    (KNil [] (vvals-rev acc (VVNil)))
    (KCons [kid rest]
      (match kid
        (AInt [v at] (kids-i64s (clone rest) (VVI64 v acc)))
        (ANil [at] (VVNil))
        (ASym [sid at] (VVNil))
        (AF64 [v at] (VVNil))
        (ABool [v at] (VVNil))
        (AStr [v at] (VVNil))
        (AList [ks2 at] (VVNil))
        (AVec [ks2 at] (VVNil))
        (AMap [ks2 at] (VVNil))
        (ASet [ks2 at] (VVNil))))))

(defn kids-f64s [ks :- Asts acc :- VVals] :- VVals
  (match ks
    (KNil [] (vvals-rev acc (VVNil)))
    (KCons [kid rest]
      (match kid
        (AInt [v at] (kids-f64s (clone rest) (VVF64 (f64 v) acc)))
        (AF64 [v at] (kids-f64s (clone rest) (VVF64 v acc)))
        (ANil [at] (VVNil))
        (ASym [sid at] (VVNil))
        (ABool [v at] (VVNil))
        (AStr [v at] (VVNil))
        (AList [ks2 at] (VVNil))
        (AVec [ks2 at] (VVNil))
        (AMap [ks2 at] (VVNil))
        (ASet [ks2 at] (VVNil))))))

(defn vvals-rev [ks :- VVals acc :- VVals] :- VVals
  (match ks
    (VVI64 [v next] (vvals-rev (clone next) (VVI64 v acc)))
    (VVF64 [v next] (vvals-rev (clone next) (VVF64 v acc)))
    (VVNil [] acc)))

; --- entry -------------------------------------------------------------------

(defn lower-x [a :- Ast env :- TyEnv tab :- (Vector str) adts :- AdtTab
              insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
              ncached :- i64 defs :- Defns] :- LRes
  (lower a env (t-none) tab adts insts sigs lams rets ncached defs))

(defn lower [a :- Ast env :- TyEnv expected :- Ty tab :- (Vector str)
            adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
            rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (let [tag (ast-tag (clone a))]
    (cond
      (= tag 2)
      (lok tab adts insts sigs lams rets ncached (DNil) (HConstI64 (ast-int-of (clone a))))

      (= tag 3)
      (lok tab adts insts sigs lams rets ncached (DNil) (HConstF64 (ast-f64-of (clone a))))

      (= tag 4)
      (lok tab adts insts sigs lams rets ncached (DNil) (HConstB (ast-bool-of (clone a))))

      (= tag 5)
      (lok tab adts insts sigs lams rets ncached (DNil) (HStrLit (ast-str-of (clone a))))

      (= tag 1)
      (let [sid (ast-sid-of (clone a))]
        (if (te-has (clone env) sid)
          (lok tab adts insts sigs lams rets ncached (DNil) (HVar sid))
          (LErr (str "unbound variable " (sym-str tab sid)))))

      (= tag 6)
      (lower-veclit a env tab adts insts sigs lams rets ncached defs)

      (= tag 5)
      (lower-list a env expected tab adts insts sigs lams rets ncached defs)

      (LErr "unsupported map/set literal"))))

(defn lower-veclit [a :- Ast env :- TyEnv tab :- (Vector str) adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns] :- LRes
  (match a
    (AVec [kids at]
      (cond
        (kids-all-int (clone kids))
        (lok tab adts insts sigs lams rets ncached (DNil)
             (HVecLit 0 (kids-i64s (clone kids) (VVNil))))

        (kids-all-num (clone kids))
        (lok tab adts insts sigs lams rets ncached (DNil)
             (HVecLit 1 (kids-f64s (clone kids) (VVNil))))

        (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))")))
    (ANil [at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ASym [sid at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AInt [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AF64 [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ABool [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AStr [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AList [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AMap [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ASet [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))))

; --- typing (ty_of) ----------------------------------------------------------

; Reads only: raws/rets/sigs are caller-cloned. Mirrors `ty_of`.
(defn ty-of [e :- HExpr env :- TyEnv rets :- TyEnv sigs :- Sigs] :- Ty
  ; Reads only: raws/rets/sigs are caller-cloned. Mirrors `ty_of`; the
  ; rets table holds static non-generic rets + mono rets, so the Call arm
  ; is a lookup and the seed's i64 fallback covers print-* et al.
  (match e
    (HConstI64 [v] (t-i64))
    (HConstF64 [v] (t-f64))
    (HConstB [v] (t-bool))
    (HVar [name] (te-get (clone env) name))
    (HStrLit [v] (t-str))
    (HVecLit [el vals] (t-vec el))
    (HBinW [op a b ty] (clone ty))
    (HBinF [op a b] (t-f32))
    (HCmpW [op a b ty] (t-bool))
    (HStrCmp [pol a b] (t-bool))
    (HStrOrd [op a b] (t-bool))
    (HICast [e2 from to] (clone to))
    (HCount [x] (t-i64))
    (HToStr [x ty] (t-str))
    (HStrCat [args] (t-str))
    (HSubs [s a b] (t-str))
    (HSplit [s sep] (t-vec 2))
    (HJoin [sep xs] (t-str))
    (HStrNth [s idx res] (clone res))
    (HCharStr [x] (t-str))
    (HGet [src idx dflt ty res] (if (ty-noneq (clone res)) (clone ty) (clone res)))
    (HConj [v x el inplace] (t-vec el))
    (HIf [c t2 e2 ty] (clone ty))
    (HAnd [a b] (t-bool))
    (HOr [a b] (t-bool))
    (HNot [x] (t-bool))
    (HAbs [x ty] (clone ty))
    (HMin [a b ty] (clone ty))
    (HMax [a b ty] (clone ty))
    (HSeq [es] (if (hes-null (clone es)) (t-i64) (h-seq-last (clone es) env rets sigs)))
    (HLet [binds body frees]
      (ty-of (clone body) (binds-extend (clone binds) (clone env) rets sigs) rets sigs))
    (HLoop [binds ty body] (clone ty))
    (HRecur [args] (t-i64))
    (HCtor [adt variant args] (t-adt adt))
    (HMatch [scrut arms ty] (clone ty))
    (HClone [x] (ty-of (clone x) env rets sigs))
    (HDrop [x] (t-i64))
    (HClosure [sig mangled params caps body] (t-fn sig))
    (HClosureCall [f args sig]
      (match (sigs-at (clone sigs) sig)
        (Sig [params r] (clone r))))
    (HCall [name args] (h-call-ty (clone e) rets))
    (HSlurp [p] (t-str))
    (HSpit [path data] (t-i64))
    (HArgs [] (t-vec 2))
    (HExit [x] (t-i64))
    (HParseNum [s int res] (clone res))))

(defn ty-noneq [x :- Ty] :- bool
  (= (ty-tag x) 19))

(defn h-seq-last [es :- HExprs env :- TyEnv rets :- TyEnv sigs :- Sigs] :- Ty
  (if (hes-null (asts-tail-hes (clone es)))
    (ty-of (hes-head-hes (clone es)) env rets sigs)
    (h-seq-last (asts-tail-hes (clone es)) env rets sigs)))

(defn asts-tail-hes [ks :- HExprs] :- HExprs
  (match ks
    (HECons [kid next] (clone next))
    (HENil [] (HENil))))

(defn hes-head-hes [ks :- HExprs] :- HExpr
  (match ks
    (HECons [kid next] (clone kid))
    (HENil [] (HConstI64 0))))

(defn binds-extend [binds :- Binds env :- TyEnv rets :- TyEnv sigs :- Sigs] :- TyEnv
  (match binds
    (BCons [name v ty next]
      (binds-extend (clone next) (te-put env name (clone ty)) rets sigs))
    (BNil [] env)))

; A flat tag walk (mirrors the variant order of the HExpr deftype).
(defn h-tag [e :- HExpr] :- i64
  (match e
    (HConstI64 [v] 0)
    (HConstF64 [v] 1)
    (HConstB [v] 2)
    (HVar [name] 3)
    (HStrLit [v] 4)
    (HVecLit [el vals] 5)
    (HBinW [op a b ty] 6)
    (HBinF [op a b] 7)
    (HCmpW [op a b ty] 8)
    (HStrCmp [pol a b] 9)
    (HStrOrd [op a b] 10)
    (HICast [e from to] 11)
    (HCount [e] 12)
    (HToStr [e ty] 13)
    (HStrCat [args] 14)
    (HSubs [s a b] 15)
    (HSplit [s sep] 16)
    (HJoin [sep xs] 17)
    (HStrNth [s idx res] 18)
    (HCharStr [e] 19)
    (HGet [src idx dflt ty res] 20)
    (HConj [v x el inplace] 21)
    (HIf [c t e ty] 22)
    (HAnd [a b] 23)
    (HOr [a b] 24)
    (HNot [e] 25)
    (HAbs [e ty] 26)
    (HMin [a b ty] 27)
    (HMax [a b ty] 28)
    (HSeq [es] 29)
    (HLet [binds body frees] 30)
    (HLoop [binds ty body] 31)
    (HRecur [args] 32)
    (HCtor [adt variant args] 33)
    (HMatch [scrut arms ty] 34)
    (HClone [e] 35)
    (HDrop [e] 36)
    (HClosure [sig mangled params caps body] 37)
    (HClosureCall [f args sig] 38)
    (HCall [name args] 39)
    (HSlurp [p] 40)
    (HSpit [path data] 41)
    (HArgs [] 42)
    (HExit [e] 43)
    (HParseNum [s int res] 44)))

; --- arithmetic / comparison helpers -----------------------------------------

; coerce_f64: wrap an i64-typed expression when an f64 result is wanted.
(defn coerce-f64 [e :- HExpr cur :- Ty want :- bool] :- HExpr
  (if (and want (not (ty-eq (clone cur) (t-f64))))
    (HICast e (clone cur) (t-f64))
    e))

; promote_pair: both operands numeric and equal-width (no silent mixing).
(defn promote-pair [a :- HExpr b :- HExpr env :- TyEnv rets :- TyEnv sigs :- Sigs] :- PRes
  (let [at (ty-of (clone a) (clone env) (clone rets) (clone sigs))
        bt (ty-of (clone b) (clone env) (clone rets) (clone sigs))
        ati (is-adt-or-str at)
        bti (is-adt-or-str bt)]
    (if (or ati bti)
      (PResErr "ADT and string values cannot be used in arithmetic")
      (if (and (ty-eq at bt) (is-numeric-ty (clone at)))
        (PResOk a b)
        (PResErr (str "cannot mix " (ty-name at) " and " (ty-name bt)
                      " in arithmetic — cast explicitly with ("
                      (if (or (is-float-ty (clone at)) (is-float-ty (clone bt))) "f64" "i64") ") e"))))))

(defn is-adt-or-str [x :- Ty] :- bool
  (let [t (ty-tag x)]
    (or (= t 16) (= t 12))))

(deftype PRes (PResOk [a :- HExpr b :- HExpr]) (PResErr [msg :- str]))

; BinOp code of an arithmetic head
(defn arith-op [sid :- i64] :- i64
  (cond
    (= sid (s-add)) 0
    (= sid (s-sub)) 1
    (= sid (s-mul)) 2
    3))

(defn cmp-op [sid :- i64] :- i64
  (cond
    (= sid (s-eq)) 0
    (= sid (s-ne)) 1
    (= sid (s-lt)) 2
    (= sid (s-gt)) 3
    (= sid (s-le)) 4
    5))

; promote_bin: BinF for f32, BinW carrying the width otherwise.
(defn promote-bin [op :- i64 a :- HExpr b :- HExpr env :- TyEnv
                  rets :- TyEnv sigs :- Sigs] :- LRes1
  (match (promote-pair a b env rets sigs)
    (PResOk [a2 b2]
      (let [t (ty-of (clone a2) env rets sigs)]
        (if (ty-eq (clone t) (t-f32))
          (LRes1Ok (HBinF op a2 b2))
          (LRes1Ok (HBinW op a2 b2 t)))))
    (PResErr [msg] (LRes1Err msg))))

(deftype LRes1 (LRes1Ok [e :- HExpr]) (LRes1Err [msg :- str]))

; Type names for diagnostics (the seed renders Debug shapes; the kernel
; uses readable names — diagnostics are not part of the byte contract).
(defn ty-name [x :- Ty] :- str
  (let [t (ty-tag x)]
    (cond
      (= t 0) "i64"
      (= t 1) "i32"
      (= t 2) "i8"
      (= t 3) "i16"
      (= t 4) "u8"
      (= t 5) "u16"
      (= t 6) "u32"
      (= t 7) "u64"
      (= t 8) "usize"
      (= t 9) "f64"
      (= t 10) "f32"
      (= t 11) "bool"
      (= t 12) "str"
      (= t 13) "map"
      (= t 14) "set"
      (= t 15) "vector"
      (= t 16) "adt"
      (= t 17) "fn"
      (= t 18) "param"
      "none")))

; --- unify + substitution (mono.rs) -------------------------------------------

(deftype URes (UResOk [subs :- TyEnv]) (UResErr))

; unify with a recursion cap standing in for the seed's seen-set.
(defn unify [pat :- Ty actual :- Ty subs :- TyEnv] :- URes
  (unify-seen pat actual subs 0))

(defn unify-seen [pat :- Ty actual :- Ty subs :- TyEnv depth :- i64] :- URes
  (if (> depth 100)
    (UResOk subs)
    (let [pt (ty-tag pat)
          at (ty-tag actual)]
      (cond
        (= pt 18)
        (let [i (ty-arg pat)
              bound (te-get (clone subs) i)]
          (if (ty-noneq (clone bound))
            (UResOk (te-put subs i (clone actual)))
            (if (ty-eq (clone bound) (clone actual))
              (UResOk subs)
              (UResErr))))

        (and (= pt 15) (>= (ty-arg pat) 100) (= at 15))
        (unify-vec-pat pat actual subs depth)

        (and (ty-eq pat actual))
        (UResOk subs)

        (UResErr)))))

(defn unify-vec-pat [pat :- Ty actual :- Ty subs :- TyEnv depth :- i64] :- URes
  (let [elc (ty-arg pat)
        k (- elc 100)
        actual-el (match actual (Ty [t a] a))]
    (if (not (= (ty-tag actual) 15))
      (UResErr)
      (let [a (elem-ty actual-el)
            bound (te-get (clone subs) k)]
        (if (ty-noneq (clone bound))
          (UResOk (te-put subs k a))
          (if (ty-eq (clone bound) (clone a))
            (UResOk subs)
            (UResErr)))))))

; ADT-to-ADT unification (a template against an instance of itself,
; field-wise) is a kernel restriction: ADT-typed generic parameters fail
; instantiation with a clear diagnostic instead of unifying. The seed
; supports them; S6 fixtures exercise scalar/vector-parameter generics,
; which behave identically on both sides.


; --- substitution (subst_ty) --------------------------------------------------

; Substitute bound type parameters through a type. ADT instances whose
; arguments still mention parameters re-instantiate (grows adts/tab):
; reported via SRes.
(deftype SRes (SRes [tab :- (Vector str) adts :- AdtTab ty :- Ty msg :- str]))

(defn subst-ty [ty :- Ty subs :- TyEnv tab :- (Vector str) adts :- AdtTab] :- SRes
  (let [t (ty-tag ty)]
    (cond
      (= t 18)
      (let [bound (te-get (clone subs) (ty-arg ty))]
        (if (ty-noneq (clone bound))
          (SRes tab adts (t-none) (str "unresolved type parameter " (ty-arg ty)))
          (SRes tab adts bound "")))

      (= t 15)
      (let [elc (ty-arg ty)]
        (if (>= elc 100)
          (let [bound (te-get (clone subs) (- elc 100))]
            (cond
              (ty-eq (clone bound) (t-i64)) (SRes tab adts (t-vec 0) "")
              (ty-eq (clone bound) (t-f64)) (SRes tab adts (t-vec 1) "")
              (= (ty-tag bound) 15)         (SRes tab adts (t-vec (ty-arg bound)) "")
              (SRes tab adts (t-none) (str "unresolved vector element parameter " (- elc 100)))))
          (SRes tab adts ty "")))

      (SRes tab adts ty ""))))

; --- monomorphization (instantiate) ---------------------------------------------

; Resolve a (possibly generic) callee for concrete argument types; mint
; and lower the instance on first encounter (cache-before-body, the
; seed's recursion rule).
(deftype MIRes (MIRes [tab :- (Vector str) adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns mangled :- i64 ret :- Ty msg :- str]))

(defn ty-mangle-str2 [adts :- AdtTab tab :- (Vector str) x :- Ty] :- str
  (ty-mangle-str adts tab x))

(defn instantiate [name :- i64 argtys :- TyList env :- TyEnv expected :- Ty
                  tab :- (Vector str) adts :- AdtTab insts :- IMap
                  sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                  defs :- Defns raws :- Raws facts :- Facts] :- MIRes
  (let [raw (raws-find raws name)]
    (match raw
      (RawDefn [rname params ret2 typarams isextern body]
        (if (= (sids-depth (clone typarams)) 0)
          (MIRes tab adts insts sigs lams rets ncached defs name (clone ret2) "")
          (if (not (= (plist-depth (clone params)) (tys-depth (clone argtys))))
            (MIRes tab adts insts sigs lams rets ncached defs name (t-none)
                   (str "function " (sym-str tab name) " expects " (plist-depth (clone params)) " argument(s), got " (tys-depth (clone argtys))))
            (let [ru (unify-params (clone params) (clone argtys) (TENil))]
              (match ru
                (UResErr []
                  (MIRes tab adts insts sigs lams rets ncached defs name (t-none)
                         (str "cannot instantiate " (sym-str tab name) " with the given argument types")))
                (UResOk [subs]
                  ; check every parameter bound
                  (let [miss (unbound-param typarams subs)]
                    (if (not (= (sids-depth miss) 0))
                      (MIRes tab adts insts sigs lams rets ncached defs name (t-none)
                             (str "cannot infer type parameter of " (sym-str tab name)))
                      (let [suf (mangle-suffix typarams subs adts tab (SNil))
                            r2 (intern1 tab (str (sym-str tab name) "__" suf))]
                        (match r2
                          (I1Res [tab2 mangled]
                            (if (te-has (clone rets) mangled)
                              (MIRes tab2 adts insts sigs lams rets ncached defs mangled (te-get rets mangled) "")
                              (let [rs (subst-ty (clone ret2) (clone subs) tab2 adts)]
                                (match rs
                                  (SRes [tab3 adts3 mret msg3]
                                    (if (> (count msg3) 0)
                                      (MIRes tab3 adts3 insts sigs lams rets ncached defs mangled (t-none) msg3)
                                      (let [rp (subst-params (clone params) (clone subs) tab3 adts3 (PNil))]
                                        (match rp
                                          (SPRes [tab4 adts4 mparams msg4]
                                            (if (> (count msg4) 0)
                                              (MIRes tab4 adts4 insts sigs lams rets ncached defs mangled (t-none) msg4)
                                              ; register BEFORE the body lowers
                                              (let [nc2 (+ 1 ncached)
                                                    rets2 (te-put rets mangled mret)
                                                    ri (lower-body-raw (clone body) (binds-of-params mparams) (clone mret)
                                                                       tab4 adts4 insts sigs lams rets2 nc2 defs facts)]
                                                (match ri
                                                  (LErr [msg] (MIRes tab4 adts4 insts sigs lams rets2 nc2 defs mangled (t-none) msg))
                                                  (LOk [tab5 adts5 insts5 sigs5 lams5 rets5 nc5 defs5 body]
                                                    (MIRes tab5 adts5 insts5 sigs5 lams5 rets5 nc5
                                                           (defns-append defs5 (Defn mangled mparams mret 0 body))
                                                           mangled mret "")))))))))))))))))))))))))))

; The lowered instance defn appends to the program's defn list at build
; time from insts order — the instance list records mangled name + ret +
; substituted params + body, so keep them in an extra table threaded in
; LRes... the insts IMap only carries mangled->?; extend: insts maps
; mangled sid -> (ordinal); the DEFS chain carries the Defn values.

; The mono instance defns in creation order (drained into the program's
; defn list after plain defns and externs, matching build.rs).
(defn raws-find [rs :- Raws name :- i64] :- RawDefn
  (raws-find-2 rs name (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)))))

(defn raws-find-2 [rs :- Raws name :- i64 best :- RawDefn] :- RawDefn
  ; last-declared wins (the seed's HashMap overwrite on duplicates)
  (match rs
    (RCons [h t]
      (match h
        (RawDefn [rname params ret typarams isextern body]
          (if (= rname name)
            (raws-find-2 (clone t) name (clone h))
            (raws-find-2 (clone t) name best)))))
    (RNil [] best)))

(defn unify-params [params :- PList argtys :- TyList subs :- TyEnv] :- URes
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty]
          (match argtys
            (TyNil [] (UResErr))
            (TyCons [a arest]
              (match (unify (clone pty) (clone a) (clone subs))
                (UResErr [] (UResErr))
                (UResOk [subs2] (unify-params prest arest subs2))))))))
    (PNil []
      (if (tys-null (clone argtys))
        (UResOk subs)
        (UResErr)))))

(defn unbound-param [typarams :- Sids subs :- TyEnv] :- Sids
  ; the type parameters still unbound after unification (empty = all good)
  (unbound-param-2 typarams subs 0))

(defn unbound-param-2 [typarams :- Sids subs :- TyEnv i :- i64] :- Sids
  (match typarams
    (SNil [] (SNil))
    (SCons [h t]
      (if (ty-noneq (te-get (clone subs) i))
        (SCons i (unbound-param-2 (clone t) subs (+ i 1)))
        (unbound-param-2 (clone t) subs (+ i 1))))))

(defn mangle-suffix [typarams :- Sids subs :- TyEnv adts :- AdtTab tab :- (Vector str) acc :- Sids] :- str
  ; suffix per type parameter, in declaration order, joined with _
  (mangle-suffix-2 typarams subs adts tab 0 "" 0))

(defn mangle-suffix-2 [typarams :- Sids subs :- TyEnv adts :- AdtTab tab :- (Vector str) i :- i64 acc :- str first :- i64] :- str
  (match typarams
    (SNil [] acc)
    (SCons [h t]
      (let [arg (te-get (clone subs) i)
            suf (ty-mangle-str adts tab (clone arg))
            acc2 (if (= first 0) (str acc suf) (str acc "_" suf))]
        (mangle-suffix-2 (clone t) subs adts tab (+ i 1) acc2 0)))))

(deftype SPRes (SPRes [tab :- (Vector str) adts :- AdtTab params :- PList msg :- str]))

(defn subst-params [params :- PList subs :- TyEnv tab :- (Vector str) adts :- AdtTab acc :- PList] :- SPRes
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty]
          (let [r (subst-ty (clone pty) subs tab adts)]
            (match r
              (SRes [tab2 adts2 ty msg]
                (if (> (count msg) 0)
                  (SPRes tab2 adts2 (PNil) msg)
                  (subst-params prest subs tab2 adts2 (PCons (Param pname ty) acc)))))))))
    (PNil [] (SPRes tab adts (plist-rev acc (PNil)) ""))))

(defn binds-of-params [params :- PList] :- TyEnv
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty] (te-put (binds-of-params prest) pname pty))))
    (PNil [] (TENil))))

; lower a raw defn body (implicit do when multiple forms) — the instance
; body path of the seed's `instantiate`.
(defn lower-body-raw [body :- Ast env :- TyEnv expected :- Ty
                     tab :- (Vector str) adts :- AdtTab insts :- IMap
                     sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                     defs :- Defns facts :- Facts] :- LRes
  (let [bt (ast-tag (clone body))]
    (if (and (= bt 5) (= (asts-head-sid (ast-kids-of (clone body))) (s-do)))
      (lower-do (ast-kids-of (clone body)) env (clone expected) tab adts insts sigs lams rets ncached defs)
      (lower (clone body) env (clone expected) tab adts insts sigs lams rets ncached defs))))

; --- ascription resolution (resolve_ann_ty) -----------------------------------

; Scalars (five), concrete ADT names, or applied ADTs — instantiate.
; Note the seed's narrow scalar list here: i8 in a let ascription fails.
(defn resolve-ann-ty [a :- Ast tab :- (Vector str) adts :- AdtTab sigs :- Sigs] :- PTyRes
  (let [tag (ast-tag (clone a))]
    (cond
      (= tag 1)
      (let [s (sym-str tab (ast-sid-of (clone a)))]
        (cond
          (= s "i64")  (PTyRes (PS tab (DLNil) adts sigs (SNil) "") (t-i64))
          (= s "i32")  (PTyRes (PS tab (DLNil) adts sigs (SNil) "") (t-i32))
          (= s "f64")  (PTyRes (PS tab (DLNil) adts sigs (SNil) "") (t-f64))
          (= s "bool") (PTyRes (PS tab (DLNil) adts sigs (SNil) "") (t-bool))
          (= s "str")  (PTyRes (PS tab (DLNil) adts sigs (SNil) "") (t-str))
          (let [sid (ast-sid-of (clone a))
                hit (find-declared-adts adts sid 0)]
            (if (>= (ty-arg-of-info hit) 0)
              (if (= (info-tparams hit) 0)
                (PTyRes (PS tab (DLNil) adts sigs (SNil) "") (t-adt (info-idx hit)))
                (PTyRes (PS tab (DLNil) adts sigs (SNil) "")
                        (t-none)))
              (PTyRes (PS tab (DLNil) adts sigs (SNil) "")
                      (t-none))))))
      (= tag 5)
      (parse-ty a (PS tab (DLNil) adts sigs (SNil) ""))
      (PTyRes (PS tab (DLNil) adts sigs (SNil) "") (t-none)))))

; find a DECLARED (non-instance) ADT by name sid; info-idx carries the
; combined index, -1 when absent
(defn find-declared-adts [ts :- AdtTab sid :- i64 i :- i64] :- AdtInfo2
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [name typarams variants tpl tplargs]
          (if (and (= name sid) (= tpl -1))
            (AdtInfo2 i (clone h))
            (find-declared-adts (clone t) sid (+ i 1))))))
    (ATNil [] (AdtInfo2 -1 (AdtInfo -1 (SNil) (VNil) -1 (TyNil))))))

(deftype AdtInfo2 (AdtInfo2 [idx :- i64 info :- AdtInfo]))

(defn info-idx [x :- AdtInfo2] :- i64
  (match x (AdtInfo2 [idx info] idx)))

(defn info-tparams [x :- AdtInfo2] :- i64
  (match x
    (AdtInfo2 [idx info]
      (match info
        (AdtInfo [name typarams variants tpl tplargs] (sids-depth (clone typarams)))))))

(defn ty-arg-of-info [x :- AdtInfo2] :- i64
  (info-idx x))

; the (Option T) instance for two-argument get / nth / parse-*
(deftype OIRes (OIRes [tab :- (Vector str) adts :- AdtTab idx :- i64]))

(defn option-instance [ty :- Ty tab :- (Vector str) adts :- AdtTab sigs :- Sigs] :- OIRes
  (let [ps (PS tab (DLNil) adts sigs (SNil) "")
        r (instantiate-adt (s-option) (TyCons ty (TyNil)) ps)]
    (match r
      (PIARes [ps2 idx]
        (match ps2
          (PS [tab2 d2 a2 s2 y2 e2] (OIRes tab2 a2 idx)))))))

; --- sequences, let, if --------------------------------------------------------

; (do form...) — one form collapses to the form itself.
(defn lower-do [forms :- Asts env :- TyEnv expected :- Ty tab :- (Vector str)
               adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
               rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (asts-null (clone forms))
    (lok tab adts insts sigs lams rets ncached defs (HConstI64 0))
    (lower-do-2 (clone forms) (HENil) env expected tab adts insts sigs lams rets ncached defs)))

(defn lower-do-2 [forms :- Asts acc :- HExprs env :- TyEnv expected :- Ty
                 tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (let [kid (asts-idx (clone forms) 0)
        rest (asts-tail (clone forms))
        lastq (asts-null (clone rest))
        exp (if lastq (clone expected) (t-none))
        r (lower (clone kid) env exp tab adts insts sigs lams rets ncached defs)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 e2]
        (if lastq
          (if (hes-null (clone acc))
            (lok tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 e2)
            (lok tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2
                 (HSeq (hes-rev (HECons e2 acc) (HENil)))))
          (lower-do-2 rest (HECons e2 acc) env expected tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2))))))

; lower a single child expression (no expected type)
(defn lower-1 [a :- Ast env :- TyEnv tab :- (Vector str) adts :- AdtTab
              insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
              ncached :- i64 defs :- Defns] :- LRes
  (lower a env (t-none) tab adts insts sigs lams rets ncached defs))

; lower with an expected type
(defn lower-e [a :- Ast env :- TyEnv expected :- Ty tab :- (Vector str)
              adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
              rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (lower a env expected tab adts insts sigs lams rets ncached defs))

; --- if (forms.rs lower_if) -----------------------------------------------------

(defn lower-if [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
               insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
               ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 4))
    (LErr "if expects (if cond then else)")
    (let [c (asts-idx (clone items) 1)
          rc (lower-1 (clone c) env tab adts insts sigs lams rets ncached defs)]
      (match rc
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 c2]
          (if (not (ty-eq (ty-of (clone c2) env r1 s1) (t-bool)))
            (LErr "if condition must be boolean")
            (let [tthen (asts-idx (clone items) 2)
                  rt (lower-1 (clone tthen) env t1 a1 i1 s1 l1 r1 n1 d1)]
              (match rt
                (LErr [msg] (LErr msg))
                (LOk [t2 a2 i2 s2 l2 r2 n2 d2 then2]
                  (let [tels (asts-idx (clone items) 3)
                        re (lower-1 (clone tels) env t2 a2 i2 s2 l2 r2 n2 d2)]
                    (match re
                      (LErr [msg] (LErr msg))
                      (LOk [t3 a3 i3 s3 l3 r3 n3 d3 els2]
                        (let [tt (ty-of (clone then2) env r3 s3)
                              et (ty-of (clone els2) env r3 s3)
                              ; a recur branch takes the other branch's type
                              tt2 (if (= (h-tag (clone then2)) 32) et tt)
                              et2 (if (= (h-tag (clone els2)) 32) tt et)]
                          (if (and (not (ty-eq tt2 et2))
                                   (not (ty-eq tt2 (t-f64)))
                                   (not (ty-eq et2 (t-f64))))
                            (LErr (str "if branches must be the same type, got " (ty-name tt2) " and " (ty-name et2)))
                            (let [ty (if (or (ty-eq tt2 (t-f64)) (ty-eq et2 (t-f64))) (t-f64) tt2)
                                  wf (ty-eq ty (t-f64))
                                  then3 (coerce-f64 (clone then2) tt2 wf)
                                  els3 (coerce-f64 (clone els2) et2 wf)]
                              (lok t3 a3 i3 s3 l3 r3 n3 d3 (HIf c2 then3 els3 ty)))))))))))))))))

; --- let (forms.rs lower_let) ---------------------------------------------------

(defn lower-let [items :- Asts env :- TyEnv expected :- Ty tab :- (Vector str)
                adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (match items
    (KNil [] (LErr "let bindings must be a vector"))
    (KCons [bvec body]
      (if (not (= (ast-tag (clone bvec)) 6))
        (LErr "let bindings must be a vector")
        (if (not (even? (asts-depth (ast-kids-of (clone bvec)))))
          (LErr "let bindings must be key/value pairs")
          (let [rb (lower-let-binds (ast-kids-of (clone bvec)) 0 env (TENil) (TENil)
                                    tab adts insts sigs lams rets ncached defs)]
            (match rb
              (LBErr [msg] (LErr msg))
              (LBRes [t2 a2 i2 s2 l2 r2 n2 d2 env2 binds2]
                ; multiple body forms form an implicit sequence
                (let [rbody (lower-body-1 (asts-tail (clone items)) body env2 expected t2 a2 i2 s2 l2 r2 n2 d2)]
                  (match rbody
                    (LErr [msg] (LErr msg))
                    (LOk [t3 a3 i3 s3 l3 r3 n3 d3 e3]
                      (lok t3 a3 i3 s3 l3 r3 n3 d3 (HLet (binds-rev binds2 (BNil)) e3 (SNil))))))))))))))

; the body after the bindings vector: one form, or an implicit Seq
(defn lower-body-1 [rest :- Asts body :- Ast env :- TyEnv expected :- Ty
                   tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                   lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (asts-null (clone rest))
    (lower (clone body) env (clone expected) tab adts insts sigs lams rets ncached defs)
    (lower-body-seq (KCons (clone body) rest) (HENil) env tab adts insts sigs lams rets ncached defs)))

(defn lower-body-seq [forms :- Asts acc :- HExprs env :- TyEnv
                     tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                     lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (let [kid (asts-idx (clone forms) 0)
        restq (asts-null (asts-tail (clone forms)))
        r (lower-1 (clone kid) env tab adts insts sigs lams rets ncached defs)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
        (if restq
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSeq (hes-rev (HECons e2 acc) (HENil))))
          (lower-body-seq (asts-tail (clone forms)) (HECons e2 acc) env tab adts insts s2 l2 r2 n2 d2))))))

; returns env2 + accumulated binds (reversed); mirrors lower_let's three
; binding shapes: [a b] destructuring, [x :- ty value] ascription, plain.
(deftype LBRes (LBRes [tab :- (Vector str) adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns env :- TyEnv binds :- Binds])
              (LBErr [msg :- str]))

(defn lower-let-binds [binds :- Asts i :- i64 env0 :- TyEnv env :- TyEnv
                      acc :- Binds tab :- (Vector str) adts :- AdtTab
                      insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                      ncached :- i64 defs :- Defns] :- LBRes
  (lower-let-binds-impl binds i (asts-depth (clone binds)) env0 env acc
                        tab adts insts sigs lams rets ncached defs))

(defn lower-let-binds-impl [binds :- Asts i :- i64 n :- i64 env0 :- TyEnv env :- TyEnv
                           acc :- Binds tab :- (Vector str) adts :- AdtTab
                           insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                           ncached :- i64 defs :- Defns] :- LBRes
  (if (>= i n)
    (LBRes tab adts insts sigs lams rets ncached defs env acc)
    (let [name-node (asts-idx (clone binds) i)
          nt (ast-tag (clone name-node))]
      (cond
        ; [a b] destructuring pattern
        (= nt 6)
        (let [val-node (asts-idx (clone binds) (+ i 1))
              rv (lower-1 (clone val-node) env tab adts insts sigs lams rets ncached defs)]
          (match rv
            (LErr [msg] (LBErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
              (let [vt (ty-of (clone value) env r2 s2)]
                (if (not (= (ty-tag vt) 15))
                  (LBErr (str "destructured binding source must be a vector, got " (ty-name vt)))
                  (let [elc (ty-arg vt)
                        ; $d{ncached + resolved-so-far}
                        tmp-n (+ n2 (binds-depth (clone acc)))
                        rtmp (intern1 t2 (str "$d" tmp-n))]
                    (match rtmp
                      (I1Res [t3 tmp] 
                        (let [pat (ast-kids-of (clone name-node))
                              rp (destructure-binds (clone pat) 0 tmp elc env t3 a2 i2 s2 l2 r2 n2 d2 defs acc)]
                          (match rp
                            (LBErr [msg] (LBErr msg))
                            (LBRes [t4 a4 i4 s4 l4 r4 n4 d4 env4 acc4]
                              (lower-let-binds-impl binds (+ i 2) n env0 env4 acc4 t4 a4 i4 s4 l4 r4 n4 d4))))))))))))
        ; [x :- ty value] ascription
        (and (= nt 1)
             (let [sep (asts-idx (clone binds) (+ i 1))]
               (and (= (ast-tag (clone sep)) 1) (= (ast-sid-of (clone sep)) (s-sep)))))
        (let [name-sid (ast-sid-of (clone name-node))
              ann (asts-idx (clone binds) (+ i 2))
              val-node (asts-idx (clone binds) (+ i 3))
              ra (resolve-ann-ty (clone ann) tab adts sigs)]
          (match ra
            (PTyRes [ps2 ty]
              (if (ps-failed ps2)
                (LBErr (ps-err-msg ps2))
                (match ps2
                  (PS [t d a sg y e]
                    (let [rv (lower-e (clone val-node) env ty t a insts sg lams rets ncached defs)]
                      (match rv
                        (LErr [msg] (LBErr msg))
                        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
                          (let [vt (ty-of (clone value) env r2 s2)
                                ok (or (ty-eq vt ty) (and (ty-eq ty (t-f64)) (ty-eq vt (t-i64))))]
                            (if (not ok)
                              (LBErr (str "let binding " (sym-str t2 name-sid) " ascribed " (ty-name ty) " but the value is " (ty-name vt)))
                              (lower-let-binds-impl binds (+ i 4) n env0 (te-put env name-sid ty)
                                                    (BCons name-sid value ty acc) t2 a2 i2 s2 l2 r2 n2 d2))))))))))))
            ; plain [x value]
        (= nt 1)
        (let [name-sid (ast-sid-of (clone name-node))
              val-node (asts-idx (clone binds) (+ i 1))
              rv (lower-1 (clone val-node) env tab adts insts sigs lams rets ncached defs)]
          (match rv
            (LErr [msg] (LBErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
              (let [vt (ty-of (clone value) env r2 s2)]
                (lower-let-binds-impl binds (+ i 2) n env0 (te-put env name-sid vt)
                                      (BCons name-sid value vt acc) t2 a2 i2 s2 l2 r2 n2 d2)))))
        (LBErr "let binding name must be a symbol or a [a b] pattern")))))

(defn ps-err-msg [ps :- PS] :- str
  (match ps (PS [tab decls adts sigs typarams err] err)))

; [a b] destructuring: bind a = (get tmp 0 default), b = (get tmp 1
; default); `_` skips. Scalar i64/f64 elements only (the seed's rule).
(defn destructure-binds [pat :- Asts k :- i64 tmp :- i64 elc :- i64
                        env :- TyEnv tab :- (Vector str) adts :- AdtTab
                        insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                        ncached :- i64 defs :- Defns acc :- Binds] :- LBRes
  (if (>= k (asts-depth (clone pat)))
    (LBRes tab adts insts sigs lams rets ncached defs env acc)
    (let [p (asts-idx (clone pat) k)
          pt (ast-tag (clone p))]
      (if (not (= pt 1))
        (LBErr "destructure pattern elements must be symbols or _")
        (let [pn (ast-sid-of (clone p))]
          (if (= pn (s-wild))
            (destructure-binds pat (+ k 1) tmp elc env tab adts insts sigs lams rets ncached defs acc)
            (if (and (not (= elc 0)) (not (= elc 1)))
              (LBErr (str "destructuring supports i64/f64 vectors, got element " (ty-name (elem-ty elc))))
              (let [et (elem-ty elc)
                    zero (if (= elc 0) (HConstI64 0) (HConstF64 0.0))
                    getv (HGet (HVar tmp) (HConstI64 k) zero et (t-none))
                    acc2 (BCons pn getv et acc)]
                (destructure-binds pat (+ k 1) tmp elc (te-put env pn et) tab adts insts sigs lams rets ncached defs acc2)))))))))

; --- comparisons, not, abs, min/max, and/or (forms.rs) ----------------------------

(defn lower-cmp [op :- i64 items :- Asts env :- TyEnv tab :- (Vector str)
                adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr (str "comparison expects 2 operands"))
    (let [a (asts-idx (clone items) 1)
          b (asts-idx (clone items) 2)
          ra (lower-1 (clone a) env tab adts insts sigs lams rets ncached defs)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [rb (lower-1 (clone b) env t1 a1 i1 s1 l1 r1 n1 d1)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (let [at (ty-of (clone e1) env r2 s2)
                      bt (ty-of (clone e2) env r2 s2)]
                  (if (and (ty-eq at (t-str)) (ty-eq bt (t-str)))
                    ; string comparisons go through the runtime
                    (cond
                      (= op 0) (lok t2 a2 i2 s2 l2 r2 n2 d2 (HStrCmp 1 e1 e2))
                      (= op 1) (lok t2 a2 i2 s2 l2 r2 n2 d2 (HStrCmp 0 e1 e2))
                      (lok t2 a2 i2 s2 l2 r2 n2 d2 (HStrOrd op e1 e2)))
                    (if (and (ty-eq at bt) (is-numeric-ty at))
                      (lok t2 a2 i2 s2 l2 r2 n2 d2 (HCmpW op e1 e2 at))
                      (LErr (str "cannot compare " (ty-name at) " and " (ty-name bt)
                                 " — operands must share a width (cast explicitly)")))))))))))))

(defn lower-not [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "not expects 1 operand")
    (lower-1-bool (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs "not expects a boolean operand" 25)))

(defn lower-abs [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "abs expects 1 operand")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [t (ty-of (clone e2) env r2 s2)]
            (if (or (ty-eq t (t-i64)) (ty-eq t (t-f64)) (ty-eq t (t-i32)))
              (lok t2 a2 i2 s2 l2 r2 n2 d2 (HAbs e2 t))
              (LErr "abs expects an i64, i32 or f64 operand"))))))))

(defn lower-minmax [op :- i64 items :- Asts env :- TyEnv tab :- (Vector str)
                   adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                   rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr (if (= op 0) "min expects 2 operands" "max expects 2 operands"))
    (let [a (asts-idx (clone items) 1)
          ra (lower-1 (clone a) env tab adts insts sigs lams rets ncached defs)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [b (asts-idx (clone items) 2)
                rb (lower-1 (clone b) env t1 a1 i1 s1 l1 r1 n1 d1)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (match (promote-pair (clone e1) (clone e2) env r2 s2)
                  (PResErr [msg] (LErr msg))
                  (PResOk [f1 f2]
                    (let [t (ty-of (clone f1) env r2 s2)]
                      (if (or (ty-eq t (t-i64)) (ty-eq t (t-f64)) (ty-eq t (t-i32)))
                        (if (= op 0)
                          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HMin f1 f2 t))
                          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HMax f1 f2 t)))
                        (LErr (str "min/max expects i64/i32/f64 operands"))))))))))))))

(defn lower-1-bool [a :- Ast env :- TyEnv tab :- (Vector str) adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns msg :- str kind :- i64] :- LRes
  (let [r (lower-1 a env tab adts insts sigs lams rets ncached defs)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
        (if (not (ty-eq (ty-of (clone e2) env r2 s2) (t-bool)))
          (LErr msg)
          (lok t2 a2 i2 s2 l2 r2 n2 d2
               (if (= kind 25) (HNot e2) (HConstI64 0))))))))

; post-expansion and/or is strictly binary (the expander folded variadics)
(defn lower-andor [kind :- i64 items :- Asts env :- TyEnv tab :- (Vector str)
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr "and/or expects 2 operands")
    (let [a (asts-idx (clone items) 1)
          b (asts-idx (clone items) 2)
          ra (lower-1-bool (clone a) env tab adts insts sigs lams rets ncached defs "and/or expects boolean operands" 0)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [rb (lower-1-bool (clone b) env t1 a1 i1 s1 l1 r1 n1 d1 "and/or expects boolean operands" 0)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (if (= kind 0)
                  (lok t2 a2 i2 s2 l2 r2 n2 d2 (HAnd e1 e2))
                  (lok t2 a2 i2 s2 l2 r2 n2 d2 (HOr e1 e2)))))))))))

; --- captures (collect_captures: first-reference pre-order) ---------------------

(deftype CapsRes (CapsRes [caps :- Caps seen :- Sids]))

(defn hv-a [e :- HExpr] :- HExpr
  (match e
    (HConstI64 [v] (HConstI64 0))
    (HConstF64 [v] (HConstI64 0))
    (HConstB [v] (HConstI64 0))
    (HVar [name] (HConstI64 0))
    (HStrLit [v] (HConstI64 0))
    (HVecLit [el vals] (HConstI64 0))
    (HBinW [op a b ty] (HConstI64 0))
    (HBinF [op a b] (HConstI64 0))
    (HCmpW [op a b ty] (HConstI64 0))
    (HStrCmp [pol a b] (HConstI64 0))
    (HStrOrd [op a b] (HConstI64 0))
    (HICast [e from to] (clone e))
    (HCount [e] (clone e))
    (HToStr [e ty] (clone e))
    (HStrCat [args] (HConstI64 0))
    (HSubs [s a b] (clone s))
    (HSplit [s sep] (clone s))
    (HJoin [sep xs] (clone sep))
    (HStrNth [s idx res] (clone s))
    (HCharStr [e] (clone e))
    (HGet [src idx dflt ty res] (clone src))
    (HConj [v x el inplace] (clone v))
    (HIf [c t e ty] (clone c))
    (HAnd [a b] (clone a))
    (HOr [a b] (clone a))
    (HNot [e] (clone e))
    (HAbs [e ty] (clone e))
    (HMin [a b ty] (clone a))
    (HMax [a b ty] (clone a))
    (HSeq [es] (HConstI64 0))
    (HLet [binds body frees] (HConstI64 0))
    (HLoop [binds ty body] (HConstI64 0))
    (HRecur [args] (HConstI64 0))
    (HCtor [adt variant args] (HConstI64 0))
    (HMatch [scrut arms ty] (clone scrut))
    (HClone [e] (clone e))
    (HDrop [e] (clone e))
    (HClosure [sig mangled params caps body] (HConstI64 0))
    (HClosureCall [f args sig] (clone f))
    (HCall [name args] (HConstI64 0))
    (HSlurp [p] (clone p))
    (HSpit [path data] (clone path))
    (HArgs [] (HConstI64 0))
    (HExit [e] (clone e))
    (HParseNum [s int res] (clone s))
))

