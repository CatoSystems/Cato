    (HRecur [args] (HANil))
    (HCtor [adt variant args] (HANil))
    (HMatch [scrut arms ty] (clone arms))
    (HClone [e] (HANil))
    (HDrop [e] (HANil))
    (HClosure [sig mangled params caps body] (HANil))
    (HClosureCall [f args sig] (HANil))
    (HCall [name args] (HANil))
    (HSlurp [p] (HANil))
    (HSpit [path data] (HANil))
    (HArgs [] (HANil))
    (HExit [e] (HANil))
    (HParseNum [s int res] (HANil))))
(defn collect-caps [e :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [tag (h-tag (clone e))]
    (cond
      (= tag 3)  ; Var
      (let [v (name-of e)]
        (if (or (sids-has (clone params) v) (sids-has (clone seen) v))
          (CapsRes caps seen)
          (if (te-has (clone env) v)
            (CapsRes (CCons v (te-get (clone env) v) 1 caps) (SCons v seen))
            (CapsRes caps seen)))))
      (= tag 22)  ; If
      (let [r1 (collect-caps (hv-a e) env params seen caps)]
        (match r1
          (CapsRes [c2 s2]
            (let [r2 (collect-caps (hv-b e) env params c2 s2)]
              (match r2
                (CapsRes [c3 s3] (collect-caps (hv-c e) env params c3 s3)))))))
      (= tag 23) (cap-pair e env params seen caps)   ; And
      (= tag 24) (cap-pair e env params seen caps)   ; Or
      (= tag 27) (cap-pair e env params seen caps)   ; Min
      (= tag 28) (cap-pair e env params seen caps)   ; Max
      (= tag 6)  (cap-pair e env params seen caps)   ; BinW
      (= tag 7)  (cap-pair e env params seen caps)   ; BinF
      (= tag 8)  (cap-pair e env params seen caps)   ; CmpW
      (= tag 9)  (cap-pair e env params seen caps)   ; StrCmp
      (= tag 10) (cap-pair e env params seen caps)   ; StrOrd
      (= tag 12) (cap-un e env params seen caps)     ; Count
      (= tag 26) (cap-un e env params seen caps)     ; Abs
      (= tag 25) (cap-un e env params seen caps)     ; Not
      (= tag 35) (cap-un e env params seen caps)     ; Clone
      (= tag 36) (cap-un e env params seen caps)     ; Drop
      (= tag 11) (cap-un e env params seen caps)     ; ICast
      (= tag 13) (cap-un e env params seen caps)     ; ToStr
      (= tag 19) (cap-un e env params seen caps)     ; CharStr
      (= tag 40) (cap-un e env params seen caps)     ; Slurp
      (= tag 43) (cap-un e env params seen caps)     ; Exit
      (= tag 14) (cap-kids e env params seen caps)   ; StrCat
      (= tag 29) (cap-kids e env params seen caps)   ; Seq
      (= tag 33) (cap-kids e env params seen caps)   ; Ctor
      (= tag 39) (cap-kids e env params seen caps)   ; Call
      (= tag 38) (cap-f-args e env params seen caps) ; ClosureCall
      (= tag 30)  ; Let: bind values then body
      (cap-binds (binds-of e) (hv-b e) env params seen caps)
      (= tag 15) (cap-triple e env params seen caps) ; Subs
      (= tag 16) (cap-pair e env params seen caps)   ; Split
      (= tag 17) (cap-pair e env params seen caps)   ; Join
      (= tag 18) (cap-pair e env params seen caps)   ; StrNth
      (= tag 20)  ; Get
      (let [r1 (collect-caps (hv-a e) env params seen caps)]
        (match r1
          (CapsRes [c2 s2]
            (let [r2 (collect-caps (hv-b e) env params c2 s2)]
              (match r2
                (CapsRes [c3 s3]
                  (if (hes-null (hv-c e))
                    (CapsRes c3 s3)
                    (collect-caps (hv-c e) env params c3 s3))))))))
      (= tag 21) (cap-pair e env params seen caps)   ; Conj
      (= tag 34)  ; Match: scrut + arm bodies
      (let [r1 (collect-caps (hv-a e) env params seen caps)]
        (match r1
          (CapsRes [c2 s2] (cap-arms (arms-of e) c2 s2 env params))))
      (= tag 41)  ; Spit
      (let [r1 (collect-caps (hv-a e) env params seen caps)]
        (match r1
          (CapsRes [c2 s2] (collect-caps (hv-b e) env params c2 s2))))
      (CapsRes caps seen)))

(defn cap-pair [e :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-2 (hv-a e) (hv-b e) env params seen caps))

(defn cap-2 [a :- HExpr b :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps a env params seen caps)]
    (match r1
      (CapsRes [c2 s2] (collect-caps b env params c2 s2)))))

(defn cap-un [e :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (collect-caps (hv-a e) env params seen caps))

(defn cap-kids [e :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match e
    (HStrCat [args] (cap-kids-2 args env params seen caps))
    (HSeq [es] (cap-kids-2 es env params seen caps))
    (HCtor [adt variant args] (cap-kids-2 args env params seen caps))
    (HCall [name args] (cap-kids-2 args env params seen caps))
    (o-caps)))

(defn cap-kids-2 [es :- HExprs env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match es
    (HENil [] (CapsRes caps seen))
    (HECons [kid next]
      (let [r (collect-caps kid env params seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-kids-2 next env params c2 s2)))))))

(defn cap-f-args [e :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match e
    (HClosureCall [f args sig]
      (let [r1 (collect-caps f env params seen caps)]
        (match r1
          (CapsRes [c2 s2] (cap-kids-2 args env params c2 s2)))))
    (o-caps)))

(defn cap-triple [e :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-3 (hv-a e) (hv-b e) (hv-c e) env params seen caps))

(defn cap-3 [a :- HExpr b :- HExpr c :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps a env params seen caps)]
    (match r1
      (CapsRes [c2 s2]
        (let [r2 (collect-caps b env params c2 s2)]
          (match r2
            (CapsRes [c3 s3] (collect-caps c env params c3 s3))))))))

(defn cap-binds [binds :- Binds body :- HExpr env :- TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match binds
    (BNil [] (collect-caps body env params seen caps))
    (BCons [name v ty next]
      (let [r (collect-caps v env params seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-binds next body env params c2 s2)))))))

(defn cap-arms [arms :- HArms caps :- Caps seen :- Sids env :- TyEnv params :- Sids] :- CapsRes
  (match arms
    (HANil [] (CapsRes caps seen))
    (HACons [variant binders body next]
      (let [r (collect-caps body env params seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-arms next c2 s2 env params)))))))

; --- closures -------------------------------------------------------------------

; (fn [x :- ty ...] body) — params via the sym grammar with an EMPTY
; declared-ADT table (the seed's rule); captures by first reference.
(defn lower-closure [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                    insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                    ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr "fn expects (fn [params] <body>)")
    (let [pvec (asts-idx (clone items) 1)]
      (if (not (= (ast-tag (clone pvec)) 6))
        (LErr "fn params must be a vector")
        (let [rp (closure-params (ast-kids-of (clone pvec)) 0 (PNil) (PS tab (DLNil) adts sigs (SNil) ""))]
          (match rp
            (PParRes [ps2 params]
              (if (ps-failed ps2)
                (LErr (ps-err-msg ps2))
                (match ps2
                  (PS [t2 d2 a2 s2 y2 e2]
                    (let [body (asts-idx (clone items) 2)
                          env2 (binds-of-params params)
                          rb (lower-1 (clone body) env2 t2 a2 i2 s2 l2 r2 n2 d2)]
                      (match rb
                        (LErr [msg] (LErr msg))
                        (LOk [t3 a3 i3 s3 l3 r3 n3 d3 body2]
                          (let [ret (ty-of (clone body2) env2 r3 s3)
                                pnames (plist-names params)
                                rc (collect-caps (clone body2) env (SNil) (SNil) (CNil))]
                            (match rc
                              (CapsRes [caps seen]
                                ; dedup sig structurally; index = Ty::Fn payload
                                (let [ptys (plist-tys params)
                                      rs (register-sig2 s3 ptys ret)]
                                  (match rs
                                    (PTyRes [ps4 sig]
                                      (match ps4
                                        (PS [t4 d4 a4 s4 y4 e4]
                                          (if (ps-failed ps4)
                                            (LErr (ps-err-msg ps4))
                                            (let [midx (lams-depth s4)
                                                  rm (intern1 t4 (str "lambda_" midx))]
                                              (match rm
                                                (I1Res [t5 mangled]
                                                  (lok t5 a4 i4 s4 (lams-append s4 (Lam mangled caps params ret body2))
                                                       r3 n3 d4
                                                       (HClosure sig mangled params caps body2)))))))))))))))))))))))))))

(defn plist-tys [ps :- PList] :- TyList
  (match ps
    (PCons [h t]
      (match h
        (Param [name ty] (TyCons ty (plist-tys (clone t))))))
    (PNil [] (TyNil))))

; register-sig over the plain tables (no PS err threading needed here)
(defn register-sig2 [sigs :- Sigs params :- TyList ret :- Ty] :- PTyRes
  (let [i (sigs-find sigs params ret 0)]
    (if (>= i 0)
      (PTyRes (PS [] (DLNil) (ATNil) sigs (SNil) "") (t-fn i))
      (PTyRes (PS [] (DLNil) (ATNil) (SGCons (Sig params ret) sigs) (SNil) "")
              (t-fn (sigs-depth sigs))))))

(defn closure-params [els :- Asts i :- i64 acc :- PList ps :- PS] :- PParRes
  (if (>= i (asts-depth (clone els)))
    (PParRes ps (plist-rev acc (PNil)))
    (let [nm (asts-idx (clone els) i)
          sep (asts-idx (clone els) (+ i 1))]
      (if (not (= (ast-tag (clone nm)) 1))
        (PParRes (ps-err ps "fn param must be a symbol") (PNil))
        (if (not (and (= (ast-tag (clone sep)) 1) (= (ast-sid-of (clone sep)) (s-sep))))
          (PParRes (ps-err ps (str "fn param " (node-str nm (ps-tab ps)) " needs a type annotation in this slice (x :- i64)")) (PNil))
          (let [tyn (asts-idx (clone els) (+ i 2))
                rt (parse-ty-sym-str ps (node-str tyn (ps-tab ps)))]
            (match rt
              (PTyRes [ps2 ty]
                (if (ps-failed ps2)
                  (PParRes ps2 (PNil))
                  (closure-params els (+ i 3) (PCons (Param (ast-sid-of (clone nm)) ty) acc) ps2))))))))))

; --- loop / recur -----------------------------------------------------------------

; loop binding values, sequential scoping
(defn lower-loop-binds [binds :- Asts i :- i64 n :- i64 env :- TyEnv acc :- Binds
                       tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                       lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns] :- LBRes
  (if (>= i n)
    (LBRes tab adts insts sigs lams rets ncached defs env acc)
    (let [nm (asts-idx (clone binds) i)
          sep (asts-idx (clone binds) (+ i 1))]
      (if (not (= (ast-tag (clone nm)) 1))
        (LBErr "loop binding name must be a symbol")
        (if (not (and (= (ast-tag (clone sep)) 1) (= (ast-sid-of (clone sep)) (s-sep))))
          (LBErr (str "loop binding " (node-str nm tab) " needs a type ascription (x :- ty init) — loop variables are typed, not inferred"))
          (let [tyn (asts-idx (clone binds) (+ i 2))
                initn (asts-idx (clone binds) (+ i 3))
                ra (resolve-ann-ty tyn tab adts sigs)]
            (match ra
              (PTyRes [ps2 ty]
                (if (ps-failed ps2)
                  (LBErr (ps-err-msg ps2))
                  (match ps2
                    (PS [t2 d2 a2 s2 y2 e2]
                      (if (not (is-copy-ty (clone ty)))
                        (LBErr (str "loop variable " (node-str nm t2) " has non-Copy type " (ty-name ty) " — loop variables are numeric/bool/str in this slice"))
                        (let [ri (lower-e (clone initn) env ty t2 a2 i2 s2 l2 r2 n2 d2)]
                          (match ri
                            (LErr [msg] (LBErr msg))
                            (LOk [t3 a3 i3 s3 l3 r3 n3 d3 init]
                              (let [it (ty-of (clone init) env r3 s3)]
                                (if (and (not (ty-eq it ty)) (not (and (ty-eq ty (t-f64)) (ty-eq it (t-i64)))))
                                  (LBErr (str "loop binding " (node-str nm t3) " ascribed " (ty-name ty) " but the initial value is " (ty-name it)))
                                  (let [init2 (if (and (ty-eq ty (t-f64)) (ty-eq it (t-i64)))
                                                (HICast init (t-i64) (t-f64))
                                                init)]
                                    (lower-loop-binds binds (+ i 4) n (te-put env (ast-sid-of (clone nm)) ty)
                                                      (BCons (ast-sid-of (clone nm)) init2 ty acc)
                                                      t3 a3 i3 s3 l3 r3 n3 d3)))))))))))))))))))

(defn lower-loop [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns] :- LRes
  (if (< (asts-depth (clone items)) 3)
    (LErr "loop expects (loop [x :- ty init ...] body...)")
    (let [bvec (asts-idx (clone items) 1)]
      (if (not (= (ast-tag (clone bvec)) 6))
        (LErr "loop bindings must be a vector")
        (let [bkids (ast-kids-of (clone bvec))
              rb (lower-loop-binds bkids 0 (asts-depth (clone bkids)) env (BNil)
                                   tab adts insts sigs lams rets ncached defs)]
          (match rb
            (LBErr [msg] (LErr msg))
            (LBRes [t2 a2 i2 s2 l2 r2 n2 d2 env2 binds2]
              ; multiple body forms form an implicit sequence; the last
              ; carries the loop's type
              (let [body-forms (asts-tail (clone items))
                    rb2 (lower-do body-forms env2 (t-none) t2 a2 i2 s2 l2 r2 n2 d2)]
                (match rb2
                  (LErr [msg] (LErr msg))
                  (LOk [t3 a3 i3 s3 l3 r3 n3 d3 body2]
                    (let [ty (ty-of (clone body2) env2 r3 s3)
                          rv (validate-recurs (clone body2) (binds-depth (clone binds2)))]
                      (match rv
                        (LErr [msg] (LErr (str "loop: " msg)))
                        (LOk2 [] (lok t3 a3 i3 s3 l3 r3 n3 d3 (HLoop (binds-rev binds2 (BNil)) ty body2)))))))))))))))

; recur tail-position validation (validate_recurs); LOk2 is a unit-ok
(deftype VRes (LOk2 []) (VErr))


 

(defn validate-recurs-2 [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [tag (h-tag (clone e))]
    (cond
      (= tag 32)  ; Recur
      (if crossed
        (VErr "recur cannot cross a closure boundary")
        (if (not inloop)
          (VErr "recur in this position is not in tail position (recur may end the loop body, an if branch, a match arm, or a let/do tail)")
          (match e
            (HRecur [args]
              (if (= (hes-depth (clone args)) arity)
                (LOk2 [])
                (VErr (str "recur expects " arity " argument(s) to match the loop bindings, got " (hes-depth (clone args)))))))))

      (= tag 22)  ; If: cond is non-tail, branches are tails
      (match e
        (HIf [c t2 e2 ty]
          (let [r1 (validate-recurs-2 c arity false crossed)]
            (match r1
              (VErr [msg] (VErr msg))
              (LOk2 []
                (let [r2 (validate-recurs-2 t2 arity inloop crossed)]
                  (match r2
                    (VErr [msg] (VErr msg))
                    (LOk2 [] (validate-recurs-2 e2 arity inloop crossed))))))))))

      (= tag 30)  ; Let: values non-tail, body tail
      (match e
        (HLet [binds body frees] (validate-let binds body arity inloop crossed)))

      (= tag 29)  ; Seq: all but last non-tail
      (match e
        (HSeq [es] (validate-seq es arity inloop crossed)))

      (= tag 34)  ; Match: scrut non-tail, arm bodies tails
      (match e
        (HMatch [scrut arms ty]
          (let [r1 (validate-recurs-2 scrut arity false crossed)]
            (match r1
              (VErr [msg] (VErr msg))
              (LOk2 [] (validate-arms arms arity inloop crossed))))))

      (= tag 31)  ; nested loop validated itself
      (LOk2 [])

      (= tag 37)  ; Closure: no Recur anywhere inside
      (if (contains-recur (clone e) 0)
        (VErr "recur cannot cross a closure boundary")
        (LOk2 []))

      ; every other form: no Recur anywhere inside
      (if (contains-recur (clone e) 0)
        (VErr "recur in this position is not in tail position (recur may end the loop body, an if branch, a match arm, or a let/do tail)")
        (LOk2 []))))

(defn validate-let [binds :- Binds body :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (match binds
    (BNil [] (validate-recurs-2 body arity inloop crossed))
    (BCons [name v ty next]
      (let [r (validate-recurs-2 v arity false crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-let next body arity inloop crossed)))))))

(defn validate-seq [es :- HExprs arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [restq (asts-null (asts-tail-hes (clone es)))]
    (if restq
      (validate-recurs-2 (hes-head-hes (clone es)) arity inloop crossed)
      (let [r (validate-recurs-2 (hes-head-hes (clone es)) arity false crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-seq (asts-tail-hes (clone es)) arity inloop crossed)))))))

(defn validate-arms [arms :- HArms arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (match arms
    (HANil [] (LOk2 []))
    (HACons [variant binders body next]
      (let [r (validate-recurs-2 body arity inloop crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-arms next arity inloop crossed)))))))

(defn contains-recur [e :- HExpr depth :- i64] :- bool
  (if (> depth 1000)
    false
    (let [tag (h-tag (clone e))]
      (cond
        (= tag 32) true
        (= tag 37) false  ; closures validated separately
        (= tag 22) (match e (HIf [c t2 e2 ty] (or (contains-recur c (+ depth 1)) (or (contains-recur t2 (+ depth 1)) (contains-recur e2 (+ depth 1))))))
        (= tag 30) (match e (HLet [binds body frees] (contains-recur body (+ depth 1))))
        (= tag 29) (match e (HSeq [es] (seq-contains-recur es (+ depth 1))))
        (= tag 34) (match e (HMatch [scrut arms ty] (or (contains-recur scrut (+ depth 1)) (arms-contains-recur arms (+ depth 1)))))
        (= tag 39) (match e (HCall [name args] (kids-contains-recur args (+ depth 1))))
        (= tag 33) (match e (HCtor [adt variant args] (kids-contains-recur args (+ depth 1))))
        (= tag 14) (match e (HStrCat [args] (kids-contains-recur args (+ depth 1))))
        (= tag 23) (match e (HAnd [a b] (or (contains-recur a (+ depth 1)) (contains-recur b (+ depth 1)))))
        (= tag 24) (match e (HOr [a b] (or (contains-recur a (+ depth 1)) (contains-recur b (+ depth 1)))))
        false))))

(defn seq-contains-recur [es :- HExprs depth :- i64] :- bool
  (match es
    (HENil [] false)
    (HECons [kid next] (or (contains-recur kid depth) (seq-contains-recur next depth)))))

(defn arms-contains-recur [arms :- HArms depth :- i64] :- bool
  (match arms
    (HANil [] false)
    (HACons [variant binders body next] (or (contains-recur body depth) (arms-contains-recur next depth)))))

(defn kids-contains-recur [es :- HExprs depth :- i64] :- bool
  (seq-contains-recur es depth))

; --- match (+ :when guards) ------------------------------------------------------

; The guard rewrite (match_lower.rs): an arm (V [b :when g] body) becomes
; (V [b] (if g body (match scrut rest...))) plus a routing (_ (match scrut
; rest...)) — the rest chain is the ORIGINAL Ast tail, so the rewrite
; re-enters lower-match.
(defn lower-match [items :- Asts env :- TyEnv expected :- Ty tab :- (Vector str)
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (< (asts-depth (clone items)) 3)
    (LErr "match expects a scrutinee and at least one arm")
    (match (find-guard (asts-tail (asts-tail (clone items))) 0)
      (GRes [gi garm] (lower-match-g items env expected tab adts insts sigs lams rets ncached defs gi garm))
      (GNone [] (lower-match-plain items env expected tab adts insts sigs lams rets ncached defs)))))

(deftype GRes (GFound [gi :- i64 garm :- Ast]) (GNone []))

; the first arm whose binders contain :when (index within the arm list)
(defn find-guard [arms :- Asts i :- i64] :- GRes
  (match arms
    (KNil [] (GNone))
    (KCons [arm rest]
      (if (arm-has-guard (clone arm))
        (GFound i (clone arm))
        (find-guard (clone rest) (+ i 1))))))

(defn arm-has-guard [arm :- Ast] :- bool
  (match arm
    (AList [vitems at]
      (if (< (asts-depth (clone vitems)) 2)
        false
        (let [bs (asts-idx (clone vitems) 1)]
          (if (not (= (ast-tag (clone bs)) 6))
            false
            (binder-guard (ast-kids-of (clone bs)))))))
    (o-bool)))

(defn o-bool [] :- bool
  false)

(defn binder-guard [bs :- Asts] :- bool
  (match bs
    (KNil [] false)
    (KCons [b rest]
      (or (and (= (ast-tag (clone b)) 1) (= (ast-sid-of (clone b)) (s-whenkw)))
          (binder-guard (clone rest))))))

; index of :within the binder vector, or -1
(defn guard-pos [bs :- Asts i :- i64] :- i64
  (match bs
    (KNil [] -1)
    (KCons [b rest]
      (if (and (= (ast-tag (clone b)) 1) (= (ast-sid-of (clone b)) (s-whenkw)))
        i
        (guard-pos (clone rest) (+ i 1))))))

(defn mk-sp [] :- Span
  (Span 0 0 0))

(defn mk-match-call [scrut :- Ast rest :- Asts] :- Ast
  (AList (KCons (ASym (s-match) (mk-sp)) (KCons (clone scrut) (clone rest))) (mk-sp)))

(defn mk-guard-if [g :- Ast body :- Ast else-ast :- Ast] :- Ast
  (AList (KCons (ASym (s-if) (mk-sp))
          (KCons (clone g) (KCons (clone body) (KCons else-ast (KNil)))))
         (mk-sp)))

(defn arm-head [arm :- Ast] :- Ast
  (asts-idx (ast-kids-of (clone arm)) 0))

(defn arm-binders [arm :- Ast] :- Ast
  (asts-idx (ast-kids-of (clone arm)) 1))

(defn arm-body [arm :- Ast] :- Ast
  (asts-idx (ast-kids-of (clone arm)) 2))

(defn mk-rewritten-arm [garm :- Ast if-body :- Ast] :- Ast
  (AList (KCons (arm-head (clone garm))
          (KCons (AVec (binder-pre (ast-kids-of (arm-binders (clone garm)))) (mk-sp))
          (KCons if-body (KNil))))
         (mk-sp)))

(defn mk-route-arm [match-ast :- Ast] :- Ast
  (AList (KCons (ASym (s-wild) (mk-sp)) (KCons match-ast (KNil))) (mk-sp)))

(defn lower-match-g [items :- Asts env :- TyEnv expected :- Ty tab :- (Vector str)
                    adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                    rets :- TyEnv ncached :- i64 defs :- Defns
                    gi :- i64 garm :- Ast] :- LRes
  (if (not (guard-shape-ok (clone garm)))
    (LErr "guard arms expect (Variant [binders :when cond] body)")
    (let [scrut (asts-idx (clone items) 1)
          rp (lower-1 (clone scrut) env tab adts insts sigs lams rets ncached defs)]
      (match rp
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 probe]
          (let [pt (ty-of (clone probe) env r2 s2)]
            (if (not (= (ty-tag pt) 16))
              (LErr "guard arms require an ADT scrutinee")
              (let [vdef (adts-at a2 (ty-arg pt))
                    rest (asts-tail (asts-drop (clone items) (+ 2 gi)))
                    rest-heads (arm-heads rest)
                    covered (or (sids-has (clone rest-heads) (s-wild))
                                (all-covered rest-heads vdef 0))]
                (if (not covered)
                  (LErr (str "guard arm " (sym-str tab (asts-head-sid (ast-kids-of (clone garm)))) " falls through, but the later arms do not cover every variant (add a _ arm)"))
                  (let [arms0 (asts-drop (clone items) 2)
                        before-g (asts-take arms0 gi (KNil))
                        inner (mk-match-call (asts-idx (clone items) 1) rest)
                        if-body (mk-guard-if (binder-cond (ast-kids-of (arm-binders (clone garm))))
                                             (arm-body (clone garm))
                                             inner)
                        rewritten (mk-rewritten-arm (clone garm) if-body)
                        route (mk-route-arm (mk-match-call (asts-idx (clone items) 1) rest))
                        next-arms (asts-append (asts-append before-g rewritten) route)
                        next-items (KCons (ASym (s-match) (mk-sp)) (KCons (clone scrut) next-arms))]
                    (lower-match next-items env expected tab adts insts sigs lams rets ncached defs)))))))))))

(defn binder-pre [bs :- Asts] :- Asts
  ; binders before :when
  (match bs
    (KNil [] (KNil))
    (KCons [b rest]
      (if (and (= (ast-tag (clone b)) 1) (= (ast-sid-of (clone b)) (s-whenkw)))
        (KNil)
        (KCons (clone b) (binder-pre (clone rest)))))))

(defn binder-cond [bs :- Asts] :- Ast
  ; the condition right after :when
  (match bs
    (KNil [] (ANil (Span 0 0 0)))
    (KCons [b rest]
      (if (and (= (ast-tag (clone b)) 1) (= (ast-sid-of (clone b)) (s-whenkw)))
        (asts-idx (clone rest) 0)
        (binder-cond (clone rest))))))

(defn asts-take [ks :- Asts n :- i64 acc :- Asts] :- Asts
  (if (<= n 0)
    (asts-rev acc (KNil))
    (match ks
      (KNil [] (asts-rev acc (KNil)))
      (KCons [kid rest] (asts-take (clone rest) (- n 1) (KCons (clone kid) acc))))))

(defn asts-rev [ks :- Asts acc :- Asts] :- Asts
  (match ks
    (KCons [kid rest] (asts-rev (clone rest) (KCons (clone kid) acc)))
    (KNil [] acc)))

(defn asts-drop-last-n [ks :- Asts n :- i64 acc :- i64] :- Asts
  ; drop everything after the first n elements
  (if (<= n 0)
    (KNil)
    (match ks
      (KNil [] (KNil))
      (KCons [kid rest]
        (if (= n 1)
          (KCons (clone kid) (KNil))
          (KCons (clone kid) (asts-drop-last-n (clone rest) (- n 1) 0)))))))

(defn guard-shape-ok [arm :- Ast] :- bool
  (match arm
    (AList [vitems at]
      (and (= (asts-depth (clone vitems)) 3)
           (let [bs (asts-idx (clone vitems) 1)
                 bs-kids (ast-kids-of (clone bs))
                 wpos (guard-pos bs-kids 0)]
             (and (= (ast-tag (clone bs)) 6)
                  (not (= wpos -1))
                  (= (+ wpos 2) (asts-depth (clone bs-kids)))))))
    (o-bool)))

(defn arm-heads [arms :- Asts] :- Sids
  (match arms
    (KNil [] (SNil))
    (KCons [arm rest]
      (match arm
        (AList [vitems at]
          (SCons (asts-head-sid (clone vitems)) (arm-heads (clone rest))))
        (o-sids)))))

(defn o-sids [] :- Sids
  (SNil))

(defn variant-count [info :- AdtInfo] :- i64
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (vlist-depth (clone variants)))))

(defn all-covered [heads :- Sids info :- AdtInfo i :- i64] :- bool
  (match info
    (AdtInfo [name typarams variants tpl tplargs]
      (if (>= i (vlist-depth (clone variants)))
        true
        (let [vn (match (vlist-at (clone variants) i)
                   (Varnt [vname fields] vname))]
          (if (sids-has (clone heads) vn)
            (all-covered heads info (+ i 1))
            false))))))

; the non-guard path: build the HMatch
(defn lower-match-plain [items :- Asts env :- TyEnv expected :- Ty tab :- (Vector str)
                        adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                        rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (let [scrut (asts-idx (clone items) 1)
        rs (lower-1 (clone scrut) env tab adts insts sigs lams rets ncached defs)]
    (match rs
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 scrut2]
        (let [pt (ty-of (clone scrut2) env r2 s2)]
          (if (not (= (ty-tag pt) 16))
            (LErr "match scrutinee must be an ADT value")
            (let [adt (ty-arg pt)
                  vdef (adts-at a2 adt)
                  ra (match-arms (asts-tail (asts-tail (clone items))) vdef adt env pt t2 a2 i2 s2 l2 r2 n2 d2 (HANil) (SNil) (TyNil) 0 false false)]
              (match ra
                (LErr [msg] (LErr msg))
                (MRes [t3 a3 i3 s3 l3 r3 n3 d3 arms3 tys3 wildcard3 narms]
                  (match (finish-match tys3 wildcard3 narms vdef tab)
                    (VErr [msg] (LErr msg))
                    (LOk2 []
                      (let [merged (merge-arm-tys tys3)]
                        (lok t3 a3 i3 s3 l3 r3 n3 d3 (HMatch scrut2 (arms-rev arms3 (HANil)) merged))))))))))))))

; arms accumulate: (reversed arms chain, arm types in order, wildcard flag)
(deftype MRes (MRes [tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                    lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                    arms :- HArms tys :- TyList wildcard :- bool narms :- i64])
             (MArr [msg :- str]))

(defn rms-rev [arms :- HArms acc :- HArms] :- HArms
  (match arms
    (HANil [] acc)
    (HACons [variant binders body next] (arms-rev (clone next) (HACons variant binders body acc)))))

(defn match-arms [arms :- Asts vdef :- AdtInfo adt :- i64 env :- TyEnv pt :- Ty
                 tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                 acc :- HArms tys :- TyList wildcard :- bool narms :- i64] :- MRes
  (match arms
    (KNil [] (MRes tab adts insts sigs lams rets ncached defs acc tys wildcard narms))
    (KCons [arm rest]
      (let [head (asts-head-sid (ast-kids-of (clone arm)))]
        (if (= head (s-wild))
          ; wildcard arm: (_ body)
          (if wildcard
            (MArr "match has more than one wildcard arm")
            (if (not (= (asts-depth (ast-kids-of (clone arm))) 2))
              (MArr "wildcard arm expects (_ body)")
              (let [bodyn (asts-idx (ast-kids-of (clone arm)) 1)
                    rb (lower-e (clone bodyn) env pt tab adts insts sigs lams rets ncached defs)]
                (match rb
                  (LErr [msg] (MArr msg))
                  (LOk [t2 a2 i2 s2 l2 r2 n2 d2 body2]
                    (let [bt (ty-of (clone body2) env r2 s2)]
                      (match-arms rest vdef adt env pt tab adts insts sigs lams rets ncached defs
                                  (HACons -1 (SNil) body2 acc) (TyCons bt tys) true (+ 1 narms))))))))
          ; variant arm: (V [b1 b2] body)
          (let [vi (variant-index vdef head 0)]
            (if (< vi 0)
              (MArr (str (sym-str tab head) " is not a variant of " (adts-name vdef tab)))
              (let [fields (variant-fields vdef vi)]
                (match-variant-arm arm rest vdef adt vi fields env pt tab adts insts sigs lams rets ncached defs acc tys wildcard narms)))))))))

(defn adts-name [info :- AdtInfo tab :- (Vector str)] :- str
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (sym-str tab name))))

(defn variant-index [info :- AdtInfo name :- i64 i :- i64] :- i64
  (match info
    (AdtInfo [name2 typarams variants tpl tplargs]
      (if (>= i (vlist-depth (clone variants)))
        -1
        (let [vn (match (vlist-at (clone variants) i)
                   (Varnt [vname fields] vname))]
          (if (= vn name) i (variant-index info name (+ i 1))))))))

(defn variant-fields [info :- AdtInfo vi :- i64] :- TyList
  (match info
    (AdtInfo [name typarams variants tpl tplargs]
      (match (vlist-at (clone variants) vi)
        (Varnt [vname fields] (clone fields))))))

(defn match-variant-arm [arm :- Ast rest :- Asts vdef :- AdtInfo adt :- i64 vi :- i64
                        fields :- TyList env :- TyEnv pt :- Ty tab :- (Vector str)
                        adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                        rets :- TyEnv ncached :- i64 defs :- Defns
                        acc :- HArms tys :- TyList wildcard :- bool narms :- i64] :- MRes
  (match arm
    (AList [vitems at]
      (if (not (= (asts-depth (clone vitems)) 3))
        (MArr (str "match arm " (sym-str tab (asts-head-sid (clone vitems))) " expects (" (sym-str tab (asts-head-sid (clone vitems))) " [binders...] body)"))
        (let [bs (asts-idx (clone vitems) 1)]
          (if (not (= (ast-tag (clone bs)) 6))
            (MArr (str "match arm " (sym-str tab (asts-head-sid (clone vitems))) " binders must be a vector"))
            (if (not (= (asts-depth (ast-kids-of (clone bs))) (tys-depth (clone fields))))
              (MArr (str "variant " (adts-name vdef tab) " has " (tys-depth (clone fields)) " field(s) but the arm binds " (asts-depth (ast-kids-of (clone bs)))))
              ; binders: wildcard `_` gets a gensym
              (let [rb (match-binders (ast-kids-of (clone bs)) (clone fields) 0 env (SNil) (TENil) (SNil) tab adts insts ncached)]
                (match rb
                  (MBErr [msg] (MArr msg))
                  (MBRes [t3 a3 i3 s3 n3 env3 binders3]
                    (let [bodyn (asts-idx (clone vitems) 2)
                          rb2 (lower-e (clone bodyn) env3 pt t3 a3 i3 s3 l3 r3 n3 d3)]
                      (match rb2
                        (LErr [msg] (MArr msg))
                        (LOk [t4 a4 i4 s4 l4 r4 n4 d4 body2]
                          (let [bt (ty-of (clone body2) env3 r4 s4)]
                            (match-arms rest vdef adt env pt tab adts insts sigs lams rets ncached defs
                                        (HACons vi binders3 body2 acc) (TyCons bt tys) wildcard (+ 1 narms)))))))))))))))
    (o-marr))

(defn omarr [] :- MRes
  (MArr "match arm must be a list"))

(deftype MBRes (MBRes [tab :- (Vector str) adts :- AdtTab insts :- IMap ncached :- i64
                      env :- TyEnv binders :- Sids])
              (MBErr [msg :- str]))

(defn match-binders [bs :- Asts fields :- TyList k :- i64 env :- TyEnv acc :- Sids
                    seen :- Sids tab :- (Vector str) adts :- AdtTab insts :- IMap
                    ncached :- i64] :- MBRes
  (if (>= k (asts-depth (clone bs)))
    (MBRes tab adts insts ncached env (sids-rev acc (SNil)))
    (let [b (asts-idx (clone bs) k)
          fty (tys-idx (clone fields) k)]
      (if (not (= (ast-tag (clone b)) 1))
        (MBErr (str "match arm binder must be a symbol"))
        (let [bn (ast-sid-of (clone b))]
          (if (= bn (s-wild))
            ; unique gensym, never referenced by the arm body
            (let [g (intern1 tab (str "_wild" (+ k ncached)))]
              (match g
                (I1Res [tab2 gsid]
                  (match-binders bs fields (+ k 1) env acc (SCons gsid seen) tab2 adts insts ncached))))
            (match-binders bs fields (+ k 1) (te-put env bn fty) (SCons bn acc) (SCons bn seen) tab adts insts ncached)))))))

; exhaustiveness + the f64-promoting arm merge (finish_match)
; exhaustiveness: a wildcard arm present, or the arm count (each variant
; at most once — the seed's duplicate check is message-only here) covers
; every variant. Missing-variant NAMES in the diagnostic are a nicety the
; byte contract does not pin.
(defn finish-match [tys :- TyList wildcard :- bool narms :- i64 vdef :- AdtInfo tab :- (Vector str)] :- VRes
  (if (not wildcard)
    (if (< narms (vlist-depth-of vdef))
      (VErr (str "match on " (adts-name vdef tab) " does not cover: (add arms or a _ wildcard)"))
      (LOk2 []))
    (LOk2 [])))

(defn vlist-depth-of [info :- AdtInfo] :- i64
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (vlist-depth (clone variants)))))

; the arm merge (the seed's f64 promotion): f64 wins over i64; all-else
; must agree exactly
(defn merge-arm-tys [tys :- TyList] :- Ty
  (if (tys-has-f64 tys)
    (t-f64)
    (tys-idx tys 0)))

(defn tys-has-f64 [tys :- TyList] :- bool
  (match tys
    (TyNil [] false)
    (TyCons [h t] (or (ty-eq h (t-f64)) (tys-has-f64 (clone t))))))



; --- constructor resolution ------------------------------------------------------

; find a variant constructor among DECLARED templates (instances share
; their template's ctors and are never resolved directly)
(defn find-variant [ts :- AdtTab name :- i64] :- FVRes
  (find-variant-2 ts name 0 0))

(deftype FVRes (FVFound [adt :- i64 variant :- i64 fields :- TyList]) (FVMiss))

(defn find-variant-2 [ts :- AdtTab name :- i64 ai :- i64 vi :- i64] :- FVRes
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [aname typarams variants tpl tplargs]
          (if (not (= tpl -1))
            (find-variant-2 (clone t) name (+ ai 1) 0)
            (if (>= vi (vlist-depth (clone variants)))
              (find-variant-2 (clone t) name (+ ai 1) 0)
              (let [v (vlist-at (clone variants) vi)]
                (match v
                  (Varnt [vname fields]
                    (if (= vname name)
                      (FVFound ai vi (clone fields))
                      (find-variant-2 ts name ai (+ vi 1)))))))))))
    (ATNil [] FVMiss)))

; lower a ctor call: fields unify against the template; nullary ctors
; infer from the expected type's instance
(defn lower-ctor [fv :- FVRes items :- Asts env :- TyEnv expected :- Ty
                 tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (match fv
    (FVMiss (LErr "internal: ctor miss"))
    (FVFound [adt variant fields]
      (let [tpl-params (adts-tparams adts adt)
            ; expected pinning: an instance of this template takes its fields
            inst-exp (if (and (> tpl-params 0) (= (ty-tag expected) 16))
                       (instance-of-template adts (ty-arg expected) adt)
                       -1)]
        (if (>= inst-exp 0)
          (lower-ctor-fields items adt variant (instance-fields adts inst-exp variant) env expected
                             tab adts insts sigs lams rets ncached defs 0)
          (lower-ctor-fields items adt variant fields env expected
                             tab adts insts sigs lams rets ncached defs 0))))))

(defn adts-tparams [ts :- AdtTab i :- i64] :- i64
  (match (adts-at ts i)
    (AdtInfo [name typarams variants tpl tplargs] (sids-depth (clone typarams)))))

; is instance j an instance of template tpl? -> j else -1
(defn instance-of-template [ts :- AdtTab j :- i64 tpl :- i64] :- i64
  (match (adts-at ts j)
    (AdtInfo [name typarams variants vtpl tplargs]
      (if (= vtpl tpl) j -1))))

(defn instance-fields [ts :- AdtTab j :- i64 vi :- i64] :- TyList
  (match (adts-at ts j)
    (AdtInfo [name typarams variants vtpl tplargs]
      (match (vlist-at (clone variants) vi)
        (Varnt [vname fs] (clone fs))))))

(defn lower-ctor-fields [items :- Asts adt :- i64 variant :- i64 fields :- TyList
                        env :- TyEnv expected :- Ty tab :- (Vector str) adts :- AdtTab
                        insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                        ncached :- i64 defs :- Defns k :- i64] :- LRes
  (if (not (= (tys-depth (clone fields)) (- (asts-depth (clone items)) 1)))
    (LErr (str "constructor expects " (tys-depth (clone fields)) " argument(s), got " (- (asts-depth (clone items)) 1)))
    (if (>= k (tys-depth (clone fields)))
      (lok tab adts insts sigs lams rets ncached defs (HCtor adt variant (HENil)))
      (let [argn (asts-idx (clone items) (+ k 1))
            fty (tys-idx (clone fields) k)
            ra (lower-e (clone argn) env fty tab adts insts sigs lams rets ncached defs)]
        (match ra
          (LErr [msg] (LErr msg))
          (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
            (let [rk (lower-ctor-fields items adt variant fields env expected t2 a2 i2 s2 l2 r2 n2 d2 (+ k 1))]
              (match rk
                (LErr [msg] (LErr msg))
                (LOk [t3 a3 i3 s3 l3 r3 n3 d3 rest-args]
                  (lok t3 a3 i3 s3 l3 r3 n3 d3
                       (HCtor adt variant (HECons e2 rest-args))))))))))))

; --- the call arm ---------------------------------------------------------------

(defn lower-call [head :- i64 items :- Asts env :- TyEnv expected :- Ty
                 tab :- (Vector str) adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  ; WIP: the call arm must, in the seed's order — (1) closure-value calls
  ; from env, (2) constructor resolution (find-variant above), (3) generic
  ; dispatch via `instantiate` (mono; registers cache before body), (4)
  ; even?, (5) unknown-function error, (6) the plain HCall. Argument
  ; threading follows lower-call-args below.
  (LErr "internal: call arm lands with the dispatch"))

(defn lower-call-args [items :- Asts i :- i64 env :- TyEnv tab :- (Vector str)
                      adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                      rets :- TyEnv ncached :- i64 defs :- Defns acc :- HExpr] :- LRes
  (if (>= i (asts-depth (clone items)))
    (lok tab adts insts sigs lams rets ncached defs acc)
    (let [a (asts-idx (clone items) i)
          r (lower-1 (clone a) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (match acc
            (HCall [name args]
              (lower-call-args items (+ i 1) env t2 a2 i2 s2 l2 r2 n2 d2 (HCall name (HECons e2 args))))
            (o-lca))))))

)
; --- the head dispatch (lower_expect's list arm) ---------------------------------

(defn lower-list [a :- Ast env :- TyEnv expected :- Ty tab :- (Vector str)
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (match a
    (AList [kids at]
      (let [h (asts-head-sid (clone kids))]
        (cond
          (= h (s-do))
          (lower-do (asts-tail (clone kids)) env expected tab adts insts sigs lams rets ncached defs)

          (= h (s-fn))
          (lower-closure (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-let))
          (lower-let (asts-tail (clone kids)) env expected tab adts insts sigs lams rets ncached defs)

          (= h (s-if))
          (lower-if (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-notform))
          (lower-not (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-abs))
          (lower-abs (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-min))
          (lower-minmax 0 (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-max))
          (lower-minmax 1 (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-match))
          (lower-match (clone kids) env expected tab adts insts sigs lams rets ncached defs)

          (= h (s-loop))
          (lower-loop (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-recur))
          (lower-recur (asts-tail (clone kids)) env tab adts insts sigs lams rets ncached defs)

          (= h (s-and))
          (lower-andor 0 (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-or))
          (lower-andor 1 (clone kids) env tab adts insts sigs lams rets ncached defs)

          (or (= h (s-eq)) (= h (s-ne)) (= h (s-lt)) (= h (s-gt)) (= h (s-le)) (= h (s-ge)))
          (lower-cmp (cmp-op h) (clone kids) env tab adts insts sigs lams rets ncached defs)

          (or (= h (s-add)) (= h (s-sub)) (= h (s-mul)) (= h (s-div)))
          (lower-arith (arith-op h) (clone kids) env tab adts insts sigs lams rets ncached defs)

          (or (= h (s-f64)) (= h (s-f32)) (= h (s-i8)) (= h (s-i16)) (= h (s-i32))
              (= h (s-u8)) (= h (s-u16)) (= h (s-u32)) (= h (s-u64)) (= h (s-usize)))
          (lower-cast h (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-getform))
          (lower-get (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-conjform))
          (lower-conj (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-count))
          (lower-count (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-strform))
          (lower-str (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-subs))
          (lower-subs (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-split))
          (lower-split (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-join))
          (lower-join (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-nth))
          (lower-nth (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-charstr))
          (lower-charstr (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-clone))
          (lower-clone (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-dropform))
          (lower-drop (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-slurp))
          (lower-slurp (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-spit))
          (lower-spit (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-args))
          (lok tab adts insts sigs lams rets ncached defs (HArgs))

          (= h (s-exit))
          (lower-exit (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-parsei64))
          (lower-parse 1 (clone kids) env tab adts insts sigs lams rets ncached defs)

          (= h (s-parsef64))
          (lower-parse 0 (clone kids) env tab adts insts sigs lams rets ncached defs)

          (or (= h (s-printstr)) (= h (s-printstring)) (= h (s-printf64)) (= h (s-printi64)))
          (lower-print h (clone kids) env tab adts insts sigs lams rets ncached defs)

          (or (= h (s-veci64)) (= h (s-vecf64)))
          (lower-vec-builtin h (clone kids) tab adts insts sigs lams rets ncached defs)

          (or (= h (s-reduce)) (= h (s-for)) (= h (s-parallel)) (= h (s-map)) (= h (s-filter))
              (= h (s-doseq)))
          (LErr (str "unsupported form " (sym-str tab h)))

          (lower-call h (clone kids) env expected tab adts insts sigs lams rets ncached defs)))))
    (o-lower-list))

(defn o-lower-list [] :- LRes
  (LErr "internal: lower-list on a non-list"))

; --- builtin arms -----------------------------------------------------------------

(defn lower-arith [op :- i64 items :- Asts env :- TyEnv tab :- (Vector str)
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr "binary op expects 2 operands")
    (let [a (asts-idx (clone items) 1)
          ra (lower-1 (clone a) env tab adts insts sigs lams rets ncached defs)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [b (asts-idx (clone items) 2)
                rb (lower-1 (clone b) env t1 a1 i1 s1 l1 r1 n1 d1)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (match (promote-bin op e1 e2 env r2 s2)
                  (LRes1Err [msg] (LErr msg))
                  (LRes1Ok [e3] (lok t2 a2 i2 s2 l2 r2 n2 d2 e3)))))))))))

(defn cast-target [h :- i64] :- Ty
  (cond
    (= h (s-f64)) (t-f64)
    (= h (s-f32)) (t-f32)
    (= h (s-i8)) (t-i8)
    (= h (s-i16)) (t-i16)
    (= h (s-i32)) (t-i32)
    (= h (s-u8)) (t-u8)
    (= h (s-u16)) (t-u16)
    (= h (s-u32)) (t-u32)
    (= h (s-u64)) (t-u64)
    (t-usize)))

(defn lower-cast [h :- i64 items :- Asts env :- TyEnv tab :- (Vector str)
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "cast expects exactly 1 argument")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [src (ty-of (clone e2) env r2 s2)
                target (cast-target h)]
            (cond
              (ty-eq src target) (lok t2 a2 i2 s2 l2 r2 n2 d2 e2)
              (is-numeric-ty src) (lok t2 a2 i2 s2 l2 r2 n2 d2 (HICast e2 src target))
              (LErr (str "cast expects a numeric operand, got " (ty-name src))))))))))

(defn lower-recur [args :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns] :- LRes
  (lower-recur-2 args (HENil) env tab adts insts sigs lams rets ncached defs))

(defn lower-recur-2 [args :- Asts acc :- HExprs env :- TyEnv tab :- (Vector str)
                    adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                    rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (asts-null (clone args))
    (lok tab adts insts sigs lams rets ncached defs (HRecur (hes-rev acc (HENil))))
    (let [r (lower-1 (asts-idx (clone args) 0) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lower-recur-2 (asts-tail (clone args)) (HECons e2 acc) env t2 a2 i2 s2 l2 r2 n2 d2))))))

(defn lower-count [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "count expects exactly 1 argument")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HCount e2)))))))

(defn lower-clone [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "clone expects 1 argument")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HClone e2)))))))

(defn lower-drop [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "drop expects 1 argument")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HDrop e2)))))))

(defn lower-charstr [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                    insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                    ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "char->str expects exactly 1 argument")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of (clone e2) env r2 s2) (t-i64)))
            (LErr "char->str expects an i64 byte value")
            (lok t2 a2 i2 s2 l2 r2 n2 d2 (HCharStr e2))))))))

(defn lower-slurp [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "slurp expects (slurp <path>)")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of (clone e2) env r2 s2) (t-str)))
            (LErr "slurp path must be a string")
            (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSlurp e2))))))))

(defn lower-spit [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr "spit expects (spit <path> <content>)")
    (let [r1 (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r1
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 p]
          (let [r2 (lower-1 (asts-idx (clone items) 2) env t1 a1 i1 s1 l1 r1 n1 d1)]
            (match r2
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 d]
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSpit p d))))))))))

(defn lower-exit [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "exit expects (exit <status>)")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of (clone e2) env r2 s2) (t-i64)))
            (LErr "exit status must be i64")
            (lok t2 a2 i2 s2 l2 r2 n2 d2 (HExit e2))))))))

(defn lower-parse [intf :- i64 items :- Asts env :- TyEnv tab :- (Vector str)
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "parse expects (parse <s>)")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of (clone e2) env r2 s2) (t-str)))
            (LErr "parse expects a string")
            (let [want (if (= intf 1) (t-i64) (t-f64))
                  oi (option-instance want t2 a2 s2)]
              (match oi
                (OIRes [t3 a3 idx]
                  (lok t3 a3 i2 s2 l2 r2 n2 d2 (HParseNum e2 intf (t-adt idx))))))))))))

(defn lower-print [h :- i64 items :- Asts env :- TyEnv tab :- (Vector str)
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 2))
    (LErr "print-* expects exactly 1 argument")
    (let [r (lower-1 (asts-idx (clone items) 1) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (and (= h (s-printstr)) (not (ty-eq (ty-of (clone e2) env r2 s2) (t-str))))
            (LErr "print-str expects a string")
            (lok t2 a2 i2 s2 l2 r2 n2 d2 (HCall h (HECons e2 (HENil))))))))))

(defn lower-vec-builtin [h :- i64 items :- Asts tab :- (Vector str) adts :- AdtTab
                        insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                        ncached :- i64 defs :- Defns] :- LRes
  (let [els (asts-tail items)]
    (if (= h (s-veci64))
      (if (kids-all-int (clone els))
        (lok tab adts insts sigs lams rets ncached defs (HVecLit 0 (kids-i64s (clone els) (VVNil))))
        (LErr "vec-i64 elements must be i64 literals"))
      (if (kids-all-num (clone els))
        (lok tab adts insts sigs lams rets ncached defs (HVecLit 1 (kids-f64s (clone els) (VVNil))))
        (LErr "vec-f64 elements must be numeric literals")))))

(defn lower-str [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns] :- LRes
  (if (< (asts-depth (clone items)) 2)
    (LErr "str expects at least one argument")
    (lower-str-args (asts-tail (clone items)) (HENil) env tab adts insts sigs lams rets ncached defs)))

(defn lower-str-args [els :- Asts acc :- HExprs env :- TyEnv tab :- (Vector str)
                     adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                     rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (if (asts-null (clone els))
    (let [args (hes-rev acc (HENil))]
      (lok tab adts insts sigs lams rets ncached defs (HStrCat args)))
    (let [r (lower-1 (asts-idx (clone els) 0) env tab adts insts sigs lams rets ncached defs)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [t (ty-of (clone e2) env r2 s2)]
            (if (or (ty-eq t (t-str)) (is-numeric-ty (clone t)) (ty-eq t (t-bool)))
              (let [e3 (if (ty-eq t (t-str)) e2 (HToStr e2 t))]
                (lower-str-args (asts-tail (clone els)) (HECons e3 acc) env t2 a2 i2 s2 l2 r2 n2 d2))
              (LErr (str "str arguments must be strings, numbers or bools, got " (ty-name t))))))))))

(defn lower-subs [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 4))
    (LErr "subs expects (subs <s> <start> <end>)")
    (lower-3-to items 0 env tab adts insts sigs lams rets ncached defs)))

(defn lower-split [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr "split expects (split <s> <sep>)")
    (lower-2-to items 0 env tab adts insts sigs lams rets ncached defs "split" 16)))

(defn lower-join [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr "join expects (join <sep> <strs>)")
    (lower-join-2 items env tab adts insts sigs lams rets ncached defs)))

(defn lower-get [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns] :- LRes
  (let [n (asts-depth (clone items))]
    (if (and (not (= n 3)) (not (= n 4)))
      (LErr "get expects (get <vec> <idx>) or (get <vec> <idx> <default>)")
      (let [src (asts-idx (clone items) 1)
            rs (lower-1 (clone src) env tab adts insts sigs lams rets ncached defs)]
        (match rs
          (LErr [msg] (LErr msg))
          (LOk [t1 a1 i1 s1 l1 r1 n1 d1 src2]
            (let [st (ty-of (clone src2) env r1 s1)]
              (if (not (= (ty-tag st) 15))
                (LErr (str "get source must be a vector, got " (ty-name st)))
                (let [elc (ty-arg st)
                      et (elem-ty elc)
                      idx (asts-idx (clone items) 2)
                      ri (lower-1 (clone idx) env t1 a1 i1 s1 l1 r1 n1 d1)]
                  (match ri
                    (LErr [msg] (LErr msg))
                    (LOk [t2 a2 i2 s2 l2 r2 n2 d2 idx2]
                      (if (= n 4)
                        (let [dflt (asts-idx (clone items) 3)
                              rd (lower-1 (clone dflt) env t2 a2 i2 s2 l2 r2 n2 d2)]
                          (match rd
                            (LErr [msg] (LErr msg))
                            (LOk [t3 a3 i3 s3 l3 r3 n3 d3 d2]
                              (lok t3 a3 i3 s3 l3 r3 n3 d3 (HGet src2 idx2 d2 et (t-none))))))
                        (if (= elc 2)
                          (LErr "Option get over (Vector str) is not supported — use (get v i default)")
                          (let [oi (option-instance et t2 a2 i2 s2)]
                            (match oi
                              (OIRes [t3 a3 opt]
                                (lok t3 a3 i2 s2 l2 r2 n2 d2 (HGet src2 idx2 (HENil) et (t-adt opt)))))))))))))))))))

(defn lower-conj [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns] :- LRes
  (if (not (= (asts-depth (clone items)) 3))
    (LErr "conj expects (conj <vec> <x>)")
    (LErr "conj: lands with the fold rules")))

(defn lower-nth [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns] :- LRes
  (LErr "nth: lands with the fold rules"))

; shared child-lowering shapes
(defn lower-3-to [items :- Asts mode :- i64 env :- TyEnv tab :- (Vector str)
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns] :- LRes
  (let [a (asts-idx (clone items) 1)
        ra (lower-1 (clone a) env tab adts insts sigs lams rets ncached defs)]
    (match ra
      (LErr [msg] (LErr msg))
      (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
        (let [b (asts-idx (clone items) 2)
              rb (lower-1 (clone b) env t1 a1 i1 s1 l1 r1 n1 d1)]
          (match rb
            (LErr [msg] (LErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
              (let [c (asts-idx (clone items) 3)
                    rc (lower-1 (clone c) env t2 a2 i2 s2 l2 r2 n2 d2)]
                (match rc
                  (LErr [msg] (LErr msg))
                  (LOk [t3 a3 i3 s3 l3 r3 n3 d3 e3]
                    (lok t3 a3 i3 s3 l3 r3 n3 d3 (HSubs e1 e2 e3))))))))))))

(defn lower-2-to [items :- Asts mode :- i64 env :- TyEnv tab :- (Vector str)
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns name :- str kind :- i64] :- LRes
  (let [a (asts-idx (clone items) 1)
        ra (lower-1 (clone a) env tab adts insts sigs lams rets ncached defs)]
    (match ra
      (LErr [msg] (LErr msg))
      (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
        (let [b (asts-idx (clone items) 2)
              rb (lower-1 (clone b) env t1 a1 i1 s1 l1 r1 n1 d1)]
          (match rb
            (LErr [msg] (LErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
              (if (= kind 16)
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSplit e1 e2))
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HJoin e1 e2))))))))))

(defn lower-join-2 [items :- Asts env :- TyEnv tab :- (Vector str) adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns] :- LRes
  (lower-2-to items 0 env tab adts insts sigs lams rets ncached defs "join" 17))
; Call ret: the rets table (static non-generic + mono), else the seed's
; i64 fallback for the builtin print heads.
(defn h-call-ty [e :- HExpr rets :- TyEnv] :- Ty
  (match e
    (HCall [name args]
      (if (te-has (clone rets) name)
        (te-get (clone rets) name)
        (t-i64)))
    (o-hcall)))

(defn o-hcall [] :- Ty
  (t-i64))
