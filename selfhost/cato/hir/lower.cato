(ns cato.hir.lower)
(require ["../lib/ast.cato" :as ast])
(require ["hexpr.cato" :as hexpr])
(require ["types.cato" :as types])
(require ["expand.cato" :as expand])
(require ["forms.cato" :as forms])
(require ["../lib/span.cato" :as span])

; STATUS: S6 complete — the full pipeline runs and the differential test
; is green: expand (S5/S6) → build-program (pass 0a/0b headers, pass 1
; raws, plain-defn lowering in source order, externs, mono instances
; appended) → move check (moveck.cato, the BCheck port: frees/in_place/
; capture-own bits) → dump (dump.cato, the wire grammar). The Rust oracle
; serializes the seed's build_program_located output with the same grammar
; and the fixtures corpus (hir/fixtures/) is byte-identical on both sides
; (crates/cato-backend-interp/tests/kernel_hir.rs). Driver modes: `ast`
; (expander differential) and default (typed-IR dump).

(deftype LRes (LOk [tab :- i64 adts :- AdtTab insts :- IMap
                   sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                   defs :- Defns e :- HExpr])
             (LErr [msg :- str]))

(defn lok [tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
          lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
          e :- HExpr] :- LRes
  (LOk tab adts insts sigs lams rets ncached defs e))

; --- ast atom accessors (typed reads off tag checks) ------------------------

(defn ast-int-of [a :- &Ast] :- i64
  (match a
    (ANil [at] 0)
    (ASym [sid at] 0)
    (AInt [v at] v)
    (AF64 [v at] 0)
    (ABool [v at] 0)
    (AStr [v at] 0)
    (AList [ks at] 0)
    (AVec [ks at] 0)
    (AMap [ks at] 0)
    (ASet [ks at] 0)))

(defn ast-f64-of [a :- &Ast] :- f64
  (match a
    (ANil [at] 0.0)
    (ASym [sid at] 0.0)
    (AInt [v at] 0.0)
    (AF64 [v at] v)
    (ABool [v at] 0.0)
    (AStr [v at] 0.0)
    (AList [ks at] 0.0)
    (AVec [ks at] 0.0)
    (AMap [ks at] 0.0)
    (ASet [ks at] 0.0)))

; payload accessors for tag-checked atoms (avoids 10-arm matches at
; every use)
(defn ast-bool-of [a :- &Ast] :- i64
  (match a
    (ANil [at] 0)
    (ASym [sid at] 0)
    (AInt [v at] 0)
    (AF64 [v at] 0)
    (ABool [v at] v)
    (AStr [v at] 0)
    (AList [ks at] 0)
    (AVec [ks at] 0)
    (AMap [ks at] 0)
    (ASet [ks at] 0)))

(defn ast-str-of [a :- &Ast] :- str
  (match a
    (ANil [at] "")
    (ASym [sid at] "")
    (AInt [v at] "")
    (AF64 [v at] "")
    (ABool [v at] "")
    (AStr [v at] (clone v))
    (AList [ks at] "")
    (AVec [ks at] "")
    (AMap [ks at] "")
    (ASet [ks at] "")))

(defn kids-all-int [ks :- Asts] :- bool
  (match ks
    (KNil [] true)
    (KCons [kid rest] (and (= (ast/ast-tag kid) 2) (kids-all-int rest)))))

(defn kids-all-num [ks :- Asts] :- bool
  (match ks
    (KNil [] true)
    (KCons [kid rest]
      (let [t (ast/ast-tag kid)]
        (and (or (= t 2) (= t 3)) (kids-all-num rest))))))

(defn kids-i64s [ks :- Asts acc :- VVals] :- VVals
  (match ks
    (KNil [] (vvals-rev acc (VVNil)))
    (KCons [kid rest]
      (match kid
        (AInt [v at] (kids-i64s rest (VVI64 v acc)))
        (ANil [at] (VVNil))
        (ASym [sid at] (VVNil))
        (AF64 [v at] (VVNil))
        (ABool [v at] (VVNil))
        (AStr [v at] (VVNil))
        (AList [ks2 at] (VVNil))
        (AVec [ks2 at] (VVNil))
        (AMap [ks2 at] (VVNil))
        (ASet [ks2 at] (VVNil))))))

(defn kids-f64s [ks :- Asts acc :- VVals] :- VVals
  (match ks
    (KNil [] (vvals-rev acc (VVNil)))
    (KCons [kid rest]
      (match kid
        (AInt [v at] (kids-f64s rest (VVF64 (f64 v) acc)))
        (AF64 [v at] (kids-f64s rest (VVF64 v acc)))
        (ANil [at] (VVNil))
        (ASym [sid at] (VVNil))
        (ABool [v at] (VVNil))
        (AStr [v at] (VVNil))
        (AList [ks2 at] (VVNil))
        (AVec [ks2 at] (VVNil))
        (AMap [ks2 at] (VVNil))
        (ASet [ks2 at] (VVNil))))))

(defn vvals-rev [ks :- VVals acc :- VVals] :- VVals
  (match ks
    (VVI64 [v next] (vvals-rev next (VVI64 v acc)))
    (VVF64 [v next] (vvals-rev next (VVF64 v acc)))
    (VVNil [] acc)))

; --- entry -------------------------------------------------------------------

(defn lower-x [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
              insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
              ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower a env (types/t-none) tab adts insts sigs lams rets ncached defs raws))

(defn lower [a :- Ast env :- TyEnv expected :- Ty tab :- i64
            adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
            rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [tag (ast/ast-tag a)]
    (cond
      (= tag 2)
      (lok tab adts insts sigs lams rets ncached defs (HConstI64 (ast-int-of a)))

      (= tag 3)
      (lok tab adts insts sigs lams rets ncached defs (HConstF64 (ast-f64-of a)))

      (= tag 9)
      (lok tab adts insts sigs lams rets ncached defs (HConstB (ast-bool-of a)))

      (= tag 4)
      (lok tab adts insts sigs lams rets ncached defs (HStrLit (ast-str-of a)))

      (= tag 1)
      (let [sid (expand/ast-sid-of a)]
        (if (forms/te-has env sid)
          (lok tab adts insts sigs lams rets ncached defs (HVar sid))
          (LErr (str "unbound variable " (forms/sym-str (clone tab) sid)))))

      (= tag 6)
      (lower-veclit (clone a) (clone env) tab adts insts sigs lams rets ncached defs)

      (= tag 5)
      (lower-list (clone a) (clone env) expected tab adts insts sigs lams rets ncached defs raws)

      (LErr "unsupported map/set literal"))))

(defn lower-veclit [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns] :- LRes
  (match a
    (AVec [kids at]
      (cond
        (kids-all-int (clone kids))
        (lok tab adts insts sigs lams rets ncached defs
             (HVecLit 0 (kids-i64s (clone kids) (VVNil))))

        (kids-all-num (clone kids))
        (lok tab adts insts sigs lams rets ncached defs
             (HVecLit 1 (kids-f64s kids (VVNil))))

        (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))")))
    (ANil [at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ASym [sid at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AInt [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AF64 [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ABool [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AStr [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AList [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AMap [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ASet [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))))

; --- typing (ty_of) ----------------------------------------------------------

; Reads only: raws/rets/sigs are caller-cloned. Mirrors `ty_of`.
(defn ty-of [e :- &HExpr env :- &TyEnv rets :- &TyEnv sigs :- &Sigs] :- Ty
  ; Reads only: env/rets/sigs are passed by reference (no per-call clone),
  ; and the HLet/HSeq/HClone arms recurse over borrowed children. Mirrors
  ; `ty_of`; the rets table holds static non-generic rets + mono rets, so the
  ; Call arm is a lookup and the seed's i64 fallback covers print-* et al.
  (match e
    (HConstI64 [v] (types/t-i64))
    (HConstF64 [v] (types/t-f64))
    (HConstB [v] (types/t-bool))
    (HVar [name] (forms/te-get env name))
    (HStrLit [v] (types/t-str))
    (HVecLit [el vals] (types/t-vec el))
    (HBinW [op a b ty] (clone ty))
    (HBinF [op a b] (types/t-f32))
    (HCmpW [op a b ty] (types/t-bool))
    (HStrCmp [pol a b] (types/t-bool))
    (HStrOrd [op a b] (types/t-bool))
    (HICast [e2 from to] (clone to))
    (HCount [x] (types/t-i64))
    (HToStr [x ty] (types/t-str))
    (HStrCat [args] (types/t-str))
    (HSubs [s a b] (types/t-str))
    (HSplit [s sep] (types/t-vec 2))
    (HJoin [sep xs] (types/t-str))
    (HStrNth [s idx res] (clone res))
    (HCharStr [x] (types/t-str))
    (HGet [src idx dflt ty res] (if (ty-noneq res) (clone ty) (clone res)))
    (HConj [v x el inplace] (types/t-vec el))
    (HIf [c t2 e2 ty] (clone ty))
    (HAnd [a b] (types/t-bool))
    (HOr [a b] (types/t-bool))
    (HNot [x] (types/t-bool))
    (HAbs [x ty] (clone ty))
    (HMin [a b ty] (clone ty))
    (HMax [a b ty] (clone ty))
    (HSeq [es] (if (hexpr/hes-null es) (types/t-i64) (h-seq-last es env rets sigs)))
    (HLet [binds body frees]
      (ty-of body (binds-extend (clone binds) (clone env)) rets sigs))
    (HLoop [binds ty body] (clone ty))
    (HRecur [args] (types/t-i64))
    (HCtor [adt variant args] (types/t-adt adt))
    (HMatch [scrut arms ty] (clone ty))
    (HClone [x] (ty-of x env rets sigs))
    (HDrop [x] (types/t-i64))
    (HClosure [sig mangled params caps body] (types/t-fn sig))
    (HClosureCall [f args sig]
      (match (forms/sigs-at sigs sig)
        (Sig [params r] r)))
    (HCall [name args] (if (= name (expand/s-evenq)) (types/t-bool) (h-call-ty rets name)))
    (HSlurp [p] (types/t-str))
    (HSpit [path data] (types/t-i64))
    (HArgs [] (types/t-vec 2))
    (HExit [x] (types/t-i64))
    (HParseNum [s int res] (clone res))))

(defn ty-noneq [x :- &Ty] :- bool
  (= (types/ty-tag x) 19))

(defn h-seq-last [es :- &HExprs env :- &TyEnv rets :- &TyEnv sigs :- &Sigs] :- Ty
  (if (hexpr/hes-null (asts-tail-hes es))
    (ty-of (hes-head-hes es) env rets sigs)
    (h-seq-last (asts-tail-hes es) env rets sigs)))

(defn asts-tail-hes [ks :- &HExprs] :- HExprs
  (match ks
    (HECons [kid next] (clone next))
    (HENil [] (HENil))))

(defn hes-head-hes [ks :- &HExprs] :- HExpr
  (match ks
    (HECons [kid next] (clone kid))
    (HENil [] (HConstI64 0))))

(defn binds-extend [binds :- Binds env :- TyEnv] :- TyEnv
  (match binds
    (BCons [name v ty next]
      (binds-extend next (forms/te-put env name ty)))
    (BNil [] env)))

; A flat tag walk (mirrors the variant order of the HExpr deftype).
(defn h-tag [e :- &HExpr] :- i64
  (match e
    (HConstI64 [v] 0)
    (HConstF64 [v] 1)
    (HConstB [v] 2)
    (HVar [name] 3)
    (HStrLit [v] 4)
    (HVecLit [el vals] 5)
    (HBinW [op a b ty] 6)
    (HBinF [op a b] 7)
    (HCmpW [op a b ty] 8)
    (HStrCmp [pol a b] 9)
    (HStrOrd [op a b] 10)
    (HICast [e from to] 11)
    (HCount [e] 12)
    (HToStr [e ty] 13)
    (HStrCat [args] 14)
    (HSubs [s a b] 15)
    (HSplit [s sep] 16)
    (HJoin [sep xs] 17)
    (HStrNth [s idx res] 18)
    (HCharStr [e] 19)
    (HGet [src idx dflt ty res] 20)
    (HConj [v x el inplace] 21)
    (HIf [c t e ty] 22)
    (HAnd [a b] 23)
    (HOr [a b] 24)
    (HNot [e] 25)
    (HAbs [e ty] 26)
    (HMin [a b ty] 27)
    (HMax [a b ty] 28)
    (HSeq [es] 29)
    (HLet [binds body frees] 30)
    (HLoop [binds ty body] 31)
    (HRecur [args] 32)
    (HCtor [adt variant args] 33)
    (HMatch [scrut arms ty] 34)
    (HClone [e] 35)
    (HDrop [e] 36)
    (HClosure [sig mangled params caps body] 37)
    (HClosureCall [f args sig] 38)
    (HCall [name args] 39)
    (HSlurp [p] 40)
    (HSpit [path data] 41)
    (HArgs [] 42)
    (HExit [e] 43)
    (HParseNum [s int res] 44)))

; --- arithmetic / comparison helpers -----------------------------------------

; coerce_f64: wrap an i64-typed expression when an f64 result is wanted.
(defn coerce-f64 [e :- HExpr cur :- Ty want :- bool] :- HExpr
  (if (and want (not (types/ty-eq (clone cur) (types/t-f64))))
    (HICast e cur (types/t-f64))
    e))

; promote_pair: both operands numeric and equal-width (no silent mixing).
(defn promote-pair [a :- HExpr b :- HExpr env :- &TyEnv rets :- &TyEnv sigs :- Sigs] :- PRes
  (let [at (ty-of a env rets sigs)
        bt (ty-of b env rets sigs)]
    (if (or (is-adt-or-str (clone at)) (is-adt-or-str (clone bt)))
      (PResErr "ADT and string values cannot be used in arithmetic")
      (if (and (types/ty-eq (clone at) (clone bt)) (types/is-numeric-ty (clone at)))
        (PResOk (clone a) (clone b))
        (PResErr (str "cannot mix " (ty-name (clone at)) " and " (ty-name (clone bt))
                      " in arithmetic — cast explicitly with ("
                      (if (or (types/is-float-ty at) (types/is-float-ty bt)) "f64" "i64") ") e"))))))

(defn is-adt-or-str [x :- Ty] :- bool
  (let [t (types/ty-tag x)]
    (or (= t 16) (= t 12))))

(deftype PRes (PResOk [a :- HExpr b :- HExpr]) (PResErr [msg :- str]))

; BinOp code of an arithmetic head
(defn arith-op [sid :- i64] :- i64
  (cond
    (= sid (expand/s-add)) 0
    (= sid (expand/s-sub)) 1
    (= sid (expand/s-mul)) 2
    3))

(defn cmp-op [sid :- i64] :- i64
  (cond
    (= sid (expand/s-eq)) 0
    (= sid (expand/s-ne)) 1
    (= sid (expand/s-lt)) 2
    (= sid (expand/s-gt)) 3
    (= sid (expand/s-le)) 4
    5))

; promote_bin: BinF for f32, BinW carrying the width otherwise.
(defn promote-bin [op :- i64 a :- HExpr b :- HExpr env :- &TyEnv
                  rets :- &TyEnv sigs :- Sigs] :- LRes1
  (match (promote-pair a b env rets (clone sigs))
    (PResOk [a2 b2]
      (let [t (ty-of a2 env rets sigs)]
        (if (types/ty-eq (clone t) (types/t-f32))
          (LRes1Ok (HBinF op a2 b2))
          (LRes1Ok (HBinW op a2 b2 t)))))
    (PResErr [msg] (LRes1Err msg))))

(deftype LRes1 (LRes1Ok [e :- HExpr]) (LRes1Err [msg :- str]))

; Type names for diagnostics (the seed renders Debug shapes; the kernel
; uses readable names — diagnostics are not part of the byte contract).
(defn ty-name [x :- Ty] :- str
  (let [t (types/ty-tag x)]
    (cond
      (= t 0) "i64"
      (= t 1) "i32"
      (= t 2) "i8"
      (= t 3) "i16"
      (= t 4) "u8"
      (= t 5) "u16"
      (= t 6) "u32"
      (= t 7) "u64"
      (= t 8) "usize"
      (= t 9) "f64"
      (= t 10) "f32"
      (= t 11) "bool"
      (= t 12) "str"
      (= t 13) "map"
      (= t 14) "set"
      (= t 15) "vector"
      (= t 16) "adt"
      (= t 17) "fn"
      (= t 18) "param"
      "none")))

; --- unify + substitution (mono.rs) -------------------------------------------

(deftype URes (UResOk [subs :- TyEnv]) (UResErr))

; unify with a recursion cap standing in for the seed's seen-set.
(defn unify [pat :- Ty actual :- Ty subs :- &TyEnv] :- URes
  (unify-seen pat actual subs 0))

(defn unify-seen [pat :- Ty actual :- Ty subs :- &TyEnv depth :- i64] :- URes
  (if (> depth 100)
    (UResOk (clone subs))
    (let [pt (types/ty-tag pat)
          at (types/ty-tag actual)]
      (cond
        (= pt 18)
        (let [i (types/ty-arg pat)
              bound (forms/te-get subs i)]
          (if (ty-noneq bound)
            (UResOk (forms/te-put (clone subs) i (clone actual)))
            (if (types/ty-eq bound (clone actual))
              (UResOk (clone subs))
              (UResErr))))

        (and (= pt 15) (>= (types/ty-arg pat) 100) (= at 15))
        (unify-vec-pat (clone pat) (clone actual) subs depth)

        (and (types/ty-eq pat actual))
        (UResOk (clone subs))

        (UResErr)))))

(defn unify-vec-pat [pat :- Ty actual :- Ty subs :- &TyEnv depth :- i64] :- URes
  (let [elc (types/ty-arg pat)
        k (- elc 100)
        actual-el (match actual (Ty [t a] a))]
    (if (not (= (types/ty-tag actual) 15))
      (UResErr)
      (let [a (types/elem-ty actual-el)
            bound (forms/te-get subs k)]
        (if (ty-noneq bound)
          (UResOk (forms/te-put (clone subs) k a))
          (if (types/ty-eq bound a)
            (UResOk (clone subs))
            (UResErr)))))))

; ADT-to-ADT unification (a template against an instance of itself,
; field-wise) is a kernel restriction: ADT-typed generic parameters fail
; instantiation with a clear diagnostic instead of unifying. The seed
; supports them; S6 fixtures exercise scalar/vector-parameter generics,
; which behave identically on both sides.


; --- substitution (subst_ty) --------------------------------------------------

; Substitute bound type parameters through a type. ADT instances whose
; arguments still mention parameters re-instantiate (grows adts/tab):
; reported via SRes.
(deftype SRes (SRes [tab :- i64 adts :- AdtTab ty :- Ty msg :- str]))

(defn subst-ty [ty :- Ty subs :- &TyEnv tab :- i64 adts :- AdtTab] :- SRes
  (let [t (types/ty-tag ty)]
    (cond
      (= t 18)
      (let [bound (forms/te-get subs (types/ty-arg ty))]
        (if (ty-noneq bound)
          (SRes tab (clone adts) (types/t-none) (str "unresolved type parameter " (types/ty-arg ty)))
          (SRes tab (clone adts) bound "")))

      (= t 15)
      (let [elc (types/ty-arg ty)]
        (if (>= elc 100)
          (let [bound (forms/te-get subs (- elc 100))]
            (cond
              (types/ty-eq (clone bound) (types/t-i64)) (SRes tab (clone adts) (types/t-vec 0) "")
              (types/ty-eq (clone bound) (types/t-f64)) (SRes tab (clone adts) (types/t-vec 1) "")
              (= (types/ty-tag bound) 15)         (SRes tab (clone adts) (types/t-vec (types/ty-arg bound)) "")
              (SRes tab (clone adts) (types/t-none) (str "unresolved vector element parameter " (- elc 100)))))
          (SRes tab (clone adts) (clone ty) "")))

      ; an instance whose arguments mention parameters re-instantiates
      ; (the seed's subst_ty ADT arm); dedup makes this a cache hit when
      ; the args are already concrete
      (= t 16)
      (let [info (forms/adts-at adts (types/ty-arg ty))]
        (match info
          (AdtInfo [name tps variants tpl tplargs]
            (if (>= tpl 0)
              (let [r (subst-ty-list tplargs subs tab (clone adts) (TyNil))]
                (match r
                  (SResL [tab2 adts2 args2 msg]
                    (if (> (count msg) 0)
                      (SRes tab2 adts2 (clone ty) msg)
                      (let [ri (forms/instantiate-adt tpl args2
                                                (PS (clone tab2) (DLNil) adts2 (SGNil) (SNil) ""))]
                        (match ri
                          (PIARes [ps2 idx]
                            (if (forms/ps-failed ps2)
                              ; read the message before the state moves
                              (let [m (ps-err-msg ps2)]
                                (SRes tab2 (forms/ps-adts ps2) (clone ty) m))
                              (SRes (forms/ps-tab ps2) (forms/ps-adts ps2) (types/t-adt idx) "")))))))))
              (SRes tab (clone adts) (clone ty) "")))))

      (SRes tab adts ty ""))))

; the list form of subst-ty: every element substituted, in order
(deftype SResL (SResL [tab :- i64 adts :- AdtTab tys :- TyList msg :- str]))

(defn subst-ty-list [tys :- TyList subs :- &TyEnv tab :- i64 adts :- AdtTab
                    acc :- TyList] :- SResL
  (match tys
    (TyNil [] (SResL tab adts (types/tys-rev acc (TyNil)) ""))
    (TyCons [h t]
      (let [r (subst-ty h subs tab adts)]
        (match r
          (SRes [tab2 adts2 ty2 msg]
            (if (> (count msg) 0)
              (SResL tab2 adts2 (TyNil) msg)
              (subst-ty-list t subs tab2 adts2 (TyCons ty2 acc)))))))))

; --- monomorphization (instantiate) ---------------------------------------------

; Resolve a (possibly generic) callee for concrete argument types; mint
; and lower the instance on first encounter (cache-before-body, the
; seed's recursion rule).
(deftype MIRes (MIRes [tab :- i64 adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns mangled :- i64 ret :- Ty msg :- str]))

(defn ty-mangle-str2 [adts :- AdtTab tab :- i64 x :- Ty] :- str
  (forms/ty-mangle-str adts tab x))

(defn instantiate [name :- i64 argtys :- TyList
                  tab :- i64 adts :- AdtTab insts :- IMap
                  sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                  defs :- Defns raws :- &Raws] :- MIRes
  (let [raw (raws-find raws name)]
    (match raw
      (RawDefn [rname params ret2 typarams isextern body rb]
        (if (= (types/sids-depth typarams) 0)
          (MIRes (clone tab) adts insts sigs lams rets ncached defs name ret2 "")
          (if (not (= (forms/plist-depth params) (types/tys-depth argtys)))
            (MIRes (clone tab) adts insts sigs lams rets ncached defs name (types/t-none)
                   (str "function " (forms/sym-str (clone tab) name) " expects " (forms/plist-depth params) " argument(s), got " (types/tys-depth argtys)))
            (let [ru (unify-params (clone params) argtys (TENil))]
              (match ru
                (UResErr []
                  (MIRes (clone tab) adts insts sigs lams rets ncached defs name (types/t-none)
                         (str "cannot instantiate " (forms/sym-str (clone tab) name) " with the given argument types")))
                (UResOk [subs]
                  ; check every parameter bound
                  (let [miss (unbound-param (clone typarams) subs)]
                    (if (not (= (types/sids-depth miss) 0))
                      (MIRes (clone tab) adts insts sigs lams rets ncached defs name (types/t-none)
                             (str "cannot infer type parameter of " (forms/sym-str (clone tab) name)))
                      (let [suf (mangle-suffix typarams subs (clone adts) (clone tab) (SNil))
                            r2 (forms/intern1 (clone tab) (str (forms/sym-str (clone tab) name) "__" suf))]
                        (match r2
                          (I1Res [tab2 mangled]
                            (if (forms/te-has rets mangled)
                              (MIRes tab2 adts insts sigs lams (clone rets) ncached defs mangled (forms/te-get rets mangled) "")
                              (let [rs (subst-ty ret2 subs tab2 (clone adts))]
                                (match rs
                                  (SRes [tab3 adts3 mret msg3]
                                    (if (> (count msg3) 0)
                                      (MIRes tab3 adts3 (clone insts) (clone sigs) (clone lams) (clone rets) ncached (clone defs) mangled (types/t-none) msg3)
                                      (let [rp (subst-params params subs tab3 adts3 (PNil))]
                                        (match rp
                                          (SPRes [tab4 adts4 mparams msg4]
                                            (if (> (count msg4) 0)
                                              (MIRes tab4 adts4 (clone insts) (clone sigs) (clone lams) (clone rets) ncached (clone defs) mangled (types/t-none) msg4)
                                              ; register BEFORE the body lowers
                                              (let [nc2 (+ 1 ncached)
                                                    rets2 (forms/te-put (clone rets) mangled mret)
                                                    ri (lower-body-raw body (binds-of-params (clone mparams)) (clone mret)
                                                                       (clone tab4) (clone adts4) (clone insts) (clone sigs) (clone lams) (clone rets2) nc2 (clone defs) raws)]
                                                (match ri
                                                  (LErr [msg] (MIRes tab4 adts4 (clone insts) (clone sigs) (clone lams) rets2 nc2 (clone defs) mangled (types/t-none) msg))
                                                  (LOk [tab5 adts5 insts5 sigs5 lams5 rets5 nc5 defs5 body]
                                                    (MIRes tab5 adts5 insts5 sigs5 lams5 rets5 nc5
                                                           (forms/defns-append defs5 (Defn mangled mparams mret 0 body rb))
                                                           mangled mret "")))))))))))))))))))))))))))

; The lowered instance defn appends to the program's defn list at build
; time from insts order — the instance list records mangled name + ret +
; substituted params + body, so keep them in an extra table threaded in
; LRes... the insts IMap only carries mangled->?; extend: insts maps
; mangled sid -> (ordinal); the DEFS chain carries the Defn values.

; The mono instance defns in creation order (drained into the program's
; defn list after plain defns and externs, matching build.rs).
(defn raws-find [rs :- &Raws name :- i64] :- RawDefn
  (raws-find-2 rs name (RawDefn -1 (PNil) (types/t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))

(defn raws-find-2 [rs :- &Raws name :- i64 best :- RawDefn] :- RawDefn
  ; last-declared wins (the seed's HashMap overwrite on duplicates)
  (match rs
    (RCons [h t]
      (match h
        (RawDefn [rname params ret typarams isextern body rb]
          (if (= rname name)
            (raws-find-2 t name (clone h))
            (raws-find-2 t name best)))))
    (RNil [] best)))

(defn unify-params [params :- PList argtys :- TyList subs :- TyEnv] :- URes
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty _pb]
          (match argtys
            (TyNil [] (UResErr))
            (TyCons [a arest]
              (match (unify pty a subs)
                (UResErr [] (UResErr))
                (UResOk [subs2] (unify-params prest arest subs2))))))))
    (PNil []
      (if (types/tys-null argtys)
        (UResOk subs)
        (UResErr)))))

(defn unbound-param [typarams :- Sids subs :- &TyEnv] :- Sids
  ; the type parameters still unbound after unification (empty = all good)
  (unbound-param-2 typarams subs 0))

(defn unbound-param-2 [typarams :- Sids subs :- &TyEnv i :- i64] :- Sids
  (match typarams
    (SNil [] (SNil))
    (SCons [h t]
      (if (ty-noneq (forms/te-get subs i))
        (SCons i (unbound-param-2 t subs (+ i 1)))
        (unbound-param-2 t subs (+ i 1))))))

(defn mangle-suffix [typarams :- Sids subs :- &TyEnv adts :- AdtTab tab :- i64 acc :- Sids] :- str
  ; suffix per type parameter, in declaration order, joined with _
  (mangle-suffix-2 typarams subs adts tab 0 "" 0))

(defn mangle-suffix-2 [typarams :- Sids subs :- &TyEnv adts :- AdtTab tab :- i64 i :- i64 acc :- str first :- i64] :- str
  (match typarams
    (SNil [] acc)
    (SCons [h t]
      (let [arg (forms/te-get subs i)
            suf (forms/ty-mangle-str (clone adts) (clone tab) arg)
            acc2 (if (= first 0) (str acc suf) (str acc "_" suf))]
        (mangle-suffix-2 t subs adts (clone tab) (+ i 1) acc2 0)))))

(deftype SPRes (SPRes [tab :- i64 adts :- AdtTab params :- PList msg :- str]))

(defn subst-params [params :- PList subs :- &TyEnv tab :- i64 adts :- AdtTab acc :- PList] :- SPRes
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty pb]
          (let [r (subst-ty pty subs tab adts)]
            (match r
              (SRes [tab2 adts2 ty msg]
                (if (> (count msg) 0)
                  (SPRes tab2 adts2 (PNil) msg)
                  (subst-params prest subs tab2 adts2 (PCons (Param pname ty pb) acc)))))))))
    (PNil [] (SPRes tab adts (forms/plist-rev acc (PNil)) ""))))

(defn binds-of-params [params :- PList] :- TyEnv
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty _pb] (forms/te-put (binds-of-params prest) pname pty))))
    (PNil [] (TENil))))

; lower a raw defn body (implicit do when multiple forms) — the instance
; body path of the seed's `instantiate`.
(defn lower-body-raw [body :- Ast env :- TyEnv expected :- Ty
                     tab :- i64 adts :- AdtTab insts :- IMap
                     sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                     defs :- Defns raws :- &Raws] :- LRes
  (let [bt (ast/ast-tag body)]
    (if (and (= bt 5) (= (expand/asts-head-sid (expand/ast-kids-of (clone body))) (expand/s-do)))
      (lower-do (expand/asts-tail (expand/ast-kids-of (clone body))) env expected tab adts insts sigs lams rets ncached defs raws)
      (lower (clone body) env expected tab adts insts sigs lams rets ncached defs raws))))

; --- ascription resolution (resolve_ann_ty) -----------------------------------

; Scalars (five), concrete ADT names, or applied ADTs — instantiate.
; Note the seed's narrow scalar list here: i8 in a let ascription fails.
(defn mk-ps [tab :- i64 adts :- AdtTab sigs :- Sigs] :- PS
  (PS tab (DLNil) adts sigs (SNil) ""))

(defn resolve-ann-args [els :- Asts tab :- i64 adts :- AdtTab sigs :- Sigs] :- PArgsRes
  (match els
    (KCons [e rest]
      (let [r (resolve-ann-ty e (clone tab) (clone adts) (clone sigs))]
        (match r
          (PTyRes [ps2 ty]
            (if (forms/ps-failed ps2)
              (PArgsRes ps2 (TyNil))
              (let [rr (resolve-ann-args rest (clone tab) adts sigs)]
                (match rr
                  (PArgsRes [ps3 args] (PArgsRes ps3 (TyCons ty args))))))))))
    (KNil [] (PArgsRes (mk-ps (clone tab) adts sigs) (TyNil)))))

(defn resolve-ann-applied [a :- Ast tab :- i64 adts :- AdtTab sigs :- Sigs] :- PTyRes
  (match a
    (AList [kids at]
      (let [h (expand/asts-head-sid kids)]
        ; `(Vector el)` — the built-in generic (S8: loop-bind annotations
        ; carry full type forms, e.g. the reader's `tab :- i64`)
        (if (= h (expand/s-vec))
          (match (expand/asts-tail kids)
            (KCons [eln rest]
              (if (expand/asts-null rest)
                (let [es (forms/sym-str (clone tab) (expand/ast-sid-of eln))]
                  (cond
                    (= es "i64") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-vec 0))
                    (= es "f64") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-vec 1))
                    (= es "str") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-vec 2))
                    (PTyRes (forms/ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                    (str "(Vector " es ") element must be i64, f64 or str")) (types/t-none))))
                (PTyRes (forms/ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                "(Vector expects exactly one element type") (types/t-none))))
            (KNil [] (PTyRes (forms/ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                "(Vector expects exactly one element type") (types/t-none))))
          (resolve-ann-adt a tab adts sigs h))))
    (_ (PTyRes (forms/ps-err (mk-ps (clone tab) (clone adts) (clone sigs)) "type annotation must be a symbol or applied ADT") (types/t-none)))))

; the declared-ADT application path of resolve-ann-applied
(defn resolve-ann-adt [a :- Ast tab :- i64 adts :- AdtTab sigs :- Sigs h :- i64] :- PTyRes
  (match a
    (AList [kids at]
      (let [hit (find-declared-adts (clone adts) h 0)]
        (if (< (ty-arg-of-info (clone hit)) 0)
          (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) (str "unknown type name " (forms/sym-str (clone tab) h))) (types/t-none))
          (let [rargs (resolve-ann-args (expand/asts-tail kids) (clone tab) adts sigs)]
            (match rargs
              (PArgsRes [ps2 args]
                (if (forms/ps-failed ps2)
                  (PTyRes ps2 (types/t-none))
                  (let [ri (forms/instantiate-adt (info-idx hit) args ps2)]
                    (match ri
                      (PIARes [ps3 idx] (PTyRes ps3 (types/t-adt idx))))))))))))
    (ANil [at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (ASym [sid at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (AInt [v at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (AF64 [v at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (ABool [v at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (AStr [v at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (AVec [ks at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (AMap [ks at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))
    (ASet [ks at] (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))))

(defn resolve-ann-ty [a :- Ast tab :- i64 adts :- AdtTab sigs :- Sigs] :- PTyRes
  (let [tag (ast/ast-tag a)]
    (cond
      (= tag 1)
      (let [s (forms/sym-str (clone tab) (expand/ast-sid-of a))]
        (cond
          (= s "i64")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-i64))
          (= s "i32")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-i32))
          (= s "f64")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-f64))
          (= s "bool") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-bool))
          (= s "str")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-str))
          (let [sid (expand/ast-sid-of a)
                hit (find-declared-adts (clone adts) sid 0)]
            (if (>= (ty-arg-of-info (clone hit)) 0)
              (if (= (info-tparams (clone hit)) 0)
                (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (types/t-adt (info-idx hit)))
                (PTyRes (forms/ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                (str s " expects " (info-tparams hit) " type argument(s)")) (types/t-none)))
              (PTyRes (forms/ps-err (mk-ps (clone tab) (clone adts) (clone sigs)) (str "unknown type name " s)) (types/t-none))))))
      (= tag 5)
      (resolve-ann-applied (clone a) (clone tab) (clone adts) (clone sigs))
      (PTyRes (forms/ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (types/t-none)))))

; find a DECLARED (non-instance) ADT by name sid; info-idx carries the
; combined index, -1 when absent
(defn find-declared-adts [ts :- AdtTab sid :- i64 i :- i64] :- AdtInfo2
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [name typarams variants tpl tplargs]
          (if (and (= name sid) (= tpl -1))
            (AdtInfo2 i h)
            (find-declared-adts t sid (+ i 1))))))
    (ATNil [] (AdtInfo2 -1 (AdtInfo -1 (SNil) (VNil) -1 (TyNil))))))

(deftype AdtInfo2 (AdtInfo2 [idx :- i64 info :- AdtInfo]))

(defn info-idx [x :- AdtInfo2] :- i64
  (match x (AdtInfo2 [idx info] idx)))

(defn info-tparams [x :- AdtInfo2] :- i64
  (match x
    (AdtInfo2 [idx info]
      (match info
        (AdtInfo [name typarams variants tpl tplargs] (types/sids-depth typarams))))))

(defn ty-arg-of-info [x :- AdtInfo2] :- i64
  (info-idx x))

; the (Option T) instance for two-argument get / nth / parse-*
(deftype OIRes (OIRes [tab :- i64 adts :- AdtTab idx :- i64]))

(defn option-instance [ty :- Ty tab :- i64 adts :- AdtTab sigs :- Sigs] :- OIRes
  ; the prelude's (Option a) is pinned at combined-table index 0
  (let [ps (PS tab (DLNil) adts sigs (SNil) "")
        r (forms/instantiate-adt 0 (TyCons ty (TyNil)) ps)]
    (match r
      (PIARes [ps2 idx]
        (match ps2
          (PS [tab2 d2 a2 s2 y2 e2] (OIRes tab2 a2 idx)))))))

; --- sequences, let, if --------------------------------------------------------

; (do form...) — one form collapses to the form itself.
(defn lower-do [forms :- Asts env :- TyEnv expected :- Ty tab :- i64
               adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
               rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (expand/asts-null forms)
    (lok tab adts insts sigs lams rets ncached defs (HConstI64 0))
    (lower-do-2 forms (HENil) env expected tab adts insts sigs lams rets ncached defs raws)))

(defn lower-do-2 [forms :- Asts acc :- HExprs env :- TyEnv expected :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [kid (expand/asts-idx (clone forms) 0)
        rest (expand/asts-tail forms)
        lastq (expand/asts-null rest)
        exp (if lastq (clone expected) (types/t-none))
        r (lower kid (clone env) exp tab adts insts sigs lams rets ncached defs raws)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 e2]
        (if lastq
          (if (hexpr/hes-null acc)
            (lok tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 e2)
            (lok tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2
                 (HSeq (hexpr/hes-rev (HECons e2 acc) (HENil)))))
          (lower-do-2 rest (HECons e2 acc) env expected tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 raws))))))

; lower a single child expression (no expected type)
(defn lower-1 [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
              insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
              ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower a env (types/t-none) tab adts insts sigs lams rets ncached defs raws))

; lower with an expected type
(defn lower-e [a :- Ast env :- TyEnv expected :- Ty tab :- i64
              adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
              rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower a env expected tab adts insts sigs lams rets ncached defs raws))

; --- if (forms.rs lower_if) -----------------------------------------------------

; does every path through e end in a recur? Such an expression never
; completes with a value, so an if with it on one side takes the other
; side's type (S8: the reader's scan wraps its recur continuations in
; match/let/if tails — a bare HRecur tag check is not enough).
(defn all-paths-recur [e :- HExpr] :- bool
  (let [tag (h-tag e)]
    (cond
      (= tag 32) true
      (= tag 22) (and (all-paths-recur (hv-b e))
                      (all-paths-recur (hv-c e)))
      (= tag 30) (all-paths-recur (hv-b e))
      (= tag 29) (seq-all-recur (hargs-of e))
      (= tag 34) (arms-all-recur (arms-of e))
      false)))

(defn seq-all-recur [es :- HExprs] :- bool
  (if (expand/asts-null es)
    false
    (if (expand/asts-null (asts-tail-hes es))
      (all-paths-recur (hes-head-hes es))
      (seq-all-recur (asts-tail-hes es)))))

(defn arms-all-recur [arms :- HArms] :- bool
  (match arms
    (HANil [] true)
    (HACons [variant binders body ef next]
      (and (all-paths-recur body) (arms-all-recur next)))))

(defn lower-if [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
               insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
               ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 4))
    (LErr "if expects (if cond then else)")
    (let [c (expand/asts-idx (clone items) 1)
          rc (lower-1 c (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match rc
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 c2]
          (if (not (types/ty-eq (ty-of c2 env r1 s1) (types/t-bool)))
            (LErr "if condition must be boolean")
            (let [tthen (expand/asts-idx (clone items) 2)
                  rt (lower-1 tthen (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
              (match rt
                (LErr [msg] (LErr msg))
                (LOk [t2 a2 i2 s2 l2 r2 n2 d2 then2]
                  (let [tels (expand/asts-idx items 3)
                        re (lower-1 tels (clone env) t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                    (match re
                      (LErr [msg] (LErr msg))
                      (LOk [t3 a3 i3 s3 l3 r3 n3 d3 els2]
                        (let [tt (ty-of then2 env r3 s3)
                              et (ty-of els2 env r3 s3)
                              ; a branch whose every path recurs takes the
                              ; other branch's type
                              tt2 (if (all-paths-recur (clone then2)) (clone et) (clone tt))
                              et2 (if (all-paths-recur (clone els2)) tt et)]
                          (if (and (not (types/ty-eq (clone tt2) (clone et2)))
                                   (not (types/ty-eq (clone tt2) (types/t-f64)))
                                   (not (types/ty-eq (clone et2) (types/t-f64))))
                            (LErr (str "if branches must be the same type, got " (ty-name tt2) " and " (ty-name et2)))
                            (let [wf (or (types/ty-eq (clone tt2) (types/t-f64)) (types/ty-eq (clone et2) (types/t-f64)))
                                  ty (if wf (types/t-f64) (clone tt2))
                                  then3 (coerce-f64 (clone then2) (clone tt2) wf)
                                  els3 (coerce-f64 (clone els2) (clone et2) wf)]
                              (lok t3 a3 i3 (clone s3) l3 (clone r3) n3 d3 (HIf (clone c2) then3 els3 ty)))))))))))))))))

; --- let (forms.rs lower_let) ---------------------------------------------------

(defn lower-let [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (match items
    (KNil [] (LErr "let bindings must be a vector"))
    ; brest is the KCons tail: the chain of body forms AFTER the bindings
    ; vector — the second destructure name is a chain, not a form
    (KCons [bvec brest]
      (if (not (= (ast/ast-tag bvec) 6))
        (LErr "let bindings must be a vector")
        (if (not (even? (ast/asts-depth (expand/ast-kids-of (clone bvec)))))
          (LErr "let bindings must be key/value pairs")
          (if (expand/asts-null brest)
            (LErr "let body required")
            (let [rb (lower-let-binds (expand/ast-kids-of (clone bvec)) 0 (clone env) env (BNil)
                                      tab adts insts sigs lams rets ncached defs raws)]
              (match rb
                (LBErr [msg] (LErr msg))
                (LBRes [t2 a2 i2 s2 l2 r2 n2 d2 env2 binds2]
                  ; multiple body forms form an implicit sequence
                  (let [body (expand/asts-idx (clone brest) 0)
                        rbody (lower-body-1 (expand/asts-tail brest) body env2 expected t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                    (match rbody
                      (LErr [msg] (LErr msg))
                      (LOk [t3 a3 i3 s3 l3 r3 n3 d3 e3]
                        (lok t3 a3 i3 s3 l3 r3 n3 d3 (HLet (hexpr/binds-rev binds2 (BNil)) e3 (SNil)))))))))))))))

; the body after the bindings vector: one form, or an implicit Seq
(defn lower-body-1 [rest :- Asts body :- Ast env :- TyEnv expected :- Ty
                   tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                   lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (expand/asts-null rest)
    (lower body env expected tab adts insts sigs lams rets ncached defs raws)
    (lower-body-seq (KCons body rest) (HENil) env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-body-seq [forms :- Asts acc :- HExprs env :- TyEnv
                     tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                     lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [kid (expand/asts-idx (clone forms) 0)
        restq (expand/asts-null (expand/asts-tail (clone forms)))
        r (lower-1 kid (clone env) (clone tab) (clone adts) (clone insts) sigs lams rets ncached defs raws)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
        (if restq
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSeq (hexpr/hes-rev (HECons e2 acc) (HENil))))
          (lower-body-seq (expand/asts-tail forms) (HECons e2 acc) env (clone tab) adts insts s2 l2 r2 n2 d2 raws))))))

; returns env2 + accumulated binds (reversed); mirrors lower_let's three
; binding shapes: [a b] destructuring, [x :- ty value] ascription, plain.
(deftype LBRes (LBRes [tab :- i64 adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns env :- TyEnv binds :- Binds])
              (LBErr [msg :- str]))

(defn lower-let-binds [binds :- Asts i :- i64 env0 :- TyEnv env :- TyEnv
                      acc :- Binds tab :- i64 adts :- AdtTab
                      insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                      ncached :- i64 defs :- Defns raws :- &Raws] :- LBRes
  (lower-let-binds-impl (clone binds) i (ast/asts-depth binds) env0 env acc
                        tab adts insts sigs lams rets ncached defs raws))

(defn lower-let-binds-impl [binds :- Asts i :- i64 n :- i64 env0 :- TyEnv env :- TyEnv
                           acc :- Binds tab :- i64 adts :- AdtTab
                           insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                           ncached :- i64 defs :- Defns raws :- &Raws] :- LBRes
  (if (>= i n)
    (LBRes tab adts insts sigs lams rets ncached defs (clone env) acc)
    (let [name-node (expand/asts-idx (clone binds) i)
          nt (ast/ast-tag name-node)]
      (cond
        ; [a b] destructuring pattern
        (= nt 6)
        (let [val-node (expand/asts-idx (clone binds) (+ i 1))
              rv (lower-1 val-node (clone env) tab adts insts sigs lams rets ncached defs raws)]
          (match rv
            (LErr [msg] (LBErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
              (let [vt (ty-of value env r2 s2)]
                (if (not (= (types/ty-tag vt) 15))
                  (LBErr (str "destructured binding source must be a vector, got " (ty-name vt)))
                  (let [elc (types/ty-arg vt)
                        ; $d{ncached + resolved-so-far}
                        tmp-n (+ n2 (hexpr/binds-depth acc))
                        rtmp (forms/intern1 t2 (str "$d" tmp-n))]
                    (match rtmp
                      (I1Res [t3 tmp] 
                        (let [pat (expand/ast-kids-of (clone name-node))
                              ; the temp binds FIRST (the seed pushes
                              ; (tmp, value, Vec elem) before the pattern)
                              env3 (forms/te-put (clone env) tmp (types/t-vec elc))
                              acc3 (BCons tmp (clone value) (types/t-vec elc) (clone acc))
                              rp (destructure-binds pat 0 tmp elc env3 t3 a2 i2 (clone s2) l2 (clone r2) n2 d2 acc3)]
                          (match rp
                            (LBErr [msg] (LBErr msg))
                            (LBRes [t4 a4 i4 s4 l4 r4 n4 d4 env4 acc4]
                              (lower-let-binds-impl (clone binds) (+ i 2) n (clone env0) env4 acc4 t4 a4 i4 s4 l4 r4 n4 d4 raws))))))))))))
        ; [x :- ty value] ascription
        (and (= nt 1)
             (let [sep (expand/asts-idx (clone binds) (+ i 1))]
               (and (= (ast/ast-tag sep) 1) (= (expand/ast-sid-of sep) (expand/s-sep)))))
        (let [name-sid (expand/ast-sid-of name-node)
              ann (expand/asts-idx (clone binds) (+ i 2))
              val-node (expand/asts-idx (clone binds) (+ i 3))
              ra (resolve-ann-ty ann tab (clone adts) (clone sigs))]
          (match ra
            (PTyRes [ps2 ty]
              (if (forms/ps-failed ps2)
                (LBErr (ps-err-msg ps2))
                (match (clone ps2)
                  (PS [t d a sg y e]
                    (let [rv (lower-e val-node (clone env) ty t a (clone insts) sg (clone lams) (clone rets) ncached (clone defs) raws)]
                      (match rv
                        (LErr [msg] (LBErr msg))
                        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
                          (let [vt (ty-of value env r2 s2)
                                ok (or (types/ty-eq (clone vt) ty) (and (types/ty-eq ty (types/t-f64)) (types/ty-eq (clone vt) (types/t-i64))))]
                            (if (not ok)
                              (LBErr (str "let binding " (forms/sym-str t2 name-sid) " ascribed " (ty-name ty) " but the value is " (ty-name vt)))
                              (lower-let-binds-impl (clone binds) (+ i 4) n (clone env0) (forms/te-put (clone env) name-sid ty)
                                                    (BCons name-sid (clone value) ty (clone acc)) t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 raws))))))))))))
            ; plain [x value]
        (= nt 1)
        (let [name-sid (expand/ast-sid-of name-node)
              val-node (expand/asts-idx (clone binds) (+ i 1))
              rv (lower-1 val-node (clone env) tab adts insts sigs lams rets ncached defs raws)]
          (match rv
            (LErr [msg] (LBErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
              (let [vt (ty-of value env r2 s2)]
                (lower-let-binds-impl binds (+ i 2) n env0 (forms/te-put (clone env) name-sid (clone vt))
                                      (BCons name-sid (clone value) vt acc) t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 raws)))))
        (LBErr "let binding name must be a symbol or a [a b] pattern")))))

(defn ps-err-msg [ps :- &PS] :- str
  (match ps (PS [tab decls adts sigs typarams err] (clone err))))

; [a b] destructuring: bind a = (get tmp 0 default), b = (get tmp 1
; default); `_` skips. Scalar i64/f64 elements only (the seed's rule).
(defn destructure-binds [pat :- Asts k :- i64 tmp :- i64 elc :- i64
                        env :- TyEnv tab :- i64 adts :- AdtTab
                        insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                        ncached :- i64 defs :- Defns acc :- Binds] :- LBRes
  (if (>= k (ast/asts-depth pat))
    (LBRes tab adts insts sigs lams rets ncached defs env acc)
    (let [p (expand/asts-idx (clone pat) k)
          pt (ast/ast-tag p)]
      (if (not (= pt 1))
        (LBErr "destructure pattern elements must be symbols or _")
        (let [pn (expand/ast-sid-of p)]
          (if (= pn (expand/s-wild))
            (destructure-binds pat (+ k 1) tmp elc env tab adts insts sigs lams rets ncached defs acc)
            (if (and (not (= elc 0)) (not (= elc 1)))
              (LBErr (str "destructuring supports i64/f64 vectors, got element " (ty-name (types/elem-ty elc))))
              (let [et (types/elem-ty elc)
                    zero (if (= elc 0) (HConstI64 0) (HConstF64 0.0))
                    getv (HGet (HVar tmp) (HConstI64 k) (HECons zero (HENil)) (clone et) (types/t-none))
                    acc2 (BCons pn getv (clone et) acc)]
                (destructure-binds pat (+ k 1) tmp elc (forms/te-put env pn et) tab adts insts sigs lams rets ncached defs acc2)))))))))

; --- comparisons, not, abs, min/max, and/or (forms.rs) ----------------------------

(defn lower-cmp [op :- i64 items :- Asts env :- TyEnv tab :- i64
                adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr (str "comparison expects 2 operands"))
    (let [a (expand/asts-idx (clone items) 1)
          b (expand/asts-idx items 2)
          ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (let [at (ty-of e1 env r2 s2)
                      bt (ty-of e2 env r2 s2)]
                  (if (and (types/ty-eq (clone at) (types/t-str)) (types/ty-eq (clone bt) (types/t-str)))
                    ; string comparisons go through the runtime
                    (cond
                      (= op 0) (lok (clone t2) (clone a2) (clone i2) (clone s2) (clone l2) (clone r2) n2 (clone d2) (HStrCmp 1 (clone e1) (clone e2)))
                      (= op 1) (lok (clone t2) (clone a2) (clone i2) (clone s2) (clone l2) (clone r2) n2 (clone d2) (HStrCmp 0 (clone e1) (clone e2)))
                      (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HStrOrd op (clone e1) (clone e2))))
                    (if (and (types/ty-eq (clone at) (clone bt)) (types/is-numeric-ty (clone at)))
                      (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HCmpW op (clone e1) (clone e2) at))
                      (LErr (str "cannot compare " (ty-name at) " and " (ty-name bt)
                                 " — operands must share a width (cast explicitly)")))))))))))))

(defn lower-not [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "not expects 1 operand")
    (lower-1-bool (expand/asts-idx items 1) env tab adts insts sigs lams rets ncached defs "not expects a boolean operand" 25 raws)))

(defn lower-abs [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "abs expects 1 operand")
    (let [r (lower-1 (expand/asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [t (ty-of e2 env r2 s2)]
            (if (or (types/ty-eq (clone t) (types/t-i64)) (types/ty-eq (clone t) (types/t-f64)) (types/ty-eq (clone t) (types/t-i32)))
              (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HAbs (clone e2) t))
              (LErr "abs expects an i64, i32 or f64 operand"))))))))

(defn lower-minmax [op :- i64 items :- Asts env :- TyEnv tab :- i64
                   adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                   rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr (if (= op 0) "min expects 2 operands" "max expects 2 operands"))
    (let [a (expand/asts-idx (clone items) 1)
          ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [b (expand/asts-idx items 2)
                rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (match (promote-pair e1 e2 env r2 (clone s2))
                  (PResErr [msg] (LErr msg))
                  (PResOk [f1 f2]
                    (let [t (ty-of f1 env r2 s2)]
                      (if (or (types/ty-eq (clone t) (types/t-i64)) (types/ty-eq (clone t) (types/t-f64)) (types/ty-eq (clone t) (types/t-i32)))
                        (if (= op 0)
                          (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HMin f1 f2 t))
                          (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HMax f1 f2 t)))
                        (LErr (str "min/max expects i64/i32/f64 operands"))))))))))))))

(defn lower-1-bool [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns msg :- str kind :- i64 raws :- &Raws] :- LRes
  (let [r (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
        (if (not (types/ty-eq (ty-of e2 env r2 s2) (types/t-bool)))
          (LErr msg)
          (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2
               (if (= kind 25) (HNot (clone e2)) (clone e2))))))))

; post-expansion and/or is strictly binary (the expander folded variadics)
(defn lower-andor [kind :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr "and/or expects 2 operands")
    (let [a (expand/asts-idx (clone items) 1)
          b (expand/asts-idx items 2)
          ra (lower-1-bool a (clone env) tab adts insts sigs lams rets ncached defs "and/or expects boolean operands" 0 raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [rb (lower-1-bool b env t1 a1 i1 s1 l1 r1 n1 d1 "and/or expects boolean operands" 0 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (if (= kind 0)
                  (lok t2 a2 i2 s2 l2 r2 n2 d2 (HAnd e1 e2))
                  (lok t2 a2 i2 s2 l2 r2 n2 d2 (HOr e1 e2)))))))))))

; --- captures (collect_captures: first-reference pre-order) ---------------------

(deftype CapsRes (CapsRes [caps :- Caps seen :- Sids]))

(defn hv-a [e :- &HExpr] :- HExpr
  (match e
    (HConstI64 [v] (HConstI64 0))
    (HConstF64 [v] (HConstI64 0))
    (HConstB [v] (HConstI64 0))
    (HVar [name] (HConstI64 0))
    (HStrLit [v] (HConstI64 0))
    (HVecLit [el vals] (HConstI64 0))
    (HBinW [op a b ty] (HConstI64 0))
    (HBinF [op a b] (HConstI64 0))
    (HCmpW [op a b ty] (HConstI64 0))
    (HStrCmp [pol a b] (HConstI64 0))
    (HStrOrd [op a b] (HConstI64 0))
    (HICast [e from to] (clone e))
    (HCount [e] (clone e))
    (HToStr [e ty] (clone e))
    (HStrCat [args] (HConstI64 0))
    (HSubs [s a b] (clone s))
    (HSplit [s sep] (clone s))
    (HJoin [sep xs] (clone sep))
    (HStrNth [s idx res] (clone s))
    (HCharStr [e] (clone e))
    (HGet [src idx dflt ty res] (clone src))
    (HConj [v x el inplace] (clone v))
    (HIf [c t e ty] (clone c))
    (HAnd [a b] (clone a))
    (HOr [a b] (clone a))
    (HNot [e] (clone e))
    (HAbs [e ty] (clone e))
    (HMin [a b ty] (clone a))
    (HMax [a b ty] (clone a))
    (HSeq [es] (HConstI64 0))
    (HLet [binds body frees] (HConstI64 0))
    (HLoop [binds ty body] (HConstI64 0))
    (HRecur [args] (HConstI64 0))
    (HCtor [adt variant args] (HConstI64 0))
    (HMatch [scrut arms ty] (clone scrut))
    (HClone [e] (clone e))
    (HDrop [e] (clone e))
    (HClosure [sig mangled params caps body] (HConstI64 0))
    (HClosureCall [f args sig] (clone f))
    (HCall [name args] (HConstI64 0))
    (HSlurp [p] (clone p))
    (HSpit [path data] (clone path))
    (HArgs [] (HConstI64 0))
    (HExit [e] (clone e))
    (HParseNum [s int res] (clone s))
))

(defn hv-b [e :- &HExpr] :- HExpr
  (match e
    (HConstI64 [v] (HConstI64 0))
    (HConstF64 [v] (HConstI64 0))
    (HConstB [v] (HConstI64 0))
    (HVar [name] (HConstI64 0))
    (HStrLit [v] (HConstI64 0))
    (HVecLit [el vals] (HConstI64 0))
    (HBinW [op a b ty] (clone a))
    (HBinF [op a b] (clone a))
    (HCmpW [op a b ty] (clone a))
    (HStrCmp [pol a b] (clone a))
    (HStrOrd [op a b] (clone a))
    (HICast [e from to] (HConstI64 0))
    (HCount [e] (HConstI64 0))
    (HToStr [e ty] (HConstI64 0))
    (HStrCat [args] (HConstI64 0))
    (HSubs [s a b] (clone a))
    (HSplit [s sep] (clone sep))
    (HJoin [sep xs] (clone xs))
    (HStrNth [s idx res] (clone idx))
    (HCharStr [e] (HConstI64 0))
    (HGet [src idx dflt ty res] (clone idx))
    (HConj [v x el inplace] (clone x))
    (HIf [c t e ty] (clone t))
    (HAnd [a b] (clone b))
    (HOr [a b] (clone b))
    (HNot [e] (HConstI64 0))
    (HAbs [e ty] (HConstI64 0))
    (HMin [a b ty] (clone b))
    (HMax [a b ty] (clone b))
    (HSeq [es] (HConstI64 0))
    (HLet [binds body frees] (clone body))
    (HLoop [binds ty body] (HConstI64 0))
    (HRecur [args] (HConstI64 0))
    (HCtor [adt variant args] (HConstI64 0))
    (HMatch [scrut arms ty] (HConstI64 0))
    (HClone [e] (HConstI64 0))
    (HDrop [e] (HConstI64 0))
    (HClosure [sig mangled params caps body] (HConstI64 0))
    (HClosureCall [f args sig] (HConstI64 0))
    (HCall [name args] (HConstI64 0))
    (HSlurp [p] (HConstI64 0))
    (HSpit [path data] (clone data))
    (HArgs [] (HConstI64 0))
    (HExit [e] (HConstI64 0))
    (HParseNum [s int res] (HConstI64 0))
))

(defn hv-c [e :- &HExpr] :- HExpr
  (match e
    (HConstI64 [v] (HConstI64 0))
    (HConstF64 [v] (HConstI64 0))
    (HConstB [v] (HConstI64 0))
    (HVar [name] (HConstI64 0))
    (HStrLit [v] (HConstI64 0))
    (HVecLit [el vals] (HConstI64 0))
    (HBinW [op a b ty] (clone b))
    (HBinF [op a b] (clone b))
    (HCmpW [op a b ty] (clone b))
    (HStrCmp [pol a b] (clone b))
    (HStrOrd [op a b] (clone b))
    (HICast [e from to] (HConstI64 0))
    (HCount [e] (HConstI64 0))
    (HToStr [e ty] (HConstI64 0))
    (HStrCat [args] (HConstI64 0))
    (HSubs [s a b] (clone b))
    (HSplit [s sep] (HConstI64 0))
    (HJoin [sep xs] (HConstI64 0))
    (HStrNth [s idx res] (HConstI64 0))
    (HCharStr [e] (HConstI64 0))
    (HGet [_ _ _ _ _] (HConstI64 0))
    (HConj [v x el inplace] (HConstI64 0))
    (HIf [c t e ty] (clone e))
    (HAnd [a b] (HConstI64 0))
    (HOr [a b] (HConstI64 0))
    (HNot [e] (HConstI64 0))
    (HAbs [e ty] (HConstI64 0))
    (HMin [a b ty] (HConstI64 0))
    (HMax [a b ty] (HConstI64 0))
    (HSeq [es] (HConstI64 0))
    (HLet [binds body frees] (HConstI64 0))
    (HLoop [binds ty body] (clone body))
    (HRecur [args] (HConstI64 0))
    (HCtor [adt variant args] (HConstI64 0))
    (HMatch [scrut arms ty] (HConstI64 0))
    (HClone [e] (HConstI64 0))
    (HDrop [e] (HConstI64 0))
    (HClosure [sig mangled params caps body] (HConstI64 0))
    (HClosureCall [f args sig] (HConstI64 0))
    (HCall [name args] (HConstI64 0))
    (HSlurp [p] (HConstI64 0))
    (HSpit [path data] (HConstI64 0))
    (HArgs [] (HConstI64 0))
    (HExit [e] (HConstI64 0))
    (HParseNum [s int res] (HConstI64 0))
))

(defn name-of [e :- HExpr] :- i64
  (match e
    (HConstI64 [_] 0)
    (HConstF64 [_] 0)
    (HConstB [_] 0)
    (HVar [name] name)
    (HStrLit [_] 0)
    (HVecLit [_ _] 0)
    (HBinW [_ _ _ _] 0)
    (HBinF [_ _ _] 0)
    (HCmpW [_ _ _ _] 0)
    (HStrCmp [_ _ _] 0)
    (HStrOrd [_ _ _] 0)
    (HICast [_ _ _] 0)
    (HCount [_] 0)
    (HToStr [_ _] 0)
    (HStrCat [_] 0)
    (HSubs [_ _ _] 0)
    (HSplit [_ _] 0)
    (HJoin [_ _] 0)
    (HStrNth [_ _ _] 0)
    (HCharStr [_] 0)
    (HGet [_ _ _ _ _] 0)
    (HConj [_ _ _ _] 0)
    (HIf [_ _ _ _] 0)
    (HAnd [_ _] 0)
    (HOr [_ _] 0)
    (HNot [_] 0)
    (HAbs [_ _] 0)
    (HMin [_ _ _] 0)
    (HMax [_ _ _] 0)
    (HSeq [_] 0)
    (HLet [_ _ _] 0)
    (HLoop [_ _ _] 0)
    (HRecur [_] 0)
    (HCtor [_ _ _] 0)
    (HMatch [_ _ _] 0)
    (HClone [_] 0)
    (HDrop [_] 0)
    (HClosure [_ _ _ _ _] 0)
    (HClosureCall [_ _ _] 0)
    (HCall [_ _] 0)
    (HSlurp [_] 0)
    (HSpit [_ _] 0)
    (HArgs [] 0)
    (HExit [_] 0)
    (HParseNum [_ _ _] 0)))

(defn binds-of [e :- HExpr] :- Binds
  (match e
    (HConstI64 [v] (BNil))
    (HConstF64 [v] (BNil))
    (HConstB [v] (BNil))
    (HVar [name] (BNil))
    (HStrLit [v] (BNil))
    (HVecLit [el vals] (BNil))
    (HBinW [op a b ty] (BNil))
    (HBinF [op a b] (BNil))
    (HCmpW [op a b ty] (BNil))
    (HStrCmp [pol a b] (BNil))
    (HStrOrd [op a b] (BNil))
    (HICast [e from to] (BNil))
    (HCount [e] (BNil))
    (HToStr [e ty] (BNil))
    (HStrCat [args] (BNil))
    (HSubs [s a b] (BNil))
    (HSplit [s sep] (BNil))
    (HJoin [sep xs] (BNil))
    (HStrNth [s idx res] (BNil))
    (HCharStr [e] (BNil))
    (HGet [src idx dflt ty res] (BNil))
    (HConj [v x el inplace] (BNil))
    (HIf [c t e ty] (BNil))
    (HAnd [a b] (BNil))
    (HOr [a b] (BNil))
    (HNot [e] (BNil))
    (HAbs [e ty] (BNil))
    (HMin [a b ty] (BNil))
    (HMax [a b ty] (BNil))
    (HSeq [es] (BNil))
    (HLet [binds body frees] binds)
    (HLoop [binds ty body] (BNil))
    (HRecur [args] (BNil))
    (HCtor [adt variant args] (BNil))
    (HMatch [scrut arms ty] (BNil))
    (HClone [e] (BNil))
    (HDrop [e] (BNil))
    (HClosure [sig mangled params caps body] (BNil))
    (HClosureCall [f args sig] (BNil))
    (HCall [name args] (BNil))
    (HSlurp [p] (BNil))
    (HSpit [path data] (BNil))
    (HArgs [] (BNil))
    (HExit [e] (BNil))
    (HParseNum [s int res] (BNil))))

(defn frees-of [e :- HExpr] :- Sids
  (match e
    (HConstI64 [v] (SNil))
    (HConstF64 [v] (SNil))
    (HConstB [v] (SNil))
    (HVar [name] (SNil))
    (HStrLit [v] (SNil))
    (HVecLit [el vals] (SNil))
    (HBinW [op a b ty] (SNil))
    (HBinF [op a b] (SNil))
    (HCmpW [op a b ty] (SNil))
    (HStrCmp [pol a b] (SNil))
    (HStrOrd [op a b] (SNil))
    (HICast [e from to] (SNil))
    (HCount [e] (SNil))
    (HToStr [e ty] (SNil))
    (HStrCat [args] (SNil))
    (HSubs [s a b] (SNil))
    (HSplit [s sep] (SNil))
    (HJoin [sep xs] (SNil))
    (HStrNth [s idx res] (SNil))
    (HCharStr [e] (SNil))
    (HGet [src idx dflt ty res] (SNil))
    (HConj [v x el inplace] (SNil))
    (HIf [c t e ty] (SNil))
    (HAnd [a b] (SNil))
    (HOr [a b] (SNil))
    (HNot [e] (SNil))
    (HAbs [e ty] (SNil))
    (HMin [a b ty] (SNil))
    (HMax [a b ty] (SNil))
    (HSeq [es] (SNil))
    (HLet [binds body frees] frees)
    (HLoop [binds ty body] (SNil))
    (HRecur [args] (SNil))
    (HCtor [adt variant args] (SNil))
    (HMatch [scrut arms ty] (SNil))
    (HClone [e] (SNil))
    (HDrop [e] (SNil))
    (HClosure [sig mangled params caps body] (SNil))
    (HClosureCall [f args sig] (SNil))
    (HCall [name args] (SNil))
    (HSlurp [p] (SNil))
    (HSpit [path data] (SNil))
    (HArgs [] (SNil))
    (HExit [e] (SNil))
    (HParseNum [s int res] (SNil))))

(defn arms-of [e :- &HExpr] :- HArms
  (match e
    (HConstI64 [v] (HANil))
    (HConstF64 [v] (HANil))
    (HConstB [v] (HANil))
    (HVar [name] (HANil))
    (HStrLit [v] (HANil))
    (HVecLit [el vals] (HANil))
    (HBinW [op a b ty] (HANil))
    (HBinF [op a b] (HANil))
    (HCmpW [op a b ty] (HANil))
    (HStrCmp [pol a b] (HANil))
    (HStrOrd [op a b] (HANil))
    (HICast [e from to] (HANil))
    (HCount [e] (HANil))
    (HToStr [e ty] (HANil))
    (HStrCat [args] (HANil))
    (HSubs [s a b] (HANil))
    (HSplit [s sep] (HANil))
    (HJoin [sep xs] (HANil))
    (HStrNth [s idx res] (HANil))
    (HCharStr [e] (HANil))
    (HGet [src idx dflt ty res] (HANil))
    (HConj [v x el inplace] (HANil))
    (HIf [c t e ty] (HANil))
    (HAnd [a b] (HANil))
    (HOr [a b] (HANil))
    (HNot [e] (HANil))
    (HAbs [e ty] (HANil))
    (HMin [a b ty] (HANil))
    (HMax [a b ty] (HANil))
    (HSeq [es] (HANil))
    (HLet [binds body frees] (HANil))
    (HLoop [binds ty body] (HANil))
    (HRecur [args] (HANil))
    (HCtor [adt variant args] (HANil))
    (HMatch [scrut arms ty] (clone arms))
    (HClone [e] (HANil))
    (HDrop [e] (HANil))
    (HClosure [sig mangled params caps body] (HANil))
    (HClosureCall [f args sig] (HANil))
    (HCall [name args] (HANil))
    (HSlurp [p] (HANil))
    (HSpit [path data] (HANil))
    (HArgs [] (HANil))
    (HExit [e] (HANil))
    (HParseNum [s int res] (HANil))))
(defn hargs-of [e :- &HExpr] :- HExprs
  (match e
    (HConstI64 [_] (HENil))
    (HConstF64 [_] (HENil))
    (HConstB [_] (HENil))
    (HVar [_] (HENil))
    (HStrLit [_] (HENil))
    (HVecLit [_ _] (HENil))
    (HBinW [_ _ _ _] (HENil))
    (HBinF [_ _ _] (HENil))
    (HCmpW [_ _ _ _] (HENil))
    (HStrCmp [_ _ _] (HENil))
    (HStrOrd [_ _ _] (HENil))
    (HICast [_ _ _] (HENil))
    (HCount [_] (HENil))
    (HToStr [_ _] (HENil))
    (HStrCat [args] (clone args))
    (HSubs [_ _ _] (HENil))
    (HSplit [_ _] (HENil))
    (HJoin [_ _] (HENil))
    (HStrNth [_ _ _] (HENil))
    (HCharStr [_] (HENil))
    (HGet [_ _ _ _ _] (HENil))
    (HConj [_ _ _ _] (HENil))
    (HIf [_ _ _ _] (HENil))
    (HAnd [_ _] (HENil))
    (HOr [_ _] (HENil))
    (HNot [_] (HENil))
    (HAbs [_ _] (HENil))
    (HMin [_ _ _] (HENil))
    (HMax [_ _ _] (HENil))
    (HSeq [es] (clone es))
    (HLet [_ _ _] (HENil))
    (HLoop [_ _ _] (HENil))
    (HRecur [args] (clone args))
    (HCtor [_ _ args] (clone args))
    (HMatch [_ _ _] (HENil))
    (HClone [_] (HENil))
    (HDrop [_] (HENil))
    (HClosure [_ _ _ _ _] (HENil))
    (HClosureCall [_ _ _] (HENil))
    (HCall [_ args] (clone args))
    (HSlurp [_] (HENil))
    (HSpit [_ _] (HENil))
    (HArgs [] (HENil))
    (HExit [_] (HENil))
    (HParseNum [_ _ _] (HENil))))

(defn collect-caps [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [tag (h-tag e)]
    (cond
      (= tag 3)
      (let [v (name-of e)
            hit (or (types/sids-has params v) (types/sids-has seen v))]
        (if hit
          (CapsRes (clone caps) (clone seen))
          (if (forms/te-has env v)
            (CapsRes (CCons v (forms/te-get env v) 1 (clone caps)) (SCons v (clone seen)))
            (CapsRes (clone caps) (clone seen)))))
      (CapsRes caps seen))))

(defn cap-pair [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-2 (hv-a e) (hv-b e) env params seen caps))

(defn cap-2 [a :- HExpr b :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps a env (clone params) seen caps)]
    (match r1
      (CapsRes [c2 s2] (collect-caps b env params s2 c2)))))

(defn cap-un [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (collect-caps (hv-a e) env params seen caps))

(defn cap-kids [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-kids-2 (hargs-of e) env params seen caps))

(defn cap-kids-2 [es :- HExprs env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match es
    (HENil [] (CapsRes caps seen))
    (HECons [kid next]
      (let [r (collect-caps kid env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-kids-2 next env params s2 c2)))))))

(defn cap-f-args [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps (hv-a e) env (clone params) seen caps)]
    (match r1
      (CapsRes [c2 s2] (cap-kids-2 (hargs-of e) env params s2 c2)))))

(defn cap-triple [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-3 (hv-a e) (hv-b e) (hv-c e) env params seen caps))

(defn cap-3 [a :- HExpr b :- HExpr c :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps a env (clone params) seen caps)]
    (match r1
      (CapsRes [c2 s2]
        (let [r2 (collect-caps b env (clone params) s2 c2)]
          (match r2
            (CapsRes [c3 s3] (collect-caps c env params s3 c3))))))))

(defn cap-binds [binds :- Binds body :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match binds
    (BNil [] (collect-caps body env params seen caps))
    (BCons [name v ty next]
      (let [r (collect-caps v env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-binds next body env params s2 c2)))))))

(defn cap-arms [arms :- HArms caps :- Caps seen :- Sids env :- &TyEnv params :- Sids] :- CapsRes
  (match arms
    (HANil [] (CapsRes caps seen))
    (HACons [variant binders body ef next]
      (let [r (collect-caps body env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-arms next c2 s2 env params)))))))

; The full capture walk (collect_captures): dispatch on the node kind,
; recurse in the seed's field order, first-reference order preserved.
; Loop, Recur, VecLit, nested Closure and Args fall to the seed's `_` arm
; (skipped — nested closures collect their own captures).
(defn caps-of [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  ; exhaustive direct destructure — the seed's collect_captures field
  ; order; leaves, Loop, nested Closure and Args are the seed's `_` arm
  (match e
    (HVar [v] (collect-caps e env params seen caps))

    (HBinW [op a b ty] (cap-2 a b env params seen caps))
    (HBinF [op a b] (cap-2 a b env params seen caps))
    (HCmpW [op a b ty] (cap-2 a b env params seen caps))
    (HStrCmp [p a b] (cap-2 a b env params seen caps))
    (HStrOrd [op a b] (cap-2 a b env params seen caps))
    (HAnd [a b] (cap-2 a b env params seen caps))
    (HOr [a b] (cap-2 a b env params seen caps))
    (HMin [a b ty] (cap-2 a b env params seen caps))
    (HMax [a b ty] (cap-2 a b env params seen caps))
    (HConj [v x el ip] (cap-2 v x env params seen caps))
    (HSubs [s a b] (cap-2 s a env params seen caps))
    (HSplit [s sep] (cap-2 s sep env params seen caps))
    (HJoin [sep xs] (cap-2 sep xs env params seen caps))
    (HStrNth [s idx res] (cap-2 s idx env params seen caps))
    (HSpit [p d] (cap-2 p d env params seen caps))

    (HIf [c t2 e2 ty] (cap-3 c t2 e2 env params seen caps))

    (HICast [x from to] (collect-caps x env params seen caps))
    (HCount [x] (collect-caps x env params seen caps))
    (HNot [x] (collect-caps x env params seen caps))
    (HAbs [x ty] (collect-caps x env params seen caps))
    (HClone [x] (collect-caps x env params seen caps))
    (HDrop [x] (collect-caps x env params seen caps))
    (HCharStr [x] (collect-caps x env params seen caps))
    (HToStr [x ty] (collect-caps x env params seen caps))
    (HSlurp [p] (collect-caps p env params seen caps))
    (HExit [x] (collect-caps x env params seen caps))
    (HParseNum [s int res] (collect-caps s env params seen caps))

    (HStrCat [args] (cap-kids-2 args env params seen caps))
    (HSeq [es] (cap-kids-2 es env params seen caps))
    (HRecur [args] (cap-kids-2 args env params seen caps))
    (HCtor [adt variant args] (cap-kids-2 args env params seen caps))
    (HCall [name args] (cap-kids-2 args env params seen caps))

    (HGet [src idx dflt ty res]
      (let [r (cap-2 src idx env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-kids-2 dflt env params s2 c2)))))

    (HLet [binds body frees]
      (cap-binds binds body env params seen caps))

    (HMatch [scrut arms ty]
      (let [r (collect-caps scrut env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-arms-2 arms env params c2 s2)))))

    (HClosureCall [f args sig]
      (let [r (collect-caps f env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-kids-2 args env params s2 c2)))))

    ; the seed's `_` arm: constants, literals, Loop, nested Closure, Args
    (HConstI64 [v] (CapsRes caps seen))
    (HConstF64 [v] (CapsRes caps seen))
    (HConstB [v] (CapsRes caps seen))
    (HStrLit [v] (CapsRes caps seen))
    (HVecLit [el vals] (CapsRes caps seen))
    (HLoop [binds ty body] (CapsRes caps seen))
    (HClosure [sig mangled ps2 cs body] (CapsRes caps seen))
    (HArgs [] (CapsRes caps seen))))

(defn cap-match [scrut :- HExpr arms :- HArms env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r (collect-caps scrut env (clone params) seen caps)]
    (match r
      (CapsRes [c2 s2] (cap-arms-2 arms env params c2 s2)))))

(defn cap-arms-2 [arms :- HArms env :- &TyEnv params :- Sids caps :- Caps seen :- Sids] :- CapsRes
  (match arms
    (HANil [] (CapsRes caps seen))
    (HACons [variant binders body ef next]
      (let [r (collect-caps body env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-arms-2 next env params c2 s2)))))))

; --- closures -------------------------------------------------------------------

; (fn [x :- ty ...] body) — params via the sym grammar with an EMPTY
; declared-ADT table (the seed's rule); captures by first reference.
(defn lower-closure [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                    insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                    ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr "fn expects (fn [params] <body>)")
    (let [pvec (expand/asts-idx (clone items) 1)]
      (if (not (= (ast/ast-tag pvec) 6))
        (LErr "fn params must be a vector")
        (let [rp (closure-params (expand/ast-kids-of (clone pvec)) 0 (PNil) (PS tab (DLNil) adts sigs (SNil) "") (SNil))]
          (match rp
            (PParRes [ps2 params]
              (if (forms/ps-failed ps2)
                (LErr (ps-err-msg ps2))
                (match (clone ps2)
                  (PS [t2 d2 a2 s2 y2 e2]
                    (let [body (expand/asts-idx items 2)
                          ; the body lowers in the OUTER env extended with
                          ; the params (the seed's child = env + params);
                          ; captures are collected against the outer env
                          env2 (params-extend (clone env) (clone params))
                          rb (lower-1 body (clone env2) t2 a2 (clone insts) s2 (clone lams) rets ncached (clone defs) raws)]
                      (match rb
                        (LErr [msg] (LErr msg))
                        (LOk [t3 a3 i3 s3 l3 r3 n3 d3 body2]
                          (let [ret (ty-of body2 env2 r3 s3)
                                pnames (plist-names (clone params))
                                rc (caps-of (clone body2) env pnames (SNil) (CNil))]
                            (match rc
                              (CapsRes [caps seen]
                                ; dedup sig structurally; index = Ty::Fn payload
                                (let [ptys (plist-tys (clone params))
                                      rs (register-sig2 (clone s3) ptys (clone ret))]
                                  (match rs
                                    (SigRes [s4 sig]
                                      (let [midx (forms/lams-depth lams)
                                            rm (forms/intern1 t3 (str "lambda_" midx))]
                                        (match rm
                                          (I1Res [t5 mangled]
                                            (lok t5 a3 insts s4 (forms/lams-append lams (Lam mangled (clone caps) (clone params) ret (clone body2)))
                                                 (clone r3) n3 defs
                                                 (HClosure sig mangled params caps (clone body2)))))))))))))))))))))))))

(defn plist-names [ps :- PList] :- Sids
  (match ps
    (PCons [h t]
      (match h
        (Param [name ty _pb] (SCons name (plist-names t)))))
    (PNil [] (SNil))))

; the outer env extended with the fn params, in order
(defn params-extend [env :- TyEnv ps :- PList] :- TyEnv
  (match ps
    (PCons [p rest]
      (match p
        (Param [name ty _pb] (params-extend (forms/te-put env name ty) rest))))
    (PNil [] env)))

(defn plist-tys [ps :- PList] :- TyList
  (match ps
    (PCons [h t]
      (match h
        (Param [name ty _pb] (TyCons ty (plist-tys t)))))
    (PNil [] (TyNil))))

; register-sig over the plain tables; returns the table index
(deftype SigRes (SigRes [sigs :- Sigs idx :- i64]))

(defn register-sig2 [sigs :- Sigs params :- TyList ret :- Ty] :- SigRes
  (let [i (forms/sigs-find sigs params (clone ret) 0)]
    (if (>= i 0)
      (SigRes sigs i)
      (SigRes (SGCons (Sig params ret) (clone sigs)) (forms/sigs-depth sigs)))))

; a closure param annotation: parse_ty_sym with an empty ADT table —
; scalars, the vec/map/set spellings, or a fresh uppercase type parameter
(deftype CtyRes (CtyRes [tps :- Sids ty :- Ty msg :- str]))

(defn closure-ty-sym [s :- str tps :- Sids tab :- i64] :- CtyRes
  (cond
    (= s "i64")    (CtyRes tps (types/t-i64) "")
    (= s "i32")    (CtyRes tps (types/t-i32) "")
    (= s "i8")     (CtyRes tps (types/t-i8) "")
    (= s "i16")    (CtyRes tps (types/t-i16) "")
    (= s "u8")     (CtyRes tps (types/t-u8) "")
    (= s "u16")    (CtyRes tps (types/t-u16) "")
    (= s "u32")    (CtyRes tps (types/t-u32) "")
    (= s "u64")    (CtyRes tps (types/t-u64) "")
    (= s "usize")  (CtyRes tps (types/t-usize) "")
    (= s "f64")    (CtyRes tps (types/t-f64) "")
    (= s "f32")    (CtyRes tps (types/t-f32) "")
    (= s "vec")    (CtyRes tps (types/t-vec 0) "")
    (= s "bool")   (CtyRes tps (types/t-bool) "")
    (= s "str")    (CtyRes tps (types/t-str) "")
    (= s "string") (CtyRes tps (types/t-str) "")
    (= s "map")    (CtyRes tps (types/t-map) "")
    (= s "set")    (CtyRes tps (types/t-set) "")
    (if (forms/is-upper s)
      (let [r (forms/intern1 (clone tab) s)]
        (match r
          (I1Res [tab2 sid]
            (CtyRes (types/sids-append (clone tps) sid) (types/t-param (types/sids-depth tps)) ""))))
      (CtyRes tps (types/t-none) (str "unknown type name " s)))))

(defn closure-params [els :- Asts i :- i64 acc :- PList ps :- PS tps :- Sids] :- PParRes
  (if (>= i (ast/asts-depth els))
    (PParRes ps (forms/plist-rev acc (PNil)))
    (let [nm (expand/asts-idx (clone els) i)
          sep (expand/asts-idx (clone els) (+ i 1))]
      (if (not (= (ast/ast-tag nm) 1))
        (PParRes (forms/ps-err ps "fn param must be a symbol") (PNil))
        (if (not (and (= (ast/ast-tag sep) 1) (= (expand/ast-sid-of sep) (expand/s-sep))))
          (PParRes (forms/ps-err ps (str "fn param " (forms/node-str (clone nm) (forms/ps-tab ps)) " needs a type annotation in this slice (x :- i64)")) (PNil))
          (let [tyn (expand/asts-idx (clone els) (+ i 2))
                rt (closure-ty-sym (forms/node-str tyn (forms/ps-tab ps)) tps (forms/ps-tab ps))]
            (match rt
              (CtyRes [tps2 ty msg]
                (if (> (count msg) 0)
                  (PParRes (forms/ps-err ps msg) (PNil))
                  (closure-params els (+ i 3) (PCons (Param (expand/ast-sid-of nm) ty 0) acc) ps tps2))))))))))

; --- loop / recur -----------------------------------------------------------------

; loop binding values, sequential scoping
(defn lower-loop-binds [binds :- Asts i :- i64 n :- i64 env :- TyEnv acc :- Binds
                       tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                       lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LBRes
  (if (>= i n)
    (LBRes tab adts insts sigs lams rets ncached defs (clone env) acc)
    (let [nm (expand/asts-idx (clone binds) i)
          sep (expand/asts-idx (clone binds) (+ i 1))]
      (if (not (= (ast/ast-tag nm) 1))
        (LBErr "loop binding name must be a symbol")
        (if (not (and (= (ast/ast-tag sep) 1) (= (expand/ast-sid-of sep) (expand/s-sep))))
          (LBErr (str "loop binding " (forms/node-str (clone nm) tab) " needs a type ascription (x :- ty init) — loop variables are typed, not inferred"))
          (let [tyn (expand/asts-idx (clone binds) (+ i 2))
                initn (expand/asts-idx (clone binds) (+ i 3))
                ra (resolve-ann-ty tyn tab (clone adts) (clone sigs))]
            (match ra
              (PTyRes [ps2 ty]
                (if (forms/ps-failed ps2)
                  (LBErr (ps-err-msg ps2))
                  (match (clone ps2)
                    (PS [t2 d2 a2 s2 y2 e2]
                      ; S8: loop variables may also be boxed ADTs and
                      ; collection headers — the reader threads its frame
                      ; stack, children and intern table through one loop.
                      ; Loop variables are never freed and never moved, so
                      ; the recursion the loop replaces cannot double-free.
                      (if (and (not (types/is-copy-ty (clone ty)))
                               (not (or (= (types/ty-tag ty) 16)
                                        (= (types/ty-tag ty) 15)
                                        (= (types/ty-tag ty) 13)
                                        (= (types/ty-tag ty) 14))))
                        (LBErr (str "loop variable " (forms/node-str (clone nm) t2) " has non-Copy type " (ty-name ty) " — loop variables are numeric/bool/str/ADT/collection in this slice"))
                        (let [ri (lower-e initn (clone env) ty t2 a2 (clone insts) s2 (clone lams) (clone rets) ncached (clone defs) raws)]
                          (match ri
                            (LErr [msg] (LBErr msg))
                            (LOk [t3 a3 i3 s3 l3 r3 n3 d3 init]
                              (let [it (ty-of init env r3 s3)
                                    empty-vec (and (= (types/ty-tag ty) 15) (= (h-tag init) 5) (= (hexpr/vvals-depth-of (clone init)) 0))]
                                (if (and (not (types/ty-eq (clone it) ty)) (not (and (types/ty-eq ty (types/t-f64)) (types/ty-eq (clone it) (types/t-i64)))) (not empty-vec))
                                  (LBErr (str "loop binding " (forms/node-str (clone nm) t3) " ascribed " (ty-name ty) " but the initial value is " (ty-name it)))
                                  (let [init2 (if (and (types/ty-eq ty (types/t-f64)) (types/ty-eq it (types/t-i64)))
                                                (HICast (clone init) (types/t-i64) (types/t-f64))
                                                (clone init))]
                                    (lower-loop-binds binds (+ i 4) n (forms/te-put (clone env) (expand/ast-sid-of nm) ty)
                                                      (BCons (expand/ast-sid-of nm) init2 ty acc)
                                                      t3 a3 i3 (clone s3) l3 (clone r3) n3 d3 raws)))))))))))))))))))

(defn lower-loop [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (< (ast/asts-depth items) 3)
    (LErr "loop expects (loop [x :- ty init ...] body...)")
    (let [bvec (expand/asts-idx (clone items) 1)]
      (if (not (= (ast/ast-tag bvec) 6))
        (LErr "loop bindings must be a vector")
        (let [bkids (expand/ast-kids-of (clone bvec))
              rb (lower-loop-binds (clone bkids) 0 (ast/asts-depth bkids) env (BNil)
                                   tab adts insts sigs lams rets ncached defs raws)]
          (match rb
            (LBErr [msg] (LErr msg))
            (LBRes [t2 a2 i2 s2 l2 r2 n2 d2 env2 binds2]
              ; multiple body forms form an implicit sequence; the last
              ; carries the loop's type. items includes the `loop` head
              ; and the bindings vector — the body starts at index 2.
              (let [body-forms (expand/asts-drop items 2)
                    rb2 (lower-do body-forms (clone env2) (types/t-none) t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                (match rb2
                  (LErr [msg] (LErr msg))
                  (LOk [t3 a3 i3 s3 l3 r3 n3 d3 body2]
                    (let [ty (ty-of body2 env2 r3 s3)
                          rv (validate-recurs (clone body2) (hexpr/binds-depth binds2))]
                      (match rv
                        (VErr [msg] (LErr (str "loop: " msg)))
                        (LOk2 [] (lok t3 a3 i3 (clone s3) l3 (clone r3) n3 d3 (HLoop (hexpr/binds-rev binds2 (BNil)) ty (clone body2))))))))))))))))

; recur tail-position validation (validate_recurs); LOk2 is a unit-ok
(deftype VRes (LOk2) (VErr [msg :- str]))


 

(defn validate-recurs [e :- HExpr arity :- i64] :- VRes
  (validate-recurs-2 e arity true false))

(defn validate-recurs-2 [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [tag (h-tag e)]
    (cond
      (= tag 32)
      (v-recur-arm (clone e) arity inloop crossed)

      (= tag 22)
      (v-if-arm (clone e) arity inloop crossed)

      (= tag 30)
      (validate-let (binds-of (clone e)) (hv-b e) arity inloop crossed)

      (= tag 29)
      (validate-seq (hargs-of e) arity inloop crossed)

      (= tag 34)
      (v-match-arm (clone e) arity inloop crossed)

      (= tag 31)
      (LOk2)

      (v-default-arm (clone e) arity inloop crossed))))

(defn v-recur-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (if crossed
    (VErr "recur cannot cross a closure boundary")
    (if (not inloop)
      (VErr "recur in this position is not in tail position (recur may end the loop body, an if branch, a match arm, or a let/do tail)")
      (if (= (hexpr/hes-depth (hexpr/recur-args (clone e))) arity)
        (LOk2)
        (VErr (str "recur expects " arity " argument(s) to match the loop bindings, got " (hexpr/hes-depth (hexpr/recur-args e))))))))

(defn v-if-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [r1 (validate-recurs-2 (hv-a e) arity false crossed)]
    (match r1
      (VErr [msg] (VErr msg))
      (LOk2 []
        (let [r2 (validate-recurs-2 (hv-b e) arity inloop crossed)]
          (match r2
            (VErr [msg] (VErr msg))
            (LOk2 [] (validate-recurs-2 (hv-c e) arity inloop crossed))))))))

(defn v-match-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [r1 (validate-recurs-2 (hv-a e) arity false crossed)]
    (match r1
      (VErr [msg] (VErr msg))
      (LOk2 [] (validate-arms (arms-of e) arity inloop crossed)))))

(defn v-default-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (if (contains-recur (clone e) 0)
    (if (= (h-tag e) 37)
      (VErr "recur cannot cross a closure boundary")
      (VErr "recur in this position is not in tail position (recur may end the loop body, an if branch, a match arm, or a let/do tail)"))
    (LOk2)))

(defn validate-let [binds :- Binds body :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (match binds
    (BNil [] (validate-recurs-2 body arity inloop crossed))
    (BCons [name v ty next]
      (let [r (validate-recurs-2 v arity false crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-let next body arity inloop crossed)))))))

(defn validate-seq [es :- HExprs arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [restq (expand/asts-null (asts-tail-hes es))]
    (if restq
      (validate-recurs-2 (hes-head-hes es) arity inloop crossed)
      (let [r (validate-recurs-2 (hes-head-hes es) arity false crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-seq (asts-tail-hes es) arity inloop crossed)))))))

(defn validate-arms [arms :- HArms arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (match arms
    (HANil [] (LOk2))
    (HACons [variant binders body ef next]
      (let [r (validate-recurs-2 body arity inloop crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-arms next arity inloop crossed)))))))

(defn contains-recur [e :- HExpr depth :- i64] :- bool
  (if (> depth 200)
    false
    (let [tag (h-tag e)]
      (cond
        (= tag 32) true
        (= tag 37) false
        (= tag 22) (or (contains-recur (hv-a e) (+ depth 1))
                       (or (contains-recur (hv-b e) (+ depth 1))
                           (contains-recur (hv-c e) (+ depth 1))))
        (= tag 30) (contains-recur (hv-b e) (+ depth 1))
        (= tag 29) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 34) (or (contains-recur (hv-a e) (+ depth 1))
                       (arms-contains-recur (arms-of e) (+ depth 1)))
        (= tag 39) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 33) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 14) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 23) (or (contains-recur (hv-a e) (+ depth 1)) (contains-recur (hv-b e) (+ depth 1)))
        (= tag 24) (or (contains-recur (hv-a e) (+ depth 1)) (contains-recur (hv-b e) (+ depth 1)))
        false))))

(defn seq-contains-recur [es :- HExprs depth :- i64] :- bool
  (match es
    (HENil [] false)
    (HECons [kid next] (or (contains-recur kid depth) (seq-contains-recur next depth)))))

(defn arms-contains-recur [arms :- HArms depth :- i64] :- bool
  (match arms
    (HANil [] false)
    (HACons [variant binders body ef next] (or (contains-recur body depth) (arms-contains-recur next depth)))))

(defn kids-contains-recur [es :- HExprs depth :- i64] :- bool
  (seq-contains-recur es depth))

; --- match (+ :when guards) ------------------------------------------------------

; The guard rewrite (match_lower.rs): an arm (V [b :when g] body) becomes
; (V [b] (if g body (match scrut rest...))) plus a routing (_ (match scrut
; rest...)) — the rest chain is the ORIGINAL Ast tail, so the rewrite
; re-enters lower-match.
(defn lower-match [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (< (ast/asts-depth items) 3)
    (LErr "match expects a scrutinee and at least one arm")
    (match (find-guard (expand/asts-tail (expand/asts-tail (clone items))) 0)
      (GFound [gi garm] (lower-match-g items env expected tab adts insts sigs lams rets ncached defs gi garm raws))
      (GNone [] (lower-match-plain items env expected tab adts insts sigs lams rets ncached defs raws)))))

(deftype GRes (GFound [gi :- i64 garm :- Ast]) (GNone []))

; the first arm whose binders contain :when (index within the arm list)
(defn find-guard [arms :- Asts i :- i64] :- GRes
  (match arms
    (KNil [] (GNone))
    (KCons [arm rest]
      (if (arm-has-guard (clone arm))
        (GFound i arm)
        (find-guard rest (+ i 1))))))

(defn arm-has-guard [arm :- Ast] :- bool
  (let [kids (expand/ast-kids-of arm)]
    (if (< (ast/asts-depth kids) 2)
      false
      (let [bs (expand/asts-idx kids 1)]
        (if (not (= (ast/ast-tag bs) 6))
          false
          (binder-guard (expand/ast-kids-of (clone bs))))))))

(defn binder-guard [bs :- Asts] :- bool
  (match bs
    (KNil [] false)
    (KCons [b rest]
      (or (and (= (ast/ast-tag b) 1) (= (expand/ast-sid-of b) (expand/s-whenkw)))
          (binder-guard rest)))))

; index of :within the binder vector, or -1
(defn guard-pos [bs :- Asts i :- i64] :- i64
  (match bs
    (KNil [] -1)
    (KCons [b rest]
      (if (and (= (ast/ast-tag b) 1) (= (expand/ast-sid-of b) (expand/s-whenkw)))
        i
        (guard-pos rest (+ i 1))))))

(defn mk-sp [] :- Span
  (Span 0 0 0))

(defn mk-match-call [scrut :- Ast rest :- Asts] :- Ast
  (AList (KCons (ASym (expand/s-match) (mk-sp)) (KCons scrut rest)) (mk-sp)))

(defn mk-guard-if [g :- Ast body :- Ast else-ast :- Ast] :- Ast
  (AList (KCons (ASym (expand/s-if) (mk-sp))
          (KCons g (KCons body (KCons else-ast (KNil)))))
         (mk-sp)))

(defn arm-head [arm :- Ast] :- Ast
  (expand/asts-idx (expand/ast-kids-of arm) 0))

(defn arm-binders [arm :- Ast] :- Ast
  (expand/asts-idx (expand/ast-kids-of arm) 1))

(defn arm-body [arm :- Ast] :- Ast
  (expand/asts-idx (expand/ast-kids-of arm) 2))

(defn mk-rewritten-arm [garm :- Ast if-body :- Ast] :- Ast
  (AList (KCons (arm-head (clone garm))
          (KCons (AVec (binder-pre (expand/ast-kids-of (arm-binders garm))) (mk-sp))
          (KCons if-body (KNil))))
         (mk-sp)))

(defn mk-route-arm [match-ast :- Ast] :- Ast
  (AList (KCons (ASym (expand/s-wild) (mk-sp)) (KCons match-ast (KNil))) (mk-sp)))

(defn lower-match-g [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                    adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                    rets :- TyEnv ncached :- i64 defs :- Defns
                    gi :- i64 garm :- Ast raws :- &Raws] :- LRes
  (if (not (guard-shape-ok (clone garm)))
    (LErr "guard arms expect (Variant [binders :when cond] body)")
    (let [scrut (expand/asts-idx (clone items) 1)
          rp (lower-1 (clone scrut) (clone env) (clone tab) (clone adts) (clone insts) (clone sigs) (clone lams) (clone rets) ncached (clone defs) raws)]
      (match rp
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 probe]
          (let [pt (ty-of probe env r2 s2)]
            (if (not (= (types/ty-tag pt) 16))
              (LErr "guard arms require an ADT scrutinee")
              (let [vdef (forms/adts-at a2 (types/ty-arg pt))
                    rest (expand/asts-tail (expand/asts-drop (clone items) (+ 2 gi)))
                    rest-heads (arm-heads (clone rest))
                    covered (or (types/sids-has rest-heads (expand/s-wild))
                                (all-covered rest-heads vdef 0))]
                (if (not covered)
                  (LErr (str "guard arm " (forms/sym-str (clone tab) (expand/asts-head-sid (expand/ast-kids-of garm))) " falls through, but the later arms do not cover every variant (add a _ arm)"))
                  (let [arms0 (expand/asts-drop (clone items) 2)
                        before-g (match-asts-take arms0 gi (KNil))
                        inner (mk-match-call (expand/asts-idx (clone items) 1) (clone rest))
                        if-body (mk-guard-if (binder-cond (expand/ast-kids-of (arm-binders (clone garm))))
                                             (arm-body (clone garm))
                                             inner)
                        rewritten (mk-rewritten-arm garm if-body)
                        route (mk-route-arm (mk-match-call (expand/asts-idx items 1) rest))
                        next-arms (expand/asts-append (expand/asts-append before-g rewritten) route)
                        next-items (KCons (ASym (expand/s-match) (mk-sp)) (KCons scrut next-arms))]
                    (lower-match next-items (clone env) expected tab adts insts sigs lams rets ncached defs raws)))))))))))

(defn binder-pre [bs :- Asts] :- Asts
  ; binders before :when
  (match bs
    (KNil [] (KNil))
    (KCons [b rest]
      (if (and (= (ast/ast-tag b) 1) (= (expand/ast-sid-of b) (expand/s-whenkw)))
        (KNil)
        (KCons (clone b) (binder-pre rest))))))

(defn binder-cond [bs :- Asts] :- Ast
  ; the condition right after :when
  (match bs
    (KNil [] (ANil (Span 0 0 0)))
    (KCons [b rest]
      (if (and (= (ast/ast-tag b) 1) (= (expand/ast-sid-of b) (expand/s-whenkw)))
        (expand/asts-idx rest 0)
        (binder-cond rest)))))

(defn match-asts-take [ks :- Asts n :- i64 acc :- Asts] :- Asts
  (if (<= n 0)
    (match-asts-rev acc (KNil))
    (match ks
      (KNil [] (match-asts-rev acc (KNil)))
      (KCons [kid rest] (match-asts-take rest (- n 1) (KCons kid acc))))))

(defn match-asts-rev [ks :- Asts acc :- Asts] :- Asts
  (match ks
    (KCons [kid rest] (match-asts-rev rest (KCons kid acc)))
    (KNil [] acc)))

(defn asts-drop-last-n [ks :- Asts n :- i64 acc :- i64] :- Asts
  ; drop everything after the first n elements
  (if (<= n 0)
    (KNil)
    (match ks
      (KNil [] (KNil))
      (KCons [kid rest]
        (if (= n 1)
          (KCons kid (KNil))
          (KCons kid (asts-drop-last-n rest (- n 1) 0)))))))

(defn guard-shape-ok [arm :- Ast] :- bool
  (if (not (= (ast/ast-tag arm) 5))
    false
    (let [vitems (expand/ast-kids-of (clone arm))]
      (and (= (ast/asts-depth vitems) 3)
           (let [bs (expand/asts-idx vitems 1)
                 bs-kids (expand/ast-kids-of (clone bs))
                 wpos (guard-pos (clone bs-kids) 0)]
             (and (= (ast/ast-tag bs) 6)
                  (not (= wpos -1))
                  (= (+ wpos 2) (ast/asts-depth bs-kids))))))))

(defn arm-heads [arms :- Asts] :- Sids
  (match arms
    (KNil [] (SNil))
    (KCons [arm rest]
      (SCons (expand/asts-head-sid (expand/ast-kids-of arm)) (arm-heads rest)))))

(defn o-sids [] :- Sids
  (SNil))

(defn variant-count [info :- AdtInfo] :- i64
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (forms/vlist-depth variants))))

(defn all-covered [heads :- Sids info :- AdtInfo i :- i64] :- bool
  (match info
    (AdtInfo [name typarams variants tpl tplargs]
      (if (>= i (forms/vlist-depth variants))
        true
        (let [vn (forms/varnt-name-at variants i)]
          (if (types/sids-has heads vn)
            (all-covered heads info (+ i 1))
            false))))))

; the non-guard path: build the HMatch
(defn lower-match-plain [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                        adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                        rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [scrut (expand/asts-idx (clone items) 1)
        rs (lower-1 scrut (clone env) (clone tab) adts insts sigs lams rets ncached defs raws)]
    (match rs
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 scrut2]
        (let [pt (ty-of scrut2 env r2 s2)]
          (if (not (= (types/ty-tag pt) 16))
            (LErr "match scrutinee must be an ADT value")
            (let [adt (types/ty-arg pt)
                  vdef (forms/adts-at a2 adt)
                  ra (match-arms (expand/asts-tail (expand/asts-tail items)) (clone vdef) adt (clone env) pt t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HANil) (TyNil) false 0 raws)]
              (match ra
                (MArr [msg] (LErr msg))
                (MRes [t3 a3 i3 s3 l3 r3 n3 d3 arms3 tys3 wildcard3 narms]
                  (match (finish-match (clone tys3) wildcard3 narms vdef tab)
                    (VErr [msg] (LErr msg))
                    (LOk2 []
                      (let [merged (merge-arm-tys (clone tys3))]
                        (lok t3 a3 i3 s3 l3 r3 n3 d3
                             (HMatch (clone scrut2)
                                     (arms-coerce (hexpr/arms-rev arms3 (HANil)) (types/tys-rev tys3 (TyNil)) (clone merged))
                                     merged))))))))))))))

; arms accumulate: (reversed arms chain, arm types in order, wildcard flag)
(deftype MRes (MRes [tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                    lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                    arms :- HArms tys :- TyList wildcard :- bool narms :- i64])
             (MArr [msg :- str]))

(defn rms-rev [arms :- HArms acc :- HArms] :- HArms
  (match arms
    (HANil [] acc)
    (HACons [variant binders body ef next] (hexpr/arms-rev next (HACons variant binders body (AFNone) acc)))))

(defn match-arms [arms :- Asts vdef :- AdtInfo adt :- i64 env :- TyEnv pt :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                 acc :- HArms tys :- TyList wildcard :- bool narms :- i64 raws :- &Raws] :- MRes
  (match arms
    (KNil [] (MRes tab adts insts sigs lams rets ncached defs acc tys wildcard narms))
    (KCons [arm rest]
      (let [head (expand/asts-head-sid (expand/ast-kids-of (clone arm)))]
        (if (= head (expand/s-wild))
          ; wildcard arm: (_ body)
          (if wildcard
            (MArr "match has more than one wildcard arm")
            (if (not (= (ast/asts-depth (expand/ast-kids-of (clone arm))) 2))
              (MArr "wildcard arm expects (_ body)")
              (let [bodyn (expand/asts-idx (expand/ast-kids-of arm) 1)
                    rb (lower-e bodyn (clone env) (clone pt) (clone tab) (clone adts) (clone insts) (clone sigs) (clone lams) (clone rets) ncached defs raws)]
                (match rb
                  (LErr [msg] (MArr msg))
                  (LOk [t2 a2 i2 s2 l2 r2 n2 d2 body2]
                    (let [bt (ty-of body2 env r2 s2)]
                      ; same as the variant arm: the body's lowering hands the
                      ; definition list back, so it is threaded, not copied
                      (match-arms rest vdef adt (clone env) pt (clone tab) adts insts sigs lams rets ncached d2
                                  (HACons -1 (SNil) (clone body2) (AFNone) acc) (TyCons bt tys) true (+ 1 narms) raws)))))))
          ; variant arm: (V [b1 b2] body)
          (let [vi (variant-index (clone vdef) head 0)]
            (if (< vi 0)
              (MArr (str (forms/sym-str (clone tab) head) " is not a variant of " (adts-name vdef (clone tab))))
              (let [fields (variant-fields vdef vi)]
                (match-variant-arm arm rest vdef adt vi fields (clone env) pt tab adts insts sigs lams rets ncached defs acc tys wildcard narms raws)))))))))

(defn adts-name [info :- AdtInfo tab :- i64] :- str
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (forms/sym-str (clone tab) name))))

(defn variant-index [info :- AdtInfo name :- i64 i :- i64] :- i64
  (match info
    (AdtInfo [name2 typarams variants tpl tplargs]
      (if (>= i (forms/vlist-depth variants))
        -1
        (let [vn (forms/varnt-name-at variants i)]
          (if (= vn name) i (variant-index info name (+ i 1))))))))

; Borrowed: the caller keeps its AdtInfo (it used to clone the whole thing,
; which also meant a deep drop afterwards) and only the field list is copied.
(defn variant-fields [info :- &AdtInfo vi :- i64] :- TyList
  (match info
    (AdtInfo [name typarams variants tpl tplargs]
      (forms/vlist-fields-at variants vi))))

(defn match-variant-arm [arm :- Ast rest :- Asts vdef :- AdtInfo adt :- i64 vi :- i64
                        fields :- TyList env :- TyEnv pt :- Ty tab :- i64
                        adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                        rets :- TyEnv ncached :- i64 defs :- Defns
                        acc :- HArms tys :- TyList wildcard :- bool narms :- i64 raws :- &Raws] :- MRes
  (if (not (= (ast/ast-tag arm) 5))
    (MArr "match arm must be a list")
    (let [vitems (expand/ast-kids-of (clone arm))]
      (if (not (= (ast/asts-depth vitems) 3))
        (MArr (str "match arm " (forms/sym-str (clone tab) (expand/asts-head-sid vitems)) " expects (" (forms/sym-str (clone tab) (expand/asts-head-sid vitems)) " [binders...] body)"))
        (let [bs (expand/asts-idx (clone vitems) 1)]
          (if (not (= (ast/ast-tag bs) 6))
            (MArr (str "match arm " (forms/sym-str (clone tab) (expand/asts-head-sid vitems)) " binders must be a vector"))
            (if (not (= (ast/asts-depth (expand/ast-kids-of (clone bs))) (types/tys-depth fields)))
              (MArr (str "variant " (adts-name vdef (clone tab)) " has " (types/tys-depth fields) " field(s) but the arm binds " (ast/asts-depth (expand/ast-kids-of (clone bs)))))
              ; binders: wildcard `_` gets a gensym
              (let [rb (match-binders (expand/ast-kids-of (clone bs)) fields 0 (clone env) (SNil) (SNil) (clone tab) ncached)]
                (match rb
                  (MBErr [msg] (MArr msg))
                  (MBRes [t3 n3 env3 binders3]
                    (let [bodyn (expand/asts-idx vitems 2)
                          rb2 (lower-e bodyn (clone env3) (clone pt) t3 adts insts (clone sigs) (clone lams) (clone rets) n3 defs raws)]
                      (match rb2
                        (LErr [msg] (MArr msg))
                        (LOk [t4 a4 i4 s4 l4 r4 n4 d4 body2]
                          (let [bt (ty-of body2 env3 r4 s4)]
                            ; Thread the defs the body lowering handed back.
                            ; Expression lowering never adds a definition, so
                            ; d4 *is* defs — and cloning defs here (the whole
                            ; program's definition list, bodies included)
                            ; accounted for a third of the kernel's churn.
                            (match-arms rest vdef adt env pt (clone tab) a4 i4 sigs lams rets ncached d4
                                        (HACons vi binders3 (clone body2) (AFNone) acc) (TyCons bt tys) wildcard (+ 1 narms) raws))
)))))))))))))

; The table and instance map were threaded through this walk and returned
; untouched — callers cloned a whole AdtTab (and an IMap) per arm to satisfy
; the shape. Nothing here reads them, so they are gone.
(deftype MBRes (MBRes [tab :- i64 ncached :- i64 env :- TyEnv binders :- Sids])
              (MBErr [msg :- str]))

(defn match-binders [bs :- Asts fields :- TyList k :- i64 env :- TyEnv acc :- Sids
                    seen :- Sids tab :- i64 ncached :- i64] :- MBRes
  (if (>= k (ast/asts-depth bs))
    (MBRes tab ncached env (types/sids-rev acc (SNil)))
    (let [b (expand/asts-idx (clone bs) k)
          fty (types/tys-idx (clone fields) k)]
      (if (not (= (ast/ast-tag b) 1))
        (MBErr (str "match arm binder must be a symbol"))
        (let [bn (expand/ast-sid-of b)]
          (if (= bn (expand/s-wild))
            ; unique gensym, never referenced by the arm body
            (let [g (forms/intern1 tab (str "_wild" (+ k ncached)))]
              (match g
                (I1Res [tab2 gsid]
                  (match-binders bs fields (+ k 1) env (SCons gsid acc) (SCons gsid seen) tab2 ncached))))
            (match-binders bs fields (+ k 1) (forms/te-put env bn fty) (SCons bn acc) (SCons bn seen) tab ncached)))))))

; exhaustiveness + the f64-promoting arm merge (finish_match)
; exhaustiveness: a wildcard arm present, or the arm count (each variant
; at most once — the seed's duplicate check is message-only here) covers
; every variant. Missing-variant NAMES in the diagnostic are a nicety the
; byte contract does not pin.
(defn finish-match [tys :- TyList wildcard :- bool narms :- i64 vdef :- AdtInfo tab :- i64] :- VRes
  (if (not wildcard)
    (if (< narms (vlist-depth-of (clone vdef)))
      (VErr (str "match on " (adts-name vdef tab) " does not cover: (add arms or a _ wildcard)"))
      (LOk2))
    (LOk2)))

(defn vlist-depth-of [info :- AdtInfo] :- i64
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (forms/vlist-depth variants))))

; the arm merge (the seed's f64 promotion): f64 wins over i64; all-else
; must agree exactly
(defn merge-arm-tys [tys :- TyList] :- Ty
  (if (tys-has-f64 (clone tys))
    (types/t-f64)
    (types/tys-idx tys 0)))

(defn tys-has-f64 [tys :- TyList] :- bool
  (match tys
    (TyNil [] false)
    (TyCons [h t] (or (types/ty-eq h (types/t-f64)) (tys-has-f64 t)))))



; coerce int arm bodies up when the merged match type is f64 (the seed's
; finish_match coercion walk, in arm order)
(defn arms-coerce [arms :- HArms tys :- TyList merged :- Ty] :- HArms
  (match arms
    (HANil [] (HANil))
    (HACons [variant binders body ef next]
      (match tys
        (TyNil [] (HANil))
        (TyCons [t trest]
          (HACons variant binders
                  (coerce-f64 body t (types/ty-eq (clone merged) (types/t-f64))) (AFNone)
                  (arms-coerce next trest merged)))))))

; --- constructor resolution ------------------------------------------------------

; find a variant constructor among DECLARED templates (instances share
; their template's ctors and are never resolved directly)
(defn find-variant [ts :- &AdtTab name :- i64] :- FVRes
  (find-variant-2 ts name 0 0))

(deftype FVRes (FVFound [adt :- i64 variant :- i64 fields :- TyList]) (FVMiss))

(defn find-variant-2 [ts :- &AdtTab name :- i64 ai :- i64 vi :- i64] :- FVRes
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [aname typarams variants tpl tplargs]
          (if (not (= tpl -1))
            (find-variant-2 t name (+ ai 1) 0)
            (if (>= vi (forms/vlist-depth variants))
              (find-variant-2 t name (+ ai 1) 0)
              (let [v (forms/vlist-at variants vi)]
                (match v
                  (Varnt [vname fields]
                    (if (= vname name)
                      (FVFound ai vi fields)
                      (find-variant-2 ts name ai (+ vi 1)))))))))))
    (ATNil [] (FVMiss))))

; lower a ctor call: fields unify against the template; nullary ctors
; infer from the expected type's instance
(defn lower-ctor [fv :- FVRes items :- Asts env :- TyEnv expected :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (match fv
    (FVMiss [] (LErr "internal: ctor miss"))
    (FVFound [adt variant fields]
      (let [tpl-params (adts-tparams adts adt)
            ; expected pinning: an instance of this template takes its fields
            inst-exp (if (and (> tpl-params 0) (= (types/ty-tag expected) 16))
                       (instance-of-template adts (types/ty-arg expected) adt)
                       -1)]
        (if (>= inst-exp 0)
          ; the expected instance pins the ctor (the seed's inst_expected
          ; rule): its fields, its table index, no inference
          (lower-ctor-fields items inst-exp variant (instance-fields (clone adts) inst-exp variant)
                             env 0 (TENil)
                             tab adts insts sigs lams rets ncached defs 0 (HENil) raws)
          (lower-ctor-fields items adt variant fields
                             env tpl-params (TENil)
                             tab adts insts sigs lams rets ncached defs 0 (HENil) raws))))))

(defn index-sids [n :- i64 i :- i64] :- Sids
  (if (>= i n) (SNil) (SCons i (index-sids n (+ i 1)))))

(defn subs-collect [subs :- &TyEnv i :- i64 n :- i64] :- TyList
  (if (>= i n) (TyNil) (TyCons (forms/te-get subs i) (subs-collect subs (+ i 1) n))))

(defn ctor-instantiate [adt :- i64 variant :- i64 args :- HExprs targs :- TyList
                       tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                       lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [r (forms/instantiate-adt adt targs (PS tab (DLNil) adts sigs (SNil) ""))]
    (match r
      (PIARes [ps2 idx]
        (if (forms/ps-failed ps2)
          (LErr (ps-err-msg ps2))
          (match (clone ps2)
            (PS [t2 d2 a2 s2 y2 e2]
              (lok t2 a2 insts s2 lams rets ncached defs
                   (HCtor idx variant args)))))))))

(defn ctor-finish [adt :- i64 variant :- i64 args :- HExprs nparams :- i64 subs :- TyEnv expected :- Ty
                  tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                  lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (= nparams 0)
    (lok tab adts insts sigs lams rets ncached defs
         (HCtor adt variant args))
    (let [miss (unbound-param (index-sids nparams 0) subs)]
      (if (= (types/sids-depth miss) 0)
        (ctor-instantiate adt variant args (subs-collect subs 0 nparams)
                          tab adts insts sigs lams rets ncached defs raws)
        ; unbound parameters: a nullary ctor of a generic ADT infers from
        ; the expected instance of the same template
        (if (not (= (types/ty-tag expected) 16))
          (LErr (str "cannot infer the type argument(s) of the constructor — ascribe the binding"))
          (let [ed (forms/adts-at adts (types/ty-arg expected))]
            (match ed
              (AdtInfo [en etp ev etpl eargs]
                (if (not (= etpl adt))
                  (LErr (str "cannot infer the type argument(s) of the constructor for the expected type"))
                  (ctor-instantiate adt variant args eargs
                                    tab adts insts sigs lams rets ncached defs raws))))))))))

(defn lower-ctor-fields [items :- Asts adt :- i64 variant :- i64 fields :- TyList
                        env :- TyEnv nparams :- i64 subs :- TyEnv
                        tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                        lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                        k :- i64 acc :- HExprs raws :- &Raws] :- LRes
  (if (not (= (types/tys-depth fields) (- (ast/asts-depth items) 1)))
    (LErr (str "constructor expects " (types/tys-depth fields) " argument(s), got " (- (ast/asts-depth items) 1)))
    (if (>= k (types/tys-depth fields))
      (ctor-finish adt variant (hexpr/hes-rev acc (HENil)) nparams subs (clone env)
                   tab adts insts sigs lams rets ncached defs raws)
      (let [argn (expand/asts-idx (clone items) (+ k 1))
            fty (types/tys-idx (clone fields) k)
            ra (lower-e argn (clone env) (clone fty) tab adts insts sigs lams rets ncached defs raws)]
        (match ra
          (LErr [msg] (LErr msg))
          (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
            (let [at0 (ty-of e2 env r2 s2)
                  ; literal-friendly coercions: an i64 argument widens where
                  ; the field is f64; an empty vector literal satisfies any
                  ; vector field (the seed's rules)
                  emptv (and (= (types/ty-tag fty) 15)
                             (= (h-tag e2) 5)
                             (= (hexpr/vvals-depth-of (clone e2)) 0))
                  widq (and (types/ty-eq (clone fty) (types/t-f64)) (types/ty-eq (clone at0) (types/t-i64)))
                  e3 (if widq (HICast (clone e2) (types/t-i64) (types/t-f64)) (clone e2))
                  at (if emptv (clone fty)
                       (if widq (types/t-f64) at0))]
              (match (unify (clone fty) (clone at) subs)
                (UResErr [] (LErr (str "constructor field expects " (ty-name fty) ", got " (ty-name at))))
                (UResOk [subs2]
                  (lower-ctor-fields items adt variant fields (clone env) nparams subs2
                                     t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (+ k 1) (HECons e3 acc) raws))))))))))

(defn adts-tparams [ts :- &AdtTab i :- i64] :- i64
  (match (forms/adts-at ts i)
    (AdtInfo [name typarams variants tpl tplargs] (types/sids-depth typarams))))

; is instance j an instance of template tpl? -> j else -1
(defn instance-of-template [ts :- &AdtTab j :- i64 tpl :- i64] :- i64
  (match (forms/adts-at ts j)
    (AdtInfo [name typarams variants vtpl tplargs]
      (if (= vtpl tpl) j -1))))

(defn instance-fields [ts :- AdtTab j :- i64 vi :- i64] :- TyList
  (match (forms/adts-at ts j)
    (AdtInfo [name typarams variants vtpl tplargs]
      (match (forms/vlist-at variants vi)
        (Varnt [vname fs] fs)))))

; --- the call arm ---------------------------------------------------------------
; The seed's dispatch order: (1) closure-value calls from env, (2)
; constructor resolution, (3) generic defn instantiation, (4) even? and
; known callees, (5) the unknown-function error.

(defn lower-call-args [items :- Asts i :- i64 env :- TyEnv tab :- i64
                      adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                      rets :- TyEnv ncached :- i64 defs :- Defns head :- i64
                      kind :- i64 sig :- i64 acc :- HExprs raws :- &Raws] :- LRes
  (if (>= i (ast/asts-depth items))
    (lok tab adts insts sigs lams rets ncached defs
         (if (= kind 0)
           (HCall head (hexpr/hes-rev acc (HENil)))
           (HClosureCall (HVar head) (hexpr/hes-rev acc (HENil)) sig)))
    (let [a (expand/asts-idx (clone items) i)
          r (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lower-call-args items (+ i 1) env t2 a2 i2 s2 l2 r2 n2 d2 head kind sig (HECons e2 acc) raws))))))

(defn call-argtys [args :- HExprs env :- &TyEnv rets :- &TyEnv sigs :- Sigs acc :- TyList] :- TyList
  ; the concrete argument types, in order (the seed maps ty_of over args)
  (match args
    (HENil [] (types/tys-rev acc (TyNil)))
    (HECons [kid next]
      (call-argtys next env rets (clone sigs) (TyCons (ty-of kid env rets sigs) acc)))))

(defn lower-call [head :- i64 items :- Asts env :- TyEnv expected :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [ht (forms/te-get env head)]
    (if (= (types/ty-tag ht) 17)
      (let [sig (types/ty-arg ht)]
        (match (forms/sigs-at sigs sig)
          (Sig [want swant]
            (let [nargs (- (ast/asts-depth items) 1)]
              (if (not (= nargs (types/tys-depth want)))
                (LErr (str "closure call expects " (types/tys-depth want) " argument(s), got " nargs))
                (lower-call-args items 1 (clone env) tab adts insts sigs lams rets ncached defs head 1 sig (HENil) raws))))))
      (match (find-variant adts head)
        (FVFound [adt variant fields]
          (lower-ctor (FVFound adt variant fields) items (clone env) expected
                      tab adts insts sigs lams rets ncached defs raws))
        (FVMiss []
          (let [raw (raws-find raws head)]
            (match raw
              (RawDefn [rname rp rret rtps rie rbody rb]
                (cond
                  (> (types/sids-depth rtps) 0)
                  (match (lower-call-args (clone items) 1 (clone env) tab adts insts sigs lams rets ncached defs head 0 -1 (HENil) raws)
                    (LErr [msg] (LErr msg))
                    (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                      (if (not (= (h-tag e2) 39))
                        (LErr "internal: call args shape")
                        (let [args (hargs-of e2)
                              argtys (call-argtys (clone args) env r2 (clone s2) (TyNil))
                              mi (instantiate head argtys t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                          (match mi
                            (MIRes [t3 a3 i3 s3 l3 r3 n3 d3 mangled mret msg]
                              (if (> (count msg) 0)
                                (LErr msg)
                                (lok t3 a3 i3 s3 l3 r3 n3 d3 (HCall mangled args)))))))))
                  (= rname -1)
                  (if (= head (expand/s-evenq))
                    (lower-call-args (clone items) 1 (clone env) tab adts insts sigs lams rets ncached defs head 0 -1 (HENil) raws)
                    (LErr (str "unknown function " (forms/sym-str (clone tab) head))))
                  (lower-call-args items 1 (clone env) tab adts insts sigs lams rets ncached defs head 0 -1 (HENil) raws))))))))))

(defn lower-list [a :- Ast env :- TyEnv expected :- Ty tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [kids (expand/ast-kids-of a)
        h (expand/asts-head-sid kids)]
    (cond
      (= h (expand/s-do))
      (lower-do (expand/asts-tail (clone kids)) (clone env) (clone expected) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-fn))
      (lower-closure (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-let))
      (lower-let (expand/asts-tail (clone kids)) (clone env) (clone expected) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-if))
      (lower-if (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-notform))
      (lower-not (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-abs))
      (lower-abs (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-min))
      (lower-minmax 0 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-max))
      (lower-minmax 1 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-match))
      (lower-match (clone kids) (clone env) (clone expected) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-loop))
      (lower-loop (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-recur))
      (lower-recur (expand/asts-tail (clone kids)) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-and))
      (lower-andor 0 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-or))
      (lower-andor 1 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (expand/s-eq)) (= h (expand/s-ne)) (= h (expand/s-lt)) (= h (expand/s-gt)) (= h (expand/s-le)) (= h (expand/s-ge)))
      (lower-cmp (cmp-op h) (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (expand/s-add)) (= h (expand/s-sub)) (= h (expand/s-mul)) (= h (expand/s-div)))
      (lower-arith (arith-op h) (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (expand/s-f64)) (= h (expand/s-f32)) (= h (expand/s-i8)) (= h (expand/s-i16)) (= h (expand/s-i32)) (= h (expand/s-i64))
          (= h (expand/s-u8)) (= h (expand/s-u16)) (= h (expand/s-u32)) (= h (expand/s-u64)) (= h (expand/s-usize)))
      (lower-cast h (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-getform))
      (lower-get (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-conjform))
      (lower-conj (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-count))
      (lower-count (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-strform))
      (lower-str (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-subs))
      (lower-subs (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-split))
      (lower-split (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-join))
      (lower-join (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-nth))
      (lower-nth (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-charstr))
      (lower-charstr (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-clone))
      (lower-clone (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-dropform))
      (lower-drop (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-slurp))
      (lower-slurp (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-spit))
      (lower-spit (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-args))
      (lok tab adts insts sigs lams rets ncached defs (HArgs))

      (= h (expand/s-exit))
      (lower-exit (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-parsei64))
      (lower-parse 1 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (expand/s-parsef64))
      (lower-parse 0 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (expand/s-printstr)) (= h (expand/s-printstring)) (= h (expand/s-printf64)) (= h (expand/s-printi64)))
      (lower-print h (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (expand/s-veci64)) (= h (expand/s-vecf64)))
      (lower-vec-builtin h (clone kids) tab adts insts sigs lams rets ncached defs)

      (or (= h (expand/s-reduce)) (= h (expand/s-for)) (= h (expand/s-parallel)) (= h (expand/s-map)) (= h (expand/s-filter))
          (= h (expand/s-doseq)))
      (LErr (str "unsupported form " (forms/sym-str (clone tab) h)))

      (lower-call h kids env expected tab adts insts sigs lams rets ncached defs raws))))
; --- builtin arms -----------------------------------------------------------------

(defn lower-arith [op :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr "binary op expects 2 operands")
    (let [a (expand/asts-idx (clone items) 1)
          ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [b (expand/asts-idx items 2)
                rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (match (promote-bin op e1 e2 env r2 (clone s2))
                  (LRes1Err [msg] (LErr msg))
                  (LRes1Ok [e3] (lok t2 a2 i2 s2 l2 r2 n2 d2 e3)))))))))))

(defn cast-target [h :- i64] :- Ty
  (cond
    (= h (expand/s-f64)) (types/t-f64)
    (= h (expand/s-f32)) (types/t-f32)
    (= h (expand/s-i8)) (types/t-i8)
    (= h (expand/s-i16)) (types/t-i16)
    (= h (expand/s-i32)) (types/t-i32)
    (= h (expand/s-i64)) (types/t-i64)
    (= h (expand/s-u8)) (types/t-u8)
    (= h (expand/s-u16)) (types/t-u16)
    (= h (expand/s-u32)) (types/t-u32)
    (= h (expand/s-u64)) (types/t-u64)
    (types/t-usize)))

(defn lower-cast [h :- i64 items :- Asts env :- TyEnv tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "cast expects exactly 1 argument")
    (let [r (lower-1 (expand/asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [src (ty-of e2 env r2 s2)
                target (cast-target h)]
            (cond
              (types/ty-eq (clone src) (clone target)) (lok (clone t2) (clone a2) (clone i2) (clone s2) (clone l2) (clone r2) n2 (clone d2) (clone e2))
              (types/is-numeric-ty (clone src)) (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HICast (clone e2) (clone src) target))
              (LErr (str "cast expects a numeric operand, got " (ty-name src))))))))))

(defn lower-recur [args :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower-recur-2 args (HENil) env tab adts insts sigs lams rets ncached defs raws))

(defn lower-recur-2 [args :- Asts acc :- HExprs env :- TyEnv tab :- i64
                    adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                    rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (expand/asts-null args)
    (lok tab adts insts sigs lams rets ncached defs (HRecur (hexpr/hes-rev acc (HENil))))
    (let [r (lower-1 (expand/asts-idx (clone args) 0) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lower-recur-2 (expand/asts-tail args) (HECons e2 acc) env t2 a2 i2 s2 l2 r2 n2 d2 raws))))))

(defn lower-count [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "count expects exactly 1 argument")
    (let [r (lower-1 (expand/asts-idx items 1) env tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HCount e2)))))))

(defn lower-clone [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "clone expects 1 argument")
    (let [r (lower-1 (expand/asts-idx items 1) env tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HClone e2)))))))

(defn lower-drop [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "drop expects 1 argument")
    (let [r (lower-1 (expand/asts-idx items 1) env tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HDrop e2)))))))

(defn lower-charstr [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                    insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                    ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "char->str expects exactly 1 argument")
    (let [r (lower-1 (expand/asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (types/ty-eq (ty-of e2 env r2 s2) (types/t-i64)))
            (LErr "char->str expects an i64 byte value")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HCharStr (clone e2)))))))))

(defn lower-slurp [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "slurp expects (slurp <path>)")
    (let [r (lower-1 (expand/asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (types/ty-eq (ty-of e2 env r2 s2) (types/t-str)))
            (LErr "slurp path must be a string")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HSlurp (clone e2)))))))))

(defn lower-spit [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr "spit expects (spit <path> <content>)")
    (let [r1 (lower-1 (expand/asts-idx (clone items) 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match (clone r1)
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 p]
          (let [r2 (lower-1 (expand/asts-idx items 2) env t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match (clone r2)
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 d]
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSpit p d))))))))))

(defn lower-exit [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "exit expects (exit <status>)")
    (let [r (lower-1 (expand/asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (types/ty-eq (ty-of e2 env r2 s2) (types/t-i64)))
            (LErr "exit status must be i64")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HExit (clone e2)))))))))

(defn lower-parse [intf :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "parse expects (parse <s>)")
    (let [r (lower-1 (expand/asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (types/ty-eq (ty-of e2 env r2 s2) (types/t-str)))
            (LErr "parse expects a string")
            (let [want (if (= intf 1) (types/t-i64) (types/t-f64))
                  oi (option-instance want t2 a2 (clone s2))]
              (match oi
                (OIRes [t3 a3 idx]
                  (lok t3 a3 i2 (clone s2) l2 (clone r2) n2 d2 (HParseNum (clone e2) intf (types/t-adt idx))))))))))))

(defn lower-print [h :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 2))
    (LErr "print-* expects exactly 1 argument")
    (let [r (lower-1 (expand/asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (and (= h (expand/s-printstr)) (not (types/ty-eq (ty-of e2 env r2 s2) (types/t-str))))
            (LErr "print-str expects a string")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HCall h (HECons (clone e2) (HENil))))))))))

(defn lower-vec-builtin [h :- i64 items :- Asts tab :- i64 adts :- AdtTab
                        insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                        ncached :- i64 defs :- Defns] :- LRes
  (let [els (expand/asts-tail items)]
    (if (= h (expand/s-veci64))
      (if (kids-all-int (clone els))
        (lok tab adts insts sigs lams rets ncached defs (HVecLit 0 (kids-i64s els (VVNil))))
        (LErr "vec-i64 elements must be i64 literals"))
      (if (kids-all-num (clone els))
        (lok tab adts insts sigs lams rets ncached defs (HVecLit 1 (kids-f64s els (VVNil))))
        (LErr "vec-f64 elements must be numeric literals")))))

; --- (str ...) constant folding ---------------------------------------------------
; A single-argument (str x) is just x; an all-literal (str "a" "b" ...) folds to a
; single literal. Without this the kernel emits a runtime malloc+memcpy for every
; literal string fragment, of which the kernel source has very many.
(defn hs-lit-of [e :- &HExpr] :- bool
  (match e
    (HStrLit [_] true)
    (_ false)))

(defn hs-all-lit [es :- &HExprs] :- bool
  (match es
    (HENil [] true)
    (HECons [kid next] (if (hs-lit-of kid) (hs-all-lit next) false))))

(defn hs-join-lit [es :- &HExprs acc :- str] :- str
  (match es
    (HENil [] acc)
    (HECons [kid next]
      (match kid
        (HStrLit [s] (hs-join-lit next (str acc s)))
        (_ acc)))))

(defn hs-one [es :- &HExprs] :- bool
  (match es
    (HECons [_ next] (hexpr/hes-null next))
    (HENil [] false)))

(defn lower-str [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (< (ast/asts-depth items) 2)
    (LErr "str expects at least one argument")
    (lower-str-args (expand/asts-tail items) (HENil) env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-str-args [els :- Asts acc :- HExprs env :- TyEnv tab :- i64
                     adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                     rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (expand/asts-null els)
     (let [args (hexpr/hes-rev acc (HENil))]
       (if (hs-one args)
         (lok tab adts insts sigs lams rets ncached defs (hes-head-hes args))
         (if (hs-all-lit args)
           (lok tab adts insts sigs lams rets ncached defs (HStrLit (hs-join-lit args "")))
           (lok tab adts insts sigs lams rets ncached defs (HStrCat (clone args))))))
    (let [r (lower-1 (expand/asts-idx (clone els) 0) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [t (ty-of e2 env r2 s2)]
            (if (or (types/ty-eq (clone t) (types/t-str)) (types/is-numeric-ty (clone t)) (types/ty-eq (clone t) (types/t-bool)))
              (let [e3 (if (types/ty-eq (clone t) (types/t-str)) (clone e2) (HToStr (clone e2) t))]
                (lower-str-args (expand/asts-tail els) (HECons e3 acc) (clone env) t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 raws))
              (LErr (str "str arguments must be strings, numbers or bools, got " (ty-name t))))))))))

(defn lower-subs [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 4))
    (LErr "subs expects (subs <s> <start> <end>)")
    (lower-3-to items 0 env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-split [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr "split expects (split <s> <sep>)")
    (lower-2-to items 0 env tab adts insts sigs lams rets ncached defs "split" 16 raws)))

(defn lower-join [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr "join expects (join <sep> <strs>)")
    (lower-join-2 items env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-get [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [n (ast/asts-depth items)]
    (if (and (not (= n 3)) (not (= n 4)))
      (LErr "get expects (get <vec> <idx>) or (get <vec> <idx> <default>)")
      (let [src (expand/asts-idx (clone items) 1)
            rs (lower-1 src (clone env) tab adts insts sigs lams rets ncached defs raws)]
        (match rs
          (LErr [msg] (LErr msg))
          (LOk [t1 a1 i1 s1 l1 r1 n1 d1 src2]
            (let [st (ty-of src2 env r1 s1)]
              (if (not (= (types/ty-tag st) 15))
                (LErr (str "get source must be a vector, got " (ty-name st)))
                (let [elc (types/ty-arg st)
                      et (types/elem-ty elc)
                      idx (expand/asts-idx (clone items) 2)
                      ri (lower-1 idx (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
                  (match ri
                    (LErr [msg] (LErr msg))
                    (LOk [t2 a2 i2 s2 l2 r2 n2 d2 idx2]
                      (if (= n 4)
                        (let [dflt (expand/asts-idx items 3)
                              rd (lower-1 dflt (clone env) t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                          (match rd
                            (LErr [msg] (LErr msg))
                            (LOk [t3 a3 i3 s3 l3 r3 n3 d3 d2]
                              (lok t3 a3 i3 s3 l3 r3 n3 d3 (HGet (clone src2) idx2 (HECons d2 (HENil)) et (types/t-none))))))
                        (if (= elc 2)
                          (LErr "Option get over (Vector str) is not supported — use (get v i default)")
                          (let [oi (option-instance (clone et) t2 a2 (clone s2))]
                            (match oi
                              (OIRes [t3 a3 opt]
                                (lok t3 a3 i2 s2 l2 r2 n2 d2 (HGet (clone src2) idx2 (HENil) et (types/t-adt opt)))))))))))))))))))

(defn vvals-append-i64 [ks :- VVals v :- i64] :- VVals
  (match ks
    (VVNil [] (VVI64 v (VVNil)))
    (VVI64 [w next] (VVI64 w (vvals-append-i64 next v)))
    (VVF64 [w next] (VVF64 w (vvals-append-i64 next v)))))

(defn vvals-append-f64 [ks :- VVals v :- f64] :- VVals
  (match ks
    (VVNil [] (VVF64 v (VVNil)))
    (VVI64 [w next] (VVI64 w (vvals-append-f64 next v)))
    (VVF64 [w next] (VVF64 w (vvals-append-f64 next v)))))

(defn vvals-promote [ks :- VVals] :- VVals
  ; an i64 literal promoted to an f64 literal (the conj fold rule)
  (match ks
    (VVNil [] (VVNil))
    (VVI64 [w next] (VVF64 (f64 w) (vvals-promote next)))
    (VVF64 [w next] (VVF64 w (vvals-promote next)))))

(defn lower-conj-plain [elc :- i64 v2 :- HExpr x2 :- HExpr env :- TyEnv
                       tab :- i64 adts :- AdtTab insts :- IMap
                       sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                       defs :- Defns] :- LRes
  (let [xt (ty-of x2 env rets sigs)
        want (types/elem-ty elc)
        wf64 (types/ty-eq (clone want) (types/t-f64))
        xi64 (types/ty-eq (clone xt) (types/t-i64))]
    (if (and (not (types/ty-eq (clone xt) (clone want))) (not (and wf64 xi64)))
      (LErr (str "conj element expects " (ty-name want) ", got " (ty-name xt)))
      (let [x3 (if (and wf64 xi64)
                 (HICast (clone x2) (types/t-i64) (types/t-f64))
                 (clone x2))]
        (lok tab adts insts sigs lams rets ncached defs
             (HConj v2 x3 elc 0))))))

(defn lower-conj-fold [elc :- i64 v2 :- HExpr x2 :- HExpr env :- TyEnv
                      tab :- i64 adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns] :- LRes
  ; conj on a literal vector with a constant element folds to a new
  ; static literal (zero runtime cost) — the seed's three fold arms
  (let [xt (ty-of x2 env rets sigs)]
    (cond
      (and (= (h-tag v2) 5) (= (h-tag x2) 0) (= (hexpr/hvec-el (clone v2)) 0))
      (lok tab adts insts sigs lams rets ncached defs
           (HVecLit 0 (vvals-append-i64 (hexpr/hvec-vals (clone v2)) (hexpr/hconst-i64-of (clone x2)))))

      (and (= (h-tag v2) 5) (= (h-tag x2) 1) (= (hexpr/hvec-el (clone v2)) 1))
      (lok tab adts insts sigs lams rets ncached defs
           (HVecLit 1 (vvals-append-f64 (hexpr/hvec-vals (clone v2)) (hexpr/hconst-f64-of (clone x2)))))

      (and (= (h-tag v2) 5) (= (h-tag x2) 1) (= (hexpr/hvec-el (clone v2)) 0))
      (lok tab adts insts sigs lams rets ncached defs
           (HVecLit 1 (vvals-append-f64 (vvals-promote (hexpr/hvec-vals (clone v2))) (hexpr/hconst-f64-of (clone x2)))))

      ; (F64 lit, i64 const) falls through to the runtime conj
      (lower-conj-plain elc v2 (clone x2) (clone env) tab (clone adts) (clone insts)
                        (clone sigs) (clone lams) (clone rets) ncached (clone defs)))))

(defn lower-conj [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (ast/asts-depth items) 3))
    (LErr "conj expects (conj <vec> <x>)")
    (let [v (expand/asts-idx (clone items) 1)
          rv (lower-1 v (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match rv
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 v2]
          (let [vt (ty-of v2 env r1 s1)]
            (if (not (= (types/ty-tag vt) 15))
              (LErr (str "conj source must be a vector, got " (ty-name vt)))
              (let [elc (types/ty-arg vt)
                    x (expand/asts-idx items 2)
                    rx (lower-1 x (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
                (match rx
                  (LErr [msg] (LErr msg))
                  (LOk [t2 a2 i2 s2 l2 r2 n2 d2 x2]
                    (lower-conj-fold elc (clone v2) x2 (clone env) t2 a2 i2 s2 l2 r2 n2 d2)))))))))))

(defn lower-nth [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  ; two-argument nth is (StrNth s idx (Option i64)); the explicit-default
  ; form desugars to a match over it with binder $b (the seed's rule)
  (let [n (ast/asts-depth items)]
    (if (or (> n 4) (< n 3))
      (LErr "nth expects (nth <s> <idx>) or (nth <s> <idx> <default>)")
      (let [snode (expand/asts-idx (clone items) 1)
            rs (lower-1 snode (clone env) tab adts insts sigs lams rets ncached defs raws)]
        (match rs
          (LErr [msg] (LErr msg))
          (LOk [t1 a1 i1 s1 l1 r1 n1 d1 sval]
            (if (not (types/ty-eq (ty-of sval env r1 s1) (types/t-str)))
              (LErr "nth source must be a string")
              (let [idxnode (expand/asts-idx (clone items) 2)
                    ri (lower-1 idxnode (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
                (match ri
                  (LErr [msg] (LErr msg))
                  (LOk [t2 a2 i2 s2 l2 r2 n2 d2 idxval]
                    (if (not (types/ty-eq (ty-of idxval env r2 s2) (types/t-i64)))
                      (LErr "nth index must be i64")
                      (let [oi (option-instance (types/t-i64) t2 a2 (clone s2))]
                        (match oi
                          (OIRes [t3 a3 opt]
                            (if (= n 3)
                              (lok t3 a3 i2 (clone s2) l2 (clone r2) n2 d2 (HStrNth (clone sval) (clone idxval) (types/t-adt opt)))
                              (let [dflt (expand/asts-idx items 3)
                                    rd (lower-1 dflt (clone env) t3 a3 i2 (clone s2) l2 (clone r2) n2 d2 raws)]
                                (match rd
                                  (LErr [msg] (LErr msg))
                                  (LOk [t4 a4 i4 s4 l4 r4 n4 d4 dval]
                                    (lok t4 a4 i4 s4 l4 r4 n4 d4
                                         (HMatch (HStrNth (clone sval) (clone idxval) (types/t-adt opt))
                                                 (HACons 0 (SCons (expand/s-binder) (SNil)) (HVar (expand/s-binder)) (AFNone)
                                                         (HACons -1 (SNil) dval (AFNone) (HANil)))
                                                 (types/t-i64)))))))))))))))))))))

; shared child-lowering shapes
(defn lower-3-to [items :- Asts mode :- i64 env :- TyEnv tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [a (expand/asts-idx (clone items) 1)
        ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
    (match ra
      (LErr [msg] (LErr msg))
      (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
        (let [b (expand/asts-idx (clone items) 2)
              rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
          (match rb
            (LErr [msg] (LErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
              (let [c (expand/asts-idx items 3)
                    rc (lower-1 c env t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                (match rc
                  (LErr [msg] (LErr msg))
                  (LOk [t3 a3 i3 s3 l3 r3 n3 d3 e3]
                    (lok t3 a3 i3 s3 l3 r3 n3 d3 (HSubs e1 e2 e3))))))))))))

(defn lower-2-to [items :- Asts mode :- i64 env :- TyEnv tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns name :- str kind :- i64 raws :- &Raws] :- LRes
  (let [a (expand/asts-idx (clone items) 1)
        ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
    (match ra
      (LErr [msg] (LErr msg))
      (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
        (let [b (expand/asts-idx items 2)
              rb (lower-1 b env t1 a1 i1 s1 l1 r1 n1 d1 raws)]
          (match rb
            (LErr [msg] (LErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
              (if (= kind 16)
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSplit e1 e2))
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HJoin e1 e2))))))))))

(defn lower-join-2 [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower-2-to items 0 env tab adts insts sigs lams rets ncached defs "join" 17 raws))
; Call ret: the rets table (static non-generic + mono), else the seed's
; i64 fallback for the builtin print heads.
; Call ret: the rets table (static non-generic + mono), else the seed's
; i64 fallback for the builtin print heads.
(defn h-call-ty [rets :- &TyEnv name :- i64] :- Ty
  (let [r (forms/te-get rets name)]
    (if (ty-noneq r) (types/t-i64) r)))


; --- program assembly (build.rs) -------------------------------------------------
; Pass 0a collects deftype headers (field types may reference any template,
; regardless of order), pass 0b parses variants, pass 1 parses
; defn/extern headers in form order — registering Fn signatures and
; instantiating applied ADTs eagerly, which is the creation order the
; dump pins. Then every plain defn lowers in source order, with mono
; instances gathered separately and appended after the externs, exactly
; like the seed's `out` list.

(deftype POut (POk [tab :- i64 adts :- AdtTab defs :- Defns
                   lams :- Lams sigs :- Sigs])
             (PErr [msg :- str]))

(deftype DeclRes (DeclRes [decls :- Decls ndecls :- i64 msg :- str]))

(defn dl-depth [e :- Decls] :- i64
  (match e
    (DLCons [k v next] (+ 1 (dl-depth next)))
    (DLNil [] 0)))

(defn form-head-sid [f :- &Ast] :- i64
  ; borrowed read: match the node, hand the kids chain to the borrowed
  ; head-sid query — no move, no clone
  (match f
    (AList [kids at] (expand/asts-head-sid kids))
    (_ -1)))

; pass 0a: deftype headers, in form order
(defn collect-decls [forms :- Asts i :- i64 n :- i64 decls :- Decls ps :- PS] :- DeclRes
  ; ndecls starts at 1: adt 0 is the prelude's (Option a). The chain is
  ; consumed by match — an asts-idx per form deep-cloned the whole
  ; program per form and made the self-compile quadratic (S8).
  (match forms
    (KNil [] (DeclRes decls 1 ""))
    (KCons [f rest]
      (if (not (= (form-head-sid f) (expand/s-deftype)))
        (collect-decls rest (+ i 1) n decls ps)
        (let [r (forms/parse-deftype-header f (clone ps))]
          (match r
            (HDRRes [ps2 name typarams]
              (if (< name 0)
                (DeclRes (DLNil) 0 (ps-err-msg ps2))
                (if (forms/dl-has decls name)
                  (DeclRes (DLNil) 0 (str "duplicate deftype " (forms/sym-str (forms/ps-tab ps) name)))
                  (match (collect-decls rest (+ i 1) n decls ps2)
                    (DeclRes [d nd msg]
                      (if (> (count msg) 0)
                        (DeclRes (DLNil) 0 msg)
                        (DeclRes (forms/dl-put d name (Decl nd typarams)) (+ 1 nd) "")))))))))))))

(deftype VarRes (VarRes [adts :- AdtTab msg :- str]))

; pass 0b: variants, in declaration order; each deftype's own type
; parameters are in scope while its fields parse
(defn build-variants [forms :- Asts i :- i64 n :- i64 decls :- Decls adts :- AdtTab
                     tab :- i64 sigs :- Sigs] :- VarRes
  ; match-walk, as collect-decls (S8)
  (match forms
    (KNil [] (VarRes adts ""))
    (KCons [f rest]
      (if (not (= (form-head-sid f) (expand/s-deftype)))
        (build-variants rest (+ i 1) n decls adts tab sigs)
        (let [f2 (clone f)
              rh (forms/parse-deftype-header f (PS (clone tab) (clone decls) (clone adts) (clone sigs) (SNil) ""))]
          (match rh
            (HDRRes [ps1 name typarams]
              (if (< name 0)
                (VarRes (ATNil) (ps-err-msg ps1))
                (let [rv (forms/parse-deftype-variants f2 (PS (clone tab) (clone decls) (clone adts) (clone sigs) (clone typarams) ""))]
                  (match rv
                    (PVRes2 [ps2 vs]
                      (if (forms/ps-failed ps2)
                        (VarRes (ATNil) (ps-err-msg ps2))
                        (match (build-variants rest (+ i 1) n decls adts tab sigs)
                          (VarRes [restv msg]
                            (if (> (count msg) 0)
                              (VarRes (ATNil) msg)
                              (VarRes (forms/adts-append-info restv (AdtInfo name typarams vs -1 (TyNil))) ""))))))))))))))))

(deftype RawsRes (RawsRes [ps :- PS raws :- Raws msg :- str]))

; pass 1: defn/extern headers, in form order
(defn build-raws [forms :- Asts i :- i64 n :- i64 ps :- PS acc :- Raws] :- RawsRes
  ; match-walk (S8): the chain is consumed, the per-form asts-idx with its
  ; whole-program clone is gone. The parse result raw is moved into the
  ; accumulator after the recursion — one move, no clone.
  (match forms
    (KNil [] (RawsRes ps acc ""))
    (KCons [f rest]
      (let [h (form-head-sid f)]
        (cond
          (= h (expand/s-deftype))
          (build-raws rest (+ i 1) n ps acc)

          (= h (expand/s-extern))
          (let [r (forms/parse-defn f ps 1)]
            (match r
              (RawRes [ps2 raw]
                (if (forms/ps-failed ps2)
                  (let [m (ps-err-msg ps2)] (RawsRes ps2 (RNil) m))
                  (match (build-raws rest (+ i 1) n ps2 acc)
                    (RawsRes [ps3 rs msg]
                      (if (> (count msg) 0)
                        (RawsRes ps3 (RNil) msg)
                        (RawsRes ps3 (RCons raw rs) ""))))))))

          (= h (expand/s-defn))
          (let [r (forms/parse-defn f ps 0)]
            (match r
              (RawRes [ps2 raw]
                (if (forms/ps-failed ps2)
                  (let [m (ps-err-msg ps2)] (RawsRes ps2 (RNil) m))
                  (match (build-raws rest (+ i 1) n ps2 acc)
                    (RawsRes [ps3 rs msg]
                      (if (> (count msg) 0)
                        (RawsRes ps3 (RNil) msg)
                        (RawsRes ps3 (RCons raw rs) ""))))))))

          (let [m (str "cato1: unsupported form " (forms/sym-str (forms/ps-tab ps) h))]
            (RawsRes ps (RNil) m)))))))

; static (non-generic) callee rets, for ty_of's Call arm
(defn seed-rets [rs :- &Raws rets :- TyEnv] :- TyEnv
  (match rs
    (RCons [h t]
      (match h
        (RawDefn [name params ret typarams isextern body rb]
          (if (= (types/sids-depth typarams) 0)
            (seed-rets t (forms/te-put rets name (clone ret)))
            (seed-rets t rets)))))
    (RNil [] rets)))

; the plain-defn lowering loop (source order); instances accumulate in
; their own chain and move behind the externs at assembly time
(deftype LLoopRes (LLoopRes [ps :- PS defs :- Defns instdefs :- Defns
                            tab :- i64 adts :- AdtTab insts :- IMap
                            sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64])
             (LLoopErr [msg :- str]))

(defn build-lower [rs :- &Raws i :- i64 n :- i64 ps :- PS env-of :- i64] :- LLoopRes
  (build-lower-2 rs i n ps (DNil) (DNil)
                 (forms/ps-tab ps) (forms/ps-adts (clone ps)) (MNil)
                 (forms/ps-sigs (clone ps)) (LMNil)
                 ; static non-generic callee rets, for ty_of's Call arm
                 (seed-rets rs (TENil)) 0))

; the accumulated tab/adts/insts/sigs/lams/rets/ncached persist across
; defns: interning during lowering (mangled names, $d/lambda gensyms),
; ADT instances, closure signatures and mono cache state must reach the
; next defn and the final dump — the seed's Ctx cells are program-global
(defn build-lower-2 [rs :- &Raws i :- i64 n :- i64 ps :- PS defs :- Defns instdefs :- Defns
                    tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                    lams :- Lams rets :- TyEnv ncached :- i64] :- LLoopRes
  (if (>= i n)
    (match ps
      (PS [tab0 decls adts0 sigs0 typarams err]
        (if (> (count err) 0)
          (LLoopErr err)
          (LLoopRes ps defs instdefs tab adts insts sigs lams rets ncached))))
    (let [r (forms/raws-at rs i)]
      (match r
        (RawDefn [name params ret typarams isextern body rb]
          (cond
            ; externs: no lowering; the seed appends the declaration with
            ; a (const 0) placeholder body, all params Shared
            (= isextern 1)
            ; Each branch is an alternative path and ends in the recursive
            ; call, so the state moves: cloning it here copied the whole
            ; parser state, definition chain and instance list per defn.
            (build-lower-2 rs (+ i 1) n ps
                           (forms/defns-append defs (Defn name (clone params) (clone ret) 1 (HConstI64 0) 0))
                           instdefs
                           tab adts insts sigs lams rets ncached)

            (> (types/sids-depth typarams) 0)
            (build-lower-2 rs (+ i 1) n ps defs instdefs
                           tab adts insts sigs lams rets ncached)

            (let [env (binds-of-params (clone params))
                  ; the defs chain threads through lowering: instances
                  ; minted during this body append to it (the seed's
                  ; InstState::extra drain)
                  lr (lower-body-raw body env (clone ret) tab adts
                                     insts sigs lams rets ncached defs rs)]
              (match lr
                (LErr [msg] (LLoopErr msg))
                (LOk [t2 a2 i2 s2 l2 r2 n2 d2 body2]
                  ; the recursive call already gets the tables lowering
                  ; returned; the inputs are dead here
                  (build-lower-2 rs (+ i 1) n ps
                                 (forms/defns-append d2 (Defn name params ret 0 body2 rb))
                                 instdefs
                                 t2 a2 i2 s2 l2 r2 n2))))))))))

(defn build-program [forms :- Asts tab :- i64] :- POut
  (let [n (ast/asts-depth forms)
        ; the prelude: the (Option a) template seeded as adt 0, with its
        ; declaration registered so annotations resolve
        ps0 (forms/ps-new (clone tab))
        decls0 (forms/dl-put (DLNil) (expand/s-option) (Decl 0 (SCons (expand/s-aparam) (SNil))))
        ; user deftype indices start at 1: adt 0 is the prelude's Option
        dres (collect-decls (clone forms) 0 n decls0 (clone ps0))]
    (match dres
      (DeclRes [decls ndecls msg]
        (if (> (count msg) 0)
          (PErr msg)
          (match (build-variants (clone forms) 0 n (clone decls)
                                 (forms/ps-adts (clone ps0)) (forms/ps-tab ps0) (SGNil))
            (VarRes [adts vmsg]
              (if (> (count vmsg) 0)
                (PErr vmsg)
                (match (build-raws forms 0 n
                                   (PS (clone tab) decls adts (SGNil) (SNil) "") (RNil))
                  (RawsRes [ps1 raws rmsg]
                    (if (> (count rmsg) 0)
                      (PErr rmsg)
                      (match ps1
                        (PS [tab1 decls1 adts1 sigs1 typarams1 err1]
                          (if (> (count err1) 0)
                            (PErr err1)
                            (let [rn (forms/raws-depth raws)
                                  rets (seed-rets raws (TENil))]
                              (match (build-lower raws 0 rn ps1 0)
                                (LLoopErr [msg2] (PErr msg2))
                                (LLoopRes [ps2 defs instdefs t2 a2 i2 s2 l2 r2 n2]
                                  ; the seed's out order: plain defns in
                                  ; source order, then externs, then mono
                                  ; instances
                                  (let [parts (partition-defns defs raws (DNil) (DNil) (DNil))]
                                    (match parts
                                      (PRes3 [plains exts insts2]
                                        (POk t2 a2 (defns-concat (defns-concat plains exts) insts2) l2 s2)))))))))))))))))))))

; the seed's out assembly: plain defns in source order, then externs,
; then mono instances. The lowering accumulates one chain (plain defns
; appended per defn, instances appended where minted); partitioning it
; preserves each group's relative order.
(deftype PRes3 (PRes3 [plains :- Defns exts :- Defns insts :- Defns]))

(defn partition-defns [ds :- Defns rs :- &Raws plains :- Defns exts :- Defns
                      insts :- Defns] :- PRes3
  (match ds
    (DNil [] (PRes3 plains exts insts))
    (DCons [h t]
      (if (= (h-defn-ext (clone h)) 1)
        (partition-defns t rs plains (forms/defns-append exts h) insts)
        (if (raws-has rs (h-defn-name (clone h)))
          (partition-defns t rs (forms/defns-append plains h) exts insts)
          (partition-defns t rs plains exts (forms/defns-append insts h)))))))

(defn h-defn-ext [d :- Defn] :- i64
  (match d (Defn [name params ret ie body rb] ie)))

(defn h-defn-name [d :- Defn] :- i64
  (match d (Defn [name params ret ie body rb] name)))

(defn raws-has [rs :- &Raws name :- i64] :- bool
  (let [hit (raws-find rs name)]
    (match hit
      (RawDefn [hname hp hret htp hie hbody rb] (not (= hname -1))))))

(defn defns-concat [xs :- Defns ys :- Defns] :- Defns
  (match xs
    (DNil [] ys)
    (DCons [h t] (DCons h (defns-concat t ys)))))
