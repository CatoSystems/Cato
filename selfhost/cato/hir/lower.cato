    (HStrCmp [pol a b] (BNil))
    (HStrOrd [op a b] (BNil))
    (HICast [e from to] (BNil))
    (HCount [e] (BNil))
    (HToStr [e ty] (BNil))
    (HStrCat [args] (BNil))
