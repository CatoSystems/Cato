(defn arms-of [e :- HExpr] :- HArms
  (match e
    (HConstI64 [v] (HANil))
    (HConstF64 [v] (HANil))
    (HConstB [v] (HANil))
    (HVar [name] (HANil))
    (HStrLit [v] (HANil))
    (HVecLit [el vals] (HANil))
    (HBinW [op a b ty] (HANil))
    (HBinF [op a b] (HANil))
