(ns cato.hir.moveck)
(require ["types.cato" :as types])
(require ["forms.cato" :as forms])
(require ["lower.cato" :as lower])
(require ["hexpr.cato" :as hexpr])
(require ["alias.cato" :as alias])
(require ["statemap.cato" :as statemap])
(require ["expand.cato" :as expand])
(require ["../lib/span.cato" :as span])

; moveck.cato — S6: the move checker + drop planner.
;
; A port of the seed's `BCheck`/`plan_drops` over the kernel subset: per-
; name ownership states (0 Owned / 1 Moved), `rem` occurrence counts (a
; conj source at count 0 is a last use, so in-place update is
; unobservable), the tail-escape set, the shadowed-bindings pre-pass, the
; consumed set; the same merge rules for `if` branches and `match` arms
; (union of moved, union of not-owning); conj's in_place bit; closure
; captures consuming non-Copy vars with per-capture own bits; `let`'s
; transfer-on-Var-init ownership rule; scope-exit `frees` = heap-owning ∧
; still-owned ∧ not escaped ∧ not consumed ∧ not shadowed.
;
; The kernel has no borrows: every plain defn's parameters are Owned,
; externs are Shared (the seed's own convention). The checker REBUILDS
; nodes to fill the post-`plan_drops` annotations: HLet frees, HConj
; in_place, HClosure capture own-bits. `rem` and `cons` thread
; sequentially through branch walks (field mutations in the seed);
; `st`/`owns` restart from the pre-branch state per branch and merge.

; --- read-only context ---------------------------------------------------------

; callee name -> its parameter list, so a call can move only the args bound
; to owned (non-`&`) parameters (the seed's per-param borrow kinds). Extern
; parameters are recorded all-borrowed (externs never consume).
(deftype DParams
  (DPNil)
  (DPCons [name :- i64 ps :- PList next :- DParams]))

; nomove: the borrowed (&) parameter names of the defn under check —
; moving one anywhere in the body is an error (the caller still owns the
; buffer, and an owned callee would free it). The match scrutinee watch —
; the boxed scrutinee var under whose arm the body walks and the binders
; that alias its one heap box (the seed's Watch list) — does NOT ride in
; the context: it lives in the watch stack threaded beside bcx, so
; arming a watch no longer rebuilds the whole context (which cloned the
; program-wide tables per armed arm). currb: the current defn's
; return-borrow flag (a `&T` defn legitimately returns aliasing binders).
(deftype BCtx
  (
    BCtx
    [
      escaped
      :-
      Sids
      shadowed
      :-
      Sids
      facts
      :-
      Facts
      tab
      :-
      i64
      shared
      :-
      Sids
      loopcopy
      :-
      Sids
      adts
      :-
      AdtTab
      dparams
      :-
      DParams
      retb
      :-
      RBTable
      nomove
      :-
      Sids
      curbrb
      :-
      i64
      recur-ok
      :-
      i64
      loopseed
      :-
      Sids
    ]
  ))

(deftype BRes
  (BOk [st :- IMap owns :- IMap rem :- IMap cons :- IMap e :- HExpr])
  (BErr [msg :- str]))

(deftype BKRes
  (BKOk [st :- IMap owns :- IMap rem :- IMap cons :- IMap es :- HExprs])
  (BKErr [msg :- str]))

(deftype B4
  (B4 [st :- IMap owns :- IMap rem :- IMap cons :- IMap])
  (B4Err [msg :- str]))

(deftype UseRes (UseRes [rem :- IMap msg :- str]))

; Error sites (span/err-occ): per symbol, how many of its source
; occurrences the walk has reached — a variable's value-position reads, a
; closure capture (one per `fn` form), a call's head. The counts ride in
; `rem` under key -(sid+10) (rem threads sequentially through every walk;
; -1 is the hoist counter).
(defn occ-key [v :- i64] :- i64 (- -10 v))

(defn occ-bump [rem :- IMap v :- i64] :- IMap
  (forms/im-put rem (occ-key v) (+ 1 (forms/im-get rem (occ-key v) 0))))

(defn occ-at [rem :- &IMap v :- i64] :- i64 (forms/im-get rem (occ-key v) 0))

; Tag an error with the latest occurrence of v.
(defn occ-tag [msg :- str rem :- &IMap v :- i64] :- str
  (if (> (count msg) 0) (span/err-occ msg v (occ-at rem v)) msg))

; use_var: one occurrence consumed; a non-Copy read of a Moved value errors
(defn use-var [v :- i64 rem :- IMap tys :- &TyEnv st :- &IMap bcx :- &BCtx] :- UseRes
  ; a non-Copy loop variable rides as Copy: reads never see it Moved (S8)
  (if
    (types/sids-has (b-loopcopy-of bcx) v)
    (UseRes (forms/im-put rem v (- (forms/im-get rem v 0) 1)) "")
    (let [dec (- (forms/im-get rem v 0) 1) rem2 (forms/im-put rem v dec) t (forms/te-get tys v)]
      (if
        (and (not (lower/ty-noneq t)) (types/is-non-copy-ty t) (= (forms/im-get st v 0) 1))
        (match bcx
          (
            BCtx
            [escaped shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
            (let [msg (span/err-occ (str "use of moved value " (forms/sym-str (clone tab) v)) v (occ-at rem2 v))]
              (UseRes rem2 msg))
          ))
        (UseRes rem2 "")))))

(defn b-loopcopy-of [bcx :- &BCtx] :- Sids
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared loopcopy adts dp retb _nm _crb _rok _lseed]
      (clone loopcopy)
    )))

(deftype MoveRes (MoveRes [st :- IMap owns :- IMap cons :- IMap msg :- str]))

; The enclosing arms' watches, innermost first: the matched box's
; scrutinee variable (-1 for a temp), the arm's binders that alias the
; box's heap, and the non-Copy ones among them that a branch may free —
; empty unless this match may free the box. Moving a watched scrutinee
; retires its binders; a watched scrutinee is never freed by a branch (its
; binders still point into it); a freeable binder that one branch moves is
; freed by the branches that kept it.
(deftype Watches
  (WNil)
  (WCons [sc :- i64 bs :- Sids fbs :- Sids next :- Watches]))

; move_var: state goes Moved; the drop duty leaves the binding. A borrowed
; parameter cannot move — the caller still owns it, and an owned callee
; would free the shared buffer (the seed's no_move error). Moving a watched
; scrutinee retires its aliasing binders: their values live in (or own
; through) the box that just left, so a later use is the standard
; use-of-moved error. The watches ride beside bcx, not in the context.
(defn move-var [v :- i64 st :- IMap owns :- IMap cons :- IMap bcx :- &BCtx ws :- &Watches] :- MoveRes
  (if
    (types/sids-has (b-nomove-of bcx) v)
    (match bcx
      (
        BCtx
        [escaped shadowed facts tab shared _lc adts dp retb _nm _crb _rok _lseed]
        (
          MoveRes
          st
          owns
          cons
          (
            str
            "cannot move "
            (forms/sym-str (clone tab) v)
            ": it is a borrowed parameter and still belongs to the caller"
          )
        )
      ))
    (if
      (watched ws v)
      (match
        (retire-watched ws v st owns cons)
        (
          MoveRes
          [st2 owns2 cons2 _m]
          (MoveRes (forms/im-put st2 v 1) (forms/im-put owns2 v 0) (forms/im-put cons2 v 1) "")
        ))
      (MoveRes (forms/im-put st v 1) (forms/im-put owns v 0) (forms/im-put cons v 1) ""))))

; Is v the scrutinee of an enclosing match whose arm has aliasing binders?
(defn watched [ws :- &Watches v :- i64] :- bool
  (match ws
    (WNil [] false)
    (WCons [sc _bs _f next] (or (and (>= sc 0) (= sc v)) (watched next v)))))

; Does the innermost watch binding b say its box may be freed here?
(defn freeable-alias [ws :- &Watches b :- i64] :- bool
  (match ws
    (WNil [] false)
    (WCons [_sc bs fbs next] (if (types/sids-has bs b) (types/sids-has fbs b) (freeable-alias next b)))))

; retire the aliasing binders of every enclosing watch on v
(defn retire-watched [ws :- &Watches v :- i64 st :- IMap owns :- IMap cons :- IMap] :- MoveRes
  (match ws
    (WNil [] (MoveRes st owns cons ""))
    (
      WCons
      [sc bs _f next]
      (if
        (= sc v)
        (match
          (retire-binders (clone bs) st owns cons)
          (MoveRes [st2 owns2 cons2 _m] (retire-watched next v st2 owns2 cons2)))
        (retire-watched next v st owns cons))
    )))

(defn b-nomove-of [bcx :- &BCtx] :- Sids
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc adts dp retb nomove _crb _rok _lseed]
      (clone nomove)
    )))

; mark a watch's aliasing binders Moved/unowning (the box just left)
(defn retire-binders [bs :- Sids st :- IMap owns :- IMap cons :- IMap] :- MoveRes
  (match bs
    (SNil [] (MoveRes st owns cons ""))
    (SCons [b rest] (retire-binders rest (forms/im-put st b 1) (forms/im-put owns b 0) cons))))

; move_if_non_copy: the move sites (call args, conj sources, closure
; captures, drop, let-of-var)
(deftype MncRes
  (MncRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap])
  (MncErr [msg :- str]))

(defn move-if-nc [v :- i64
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- MncRes
  (let [t (forms/te-get tys v)]
    (if
      (and (not (lower/ty-noneq t)) (types/is-non-copy-ty t))
      (match
        (use-var v rem tys st bcx)
        (
          UseRes
          [rem2 msg]
          (if
            (> (count msg) 0)
            (MncErr msg)
            (match bcx
              ; a non-Copy loop variable rides as Copy: calls and
              ; constructors borrow it, nothing moves (S8)
              (
                BCtx
                [escaped shadowed facts tab shared loopcopy _adts _dp _retb _nm _crb _rok _lseed]
                (if
                  (types/sids-has loopcopy v)
                  (MncRes st owns rem2 cons)
                  (match
                    (move-var v st owns cons bcx ws)
                    (
                      MoveRes
                      [st2 owns2 cons2 m2]
                      (if
                        (> (count m2) 0)
                        (MncErr (occ-tag m2 rem2 v))
                        (MncRes st2 owns2 rem2 cons2))
                    )))
              )))
        ))
      (MncRes st owns rem cons))))

(defn im-remove [m :- IMap k :- i64] :- IMap
  (match m
    (MNil [] (MNil))
    (
      MCons
      [ek ev next]
      (if
        (= ek k)
        (im-remove next k)
        (MCons ek ev (im-remove next k)))
    )))

; --- merge rules (the if/match branch merges) --------------------------------------

; --- the seed's predicate helpers ---------------------------------------------------

(defn b-heap-owning [ty :- &Ty facts :- &Facts] :- bool
  (let [t (types/ty-tag ty)]
    (cond
      (= t 15)
      true
      (= t 12)
      true
      (= t 17)
      true
      (= t 13)
      true
      (= t 14)
      true
      (= t 16)
      (= (forms/facts-owns-at facts (types/ty-arg ty)) 1)
      false)))

(defn b-param-moves [ty :- &Ty facts :- &Facts] :- bool
  ; boxed ADTs move by pointer; closures move their env
  (let [t (types/ty-tag ty)]
    (cond
      (= t 17)
      true
      (= t 16)
      (= (forms/facts-boxed-at facts (types/ty-arg ty)) 1)
      false)))

; allocates: a fresh heap buffer the binding uniquely owns; aliases (Var),
; element loads and control-flow results are excluded (the seed's rule —
; control-flow merges leak as today until per-arm scratch drops exist)
(defn b-allocates [v :- &HExpr facts :- &Facts] :- bool
  (let [tag (lower/h-tag v)]
    (cond
      ; subs/split/join/strcat/charstr/tostr: fresh strings
      (or (= tag 15) (= tag 16) (= tag 17) (= tag 14) (= tag 19) (= tag 13))
      true
      ; conj/args: fresh collections; vec literals are fresh
      (or (= tag 21) (= tag 42) (= tag 5))
      true
      ; a closure mints its owning env allocation
      (= tag 37)
      true
      ; a fresh collection from a call; an explicit deep copy
      (= tag 39)
      true
      (= tag 35)
      true
      (= tag 40)
      true
      ; a `let`'s value is its body's (the planner's hoisted-temp lets)
      (= tag 30)
      (match v (HLet [_b body _f] (b-allocates body facts)) (_ false))
      ; a fresh box for an owning ADT; a fresh Option from parse-*
      (= tag 33)
      (= (forms/facts-owns-at facts (hexpr/hctor-adt v)) 1)
      (= tag 44)
      (let [res (hexpr/hparse-res v)]
        (and (= (types/ty-tag res) 16) (= (forms/facts-owns-at facts (types/ty-arg res)) 1)))
      false)))

; --- pre-passes: occurrence counts, shadowing, tail escapes -------------------------

(defn cv-bump [name :- i64 counts :- IMap] :- IMap
  (let [c (+ 1 (forms/im-get counts name 0))] (forms/im-put counts name c)))

; count_vars: every name occurrence, all positions (closure capture names
; too — a missed occurrence would make in-place update unsound)
(defn b-count-vars [e :- &HExpr counts :- IMap] :- IMap
  (match e
    (HVar [name] (cv-bump name counts))
    (HBinW [_ a _ _] (b-count-vars a counts))
    (HBinF [_ a _] (b-count-vars a counts))
    (HCmpW [_ a _ _] (b-count-vars a counts))
    (HStrCmp [_ a _] (b-count-vars a counts))
    (HStrOrd [_ a _] (b-count-vars a counts))
    (HAnd [a b] (b-count-vars b (b-count-vars a counts)))
    (HOr [a b] (b-count-vars b (b-count-vars a counts)))
    (HMin [a b _] (b-count-vars b (b-count-vars a counts)))
    (HMax [a b _] (b-count-vars b (b-count-vars a counts)))
    (HConj [v x _ _] (b-count-vars x (b-count-vars v counts)))
    (HSubs [s a _] (b-count-vars a (b-count-vars s counts)))
    (HSplit [s sep] (b-count-vars sep (b-count-vars s counts)))
    (HJoin [sep xs] (b-count-vars xs (b-count-vars sep counts)))
    (HStrNth [s idx _] (b-count-vars idx (b-count-vars s counts)))
    (HSpit [path data] (b-count-vars data (b-count-vars path counts)))
    (HIf [c t e _] (b-count-vars e (b-count-vars t (b-count-vars c counts))))
    (HICast [e _ _] (b-count-vars e counts))
    (HAbs [e _] (b-count-vars e counts))
    (HNot [e] (b-count-vars e counts))
    (HClone [e] (b-count-vars e counts))
    (HDrop [e] (b-count-vars e counts))
    (HCount [e] (b-count-vars e counts))
    (HCharStr [e] (b-count-vars e counts))
    (HToStr [e _] (b-count-vars e counts))
    (HParseNum [s _ _] (b-count-vars s counts))
    (HSlurp [p] (b-count-vars p counts))
    (HExit [e] (b-count-vars e counts))
    (HStrCat [args] (b-count-vars-kids args counts))
    (HCall [_ args] (b-count-vars-kids args counts))
    (HCtor [_ _ args] (b-count-vars-kids args counts))
    (HSeq [es] (b-count-vars-kids es counts))
    (HRecur [args _drops] (b-count-vars-kids args counts))
    (
      HGet
      [src idx dflt _ _]
      (b-count-vars-default dflt (b-count-vars idx (b-count-vars src counts)))
    )
    (HClosure [_ _ _ caps body] (b-count-vars body (b-count-caps caps counts)))
    (HClosureCall [f args _] (b-count-vars-kids args (b-count-vars f counts)))
    (HMatch [scrut arms _] (b-count-vars-arms arms (b-count-vars scrut counts)))
    (HLoop [binds _ body] (b-count-vars body (b-count-vars-binds binds counts)))
    (HLet [binds body _] (b-count-vars body (b-count-vars-binds binds counts)))
    (_ counts)))

(defn b-count-vars-kids [es :- &HExprs counts :- IMap] :- IMap
  (match es
    (HENil [] counts)
    (HECons [kid next] (b-count-vars-kids next (b-count-vars kid counts)))))

(defn b-count-vars-binds [binds :- &Binds counts :- IMap] :- IMap
  (match binds
    (BNil [] counts)
    (BCons [name v ty next] (b-count-vars-binds next (b-count-vars v counts)))))

(defn b-count-vars-arms [arms :- &HArms counts :- IMap] :- IMap
  (match arms
    (HANil [] counts)
    (HACons [variant binders body ef next] (b-count-vars-arms next (b-count-vars body counts)))))

(defn b-count-caps [caps :- &Caps counts :- IMap] :- IMap
  (match caps
    (CNil [] counts)
    (CCons [name ty own next] (b-count-caps next (cv-bump name counts)))))

(defn b-count-vars-default [dflt :- &HExprs counts :- IMap] :- IMap (b-count-vars-kids dflt counts))

; count_binds: names bound by more than one `let` share a codegen slot, so
; their frees stay suppressed (the seed's known limitation). The walk
; visits the same node kinds as the seed's count_binds.
(defn b-count-binds [e :- &HExpr counts :- IMap] :- IMap
  (match e
    (HLet [binds body _] (b-count-binds body (b-count-binds-binds binds counts)))
    (HSeq [es] (b-count-binds-kids es counts))
    (HStrCat [args] (b-count-binds-kids args counts))
    (HRecur [args _drops] (b-count-binds-kids args counts))
    (HLoop [binds _ body] (b-count-binds body (b-count-binds-binds binds counts)))
    (HIf [c t e _] (b-count-binds e (b-count-binds t (b-count-binds c counts))))
    (HToStr [e _] (b-count-binds e counts))
    (HParseNum [s _ _] (b-count-binds s counts))
    (HSlurp [p] (b-count-binds p counts))
    (HExit [e] (b-count-binds e counts))
    (HSpit [path data] (b-count-binds data (b-count-binds path counts)))
    (HAnd [a b] (b-count-binds b (b-count-binds a counts)))
    (HOr [a b] (b-count-binds b (b-count-binds a counts)))
    (_ counts)))

(defn b-count-binds-binds [binds :- &Binds counts :- IMap] :- IMap
  (match binds
    (BNil [] counts)
    (BCons [name v ty next] (b-count-binds-binds next (b-count-binds v (cv-bump name counts))))))

(defn b-count-binds-kids [es :- &HExprs counts :- IMap] :- IMap
  (match es
    (HENil [] counts)
    (HECons [kid next] (b-count-binds-kids next (b-count-binds kid counts)))))

(defn b-shadowed-of [counts :- &IMap acc :- Sids] :- Sids
  (match counts
    (MNil [] acc)
    (
      MCons
      [k v next]
      (
        b-shadowed-of
        next
        (if
          (> v 1)
          (SCons k acc)
          acc)
      )
    )))

; tail_escape: vars referenced in tail (returned) position; branch results
; are tail positions too — a binding returned from an if/match arm
; transfers its drop duty to the result
(defn b-tail-escape [e :- &HExpr acc :- Sids] :- Sids
  (match e
    (HLet [_ body _] (b-tail-escape body acc))
    (HSeq [es] (b-tail-escape-last es acc))
    (HIf [_ t e _] (b-tail-escape e (b-tail-escape t acc)))
    (HMatch [_ arms _] (b-tail-escape-arms arms acc))
    (HVar [name] (SCons name acc))
    (_ acc)))

(defn b-tail-escape-last [es :- &HExprs acc :- Sids] :- Sids
  (match es
    (HENil [] acc)
    (
      HECons
      [kid next]
      (if
        (hexpr/hes-null next)
        (b-tail-escape kid acc)
        (b-tail-escape-last next acc))
    )))

(defn b-tail-escape-arms [arms :- &HArms acc :- Sids] :- Sids
  (match arms
    (HANil [] acc)
    (HACons [variant binders body ef next] (b-tail-escape-arms next (b-tail-escape body acc)))))

; --- the checker -------------------------------------------------------------------

; sequential children
(defn b-kids [es :- HExprs
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
  acc :- HExprs
] :- BKRes
  (match es
    (HENil [] (BKOk st owns rem cons (hexpr/hes-rev acc (HENil))))
    (
      HECons
      [kid next]
      (match
        (bcheck kid st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BKErr msg))
        (
          BOk
          [st2 owns2 rem2 cons2 c2]
          (b-kids next st2 owns2 rem2 cons2 tys bcx ws (HECons c2 acc))
        ))
    )))

; a Get's optional default (absent = the empty chain)
(defn b-default [dflt :- HExprs
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- BKRes
  (match dflt
    (HENil [] (BKOk st owns rem cons (HENil)))
    (
      HECons
      [kid next]
      (match
        (b-kids dflt st owns rem cons tys bcx ws (HENil))
        (BKErr [msg] (BKErr msg))
        (BKOk [st2 owns2 rem2 cons2 c2] (BKOk st2 owns2 rem2 cons2 c2)))
    )))

; HCall's Owned-kind Var arguments: use + move after the plain child walk.
; Builtins never consume; for every other callee we consult the callee's
; parameter borrows (the seed's per-param kinds): an arg bound to an owned
; param moves, one bound to a borrowed (&) param stays with the caller.
(deftype DLook
  (DFound [ps :- PList])
  (DMissing))

(defn dparams-get [dp :- &DParams name :- i64] :- DLook
  (match dp
    (DPNil [] (DMissing))
    (
      DPCons
      [n ps next]
      (if
        (= n name)
        (DFound (clone ps))
        (dparams-get next name))
    )))

(defn b-mark-borrowed [ps :- PList] :- PList
  (match ps
    (PNil [] (PNil))
    (PCons [h t] (match h (Param [pname pty pb] (PCons (Param pname pty 1) (b-mark-borrowed t)))))))

(defn b-dparams [defs :- &Defns acc :- DParams] :- DParams
  (match defs
    (DNil [] acc)
    (
      DCons
      [h t]
      (match
        (clone h)
        (
          Defn
          [name params ret isextern body rb]
          (
            b-dparams
            t
            (
              DPCons
              name
              (if
                (= isextern 1)
                (b-mark-borrowed params)
                params)
              acc
            )
          )
        ))
    )))

; callee name -> return kind (see RBTable) and type, once per program
(defn b-retb [defs :- &Defns alias :- &Sids acc :- RBTable] :- RBTable
  (match defs
    (DNil [] acc)
    (
      DCons
      [h t]
      (match
        h
        (
          Defn
          [name params ret isextern body rb]
          (
            b-retb
            t
            alias
            (RBCons name (if (= rb 1) 1 (if (types/sids-has alias name) 2 0)) (clone ret) acc)
          )
        ))
    )))

; --- alias-returning functions (the seed's compute_alias_ret) -----------------

; Is the value of e not fresh: a call to a nonfresh function, a var bound
; to such a value, or a static vec literal? (the seed's tail_nonfresh)
(defn b-tail-nonfresh [e :- &HExpr nonfresh :- &Sids vars :- &Sids] :- bool
  (match e
    (HCall [c _args] (types/sids-has nonfresh c))
    (HVar [v] (types/sids-has vars v))
    (HVecLit [_el _vals] true)
    (HLet [binds body _] (let [inner (b-tnf-binds binds nonfresh (clone vars))] (b-tail-nonfresh body nonfresh inner)))
    (HSeq [es] (b-tnf-last es nonfresh vars))
    (HIf [_c t2 e2 _] (or (b-tail-nonfresh t2 nonfresh vars) (b-tail-nonfresh e2 nonfresh vars)))
    (HMatch [_s arms _] (b-tnf-arms arms nonfresh vars))
    (HLoop [binds _ty body] (b-tnf-leaves body nonfresh (b-tnf-binds binds nonfresh (clone vars))))
    (_ false)))

(defn b-tnf-binds [binds :- &Binds nonfresh :- &Sids vars :- Sids] :- Sids
  (match binds
    (BNil [] vars)
    (
      BCons
      [n v _ty next]
      (if
        (b-tail-nonfresh v nonfresh (clone vars))
        (b-tnf-binds next nonfresh (SCons n vars))
        (b-tnf-binds next nonfresh vars))
    )))

(defn b-tnf-last [es :- &HExprs nonfresh :- &Sids vars :- &Sids] :- bool
  (match es
    (HENil [] false)
    (
      HECons
      [k next]
      (if
        (hexpr/hes-null next)
        (b-tail-nonfresh k nonfresh vars)
        (b-tnf-last next nonfresh vars))
    )))

(defn b-tnf-arms [arms :- &HArms nonfresh :- &Sids vars :- &Sids] :- bool
  (match arms
    (HANil [] false)
    (HACons [_v _b body _fr next] (or (b-tail-nonfresh body nonfresh vars) (b-tnf-arms next nonfresh vars)))))

; A loop's completing leaves (the seed's tail_leaves minus recurs).
(defn b-tnf-leaves [e :- &HExpr nonfresh :- &Sids vars :- Sids] :- bool
  (match e
    (HLet [_b body _f] (b-tnf-leaves body nonfresh vars))
    (HSeq [es] (b-tnf-leaves-last es nonfresh vars))
    (HIf [_c t2 e2 _] (or (b-tnf-leaves t2 nonfresh (clone vars)) (b-tnf-leaves e2 nonfresh vars)))
    (HMatch [_s arms _] (b-tnf-leaves-arms arms nonfresh vars))
    (HRecur [_args _drops] false)
    (_ (b-tail-nonfresh e nonfresh (clone vars)))))

(defn b-tnf-leaves-last [es :- &HExprs nonfresh :- &Sids vars :- Sids] :- bool
  (match es
    (HENil [] false)
    (
      HECons
      [k next]
      (if
        (hexpr/hes-null next)
        (b-tnf-leaves k nonfresh vars)
        (b-tnf-leaves-last next nonfresh vars))
    )))

(defn b-tnf-leaves-arms [arms :- &HArms nonfresh :- &Sids vars :- Sids] :- bool
  (match arms
    (HANil [] false)
    (
      HACons
      [_v _b body _fr next]
      (or (b-tnf-leaves body nonfresh (clone vars)) (b-tnf-leaves-arms next nonfresh vars))
    )))

(defn b-coll-param-names [ps :- &PList acc :- Sids] :- Sids
  (match ps
    (PNil [] acc)
    (
      PCons
      [p rest]
      (match p
        (
          Param
          [n ty _b]
          (b-coll-param-names rest (if (alias/coll-ty ty) (SCons n acc) acc))
        ))
    )))

; Seeds: externs returning a collection (runtime memory). `&T` defns seed
; the alias-call set.
(defn b-ar-seed [defs :- &Defns out :- Sids] :- Sids
  (match defs
    (DNil [] out)
    (
      DCons
      [h t]
      (match h
        (
          Defn
          [name _ps ret isextern _body _rb]
          ; An extern's str/collection result is borrowed (never freed)
          ; unless it is declared `(own T)` (ret-borrowed 2).
          (b-ar-seed t (if (and (= isextern 1) (alias/coll-ty ret) (not (= _rb 2))) (SCons name out) out))
        ))
    )))

(defn b-ar-calls [defs :- &Defns acc :- Sids] :- Sids
  (match defs
    (DNil [] acc)
    (
      DCons
      [h t]
      (match h
        (Defn [name _ps _ret _ie _body rb] (b-ar-calls t (if (= rb 1) (SCons name acc) acc))))
    )))

(deftype ARStep (ARStep [out :- Sids calls :- Sids changed :- i64]))

; One pass over the defns: every non-extern collection-returning defn
; whose tail may alias a collection parameter (through an alias call) or
; is not fresh joins both sets.
(defn b-ar-pass [defs :- &Defns out :- Sids calls :- Sids changed :- i64] :- ARStep
  (match defs
    (DNil [] (ARStep out calls changed))
    (
      DCons
      [h t]
      (match h
        (
          Defn
          [name ps ret isextern body _rb]
          (if
            (or (= isextern 1) (types/sids-has out name) (not (alias/coll-ty ret)))
            (b-ar-pass t out calls changed)
            (if
              (let [cps (b-coll-param-names ps (SNil)) none (SNil)]
                (or (alias/tail-may-alias body cps calls (RBNil)) (b-tail-nonfresh body out none)))
              (b-ar-pass t (SCons name out) (SCons name calls) 1)
              (b-ar-pass t out calls changed)))
        ))
    )))

(defn b-ar-fix [defs :- &Defns out :- Sids calls :- Sids] :- Sids
  (match (b-ar-pass defs out calls 0)
    (ARStep [out2 calls2 changed] (if (= changed 1) (b-ar-fix defs out2 calls2) out2))))

(defn b-alias-ret [defs :- &Defns] :- Sids
  (b-ar-fix defs (b-ar-seed defs (SNil)) (b-ar-calls defs (SNil))))

(defn b-call-move [name :- i64
  args :- HExprs
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- B4
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc _adts dp _retb _nm _crb _rok _lseed]
      (if
        (types/sids-has shared name)
        (B4 st owns rem cons)
        (match
          (dparams-get dp name)
          (DFound [ps] (b-call-move-ps args ps st owns rem cons tys bcx ws))
          (DMissing [] (b-call-move-walk args st owns rem cons tys bcx ws))))
    )))

(defn b-call-move-ps [args :- HExprs
  ps :- PList
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- B4
  (match args
    (HENil [] (B4 st owns rem cons))
    (
      HECons
      [kid next]
      (match ps
        (PNil [] (b-call-move-walk args st owns rem cons tys bcx ws))
        (
          PCons
          [h pt]
          (match h
            (
              Param
              [pname pty pb]
              (if
                (
                  and
                  (= pb 0)
                  (= (lower/h-tag (clone kid)) 39)
                  (= (b-rb-at bcx (lower/name-of (clone kid))) 1)
                )
                ; a borrowed (`&T`) call result handed to an owned parameter
                ; would let the callee free a value that still belongs to
                ; the borrow's origin (the seed's E-check)
                (
                  B4Err
                  (
                    occ-tag
                    (
                      str
                      "cannot move the borrowed result of "
                      (forms/sym-str (b-tab-of bcx) (lower/name-of (clone kid)))
                      " into an owned parameter: it belongs to the caller"
                    )
                    rem
                    (lower/name-of (clone kid))
                  )
                )
                (if
                  (and (= pb 0) (= (lower/h-tag kid) 3))
                  (match
                    (move-if-nc (lower/name-of kid) st owns rem cons tys bcx ws)
                    (MncErr [msg] (B4Err msg))
                    (
                      MncRes
                      [st2 owns2 rem2 cons2]
                      (b-call-move-ps next pt st2 owns2 rem2 cons2 tys bcx ws)
                    ))
                  (b-call-move-ps next pt st owns rem cons tys bcx ws)))
            ))
        ))
    )))

(defn b-call-move-walk [args :- HExprs
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- B4
  (match args
    (HENil [] (B4 st owns rem cons))
    (
      HECons
      [kid next]
      (if
        (= (lower/h-tag kid) 3)
        ; the seed's kinds loop: use + move only NON-COPY Var args
        (match
          (move-if-nc (lower/name-of kid) st owns rem cons tys bcx ws)
          (MncErr [msg] (B4Err msg))
          (
            MncRes
            [st2 owns2 rem2 cons2]
            (b-call-move-walk next st2 owns2 rem2 cons2 tys bcx ws)
          ))
        (b-call-move-walk next st owns rem cons tys bcx ws))
    )))

; let bindings: sequential; the transfer-on-Var-init ownership rule
(deftype BLRes
  (BLRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap tys :- TyEnv binds :- Binds])
  (BLErr [msg :- str]))

(defn b-let-binds [binds :- Binds
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- TyEnv
  bcx :- &BCtx
  ws :- &Watches
  acc :- Binds
] :- BLRes
  (match binds
    (BNil [] (BLRes st owns rem cons tys acc))
    (
      BCons
      [name value ty next]
      (match
        (bcheck value st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BLErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 v2]
          (let [isv (= (lower/h-tag v2) 3)
            vn (lower/name-of (clone v2))
            ncopy (types/is-non-copy-ty ty)]
            (if
              (and isv ncopy (not (types/sids-has (b-loopcopy-of bcx) vn)))
              ; a non-Copy Var init moves the buffer: the drop duty
              ; transfers to the new binding (read the source's ownership
              ; before the move clears it). A non-Copy loop variable rides
              ; as Copy: the let aliases the loop's slot, it does not
              ; consume it.
              (let [src-owns (forms/im-get owns1 vn 0)]
                (match
                  (move-var vn st1 owns1 cons1 bcx ws)
                  (
                    MoveRes
                    [st2 owns2 cons2 m2]
                    (if
                      (> (count m2) 0)
                      (BLErr m2)
                      (
                        b-let-binds
                        next
                        (forms/im-put st2 name 0)
                        (forms/im-put owns2 name src-owns)
                        rem1
                        (im-remove cons2 name)
                        (forms/te-put tys name ty)
                        bcx
                        ws
                        (BCons name v2 ty acc)
                      ))
                  )))
              ; a fresh binding starts unconsumed; a Copy Var alias never
              ; owns; a borrowed (`&T`) call result is a borrow the caller
              ; still owns, so it never owns; anything else owns iff it
              ; allocates
              (let [owns2
                (if isv
                  (forms/im-put owns1 name 0)
                  (
                    forms/im-put
                    owns1
                    name
                    (if
                      (b-borrowed-call-at v2 bcx)
                      0
                      (if
                        (b-let-allocates-of v2 bcx)
                        1
                        0))
                  ))]
                (
                  b-let-binds
                  next
                  (forms/im-put st1 name 0)
                  owns2
                  rem1
                  (im-remove cons1 name)
                  (forms/te-put tys name ty)
                  bcx
                  ws
                  (BCons name v2 ty acc)
                ))))
        ))
    )))

(defn b-facts-of [bcx :- &BCtx] :- Facts
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (clone facts)
    )))

(defn b-retb-of [bcx :- &BCtx] :- RBTable
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp retb _nm _crb _rok _lseed] (clone retb))))

; The accessors above hand back an owned field, so every read copied the
; ownership list (one cons per ADT in the program). The consumers of these
; only borrow, so the read happens inside the match instead.
(defn b-facts-owns-at [bcx :- &BCtx i :- i64] :- i64
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (forms/facts-owns-at facts i)
    )))

(defn b-facts-boxed-at [bcx :- &BCtx i :- i64] :- i64
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (forms/facts-boxed-at facts i)
    )))

(defn b-allocates-of [v :- &HExpr bcx :- &BCtx] :- bool
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (b-allocates v facts)
    )))

; A let binding owns its value only when that value is a fresh heap
; allocation. Vec literals are not (the seed's allocates_fresh): the
; emitter mints them as private constants (md-mint-vec), so a let that
; "owned" one would hand a global to a closure env's drop glue. Loop seeds
; keep b-allocates-of (the emitter copies a literal seed into the loop's
; growable slot).
(defn b-let-allocates-of [v :- &HExpr bcx :- &BCtx] :- bool
  (match v
    ; a call result is fresh unless the callee may return an alias (rb 2;
    ; rb 1 borrowed calls are filtered by b-borrowed-call first)
    (HCall [c _args] (/= (b-rb-at bcx c) 2))
    ; a `let`'s value is its body's (the planner's hoisted-temp lets)
    (HLet [_b body _f] (b-let-allocates-of body bcx))
    (_ (and (/= (lower/h-tag v) 5) (b-allocates-of v bcx)))))

(defn b-arm-state-of [binders :- Sids
  fields :- TyList
  pst :- IMap
  powns :- IMap
  tys :- TyEnv
  bcx :- &BCtx
] :- BLRes
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (b-arm-state binders fields pst powns tys facts)
    )))

(defn b-arm-esc-of [binders :- Sids
  fields :- TyList
  st :- IMap
  escaped :- Sids
  bcx :- &BCtx
  acc :- i64
] :- i64
  (match bcx
    (
      BCtx
      [escaped0 shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (b-arm-esc binders fields st escaped facts acc)
    )))

; Is this an expression whose value is a borrow (a call to a `&T` callee)?
; b-borrowed-call through the context, without copying the table out
(defn b-borrowed-call-at [v :- &HExpr bcx :- &BCtx] :- bool
  (match v
    (HCall [name _args] (= (b-rb-at bcx name) 1))
    (_ false)))

(defn b-borrowed-call [v :- &HExpr retb :- &RBTable] :- bool
  (match v
    (HCall [name args] (= (alias/rb-get retb name) 1))
    (_ false)))

; scope-exit frees: heap-owning ∧ still-owned ∧ not escaped ∧ not
; consumed ∧ not shadowed, in binding order — the whole destruction rule
(defn b-frees [binds :- Binds st :- IMap owns :- IMap cons :- IMap bcx :- &BCtx] :- Sids
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (b-frees-walk binds st owns cons escaped shadowed facts)
    )))

(defn b-frees-walk [binds :- &Binds
  st :- &IMap
  owns :- &IMap
  cons :- &IMap
  escaped :- &Sids
  shadowed :- &Sids
  facts :- &Facts
] :- Sids
  (match binds
    (BNil [] (SNil))
    (
      BCons
      [name v ty next]
      (let [rest (b-frees-walk next st owns cons escaped shadowed facts)]
        (if
          (
            and
            (b-heap-owning ty facts)
            (= (forms/im-get owns name 0) 1)
            (= (forms/im-get st name 0) 0)
            (not (types/sids-has escaped name))
            (not (forms/im-has cons name))
            (not (types/sids-has shadowed name))
          )
          (SCons name rest)
          rest))
    )))

; does `name` occur anywhere in this expression (read-only, no allocations)?
; The watch pre-scan: an arm that never mentions the scrutinee cannot move
; it, so no watch needs arming.
(defn b-mentions [e :- &HExpr name :- i64] :- bool
  (match e
    (HVar [v] (= v name))
    (HBinW [_ a b _] (or (b-mentions a name) (b-mentions b name)))
    (HBinF [_ a b] (or (b-mentions a name) (b-mentions b name)))
    (HCmpW [_ a b _] (or (b-mentions a name) (b-mentions b name)))
    (HStrCmp [_ a b] (or (b-mentions a name) (b-mentions b name)))
    (HStrOrd [_ a b] (or (b-mentions a name) (b-mentions b name)))
    (HAnd [a b] (or (b-mentions a name) (b-mentions b name)))
    (HOr [a b] (or (b-mentions a name) (b-mentions b name)))
    (HMin [a b _] (or (b-mentions a name) (b-mentions b name)))
    (HMax [a b _] (or (b-mentions a name) (b-mentions b name)))
    (HConj [v x _ _] (or (b-mentions v name) (b-mentions x name)))
    (HSubs [s a b] (or (b-mentions s name) (b-mentions a name) (b-mentions b name)))
    (HSplit [s sep] (or (b-mentions s name) (b-mentions sep name)))
    (HJoin [sep xs] (or (b-mentions sep name) (b-mentions xs name)))
    (HStrNth [s idx _] (or (b-mentions s name) (b-mentions idx name)))
    (HSpit [p d] (or (b-mentions p name) (b-mentions d name)))
    (HIf [c t e _] (or (b-mentions c name) (b-mentions t name) (b-mentions e name)))
    (HICast [e _ _] (b-mentions e name))
    (HAbs [e _] (b-mentions e name))
    (HNot [e] (b-mentions e name))
    (HClone [e] (b-mentions e name))
    (HDrop [e] (b-mentions e name))
    (HCount [e] (b-mentions e name))
    (HCharStr [e] (b-mentions e name))
    (HToStr [e _] (b-mentions e name))
    (HParseNum [s _ _] (b-mentions s name))
    (HSlurp [p] (b-mentions p name))
    (HExit [e] (b-mentions e name))
    (HStrCat [args] (b-mentions-kids args name))
    (HCall [_ args] (b-mentions-kids args name))
    (HCtor [_ _ args] (b-mentions-kids args name))
    (HSeq [es] (b-mentions-kids es name))
    (HRecur [args _drops] (b-mentions-kids args name))
    (
      HGet
      [src idx dflt _ _]
      (or (b-mentions src name) (b-mentions idx name) (b-mentions-kids dflt name))
    )
    (HClosure [_ _ _ caps body] (or (b-mentions-caps caps name) (b-mentions body name)))
    (HClosureCall [f args _] (or (b-mentions f name) (b-mentions-kids args name)))
    (HMatch [scrut arms _] (or (b-mentions scrut name) (b-mentions-arms arms name)))
    (HLoop [binds _ body] (or (b-mentions-binds binds name) (b-mentions body name)))
    (HLet [binds body _] (or (b-mentions-binds binds name) (b-mentions body name)))
    (_ false)))

(defn b-mentions-kids [es :- &HExprs name :- i64] :- bool
  (match es
    (HENil [] false)
    (HECons [kid next] (or (b-mentions kid name) (b-mentions-kids next name)))))

(defn b-mentions-arms [arms :- &HArms name :- i64] :- bool
  (match arms
    (HANil [] false)
    (
      HACons
      [_ binders body _ef next]
      (or (types/sids-has binders name) (b-mentions body name) (b-mentions-arms next name))
    )))

(defn b-mentions-binds [binds :- &Binds name :- i64] :- bool
  (match binds
    (BNil [] false)
    (BCons [_ v _ next] (or (b-mentions v name) (b-mentions-binds next name)))))

(defn b-mentions-caps [caps :- &Caps name :- i64] :- bool
  (match caps
    (CNil [] false)
    (
      CCons
      [n _ _ next]
      (if
        (= n name)
        true
        (b-mentions-caps next name))
    )))

; scope-aware shadowing (the seed's rebound_in_body): is `name` re-bound
; by a let anywhere inside this expression? Read-only — no allocations.
(defn b-rebound [e :- &HExpr name :- i64] :- bool
  (match e
    (
      HLet
      [binds body _]
      (if
        (b-binds-has binds name)
        true
        (b-rebound body name))
    )
    (HSeq [es] (b-rebound-kids es name))
    (HStrCat [args] (b-rebound-kids args name))
    (HRecur [args _drops] (b-rebound-kids args name))
    (HIf [c t e2 _] (or (b-rebound c name) (b-rebound t name) (b-rebound e2 name)))
    (
      HMatch
      [scrut arms _]
      (if
        (b-rebound scrut name)
        true
        (b-rebound-arms arms name))
    )
    (HLoop [binds _ body] (or (b-rebound-binds binds name) (b-rebound body name)))
    (HAnd [a b] (or (b-rebound a name) (b-rebound b name)))
    (HOr [a b] (or (b-rebound a name) (b-rebound b name)))
    (_ false)))

(defn b-rebound-kids [es :- &HExprs name :- i64] :- bool
  (match es
    (HENil [] false)
    (HECons [kid next] (or (b-rebound kid name) (b-rebound-kids next name)))))

(defn b-rebound-arms [arms :- &HArms name :- i64] :- bool
  (match arms
    (HANil [] false)
    (HACons [_ _ body _ef next] (or (b-rebound body name) (b-rebound-arms next name)))))

(defn b-rebound-binds [binds :- &Binds name :- i64] :- bool
  (match binds
    (BNil [] false)
    (BCons [n v _ next] (or (= n name) (b-rebound v name) (b-rebound-binds next name)))))

(defn b-binds-has [binds :- &Binds name :- i64] :- bool
  (match binds
    (BNil [] false)
    (
      BCons
      [n _ _ next]
      (if
        (= n name)
        true
        (b-binds-has next name))
    )))

; The let's scope-exit frees: the seed's destruction rule with the per-let
; shadow check inlined, so no per-let IMap is built.
(defn b-frees-here [binds :- &Binds
  body :- &HExpr
  st :- &IMap
  owns :- &IMap
  cons :- &IMap
  bcx :- &BCtx
] :- Sids
  (match bcx
    (
      BCtx
      [escaped _sh facts tab shared _lc adts dp retb _nm _crb _rok _lseed]
      (b-frees-here-walk binds body st owns cons escaped facts)
    )))

(defn b-frees-here-walk [binds :- &Binds
  body :- &HExpr
  st :- &IMap
  owns :- &IMap
  cons :- &IMap
  escaped :- &Sids
  facts :- &Facts
] :- Sids
  (match binds
    (BNil [] (SNil))
    (
      BCons
      [name v ty next]
      (let [rest (b-frees-here-walk next body st owns cons escaped facts)]
        (if
          (
            and
            (b-heap-owning ty facts)
            (= (forms/im-get owns name 0) 1)
            (= (forms/im-get st name 0) 0)
            (not (types/sids-has escaped name))
            (not (forms/im-has cons name))
            (not (b-rebound body name))
            ; a name re-bound later in this same let is planned once, for
            ; its last binding (the state maps describe only that one; a
            ; second entry would free the same buffer twice)
            (not (b-binds-has next name))
          )
          (SCons name rest)
          rest))
    )))

; loop bindings: Copy-typed; the init checks against the outer state, the
; binding shadows for the body, and the previous state restores after
(deftype BLoopRes
  (
    BLoopRes
    [
      st
      :-
      IMap
      owns
      :-
      IMap
      rem
      :-
      IMap
      cons
      :-
      IMap
      tys
      :-
      TyEnv
      binds
      :-
      Binds
      saved
      :-
      IMap
      savedo
      :-
      IMap
      seed
      :-
      Sids
    ]
  )
  (BLoopErr [msg :- str]))

; S8: a non-Copy loop variable rides as Copy — reads and calls never
; move it, and no scope frees it. Non-Copy bind names collect into a set
; the body walk consults through the context.
(defn bcx-with-loopcopy [bcx :- &BCtx names :- Sids seed :- Sids] :- BCtx
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc adts dp retb _nm _crb _rok _lseed]
      ; nested loops accumulate: an outer loop variable stays Copy inside
      ; an inner loop body (the seed keeps one accumulating set). The
      ; caller resets the watch pair for the body (a new loop body is not
      ; inside any match arm). A fresh recur-ok context starts here.
      (
        BCtx
        (clone escaped)
        (clone shadowed)
        (clone facts)
        (clone tab)
        (clone shared)
        (alias/sids-into names (clone _lc))
        (clone adts)
        (clone dp)
        (clone retb)
        (clone _nm)
        _crb
        -1
        (alias/sids-into seed (clone _lseed))
      )
    )))

; recur-ok: the accumulator the enclosing HRecur proved a self-update conj
; for (the seed's recur_ok); -1 outside. loopseed: the loop variables whose
; seed is a fresh allocation (the seed's loop_seed_fresh) — only those may
; take the in-place recur path.
(defn b-recur-ok-of [bcx :- &BCtx] :- i64
  (match bcx (BCtx [escaped shadowed facts tab shared _lc adts dp retb _nm _crb rok _lseed] rok)))

(defn b-loopseed-of [bcx :- &BCtx] :- Sids
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc adts dp retb _nm _crb _rok lseed] (clone lseed))))

(defn bcx-with-recur-ok [bcx :- &BCtx rok :- i64] :- BCtx
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared lc adts dp retb nm crb _rok lseed]
      (
        BCtx
        (clone escaped)
        (clone shadowed)
        (clone facts)
        (clone tab)
        (clone shared)
        (clone lc)
        (clone adts)
        (clone dp)
        (clone retb)
        (clone nm)
        crb
        rok
        (clone lseed)
      )
    )))

; the seed's conj_counts: how many recur args are `(conj n ...)`
(defn recur-conj-count [args :- &HExprs n :- i64] :- i64
  (match args
    (HENil [] 0)
    (
      HECons
      [a next]
      (let [hit
        (match a
          (
            HConj
            [v x el inpo]
            (match v
              (
                HVar
                [vname]
                (if
                  (= vname n)
                  1
                  0)
              )
              (_ 0))
          )
          (_ 0))]
        (+ hit (recur-conj-count next n)))
    )))

; the seed's sibling_reads: does any arg other than ai read n?
(defn recur-sibling-reads [args :- &HExprs ai :- i64 k :- i64 n :- i64] :- bool
  (match args
    (HENil [] false)
    (
      HECons
      [a next]
      (if
        (= k ai)
        (recur-sibling-reads next ai (+ k 1) n)
        (if
          (> (forms/im-get (b-count-vars a (MNil)) n 0) 0)
          true
          (recur-sibling-reads next ai (+ k 1) n)))
    )))

; Is arg `kid` the loop's self-update `(conj acc x)` (the seed's recur_ok
; candidate)? Only a single conj of a fresh-seeded loop variable counts,
; and no sibling arg may read it (a sibling seeing the old header would
; observe the append, or the growth's free).
(defn recur-cand-of [kid :- HExpr all :- &HExprs ai :- i64 bcx :- &BCtx] :- i64
  (match kid
    (
      HConj
      [v x el inpo]
      (match v
        (
          HVar
          [n]
          (if
            (
              and
              (types/sids-has (b-loopcopy-of bcx) n)
              (types/sids-has (b-loopseed-of bcx) n)
              (= (recur-conj-count all n) 1)
              (not (recur-sibling-reads all ai 0 n))
            )
            n
            -1)
        )
        (_ -1))
    )
    (_ -1)))

; b-kids with a per-arg recur-ok context: the arg at `ai` that is the
; self-update conj is checked under recur-ok = its accumulator var.
(defn b-recur-kids [es :- HExprs
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
  acc :- HExprs
  all :- &HExprs
  ai :- i64
] :- BKRes
  (match es
    (HENil [] (BKOk st owns rem cons (hexpr/hes-rev acc (HENil))))
    (
      HECons
      [kid next]
      (let [bcx2 (bcx-with-recur-ok bcx (recur-cand-of (clone kid) all ai bcx))]
        (match
          (bcheck kid st owns rem cons (clone tys) bcx2 ws)
          (BErr [msg] (BKErr msg))
          (
            BOk
            [st2 owns2 rem2 cons2 c2]
            (b-recur-kids next st2 owns2 rem2 cons2 tys bcx ws (HECons c2 acc) all (+ ai 1))
          )))
    )))

; The watch set: binders whose field aliases the scrutinee's one heap box
; (str/vec/map/set/fn fields and boxed-ADT children — the seed's rule,
; including inline-ADT children whose binder is the field's address).
(defn b-facts-alias-of [bcx :- &BCtx fty :- &Ty] :- i64
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc adts dp retb _nm _crb _rok _lseed]
      (fp-binder-alias fty facts)
    )))

(defn aliasing-binders [binders :- Sids fields :- TyList bcx :- &BCtx acc :- Sids] :- Sids
  (match binders
    (SNil [] acc)
    (
      SCons
      [b rest]
      (let [fty
        (match fields
          (TyCons [h t2] (clone h))
          (TyNil [] (types/t-i64)))
        frest
        (match fields
          (TyCons [h t2] t2)
          (TyNil [] (TyNil)))
        keep
        (if
          (or (= (b-facts-alias-of bcx fty) 1) (= (types/ty-tag fty) 16))
          (SCons b acc)
          acc)]
        (aliasing-binders rest frest bcx keep))
    )))

; The borrowed-scrutinee binder errors (the seed's scrut_borrowed_param
; block): an aliasing binder that escapes the arm or moves hands a piece of
; the caller's box to someone else — the caller frees it too. Legitimate
; only when the defn's return is itself a borrow (`&T`): the alias IS the
; return value.
(defn b-borrowed-scrut-hit [binders :- Sids
  fields :- TyList
  st :- IMap
  escaped :- Sids
  bcx :- &BCtx
  scrid :- i64
  rem :- &IMap
] :- str
  (if
    (or (< scrid 0) (not (types/sids-has (b-nomove-of bcx) scrid)))
    ""
    (b-borrowed-scrut-walk binders fields st escaped bcx rem)))

(defn b-borrowed-scrut-walk [binders :- Sids
  fields :- TyList
  st :- IMap
  escaped :- Sids
  bcx :- &BCtx
  rem :- &IMap
] :- str
  (match binders
    (SNil [] "")
    (
      SCons
      [b rest]
      (let [fty
        (match fields
          (TyCons [h t2] (clone h))
          (TyNil [] (types/t-i64)))
        frest
        (match fields
          (TyCons [h t2] t2)
          (TyNil [] (TyNil)))
        aliases (or (= (b-facts-alias-of bcx fty) 1) (= (types/ty-tag fty) 16))
        nm (forms/sym-str (b-tab-of bcx) b)
        hit
        (if
          (and aliases (types/sids-has escaped b) (not (= (b-currbrb-of bcx) 1)))
          (str "cannot return " nm ": it aliases a field of the matched value — clone it first")
          (if
            (and aliases (= (forms/im-get st b 0) 1))
            (str "cannot move " nm ": it aliases a field of the matched value — clone it first")
            ""))]
        (if
          (> (count hit) 0)
          (span/err-occ hit b (occ-at rem b))
          (b-borrowed-scrut-walk rest frest st escaped bcx rem)))
    )))

(defn b-tab-of [bcx :- &BCtx] :- i64
  (match bcx (BCtx [escaped shadowed facts tab shared _lc adts dp retb _nm _crb _rok _lseed] tab)))

(defn b-escaped-of [bcx :- &BCtx] :- Sids
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc adts dp retb _nm _crb _rok _lseed] (clone escaped))))

(defn b-currbrb-of [bcx :- &BCtx] :- i64
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc adts dp retb _nm curbrb _rok _lseed] curbrb)))

(defn binds-loopcopy [binds :- Binds acc :- Sids] :- Sids
  (match binds
    (BNil [] acc)
    (
      BCons
      [name init ty next]
      (
        binds-loopcopy
        next
        (if
          (types/is-non-copy-ty ty)
          (SCons name acc)
          acc)
      )
    )))

(defn b-loop-binds [binds :- Binds
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- TyEnv
  bcx :- &BCtx
  ws :- &Watches
  acc :- Binds
  saved :- IMap
  savedo :- IMap
  seed :- Sids
] :- BLoopRes
  (match binds
    (BNil [] (BLoopRes st owns rem cons tys acc saved savedo seed))
    (
      BCons
      [name init ty next]
      (match
        (bcheck init st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BLoopErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 init2]
          (let [sval (forms/im-get st1 name 0) soval (forms/im-get owns1 name 0)]
            ; a non-Copy Var seed moves into the loop: the value rides the
            ; loop slot and no scope ever frees it, so the source's drop
            ; duty ends here (the seed's Loop-init move)
            (if
              (
                and
                (= (lower/h-tag init2) 3)
                (types/is-non-copy-ty ty)
                (not (types/sids-has (b-loopcopy-of bcx) (lower/name-of (clone init2))))
              )
              ; the loop slot inherits the source's duty — read the source's
              ; ownership BEFORE the move clears it
              (let [src (lower/name-of (clone init2)) src-owns (forms/im-get owns1 src 0)]
                (match
                  (move-var src st1 owns1 cons1 bcx ws)
                  (
                    MoveRes
                    [st2 owns2 cons2 m2]
                    (if
                      (> (count m2) 0)
                      (BLoopErr m2)
                      (
                        b-loop-binds
                        next
                        (forms/im-put st2 name 0)
                        (forms/im-put owns2 name src-owns)
                        rem1
                        cons2
                        (forms/te-put tys name ty)
                        bcx
                        ws
                        (BCons name init2 ty acc)
                        (forms/im-put saved name sval)
                        (forms/im-put savedo name soval)
                        seed
                      ))
                  )))
              (let [iown
                (if
                  (types/is-non-copy-ty ty)
                  (if
                    (b-allocates-of init2 bcx)
                    1
                    0)
                  0)
                seed2
                (if
                  (= iown 1)
                  (SCons name seed)
                  seed)]
                (
                  b-loop-binds
                  next
                  (forms/im-put st1 name 0)
                  (forms/im-put owns1 name iown)
                  rem1
                  cons1
                  (forms/te-put tys name ty)
                  bcx
                  ws
                  (BCons name init2 ty acc)
                  (forms/im-put saved name sval)
                  (forms/im-put savedo name soval)
                  seed2
                ))))
        ))
    )))

(defn b-restore-st [saved :- IMap st :- IMap] :- IMap
  (match saved
    (MNil [] st)
    (MCons [k prev next] (b-restore-st next (forms/im-put st k prev)))))

; The ADT index of a named match scrutinee for the boxed-alias analysis
; (the seed's scrutinee_adt); -1 when there is no binding to retire.
; Does a match binder over field type fty alias the scrutinee's one heap
; box? str/vec/map/set/fn fields and boxed-ADT children do; scalars and
; inline-ADT children copy by value.
(defn fp-binder-alias [fty :- &Ty facts :- &Facts] :- i64
  (let [t (types/ty-tag fty)]
    (cond
      (= t 12)
      1
      (= t 13)
      1
      (= t 14)
      1
      (= t 15)
      1
      (= t 17)
      1
      (= t 16)
      (forms/facts-boxed-at facts (types/ty-arg fty))
      0)))

; Real field type for a binder whose field aliases the scrutinee's heap
; (vec/map/set or a boxed ADT child) so a move through it registers; other
; fields keep the I64 copy stand-in.
(defn fp-binder-type [fty :- Ty facts :- &Facts] :- Ty
  (let [t (types/ty-tag fty)]
    (if
      (and (or (= t 13) (= t 14) (= t 15) (= t 16)) (= (fp-binder-alias fty facts) 1))
      fty
      (types/t-i64))))

; The variant's field list, read through the borrowed context: returning the
; table itself copied every ADT in the program.
(defn b-varnt-fields-at [bcx :- &BCtx t :- i64 vi :- i64] :- TyList
  (match bcx
    (
      BCtx
      [escaped shadowed facts tab shared _lc adts _dp _retb _nm _crb _rok _lseed]
      (forms/varnt-fields-at adts t vi)
    )))

; Did any aliasing binder escape the arm (tail position) or get moved? If
; so the box's drop duty transfers and the scrutinee's scope free is
; suppressed (the seed's any_alias_escape).
(defn b-arm-esc [binders :- Sids
  fields :- TyList
  st :- IMap
  escaped :- Sids
  facts :- &Facts
  acc :- i64
] :- i64
  (match binders
    (SNil [] acc)
    (
      SCons
      [b rest]
      (let [fty
        (match fields
          (TyCons [h t2] (clone h))
          (TyNil [] (types/t-i64)))
        frest
        (match fields
          (TyCons [h t2] t2)
          (TyNil [] (TyNil)))
        ; an inline ADT binder is materialized as the field's address
        ; inside the box, so it aliases too (the seed's `|| Adt`)
        hit
        (if
          (
            and
            (or (= (fp-binder-alias fty facts) 1) (= (types/ty-tag fty) 16))
            (or (types/sids-has escaped b) (= (forms/im-get st b 0) 1))
          )
          1
          acc)
      ]
        (b-arm-esc rest frest st escaped facts hit))
    )))

; match arms: every arm starts from the same post-scrutinee state; a move
; in one arm must not poison the others — only one arm runs. Binders alias
; the scrutinee's fields, so they never own (I64 is the historical
; state-tracking stand-in).
; Per-arm sets, in arm order: the pre-match names each arm moved.
(deftype MovedL
  (MLNil)
  (MLCons [m :- Sids next :- MovedL]))

(defn ml-rev [ms :- MovedL acc :- MovedL] :- MovedL
  (match ms
    (MLNil [] acc)
    (MLCons [m next] (ml-rev next (MLCons m acc)))))

(defn ml-union [ms :- &MovedL acc :- Sids] :- Sids
  (match ms
    (MLNil [] acc)
    (MLCons [m next] (ml-union next (statemap/union m acc)))))

(deftype BArmsRes
  (BArmsRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap arms :- HArms esc :- i64 moved :- MovedL])
  (BArmsErr [msg :- str]))

(defn b-arm-state [binders :- Sids
  fields :- TyList
  pst :- IMap
  powns :- IMap
  tys :- TyEnv
  facts :- &Facts
] :- BLRes
  (match binders
    (SNil [] (BLRes pst powns (MNil) (MNil) tys (BNil)))
    (
      SCons
      [b rest]
      (let [fty
        (match fields
          (TyCons [h t2] (clone h))
          (TyNil [] (types/t-i64)))
        frest
        (match fields
          (TyCons [h t2] t2)
          (TyNil [] (TyNil)))]
        (match
          (b-arm-state rest frest pst powns tys facts)
          (BLErr [msg] (BLErr msg))
          (
            BLRes
            [st1 owns1 rem1 cons1 tys1 binds1]
            (
              BLRes
              (forms/im-put st1 b 0)
              (forms/im-put owns1 b 0)
              rem1
              cons1
              (forms/te-put tys1 b (fp-binder-type fty facts))
              (BNil)
            )
          )))
    )))

(defn b-arms [arms :- HArms
  pst :- IMap
  powns :- IMap
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
  acc :- HArms
  adtidx :- i64
  boxed :- i64
  esc :- i64
  scrid :- i64
  freeable :- i64
  sv :- i64
  macc :- MovedL
] :- BArmsRes
  (match arms
    (HANil [] (BArmsRes st owns rem cons (hes-rev-arms acc (HANil)) esc (ml-rev macc (MLNil))))
    (
      HACons
      [variant binders body ef next]
      (let [fields
        (if
          (= boxed 1)
          (b-varnt-fields-at bcx adtidx variant)
          (TyNil))]
        (match
          (b-arm-state-of (clone binders) (clone fields) (clone pst) (clone powns) (clone tys) bcx)
          (BLErr [msg] (BArmsErr msg))
          (
            BLRes
            [st1 owns1 rem1 cons1 tys1 binds1]
            (let [; The arm's watch (see Watches): pushed when the box's
              ; binders alias its heap and the watch can matter — the body
              ; names the scrutinee variable (it may move it), or this
              ; match may free the box (its binders may need branch frees).
              ; An arm that never names the scrutinee cannot move it, so
              ; its watch carries no scrutinee.
              named (and (>= scrid 0) (b-mentions body scrid))
              armwbs
              (if
                (and (= boxed 1) (or named (= freeable 1)))
                (aliasing-binders (clone binders) (clone fields) bcx (SNil))
                (SNil))
              aws
              (if
                (types/sids-null armwbs)
                (clone ws)
                (
                  WCons
                  (if named scrid -1)
                  (clone armwbs)
                  (if (= freeable 1) (non-copy-binders armwbs tys1) (SNil))
                  (clone ws)
                ))
            ]
              (match
                (bcheck body (clone st1) (clone owns1) rem1 cons1 tys1 bcx aws)
                (BErr [msg] (BArmsErr msg))
                (
                  BOk
                  [st2 owns2 rem2 cons2 body2]
                  ; a value moved in any arm counts as moved and
                  ; unconsumed-eligible afterwards
                  (let [escaped (b-tail-escape body2 (SNil))
                    esc2
                    (
                      b-arm-esc-of
                      (clone binders)
                      (clone fields)
                      (clone st2)
                      (clone escaped)
                      bcx
                      esc
                    )
                    plan
                    (b-arm-plan-of freeable variant binders fields body2 st2 escaped sv bcx)
                    mv (statemap/moved-in st2 pst)
                    borrowed-hit
                    (
                      b-borrowed-scrut-hit
                      (clone binders)
                      (clone fields)
                      (clone st2)
                      escaped
                      bcx
                      scrid
                      rem2
                    )
                    ; a value moved in any arm is moved afterwards; a name
                    ; that failed to own in any arm never owns afterwards
                    st3 (statemap/merge-into st st2 (statemap/prefix-len st2 pst) 1)
                    owns3 (statemap/merge-into owns owns2 (statemap/prefix-len owns2 powns) 0)]
                    (if
                      (> (count borrowed-hit) 0)
                      (BArmsErr borrowed-hit)
                      (
                        b-arms
                        next
                        pst
                        powns
                        st3
                        owns3
                        rem2
                        cons2
                        tys
                        bcx
                        ws
                        (HACons variant binders body2 plan acc)
                        adtidx
                        boxed
                        esc2
                        scrid
                        freeable
                        sv
                        (MLCons mv macc)
                      )))
                )))
          )))
    )))

; The arm's exit-free plan, computed only when the match may free its
; scrutinee (see b-scrut-freeable).
(defn b-arm-plan-of [freeable :- i64
  variant :- i64
  binders :- &Sids
  fields :- &TyList
  body :- &HExpr
  st :- &IMap
  escaped :- &Sids
  sv :- i64
  bcx :- &BCtx
] :- ArmFree
  (if
    (= freeable 0)
    (AFNone)
    (match bcx
      (
        BCtx
        [_e _s facts _t _sh _lc _adts _dp retb _nm _crb _rok _lseed]
        (alias/arm-plan variant binders fields body st escaped sv facts retb)
      ))))

; Which box may this match free at its arms' exits? 1: a fresh temp (a
; call result, constructor or clone nobody else holds) — always freed
; there. 2: an owned, unmoved boxed variable — freed there only when some
; arm moves an aliasing binder out (its scope free is then suppressed). 0:
; neither (a borrowed parameter, a loop variable, an alias, an inline ADT).
(defn b-scrut-freeable [scrut :- &HExpr boxed :- i64 st :- &IMap owns :- &IMap bcx :- &BCtx] :- i64
  (if
    (= boxed 0)
    0
    (match scrut
      (
        HVar
        [v]
        (if
          (
            and
            (= (forms/im-get owns v 0) 1)
            (= (forms/im-get st v -1) 0)
            (not (types/sids-has (b-nomove-of bcx) v))
            (not (types/sids-has (b-loopcopy-of bcx) v))
          )
          2
          0)
      )
      (_ (if (b-fresh-box-of scrut bcx) 1 0)))))

(defn b-fresh-box-of [scrut :- &HExpr bcx :- &BCtx] :- bool
  (match bcx
    (BCtx [_e _s _f _t _sh _lc _adts _dp retb _nm _crb _rok _lseed] (alias/fresh-box scrut retb))))

(defn b-scrut-adt-of [scrut :- &HExpr tys :- &TyEnv bcx :- &BCtx] :- i64
  (match bcx
    (BCtx [_e _s _f _t _sh _lc _adts _dp retb _nm _crb _rok _lseed] (alias/scrut-adt scrut tys retb))))

; --- branch-local frees ---------------------------------------------------------
;
; A binding moved in one branch of an if/match is moved after the merge, so
; its scope free is gone; the branches that kept it free it at their exit.
; Eligible: a non-Copy value this function owns before the branch, or a
; binder of a box this match may free (see Watches) — never a borrowed
; parameter, a loop copy, a planner temp, a name bound twice in the defn
; (the state maps are flat, so a shadowed name's state is not its own), a watched
; scrutinee, the match's own scrutinee, the arm's own binders, or a value
; the branch's result may point into. A branch that jumps back to a loop
; head has no exit of its own.

(defn b-non-copy [t :- &Ty] :- bool
  (let [g (types/ty-tag t)] (and (>= g 13) (<= g 17))))

; The binders whose (registered) type is non-Copy: a str binder aliases the
; box too but is never moved on its own.
(defn non-copy-binders [bs :- Sids tys :- &TyEnv] :- Sids
  (match bs
    (SNil [] (SNil))
    (
      SCons
      [b rest]
      (if
        (b-non-copy (forms/te-get tys b))
        (SCons b (non-copy-binders rest tys))
        (non-copy-binders rest tys))
    )))

(defn b-branch-free-ok [n :- i64
  body :- &HExpr
  powns :- &IMap
  bcx :- &BCtx
  ws :- &Watches
] :- bool
  (match bcx
    (
      BCtx
      [_e shadowed _f tab _sh loopcopy _adts _dp retb nomove _crb _rok _lseed]
      (and
        ; a planner-hoisted `~aN` temp is freed by its own let (and its
        ; name is reused across nodes, so it names no single binding)
        (not (= (subs (forms/sym-str tab n) 0 1) "~"))
        (not (types/sids-has nomove n))
        (not (types/sids-has loopcopy n))
        (not (types/sids-has shadowed n))
        (not (watched ws n))
        (or (= (forms/im-get powns n 0) 1) (freeable-alias ws n))
        (let [one (SCons n (SNil)) none (SNil)] (not (alias/tail-may-alias body one none retb))))
    )))

(defn b-branch-free-names [union :- &Sids
  moved :- &Sids
  shadow :- &Sids
  exclude :- i64
  body :- &HExpr
  powns :- &IMap
  bcx :- &BCtx
  ws :- &Watches
  acc :- Sids
] :- Sids
  (match union
    (SNil [] acc)
    (
      SCons
      [n rest]
      (b-branch-free-names
        rest
        moved
        shadow
        exclude
        body
        powns
        bcx
        ws
        (if
          (
            and
            (not (= n exclude))
            (not (types/sids-has moved n))
            (not (types/sids-has shadow n))
            (b-branch-free-ok n body powns bcx ws)
          )
          (SCons n acc)
          acc))
    )))

; The branch body with its local frees (frees run after its value).
(defn b-branch-frees [body :- HExpr
  union :- &Sids
  moved :- &Sids
  shadow :- &Sids
  exclude :- i64
  powns :- &IMap
  bcx :- &BCtx
  ws :- &Watches
] :- HExpr
  (if
    (or (types/sids-null union) (alias/tail-has-recur body))
    body
    (let [fs (b-branch-free-names union moved shadow exclude body powns bcx ws (SNil))]
      (if
        (types/sids-null fs)
        body
        (HLet (BNil) body (statemap/sort-by-name fs (b-tab-of bcx)))))))

(defn arms-branch-frees [arms :- HArms
  mvs :- &MovedL
  un :- &Sids
  exclude :- i64
  powns :- &IMap
  bcx :- &BCtx
  ws :- &Watches
] :- HArms
  (match arms
    (HANil [] (HANil))
    (
      HACons
      [variant binders body ef next]
      (match mvs
        (MLNil [] (HACons variant binders body ef next))
        (
          MLCons
          [m mrest]
          (HACons
            variant
            (clone binders)
            (b-branch-frees body un m binders exclude powns bcx ws)
            ef
            (arms-branch-frees next mrest un exclude powns bcx ws))
        ))
    )))

(defn arms-no-free [arms :- HArms] :- HArms
  (match arms
    (HANil [] (HANil))
    (HACons [variant binders body _ef next] (HACons variant binders body (AFNone) (arms-no-free next)))))

(defn hes-rev-arms [arms :- HArms acc :- HArms] :- HArms
  (match arms
    (HANil [] acc)
    (
      HACons
      [variant binders body ef next]
      (hes-rev-arms next (HACons variant binders body ef acc))
    )))

; closure captures: use, record the heap-ownership bit, then move the
; non-Copy ones (the env's drop glue frees only what it really owns)
(deftype BCapRes
  (BCapRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap caps :- Caps])
  (BCapErr [msg :- str]))

(defn b-caps [caps :- Caps
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- BCapRes
  (match caps
    (CNil [] (BCapRes st owns rem cons (CNil)))
    (
      CCons
      [name ty own next]
      (match
        (use-var name (occ-bump rem name) tys st bcx)
        (
          UseRes
          [rem2 msg]
          (if
            (> (count msg) 0)
            (BCapErr msg)
            (let [own2 (forms/im-get owns name 0)]
              (if
                (types/is-non-copy-ty ty)
                (match
                  (move-var name st owns cons bcx ws)
                  (
                    MoveRes
                    [st2 owns2 cons2 m2]
                    (if
                      (> (count m2) 0)
                      (BCapErr (occ-tag m2 rem2 name))
                      (match
                        (b-caps next st2 owns2 rem2 cons2 tys bcx ws)
                        (BCapErr [msg] (BCapErr msg))
                        (
                          BCapRes
                          [st3 owns3 rem3 cons3 caps2]
                          (BCapRes st3 owns3 rem3 cons3 (CCons name ty own2 caps2))
                        )))
                  ))
                (match
                  (b-caps next st owns rem2 cons tys bcx ws)
                  (BCapErr [msg] (BCapErr msg))
                  (
                    BCapRes
                    [st3 owns3 rem3 cons3 caps2]
                    (BCapRes st3 owns3 rem3 cons3 (CCons name ty own2 caps2))
                  )))))
        ))
    )))
;
; --- R5: hoisting fresh argument temps ------------------------------------------
;
; The seed's hoist_arg_temps: `(f … <temp> …)` becomes
; `(let [~aN <temp>] (f … ~aN …))` and the ordinary let planning frees ~aN
; after the node. Two kinds of temp leak otherwise: a fresh box on a
; borrowed parameter (the callee only reads it, nobody owns it) and any
; fresh string/collection temp (callees never free those; constructors,
; str, conj and spit copy or consume the bytes). Never under a `&T` or
; alias-returning callee, whose result may be the temp itself. Evaluation
; order is kept: every effectful argument before a hoisted one is hoisted
; too (under its own type), and the hoist stops at an argument it cannot
; type. The ~aN counter is per defn and rides in `rem` under key -1 (rem
; threads sequentially through every walk, like the seed's counter).

(defn hz-none [t :- &Ty] :- bool (= (types/ty-tag t) 19))

; Reads of bindings, literals and arithmetic over them: no effects to
; reorder around a hoisted argument (the seed's order_free).
(defn hz-order-free [e :- &HExpr] :- bool
  (match e
    (HVar [_v] true)
    (HStrLit [_v] true)
    (HConstI64 [_v] true)
    (HConstF64 [_v] true)
    (HConstB [_v] true)
    (HVecLit [_el _vals] true)
    (HArgs [] true)
    (HBinW [_op a b _ty] (and (hz-order-free a) (hz-order-free b)))
    (HCmpW [_op a b _ty] (and (hz-order-free a) (hz-order-free b)))
    (HBinF [_op a b] (and (hz-order-free a) (hz-order-free b)))
    (HAnd [a b] (and (hz-order-free a) (hz-order-free b)))
    (HOr [a b] (and (hz-order-free a) (hz-order-free b)))
    (HMin [a b _ty] (and (hz-order-free a) (hz-order-free b)))
    (HMax [a b _ty] (and (hz-order-free a) (hz-order-free b)))
    (HNot [a] (hz-order-free a))
    (HAbs [a _ty] (hz-order-free a))
    (HICast [a _f _t] (hz-order-free a))
    (HCount [a] (hz-order-free a))
    (HStrCmp [_p a b] (and (hz-order-free a) (hz-order-free b)))
    (HStrOrd [_op a b] (and (hz-order-free a) (hz-order-free b)))
    (HStrNth [s idx res] (and (hz-none res) (hz-order-free s) (hz-order-free idx)))
    (_ false)))

(defn b-rb-at [bcx :- &BCtx name :- i64] :- i64
  (match bcx
    (BCtx [_e _s _f _t _sh _lc _adts _dp retb _nm _crb _rok _lseed] (alias/rb-get retb name))))

(defn b-ret-at [bcx :- &BCtx name :- i64] :- Ty
  (match bcx
    (BCtx [_e _s _f _t _sh _lc _adts _dp retb _nm _crb _rok _lseed] (alias/rb-ret-get retb name))))

; Is the callee's i-th parameter owned? Borrowed (`&`) parameters and
; extern parameters are not; builtins without a defn are owned except the
; seed's never-consuming set.
(defn plist-owned-at [ps :- &PList i :- i64] :- i64
  (match ps
    (PNil [] 1)
    (
      PCons
      [p rest]
      (if
        (= i 0)
        (match p (Param [_n _ty b] (if (= b 1) 0 1)))
        (plist-owned-at rest (- i 1)))
    )))

(defn dparams-owned-at [dp :- &DParams name :- i64 i :- i64] :- i64
  (match dp
    (DPNil [] -1)
    (
      DPCons
      [n ps next]
      (if
        (= n name)
        (plist-owned-at ps i)
        (dparams-owned-at next name i))
    )))

(defn hz-builtin-shared [nm :- str] :- bool
  (or (= nm "count") (= nm "even?") (= nm "print-i64") (= nm "print-f64")
      (= nm "get") (= nm "clone") (= nm "drop")))

(defn b-param-owned-at [bcx :- &BCtx name :- i64 i :- i64] :- i64
  (match bcx
    (
      BCtx
      [_e _s _f tab _sh _lc _adts dp _retb _nm _crb _rok _lseed]
      (let [k (dparams-owned-at dp name i)]
        (if
          (>= k 0)
          k
          (if (hz-builtin-shared (forms/sym-str tab name)) 0 1)))
    )))

; Does this type pass the hoist's filter? boxed: a boxed ADT; otherwise a
; string or collection.
(defn hz-want [t :- &Ty boxed :- bool bcx :- &BCtx] :- bool
  (if
    boxed
    (and (= (types/ty-tag t) 16) (= (b-facts-boxed-at bcx (types/ty-arg t)) 1))
    (alias/coll-ty t)))

(defn hz-filter [t :- Ty boxed :- bool bcx :- &BCtx] :- Ty
  (if (hz-want t boxed bcx) t (types/t-none)))

; The static type of a fresh heap value the caller would otherwise lose,
; t-none when e is not one (the seed's fresh_temp_ty).
(defn hz-fresh [e :- &HExpr tys :- &TyEnv boxed :- bool bcx :- &BCtx] :- Ty
  (match e
    (
      HCall
      [c _args]
      (if
        (> (b-rb-at bcx c) 0)
        (types/t-none)
        (hz-filter (b-ret-at bcx c) boxed bcx))
    )
    (
      HCtor
      [adt _v _args]
      (if
        (and boxed (= (b-facts-boxed-at bcx adt) 1))
        (types/t-adt adt)
        (types/t-none))
    )
    (
      HClone
      [inner]
      (match inner
        (HVar [v] (hz-filter (forms/te-get tys v) boxed bcx))
        (_ (hz-fresh inner tys boxed bcx)))
    )
    (HSubs [_s _a _b] (if boxed (types/t-none) (types/t-str)))
    (HStrCat [_args] (if boxed (types/t-none) (types/t-str)))
    (HJoin [_sep _xs] (if boxed (types/t-none) (types/t-str)))
    (HToStr [_e _ty] (if boxed (types/t-none) (types/t-str)))
    (HCharStr [_e] (if boxed (types/t-none) (types/t-str)))
    (HSlurp [_p] (if boxed (types/t-none) (types/t-str)))
    (HSplit [_s _sep] (if boxed (types/t-none) (types/t-vec 2)))
    (HConj [_v _x el _ip] (if boxed (types/t-none) (types/t-vec el)))
    (_ (types/t-none))))

; The static type to bind a hoisted argument under (the seed's hoist_ty).
(defn hz-hoist-ty [e :- &HExpr tys :- &TyEnv bcx :- &BCtx] :- Ty
  (match e
    (HCall [c _args] (b-ret-at bcx c))
    (HCtor [adt _v _args] (types/t-adt adt))
    (
      HClone
      [inner]
      (match inner
        (HVar [v] (forms/te-get tys v))
        (_ (hz-hoist-ty inner tys bcx)))
    )
    (HSubs [_s _a _b] (types/t-str))
    (HStrCat [_args] (types/t-str))
    (HJoin [_sep _xs] (types/t-str))
    (HToStr [_e _ty] (types/t-str))
    (HCharStr [_e] (types/t-str))
    (HSlurp [_p] (types/t-str))
    (HSplit [_s _sep] (types/t-vec 2))
    (HConj [_v _x el _ip] (types/t-vec el))
    (HIf [_c _t _e ty] (clone ty))
    (HMatch [_s _a ty] (clone ty))
    (HLoop [_b ty _body] (clone ty))
    (HGet [_src _idx _d ty res] (if (hz-none res) (clone ty) (clone res)))
    (HStrNth [_s _idx res] (clone res))
    (HParseNum [_s _int res] (clone res))
    (_ (types/t-none))))

; A hoist plan, newest entry first: argument index, bind type, leaks bit.
(deftype HPlan
  (HPNil)
  (HPCons [i :- i64 ty :- Ty leaks :- i64 next :- HPlan]))

; callee: the HCall's name (per-parameter kinds), -1 for nodes whose
; arguments are all owned (str, constructors, conj, spit).
(defn hz-plan [args :- &HExprs i :- i64 callee :- i64 tys :- &TyEnv bcx :- &BCtx acc :- HPlan] :- HPlan
  (match args
    (HENil [] acc)
    (
      HECons
      [a next]
      (if
        (hz-order-free a)
        (hz-plan next (+ i 1) callee tys bcx acc)
        (let [ht (hz-hoist-ty a tys bcx)]
          (if
            (hz-none ht)
            acc
            (hz-plan next (+ i 1) callee tys bcx (HPCons i ht (hz-leaks-bit a i callee tys bcx) acc)))))
    )))

; Trailing hoists that free nothing only add noise: drop them (the plan is
; newest-first, so trailing entries are at the head).
(defn hz-trim [p :- HPlan] :- HPlan
  (match p
    (HPNil [] (HPNil))
    (HPCons [i ty leaks next] (if (= leaks 1) (HPCons i ty leaks next) (hz-trim next)))))

(defn hz-plan-ty [p :- &HPlan i :- i64] :- Ty
  (match p
    (HPNil [] (types/t-none))
    (HPCons [j ty _l next] (if (= j i) (clone ty) (hz-plan-ty next i)))))

(defn hz-mint [tab :- i64 n :- i64] :- i64
  (match (forms/intern1 tab (str "~a" n)) (I1Res [_t sid] sid)))

(deftype HZArgs (HZArgs [args :- HExprs binds :- Binds rem :- IMap]))

; Replace each planned argument with a fresh ~aN var; the binds come back
; in argument order.
(defn hz-rewrite [args :- HExprs i :- i64 p :- &HPlan rem :- IMap tab :- i64 acc :- HExprs bacc :- Binds] :- HZArgs
  (match args
    (HENil [] (HZArgs (hexpr/hes-rev acc (HENil)) (hexpr/binds-rev bacc (BNil)) rem))
    (
      HECons
      [a next]
      (let [t (hz-plan-ty p i)]
        (if
          (hz-none t)
          (hz-rewrite next (+ i 1) p rem tab (HECons a acc) bacc)
          (let [n (forms/im-get rem -1 0) sid (hz-mint tab n)]
            (
              hz-rewrite
              next
              (+ i 1)
              p
              (forms/im-put rem -1 (+ n 1))
              tab
              (HECons (HVar sid) acc)
              (BCons sid a t bacc)
            ))))
    )))

(deftype HZOut (HZOut [e :- HExpr rem :- IMap]))

(defn b-tab-at [bcx :- &BCtx] :- i64
  (match bcx (BCtx [_e _s _f tab _sh _lc _adts _dp _retb _nm _crb _rok _lseed] tab)))

; Hoist args; rebuild yields the node over the rewritten args.
(defn hz-apply [args :- HExprs callee :- i64 rem :- IMap tys :- &TyEnv bcx :- &BCtx] :- HZArgs
  (let [p (hz-trim (hz-plan args 0 callee tys bcx (HPNil)))]
    (match p
      (HPNil [] (HZArgs args (BNil) rem))
      (_ (hz-rewrite args 0 p rem (b-tab-at bcx) (HENil) (BNil))))))

(defn hz-wrap [binds :- Binds node :- HExpr rem :- IMap] :- HZOut
  (match binds
    (BNil [] (HZOut node rem))
    (_ (HZOut (HLet binds node (SNil)) rem))))

(defn hz-one [x :- HExpr] :- HExprs (HECons x (HENil)))

(defn hz-first [xs :- HExprs] :- HExpr
  (match xs
    (HECons [k _next] k)
    (HENil [] (HConstI64 0))))

(defn hz-second [xs :- HExprs] :- HExpr
  (match xs
    (HECons [_k next] (hz-first next))
    (HENil [] (HConstI64 0))))

(defn b-hoist [e :- HExpr rem :- IMap tys :- &TyEnv bcx :- &BCtx] :- HZOut
  (match e
    (
      HCall
      [name args]
      (if
        (> (b-rb-at bcx name) 0)
        (HZOut (HCall name args) rem)
        (match (hz-apply args name rem tys bcx) (HZArgs [a2 bs rem2] (hz-wrap bs (HCall name a2) rem2))))
    )
    (HStrCat [args] (match (hz-apply args -1 rem tys bcx) (HZArgs [a2 bs rem2] (hz-wrap bs (HStrCat a2) rem2))))
    (
      HCtor
      [adt variant args]
      (match (hz-apply args -1 rem tys bcx) (HZArgs [a2 bs rem2] (hz-wrap bs (HCtor adt variant a2) rem2)))
    )
    (
      HConj
      [v x el ip]
      (match
        (hz-apply (hz-one x) -1 rem tys bcx)
        (HZArgs [a2 bs rem2] (hz-wrap bs (HConj v (hz-first a2) el ip) rem2)))
    )
    (
      HSpit
      [path data]
      (match
        (hz-apply (HECons path (hz-one data)) -1 rem tys bcx)
        (HZArgs [a2 bs rem2] (hz-wrap bs (HSpit (hz-first (clone a2)) (hz-second a2)) rem2)))
    )
    ; Builtins that only read their operands and return a scalar or a
    ; fresh copy: a fresh operand is bound and freed after the read.
    (HCount [a] (match (hz-apply (hz-one a) -1 rem tys bcx) (HZArgs [a2 bs rem2] (hz-wrap bs (HCount (hz-first a2)) rem2))))
    (HSlurp [a] (match (hz-apply (hz-one a) -1 rem tys bcx) (HZArgs [a2 bs rem2] (hz-wrap bs (HSlurp (hz-first a2)) rem2))))
    (
      HStrCmp
      [pol a b]
      (match
        (hz-apply (HECons a (hz-one b)) -1 rem tys bcx)
        (HZArgs [a2 bs rem2] (hz-wrap bs (HStrCmp pol (hz-first (clone a2)) (hz-second a2)) rem2)))
    )
    (
      HStrOrd
      [op a b]
      (match
        (hz-apply (HECons a (hz-one b)) -1 rem tys bcx)
        (HZArgs [a2 bs rem2] (hz-wrap bs (HStrOrd op (hz-first (clone a2)) (hz-second a2)) rem2)))
    )
    (
      HSubs
      [s a b]
      (match (hz-apply (hz-one s) -1 rem tys bcx) (HZArgs [a2 bs rem2] (hz-wrap bs (HSubs (hz-first a2) a b) rem2)))
    )
    (
      HStrNth
      [s idx res]
      (match (hz-apply (hz-one s) -1 rem tys bcx) (HZArgs [a2 bs rem2] (hz-wrap bs (HStrNth (hz-first a2) idx res) rem2)))
    )
    (
      HSplit
      [s sep]
      (match
        (hz-apply (HECons s (hz-one sep)) -1 rem tys bcx)
        (HZArgs [a2 bs rem2] (hz-wrap bs (HSplit (hz-first (clone a2)) (hz-second a2)) rem2)))
    )
    (
      HJoin
      [sep xs]
      (match
        (hz-apply (HECons sep (hz-one xs)) -1 rem tys bcx)
        (HZArgs [a2 bs rem2] (hz-wrap bs (HJoin (hz-first (clone a2)) (hz-second a2)) rem2)))
    )
    (_ (HZOut e rem))))

; The plan step for one argument, without building the plan: 0 keep going
; (order-free, or hoistable without leaking), 1 leaks (the trimmed plan is
; nonempty), 2 stop (cannot be typed: the plan ends here).
(defn hz-arg-step [a :- &HExpr i :- i64 callee :- i64 tys :- &TyEnv bcx :- &BCtx] :- i64
  (if
    (hz-order-free a)
    0
    (if
      (hz-none (hz-hoist-ty a tys bcx))
      2
      (hz-leaks-bit a i callee tys bcx))))

; 1 when the argument leaks: a fresh string/collection, or a fresh box on a
; borrowed parameter. The parameter kind is looked up only for the latter.
(defn hz-leaks-bit [a :- &HExpr i :- i64 callee :- i64 tys :- &TyEnv bcx :- &BCtx] :- i64
  (cond
    (not (hz-none (hz-fresh a tys false bcx)))
    1
    (hz-none (hz-fresh a tys true bcx))
    0
    (< callee 0)
    0
    (= (b-param-owned-at bcx callee i) 0)
    1
    0))

(defn hz-leaky [args :- &HExprs i :- i64 callee :- i64 tys :- &TyEnv bcx :- &BCtx] :- bool
  (match args
    (HENil [] false)
    (
      HECons
      [a next]
      (let [k (hz-arg-step a i callee tys bcx)]
        (if (= k 0) (hz-leaky next (+ i 1) callee tys bcx) (= k 1)))
    )))

; Would b-hoist rewrite this node? A borrowed, allocation-free test, so the
; common no-hoist path never rebuilds a node.
(defn hz-needed [e :- &HExpr tys :- &TyEnv bcx :- &BCtx] :- bool
  (match e
    (HCall [name args] (and (= (b-rb-at bcx name) 0) (hz-leaky args 0 name tys bcx)))
    (HStrCat [args] (hz-leaky args 0 -1 tys bcx))
    (HCtor [_adt _v args] (hz-leaky args 0 -1 tys bcx))
    (HConj [_v x _el _ip] (= (hz-arg-step x 0 -1 tys bcx) 1))
    (
      HSpit
      [path data]
      (hz-pair-leaky path data tys bcx)
    )
    (HCount [a] (= (hz-arg-step a 0 -1 tys bcx) 1))
    (HSlurp [a] (= (hz-arg-step a 0 -1 tys bcx) 1))
    (HSubs [s _a _b] (= (hz-arg-step s 0 -1 tys bcx) 1))
    (HStrNth [s _i _r] (= (hz-arg-step s 0 -1 tys bcx) 1))
    (HStrCmp [_p a b] (hz-pair-leaky a b tys bcx))
    (HStrOrd [_o a b] (hz-pair-leaky a b tys bcx))
    (HSplit [s sep] (hz-pair-leaky s sep tys bcx))
    (HJoin [sep xs] (hz-pair-leaky sep xs tys bcx))
    (_ false)))

; Two operands, in evaluation order: the first leaks, or it is order-free
; and the second leaks (the plan's stop rule, as in hz-leaky).
(defn hz-pair-leaky [a :- &HExpr b :- &HExpr tys :- &TyEnv bcx :- &BCtx] :- bool
  (let [k (hz-arg-step a 0 -1 tys bcx)]
    (or (= k 1) (and (= k 0) (= (hz-arg-step b 1 -1 tys bcx) 1)))))

; Every node is hoisted before it is checked (the seed's check entry); the
; planner-made let is then planned like any other.
(defn bcheck [e :- HExpr
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- BRes
  (if
    (hz-needed e tys bcx)
    (match (b-hoist e rem tys bcx) (HZOut [e2 rem2] (bcheck-node e2 st owns rem2 cons tys bcx ws)))
    (bcheck-node e st owns rem cons tys bcx ws)))

; --- the checker body ----------------------------------------------------------------

(defn bcheck-node [e :- HExpr
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- BRes
  (match e
    (HConstI64 [v] (BOk st owns rem cons e))
    (HConstF64 [v] (BOk st owns rem cons e))
    (HConstB [v] (BOk st owns rem cons e))
    (HStrLit [v] (BOk st owns rem cons e))
    (HVecLit [el vals] (BOk st owns rem cons e))
    (HArgs [] (BOk st owns rem cons e))
    (
      HVar
      [name]
      (match
        (use-var name (occ-bump rem name) tys st bcx)
        (
          UseRes
          [rem2 msg]
          (if
            (> (count msg) 0)
            (BErr msg)
            (BOk st owns rem2 cons e))
        ))
    )
    (
      HBinW
      [op a b ty]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HBinW op c1 c2 ty))))
        ))
    )
    (
      HBinF
      [op a b]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HBinF op c1 c2))))
        ))
    )
    (
      HCmpW
      [op a b ty]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HCmpW op c1 c2 ty))))
        ))
    )
    (
      HStrCmp
      [p a b]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HStrCmp p c1 c2))))
        ))
    )
    (
      HStrOrd
      [op a b]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HStrOrd op c1 c2))))
        ))
    )
    (
      HAnd
      [a b]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HAnd c1 c2))))
        ))
    )
    (
      HOr
      [a b]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HOr c1 c2))))
        ))
    )
    (
      HMin
      [a b ty]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HMin c1 c2 ty))))
        ))
    )
    (
      HMax
      [a b ty]
      (match
        (bcheck a st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck b st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HMax c1 c2 ty))))
        ))
    )
    (
      HSplit
      [s sep]
      (match
        (bcheck s st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck sep st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HSplit c1 c2))))
        ))
    )
    (
      HJoin
      [sep xs]
      (match
        (bcheck sep st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck xs st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HJoin c1 c2))))
        ))
    )
    (
      HStrNth
      [s idx res]
      (match
        (bcheck s st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck idx st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HStrNth c1 c2 res))))
        ))
    )
    (
      HSubs
      [s a b]
      (match
        (bcheck s st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck a st1 owns1 rem1 cons1 (clone tys) bcx ws)
            (BErr [msg] (BErr msg))
            (
              BOk
              [st2 owns2 rem2 cons2 c2]
              (match
                (bcheck b st2 owns2 rem2 cons2 tys bcx ws)
                (BErr [msg] (BErr msg))
                (BOk [st3 owns3 rem3 cons3 c3] (BOk st3 owns3 rem3 cons3 (HSubs c1 c2 c3))))
            ))
        ))
    )
    (
      HICast
      [x from to]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HICast c1 from to))))
    )
    (
      HCount
      [x]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HCount c1))))
    )
    (
      HToStr
      [x ty]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HToStr c1 ty))))
    )
    (
      HCharStr
      [x]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HCharStr c1))))
    )
    (
      HNot
      [x]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HNot c1))))
    )
    (
      HAbs
      [x ty]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HAbs c1 ty))))
    )
    (
      HClone
      [x]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HClone c1))))
    )
    (
      HSlurp
      [p]
      (match
        (bcheck p st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HSlurp c1))))
    )
    (
      HExit
      [x]
      (match
        (bcheck x st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HExit c1))))
    )
    (
      HParseNum
      [s intf res]
      (match
        (bcheck s st owns rem cons tys bcx ws)
        (BErr [msg] (BErr msg))
        (BOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HParseNum c1 intf res))))
    )
    (
      HStrCat
      [args]
      (match
        (b-kids args st owns rem cons tys bcx ws (HENil))
        (BKErr [msg] (BErr msg))
        (BKOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HStrCat c1))))
    )
    (
      HSeq
      [es]
      (match
        (b-kids es st owns rem cons tys bcx ws (HENil))
        (BKErr [msg] (BErr msg))
        (BKOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HSeq c1))))
    )
    (
      HRecur
      [args drops]
      ; `all` is walked for sibling reads while the owned copy's elements are
      ; moved into bcheck one by one: the borrowed position needs its own list
      ; (one value in two parameter positions is an alias, and the reads would
      ; hit consumed elements).
      (match
        (b-recur-kids args st owns rem cons tys bcx ws (HENil) (clone args) 0)
        (BKErr [msg] (BErr msg))
        (BKOk [st1 owns1 rem1 cons1 c1] (BOk st1 owns1 rem1 cons1 (HRecur c1 drops))))
    )
    (
      HGet
      [src idx dflt ty res]
      (match
        (bcheck src st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck idx st1 owns1 rem1 cons1 (clone tys) bcx ws)
            (BErr [msg] (BErr msg))
            (
              BOk
              [st2 owns2 rem2 cons2 c2]
              (match
                (b-default dflt st2 owns2 rem2 cons2 tys bcx ws)
                (BKErr [msg] (BErr msg))
                (BKOk [st3 owns3 rem3 cons3 c3] (BOk st3 owns3 rem3 cons3 (HGet c1 c2 c3 ty res))))
            ))
        ))
    )
    (
      HConj
      [v x el inplace]
      (match
        (bcheck v st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (let [vn (lower/name-of (clone c1))
            isv (= (lower/h-tag c1) 3)
            t (forms/te-get tys vn)
            lastq
            (
              and
              isv
              (not (lower/ty-noneq t))
              (types/is-non-copy-ty t)
              (= (forms/im-get st1 vn 0) 0)
              (= (forms/im-get owns1 vn 0) 1)
              (or (= (forms/im-get rem1 vn 0) 0) (= (b-recur-ok-of bcx) vn))
            )]
            (if
              (not lastq)
              (match
                (bcheck x st1 owns1 rem1 cons1 tys bcx ws)
                (BErr [msg] (BErr msg))
                (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HConj c1 c2 el 0))))
              (match
                (move-var vn st1 owns1 cons1 bcx ws)
                (
                  MoveRes
                  [st2 owns2 cons2 m2]
                  (if
                    (> (count m2) 0)
                    (BErr m2)
                    (match
                      (bcheck x st2 owns2 rem1 cons2 tys bcx ws)
                      (BErr [msg] (BErr msg))
                      (BOk [st3 owns3 rem2 cons3 c2] (BOk st3 owns3 rem2 cons3 (HConj c1 c2 el 1)))))
                ))))
        ))
    )
    (
      HIf
      [c t2 e2 ty]
      (match
        (bcheck c st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck t2 (clone st1) (clone owns1) rem1 cons1 (clone tys) bcx ws)
            (BErr [msg] (BErr msg))
            (
              BOk
              [stT ownsT remT consT c2]
              (match
                (bcheck e2 (clone st1) (clone owns1) remT consT tys bcx ws)
                (BErr [msg] (BErr msg))
                (
                  BOk
                  [stE ownsE remE consE c3]
                  (let [mt (statemap/moved-in stT st1)
                    me (statemap/moved-in stE st1)
                    un (statemap/union mt (clone me))
                    c2b (b-branch-frees c2 un mt (SNil) -1 owns1 bcx ws)
                    c3b (b-branch-frees c3 un me (SNil) -1 owns1 bcx ws)
                    nst (statemap/prefix-len stT st1)
                    nse (statemap/prefix-len stE st1)
                    nwt (statemap/prefix-len ownsT owns1)
                    noe (statemap/prefix-len ownsE owns1)
                    st4 (statemap/merge-into (statemap/merge-into st1 stT nst 1) stE nse 1)
                    owns4 (statemap/merge-into (statemap/merge-into owns1 ownsT nwt 0) ownsE noe 0)]
                    (BOk st4 owns4 remE consE (HIf c1 c2b c3b ty)))
                ))
            ))
        ))
    )
    (
      HLet
      [binds body frees]
      (match
        (b-let-binds binds st owns rem cons tys bcx ws (BNil))
        (BLErr [msg] (BErr msg))
        ; b-let-binds prepends while walking, so restore source order —
        ; frees are collected in binding order over the restored chain
        (
          BLRes
          [st1 owns1 rem1 cons1 tys1 binds2]
          (match
            (bcheck body st1 owns1 rem1 cons1 tys1 bcx ws)
            (BErr [msg] (BErr msg))
            (
              BOk
              [st2 owns2 rem2 cons2 body2]
              (let [binds3
                (hexpr/binds-rev binds2 (BNil))
                ; scope-aware shadowing (the seed's rebound_in_body): a
                ; free stays suppressed only when THIS body rebinds the
                ; name — sibling-branch lets of the same name are distinct
                ; bindings in distinct slots, and each frees its own
                ; buffer. The defn-wide pre-pass suppressed both.
                frees2
                (b-frees-here binds3 body2 st2 owns2 cons2 bcx)
              ]
                (BOk st2 owns2 rem2 cons2 (HLet binds3 body2 frees2)))
            ))
        ))
    )
    (
      HLoop
      [binds ty body]
      (match
        (b-loop-binds binds st owns rem cons tys bcx ws (BNil) (MNil) (MNil) (SNil))
        (BLoopErr [msg] (BErr msg))
        (
          BLoopRes
          [st1 owns1 rem1 cons1 tys1 binds2 saved savedo seed1]
          (match
            (
              bcheck
              body
              st1
              owns1
              rem1
              cons1
              tys1
              (
                bcx-with-loopcopy
                bcx
                (binds-loopcopy (hexpr/binds-rev (clone binds2) (BNil)) (SNil))
                seed1
              )
              ws
            )
            (BErr [msg] (BErr msg))
            (
              BOk
              [st2 owns2 rem2 cons2 body2]
              ; owns restores with st: a stale owns=1 leaking past the loop
              ; would let a later conj on the shadowed outer binding fire
              ; in-place on a buffer it only aliases
              (
                BOk
                (b-restore-st saved st2)
                (b-restore-st savedo owns2)
                rem2
                cons2
                (HLoop (hexpr/binds-rev binds2 (BNil)) ty body2)
              )
            ))
        ))
    )
    (
      HCtor
      [adt variant args]
      (match
        (b-kids args st owns rem cons tys bcx ws (HENil))
        (BKErr [msg] (BErr msg))
        (
          BKOk
          [st1 owns1 rem1 cons1 c1]
          (if
            (= (b-facts-owns-at bcx adt) 1)
            (match
              (b-ctor-move (clone c1) st1 owns1 rem1 cons1 tys bcx ws)
              (B4Err [msg] (BErr msg))
              (B4 [st2 owns2 rem2 cons2] (BOk st2 owns2 rem2 cons2 (HCtor adt variant c1))))
            (BOk st1 owns1 rem1 cons1 (HCtor adt variant c1)))
        ))
    )
    (
      HMatch
      [scrut arms ty]
      (let [adtidx (b-scrut-adt-of scrut tys bcx)
        boxed
        (if
          (and (>= adtidx 0) (= (b-facts-boxed-at bcx adtidx) 1))
          1
          0)]
        (match
          (bcheck (clone scrut) st owns rem cons (clone tys) bcx ws)
          (BErr [msg] (BErr msg))
          (
            BOk
            [st1 owns1 rem1 cons1 c1]
            ; the watch matters only when some binding owns the scrutinee's
            ; box and frees it after the match: a constructor/call temp is
            ; never freed, so its binders need no retirement
            (let [scrid
              (if
                (and (= (lower/h-tag scrut) 3) (forms/im-has st1 (lower/name-of (clone scrut))))
                (lower/name-of (clone scrut))
                -1)
              fk (b-scrut-freeable c1 boxed st1 owns1 bcx)
              powns0 (clone owns1)
              svar
              (if
                (= (lower/h-tag c1) 3)
                (lower/name-of (clone c1))
                -1)]
              (match
                (
                  b-arms
                  arms
                  (clone st1)
                  (clone owns1)
                  st1
                  owns1
                  rem1
                  cons1
                  tys
                  bcx
                  ws
                  (HANil)
                  adtidx
                  boxed
                  0
                  scrid
                  (if (= fk 0) 0 1)
                  svar
                  (MLNil)
                )
                (BArmsErr [msg] (BErr msg))
                (
                  BArmsRes
                  [st2 owns2 rem2 cons2 arms0 esc2 mvs]
                  ; An aliasing binder left the arm: the box's drop duty
                  ; transfers, so the scrutinee's own scope free is suppressed.
                  ; A borrowed-parameter scrutinee keeps its box with the
                  ; caller — the transfer move would be the borrowed-param
                  ; error — and a loop variable never frees anyway. Both skip
                  ; the transfer (the seed's `!loop_copy && !scrut_borrowed_param`).
                  (let [arms1
                    (if
                      (or (= fk 1) (and (= fk 2) (= esc2 1)))
                      arms0
                      (arms-no-free arms0))
                    un (ml-union mvs (SNil))
                    arms2 (arms-branch-frees arms1 mvs un svar powns0 bcx ws)
                    sv
                    (if
                      (= (lower/h-tag scrut) 3)
                      (lower/name-of (clone scrut))
                      -1)]
                    (if
                      (
                        and
                        (= esc2 1)
                        (>= sv 0)
                        (not (types/sids-has (b-nomove-of bcx) sv))
                        (not (types/sids-has (b-loopcopy-of bcx) sv))
                      )
                      (match
                        (move-var sv st2 owns2 cons2 bcx ws)
                        (
                          MoveRes
                          [st3 owns3 cons3 m3]
                          (if
                            (> (count m3) 0)
                            (BErr m3)
                            (BOk st3 owns3 rem2 cons3 (HMatch c1 arms2 ty)))
                        ))
                      (BOk st2 owns2 rem2 cons2 (HMatch c1 arms2 ty))))
                )))
          )))
    )
    (
      HDrop
      [x]
      (match
        (bcheck x st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (if
            (= (lower/h-tag c1) 3)
            (match
              (move-if-nc (lower/name-of (clone c1)) st1 owns1 rem1 cons1 tys bcx ws)
              (MncErr [msg] (BErr msg))
              (MncRes [st2 owns2 rem2 cons2] (BOk st2 owns2 rem2 cons2 (HDrop c1))))
            (BOk st1 owns1 rem1 cons1 (HDrop c1)))
        ))
    )
    (
      HClosure
      [sig mangled params caps body]
      ; captures use+move here (non-Copy); the BODY is checked separately
      ; over the lambda table (check-lams) — the seed's split
      (match
        (b-caps caps st owns rem cons tys bcx ws)
        (BCapErr [msg] (BErr msg))
        (
          BCapRes
          [st1 owns1 rem1 cons1 caps2]
          (BOk st1 owns1 rem1 cons1 (HClosure sig mangled params caps2 body))
        ))
    )
    (
      HClosureCall
      [f args sig]
      (match
        (bcheck f st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (b-kids args st1 owns1 rem1 cons1 tys bcx ws (HENil))
            (BKErr [msg] (BErr msg))
            (BKOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HClosureCall c1 c2 sig))))
        ))
    )
    (
      HSpit
      [path data]
      (match
        (bcheck path st owns rem cons (clone tys) bcx ws)
        (BErr [msg] (BErr msg))
        (
          BOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (bcheck data st1 owns1 rem1 cons1 tys bcx ws)
            (BErr [msg] (BErr msg))
            (BOk [st2 owns2 rem2 cons2 c2] (BOk st2 owns2 rem2 cons2 (HSpit c1 c2))))
        ))
    )
    (
      HCall
      [name args]
      (match
        (b-kids args st owns (occ-bump rem name) cons tys bcx ws (HENil))
        (BKErr [msg] (BErr msg))
        (
          BKOk
          [st1 owns1 rem1 cons1 c1]
          (match
            (b-call-move name (clone c1) st1 owns1 rem1 cons1 tys bcx ws)
            (B4Err [msg] (BErr msg))
            (B4 [st2 owns2 rem2 cons2] (BOk st2 owns2 rem2 cons2 (HCall name c1))))
        ))
    ))) (defn b-ctor-move [args :- HExprs
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- &TyEnv
  bcx :- &BCtx
  ws :- &Watches
] :- B4
  (match args
    (HENil [] (B4 st owns rem cons))
    (
      HECons
      [kid next]
      (if
        (= (lower/h-tag kid) 3)
        (match
          (move-if-nc (lower/name-of kid) st owns rem cons tys bcx ws)
          (MncErr [msg] (B4Err msg))
          (MncRes [st2 owns2 rem2 cons2] (b-ctor-move next st2 owns2 rem2 cons2 tys bcx ws)))
        (b-ctor-move next st owns rem cons tys bcx ws))
    )))

; --- plan_drops: the per-defn wrapper ------------------------------------------------

; precompute the Shared-kind callees: builtins and externs never consume
(defn plist-has-borrowed [ps :- PList] :- bool
  (match ps
    (PNil [] false)
    (
      PCons
      [h t]
      (match h
        (
          Param
          [pname pty pb]
          (if
            (= pb 1)
            true
            (plist-has-borrowed t))
        ))
    )))

(defn b-shared-callees [defs :- &Defns acc :- Sids] :- Sids
  ; externs never consume; a defn with a borrowed (&) parameter never
  ; consumes either — its borrowed args stay with the caller (S8).
  ; The walk borrows: cloning the whole program per step made the
  ; self-compile quadratic.
  (match defs
    (DNil [] acc)
    (
      DCons
      [h t]
      ; one shallow destructure per defn: h is a binder of the borrowed
      ; walk, so the inner match consumes a clone of the box (the walk
      ; itself stays O(n))
      (match
        (clone h)
        (
          Defn
          [name params ret isextern body rb]
          (
            b-shared-callees
            t
            (if
              (or (= isextern 1) (plist-has-borrowed params))
              (SCons name acc)
              acc)
          )
        ))
    )))

(defn b-add-builtins [acc :- Sids] :- Sids
  (
    types/sids-append
    (
      types/sids-append
      (
        types/sids-append
        (
          types/sids-append
          (
            types/sids-append
            (types/sids-append (types/sids-append acc (expand/s-count)) (expand/s-evenq))
            (expand/s-printi64)
          )
          (expand/s-printf64)
        )
        (expand/s-getform)
      )
      (expand/s-clone)
    )
    (expand/s-dropform)
  ))

(deftype BPlan
  (BPlan [st :- IMap owns :- IMap e :- HExpr frees :- Sids])
  (BPlanErr [msg :- str]))

; --- borrowed-return preconditions ------------------------------------------

; the borrowed (pb != 0) parameter names of a defn
(defn b-borrowed-names [ps :- PList acc :- Sids] :- Sids
  (match ps
    (PNil [] acc)
    (
      PCons
      [h t]
      (match h
        (
          Param
          [pname pty pb]
          (
            b-borrowed-names
            t
            (if
              (= pb 1)
              (SCons pname acc)
              acc)
          )
        ))
    )))

; union src into dst
; is the callee's return a borrow? Mirrors the seed's tail_borrow_ok. The
; test is conservative: an unmodelled form returns false (reject).
(defn b-tail-borrow-ok [e :- &HExpr borrows :- &Sids dparams :- &DParams retb :- &RBTable] :- bool
  (match e
    (HVar [v] (types/sids-has borrows v))
    (
      HCall
      [name args]
      (if
        (= (alias/rb-get retb name) 1)
        (match
          (dparams-get dparams name)
          (DFound [ps] (b-tail-args-ok args ps borrows dparams retb))
          (DMissing [] false))
        false)
    )
    (HClone [x] false)
    (
      HIf
      [c t f ty]
      (and (b-tail-borrow-ok t borrows dparams retb) (b-tail-borrow-ok f borrows dparams retb))
    )
    (
      HMatch
      [scrut arms ty]
      (let [sc
        (if
          (match scrut
            (HVar [v] (types/sids-has borrows v))
            (_ false))
          1
          (if
            (b-tail-borrow-ok scrut borrows dparams retb)
            1
            0))]
        (b-tail-arms-ok arms borrows sc dparams retb))
    )
    (
      HLet
      [binds body frees]
      (b-tail-borrow-ok body (b-tail-let-fold binds borrows dparams retb) dparams retb)
    )
    (HSeq [es] (b-tail-seq-ok es borrows dparams retb))
    (_ false)))

(defn b-tail-args-ok [args :- &HExprs
  ps :- &PList
  borrows :- &Sids
  dparams :- &DParams
  retb :- &RBTable
] :- bool
  (match args
    (HENil [] true)
    (
      HECons
      [kid next]
      (match ps
        (PNil [] true)
        (
          PCons
          [h pt]
          (match h
            (
              Param
              [pname pty pb]
              (if
                (and (= pb 1) (not (b-tail-borrow-ok kid borrows dparams retb)))
                false
                (b-tail-args-ok next pt borrows dparams retb))
            ))
        ))
    )))

(defn b-tail-arms-ok [arms :- &HArms
  borrows :- &Sids
  sc :- i64
  dparams :- &DParams
  retb :- &RBTable
] :- bool
  (match arms
    (HANil [] true)
    (
      HACons
      [variant binders body ef next]
      (let [arb
        (if
          (= sc 1)
          (alias/sids-into binders (clone borrows))
          (clone borrows))]
        (if
          (b-tail-borrow-ok body arb dparams retb)
          (b-tail-arms-ok next borrows sc dparams retb)
          false))
    )))

(defn b-tail-let-fold [binds :- &Binds borrows :- &Sids dparams :- &DParams retb :- &RBTable] :- Sids
  (match binds
    (BNil [] (clone borrows))
    (
      BCons
      [name v ty next]
      (
        b-tail-let-fold
        next
        (if
          (b-tail-borrow-ok v borrows dparams retb)
          (SCons name (clone borrows))
          borrows)
        dparams
        retb
      )
    )))

(defn b-tail-seq-ok [es :- &HExprs borrows :- &Sids dparams :- &DParams retb :- &RBTable] :- bool
  (match es
    (HENil [] false)
    (
      HECons
      [kid next]
      (match next
        (HENil [] (b-tail-borrow-ok kid borrows dparams retb))
        (HECons [k2 n2] (b-tail-seq-ok next borrows dparams retb)))
    )))

; Owned move-type parameters whose buffer is still held at body exit get a
; scope-exit free (mirrors the seed's param_frees wrapper). A moved or
; returned param has already transferred its drop duty (owns=0, or escaped).
(defn fp-frees [params :- PList st :- &IMap owns :- &IMap facts :- &Facts esc :- &Sids] :- Sids
  (match params
    (PNil [] (SNil))
    (
      PCons
      [p rest]
      (match p
        (
          Param
          [pname pty pb]
          (if
            (
              and
              (= pb 0)
              (b-param-moves pty facts)
              (= (forms/im-get owns pname 0) 1)
              (= (forms/im-get st pname -1) 0)
              (not (types/sids-has esc pname))
            )
            (SCons pname (fp-frees rest st owns facts esc))
            (fp-frees rest st owns facts esc))
        ))
    )))

; A `&T` return is only a sound borrow for pointer-like values: a boxed
; (recursive/owning) ADT. The return index reads the template facts (the
; annotation names a template).
(defn b-borrowed-ret-boxed [ret :- &Ty facts :- &Facts] :- bool
  (if
    (= (types/ty-tag ret) 16)
    (= (forms/facts-boxed-at facts (types/ty-arg ret)) 1)
    false))

; plan_drops over one body: the pre-passes, the param states, the walk
(deftype BPlanRes (BPlanRes [bcx :- BCtx plan :- BPlan]))

; The plan plus the context it ran in. The program-wide tables (facts, the
; symbol table, shared names, the ADT table, per-callee parameter borrows,
; return-borrows) are computed once per program and never change during the
; pass, so they are threaded *through* the planner and handed back rather
; than copied per definition — the `dparams` map alone has one entry per
; definition, and every definition copied it twice.
(defn fp-frees-of [params :- PList st :- &IMap owns :- &IMap bcx :- &BCtx] :- Sids
  (match bcx
    (
      BCtx
      [esc _sh facts _tab _shared _lc _adts _dp _retb _nm _crb _rok _lseed]
      (fp-frees params st owns facts esc)
    )))

(defn b-plan [name :- i64
  params :- PList
  body :- HExpr
  ret :- Ty
  rb :- i64
  facts :- Facts
  tab :- i64
  shared :- Sids
  adts :- AdtTab
  dparams :- DParams
  retb :- RBTable
] :- BPlanRes
  ; Borrowed-return preconditions fire first so the reported error is the
  ; return-shape problem, not a downstream symptom.
  (let [bn (b-borrowed-names (clone params) (SNil))]
    (if
      (= rb 1)
      (if
        (not (b-borrowed-ret-boxed ret facts))
        (
          BPlanRes
          (b-plan-ctx facts tab shared adts dparams retb (SNil) rb)
          (BPlanErr "borrowed return: `&T` requires a boxed (recursive or owning) ADT return type")
        )
        (if
          (not (b-tail-borrow-ok body bn dparams retb))
          (
            BPlanRes
            (b-plan-ctx facts tab shared adts dparams retb (SNil) rb)
            (
              BPlanErr
              "Borrowed return requires a borrowed value. A `&T` function may only return a value derived from its `&` parameters, never an owned or freshly-cloned value."
            )
          )
          (b-plan-body name params body (b-plan-ctx facts tab shared adts dparams retb bn rb))))
      ; B8: the inverse discipline — a function whose return type *moves*
      ; may not return a value derived from a borrowed parameter (the
      ; caller binds the result as owned and frees it while the caller's
      ; original binding frees the same buffer).
      (if
        (
          and
          (not (types/sids-null bn))
          (types/is-non-copy-ty ret)
          (b-tail-borrow-ok body bn dparams retb)
        )
        (
          BPlanRes
          (b-plan-ctx facts tab shared adts dparams retb bn rb)
          (
            BPlanErr
            "a function returning a move type may not return a value derived from a `&` parameter: the caller would free a buffer the parameter's owner still frees. Mark the return `&T`, or clone the value before returning it."
          )
        )
        (b-plan-body name params body (b-plan-ctx facts tab shared adts dparams retb bn rb))))))

; The program-wide context for one defn's check: the borrowed parameter
; names and the return-borrow flag travel with it (the seed's no_move and
; ret_borrowed). The watch pair starts empty (-1, no binders) — no watch
; is active outside a match arm.
(defn b-plan-ctx [facts :- Facts
  tab :- i64
  shared :- Sids
  adts :- AdtTab
  dparams :- DParams
  retb :- RBTable
  nomove :- Sids
  curbrb :- i64
] :- BCtx
  (BCtx (SNil) (SNil) facts tab shared (SNil) adts dparams retb nomove curbrb -1 (SNil)))

(defn b-plan-body [name :- i64 params :- PList body :- HExpr bcx :- BCtx] :- BPlanRes
  ; `shared` (builtins, which never consume) and `dparams` (per-callee
  ; parameter borrows) are computed once per program by check-program —
  ; computing them per defn walked the whole Defns chain 1000+ times.
  (match bcx
    (
      BCtx
      [_esc0 _sh0 facts tab shared _lc0 adts dparams retb nomove curbrb _rok _lseed]
      (let [escaped (b-tail-escape body (SNil))
        rem0 (b-count-vars body (MNil))
        r (b-init-params (clone params) (clone facts) (MNil) (MNil) (MNil) (MNil) (TENil))]
        (match r
          (
            BLErr
            [msg]
            (
              BPlanRes
              (
                BCtx
                escaped
                (SNil)
                facts
                tab
                shared
                (SNil)
                adts
                dparams
                retb
                nomove
                curbrb
                -1
                (SNil)
              )
              (BPlanErr msg)
            )
          )
          (
            BLRes
            [st0 owns0 rem0 cons0 tys0 binds0]
            (let [bcx2
              (
                BCtx
                escaped
                (SNil)
                facts
                tab
                shared
                (SNil)
                adts
                dparams
                retb
                nomove
                curbrb
                -1
                (SNil)
              )]
              (match
                (bcheck body st0 owns0 rem0 cons0 tys0 bcx2 (WNil))
                (
                  BErr
                  [msg]
                  (
                    BPlanRes
                    bcx2
                    (BPlanErr (str (span/err-tags msg) "ownership check failed in " (forms/sym-str tab name) ": " (span/err-text msg)))
                  )
                )
                (
                  BOk
                  [st1 owns1 rem1 cons1 body2]
                  ; read through the context before it is handed back
                  (let [frees (fp-frees-of params st1 owns1 bcx2)]
                    (BPlanRes bcx2 (BPlan (clone st1) (clone owns1) body2 frees)))
                )))
          )))
    )))

(defn b-init-params [params :- PList
  facts :- Facts
  st :- IMap
  owns :- IMap
  rem :- IMap
  cons :- IMap
  tys :- TyEnv
] :- BLRes
  (match params
    (PNil [] (BLRes st owns rem cons tys (BNil)))
    (
      PCons
      [p rest]
      (match p
        (
          Param
          [pname pty pb]
          (
            b-init-params
            rest
            facts
            (forms/im-put st pname 0)
            (
              forms/im-put
              owns
              pname
              (if
                (and (= pb 0) (b-param-moves pty facts))
                1
                0)
            )
            rem
            cons
            (forms/te-put tys pname pty)
          )
        ))
    )))

; --- whole-program check: rewrite every plain defn and lambda ---------------

(deftype CkRes
  (CKOk [defs :- Defns lams :- Lams])
  (CKErr [msg :- str]))

(defn check-defns [ds :- Defns
  acc :- Defns
  facts :- Facts
  tab :- i64
  shared :- Sids
  adts :- AdtTab
  dparams :- DParams
  retb :- RBTable
] :- CkRes
  ; the whole-program state threads by move — a per-step clone of facts/
  ; tab/alldefs made the self-compile quadratic (S8)
  (match ds
    (DNil [] (CKOk acc (LMNil)))
    (
      DCons
      [h t]
      (match h
        (
          Defn
          [name params ret ie body rb]
          (if
            (= ie 1)
            (check-defns t (forms/defns-append acc h) facts tab shared adts dparams retb)
            (match
              (b-plan name (clone params) body (clone ret) rb facts tab shared adts dparams retb)
              (
                BPlanRes
                [bcx plan]
                (match bcx
                  (
                    BCtx
                    [_e _s facts2 tab2 shared2 _lc adts2 dp2 retb2 _nm2 _crb2 _rok _lseed]
                    (match plan
                      (BPlanErr [msg] (CKErr (span/err-in-fn msg name)))
                      (
                        BPlan
                        [st owns body2 frees]
                        (let [body3
                          (if
                            (types/sids-null frees)
                            body2
                            (HLet (BNil) body2 frees))]
                          (
                            check-defns
                            t
                            (
                              forms/defns-append
                              acc
                              (
                                Defn
                                name
                                params
                                (clone ret)
                                ie
                                body3
                                rb
                              )
                            )
                            facts2
                            tab2
                            shared2
                            adts2
                            dp2
                            retb2
                          ))
                      ))
                  ))
              )))
        ))
    )))

(deftype LkRes
  (LOkL [lams :- Lams])
  (LErrL [msg :- str]))

(defn check-lams [ls :- Lams
  acc :- Lams
  facts :- Facts
  tab :- i64
  shared :- Sids
  adts :- AdtTab
  dparams :- DParams
  retb :- RBTable
] :- LkRes
  (match ls
    (LMNil [] (LOkL acc))
    (
      LMCons
      [h t]
      (match h
        (
          Lam
          [mangled caps params ret body]
          (match
            (b-plan mangled (clone params) body (clone ret) 0 facts tab shared adts dparams retb)
            (
              BPlanRes
              [bcx plan]
              (match bcx
                (
                  BCtx
                  [_e _s facts2 tab2 shared2 _lc adts2 dp2 retb2 _nm2 _crb2 _rok _lseed]
                  (match plan
                    (BPlanErr [msg] (LErrL msg))
                    (
                      BPlan
                      [st owns body2 _frees]
                      (
                        check-lams
                        t
                        (
                          forms/lams-append
                          acc
                          (
                            Lam
                            mangled
                            caps
                            params
                            (clone ret)
                            body2
                          )
                        )
                        facts2
                        tab2
                        shared2
                        adts2
                        dp2
                        retb2
                      )
                    ))
                ))
            ))
        ))
    )))

(defn check-program [defs :- Defns lams :- Lams facts :- Facts tab :- i64 adts :- AdtTab] :- CkRes
  (let [shared
    (b-add-builtins (SNil))
    dparams
    (b-dparams defs (DPNil))
    retb
    (b-retb defs (b-alias-ret defs) (RBNil))
    ; the second stage re-reads the small program state: clone it
    ; before the first call moves it
    facts2
    (clone facts)
    tab2
    (clone tab)
    shared2
    (clone shared)
    adts2
    (clone adts)
    dparams2
    (clone dparams)
    retb2
    (clone retb)
  ]
    (match
      (check-defns defs (DNil) facts tab shared adts dparams retb)
      (CKErr [msg] (CKErr msg))
      (
        CKOk
        [defs2 lams0]
        (match
          (check-lams lams (LMNil) facts2 tab2 shared2 adts2 dparams2 retb2)
          (LErrL [msg] (CKErr msg))
          (LOkL [lams2] (CKOk defs2 lams2)))
      ))))
