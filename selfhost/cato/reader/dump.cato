; dump.cato — S5: the differential serialization.
;
; One line per top-level form — the byte-compare target the differential
; test reads:
;
;   node := "@" line ":" col "+" len tag      (line:col+len of the form)
;   tag  := "(sym " name ")" | "(int " i64 ")" | "(f64 " %g ")"
;         | "(bool " 0|1 ")" | "(str " esc ")" | "(nil)"
;         | "(list" node* ")" | "(vec" node* ")" | "(map" node* ")"
;         | "(set" node* ")"
;
; `esc` escapes backslash, quote, newline and tab so a form stays on one
; line; spaces inside string values print raw (the format is compared, not
; parsed). Symbol names render through the intern table the reader returns;
; the seed side has names only, so sids never cross the wire. Empty input
; produces empty output.

; Ownership shape: every non-Copy parameter is consumed exactly once — a
; function frees what it receives unless it moves it onward — so the table
; travels down as throwaway clones (one per node dump) and the originals
; stay with the caller's box, whose drop glue frees them. Match-bound heap
; fields are cloned out for the same reason.

; The `@line:col+len` prefix.
(defn spat [at :- Span] :- str
  (match at
    (Span [l c n] (str "@" l ":" c "+" n))))

; The span of an Ast node. Consuming (S8): the binders move out and the
; walked box leaks instead of freeing under the caller, so the span needs
; no clone; a caller that keeps the node passes a clone of it.
(defn ast-at [a :- Ast] :- Span
  (match a
    (ANil [at] at)
    (ASym [sid at] at)
    (AInt [v at] at)
    (AF64 [v at] at)
    (ABool [v at] at)
    (AStr [v at] at)
    (AList [kids at] at)
    (AVec [kids at] at)
    (AMap [kids at] at)
    (ASet [kids at] at)))

; Next byte that needs escaping (backslash, quote, newline, tab) or EOF.
(defn next-esc [s :- str i :- i64 n :- i64] :- i64
  (if (>= i n)
    n
    (let [c (nth s i 0)]
      (if (or (= c 92) (= c 34) (= c 10) (= c 9))
        i
        (next-esc s (+ i 1) n)))))

; Run-copying escape: whole stretch through `subs`, the four escapable
; bytes through literals, recurse. `\x` in the source below is the two
; characters backslash-x — the wire format, not a control byte.
(defn esc-str [s :- str i :- i64 n :- i64 acc :- str] :- str
  (if (>= i n)
    acc
    (let [c (nth s i 0)]
      (cond
        (= c 92) (esc-str s (+ i 1) n (str acc "\\\\"))
        (= c 34) (esc-str s (+ i 1) n (str acc "\\\""))
        (= c 10) (esc-str s (+ i 1) n (str acc "\\n"))
        (= c 9)  (esc-str s (+ i 1) n (str acc "\\t"))
        (let [j (next-esc s i n)]
          (esc-str s j n (str acc (subs s i j))))))))

(defn dump-kids [tab :- i64 ks :- Asts] :- str
  (match ks
    (KCons [kid rest]
      (str " " (dump-node (clone tab) (clone kid)) (dump-kids tab (clone rest))))
    (KNil [] "")))

; The node body — no position prefix. Inner nodes carry spans in the
; kernel AST, but the seed AST has none to compare against, so the wire
; pins positions at the top level only.
(defn dump-node [tab :- i64 a :- Ast] :- str
  (match a
    (ANil [at] "(nil)")
    (ASym [sid at] (str "(sym " (stab-get tab sid) ")"))
    (AInt [v at] (str "(int " v ")"))
    (AF64 [v at] (str "(f64 " v ")"))
    (ABool [v at] (str "(bool " v ")"))
    (AStr [v at] (str "(str " (esc-str v 0 (count v) "") ")"))
    (AList [ks at] (str "(list" (dump-kids tab (clone ks)) ")"))
    (AVec [ks at] (str "(vec" (dump-kids tab (clone ks)) ")"))
    (AMap [ks at] (str "(map" (dump-kids tab (clone ks)) ")"))
    (ASet [ks at] (str "(set" (dump-kids tab (clone ks)) ")"))))

; A top-level form: its span prefixes the node body.
(defn dump-top [tab :- i64 a :- Ast] :- str
  (str (spat (ast-at (clone a))) (dump-node tab a)))

; One output line per form, accumulated in the string builder and joined
; once by the driver. The table and the form chain are consumed; the
; accumulator moves through.
(defn dump-forms [tab :- i64 forms :- Asts acc :- StrBuf] :- StrBuf
  (match forms
    (KCons [f rest]
      (dump-forms tab (clone rest)
                  (sb-add-line acc (dump-top (clone tab) (clone f)))))
    (KNil [] acc)))
