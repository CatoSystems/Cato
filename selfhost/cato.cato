; sym.cato — S4: symbol interning.
;
; str -> i64 sid over an append-only table behind an opaque i64 handle.
; Cloning a compiler state is O(1) because the handle is an i64; the
; table itself lives in the runtime (cato_stab_*) and is shared across
; every snapshot. Sids are table indices; the runtime scan is linear
; from the top — kernel tables are small, and first-match-wins matches
; the reader's needs.

(extern cato-stab-new [] :- i64)
(extern cato-stab-count [h :- i64] :- i64)
(extern cato-stab-get [h :- i64 i :- i64] :- str)
(extern cato-stab-find [h :- i64 v :- str] :- i64)
(extern cato-stab-conj [h :- i64 v :- str] :- i64)
(extern cato-stab-add [h :- i64 v :- str] :- i64)

; Kernel-side wrappers over the runtime handle.
(defn stab-new [] :- i64 (cato-stab-new))

(defn stab-count [h :- i64] :- i64 (cato-stab-count h))

(defn stab-get [h :- i64 i :- i64] :- str (cato-stab-get h i))

(defn stab-find [h :- i64 v :- str] :- i64 (cato-stab-find h v))

(defn stab-conj [h :- i64 v :- str] :- i64 (cato-stab-conj h v))

(defn stab-add [h :- i64 v :- str] :- i64 (cato-stab-add h v))

(deftype Intern (I [tab :- i64 next :- i64]))

; Two results in one value: the updated state to keep threading and the
; sid the string resolved to.
(deftype IRes (IRes [st :- Intern sid :- i64]))

(defn intern-new [] :- Intern (I (stab-new) 0))

(defn intern-tab [st :- Intern] :- i64
  (match st
    (I [tab next] tab)))

(defn intern-count [st :- Intern] :- i64
  (match st
    (I [tab next] (stab-count tab))))

; Back-to-front scan; misses report -1.
(defn intern-find [tab :- i64 s :- str] :- i64
  (stab-find tab s))

(defn intern2 [st :- Intern s :- str] :- IRes
  (let [tab (intern-tab (clone st))
        sid (intern-find tab s)]
    (if (< sid 0)
      (IRes st (stab-conj tab s))
      (IRes st sid))))

; Str results are caller-freed, so return an owned copy of the element.
(defn sym-name [st :- Intern sid :- i64] :- str
  (match st
    (I [tab next] (stab-get tab sid))))

; IRes accessors: callers clone the result they still hold — a match
; consumes its scrutinee, so reading both fields means two clones.
(defn ires-st [r :- IRes] :- Intern
  (match r
    (IRes [st sid] st)))

(defn ires-sid [r :- IRes] :- i64
  (match r
    (IRes [st sid] sid)))
; strbuf.cato — S4: string builder.
;
; Emitter output and diagnostics accumulate pieces and join exactly once;
; string concatenation in a loop is quadratic and never appears in kernel
; code.
;
; The buffer is a persistent cons list: `sb-add` prepends in O(1) per
; piece (the S9 self-compile emits tens of thousands of lines through a
; threaded state, where the earlier copy-on-write vector re-strdup'd
; every accumulated line per append and made compilation quadratic).
; `sb-str` drains the list once through a loop whose accumulator is a
; `(Vector str)` loop variable — growable bindings conj in place with a
; doubling grow, so the drain is O(n) — and joins exactly once.

(deftype StrCell (SLNil) (SLCons [h :- str t :- StrCell]))
(deftype StrBuf (SB [parts :- StrCell n :- i64]))

(defn sb-new [] :- StrBuf (SB (SLNil) 0))

(defn sb-add [b :- StrBuf s :- str] :- StrBuf
  (match b
    (SB [parts n] (SB (SLCons s parts) (+ n 1)))))

(defn sb-add-line [b :- StrBuf s :- str] :- StrBuf
  (sb-add (sb-add b s) "\n"))

(defn sb-null [l :- &StrCell] :- bool
  (match l
    (SLNil [] true)
    (_ false)))

; `sb-add` prepends, so `parts` is newest-first; reverse it into add-order
; (O(n), one fresh cons per piece) before draining.
(defn sb-rev [l :- StrCell] :- StrCell
  (loop [a :- StrCell (SLNil) l2 :- StrCell l]
    (if (sb-null l2)
      a
      (match l2
        (SLCons [h t] (recur (SLCons h a) t))
        (_ a)))))

; Drain the list head-first into a growable vector. The accumulator is a
; loop variable of vector type, so every conj rides the loop's growable
; slot: in-place append under a doubling grow, O(n) over the walk.
(defn sb-str [b :- StrBuf] :- str
  (match b
    (SB [parts n]
      (let [v (loop [acc :- (Vector str) [] l :- StrCell (sb-rev parts) i :- i64 0]
                (if (or (>= i n) (sb-null l))
                  acc
                  (match l
                    (SLCons [h t] (recur (conj acc h) t (+ i 1)))
                    (_ acc))))]
        (join "" v)))))

(defn sb-count [b :- StrBuf] :- i64
  (match b
    (SB [parts n] n)))

(defn sb-len [b :- StrBuf] :- i64
  (match b
    (SB [parts n] (count (sb-str b)))))
; span.cato — S4: source positions.
;
; A Span is a value type (unboxed: i64 fields only, no heap). File
; identity is a future sid, not a field, until the interner and the
; reader meet in S5.

(deftype Span (Span [line :- i64 col :- i64 len :- i64]))

(defn sp-new [l :- i64 c :- i64 n :- i64] :- Span (Span l c n))

(defn sp-line [s :- Span] :- i64
  (match s
    (Span [l c n] l)))

(defn sp-col [s :- Span] :- i64
  (match s
    (Span [l c n] c)))

(defn sp-len [s :- Span] :- i64
  (match s
    (Span [l c n] n)))

(defn sp-str [s :- Span] :- str
  (match s
    (Span [l c n] (str l ":" c "+" n))))
; ast.cato — S4: the reader's target AST (recursive ADTs).
;
; Ast -> Asts mutual recursion makes every node heap-boxed with
; ownership-driven drop glue — the first real workout for the S1
; representation rules. Spans ride on every node as unboxed inline
; children.
;
; Child collections are a chain, not a (Vector Ast): the seed's field
; grammar allows vector elements over scalars and type parameters only,
; and the kernel subset must build with what it can express — the same
; reason environments are assoc-lists. The reader (S5) constructs children
; by persistent prepend, which is O(1) per node.
;
; A consequence worth keeping: `get items i default` cannot index children;
; passes walk them with match recursion, exactly the shape the kernel's own
; passes will use.

(deftype Asts (KNil) (KCons [kid :- Ast next :- Asts]))

; ABool is the S5 amendment: the seed reader reads `true`/`false` to
; LitBool (distinct from LitI64), so the kernel AST needs the variant. The
; payload is 0/1 — Span fields are i64 and so is every other Ast payload.
(deftype Ast
  (ANil [at :- Span])
  (ASym [sid :- i64 at :- Span])
  (AInt [v :- i64 at :- Span])
  (AF64 [v :- f64 at :- Span])
  (ABool [v :- i64 at :- Span])
  (AStr [v :- str at :- Span])
  (AList [kids :- Asts at :- Span])
  (AVec [kids :- Asts at :- Span])
  (AMap [kids :- Asts at :- Span])
  (ASet [kids :- Asts at :- Span]))

; A small discriminant for tests and generic pass logic.
(defn ast-tag [a :- &Ast] :- i64
  (match a
    (ANil [at] 0)
    (ASym [sid at] 1)
    (AInt [v at] 2)
    (AF64 [v at] 3)
    (ABool [v at] 9)
    (AStr [v at] 4)
    (AList [kids at] 5)
    (AVec [kids at] 6)
    (AMap [kids at] 7)
    (ASet [kids at] 8)))

; Constructors: spans fixed from line/col, width one.
(defn ast-nil [l :- i64 c :- i64] :- Ast (ANil (Span l c 1)))
(defn ast-sym [sid :- i64 l :- i64 c :- i64] :- Ast (ASym sid (Span l c 1)))
(defn ast-int [v :- i64 l :- i64 c :- i64] :- Ast (AInt v (Span l c 1)))
(defn ast-f64 [v :- f64 l :- i64 c :- i64] :- Ast (AF64 v (Span l c 1)))
(defn ast-bool [v :- i64 l :- i64 c :- i64] :- Ast (ABool v (Span l c 1)))
(defn ast-str [v :- str l :- i64 c :- i64] :- Ast (AStr v (Span l c 1)))

; Collection constructors take the child chain; `ast-cons` builds chains.
(defn ast-list [kids :- Asts l :- i64 c :- i64] :- Ast (AList kids (Span l c 1)))
(defn ast-vec [kids :- Asts l :- i64 c :- i64] :- Ast (AVec kids (Span l c 1)))
(defn ast-map [kids :- Asts l :- i64 c :- i64] :- Ast (AMap kids (Span l c 1)))
(defn ast-set [kids :- Asts l :- i64 c :- i64] :- Ast (ASet kids (Span l c 1)))

(defn ast-cons [kid :- Ast next :- Asts] :- Asts (KCons kid next))

; Node count over the tree: atoms count one, collections recurse.
(defn asts-count [ks :- &Asts] :- i64
  (match ks
    (KCons [kid next] (+ (ast-count kid) (asts-count next)))
    (KNil [] 0)))

(defn ast-count [a :- &Ast] :- i64
  (match a
    (ANil [at] 1)
    (ASym [sid at] 1)
    (AInt [v at] 1)
    (AF64 [v at] 1)
    (ABool [v at] 1)
    (AStr [v at] 1)
    (AList [kids at] (+ 1 (asts-count kids)))
    (AVec [kids at] (+ 1 (asts-count kids)))
    (AMap [kids at] (+ 1 (asts-count kids)))
    (ASet [kids at] (+ 1 (asts-count kids)))))

; Depth of the child chain (0 for atoms).
(defn asts-depth [ks :- &Asts] :- i64
  (match ks
    (KCons [kid next] (+ 1 (asts-depth next)))
    (KNil [] 0)))

; The first child of a chain, or the empty node. Chains have no O(1)
; index; passes walk them by match recursion.
; Consuming: the walked boxes leak (S8 ownership shape) instead of
; freeing under the caller, so no clone is needed to extract a node.
(defn asts-first [ks :- Asts] :- Ast
  (match ks
    (KCons [kid next] kid)
    (KNil [] (ast-nil 0 0))))

(defn ast-child-count [a :- &Ast] :- i64
  (match a
    (AList [kids at] (asts-depth kids))
    (AVec [kids at] (asts-depth kids))
    (AMap [kids at] (asts-depth kids))
    (ASet [kids at] (asts-depth kids))
    (ANil [at] 0)
    (ASym [sid at] 0)
    (AInt [v at] 0)
    (AF64 [v at] 0)
    (ABool [v at] 0)
    (AStr [v at] 0)))
; alist.cato — S4: sid-keyed environments.
;
; The kernel's scope tables map sid -> arbitrary value. Maps are i64->i64
; only, and a persistent linked list is the representation the kernel
; keeps, so environments are assoc-lists from day one. `al-put` extends;
; a later put for the same key shadows (first-match-wins reads), matching
; how lexical scopes nest.

(deftype (AList V) (ALNil) (ALCons [k :- i64 v :- V next :- (AList V)]))

(defn al-put [e :- (AList T) k :- i64 v :- T] :- (AList T)
  (ALCons k v e))

; First match wins; misses report the explicit default. `ev` moves out of
; the cell, so the recursive step clones the tail.
(defn al-get [e :- (AList T) k :- i64 d :- T] :- T
  (match e
    (ALCons [ek ev next]
      (if (= ek k)
        ev
        (al-get next k d)))
    (ALNil [] d)))

(defn al-has [e :- (AList T) k :- i64] :- bool
  (match e
    (ALCons [ek ev next] (if (= ek k) true (al-has next k)))
    (ALNil [] false)))

(defn al-depth [e :- (AList T)] :- i64
  (match e
    (ALCons [ek ev next] (+ 1 (al-depth next)))
    (ALNil [] 0)))
; result.cato — S4: error plumbing.
;
; The kernel's compile phases report failure as a value you match on, the
; same contract `Option` gives lookups — with a message attached. `Result`
; wraps the value-or-diagnostic; helpers cover the common reads.

(deftype (Result V) (Ok [v :- V]) (Err [msg :- str]))

; A match-bound field aliases the box, and the box's drop frees the
; field on function exit — results come back as clones.
(defn unwrap-or [r :- (Result T) d :- T] :- T
  (match r
    (Ok [v] v)
    (Err [msg] d)))

(defn is-ok [r :- (Result T)] :- bool
  (match r
    (Ok [v] true)
    (Err [msg] false)))

(defn err-msg [r :- (Result T)] :- str
  (match r
    (Ok [v] "")
    (Err [msg] msg)))
; read.cato — S5: the kernel reader.
;
; A port of crates/cato-core/src/reader.rs: one fused scan over the bytes,
; an explicit stack of open collections, no recursive descent. Semantics to
; mirror byte for byte: whitespace/comment skipping, delimiter kinds (a `}`
; closes a map or a set, nothing else crosses kinds), backslash-skipping
; string scan with the lenient unescape pass, and atom classification
; (parse-i64; true/false; f64 only when the token contains a dot; else
; symbol — `:when` is a symbol).
;
; Spans: the seed reader records byte offsets; the kernel AST carries
; (line, col, len) on every node. The scan tracks line/col as it consumes
; bytes — line starts at 1, col at 0, a newline resets col, every byte
; advances it. A node's span is its opening byte's position with
; len = hi - lo (collections include both delimiters, strings both quotes).
;
; Ownership shape: the heap state (stack of frames, children, intern table)
; rides in `loop` variables. Loop variables are never freed and never
; moved — S8 admits non-Copy loop variables for exactly this — so plain
; steps (whitespace, comments, delimiter opens, top-level pushes) clone
; nothing, and the state a recursive version would drop between events
; stays alive: persistent chains share their tails, so the cost is only
; the popped frames, not the data. The extraction law is paid where state
; actually changes shape: a close clones the enclosing children and stack
; out of the consumed frame, and a missed intern clones the table once for
; the conj.
;
; The scan is one `loop`, one lexical event per iteration — S8's revisit
; of the S5 tail-recursive state machine, which relied on call depth
; O(tokens) and could not read the kernel's own source.

; One open collection. kind: 0 list `(`, 1 vector `[`, 2 map `{`, 3 set
; `#{`. open/oline/ocol locate the opening delimiter; kids holds the
; children collected so far in reverse (prepend is O(1); close reverses
; once); next is the enclosing frame.
(deftype RStack
  (RSNil)
  (RSFrame [kind :- i64 open :- i64 oline :- i64 ocol :- i64 kids :- Asts
            next :- RStack]))

; Reader outcome: the top-level forms in source order with the intern
; table (sids are table indices), or the first error with its span.
(deftype RRes
  (ROk [forms :- Asts tab :- i64])
  (RErr [msg :- str at :- Span]))

(defn read-all [src :- str] :- RRes
  (scan src 0 1 0 0 1 0 (RSNil) (KNil) (stab-new)))

; ---------------------------------------------------------------------------
; byte access
; ---------------------------------------------------------------------------

; `(nth s i 0)` is bounds-checked, and a str's length is a strlen: paying
; one per byte makes any byte-at-a-time walk quadratic (the scan below
; strlens its own 500 KB source). Every walk here already carries the
; length and guards its index, so it reads through the length-free
; primitive instead. At i == n the terminator reads as 0, exactly the
; `(nth s i 0)` default; nothing here indexes further than that.
(extern cato-str-byte [s :- str i :- i64] :- i64)

(defn str-byte [s :- str i :- i64] :- i64
  (cato-str-byte s i))

; ---------------------------------------------------------------------------
; byte predicates (ASCII byte values)
; ---------------------------------------------------------------------------

(defn is-ws [c :- i64] :- bool
  (or (= c 32) (= c 9) (= c 10) (= c 13)))

(defn is-close [c :- i64] :- bool
  (or (= c 41) (= c 93) (= c 125)))

; A `}` closes a map or a set (`#{...}` carries its own kind but shares the
; closer); everything else must match its own opener, as in the seed.
(defn kind-accepts [kind :- i64 c :- i64] :- bool
  (if (= c 41)
    (= kind 0)
    (if (= c 93)
      (= kind 1)
      (if (= c 125)
        (or (= kind 2) (= kind 3))
        false))))

; ---------------------------------------------------------------------------
; scanning helpers (each returns an index; depth is the helper's own length)
; ---------------------------------------------------------------------------

; First byte at/after i that is not part of an atom: whitespace, a
; delimiter, `;` or `"`. EOF ends the token.
(defn tok-end [src :- str i :- i64 n :- i64] :- i64
  (if (>= i n)
    i
    (let [c (str-byte src i)]
      (if (or (is-ws c) (= c 40) (= c 41) (= c 91) (= c 93) (= c 123)
              (= c 125) (= c 59) (= c 34))
        i
        (tok-end src (+ i 1) n)))))

; End of a `;` comment: the newline itself (the whitespace step consumes
; it) or EOF.
(defn skip-line [src :- str i :- i64 n :- i64] :- i64
  (if (>= i n)
    i
    (if (= (str-byte src i) 10)
      i
      (skip-line src (+ i 1) n))))

; Closing quote of a string literal opened before j, skipping the byte
; after every backslash (so `\"` does not end the string). -1 if the run
; reaches EOF, matching the seed's "unterminated string".
(defn str-end [src :- str j :- i64 n :- i64] :- i64
  (if (>= j n)
    -1
    (let [c (str-byte src j)]
      (if (= c 34)
        j
        (if (= c 92)
          (str-end src (+ j 2) n)
          (str-end src (+ j 1) n))))))

; ---------------------------------------------------------------------------
; positions: (line, col) after consuming a byte range
; ---------------------------------------------------------------------------

(deftype LC (LC [line :- i64 col :- i64]))

(defn advance [src :- str i :- i64 end :- i64 line :- i64 col :- i64] :- LC
  (if (>= i end)
    (LC line col)
    (if (= (str-byte src i) 10)
      (advance src (+ i 1) end (+ 1 line) 0)
      (advance src (+ i 1) end line (+ 1 col)))))

; ---------------------------------------------------------------------------
; string unescaping — the seed's single left-to-right pass
; ---------------------------------------------------------------------------

; First byte at/after i that is a backslash (the unescape run boundary).
(defn next-bs [raw :- str i :- i64 n :- i64] :- i64
  (if (>= i n)
    n
    (if (= (str-byte raw i) 92)
      i
      (next-bs raw (+ i 1) n))))

; `\n` `\t` `\\` `\"` translate; any other `\x` keeps both bytes verbatim
; (lenient, as in the seed); a trailing lone `\` is kept. Runs between
; escapes copy with `subs`, so nothing builds strings byte by byte.
(defn unesc [raw :- str i :- i64 n :- i64 acc :- str] :- str
  (if (>= i n)
    acc
    (if (= (str-byte raw i) 92)
      (if (>= (+ i 1) n)
        (str acc "\\")
        (let [e (str-byte raw (+ i 1))]
          (if (= e 110)
            (unesc raw (+ i 2) n (str acc "\n"))
            (if (= e 116)
              (unesc raw (+ i 2) n (str acc "\t"))
              (if (= e 92)
                (unesc raw (+ i 2) n (str acc "\\"))
                (if (= e 34)
                  (unesc raw (+ i 2) n (str acc "\""))
                  (unesc raw (+ i 2) n (str acc (subs raw i (+ i 2))))))))))
      (let [stop (next-bs raw i n)]
        (unesc raw stop n (str acc (subs raw i stop)))))))

; ---------------------------------------------------------------------------
; the tree: children accumulate reversed; close reverses once
; ---------------------------------------------------------------------------

; Consuming reversal (S8): the walked boxes leak, so the binders move
; into the reversed chain directly — zero node copies, one fresh cons per
; element. The old deep-cloning version made every pass O(n x depth).
(defn asts-rev [ks :- Asts acc :- Asts] :- Asts
  (match ks
    (KCons [kid rest] (asts-rev rest (KCons kid acc)))
    (KNil [] acc)))

; ---------------------------------------------------------------------------
; atom classification (the seed's parse_atom order)
; ---------------------------------------------------------------------------

(defn has-dot [tok :- str i :- i64 n :- i64] :- bool
  (if (>= i n)
    false
    (if (= (str-byte tok i) 46)
      true
      (has-dot tok (+ i 1) n))))

; i64 wins (Rust from_str grammar, so `+5`/`-5` are ints and overflow is
; not); then true/false; then f64 only when the token contains a dot and
; parses; everything else — including `1.2.3`, `:when`, `nil` — is a
; symbol. sid is the interned name's table index (used by the symbol arm
; only). Parse results are let-bound before matching: the LLVM backend's
; match-over-ADT path reads a Var, not a raw call.
(defn atom-node [tok :- str sid :- i64 line :- i64 col :- i64 len :- i64] :- Ast
  (let [ni (parse-i64 tok)]
    (match ni
      (Some [v] (AInt v (Span line col len)))
      (None []
        (if (= tok "true")
          (ABool 1 (Span line col len))
          (if (= tok "false")
            (ABool 0 (Span line col len))
            (if (has-dot tok 0 (count tok))
              (let [nf (parse-f64 tok)]
                (match nf
                  (Some [v] (AF64 v (Span line col len)))
                  (None [] (ASym sid (Span line col len)))))
              (ASym sid (Span line col len)))))))))

; ---------------------------------------------------------------------------
; interning
; ---------------------------------------------------------------------------

; Back-to-front scan over the table; misses report -1. Reads elements
; through `get` (shared borrow) and threads the table by move, so the
; lookup clones nothing on its own.
(defn intern-sid [tab :- i64 s :- str] :- i64
  (stab-find tab s))

; ---------------------------------------------------------------------------
; the scan
; ---------------------------------------------------------------------------

; One lexical event per loop iteration. Copy state rides in loop variables
; (position, line/col, nesting depth, outermost-open line/col for the
; "unclosed delimiter" span); heap state (frames, children, intern table)
; rides in non-Copy loop variables, which the S8 slice treats as
; never-freed, never-moved values. Every helper call here returns a value
; (an index, a node, a classification) — no helper is on the scan's
; control path, so the loop is the only frame that persists across events.
(defn scan [src :- str i0 :- i64 line0 :- i64 col0 :- i64 depth0 :- i64
            bline0 :- i64 bcol0 :- i64 stack0 :- RStack kids0 :- Asts
            tab0 :- i64] :- RRes
  ; The source length rides as a loop variable: `count` on a str is a
  ; strlen, and re-strlens per event would make the whole scan quadratic.
  (loop [i :- i64 i0 line :- i64 line0 col :- i64 col0 depth :- i64 depth0
         bline :- i64 bline0 bcol :- i64 bcol0 stack :- RStack stack0
         kids :- Asts kids0 tab :- i64 tab0 n :- i64 (count src)]
    (if (>= i n)
      ; EOF: forms are the children accumulated at depth 0, reversed into
      ; source order; anything still open is the seed's "unclosed
      ; delimiter" at the outermost opening byte.
      (if (> depth 0)
        (RErr "unclosed delimiter" (Span bline bcol 1))
        (ROk (asts-rev kids (KNil)) tab))
      (let [c (str-byte src i)]
        (cond
          (is-ws c)
          (if (= c 10)
            (recur (+ i 1) (+ line 1) 0 depth bline bcol stack kids tab n)
            (recur (+ i 1) line (+ col 1) depth bline bcol stack kids tab n))

          (= c 59)
          (let [j (skip-line src i n)
                lcv (advance src i j line col)]
            (match lcv
              (LC [l2 c2]
                (recur j l2 c2 depth bline bcol stack kids tab n))))

          (or (= c 40) (= c 91) (= c 123))
          (let [kind (if (= c 40) 0 (if (= c 91) 1 2))
                lcv (advance src i (+ i 1) line col)]
            (match lcv
              (LC [l2 c2]
                (recur (+ i 1) l2 c2 (+ depth 1)
                       (if (= depth 0) line bline)
                       (if (= depth 0) col bcol)
                       (RSFrame kind i line col kids stack)
                       (KNil)
                       tab
                       n))))

          (if (= c 35) (= (str-byte src (+ i 1)) 123) false)
          (let [lcv (advance src i (+ i 2) line col)]
            (match lcv
              (LC [l2 c2]
                (recur (+ i 2) l2 c2 (+ depth 1)
                       (if (= depth 0) line bline)
                       (if (= depth 0) col bcol)
                       (RSFrame 3 i line col kids stack)
                       (KNil)
                       tab
                       n))))

          (is-close c)
          (match stack
            (RSNil []
              (RErr (str "unbalanced delimiter '" (char->str c) "'")
                    (Span line col 1)))
            (RSFrame [kind open oline ocol kidsF rest]
              (if (kind-accepts kind c)
                (if (and (= kind 2) (not (even? (asts-depth kids))))
                  (RErr "map literal must have key/value pairs"
                        (Span oline ocol (+ (- i open) 1)))
                  (let [k (asts-rev kids (KNil))
                        sp (Span oline ocol (+ (- i open) 1))
                        node (cond
                               (= kind 0) (AList k sp)
                               (= kind 1) (AVec k sp)
                               (= kind 2) (AMap k sp)
                               (ASet k sp))
                        lcv (advance src i (+ i 1) line col)]
                    (match lcv
                      (LC [l2 c2]
                        ; The frame binders alias the popped frame's box, but
                        ; that box lives in a never-freed loop variable — the
                        ; S8 loop discipline — so the loop carries the fields
                        ; out directly and the consumed frame simply leaks,
                        ; like every intermediate the loop abandons.
                        (recur (+ i 1) l2 c2 (- depth 1) bline bcol
                               rest (KCons node kidsF) tab
                               n)))))
                (RErr (str "unbalanced delimiter '" (char->str c) "'")
                      (Span line col 1)))))

          (= c 34)
          ; A string literal: find the closing quote, unescape the raw
          ; slice, store the value; the span includes both quotes.
          (let [j (str-end src (+ i 1) n)]
            (if (< j 0)
              (RErr "unterminated string" (Span line col (- n i)))
              (let [raw (subs src (+ i 1) j)
                    ; The accumulator seeds with a heap-empty string, not
                    ; the static `""` literal: an empty literal would flow
                    ; through untouched as static data.
                    val (unesc raw 0 (count raw) (subs raw 0 0))
                    lcv (advance src i (+ j 1) line col)]
                (match lcv
                  (LC [l2 c2]
                    (recur (+ j 1) l2 c2 depth bline bcol
                           stack (KCons (AStr val (Span line col (+ (- j i) 1))) kids)
                           tab
                           n))))))

          ; An atom token: slice it, classify, intern, push. The table is
          ; shared with the lookup (no clone per atom — loop variables are
          ; not consumed); a miss conj-appends a fresh copy.
          (let [e (tok-end src i n)
                tok (subs src i e)
                lcv (advance src i e line col)
                sid (let [s0 (intern-sid tab tok)] (if (< s0 0) (stab-conj tab tok) s0))
                node (atom-node tok sid line col (- e i))]
            (match lcv
              (LC [l2 c2]
                (recur e l2 c2 depth bline bcol stack (KCons node kids) tab
                       n)))))))))
; dump.cato — S5: the differential serialization.
;
; One line per top-level form — the byte-compare target the differential
; test reads:
;
;   node := "@" line ":" col "+" len tag      (line:col+len of the form)
;   tag  := "(sym " name ")" | "(int " i64 ")" | "(f64 " %g ")"
;         | "(bool " 0|1 ")" | "(str " esc ")" | "(nil)"
;         | "(list" node* ")" | "(vec" node* ")" | "(map" node* ")"
;         | "(set" node* ")"
;
; `esc` escapes backslash, quote, newline and tab so a form stays on one
; line; spaces inside string values print raw (the format is compared, not
; parsed). Symbol names render through the intern table the reader returns;
; the seed side has names only, so sids never cross the wire. Empty input
; produces empty output.

; Ownership shape: every non-Copy parameter is consumed exactly once — a
; function frees what it receives unless it moves it onward — so the table
; travels down as throwaway clones (one per node dump) and the originals
; stay with the caller's box, whose drop glue frees them. Match-bound heap
; fields are cloned out for the same reason.

; The `@line:col+len` prefix.
(defn spat [at :- Span] :- str
  (match at
    (Span [l c n] (str "@" l ":" c "+" n))))

; The span of an Ast node. Consuming (S8): the binders move out and the
; walked box leaks instead of freeing under the caller, so the span needs
; no clone; a caller that keeps the node passes a clone of it.
(defn ast-at [a :- Ast] :- Span
  (match a
    (ANil [at] at)
    (ASym [sid at] at)
    (AInt [v at] at)
    (AF64 [v at] at)
    (ABool [v at] at)
    (AStr [v at] at)
    (AList [kids at] at)
    (AVec [kids at] at)
    (AMap [kids at] at)
    (ASet [kids at] at)))

; Next byte that needs escaping (backslash, quote, newline, tab) or EOF.
(defn next-esc [s :- str i :- i64 n :- i64] :- i64
  (if (>= i n)
    n
    (let [c (nth s i 0)]
      (if (or (= c 92) (= c 34) (= c 10) (= c 9))
        i
        (next-esc s (+ i 1) n)))))

; Run-copying escape: whole stretch through `subs`, the four escapable
; bytes through literals, recurse. `\x` in the source below is the two
; characters backslash-x — the wire format, not a control byte.
(defn esc-str [s :- str i :- i64 n :- i64 acc :- str] :- str
  (if (>= i n)
    acc
    (let [c (nth s i 0)]
      (cond
        (= c 92) (esc-str s (+ i 1) n (str acc "\\\\"))
        (= c 34) (esc-str s (+ i 1) n (str acc "\\\""))
        (= c 10) (esc-str s (+ i 1) n (str acc "\\n"))
        (= c 9)  (esc-str s (+ i 1) n (str acc "\\t"))
        (let [j (next-esc s i n)]
          (esc-str s j n (str acc (subs s i j))))))))

(defn dump-kids [tab :- i64 ks :- Asts] :- str
  (match ks
    (KCons [kid rest]
      (str " " (dump-node (clone tab) kid) (dump-kids tab rest)))
    (KNil [] "")))

; The node body — no position prefix. Inner nodes carry spans in the
; kernel AST, but the seed AST has none to compare against, so the wire
; pins positions at the top level only.
(defn dump-node [tab :- i64 a :- Ast] :- str
  (match a
    (ANil [at] "(nil)")
    (ASym [sid at] (str "(sym " (stab-get tab sid) ")"))
    (AInt [v at] (str "(int " v ")"))
    (AF64 [v at] (str "(f64 " v ")"))
    (ABool [v at] (str "(bool " v ")"))
    (AStr [v at] (str "(str " (esc-str v 0 (count v) "") ")"))
    (AList [ks at] (str "(list" (dump-kids tab ks) ")"))
    (AVec [ks at] (str "(vec" (dump-kids tab ks) ")"))
    (AMap [ks at] (str "(map" (dump-kids tab ks) ")"))
    (ASet [ks at] (str "(set" (dump-kids tab ks) ")"))))

; A top-level form: its span prefixes the node body.
(defn dump-top [tab :- i64 a :- Ast] :- str
  (str (spat (ast-at (clone a))) (dump-node tab a)))

; One output line per form, accumulated in the string builder and joined
; once by the driver. The table and the form chain are consumed; the
; accumulator moves through.
(defn dump-forms [tab :- i64 forms :- Asts acc :- StrBuf] :- StrBuf
  (match forms
    (KCons [f rest]
      (dump-forms tab rest
                  (sb-add-line acc (dump-top (clone tab) f))))
    (KNil [] acc)))
; types.cato — S6: kernel types.
;
; A type is one flat word `(Ty tag a)` — unboxed, so types thread by copy
; and never clone. The tags mirror `hir::Ty`:
;
;   0 i64  1 i32  2 i8  3 i16  4 u8  5 u16  6 u32  7 u64  8 usize
;   9 f64 10 f32 11 bool 12 str 13 map 14 set
;   15 vec (a: element code — 0 i64, 1 f64, 2 str, 100+k param k)
;   16 adt (a: combined-table index)   17 fn (a: signature index)
;   18 param (a: index into a defn's ty_params)   19 none (absent sentinel)
;
; Type equality is tag+a equality. Element `a`-codes reuse the same
; numbering (0/1/2) so a `(Vector T)` parameter binds T = (Ty el 0).

(deftype Ty (Ty [tag :- i64 a :- i64]))
(deftype TyList (TyNil) (TyCons [h :- Ty t :- TyList]))

(defn t-none [] :- Ty (Ty 19 0))
(defn t-i64 [] :- Ty (Ty 0 0))
(defn t-i32 [] :- Ty (Ty 1 0))
(defn t-i8 [] :- Ty (Ty 2 0))
(defn t-i16 [] :- Ty (Ty 3 0))
(defn t-u8 [] :- Ty (Ty 4 0))
(defn t-u16 [] :- Ty (Ty 5 0))
(defn t-u32 [] :- Ty (Ty 6 0))
(defn t-u64 [] :- Ty (Ty 7 0))
(defn t-usize [] :- Ty (Ty 8 0))
(defn t-f64 [] :- Ty (Ty 9 0))
(defn t-f32 [] :- Ty (Ty 10 0))
(defn t-bool [] :- Ty (Ty 11 0))
(defn t-str [] :- Ty (Ty 12 0))
(defn t-map [] :- Ty (Ty 13 0))
(defn t-set [] :- Ty (Ty 14 0))
(defn t-vec [elc :- i64] :- Ty (Ty 15 elc))
(defn t-adt [i :- i64] :- Ty (Ty 16 i))
(defn t-fn [i :- i64] :- Ty (Ty 17 i))
(defn t-param [i :- i64] :- Ty (Ty 18 i))

(defn ty-eq [x :- Ty y :- Ty] :- bool
  (match x
    (Ty [xt xa]
      (match y
        (Ty [yt ya] (and (= xt yt) (= xa ya)))))))

(defn ty-tag [x :- &Ty] :- i64
  (match x (Ty [tag a] tag)))

(defn ty-arg [x :- &Ty] :- i64
  (match x (Ty [tag a] a)))

(defn is-int-ty [x :- Ty] :- bool
  (let [t (ty-tag x)]
    (< t 9)))

(defn is-uint-ty [x :- Ty] :- bool
  (let [t (ty-tag x)]
    (and (>= t 4) (< t 9))))

(defn is-float-ty [x :- Ty] :- bool
  (let [t (ty-tag x)]
    (or (= t 9) (= t 10))))

(defn is-numeric-ty [x :- Ty] :- bool
  (or (is-int-ty (clone x)) (is-float-ty x)))

; Copy semantics: everything but adt/vec/map/set/fn/param assigns by copy.
(defn is-copy-ty [x :- Ty] :- bool
  (let [t (ty-tag x)]
    (and (not (= t 15)) (not (= t 16)) (not (= t 13)) (not (= t 14))
         (not (= t 17)) (not (= t 18)))))

; Non-Copy in the move checker's sense (adt/vec/map/set/fn — param never
; survives to checking).
(defn is-non-copy-ty [x :- &Ty] :- bool
  (let [t (ty-tag x)]
    (or (= t 15) (= t 16) (= t 13) (= t 14) (= t 17))))

; The element type word of a vec type (0 i64 / 1 f64 / 2 str / 100+k param).
(defn vec-elem [x :- Ty] :- i64
  (ty-arg x))

; Elem word -> Ty (the scalar a vector element reads as); params are
; unresolved and stay words.
(defn elem-ty [el :- i64] :- Ty
  (if (= el 0) (t-i64)
    (if (= el 1) (t-f64)
      (if (= el 2) (t-str)
        (t-param (- el 100))))))

; --- suffixes (the seed's ty_suffix / ty_mangle) ----------------------------

; LLVM-safe suffix for an instantiation's type arguments; missing means
; "render as an ADT name" (the mangle fallback).
(defn ty-suffix [x :- Ty] :- str
  (let [t (ty-tag x)
        a (ty-arg x)]
    (cond
      (= t 0) "i64"
      (= t 1) "i32"
      (= t 2) "i8"
      (= t 3) "i16"
      (= t 4) "u8"
      (= t 5) "u16"
      (= t 6) "u32"
      (= t 7) "u64"
      (= t 8) "usize"
      (= t 9) "f64"
      (= t 10) "f32"
      (= t 11) "bool"
      (= t 12) "str"
      (and (= t 15) (= a 0)) "vec_i64"
      (and (= t 15) (= a 1)) "vec_f64"
      (and (= t 15) (= a 2)) "vec_str"
      "?")))

; --- type lists -------------------------------------------------------------

(defn tys-null [ks :- &TyList] :- bool
  (match ks
    (TyNil [] true)
    (TyCons [h t] false)))

(defn tys-depth [ks :- &TyList] :- i64
  (match ks
    (TyCons [h t] (+ 1 (tys-depth t)))
    (TyNil [] 0)))

(defn tys-rev [ks :- TyList acc :- TyList] :- TyList
  (match ks
    (TyCons [h t] (tys-rev t (TyCons h acc)))
    (TyNil [] acc)))

(defn tys-idx [ks :- TyList i :- i64] :- Ty
  (match ks
    (TyCons [h t] (if (= i 0) h (tys-idx t (- i 1))))
    (TyNil [] (t-none))))

(defn tys-append [ks :- TyList x :- Ty] :- TyList
  (match ks
    (TyNil [] (TyCons x (TyNil)))
    (TyCons [h t] (TyCons h (tys-append t x)))))

; Borrowed on both sides: this walk is a pure read, and cloning a cons
; clones its whole tail — passing owned lists made every signature-table
; probe (and every type-argument comparison) quadratic in list length.
(defn tys-eq [xs :- &TyList ys :- &TyList] :- bool
  (match xs
    (TyNil [] (tys-null ys))
    (TyCons [xh xt]
      (match ys
        (TyNil [] false)
        (TyCons [yh yt] (and (ty-eq xh yh) (tys-eq xt yt)))))))

; --- sids chains ------------------------------------------------------------

(deftype Sids (SNil) (SCons [h :- i64 t :- Sids]))

(defn sids-null [ks :- &Sids] :- bool
  (match ks
    (SNil [] true)
    (SCons [h t] false)))

(defn sids-depth [ks :- &Sids] :- i64
  (match ks
    (SCons [h t] (+ 1 (sids-depth t)))
    (SNil [] 0)))

(defn sids-rev [ks :- Sids acc :- Sids] :- Sids
  (match ks
    (SCons [h t] (sids-rev t (SCons h acc)))
    (SNil [] acc)))

(defn sids-idx [ks :- &Sids i :- i64] :- i64
  (match ks
    (SCons [h t] (if (= i 0) h (sids-idx t (- i 1))))
    (SNil [] -1)))

(defn sids-append [ks :- Sids x :- i64] :- Sids
  (match ks
    (SNil [] (SCons x (SNil)))
    (SCons [h t] (SCons h (sids-append t x)))))

(defn sids-has [ks :- &Sids x :- i64] :- bool
  (match ks
    (SCons [h t] (or (= h x) (sids-has t x)))
    (SNil [] false)))

(defn sids-drop [ks :- Sids n :- i64] :- Sids
  (if (= n 0)
    ks
    (match ks
      (SCons [h t] (sids-drop t (- n 1)))
      (SNil [] (SNil)))))

; The dump renders sid lists space-separated (used for binders/frees).
; expand.cato — S6: the kernel expander.
;
; A port of crates/cato-core/src/expand.rs over the S5 AST: bottom-up
; (children first, then the list head), the fixed macro set `->` `->>`
; `when` `when-not` `cond` `if-let` `when-let` `if-not` `and` `or`,
; matching the seed's desugaring — including `(and a b c)` folding
; right-associatively and `cond`'s odd trailing default. `doseq` is a
; seed-only macro (the subset contract excludes it) and fails here.
;
; Dispatch is by interned sid against the magic table: the driver seeds
; the reader's intern table with the names below in this order before
; reading the source, so a magic name's sid is exactly its index. Source
; symbols intern from index 85 on; the expander interns nothing.
;
; Synthesized nodes carry the macro form's span; expanded children keep
; theirs. Errors carry the raw seed message; expand-all attributes them
; to the enclosing top-level form's span, like `expand_all_located`.
;
; Ownership shape: chains and nodes are consumed by exactly one taker —
; a caller that retains a value passes a clone; matched-box fields are
; cloned out (the S4 extraction law); Copy payloads (sids, i64/f64,
; Span) move freely.

; --- magic sids (index into `magic-table`) ---------------------------------

(defn s-arrow [] :- i64 0)
(defn s-arrowr [] :- i64 1)
(defn s-when [] :- i64 2)
(defn s-whennot [] :- i64 3)
(defn s-cond [] :- i64 4)
(defn s-iflet [] :- i64 5)
(defn s-whenlet [] :- i64 6)
(defn s-ifnot [] :- i64 7)
(defn s-and [] :- i64 8)
(defn s-or [] :- i64 9)
(defn s-do [] :- i64 10)
(defn s-let [] :- i64 11)
(defn s-fn [] :- i64 12)
(defn s-if [] :- i64 13)
(defn s-notform [] :- i64 14)
(defn s-eq [] :- i64 15)
(defn s-ne [] :- i64 16)
(defn s-lt [] :- i64 17)
(defn s-gt [] :- i64 18)
(defn s-le [] :- i64 19)
(defn s-ge [] :- i64 20)
(defn s-add [] :- i64 21)
(defn s-sub [] :- i64 22)
(defn s-mul [] :- i64 23)
(defn s-div [] :- i64 24)
(defn s-abs [] :- i64 25)
(defn s-min [] :- i64 26)
(defn s-max [] :- i64 27)
(defn s-match [] :- i64 28)
(defn s-loop [] :- i64 29)
(defn s-recur [] :- i64 30)
(defn s-getform [] :- i64 31)
(defn s-conjform [] :- i64 32)
(defn s-count [] :- i64 33)
(defn s-strform [] :- i64 34)
(defn s-subs [] :- i64 35)
(defn s-split [] :- i64 36)
(defn s-join [] :- i64 37)
(defn s-nth [] :- i64 38)
(defn s-charstr [] :- i64 39)
(defn s-clone [] :- i64 40)
(defn s-dropform [] :- i64 41)
(defn s-parsei64 [] :- i64 42)
(defn s-parsef64 [] :- i64 43)
(defn s-veci64 [] :- i64 44)
(defn s-vecf64 [] :- i64 45)
(defn s-slurp [] :- i64 46)
(defn s-spit [] :- i64 47)
(defn s-args [] :- i64 48)
(defn s-exit [] :- i64 49)
(defn s-printstr [] :- i64 50)
(defn s-printstring [] :- i64 51)
(defn s-printf64 [] :- i64 52)
(defn s-printi64 [] :- i64 53)
(defn s-evenq [] :- i64 54)
(defn s-doseq [] :- i64 55)
(defn s-reduce [] :- i64 56)
(defn s-for [] :- i64 57)
(defn s-parallel [] :- i64 58)
(defn s-map [] :- i64 59)
(defn s-filter [] :- i64 60)
(defn s-defn [] :- i64 61)
(defn s-extern [] :- i64 62)
(defn s-deftype [] :- i64 63)
(defn s-defgeneric [] :- i64 64)
(defn s-defmethod [] :- i64 65)
(defn s-ns [] :- i64 66)
(defn s-require [] :- i64 67)
(defn s-sep [] :- i64 68)
(defn s-wild [] :- i64 69)
(defn s-whenkw [] :- i64 70)
(defn s-binder [] :- i64 71)
(defn s-nil [] :- i64 72)
(defn s-fnty [] :- i64 73)
(defn s-vec [] :- i64 74)
(defn s-f64 [] :- i64 75)
(defn s-f32 [] :- i64 76)
(defn s-i8 [] :- i64 77)
(defn s-i16 [] :- i64 78)
(defn s-i32 [] :- i64 79)
(defn s-u8 [] :- i64 80)
(defn s-u16 [] :- i64 81)
(defn s-u32 [] :- i64 82)
(defn s-u64 [] :- i64 83)
(defn s-usize [] :- i64 84)
(defn s-option [] :- i64 85)
(defn s-some [] :- i64 86)
(defn s-nonevar [] :- i64 87)
(defn s-aparam [] :- i64 88)
(defn s-i64 [] :- i64 89)

; The driver seeds the reader's intern table with these names, in this
; order, before reading the source. `conj` typechecks only on a
; table-typed variable (never on the literal), so the chain appends
; through an annotated helper — the same bootstrap as the reader's `[]`
; seed tab.
(defn mt-add [acc :- i64 s :- str] :- i64
  (stab-add acc s))

(defn magic-table [] :- i64 (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add (mt-add
   (mt-add
   (mt-add (mt-add (mt-add (mt-add (mt-add (stab-new) "->") "->>") "when") "when-not") "cond")
   "if-let") "when-let") "if-not") "and") "or") "do") "let") "fn") "if") "not") "=") "/=")
   "<") ">") "<=") ">=") "+") "-") "*") "/") "abs") "min") "max") "match") "loop") "recur")
   "get") "conj") "count") "str") "subs") "split") "join") "nth") "char->str") "clone")
   "drop") "parse-i64") "parse-f64") "vec-i64") "vec-f64") "slurp") "spit") "args") "exit")
   "print-str") "print-string") "print-f64") "print-i64") "even?") "doseq") "reduce")
   "for") "parallel") "map") "filter") "defn") "extern") "deftype") "defgeneric")
   "defmethod") "ns") "require") ":-") "_") ":when") "$b") "nil") "Fn") "Vector") "f64")
   "f32") "i8") "i16") "i32") "u8") "u16") "u32") "u64") "usize") "Option") "Some") "None")
   "a") "i64")
  )

; --- outcomes --------------------------------------------------------------

(deftype ERes (EOk [forms :- Asts]) (EErr [msg :- str at :- Span]))
(deftype ERes1 (EOk1 [a :- Ast]) (EErr1 [msg :- str at :- Span]))
(deftype EResk (EOkk [ks :- Asts]) (EErrk [msg :- str at :- Span]))

; --- chain helpers ---------------------------------------------------------

(defn asts-null [ks :- &Asts] :- bool
  (match ks
    (KNil [] true)
    (KCons [kid rest] false)))

(defn asts-tail [ks :- Asts] :- Asts
  (match ks
    (KCons [kid rest] rest)
    (KNil [] (KNil))))

(defn asts-drop [ks :- Asts n :- i64] :- Asts
  (if (= n 0)
    ks
    (match ks
      (KCons [kid rest] (asts-drop rest (- n 1)))
      (KNil [] (KNil)))))

(defn asts-idx [ks :- Asts i :- i64] :- Ast
  (match ks
    (KCons [kid rest]
      (if (= i 0) kid (asts-idx rest (- i 1))))
    (KNil [] (ANil (Span 0 0 0)))))

(defn asts-last [ks :- Asts] :- Ast
  (match ks
    (KCons [kid rest]
      (if (asts-null rest) kid (asts-last rest)))
    (KNil [] (ANil (Span 0 0 0)))))

(defn asts-append [ks :- Asts x :- Ast] :- Asts
  (match ks
    (KNil [] (KCons x (KNil)))
    (KCons [kid rest] (KCons kid (asts-append rest x)))))

; The head symbol's sid, or -1 when the head is not a symbol.
(defn ast-sid-of [a :- &Ast] :- i64
  (match a
    (ANil [at] -1)
    (ASym [sid at] sid)
    (AInt [v at] -1)
    (AF64 [v at] -1)
    (ABool [v at] -1)
    (AStr [v at] -1)
    (AList [ks at] -1)
    (AVec [ks at] -1)
    (AMap [ks at] -1)
    (ASet [ks at] -1)))

(defn asts-head-sid [ks :- &Asts] :- i64
  (match ks
    (KCons [kid rest] (ast-sid-of kid))
    (KNil [] -1)))

; The child chain of a node; atoms have none.
(defn ast-kids-of [a :- Ast] :- Asts
  (match a
    (ANil [at] (KNil))
    (ASym [sid at] (KNil))
    (AInt [v at] (KNil))
    (AF64 [v at] (KNil))
    (ABool [v at] (KNil))
    (AStr [v at] (KNil))
    (AList [ks at] ks)
    (AVec [ks at] ks)
    (AMap [ks at] ks)
    (ASet [ks at] ks)))

; All but the last child (cond's odd trailing default peels off here) —
 ; one spine walk, the boxes moved into the fresh conses.
(defn asts-init [ks :- Asts] :- Asts
  (match ks
    (KCons [kid rest]
      (if (asts-null rest)
        (KNil)
        (KCons kid (asts-init rest))))
    (KNil [] (KNil))))

; --- the walk --------------------------------------------------------------

(defn expand-all [forms :- Asts acc :- Asts] :- ERes
  ; The match consumes `forms`, so the tail binder moves into the
  ; recursion directly — a `(clone rest)` here deep-copies the whole
  ; remaining chain per form and makes self-compilation quadratic (S8).
  (match forms
    (KCons [f rest]
      (let [sp (ast-at (clone f))
            r (expand-form f)]
        (match r
          (EOk1 [a] (expand-all rest (KCons a acc)))
          (EErr1 [msg at] (EErr msg sp)))))
    (KNil [] (EOk (asts-rev acc (KNil))))))

(defn expand-kids [ks :- Asts acc :- Asts] :- EResk
  (match ks
    (KCons [kid rest]
      (let [r (expand-form kid)]
        (match r
          (EOk1 [a] (expand-kids rest (KCons a acc)))
          (EErr1 [msg at] (EErrk msg at)))))
    (KNil [] (EOkk (asts-rev acc (KNil))))))

(defn expand-form [a :- Ast] :- ERes1
  (match a
    (AList [kids at]
      (let [rk (expand-kids kids (KNil))]
        (match rk
          (EOkk [ks] (expand-list (AList ks at)))
          (EErrk [msg at2] (EErr1 msg at2)))))
    (AVec [kids at]
      (let [rk (expand-kids kids (KNil))]
        (match rk
          (EOkk [ks] (EOk1 (AVec ks at)))
          (EErrk [msg at2] (EErr1 msg at2)))))
    (AMap [kids at]
      (let [rk (expand-kids kids (KNil))]
        (match rk
          (EOkk [ks] (EOk1 (AMap ks at)))
          (EErrk [msg at2] (EErr1 msg at2)))))
    (ANil [at] (EOk1 (ANil at)))
    (ASym [sid at] (EOk1 (ASym sid at)))
    (AInt [v at] (EOk1 (AInt v at)))
    (AF64 [v at] (EOk1 (AF64 v at)))
    (ABool [v at] (EOk1 (ABool v at)))
    (AStr [v at] (EOk1 (AStr v at)))
    (ASet [kids at] (EOk1 (ASet kids at)))))


; Dispatch on the (already expanded) list head. Threading wins first, as
; in the seed. The span travels as its (line, col, len) primitives — Span
; itself is an ADT, so a synthesized node mints a fresh value per field.
(defn expand-list [a :- Ast] :- ERes1
  (match a
    (AList [kids at]
      (let [h (asts-head-sid kids)
            al (sp-line at)
            ac (sp-col at)
            an (sp-len at)]
        (cond
          (= h (s-arrow))
          (expand-thread (asts-tail kids) 0 al ac an)

          (= h (s-arrowr))
          (expand-thread (asts-tail kids) 1 al ac an)

          (= h (s-when))
          (expand-when kids al ac an)

          (= h (s-whennot))
          (expand-whennot kids al ac an)

          (= h (s-cond))
          (expand-cond kids al ac an)

          (= h (s-iflet))
          (expand-iflet kids al ac an)

          (= h (s-whenlet))
          (expand-whenlet kids al ac an)

          (= h (s-ifnot))
          (expand-ifnot kids al ac an)

          (= h (s-doseq))
          (EErr1 "unsupported macro doseq" (Span al ac an))

          (= h (s-and))
          (expand-andor kids al ac an (s-and) "and")

          (= h (s-or))
          (expand-andor kids al ac an (s-or) "or")

          (EOk1 (AList kids at)))))
    (ANil [at] (EOk1 (ANil at)))
    (ASym [sid at] (EOk1 (ASym sid at)))
    (AInt [v at] (EOk1 (AInt v at)))
    (AF64 [v at] (EOk1 (AF64 v at)))
    (ABool [v at] (EOk1 (ABool v at)))
    (AStr [v at] (EOk1 (AStr v at)))
    (AVec [kids at] (EOk1 (AVec kids at)))
    (AMap [kids at] (EOk1 (AMap kids at)))
    (ASet [kids at] (EOk1 (ASet kids at)))))

; --- node builders ---------------------------------------------------------

; (do body...) — a list whose head is the `do` symbol.
(defn do-form [body :- Asts sl :- i64 sc :- i64 sn :- i64] :- Ast
  (AList (KCons (ASym (s-do) (Span sl sc sn)) body) (Span sl sc sn)))

; (h a b c) — the 4-node list the branch desugarings emit.
(defn list4 [h :- i64 a :- Ast b :- Ast c :- Ast sl :- i64 sc :- i64 sn :- i64] :- Ast
  (AList (KCons (ASym h (Span sl sc sn))
          (KCons a (KCons b (KCons c (KNil)))))
         (Span sl sc sn)))

; (let [x e] body) — the one synthesized binding form.
(defn let-1 [x :- Ast e :- Ast body :- Ast sl :- i64 sc :- i64 sn :- i64] :- Ast
  (AList (KCons (ASym (s-let) (Span sl sc sn))
          (KCons (AVec (KCons x (KCons e (KNil))) (Span sl sc sn))
          (KCons body (KNil))))
         (Span sl sc sn)))

; --- threading -------------------------------------------------------------

(defn expand-thread [steps :- Asts lastb :- i64 sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (match steps
    (KNil [] (EErr1 "threading macro expects at least one step" (Span sl sc sn)))
    (KCons [first rest] (thread-loop rest first lastb sl sc sn))))

(defn thread-loop [steps :- Asts acc :- Ast lastb :- i64 sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (match steps
    (KNil [] (EOk1 acc))
    (KCons [step rest]
      (match (apply-step acc step lastb sl sc sn)
        (EOk1 [a2] (thread-loop rest a2 lastb sl sc sn))
        (EErr1 [msg at2] (EErr1 msg at2))))))

; A step is a list (insert the previous result at position 1, or append
; for `->>`) or a bare symbol (become a call on it).
(defn apply-step [prev :- Ast step :- Ast lastb :- i64 sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (match step
    (AList [kids sat]
      (if (= lastb 0)
        (EOk1 (AList (insert-at-1 kids prev) sat))
        (EOk1 (AList (asts-append kids prev) sat))))
    (ASym [sid sat]
      (EOk1 (AList (KCons (ASym sid sat) (KCons prev (KNil))) sat)))
    (ANil [sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))
    (AInt [v sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))
    (AF64 [v sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))
    (ABool [v sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))
    (AStr [v sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))
    (AVec [ks sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))
    (AMap [ks sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))
    (ASet [ks sat] (EErr1 "threading step must be a list or symbol" (Span sl sc sn)))))

(defn insert-at-1 [kids :- Asts prev :- Ast] :- Asts
  (match kids
    (KCons [head rest] (KCons head (KCons prev rest)))
    (KNil [] (KCons prev (KNil)))))

; --- branching -------------------------------------------------------------

(defn expand-when [kids :- Asts sl :- i64 sc :- i64 sn :- i64] :- ERes1
  ; The depth query borrows; the match then consumes the chain and the
  ; binders move into the desugaring — no idx/drop clones (S8).
  (if (< (asts-depth kids) 3)
    (EErr1 "when expects (when <cond> <body>...)" (Span sl sc sn))
    (match kids
      (KCons [_h r1]
        (match r1
          (KCons [c body]
            (let [doform (do-form body sl sc sn)]
              (EOk1 (list4 (s-if) c doform (AInt 0 (Span sl sc sn)) sl sc sn))))
          (KNil [] (EErr1 "when expects (when <cond> <body>...)" (Span sl sc sn)))))
      (KNil [] (EErr1 "when expects (when <cond> <body>...)" (Span sl sc sn))))))

(defn expand-whennot [kids :- Asts sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (if (< (asts-depth kids) 3)
    (EErr1 "when-not expects (when-not <cond> <body>...)" (Span sl sc sn))
    (match kids
      (KCons [_h r1]
        (match r1
          (KCons [c body]
            (let [doform (do-form body sl sc sn)]
              (EOk1 (list4 (s-if) c (AInt 0 (Span sl sc sn)) doform sl sc sn))))
          (KNil [] (EErr1 "when-not expects (when-not <cond> <body>...)" (Span sl sc sn)))))
      (KNil [] (EErr1 "when-not expects (when-not <cond> <body>...)" (Span sl sc sn))))))

(defn expand-cond [kids :- Asts sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (match kids
    (KCons [_h arms] (cond-nest arms sl sc sn))
    (KNil [] (EErr1 "cond expects at least one test/body pair" (Span sl sc sn)))))

; The last element split off in one spine walk (the odd-trailing-default
 ; case needs both halves; two consuming passes cannot share one chain).
(deftype LastSplit (LSplit [init :- Asts last :- Ast]))

(defn asts-split-last [ks :- Asts] :- LastSplit
  (match ks
    (KCons [kid rest]
      (if (asts-null rest)
        (LSplit (KNil) kid)
        (match (asts-split-last rest)
          (LSplit [init last] (LSplit (KCons kid init) last)))))
    (KNil [] (LSplit (KNil) (ANil (Span 0 0 0))))))

(defn cond-nest [arms :- Asts sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (if (asts-null arms)
    (EErr1 "cond expects at least one test/body pair" (Span sl sc sn))
    (if (even? (asts-depth arms))
    (cond-fold (asts-rev arms (KNil)) (AInt 0 (Span sl sc sn)) sl sc sn)
    (match (asts-split-last arms)
      (LSplit [pairs dflt]
        (cond-fold (asts-rev pairs (KNil)) dflt sl sc sn))))))

; Fold the reversed pairs two at a time: each step wraps the accumulator
; in (if test body acc).
(defn cond-fold [rev :- Asts acc :- Ast sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (match rev
    (KCons [b rest]
      (match rest
        (KCons [c rest2]
          (cond-fold rest2
                     (AList (KCons (ASym (s-if) (Span sl sc sn))
                             (KCons c (KCons b (KCons acc (KNil)))))
                            (Span sl sc sn))
                     sl sc sn))
        (KNil [] (EOk1 acc))))
    (KNil [] (EOk1 acc))))

; --- binding forms ---------------------------------------------------------

; A 2-element vector binding [x e]; (x, e) clone out, or the error. The
; message is the caller's (`if-let`/`when-let` word their own).
(deftype Bind2 (B2 [x :- Ast e :- Ast]) (B2Err [msg :- str]))

(defn bind2-of [b :- Ast msg :- str] :- Bind2
  (match b
    (AVec [ks sp]
      (if (= (asts-depth ks) 2)
        (match ks
          (KCons [x r1]
            (match r1
              (KCons [e _r2] (B2 x e))
              (KNil [] (B2Err msg))))
          (KNil [] (B2Err msg)))
        (B2Err msg)))
    (ANil [sp] (B2Err msg))
    (ASym [sid sp] (B2Err msg))
    (AInt [v sp] (B2Err msg))
    (AF64 [v sp] (B2Err msg))
    (ABool [v sp] (B2Err msg))
    (AStr [v sp] (B2Err msg))
    (AList [ks sp] (B2Err msg))
    (AMap [ks sp] (B2Err msg))
    (ASet [ks sp] (B2Err msg))))

(defn expand-iflet [kids :- Asts sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (let [n (asts-depth kids)]
    (if (and (not (= n 4)) (not (= n 5)))
      (EErr1 "if-let expects (if-let [x e] <then> [<else>])" (Span sl sc sn))
      (match kids
        (KCons [_h r1]
          (match r1
            (KCons [b rest2]
              (match (bind2-of b "if-let binding must be a 2-element vector [x e]")
                (B2 [x e]
                  (match rest2
                    (KCons [then rest3]
                      (let [els (if (= n 4)
                                  (match rest3
                                    (KCons [e3 _r4] e3)
                                    (KNil [] (AInt 0 (Span sl sc sn))))
                                  (AInt 0 (Span sl sc sn)))]
                        ; x binds twice: one clone, one move.
                        (EOk1 (let-1 (clone x) e
                                     (AList (KCons (ASym (s-if) (Span sl sc sn))
                                             (KCons x (KCons then (KCons els (KNil)))))
                                            (Span sl sc sn))
                                     sl sc sn))))
                    (KNil [] (EErr1 "if-let expects (if-let [x e] <then> [<else>])" (Span sl sc sn)))))
                (B2Err [msg] (EErr1 msg (Span sl sc sn)))))
          (KNil [] (EErr1 "if-let expects (if-let [x e] <then> [<else>])" (Span sl sc sn)))))
        (KNil [] (EErr1 "if-let expects (if-let [x e] <then> [<else>])" (Span sl sc sn)))))))

(defn expand-whenlet [kids :- Asts sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (if (< (asts-depth kids) 3)
    (EErr1 "when-let expects (when-let [x e] <body>...)" (Span sl sc sn))
    (match kids
      (KCons [_h r1]
        (match r1
          (KCons [b body]
            (match (bind2-of b "when-let binding must be a 2-element vector [x e]")
              (B2 [x e]
                (let [doform (do-form body sl sc sn)]
                  (EOk1 (let-1 (clone x) e
                               (AList (KCons (ASym (s-if) (Span sl sc sn))
                                       (KCons x (KCons doform (KCons (AInt 0 (Span sl sc sn)) (KNil)))))
                                      (Span sl sc sn))
                               sl sc sn))))
              (B2Err [msg] (EErr1 msg (Span sl sc sn)))))
        (KNil [] (EErr1 "when-let expects (when-let [x e] <body>...)" (Span sl sc sn)))))
      (KNil [] (EErr1 "when-let expects (when-let [x e] <body>...)" (Span sl sc sn))))))

(defn expand-ifnot [kids :- Asts sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (if (not (= (asts-depth kids) 4))
    (EErr1 "if-not expects (if-not <cond> <then> <else>)" (Span sl sc sn))
    (match kids
      (KCons [_h r1]
        (match r1
          (KCons [c r2]
            (match r2
              (KCons [t r3]
                (match r3
                  (KCons [e _r4]
                    (EOk1 (AList (KCons (ASym (s-if) (Span sl sc sn))
                                  (KCons c (KCons e (KCons t (KNil)))))
                                 (Span sl sc sn))))
                  (KNil [] (EErr1 "if-not expects (if-not <cond> <then> <else>)" (Span sl sc sn)))))
              (KNil [] (EErr1 "if-not expects (if-not <cond> <then> <else>)" (Span sl sc sn)))))
          (KNil [] (EErr1 "if-not expects (if-not <cond> <then> <else>)" (Span sl sc sn)))))
      (KNil [] (EErr1 "if-not expects (if-not <cond> <then> <else>)" (Span sl sc sn))))))

; --- variadic booleans ------------------------------------------------------

(defn expand-andor [kids :- Asts sl :- i64 sc :- i64 sn :- i64 op :- i64 name :- str] :- ERes1
  (match kids
    (KNil [] (EErr1 (str name " expects at least one operand") (Span sl sc sn)))
    (KCons [_h args]
      (match args
        (KNil [] (EErr1 (str name " expects at least one operand") (Span sl sc sn)))
        (KCons [first rest]
          (if (asts-null rest)
            (EOk1 first)
            (andor-fold (asts-rev (KCons first rest) (KNil))
                        op sl sc sn)))))))

; The reversed operand chain folds right-associatively: acc starts at the
; last operand, each earlier operand wraps it in (op operand acc).
(defn andor-fold [rev :- Asts op :- i64 sl :- i64 sc :- i64 sn :- i64] :- ERes1
  (match rev
    (KCons [first rest] (EOk1 (andor-fold-2 rest first op sl sc sn)))
    (KNil [] (EOk1 (AInt 0 (Span sl sc sn))))))

(defn andor-fold-2 [rest :- Asts acc :- Ast op :- i64 sl :- i64 sc :- i64 sn :- i64] :- Ast
  (match rest
    (KNil [] acc)
    (KCons [a rest2]
      (andor-fold-2 rest2
                    (AList (KCons (ASym op (Span sl sc sn))
                             (KCons a (KCons acc (KNil))))
                           (Span sl sc sn))
                    op sl sc sn))))
; forms.cato — S6: top-level forms — tables, defn/extern/deftype parsing,
; representation facts.
;
; A port of `hir/parse.rs` + the table shapes of `hir/build.rs`: pass 0a
; collects deftype headers (field types may reference any template,
; regardless of order), pass 0b parses variants, pass 1 parses
; defn/extern headers — registering `Fn` signatures and instantiating
; applied ADTs eagerly in form order, which is the creation order the
; dump pins. The prelude's `(Option a)` template is seeded as adt 0 (the
; seed's PRELUDE after the print multimethod strips away).
;
; Parser state threads the intern table (instance names intern on mint),
; the tables they grow, the current form's type parameters, and the first
; error. `err` = "" means ok.

; --- program tables ---------------------------------------------------------

(deftype Param (Param [name :- i64 ty :- Ty borrowed :- i64]))
(deftype PList (PNil) (PCons [h :- Param t :- PList]))

(deftype RawDefn (RawDefn [name :- i64 params :- PList ret :- Ty
                          typarams :- Sids isextern :- i64 body :- Ast
                          ret-borrowed :- i64]))
(deftype Raws (RNil) (RCons [h :- RawDefn t :- Raws]))

(deftype Varnt (Varnt [name :- i64 fields :- TyList]))
(deftype VList (VNil) (VCons [h :- Varnt t :- VList]))

; tpl = -1 for declared templates; else the template index (an instance).
; tplargs pins the instantiation key; dedup walks the table.
(deftype AdtInfo (AdtInfo [name :- i64 typarams :- Sids variants :- VList
                          tpl :- i64 tplargs :- TyList]))
(deftype AdtTab (ATNil) (ATCons [h :- AdtInfo t :- AdtTab]))

(deftype Defn (Defn [name :- i64 params :- PList ret :- Ty isextern :- i64
                    body :- HExpr ret-borrowed :- i64]))
(deftype Defns (DNil) (DCons [h :- Defn t :- Defns]))

(deftype Sig (Sig [params :- TyList ret :- Ty]))
(deftype Sigs (SGNil) (SGCons [h :- Sig t :- Sigs]))

(deftype Lam (Lam [mangled :- i64 caps :- Caps params :- PList ret :- Ty
                  body :- HExpr]))
(deftype Lams (LMNil) (LMCons [h :- Lam t :- Lams]))

; deftype header table: name sid -> (combined index, type parameters).
; Keyed chains are hand-rolled per value type: the field grammar admits no
; `(AList V)` fields (an applied template must apply a deftype's OWN
; parameters), so the S4 AList only appears in defn signatures.
(deftype Decl (Decl [idx :- i64 typarams :- Sids]))
(deftype Decls (DLNil) (DLCons [k :- i64 v :- Decl next :- Decls]))
(deftype TyEnv (TENil) (TECons [k :- i64 v :- Ty next :- TyEnv]))
(deftype IMap (MNil) (MCons [k :- i64 v :- i64 next :- IMap]))

(defn dl-put [e :- Decls k :- i64 v :- Decl] :- Decls
  (DLCons k v e))

(defn dl-get [e :- &Decls k :- i64] :- Decl
  (match e
    (DLCons [ek ev next] (if (= ek k) (clone ev) (dl-get next k)))
    (DLNil [] (Decl -1 (SNil)))))

(defn dl-has [e :- &Decls k :- i64] :- bool
  (match e
    (DLCons [ek ev next] (if (= ek k) true (dl-has next k)))
    (DLNil [] false)))

(defn te-put [e :- TyEnv k :- i64 v :- Ty] :- TyEnv
  (TECons k v e))

(defn te-get [e :- &TyEnv k :- i64] :- Ty
  (match e
    (TECons [ek ev next] (if (= ek k) (clone ev) (te-get next k)))
    (TENil [] (t-none))))

(defn te-has [e :- &TyEnv k :- i64] :- bool
  (match e
    (TECons [ek ev next] (if (= ek k) true (te-has next k)))
    (TENil [] false)))

(defn im-put [e :- IMap k :- i64 v :- i64] :- IMap
  (MCons k v e))

(defn im-get [e :- &IMap k :- i64 d :- i64] :- i64
  (match e
    (MCons [ek ev next] (if (= ek k) ev (im-get next k d)))
    (MNil [] d)))

(defn im-has [e :- &IMap k :- i64] :- bool
  (match e
    (MCons [ek ev next] (if (= ek k) true (im-has next k)))
    (MNil [] false)))

; representation facts per combined-table index. Post-revision the model
; gives owns ⊇ boxed and boxed := owns at convergence — one array serves
; both (the seed's two converge to equality).
(deftype Facts (Facts [owns :- Sids]))

(defn facts-owns-at [f :- &Facts i :- i64] :- i64
  (match f
    (Facts [owns] (sids-idx owns i))))

(defn facts-boxed-at [f :- &Facts i :- i64] :- i64
  (facts-owns-at f i))

; --- table helpers ----------------------------------------------------------

(defn raws-depth [rs :- &Raws] :- i64
  (match rs
    (RCons [h t] (+ 1 (raws-depth t)))
    (RNil [] 0)))

(defn raws-at [rs :- &Raws i :- i64] :- RawDefn
  (match rs
    (RCons [h t] (if (= i 0) (clone h) (raws-at t (- i 1))))
    (RNil [] (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))))

(defn raws-append [rs :- Raws r :- RawDefn] :- Raws
  (match rs
    (RNil [] (RCons r (RNil)))
    (RCons [h t] (RCons h (raws-append t r)))))

(defn adts-depth [ts :- &AdtTab] :- i64
  (match ts
    (ATCons [h t] (+ 1 (adts-depth t)))
    (ATNil [] 0)))

(defn adts-at [ts :- &AdtTab i :- i64] :- AdtInfo
  (match ts
    (ATCons [h t] (if (= i 0) (clone h) (adts-at t (- i 1))))
    (ATNil [] (AdtInfo -1 (SNil) (VNil) -1 (TyNil)))))

(defn adts-set [ts :- AdtTab i :- i64 info :- AdtInfo] :- AdtTab
  (match ts
    (ATCons [h t]
      (if (= i 0)
        (ATCons info t)
        (ATCons h (adts-set t (- i 1) info))))
    (ATNil [] (ATNil))))

(defn adts-append-info [ts :- AdtTab info :- AdtInfo] :- AdtTab
  (match ts
    (ATNil [] (ATCons info (ATNil)))
    (ATCons [h t] (ATCons h (adts-append-info t info)))))

(defn sigs-depth [ss :- &Sigs] :- i64
  (match ss
    (SGCons [h t] (+ 1 (sigs-depth t)))
    (SGNil [] 0)))

(defn sigs-at [ss :- &Sigs i :- i64] :- Sig
  (match ss
    (SGCons [h t] (if (= i 0) (clone h) (sigs-at t (- i 1))))
    (SGNil [] (Sig (TyNil) (t-none)))))

(defn lams-depth [ls :- &Lams] :- i64
  (match ls
    (LMCons [h t] (+ 1 (lams-depth t)))
    (LMNil [] 0)))

(defn lams-append [ls :- Lams l :- Lam] :- Lams
  (match ls
    (LMNil [] (LMCons l (LMNil)))
    (LMCons [h t] (LMCons h (lams-append t l)))))

(defn plist-depth [ps :- &PList] :- i64
  (match ps
    (PCons [h t] (+ 1 (plist-depth t)))
    (PNil [] 0)))

(defn plist-rev [ps :- PList acc :- PList] :- PList
  (match ps
    (PCons [h t] (plist-rev t (PCons h acc)))
    (PNil [] acc)))

(defn vlist-depth [vs :- &VList] :- i64
  (match vs
    (VCons [h t] (+ 1 (vlist-depth t)))
    (VNil [] 0)))

(defn vlist-at [vs :- &VList i :- i64] :- Varnt
  (match vs
    (VCons [h t] (if (= i 0) (clone h) (vlist-at t (- i 1))))
    (VNil [] (Varnt -1 (TyNil)))))

(defn vlist-rev [vs :- VList acc :- VList] :- VList
  (match vs
    (VCons [h t] (vlist-rev t (VCons h acc)))
    (VNil [] acc)))

(defn defns-depth [ds :- &Defns] :- i64
  (match ds
    (DCons [h t] (+ 1 (defns-depth t)))
    (DNil [] 0)))

(defn defns-append [ds :- Defns d :- Defn] :- Defns
  (match ds
    (DNil [] (DCons d (DNil)))
    (DCons [h t] (DCons h (defns-append t d)))))

; --- parser state -----------------------------------------------------------

(deftype PS (PS [tab :- i64 decls :- Decls adts :- AdtTab
                sigs :- Sigs typarams :- Sids err :- str]))

; Reads the error flag alone: taking the state by value made every caller
; copy the whole parser state (ADT and signature tables included) to keep
; its own copy for the success path.
(defn ps-failed [ps :- &PS] :- bool
  (match ps
    (PS [tab decls adts sigs typarams err] (> (count err) 0))))

; The scrutinee is consumed, so its fields can be *moved* into the result:
; cloning them deep-copied the whole ADT and signature tables on every call
; (the message is only ever threaded alongside the tables it arrived with).
(defn ps-err [ps :- PS msg :- str] :- PS
  (match ps
    (PS [tab decls adts sigs typarams err]
      (if (> (count err) 0)
        (PS tab decls adts sigs typarams err)
        (PS tab decls adts sigs typarams msg)))))

(defn ps-tab [ps :- &PS] :- i64
  (match ps (PS [tab decls adts sigs typarams err] tab)))

(defn ps-with-tab [ps :- PS tab :- i64] :- PS
  (match ps
    (PS [t decls adts sigs typarams err]
      (PS tab decls adts sigs typarams err))))

(defn ps-adts [ps :- PS] :- AdtTab
  (match ps (PS [tab decls adts sigs typarams err] adts)))

(defn ps-with-adts [ps :- PS adts :- AdtTab] :- PS
  (match ps
    (PS [tab decls a sigs typarams err]
      (PS tab decls adts sigs typarams err))))

(defn ps-sigs [ps :- PS] :- Sigs
  (match ps (PS [tab decls adts sigs typarams err] sigs)))

; Fused borrows: `(ps-adts (clone ps))` copies the whole parser state (ADT
; table included) to read one entry, and the read itself only borrows.
(defn ps-adt-at [ps :- &PS i :- i64] :- AdtInfo
  (match ps (PS [tab decls adts sigs typarams err] (adts-at adts i))))

(defn ps-adts-depth [ps :- &PS] :- i64
  (match ps (PS [tab decls adts sigs typarams err] (adts-depth adts))))

(defn ps-adts-find-inst [ps :- &PS tpl :- i64 args :- &TyList i :- i64] :- i64
  (match ps (PS [tab decls adts sigs typarams err] (adts-find-inst adts tpl args i))))


(defn ps-adt-inst-name [ps :- &PS tpl :- i64 args :- TyList] :- I1Res
  (match ps (PS [tab decls adts sigs typarams err] (adt-inst-name adts tab tpl args))))

(defn ps-with-sigs [ps :- PS sigs :- Sigs] :- PS
  (match ps
    (PS [tab decls adts s typarams err]
      (PS tab decls adts sigs typarams err))))

(defn ps-with-err [ps :- PS err :- str] :- PS
  (match ps
    (PS [tab decls adts sigs typarams e]
      (PS tab decls adts sigs typarams err))))

(defn sym-str [tab :- i64 sid :- i64] :- str
  (stab-get tab sid))

(defn ps-str-of [ps :- &PS sid :- i64] :- str
  (sym-str (ps-tab ps) sid))

; One-shot intern over a bare table: the sid, plus the grown table.
(deftype I1Res (I1Res [tab :- i64 sid :- i64]))

(defn intern1 [tab :- i64 s :- str] :- I1Res
  (let [sid (intern-find tab s)]
    (if (< sid 0) (I1Res tab (stab-conj tab s)) (I1Res tab sid))))

(defn sids-idx-of [ks :- Sids x :- i64 i :- i64] :- i64
  (match ks
    (SCons [h t] (if (= h x) i (sids-idx-of t x (+ i 1))))
    (SNil [] -1)))

(defn register-ty-param [ps :- PS name :- i64] :- PS
  (match ps
    (PS [tab decls adts sigs typarams err]
      (if (sids-has typarams name)
        (PS tab decls adts sigs typarams err)
        (PS tab decls adts sigs (sids-append typarams name) err)))))

(defn typaram-index [ps :- PS name :- i64] :- i64
  (match ps
    (PS [tab decls adts sigs typarams err] (sids-idx-of typarams name 0))))

(defn is-upper [s :- str] :- bool
  (if (= (count s) 0)
    false
    (let [c (nth s 0 0)]
      (and (>= c 65) (<= c 90)))))

; The prelude: `(deftype (Option a) (Some [v :- a]) (None))` as adt 0.
; "Option"/"Some"/"None"/"a" are magic sids 85..88.
(defn ps-new [tab :- i64] :- PS
  (let [vs (VCons (Varnt (s-some) (TyCons (t-param 0) (TyNil)))
            (VCons (Varnt (s-nonevar) (TyNil)) (VNil)))
        adts (ATCons (AdtInfo (s-option) (SCons (s-aparam) (SNil)) vs -1 (TyNil)) (ATNil))]
    (PS tab (DLNil) adts (SGNil) (SNil) "")))

; --- type parsing -----------------------------------------------------------

(deftype PTyRes (PTyRes [ps :- PS ty :- Ty]))

; A type annotation symbol (parse_ty_sym): scalars by spelling, the
; legacy `vec` alias, map/set (they parse; their ops are rejected at
; lowering), declared ADT names, uppercase type parameters.
(defn parse-ty-sym-str [ps :- PS s :- str] :- PTyRes
  (cond
    (= s "i64")    (PTyRes ps (t-i64))
    (= s "i32")    (PTyRes ps (t-i32))
    (= s "i8")     (PTyRes ps (t-i8))
    (= s "i16")    (PTyRes ps (t-i16))
    (= s "u8")     (PTyRes ps (t-u8))
    (= s "u16")    (PTyRes ps (t-u16))
    (= s "u32")    (PTyRes ps (t-u32))
    (= s "u64")    (PTyRes ps (t-u64))
    (= s "usize")  (PTyRes ps (t-usize))
    (= s "f64")    (PTyRes ps (t-f64))
    (= s "f32")    (PTyRes ps (t-f32))
    (= s "vec")    (PTyRes ps (t-vec 0))
    (= s "bool")   (PTyRes ps (t-bool))
    (= s "str")    (PTyRes ps (t-str))
    (= s "string") (PTyRes ps (t-str))
    (= s "map")    (PTyRes ps (t-map))
    (= s "set")    (PTyRes ps (t-set))
    (parse-ty-sym-name ps s)))

; A declared ADT name, or an (uppercase) type parameter — lowercase
; unknowns are typos, not variables, and are rejected.
(defn parse-ty-sym-name [ps :- PS s :- str] :- PTyRes
  (match ps
    (PS [tab decls adts sigs typarams err]
      (let [r (intern1 tab s)]
        (match r
          (I1Res [tab2 sid]
            (if (dl-has decls sid)
              (let [d (dl-get decls sid)]
                (match d
                  (Decl [idx tps]
                    (PTyRes (PS tab2 decls adts sigs typarams err)
                            (t-adt idx)))))
              (if (is-upper s)
                (let [ps0 (PS tab2 decls adts sigs typarams err)
                      ps2 (register-ty-param ps0 sid)]
                  (match ps2
                    (PS [t3 d3 a3 s3 y3 e3]
                      (PTyRes (clone ps2) (t-param (sids-idx-of (clone y3) sid 0))))))
                (let [ps0 (PS tab2 decls adts sigs typarams err)]
                  (PTyRes (ps-err ps0 (str "unknown type name " s)) (t-none)))))))))))

; (Vector el) element spelling.
(defn parse-vec-elem-str [ps :- PS s :- str] :- PTyRes
  (cond
    (= s "i64") (PTyRes ps (t-vec 0))
    (= s "f64") (PTyRes ps (t-vec 1))
    (= s "str") (PTyRes ps (t-vec 2))
    (if (is-upper s)
      (let [r (intern1 (ps-tab ps) s)]
        (match r
          (I1Res [tab2 sid]
            (let [ps2 (register-ty-param (ps-with-tab ps tab2) sid)]
              (match ps2
                (PS [t d a sg y e]
                  (PTyRes (clone ps2) (t-vec (+ 100 (sids-idx-of (clone y) sid 0))))))))))
      (PTyRes (ps-err ps (str "unknown type name " s)) (t-none)))))

; Fn-annotation element types: scalars/ADT names via the sym grammar, or
; a full (Vector ty) (parse_scalar_or_vec).
(defn parse-fn-elem [a :- Ast ps :- PS] :- PTyRes
  (let [tag (ast-tag a)]
    (if (= tag 1)
      (parse-ty-sym-str (clone (clone ps)) (sym-str (ps-tab ps) (ast-sid-of a)))
      (if (= tag 5)
        (parse-ty (clone a) ps)
        (PTyRes (ps-err ps "Fn param/ret types must be scalars, str, or (Vector ty)") (t-none))))))

; Register a closure signature (deduped structurally); the index — its
; table position — is the `Ty::Fn` payload.
(defn register-sig [ps :- PS params :- TyList ret :- Ty] :- PTyRes
  (let [i (sigs-find (ps-sigs (clone ps)) params (clone ret) 0)]
    (if (>= i 0)
      (PTyRes ps (t-fn i))
      (match ps
        (PS [tab decls adts sigs typarams err]
          (PTyRes (PS tab decls adts (SGCons (Sig (clone params) ret) (clone sigs)) typarams err)
                  (t-fn (sigs-depth sigs))))))))

; The table and the probed param list are only read: borrow both, so the
; scan costs no per-entry deep clone of `params` (a cons clone copies the
; whole tail, which made every registration quadratic in the table size).
(defn sigs-find [ss :- &Sigs params :- &TyList ret :- Ty i :- i64] :- i64
  (match ss
    (SGCons [h t]
      (match h
        (Sig [hp hr]
          (if (and (tys-eq hp params) (ty-eq hr (clone ret)))
            i
            (sigs-find t params ret (+ i 1))))))
    (SGNil [] -1)))

; The string of an atom node (only symbol/string position is queried).
(defn node-str [a :- Ast tab :- i64] :- str
  (match a
    (ANil [at] "")
    (ASym [sid at] (sym-str (clone tab) sid))
    (AInt [v at] (str v))
    (AF64 [v at] (str v))
    (ABool [v at] (str v))
    (AStr [v at] v)
    (AList [ks at] "")
    (AVec [ks at] "")
    (AMap [ks at] "")
    (ASet [ks at] "")))

; A type annotation expression (parse_ty).
(defn parse-ty [a :- Ast ps :- PS] :- PTyRes
  (let [tag (ast-tag a)]
    (cond
      ; `cond` branches are alternative paths, so each may move `ps`/`a`;
      ; the copies here were pure over-cloning (a whole parser state each).
      (= tag 1) (parse-ty-sym-str ps (sym-str (ps-tab ps) (ast-sid-of a)))
      (= tag 5) (parse-ty-list a ps)
      (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))))

(defn parse-ty-list [a :- Ast ps :- PS] :- PTyRes
  (match a
    (AList [kids at]
      (let [h (asts-head-sid kids)
            n (asts-depth kids)]
        (cond
          (= h (s-vec))
          (if (not (= n 2))
            (PTyRes (ps-err ps (str "unsupported type annotation (expected (Vector ty), got " (- n 1) " elements)")) (t-none))
            (let [el-node (asts-idx kids 1)
                  el-str (node-str el-node (ps-tab ps))]
              (parse-vec-elem-str ps el-str)))

          (= h (s-fnty))
          (parse-ty-fn (asts-drop kids 1) ps)

          (parse-ty-applied kids n ps))))
    (ANil [at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (ASym [sid at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AInt [v at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AF64 [v at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (ABool [v at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AStr [v at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AVec [ks at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (AMap [ks at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))
    (ASet [ks at] (PTyRes (ps-err ps "type annotation must be a symbol or (Vector ty)") (t-none)))))

; (Fn [t1 ...] ret) — rest is the chain AFTER the `Fn` head: the params
; vector then the ret form chain
(defn parse-ty-fn [rest :- Asts ps :- PS] :- PTyRes
  (match rest
    (KNil [] (PTyRes (ps-err ps "Fn params must be a vector") (t-none)))
    (KCons [pvec pret]
      (let [t1 (ast-tag pvec)]
        (if (not (= t1 6))
          (PTyRes (ps-err ps "Fn params must be a vector") (t-none))
          (if (asts-null pret)
            (PTyRes (ps-err ps "Fn annotation expects a return type") (t-none))
            (let [ret (asts-idx pret 0)]
              (parse-fn-elems (ast-kids-of (clone pvec)) (TyNil) ret ps))))))))

(defn parse-fn-elems [els :- Asts acc :- TyList ret :- Ast ps :- PS] :- PTyRes
  (match els
    (KCons [e rest]
      (let [r (parse-fn-elem e ps)]
        (match r
          (PTyRes [ps2 ty]
            (if (ps-failed ps2)
              (PTyRes ps2 (t-none))
              (parse-fn-elems rest (TyCons ty acc) ret ps2))))))
    (KNil []
      (let [r (parse-fn-elem ret ps)]
        (match r
          (PTyRes [ps2 rty]
            (if (ps-failed ps2)
              (PTyRes ps2 (t-none))
              (register-sig ps2 (tys-rev acc (TyNil)) rty))))))))

; Applied ADT annotation: (Name arg ...) — instantiate the template
; eagerly. The name must be a generic declared template.
(defn parse-ty-applied [kids :- Asts n :- i64 ps :- PS] :- PTyRes
  (let [h (asts-head-sid kids)]
    (if (and (= h (s-vec)) (not (= n 2)))
      (PTyRes (ps-err ps (str "unsupported type annotation (expected (Vector ty), got " (- n 1) " elements)")) (t-none))
      (match ps
        (PS [tab decls adts sigs typarams err]
          (if (dl-has decls h)
            (let [d (dl-get decls h)]
              (match d
                (Decl [idx tps]
                  (if (= (sids-depth tps) 0)
                    (PTyRes (ps-err ps (str (sym-str (clone tab) h) " takes no type parameters")) (t-none))
                    (let [rargs (parse-ty-args (asts-drop kids 1) (TyNil) (clone ps))]
                      (match rargs
                        (PArgsRes [ps2 args]
                          (if (ps-failed ps2)
                            (PTyRes ps2 (t-none))
                            (let [ri (instantiate-adt idx args ps2)]
                              (match ri
                                (PIARes [ps3 idx2] (PTyRes ps3 (t-adt idx2)))))))))))))
            (PTyRes (ps-err ps (str "unknown type name " (sym-str (clone tab) h))) (t-none))))))))

(deftype PArgsRes (PArgsRes [ps :- PS args :- TyList]))

(defn parse-ty-args [els :- Asts acc :- TyList ps :- PS] :- PArgsRes
  (match els
    (KCons [e rest]
      (let [r (parse-ty e ps)]
        (match r
          (PTyRes [ps2 ty]
            (if (ps-failed ps2)
              (PArgsRes ps2 (TyNil))
              (parse-ty-args rest (TyCons ty acc) ps2))))))
    (KNil [] (PArgsRes ps (tys-rev acc (TyNil))))))

; --- ADT instantiation (the combined-table rule of `instantiate_adt`) -------

(deftype PIARes (PIARes [ps :- PS idx :- i64]))

(defn instantiate-adt [tpl :- i64 args :- TyList ps :- PS] :- PIARes
  (let [td (ps-adt-at ps tpl)]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (if (not (= (sids-depth tps) (tys-depth (clone (clone args)))))
          (let [msg (str (ps-str-of ps name)
                         " expects " (sids-depth tps)
                         " type argument(s), got " (tys-depth args))]
            (PIARes (ps-err ps msg) -1))
          (let [hit (ps-adts-find-inst ps tpl args 0)]
            (if (>= (clone hit) 0)
              (PIARes ps (clone hit))
              (instantiate-adt-new tpl args ps))))))))

(defn adts-find-inst [ts :- &AdtTab tpl :- i64 args :- &TyList i :- i64] :- i64
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [name tps variants vtpl vtargs]
          (if (and (= vtpl tpl) (tys-eq vtargs args))
            i
            (adts-find-inst t tpl args (+ i 1))))))
    (ATNil [] -1)))

; The instance registers (empty) before its fields resolve, so recursive
; templates hit the cache — the seed's termination rule.
(defn instantiate-adt-new [tpl :- i64 args :- TyList ps :- PS] :- PIARes
  (let [td (ps-adt-at ps tpl)
        nm (ps-adt-inst-name ps tpl (clone args))]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (match nm
          (I1Res [tab2 nsid]
            (let [ps1 (ps-with-tab ps tab2)
                  idx (ps-adts-depth ps1)
                  ps2 (ps-with-adts (clone ps1) (adts-append-info (ps-adts ps1) (AdtInfo nsid (SNil) (VNil) tpl (clone args))))
                  rv (fill-variants tpl (clone args) 0 (VNil) ps2)]
              (match rv
                (PVRes [ps3 vs]
                  (PIARes (ps-with-adts (clone ps3) (adts-set (ps-adts ps3) (clone idx) (AdtInfo nsid (SNil) vs tpl args)))
                          (clone idx)))))))))))

; `Name__arg1_arg2` — the seed's adt_arg_suffix join.
(defn adt-inst-name [adts :- &AdtTab tab :- i64 tpl :- i64 args :- TyList] :- I1Res
  (let [td (adts-at adts tpl)]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (inst-name-loop adts (clone tab) (sym-str (clone tab) name) args 1)))))

(defn inst-name-loop [adts :- &AdtTab tab :- i64 acc :- str args :- TyList first :- i64] :- I1Res
  (match args
    (TyNil [] (intern1 tab acc))
    (TyCons [h t]
      (let [suf (ty-mangle-str adts (clone tab) h)
            acc2 (if (= first 1) (str acc "__" suf) (str acc "_" suf))]
        (inst-name-loop adts (clone tab) acc2 t 0)))))

(defn ty-mangle-str [adts :- &AdtTab tab :- i64 x :- Ty] :- str
  (let [suf (ty-suffix (clone x))]
    (if (not (= suf "?"))
      suf
      (let [t (ty-tag x)]
        (cond
          (= t 16)
          (let [td (adts-at adts (ty-arg x))]
            (match td
              (AdtInfo [name tps variants vtpl vargs] (sym-str (clone tab) name))))
          (= t 18) (str "t" (ty-arg x))
          "unk")))))

; A template's variants with the instantiation's arguments substituted:
; TParam(k) -> args[k]; a field naming a generic template re-applies the
; same arguments (the positional-parameter rule).
(deftype PVRes (PVRes [ps :- PS vs :- VList]))
(deftype PVRes2 (PVRes2 [ps :- PS vs :- VList]))
(deftype PVOne (PVOne [ps :- PS v :- Varnt]))
(deftype PFRes (PFRes [ps :- PS fs :- TyList]))

(defn fill-variants [tpl :- i64 args :- TyList vi :- i64 acc :- VList ps :- PS] :- PVRes
  (let [td (ps-adt-at ps tpl)]
    (match td
      (AdtInfo [name tps variants vtpl vargs]
        (if (>= vi (vlist-depth variants))
          (PVRes ps (vlist-rev acc (VNil)))
          (let [v (vlist-at variants vi)]
            (match v
              (Varnt [vn fields]
                (let [rf (fill-fields fields (TyNil) (clone args) ps)]
                  (match rf
                    (PFRes [ps2 fs]
                      (if (ps-failed ps2)
                        (PVRes ps2 (VNil))
                        (fill-variants tpl args (+ vi 1) (VCons (Varnt vn fs) acc) ps2)))))))))))))

(defn fill-fields [fs :- TyList acc :- TyList args :- TyList ps :- PS] :- PFRes
  (match fs
    (TyCons [h t]
      (let [r (subst-field-ty h (clone args) ps)]
        (match r
          (PTyRes [ps2 ty]
            (if (ps-failed ps2)
              (PFRes ps2 (TyNil))
              (fill-fields t (TyCons ty acc) args ps2))))))
    (TyNil [] (PFRes ps (tys-rev acc (TyNil))))))

(defn subst-field-ty [f :- Ty args :- TyList ps :- PS] :- PTyRes
  (let [t (ty-tag f)]
    (cond
      (= t 18)
      (if (>= (ty-arg f) (tys-depth args))
        (PTyRes (ps-err ps (str "unresolved type parameter " (ty-arg f) " in ADT field")) (t-none))
        (PTyRes ps (tys-idx (clone args) (ty-arg f))))
      (= t 16)
      (let [j (ty-arg f)
            td (ps-adt-at ps j)]
        (match td
          (AdtInfo [name tps variants vtpl vargs]
            (if (> (sids-depth tps) 0)
              (let [ri (instantiate-adt j args (clone ps))]
                (match ri
                  (PIARes [ps2 idx] (PTyRes ps2 (t-adt idx)))))
              (PTyRes ps (clone f))))))
      (PTyRes ps f))))

; --- deftype parsing --------------------------------------------------------

; Header: Name, or (Name p1 p2 ...).
(deftype HDRRes (HDRRes [ps :- PS name :- i64 typarams :- Sids]))

(defn parse-deftype-header [a :- Ast ps :- PS] :- HDRRes
  (match a
    (AList [kids at]
      (let [n (asts-depth kids)]
        (if (< n 2)
          (HDRRes (ps-err ps "deftype expects a name and at least one variant") -1 (SNil))
          (let [h (asts-idx kids 1)
                ht (ast-tag h)]
            (cond
              (= ht 1)
              (HDRRes ps (ast-sid-of h) (SNil))

              (= ht 5)
              (match (asts-idx (ast-kids-of (clone h)) 0)
                (AList [hks hat] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (ASym [nsid nat]
                  (parse-typarams (asts-drop (ast-kids-of (clone h)) 1) (SNil) nsid (clone ps)))
                (AInt [v at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (AF64 [v at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (ABool [v at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (AStr [v at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (AVec [ks at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (AMap [ks at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (ASet [ks at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))
                (ANil [at] (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil))))

              (HDRRes (ps-err ps "deftype name must be a symbol") -1 (SNil)))))))
    (ANil [at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (ASym [sid at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (AInt [v at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (AF64 [v at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (ABool [v at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (AStr [v at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (AVec [ks at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (AMap [ks at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))
    (ASet [ks at] (HDRRes (ps-err ps "expected (deftype ...)") -1 (SNil)))))

; The header's type-parameter list (symbols; duplicates rejected).
(defn parse-typarams [els :- Asts acc :- Sids name :- i64 ps :- PS] :- HDRRes
  (match els
    (KCons [p rest]
      (match p
        (ASym [pn pat]
          (if (sids-has (clone (clone acc)) pn)
            (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " repeats type parameter " (ps-str-of ps pn)))
                    -1 (SNil))
            (parse-typarams rest (SCons pn acc) name ps)))
        (ANil [at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (AInt [v at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (AF64 [v at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (ABool [v at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (AStr [v at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (AList [ks at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (AVec [ks at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (AMap [ks at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))
        (ASet [ks at] (HDRRes (ps-err ps (str "deftype " (ps-str-of ps name) " type parameter must be a symbol")) -1 (SNil)))))
    (KNil [] (HDRRes ps name (sids-rev acc (SNil))))))

; Variants (pass 0b): (VName [field :- ty ...]) per variant. `ps`'s
; typarams carry THIS deftype's parameters (the caller resets them).
(defn parse-deftype-variants [a :- Ast ps :- PS] :- PVRes2
  (match a
    (AList [kids at]
      (parse-variants-1 (asts-drop kids 2) (VNil) ps))
    (ANil [at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (ASym [sid at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (AInt [v at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (AF64 [v at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (ABool [v at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (AStr [v at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (AVec [ks at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (AMap [ks at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))
    (ASet [ks at] (PVRes2 (ps-err ps "expected (deftype ...)") (VNil)))))

(defn parse-variants-1 [els :- Asts acc :- VList ps :- PS] :- PVRes2
  (match els
    (KCons [v rest]
      (let [r (parse-variant v ps)]
        (match r
          (PVOne [ps2 vt]
            (if (ps-failed ps2)
              (PVRes2 ps2 (VNil))
              (parse-variants-1 rest (VCons vt acc) ps2))))))
    (KNil [] (PVRes2 ps (vlist-rev acc (VNil))))))

; One variant: name + optional fields vector.
(defn parse-variant [v :- Ast ps :- PS] :- PVOne
  (match v
    (AList [vitems at]
      (let [vn (asts-head-sid vitems)
            n (asts-depth vitems)]
        (if (< vn 0)
          (PVOne (ps-err ps "deftype variant name must be a symbol") (Varnt -1 (TyNil)))
          (if (> n 1)
            (let [fvec (asts-idx vitems 1)
                  ft (ast-tag fvec)]
              (if (not (= ft 6))
                (PVOne (ps-err ps (str "variant " (ps-str-of ps vn) " fields must be a vector")) (Varnt -1 (TyNil)))
                (if (> n 2)
                  (PVOne (ps-err ps (str "variant " (ps-str-of ps vn) " takes only a fields vector")) (Varnt -1 (TyNil)))
                  (let [rf (parse-fields (ast-kids-of (clone fvec)) 0 (TyNil) vn ps)]
                    (match rf
                      (PFRes [ps2 fs] (PVOne ps2 (Varnt vn fs))))))))
             (PVOne ps (Varnt vn (TyNil)))))))
    (ANil [at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (ASym [sid at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AInt [v at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AF64 [v at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (ABool [v at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AStr [v at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AVec [ks at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (AMap [ks at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))
    (ASet [ks at] (PVOne (ps-err ps "deftype variant must be a list") (Varnt -1 (TyNil))))))

; `name :- ty` triples.
(defn parse-fields [fs :- Asts i :- i64 acc :- TyList vn :- i64 ps :- PS] :- PFRes
  (let [n (asts-depth fs)]
    (if (>= i n)
      (PFRes ps (tys-rev acc (TyNil)))
      (let [fn-node (asts-idx (clone fs) i)
            fnt (ast-tag fn-node)]
        (if (not (= fnt 1))
          (PFRes (ps-err ps (str "variant " (ps-str-of ps vn) " field name must be a symbol")) (TyNil))
          (let [sep-node (asts-idx (clone fs) (+ i 1))
                sept (ast-tag sep-node)]
            (if (not (= sept 1))
              (PFRes (ps-err ps (str "variant " (ps-str-of ps vn) " field " (node-str (clone fn-node) (ps-tab ps)) " expects (name :- ty)")) (TyNil))
              (if (not (= (ast-sid-of sep-node) (s-sep)))
                (PFRes (ps-err ps (str "variant " (ps-str-of ps vn) " field " (node-str (clone fn-node) (ps-tab ps)) " expects (name :- ty)")) (TyNil))
                (let [ty-node (asts-idx (clone fs) (+ i 2))
                      rt (parse-field-ty ty-node ps)]
                  (match rt
                    (PTyRes [ps2 ty]
                      (if (ps-failed ps2)
                        (PFRes ps2 (TyNil))
                        (parse-fields fs (+ i 3) (TyCons ty acc) vn ps2)))))))))))))

; A deftype field type (parse_field_ty): scalars, this deftype's own
; parameters, concrete ADT names, (Vector el), or an applied template
; whose arguments are this deftype's parameters in order.
(defn parse-field-ty [e :- Ast ps :- PS] :- PTyRes
  (let [tag (ast-tag e)]
    (cond
      (= tag 1)
      (let [s (node-str (clone e) (ps-tab ps))]
        (cond
          (= (clone s) "i64")  (PTyRes ps (t-i64))
          (= (clone s) "i32")  (PTyRes ps (t-i32))
          (= (clone s) "f64")  (PTyRes ps (t-f64))
          (= (clone s) "bool") (PTyRes ps (t-bool))
          (= (clone s) "str")  (PTyRes ps (t-str))
          (let [sid (ast-sid-of e)
                k (typaram-index (clone ps) sid)]
            (if (>= (clone k) 0)
              (PTyRes ps (t-param (clone k)))
              (parse-field-adt-name (clone ps) (clone s) sid)))))

      (= tag 5)
      (parse-field-applied (clone e) (clone ps))

      (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))))

(defn parse-field-adt-name [ps :- PS s :- str sid :- i64] :- PTyRes
  (if (dl-has (ps-decls (clone ps)) sid)
    (let [d (dl-get (ps-decls (clone ps)) sid)]
      (match d
        (Decl [idx tps]
          (if (= (sids-depth tps) 0)
            (PTyRes ps (t-adt idx))
            (let [msg (str "generic ADT " s " needs type arguments in a field type — apply it to this deftype's parameters: (" s " ...)")]
              (PTyRes (ps-err ps msg) (t-none)))))))
    (let [msg (str "ADT field type must be i64, i32, f64, bool, str, a type parameter of this deftype, or a declared ADT name, got '" s "'")]
      (PTyRes (ps-err ps msg) (t-none)))))

(defn ps-decls [ps :- PS] :- Decls
  (match ps (PS [tab decls adts sigs typarams err] decls)))

; (Name a b ...) field: the arguments must be this deftype's parameters
; in order, so instantiation can pass its own arguments through.
(defn parse-field-applied [e :- Ast ps :- PS] :- PTyRes
  (match e
    (AList [items at]
      (let [h (asts-head-sid items)
            n (asts-depth items)]
        (if (and (= h (s-vec)) (= n 2))
          (let [el-node (asts-idx items 1)
                el-str (node-str (clone el-node) (ps-tab ps))]
            (cond
              (= (clone el-str) "i64") (PTyRes ps (t-vec 0))
              (= (clone el-str) "f64") (PTyRes ps (t-vec 1))
              (= (clone el-str) "str") (PTyRes ps (t-vec 2))
              (let [k (typaram-index (clone ps) (ast-sid-of el-node))]
                (if (>= (clone k) 0)
                  (PTyRes ps (t-vec (+ 100 (clone k))))
                  (PTyRes (ps-err ps "(Vector ...) element must be i64, f64, str or a type parameter of this deftype") (t-none))))))
          (if (dl-has (ps-decls (clone ps)) h)
            (let [d (dl-get (ps-decls (clone ps)) h)]
              (match d
                (Decl [idx tps]
                  (let [args (asts-drop items 1)]
                    (if (not (= (asts-depth args) (sids-depth tps)))
                      (let [msg (str (ps-str-of ps h) " expects " (sids-depth tps) " type argument(s) in a field type, got " (asts-depth args))]
                        (PTyRes (ps-err ps msg) (t-none)))
                      (check-positional args tps 0 ps h idx))))))
            (PTyRes (ps-err ps (str "unknown ADT name " (ps-str-of ps h) " in field type")) (t-none))))))
    (ANil [at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (ASym [sid at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (AInt [v at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (AF64 [v at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (ABool [v at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (AStr [v at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (AVec [ks at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (AMap [ks at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))
    (ASet [ks at] (PTyRes (ps-err ps "field type must be a symbol or an applied ADT name") (t-none)))))

(defn check-positional [args :- Asts tps :- Sids i :- i64 ps :- PS h :- i64 idx :- i64] :- PTyRes
  (if (>= i (asts-depth (clone (clone args))))
    (PTyRes ps (t-adt idx))
    (let [a (asts-idx (clone args) i)
          at (ast-tag a)]
      (if (not (= at 1))
        (PTyRes (ps-err ps (str (ps-str-of ps h) " type argument must be a parameter name of this deftype")) (t-none))
        (let [asid (ast-sid-of a)
            p (sids-idx tps i)]
          (if (not (= asid p))
            (let [msg (str "field type (" (ps-str-of ps h) " ...) must apply " (ps-str-of ps h) " to this deftype's parameters in order (expected " (ps-str-of ps p) ")")]
              (PTyRes (ps-err ps msg) (t-none)))
            (check-positional args tps (+ i 1) ps h idx)))))))

; --- defn / extern parsing --------------------------------------------------

(deftype PParRes (PParRes [ps :- PS params :- PList]))
(deftype RawRes (RawRes [ps :- PS raw :- RawDefn]))

(defn borrow-sigil [s :- str] :- bool
  (and (> (count s) 0) (= (nth s 0 0) 38)))

; `(name :- ty)` triples. `&` borrows are outside the kernel contract and
; fail as unsupported; everything else mirrors parse_params.
(defn parse-params [ks :- Asts i :- i64 acc :- PList ps :- PS] :- PParRes
  (let [n (asts-depth ks)]
    (if (>= i n)
      (PParRes ps (plist-rev acc (PNil)))
      (let [nm-node (asts-idx (clone ks) i)
            nm-str (node-str (clone nm-node) (ps-tab ps))]
        (cond
          (borrow-sigil (clone nm-str))
          ; the sigil on the NAME would need re-interning of the stripped
          ; symbol; borrows are written on the annotation (`ks :- &Asts`).
          (PParRes (ps-err ps (str "unsupported borrow parameter " (clone nm-str))) (PNil))

          (not (= (ast-tag nm-node) 1))
          (PParRes (ps-err ps "param must be a symbol") (PNil))

          (let [sep-node (asts-idx (clone ks) (+ i 1))]
            (not (and (= (ast-tag sep-node) 1) (= (ast-sid-of sep-node) (s-sep)))))
          (PParRes (ps-err ps (str "function parameter '" (clone nm-str) "' must have a type annotation (param :- ty)")) (PNil))

          (let [ty-node (asts-idx (clone ks) (+ i 2))
                ty-tag2 (ast-tag ty-node)]
            (if (not (= ty-tag2 1))
              (let [rt (parse-ty (clone ty-node) ps)]
                (match rt
                  (PTyRes [ps2 ty]
                    (if (ps-failed ps2)
                      (PParRes ps2 (PNil))
                      (let [p (Param (ast-sid-of nm-node) ty 0)]
                        (parse-params ks (+ i 3) (PCons p acc) ps2))))))
              (let [ty-str (node-str (clone ty-node) (ps-tab ps))
                    ; `ks :- &Asts` — a borrowed parameter: the caller keeps
                    ; ownership, the callee only reads (S8: the query
                    ; helpers over boxed chains take & so traversals cost
                    ; no clones).
                    borrowed (borrow-sigil (clone ty-str))
                    bare (if borrowed (subs (clone ty-str) 1 (count (clone ty-str))) (clone ty-str))
                    rt (parse-ty-sym-str ps bare)]
                (match rt
                  (PTyRes [ps2 ty]
                    (if (ps-failed ps2)
                      (PParRes ps2 (PNil))
                      (let [p (Param (ast-sid-of nm-node) ty (if borrowed 1 0))]
                        (parse-params ks (+ i 3) (PCons p acc) ps2)))))))))))))

; (defn name [params] [:- ret] body...) / (extern name [params] [:- ret])
(defn parse-defn [a :- Ast ps :- PS isextern :- i64] :- RawRes
  (match a
    (AList [items at]
      (let [n (asts-depth items)]
        (if (< n 3)
          (RawRes (ps-err ps "defn expects a name and a params vector") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))
          (let [name-node (asts-idx (clone items) 1)
                pvec (asts-idx (clone items) 2)]
            (if (not (= (ast-tag name-node) 1))
              (RawRes (ps-err ps "defn name must be a symbol") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))
              (if (not (= (ast-tag pvec) 6))
                (RawRes (ps-err ps "defn params must be a vector") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))
                (let [name-sid (ast-sid-of name-node)
                      ; each form starts with its own type-parameter scope
                      ps0 (ps-reset-typarams ps)
                      rp (parse-params (ast-kids-of (clone pvec)) 0 (PNil) ps0)]
                  (match rp
                    (PParRes [ps1 params]
                      (if (ps-failed ps1)
                        (RawRes ps1 (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))
                        (parse-defn-ret items n 3 params name-sid isextern ps1)))))))))))
    (ANil [at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (ASym [sid at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (AInt [v at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (AF64 [v at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (ABool [v at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (AStr [v at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (AVec [ks at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (AMap [ks at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))
    (ASet [ks at] (RawRes (ps-err ps "expected (defn ...)") (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))))

(defn ps-reset-typarams [ps :- PS] :- PS
  (match ps
    (PS [tab decls adts sigs typarams err]
      (PS tab decls adts sigs (SNil) err))))

(defn parse-defn-ret [items :- Asts n :- i64 i :- i64 params :- PList
                     name-sid :- i64 isextern :- i64 ps :- PS] :- RawRes
  (let [has-ret (and (> n (+ i 1))
                     (= (ast-tag (asts-idx (clone items) i)) 1)
                     (= (ast-sid-of (asts-idx (clone items) i)) (s-sep)))]
    (if has-ret
      (let [ret-node (asts-idx (clone items) (+ i 1))
            ; `:- &T` — a borrowed return (symbol form only). The sigil is
            ; stripped and parsed like a param annotation.
            ret-str (if (= (ast-tag ret-node) 1) (node-str (clone ret-node) (ps-tab ps)) "")]
        (if (borrow-sigil (clone ret-str))
          (let [bare (subs (clone ret-str) 1 (count ret-str))
                rt (parse-ty-sym-str ps bare)]
            (match rt
              (PTyRes [ps2 ret]
                (if (ps-failed ps2)
                  (RawRes ps2 (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))
                  (parse-defn-body items n (+ i 2) params name-sid ret 1 isextern ps2)))))
          (let [rt (parse-ty (clone ret-node) ps)]
            (match rt
              (PTyRes [ps2 ret]
                (if (ps-failed ps2)
                  (RawRes ps2 (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))
                  (parse-defn-body items n (+ i 2) params name-sid ret 0 isextern ps2)))))))
      (parse-defn-body items n i params name-sid (t-i64) 0 isextern ps))))

(defn parse-defn-body [items :- Asts n :- i64 i :- i64 params :- PList
                      name-sid :- i64 ret :- Ty ret-borrowed :- i64 isextern :- i64 ps :- PS] :- RawRes
  (match ps
    (PS [tab decls adts sigs typarams err]
      (cond
        (and (= isextern 1) (> (sids-depth typarams) 0))
        (RawRes (ps-err ps "extern declarations must have concrete types")
                (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))

        (= isextern 1)
        (if (< i n)
          (RawRes (ps-err ps "extern declarations take no body")
                  (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))
          (RawRes (clone ps) (RawDefn name-sid (clone params) (clone ret) (clone typarams) 1 (AList (KNil) (Span 0 0 0)) ret-borrowed)))

        (>= i n)
        (RawRes (ps-err ps "defn body required")
                (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0))

        (= (- n i) 1)
        (RawRes (clone ps) (RawDefn name-sid (clone params) (clone ret) (clone typarams) 0 (asts-idx (clone (clone items)) i) ret-borrowed))

        (let [doform (AList (KCons (ASym (s-do) (asts-at-of (clone items) i)) (asts-drop (clone items) i)) (asts-at-of items i))]
          (RawRes (clone ps) (RawDefn name-sid params ret (clone typarams) 0 doform ret-borrowed)))))))

(defn asts-at-of [ks :- Asts i :- i64] :- Span
  (ast-at (asts-idx ks i)))

; --- flat boolean matrix helpers (n*n over a sid chain) ---------------------

(defn mk-zeros [n :- i64] :- Sids
  (if (= n 0) (SNil) (SCons 0 (mk-zeros (- n 1)))))

(defn sids-set [ks :- Sids i :- i64 v :- i64] :- Sids
  (match ks
    (SCons [h t] (if (= i 0) (SCons v t) (SCons h (sids-set t (- i 1) v))))
    (SNil [] (SNil))))

; --- boolean matrix as a row-major list of Sids rows ------------------------
; Rows are Sids chains of 0/1. Indexed access is O(n); the flat n*n chain
; made the Warshall closure O(n^5) and dominated the whole self-compile.
(deftype Mat (MatNil) (MatCons [row :- Sids next :- Mat]))

(defn mat-zeros [n :- i64 m :- i64] :- Mat
  (if (= m 0) (MatNil) (MatCons (mk-zeros n) (mat-zeros n (- m 1)))))

(defn sids-idx-ref [ks :- &Sids i :- i64] :- i64
  (match ks
    (SCons [h t] (if (= i 0) h (sids-idx-ref t (- i 1))))
    (SNil [] -1)))

(defn mat-get [m :- &Mat i :- i64 j :- i64] :- i64
  (match m
    (MatCons [row next] (if (= i 0) (sids-idx-ref row j) (mat-get next (- i 1) j)))
    (MatNil [] 0)))

(defn mat-set [m :- Mat i :- i64 j :- i64 v :- i64] :- Mat
  (match m
    (MatCons [row next]
      (if (= i 0)
        (MatCons (sids-set row j v) next)
        (MatCons row (mat-set next (- i 1) j v))))
    (MatNil [] (MatNil))))

; --- representation facts ---------------------------------------------------

; Warshall closure over the ADT-field edge matrix; boxed = on a cycle;
; owns fixes out from boxed; in the revised model owning implies boxed,
; so the two converge and one array serves both.

(defn facts-compute [adts :- AdtTab] :- Facts
  (let [n (adts-depth adts)
        edge0 (facts-edges adts n 0 (mat-zeros n n))
        boxed0 (facts-diag edge0 n 0 (SNil))]
    (Facts (facts-owns-rounds adts n (+ n 2) (sids-rev boxed0 (SNil))))))

; The declared-template prefix of the combined table. The seed's
; build-stage plan_drops runs on facts computed BEFORE ADT instances
; exist, so instance indices read out of bounds (owns=false) — the
; kernel mirrors that by computing facts over templates only.
(defn adts-templates [ts :- AdtTab] :- AdtTab
  (match ts
    (ATCons [h t]
      (match (clone h)
        (AdtInfo [name tps variants tpl tplargs]
          (if (= tpl -1)
            (ATCons h (adts-templates t))
            (ATNil)))))
    (ATNil [] (ATNil))))

(defn facts-edges [adts :- &AdtTab n :- i64 t :- i64 edge :- Mat] :- Mat
  (if (>= t n)
    (facts-closure edge n 0)
    (facts-edges-vi adts n t 0 edge)))

(defn facts-edges-vi [adts :- &AdtTab n :- i64 t :- i64 vi :- i64 edge :- Mat] :- Mat
  (if (>= vi (vlist-depth (adts-variants-at adts t)))
    (facts-edges adts n (+ t 1) edge)
    (facts-edges-fs (varnt-fields-at adts t vi) adts n t vi edge)))

(defn facts-edges-fs [fs :- TyList adts :- &AdtTab n :- i64 t :- i64 vi :- i64 edge :- Mat] :- Mat
  (match fs
    (TyCons [h rest]
      (let [u (ty-arg h)]
        (if (and (= (ty-tag h) 16) (< u n))
          (facts-edges-fs rest adts n t vi (mat-set edge t u 1))
          (facts-edges-fs rest adts n t vi edge))))
    (TyNil [] (facts-edges-vi adts n t (+ vi 1) edge))))

; Warshall as row absorption: for each k, every row i whose k-th column is
; set absorbs row k — a[i][j] |= a[i][k] & a[k][j] for all j at once.
; The cell-wise form probed cons-list rows three times per cell, so a probe
; was O(n) and the whole traversal O(n^4) (154 deftypes: ~1.7e9 list steps,
; seconds of every build). Row k is invariant through pass k (the standard
; in-place Warshall property), so it is read once per pass, and each row is
; walked once — O(n^3) with a constant of one compare per cell.
(defn mat-row-ref [m :- &Mat i :- i64] :- Sids
  (match m
    (MatCons [row next] (if (= i 0) (clone row) (mat-row-ref next (- i 1))))
    (MatNil [] (SNil))))

; Element-wise OR of two 0/1 rows; the second is only read, so one row
; serves every absorbing row in a pass without a per-row copy.
(defn mat-row-or [a :- Sids b :- &Sids] :- Sids
  (match a
    (SCons [ha ta]
      (match b
        (SCons [hb tb] (SCons (if (or (= ha 1) (= hb 1)) 1 0) (mat-row-or ta tb)))
        (SNil [] (SCons ha (mat-row-or ta b)))))
    (SNil [] (SNil))))

(defn facts-absorb [m :- Mat k :- i64 rowk :- &Sids] :- Mat
  (match m
    (MatCons [row next]
      (if (= (sids-idx-ref row k) 1)
        (MatCons (mat-row-or row rowk) (facts-absorb next k rowk))
        (MatCons row (facts-absorb next k rowk))))
    (MatNil [] (MatNil))))

(defn facts-closure [edge :- Mat n :- i64 k :- i64] :- Mat
  (if (>= k n)
    edge
    (facts-closure (facts-absorb edge k (mat-row-ref edge k)) n (+ k 1))))

(defn facts-edges-wrap [edge :- Mat n :- i64 t :- i64] :- Mat
  (if (>= t n) (facts-closure edge n 0) edge))

(defn facts-diag [m :- &Mat n :- i64 i :- i64 acc :- Sids] :- Sids
  (if (>= i n)
    acc
    (facts-diag m n (+ i 1) (SCons (mat-get m i i) acc))))

(defn facts-owns-rounds [adts :- &AdtTab n :- i64 rounds :- i64 owns :- Sids] :- Sids
  (if (= rounds 0)
    owns
    (facts-owns-rounds adts n (- rounds 1) (owns-prop adts n 0 owns))))

(defn owns-prop [adts :- &AdtTab n :- i64 t :- i64 owns :- Sids] :- Sids
  (if (>= t n)
    owns
    (let [owns2 (if (= (sids-idx-ref owns t) 1)
                  owns
                  (if (own-via adts t 0 owns) (sids-set owns t 1) owns))]
      (owns-prop adts n (+ t 1) owns2))))

(defn own-via [adts :- &AdtTab t :- i64 vi :- i64 owns :- &Sids] :- bool
  (if (>= vi (vlist-depth (adts-variants-at adts t)))
    false
    (own-via-fs (varnt-fields-at adts t vi) owns)))

(defn own-via-fs [fs :- TyList owns :- &Sids] :- bool
  (match fs
    (TyCons [h rest]
      (let [tg (ty-tag h)]
        (if (or (= tg 12) (= tg 15) (= tg 13) (= tg 14))
          true
          (if (and (= tg 16) (= (sids-idx-ref owns (ty-arg h)) 1))
            true
            (own-via-fs rest owns)))))
    (TyNil [] false)))

(defn adts-variants-at [ts :- &AdtTab i :- i64] :- VList
  (match (adts-at ts i)
    (AdtInfo [name tps variants tpl tplargs] variants)))

; Walk to the variant's fields through borrowed chains. The old shape
; returned the whole `AdtInfo` (every variant and field list) and then the
; whole `Varnt` only to hand back `fields`; here the borrowed walk is fused
; and just the small field list is copied out.
; The variant's name only: taking the whole `Varnt` through `vlist-at`
; copies its field list, which callers that compare names never read.
(defn varnt-name-at [vs :- &VList i :- i64] :- i64
  (match vs
    (VCons [h t]
      (if (= i 0)
        (match h (Varnt [vn fields] vn))
        (varnt-name-at t (- i 1))))
    (VNil [] -1)))

(defn vlist-fields-at [vs :- &VList i :- i64] :- TyList
  (match vs
    (VCons [h t]
      (if (= i 0)
        (match h (Varnt [vn fields] (clone fields)))
        (vlist-fields-at t (- i 1))))
    (VNil [] (TyNil))))

(defn varnt-fields-at [adts :- &AdtTab t :- i64 vi :- i64] :- TyList
  (match adts
    (ATCons [h rest]
      (if (= t 0)
        (match h (AdtInfo [name tps variants tpl tplargs] (vlist-fields-at variants vi)))
        (varnt-fields-at rest (- t 1) vi)))
    (ATNil [] (TyNil))))
; hexpr.cato — S6: the kernel's typed IR.
;
; One recursive HExpr ADT mirroring the seed's `HExpr` arms for the subset.
; Children ride chains (the deftype field grammar allows no vectors of
; ADTs); optional children are `HENil`; optional types are `t-none`.
;
;   HExprs — ordered children (call args, str args, Seq, ctor args)
;   Binds  — let/loop bindings: (name sid, value, ty)
;   HArms  — match arms: (variant, binders, body); variant -1 is `_`
;   Caps   — closure captures: (name, ty, own)
;
; The move checker rebuilds nodes (functional rewrite) to fill the
; seed's post-`plan_drops` annotations: `HLet` frees, `HConj` in_place,
; `HClosure` capture own-bits.

(deftype HExprs (HENil) (HECons [kid :- HExpr next :- HExprs]))

(deftype Binds (BNil) (BCons [name :- i64 v :- HExpr ty :- Ty next :- Binds]))

(deftype HArms (HANil) (HACons [variant :- i64 binders :- Sids body :- HExpr next :- HArms]))

(deftype Caps (CNil) (CCons [name :- i64 ty :- Ty own :- i64 next :- Caps]))

(deftype VVals (VVNil)
  (VVI64 [v :- i64 next :- VVals])
  (VVF64 [v :- f64 next :- VVals]))

(deftype HExpr
  (HConstI64 [v :- i64])
  (HConstF64 [v :- f64])
  (HConstB [v :- i64])
  (HVar [name :- i64])
  (HStrLit [v :- str])
  (HVecLit [el :- i64 vals :- VVals])
  (HBinW [op :- i64 a :- HExpr b :- HExpr ty :- Ty])
  (HBinF [op :- i64 a :- HExpr b :- HExpr])
  (HCmpW [op :- i64 a :- HExpr b :- HExpr ty :- Ty])
  (HStrCmp [pol :- i64 a :- HExpr b :- HExpr])
  (HStrOrd [op :- i64 a :- HExpr b :- HExpr])
  (HICast [e :- HExpr from :- Ty to :- Ty])
  (HCount [e :- HExpr])
  (HToStr [e :- HExpr ty :- Ty])
  (HStrCat [args :- HExprs])
  (HSubs [s :- HExpr a :- HExpr b :- HExpr])
  (HSplit [s :- HExpr sep :- HExpr])
  (HJoin [sep :- HExpr xs :- HExpr])
  (HStrNth [s :- HExpr idx :- HExpr res :- Ty])
  (HCharStr [e :- HExpr])
  (HGet [src :- HExpr idx :- HExpr dflt :- HExprs ty :- Ty res :- Ty])
  (HConj [v :- HExpr x :- HExpr el :- i64 inplace :- i64])
  (HIf [c :- HExpr t :- HExpr e :- HExpr ty :- Ty])
  (HAnd [a :- HExpr b :- HExpr])
  (HOr [a :- HExpr b :- HExpr])
  (HNot [e :- HExpr])
  (HAbs [e :- HExpr ty :- Ty])
  (HMin [a :- HExpr b :- HExpr ty :- Ty])
  (HMax [a :- HExpr b :- HExpr ty :- Ty])
  (HSeq [es :- HExprs])
  (HLet [binds :- Binds body :- HExpr frees :- Sids])
  (HLoop [binds :- Binds ty :- Ty body :- HExpr])
  (HRecur [args :- HExprs])
  (HCtor [adt :- i64 variant :- i64 args :- HExprs])
  (HMatch [scrut :- HExpr arms :- HArms ty :- Ty])
  (HClone [e :- HExpr])
  (HDrop [e :- HExpr])
  (HClosure [sig :- i64 mangled :- i64 params :- PList caps :- Caps body :- HExpr])
  (HClosureCall [f :- HExpr args :- HExprs sig :- i64])
  (HCall [name :- i64 args :- HExprs])
  (HSlurp [p :- HExpr])
  (HSpit [path :- HExpr data :- HExpr])
  (HArgs)
  (HExit [e :- HExpr])
  (HParseNum [s :- HExpr int :- i64 res :- Ty]))

; --- chains -----------------------------------------------------------------

(defn hes-null [ks :- &HExprs] :- bool
  (match ks
    (HENil [] true)
    (HECons [kid next] false)))

(defn hes-depth [ks :- &HExprs] :- i64
  (match ks
    (HECons [kid next] (+ 1 (hes-depth next)))
    (HENil [] 0)))

(defn hes-rev [ks :- HExprs acc :- HExprs] :- HExprs
  (match ks
    (HECons [kid next] (hes-rev next (HECons kid acc)))
    (HENil [] acc)))

(defn binds-depth [ks :- &Binds] :- i64
  (match ks
    (BCons [name v ty next] (+ 1 (binds-depth next)))
    (BNil [] 0)))

(defn binds-rev [ks :- Binds acc :- Binds] :- Binds
  (match ks
    (BCons [name v ty next] (binds-rev next (BCons name v ty acc)))
    (BNil [] acc)))

(defn arms-depth [ks :- &HArms] :- i64
  (match ks
    (HACons [variant binders body next] (+ 1 (arms-depth next)))
    (HANil [] 0)))

(defn caps-depth [ks :- &Caps] :- i64
  (match ks
    (CCons [name ty own next] (+ 1 (caps-depth next)))
    (CNil [] 0)))

(defn vvals-depth [ks :- &VVals] :- i64
  (match ks
    (VVI64 [v next] (+ 1 (vvals-depth next)))
    (VVF64 [v next] (+ 1 (vvals-depth next)))
    (VVNil [] 0)))

(defn arms-rev [ks :- HArms acc :- HArms] :- HArms
  (match ks
    (HACons [variant binders body next] (arms-rev next (HACons variant binders body acc)))
    (HANil [] acc)))

; Get's optional default (absent = HENil)
(defn hget-dflt [e :- HExpr] :- HExprs
  (match e
    (HConstI64 [_] (HENil))
    (HConstF64 [_] (HENil))
    (HConstB [_] (HENil))
    (HVar [_] (HENil))
    (HStrLit [_] (HENil))
    (HVecLit [_ _] (HENil))
    (HBinW [_ _ _ _] (HENil))
    (HBinF [_ _ _] (HENil))
    (HCmpW [_ _ _ _] (HENil))
    (HStrCmp [_ _ _] (HENil))
    (HStrOrd [_ _ _] (HENil))
    (HICast [_ _ _] (HENil))
    (HCount [_] (HENil))
    (HToStr [_ _] (HENil))
    (HStrCat [_] (HENil))
    (HSubs [_ _ _] (HENil))
    (HSplit [_ _] (HENil))
    (HJoin [_ _] (HENil))
    (HStrNth [_ _ _] (HENil))
    (HCharStr [_] (HENil))
    (HGet [src idx dflt ty res] dflt)
    (HConj [_ _ _ _] (HENil))
    (HIf [_ _ _ _] (HENil))
    (HAnd [_ _] (HENil))
    (HOr [_ _] (HENil))
    (HNot [_] (HENil))
    (HAbs [_ _] (HENil))
    (HMin [_ _ _] (HENil))
    (HMax [_ _ _] (HENil))
    (HSeq [_] (HENil))
    (HLet [_ _ _] (HENil))
    (HLoop [_ _ _] (HENil))
    (HRecur [_] (HENil))
    (HCtor [_ _ _] (HENil))
    (HMatch [_ _ _] (HENil))
    (HClone [_] (HENil))
    (HDrop [_] (HENil))
    (HClosure [_ _ _ _ _] (HENil))
    (HClosureCall [_ _ _] (HENil))
    (HCall [_ _] (HENil))
    (HSlurp [_] (HENil))
    (HSpit [_ _] (HENil))
    (HArgs [] (HENil))
    (HExit [_] (HENil))
    (HParseNum [_ _ _] (HENil))))

(defn o-hgd [] :- HExprs
  (HENil))

; Recur's argument chain (the args field; empty elsewhere)
(defn recur-args [e :- HExpr] :- HExprs
  (match e
    (HRecur [args] args)
    (HConstI64 [_] (HENil))
    (HConstF64 [_] (HENil))
    (HConstB [_] (HENil))
    (HVar [_] (HENil))
    (HStrLit [_] (HENil))
    (HVecLit [_ _] (HENil))
    (HBinW [_ _ _ _] (HENil))
    (HBinF [_ _ _] (HENil))
    (HCmpW [_ _ _ _] (HENil))
    (HStrCmp [_ _ _] (HENil))
    (HStrOrd [_ _ _] (HENil))
    (HICast [_ _ _] (HENil))
    (HCount [_] (HENil))
    (HToStr [_ _] (HENil))
    (HStrCat [_] (HENil))
    (HSubs [_ _ _] (HENil))
    (HSplit [_ _] (HENil))
    (HJoin [_ _] (HENil))
    (HStrNth [_ _ _] (HENil))
    (HCharStr [_] (HENil))
    (HGet [_ _ _ _ _] (HENil))
    (HConj [_ _ _ _] (HENil))
