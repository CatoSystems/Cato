(defn hclo-caps [e :- HExpr] :- Caps
  (match e
    (HClosure [sig mangled params caps body] caps)
    (HConstI64 [_] (CNil))
    (HConstF64 [_] (CNil))
    (HConstB [_] (CNil))
    (HVar [_] (CNil))
    (HStrLit [_] (CNil))
    (HVecLit [_ _] (CNil))
    (HBinW [_ _ _ _] (CNil))
    (HBinF [_ _ _] (CNil))
    (HCmpW [_ _ _ _] (CNil))
    (HStrCmp [_ _ _] (CNil))
    (HStrOrd [_ _ _] (CNil))
    (HICast [_ _ _] (CNil))
    (HCount [_] (CNil))
    (HToStr [_ _] (CNil))
    (HStrCat [_] (CNil))
    (HSubs [_ _ _] (CNil))
    (HSplit [_ _] (CNil))
    (HJoin [_ _] (CNil))
    (HStrNth [_ _ _] (CNil))
    (HCharStr [_] (CNil))
    (HGet [_ _ _ _ _] (CNil))
    (HConj [_ _ _ _] (CNil))
    (HIf [_ _ _ _] (CNil))
    (HAnd [_ _] (CNil))
    (HOr [_ _] (CNil))
    (HNot [_] (CNil))
    (HAbs [_ _] (CNil))
    (HMin [_ _ _] (CNil))
    (HMax [_ _ _] (CNil))
    (HSeq [_] (CNil))
    (HLet [_ _ _] (CNil))
    (HLoop [_ _ _] (CNil))
    (HRecur [_] (CNil))
    (HCtor [_ _ _] (CNil))
    (HMatch [_ _ _] (CNil))
    (HClone [_] (CNil))
    (HDrop [_] (CNil))
    (HClosureCall [_ _ _] (CNil))
    (HCall [_ _] (CNil))
    (HSlurp [_] (CNil))
    (HSpit [_ _] (CNil))
    (HArgs [] (CNil))
    (HExit [_] (CNil))
    (HParseNum [_ _ _] (CNil))))

(defn hclo-body [e :- HExpr] :- HExpr
  (match e
    (HClosure [sig mangled params caps body] body)
    (HConstI64 [_] (HConstI64 0))
    (HConstF64 [_] (HConstI64 0))
    (HConstB [_] (HConstI64 0))
    (HVar [_] (HConstI64 0))
    (HStrLit [_] (HConstI64 0))
    (HVecLit [_ _] (HConstI64 0))
    (HBinW [_ _ _ _] (HConstI64 0))
    (HBinF [_ _ _] (HConstI64 0))
    (HCmpW [_ _ _ _] (HConstI64 0))
    (HStrCmp [_ _ _] (HConstI64 0))
    (HStrOrd [_ _ _] (HConstI64 0))
    (HICast [_ _ _] (HConstI64 0))
    (HCount [_] (HConstI64 0))
    (HToStr [_ _] (HConstI64 0))
    (HStrCat [_] (HConstI64 0))
    (HSubs [_ _ _] (HConstI64 0))
    (HSplit [_ _] (HConstI64 0))
    (HJoin [_ _] (HConstI64 0))
    (HStrNth [_ _ _] (HConstI64 0))
    (HCharStr [_] (HConstI64 0))
    (HGet [_ _ _ _ _] (HConstI64 0))
    (HConj [_ _ _ _] (HConstI64 0))
    (HIf [_ _ _ _] (HConstI64 0))
    (HAnd [_ _] (HConstI64 0))
    (HOr [_ _] (HConstI64 0))
    (HNot [_] (HConstI64 0))
    (HAbs [_ _] (HConstI64 0))
    (HMin [_ _ _] (HConstI64 0))
    (HMax [_ _ _] (HConstI64 0))
    (HSeq [_] (HConstI64 0))
    (HLet [_ _ _] (HConstI64 0))
    (HLoop [_ _ _] (HConstI64 0))
    (HRecur [_] (HConstI64 0))
    (HCtor [_ _ _] (HConstI64 0))
    (HMatch [_ _ _] (HConstI64 0))
    (HClone [_] (HConstI64 0))
    (HDrop [_] (HConstI64 0))
    (HClosureCall [_ _ _] (HConstI64 0))
    (HCall [_ _] (HConstI64 0))
    (HSlurp [_] (HConstI64 0))
    (HSpit [_ _] (HConstI64 0))
    (HArgs [] (HConstI64 0))
    (HExit [_] (HConstI64 0))
    (HParseNum [_ _ _] (HConstI64 0))))

(defn hloop-binds [e :- HExpr] :- Binds
  (match e
    (HLoop [binds ty body] binds)
    (HConstI64 [_] (BNil))
    (HConstF64 [_] (BNil))
    (HConstB [_] (BNil))
    (HVar [_] (BNil))
    (HStrLit [_] (BNil))
    (HVecLit [_ _] (BNil))
    (HBinW [_ _ _ _] (BNil))
    (HBinF [_ _ _] (BNil))
    (HCmpW [_ _ _ _] (BNil))
    (HStrCmp [_ _ _] (BNil))
    (HStrOrd [_ _ _] (BNil))
    (HICast [_ _ _] (BNil))
    (HCount [_] (BNil))
    (HToStr [_ _] (BNil))
    (HStrCat [_] (BNil))
    (HSubs [_ _ _] (BNil))
    (HSplit [_ _] (BNil))
    (HJoin [_ _] (BNil))
    (HStrNth [_ _ _] (BNil))
    (HCharStr [_] (BNil))
    (HGet [_ _ _ _ _] (BNil))
    (HConj [_ _ _ _] (BNil))
    (HIf [_ _ _ _] (BNil))
    (HAnd [_ _] (BNil))
    (HOr [_ _] (BNil))
    (HNot [_] (BNil))
    (HAbs [_ _] (BNil))
    (HMin [_ _ _] (BNil))
    (HMax [_ _ _] (BNil))
    (HSeq [_] (BNil))
    (HLet [_ _ _] (BNil))
    (HRecur [_] (BNil))
    (HCtor [_ _ _] (BNil))
    (HMatch [_ _ _] (BNil))
    (HClone [_] (BNil))
    (HDrop [_] (BNil))
    (HClosure [_ _ _ _ _] (BNil))
    (HClosureCall [_ _ _] (BNil))
    (HCall [_ _] (BNil))
    (HSlurp [_] (BNil))
    (HSpit [_ _] (BNil))
    (HArgs [] (BNil))
    (HExit [_] (BNil))
    (HParseNum [_ _ _] (BNil))))

(defn hctor-adt [e :- &HExpr] :- i64
  (match e
    (HCtor [adt variant args] adt)
    (HConstI64 [_] -1)
    (HConstF64 [_] -1)
    (HConstB [_] -1)
    (HVar [_] -1)
    (HStrLit [_] -1)
    (HVecLit [_ _] -1)
    (HBinW [_ _ _ _] -1)
    (HBinF [_ _ _] -1)
    (HCmpW [_ _ _ _] -1)
    (HStrCmp [_ _ _] -1)
    (HStrOrd [_ _ _] -1)
    (HICast [_ _ _] -1)
    (HCount [_] -1)
    (HToStr [_ _] -1)
    (HStrCat [_] -1)
    (HSubs [_ _ _] -1)
    (HSplit [_ _] -1)
    (HJoin [_ _] -1)
    (HStrNth [_ _ _] -1)
    (HCharStr [_] -1)
    (HGet [_ _ _ _ _] -1)
    (HConj [_ _ _ _] -1)
    (HIf [_ _ _ _] -1)
    (HAnd [_ _] -1)
    (HOr [_ _] -1)
    (HNot [_] -1)
    (HAbs [_ _] -1)
    (HMin [_ _ _] -1)
    (HMax [_ _ _] -1)
    (HSeq [_] -1)
    (HLet [_ _ _] -1)
    (HLoop [_ _ _] -1)
    (HRecur [_] -1)
    (HMatch [_ _ _] -1)
    (HClone [_] -1)
    (HDrop [_] -1)
    (HClosure [_ _ _ _ _] -1)
    (HClosureCall [_ _ _] -1)
    (HCall [_ _] -1)
    (HSlurp [_] -1)
    (HSpit [_ _] -1)
    (HArgs [] -1)
    (HExit [_] -1)
    (HParseNum [_ _ _] -1)))

(defn hparse-res [e :- &HExpr] :- Ty
  (match e
    (HParseNum [s intf res] (clone res))
    (HConstI64 [_] (t-none))
    (HConstF64 [_] (t-none))
    (HConstB [_] (t-none))
    (HVar [_] (t-none))
    (HStrLit [_] (t-none))
    (HVecLit [_ _] (t-none))
    (HBinW [_ _ _ _] (t-none))
    (HBinF [_ _ _] (t-none))
    (HCmpW [_ _ _ _] (t-none))
    (HStrCmp [_ _ _] (t-none))
    (HStrOrd [_ _ _] (t-none))
    (HICast [_ _ _] (t-none))
    (HCount [_] (t-none))
    (HToStr [_ _] (t-none))
    (HStrCat [_] (t-none))
    (HSubs [_ _ _] (t-none))
    (HSplit [_ _] (t-none))
    (HJoin [_ _] (t-none))
    (HStrNth [_ _ _] (t-none))
    (HCharStr [_] (t-none))
    (HGet [_ _ _ _ _] (t-none))
    (HConj [_ _ _ _] (t-none))
    (HIf [_ _ _ _] (t-none))
    (HAnd [_ _] (t-none))
    (HOr [_ _] (t-none))
    (HNot [_] (t-none))
    (HAbs [_ _] (t-none))
    (HMin [_ _ _] (t-none))
    (HMax [_ _ _] (t-none))
    (HSeq [_] (t-none))
    (HLet [_ _ _] (t-none))
    (HLoop [_ _ _] (t-none))
    (HRecur [_] (t-none))
    (HCtor [_ _ _] (t-none))
    (HMatch [_ _ _] (t-none))
    (HClone [_] (t-none))
    (HDrop [_] (t-none))
    (HClosure [_ _ _ _ _] (t-none))
    (HClosureCall [_ _ _] (t-none))
    (HCall [_ _] (t-none))
    (HSlurp [_] (t-none))
    (HSpit [_ _] (t-none))
    (HArgs [] (t-none))
    (HExit [_] (t-none))))
; STATUS: S6 complete — the full pipeline runs and the differential test
; is green: expand (S5/S6) → build-program (pass 0a/0b headers, pass 1
; raws, plain-defn lowering in source order, externs, mono instances
; appended) → move check (moveck.cato, the BCheck port: frees/in_place/
; capture-own bits) → dump (dump.cato, the wire grammar). The Rust oracle
; serializes the seed's build_program_located output with the same grammar
; and the fixtures corpus (hir/fixtures/) is byte-identical on both sides
; (crates/cato-backend-interp/tests/kernel_hir.rs). Driver modes: `ast`
; (expander differential) and default (typed-IR dump).

(deftype LRes (LOk [tab :- i64 adts :- AdtTab insts :- IMap
                   sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                   defs :- Defns e :- HExpr])
             (LErr [msg :- str]))

(defn lok [tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
          lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
          e :- HExpr] :- LRes
  (LOk tab adts insts sigs lams rets ncached defs e))

; --- ast atom accessors (typed reads off tag checks) ------------------------

(defn ast-int-of [a :- &Ast] :- i64
  (match a
    (ANil [at] 0)
    (ASym [sid at] 0)
    (AInt [v at] v)
    (AF64 [v at] 0)
    (ABool [v at] 0)
    (AStr [v at] 0)
    (AList [ks at] 0)
    (AVec [ks at] 0)
    (AMap [ks at] 0)
    (ASet [ks at] 0)))

(defn ast-f64-of [a :- &Ast] :- f64
  (match a
    (ANil [at] 0.0)
    (ASym [sid at] 0.0)
    (AInt [v at] 0.0)
    (AF64 [v at] v)
    (ABool [v at] 0.0)
    (AStr [v at] 0.0)
    (AList [ks at] 0.0)
    (AVec [ks at] 0.0)
    (AMap [ks at] 0.0)
    (ASet [ks at] 0.0)))

; payload accessors for tag-checked atoms (avoids 10-arm matches at
; every use)
(defn ast-bool-of [a :- &Ast] :- i64
  (match a
    (ANil [at] 0)
    (ASym [sid at] 0)
    (AInt [v at] 0)
    (AF64 [v at] 0)
    (ABool [v at] v)
    (AStr [v at] 0)
    (AList [ks at] 0)
    (AVec [ks at] 0)
    (AMap [ks at] 0)
    (ASet [ks at] 0)))

(defn ast-str-of [a :- &Ast] :- str
  (match a
    (ANil [at] "")
    (ASym [sid at] "")
    (AInt [v at] "")
    (AF64 [v at] "")
    (ABool [v at] "")
    (AStr [v at] (clone v))
    (AList [ks at] "")
    (AVec [ks at] "")
    (AMap [ks at] "")
    (ASet [ks at] "")))

(defn kids-all-int [ks :- Asts] :- bool
  (match ks
    (KNil [] true)
    (KCons [kid rest] (and (= (ast-tag kid) 2) (kids-all-int rest)))))

(defn kids-all-num [ks :- Asts] :- bool
  (match ks
    (KNil [] true)
    (KCons [kid rest]
      (let [t (ast-tag kid)]
        (and (or (= t 2) (= t 3)) (kids-all-num rest))))))

(defn kids-i64s [ks :- Asts acc :- VVals] :- VVals
  (match ks
    (KNil [] (vvals-rev acc (VVNil)))
    (KCons [kid rest]
      (match kid
        (AInt [v at] (kids-i64s rest (VVI64 v acc)))
        (ANil [at] (VVNil))
        (ASym [sid at] (VVNil))
        (AF64 [v at] (VVNil))
        (ABool [v at] (VVNil))
        (AStr [v at] (VVNil))
        (AList [ks2 at] (VVNil))
        (AVec [ks2 at] (VVNil))
        (AMap [ks2 at] (VVNil))
        (ASet [ks2 at] (VVNil))))))

(defn kids-f64s [ks :- Asts acc :- VVals] :- VVals
  (match ks
    (KNil [] (vvals-rev acc (VVNil)))
    (KCons [kid rest]
      (match kid
        (AInt [v at] (kids-f64s rest (VVF64 (f64 v) acc)))
        (AF64 [v at] (kids-f64s rest (VVF64 v acc)))
        (ANil [at] (VVNil))
        (ASym [sid at] (VVNil))
        (ABool [v at] (VVNil))
        (AStr [v at] (VVNil))
        (AList [ks2 at] (VVNil))
        (AVec [ks2 at] (VVNil))
        (AMap [ks2 at] (VVNil))
        (ASet [ks2 at] (VVNil))))))

(defn vvals-rev [ks :- VVals acc :- VVals] :- VVals
  (match ks
    (VVI64 [v next] (vvals-rev next (VVI64 v acc)))
    (VVF64 [v next] (vvals-rev next (VVF64 v acc)))
    (VVNil [] acc)))

; --- entry -------------------------------------------------------------------

(defn lower-x [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
              insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
              ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower a env (t-none) tab adts insts sigs lams rets ncached defs raws))

(defn lower [a :- Ast env :- TyEnv expected :- Ty tab :- i64
            adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
            rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [tag (ast-tag a)]
    (cond
      (= tag 2)
      (lok tab adts insts sigs lams rets ncached defs (HConstI64 (ast-int-of a)))

      (= tag 3)
      (lok tab adts insts sigs lams rets ncached defs (HConstF64 (ast-f64-of a)))

      (= tag 9)
      (lok tab adts insts sigs lams rets ncached defs (HConstB (ast-bool-of a)))

      (= tag 4)
      (lok tab adts insts sigs lams rets ncached defs (HStrLit (ast-str-of a)))

      (= tag 1)
      (let [sid (ast-sid-of a)]
        (if (te-has env sid)
          (lok tab adts insts sigs lams rets ncached defs (HVar sid))
          (LErr (str "unbound variable " (sym-str (clone tab) sid)))))

      (= tag 6)
      (lower-veclit (clone a) (clone env) tab adts insts sigs lams rets ncached defs)

      (= tag 5)
      (lower-list (clone a) (clone env) expected tab adts insts sigs lams rets ncached defs raws)

      (LErr "unsupported map/set literal"))))

(defn lower-veclit [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns] :- LRes
  (match a
    (AVec [kids at]
      (cond
        (kids-all-int (clone kids))
        (lok tab adts insts sigs lams rets ncached defs
             (HVecLit 0 (kids-i64s (clone kids) (VVNil))))

        (kids-all-num (clone kids))
        (lok tab adts insts sigs lams rets ncached defs
             (HVecLit 1 (kids-f64s kids (VVNil))))

        (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))")))
    (ANil [at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ASym [sid at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AInt [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AF64 [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ABool [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AStr [v at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AList [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (AMap [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))
    (ASet [ks at] (LErr "vector literal not supported (use (vec-i64 ...) / (vec-f64 ...))"))))

; --- typing (ty_of) ----------------------------------------------------------

; Reads only: raws/rets/sigs are caller-cloned. Mirrors `ty_of`.
(defn ty-of [e :- &HExpr env :- &TyEnv rets :- &TyEnv sigs :- &Sigs] :- Ty
  ; Reads only: env/rets/sigs are passed by reference (no per-call clone),
  ; and the HLet/HSeq/HClone arms recurse over borrowed children. Mirrors
  ; `ty_of`; the rets table holds static non-generic rets + mono rets, so the
  ; Call arm is a lookup and the seed's i64 fallback covers print-* et al.
  (match e
    (HConstI64 [v] (t-i64))
    (HConstF64 [v] (t-f64))
    (HConstB [v] (t-bool))
    (HVar [name] (te-get env name))
    (HStrLit [v] (t-str))
    (HVecLit [el vals] (t-vec el))
    (HBinW [op a b ty] (clone ty))
    (HBinF [op a b] (t-f32))
    (HCmpW [op a b ty] (t-bool))
    (HStrCmp [pol a b] (t-bool))
    (HStrOrd [op a b] (t-bool))
    (HICast [e2 from to] (clone to))
    (HCount [x] (t-i64))
    (HToStr [x ty] (t-str))
    (HStrCat [args] (t-str))
    (HSubs [s a b] (t-str))
    (HSplit [s sep] (t-vec 2))
    (HJoin [sep xs] (t-str))
    (HStrNth [s idx res] (clone res))
    (HCharStr [x] (t-str))
    (HGet [src idx dflt ty res] (if (ty-noneq res) (clone ty) (clone res)))
    (HConj [v x el inplace] (t-vec el))
    (HIf [c t2 e2 ty] (clone ty))
    (HAnd [a b] (t-bool))
    (HOr [a b] (t-bool))
    (HNot [x] (t-bool))
    (HAbs [x ty] (clone ty))
    (HMin [a b ty] (clone ty))
    (HMax [a b ty] (clone ty))
    (HSeq [es] (if (hes-null es) (t-i64) (h-seq-last es env rets sigs)))
    (HLet [binds body frees]
      (ty-of body (binds-extend (clone binds) (clone env)) rets sigs))
    (HLoop [binds ty body] (clone ty))
    (HRecur [args] (t-i64))
    (HCtor [adt variant args] (t-adt adt))
    (HMatch [scrut arms ty] (clone ty))
    (HClone [x] (ty-of x env rets sigs))
    (HDrop [x] (t-i64))
    (HClosure [sig mangled params caps body] (t-fn sig))
    (HClosureCall [f args sig]
      (match (sigs-at sigs sig)
        (Sig [params r] r)))
    (HCall [name args] (if (= name (s-evenq)) (t-bool) (h-call-ty rets name)))
    (HSlurp [p] (t-str))
    (HSpit [path data] (t-i64))
    (HArgs [] (t-vec 2))
    (HExit [x] (t-i64))
    (HParseNum [s int res] (clone res))))

(defn ty-noneq [x :- &Ty] :- bool
  (= (ty-tag x) 19))

(defn h-seq-last [es :- &HExprs env :- &TyEnv rets :- &TyEnv sigs :- &Sigs] :- Ty
  (if (hes-null (asts-tail-hes es))
    (ty-of (hes-head-hes es) env rets sigs)
    (h-seq-last (asts-tail-hes es) env rets sigs)))

(defn asts-tail-hes [ks :- &HExprs] :- HExprs
  (match ks
    (HECons [kid next] (clone next))
    (HENil [] (HENil))))

(defn hes-head-hes [ks :- &HExprs] :- HExpr
  (match ks
    (HECons [kid next] (clone kid))
    (HENil [] (HConstI64 0))))

(defn binds-extend [binds :- Binds env :- TyEnv] :- TyEnv
  (match binds
    (BCons [name v ty next]
      (binds-extend next (te-put env name ty)))
    (BNil [] env)))

; A flat tag walk (mirrors the variant order of the HExpr deftype).
(defn h-tag [e :- &HExpr] :- i64
  (match e
    (HConstI64 [v] 0)
    (HConstF64 [v] 1)
    (HConstB [v] 2)
    (HVar [name] 3)
    (HStrLit [v] 4)
    (HVecLit [el vals] 5)
    (HBinW [op a b ty] 6)
    (HBinF [op a b] 7)
    (HCmpW [op a b ty] 8)
    (HStrCmp [pol a b] 9)
    (HStrOrd [op a b] 10)
    (HICast [e from to] 11)
    (HCount [e] 12)
    (HToStr [e ty] 13)
    (HStrCat [args] 14)
    (HSubs [s a b] 15)
    (HSplit [s sep] 16)
    (HJoin [sep xs] 17)
    (HStrNth [s idx res] 18)
    (HCharStr [e] 19)
    (HGet [src idx dflt ty res] 20)
    (HConj [v x el inplace] 21)
    (HIf [c t e ty] 22)
    (HAnd [a b] 23)
    (HOr [a b] 24)
    (HNot [e] 25)
    (HAbs [e ty] 26)
    (HMin [a b ty] 27)
    (HMax [a b ty] 28)
    (HSeq [es] 29)
    (HLet [binds body frees] 30)
    (HLoop [binds ty body] 31)
    (HRecur [args] 32)
    (HCtor [adt variant args] 33)
    (HMatch [scrut arms ty] 34)
    (HClone [e] 35)
    (HDrop [e] 36)
    (HClosure [sig mangled params caps body] 37)
    (HClosureCall [f args sig] 38)
    (HCall [name args] 39)
    (HSlurp [p] 40)
    (HSpit [path data] 41)
    (HArgs [] 42)
    (HExit [e] 43)
    (HParseNum [s int res] 44)))

; --- arithmetic / comparison helpers -----------------------------------------

; coerce_f64: wrap an i64-typed expression when an f64 result is wanted.
(defn coerce-f64 [e :- HExpr cur :- Ty want :- bool] :- HExpr
  (if (and want (not (ty-eq (clone cur) (t-f64))))
    (HICast e cur (t-f64))
    e))

; promote_pair: both operands numeric and equal-width (no silent mixing).
(defn promote-pair [a :- HExpr b :- HExpr env :- &TyEnv rets :- &TyEnv sigs :- Sigs] :- PRes
  (let [at (ty-of a env rets sigs)
        bt (ty-of b env rets sigs)]
    (if (or (is-adt-or-str (clone at)) (is-adt-or-str (clone bt)))
      (PResErr "ADT and string values cannot be used in arithmetic")
      (if (and (ty-eq (clone at) (clone bt)) (is-numeric-ty (clone at)))
        (PResOk (clone a) (clone b))
        (PResErr (str "cannot mix " (ty-name (clone at)) " and " (ty-name (clone bt))
                      " in arithmetic — cast explicitly with ("
                      (if (or (is-float-ty at) (is-float-ty bt)) "f64" "i64") ") e"))))))

(defn is-adt-or-str [x :- Ty] :- bool
  (let [t (ty-tag x)]
    (or (= t 16) (= t 12))))

(deftype PRes (PResOk [a :- HExpr b :- HExpr]) (PResErr [msg :- str]))

; BinOp code of an arithmetic head
(defn arith-op [sid :- i64] :- i64
  (cond
    (= sid (s-add)) 0
    (= sid (s-sub)) 1
    (= sid (s-mul)) 2
    3))

(defn cmp-op [sid :- i64] :- i64
  (cond
    (= sid (s-eq)) 0
    (= sid (s-ne)) 1
    (= sid (s-lt)) 2
    (= sid (s-gt)) 3
    (= sid (s-le)) 4
    5))

; promote_bin: BinF for f32, BinW carrying the width otherwise.
(defn promote-bin [op :- i64 a :- HExpr b :- HExpr env :- &TyEnv
                  rets :- &TyEnv sigs :- Sigs] :- LRes1
  (match (promote-pair a b env rets (clone sigs))
    (PResOk [a2 b2]
      (let [t (ty-of a2 env rets sigs)]
        (if (ty-eq (clone t) (t-f32))
          (LRes1Ok (HBinF op a2 b2))
          (LRes1Ok (HBinW op a2 b2 t)))))
    (PResErr [msg] (LRes1Err msg))))

(deftype LRes1 (LRes1Ok [e :- HExpr]) (LRes1Err [msg :- str]))

; Type names for diagnostics (the seed renders Debug shapes; the kernel
; uses readable names — diagnostics are not part of the byte contract).
(defn ty-name [x :- Ty] :- str
  (let [t (ty-tag x)]
    (cond
      (= t 0) "i64"
      (= t 1) "i32"
      (= t 2) "i8"
      (= t 3) "i16"
      (= t 4) "u8"
      (= t 5) "u16"
      (= t 6) "u32"
      (= t 7) "u64"
      (= t 8) "usize"
      (= t 9) "f64"
      (= t 10) "f32"
      (= t 11) "bool"
      (= t 12) "str"
      (= t 13) "map"
      (= t 14) "set"
      (= t 15) "vector"
      (= t 16) "adt"
      (= t 17) "fn"
      (= t 18) "param"
      "none")))

; --- unify + substitution (mono.rs) -------------------------------------------

(deftype URes (UResOk [subs :- TyEnv]) (UResErr))

; unify with a recursion cap standing in for the seed's seen-set.
(defn unify [pat :- Ty actual :- Ty subs :- &TyEnv] :- URes
  (unify-seen pat actual subs 0))

(defn unify-seen [pat :- Ty actual :- Ty subs :- &TyEnv depth :- i64] :- URes
  (if (> depth 100)
    (UResOk (clone subs))
    (let [pt (ty-tag pat)
          at (ty-tag actual)]
      (cond
        (= pt 18)
        (let [i (ty-arg pat)
              bound (te-get subs i)]
          (if (ty-noneq bound)
            (UResOk (te-put (clone subs) i (clone actual)))
            (if (ty-eq bound (clone actual))
              (UResOk (clone subs))
              (UResErr))))

        (and (= pt 15) (>= (ty-arg pat) 100) (= at 15))
        (unify-vec-pat (clone pat) (clone actual) subs depth)

        (and (ty-eq pat actual))
        (UResOk (clone subs))

        (UResErr)))))

(defn unify-vec-pat [pat :- Ty actual :- Ty subs :- &TyEnv depth :- i64] :- URes
  (let [elc (ty-arg pat)
        k (- elc 100)
        actual-el (match actual (Ty [t a] a))]
    (if (not (= (ty-tag actual) 15))
      (UResErr)
      (let [a (elem-ty actual-el)
            bound (te-get subs k)]
        (if (ty-noneq bound)
          (UResOk (te-put (clone subs) k a))
          (if (ty-eq bound a)
            (UResOk (clone subs))
            (UResErr)))))))

; ADT-to-ADT unification (a template against an instance of itself,
; field-wise) is a kernel restriction: ADT-typed generic parameters fail
; instantiation with a clear diagnostic instead of unifying. The seed
; supports them; S6 fixtures exercise scalar/vector-parameter generics,
; which behave identically on both sides.


; --- substitution (subst_ty) --------------------------------------------------

; Substitute bound type parameters through a type. ADT instances whose
; arguments still mention parameters re-instantiate (grows adts/tab):
; reported via SRes.
(deftype SRes (SRes [tab :- i64 adts :- AdtTab ty :- Ty msg :- str]))

(defn subst-ty [ty :- Ty subs :- &TyEnv tab :- i64 adts :- AdtTab] :- SRes
  (let [t (ty-tag ty)]
    (cond
      (= t 18)
      (let [bound (te-get subs (ty-arg ty))]
        (if (ty-noneq bound)
          (SRes tab (clone adts) (t-none) (str "unresolved type parameter " (ty-arg ty)))
          (SRes tab (clone adts) bound "")))

      (= t 15)
      (let [elc (ty-arg ty)]
        (if (>= elc 100)
          (let [bound (te-get subs (- elc 100))]
            (cond
              (ty-eq (clone bound) (t-i64)) (SRes tab (clone adts) (t-vec 0) "")
              (ty-eq (clone bound) (t-f64)) (SRes tab (clone adts) (t-vec 1) "")
              (= (ty-tag bound) 15)         (SRes tab (clone adts) (t-vec (ty-arg bound)) "")
              (SRes tab (clone adts) (t-none) (str "unresolved vector element parameter " (- elc 100)))))
          (SRes tab (clone adts) (clone ty) "")))

      ; an instance whose arguments mention parameters re-instantiates
      ; (the seed's subst_ty ADT arm); dedup makes this a cache hit when
      ; the args are already concrete
      (= t 16)
      (let [info (adts-at adts (ty-arg ty))]
        (match info
          (AdtInfo [name tps variants tpl tplargs]
            (if (>= tpl 0)
              (let [r (subst-ty-list tplargs subs tab (clone adts) (TyNil))]
                (match r
                  (SResL [tab2 adts2 args2 msg]
                    (if (> (count msg) 0)
                      (SRes tab2 adts2 (clone ty) msg)
                      (let [ri (instantiate-adt tpl args2
                                                (PS (clone tab2) (DLNil) adts2 (SGNil) (SNil) ""))]
                        (match ri
                          (PIARes [ps2 idx]
                            (if (ps-failed ps2)
                              ; read the message before the state moves
                              (let [m (ps-err-msg ps2)]
                                (SRes tab2 (ps-adts ps2) (clone ty) m))
                              (SRes (ps-tab ps2) (ps-adts ps2) (t-adt idx) "")))))))))
              (SRes tab (clone adts) (clone ty) "")))))

      (SRes tab adts ty ""))))

; the list form of subst-ty: every element substituted, in order
(deftype SResL (SResL [tab :- i64 adts :- AdtTab tys :- TyList msg :- str]))

(defn subst-ty-list [tys :- TyList subs :- &TyEnv tab :- i64 adts :- AdtTab
                    acc :- TyList] :- SResL
  (match tys
    (TyNil [] (SResL tab adts (tys-rev acc (TyNil)) ""))
    (TyCons [h t]
      (let [r (subst-ty h subs tab adts)]
        (match r
          (SRes [tab2 adts2 ty2 msg]
            (if (> (count msg) 0)
              (SResL tab2 adts2 (TyNil) msg)
              (subst-ty-list t subs tab2 adts2 (TyCons ty2 acc)))))))))

; --- monomorphization (instantiate) ---------------------------------------------

; Resolve a (possibly generic) callee for concrete argument types; mint
; and lower the instance on first encounter (cache-before-body, the
; seed's recursion rule).
(deftype MIRes (MIRes [tab :- i64 adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns mangled :- i64 ret :- Ty msg :- str]))

(defn ty-mangle-str2 [adts :- AdtTab tab :- i64 x :- Ty] :- str
  (ty-mangle-str adts tab x))

(defn instantiate [name :- i64 argtys :- TyList
                  tab :- i64 adts :- AdtTab insts :- IMap
                  sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                  defs :- Defns raws :- &Raws] :- MIRes
  (let [raw (raws-find raws name)]
    (match raw
      (RawDefn [rname params ret2 typarams isextern body rb]
        (if (= (sids-depth typarams) 0)
          (MIRes (clone tab) adts insts sigs lams rets ncached defs name ret2 "")
          (if (not (= (plist-depth params) (tys-depth argtys)))
            (MIRes (clone tab) adts insts sigs lams rets ncached defs name (t-none)
                   (str "function " (sym-str (clone tab) name) " expects " (plist-depth params) " argument(s), got " (tys-depth argtys)))
            (let [ru (unify-params (clone params) argtys (TENil))]
              (match ru
                (UResErr []
                  (MIRes (clone tab) adts insts sigs lams rets ncached defs name (t-none)
                         (str "cannot instantiate " (sym-str (clone tab) name) " with the given argument types")))
                (UResOk [subs]
                  ; check every parameter bound
                  (let [miss (unbound-param (clone typarams) subs)]
                    (if (not (= (sids-depth miss) 0))
                      (MIRes (clone tab) adts insts sigs lams rets ncached defs name (t-none)
                             (str "cannot infer type parameter of " (sym-str (clone tab) name)))
                      (let [suf (mangle-suffix typarams subs (clone adts) (clone tab) (SNil))
                            r2 (intern1 (clone tab) (str (sym-str (clone tab) name) "__" suf))]
                        (match r2
                          (I1Res [tab2 mangled]
                            (if (te-has rets mangled)
                              (MIRes tab2 adts insts sigs lams (clone rets) ncached defs mangled (te-get rets mangled) "")
                              (let [rs (subst-ty ret2 subs tab2 (clone adts))]
                                (match rs
                                  (SRes [tab3 adts3 mret msg3]
                                    (if (> (count msg3) 0)
                                      (MIRes tab3 adts3 (clone insts) (clone sigs) (clone lams) (clone rets) ncached (clone defs) mangled (t-none) msg3)
                                      (let [rp (subst-params params subs tab3 adts3 (PNil))]
                                        (match rp
                                          (SPRes [tab4 adts4 mparams msg4]
                                            (if (> (count msg4) 0)
                                              (MIRes tab4 adts4 (clone insts) (clone sigs) (clone lams) (clone rets) ncached (clone defs) mangled (t-none) msg4)
                                              ; register BEFORE the body lowers
                                              (let [nc2 (+ 1 ncached)
                                                    rets2 (te-put (clone rets) mangled mret)
                                                    ri (lower-body-raw body (binds-of-params (clone mparams)) (clone mret)
                                                                       (clone tab4) (clone adts4) (clone insts) (clone sigs) (clone lams) (clone rets2) nc2 (clone defs) raws)]
                                                (match ri
                                                  (LErr [msg] (MIRes tab4 adts4 (clone insts) (clone sigs) (clone lams) rets2 nc2 (clone defs) mangled (t-none) msg))
                                                  (LOk [tab5 adts5 insts5 sigs5 lams5 rets5 nc5 defs5 body]
                                                    (MIRes tab5 adts5 insts5 sigs5 lams5 rets5 nc5
                                                           (defns-append defs5 (Defn mangled mparams mret 0 body rb))
                                                           mangled mret "")))))))))))))))))))))))))))

; The lowered instance defn appends to the program's defn list at build
; time from insts order — the instance list records mangled name + ret +
; substituted params + body, so keep them in an extra table threaded in
; LRes... the insts IMap only carries mangled->?; extend: insts maps
; mangled sid -> (ordinal); the DEFS chain carries the Defn values.

; The mono instance defns in creation order (drained into the program's
; defn list after plain defns and externs, matching build.rs).
(defn raws-find [rs :- &Raws name :- i64] :- RawDefn
  (raws-find-2 rs name (RawDefn -1 (PNil) (t-none) (SNil) 0 (ANil (Span 0 0 0)) 0)))

(defn raws-find-2 [rs :- &Raws name :- i64 best :- RawDefn] :- RawDefn
  ; last-declared wins (the seed's HashMap overwrite on duplicates)
  (match rs
    (RCons [h t]
      (match h
        (RawDefn [rname params ret typarams isextern body rb]
          (if (= rname name)
            (raws-find-2 t name (clone h))
            (raws-find-2 t name best)))))
    (RNil [] best)))

(defn unify-params [params :- PList argtys :- TyList subs :- TyEnv] :- URes
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty _pb]
          (match argtys
            (TyNil [] (UResErr))
            (TyCons [a arest]
              (match (unify pty a subs)
                (UResErr [] (UResErr))
                (UResOk [subs2] (unify-params prest arest subs2))))))))
    (PNil []
      (if (tys-null argtys)
        (UResOk subs)
        (UResErr)))))

(defn unbound-param [typarams :- Sids subs :- &TyEnv] :- Sids
  ; the type parameters still unbound after unification (empty = all good)
  (unbound-param-2 typarams subs 0))

(defn unbound-param-2 [typarams :- Sids subs :- &TyEnv i :- i64] :- Sids
  (match typarams
    (SNil [] (SNil))
    (SCons [h t]
      (if (ty-noneq (te-get subs i))
        (SCons i (unbound-param-2 t subs (+ i 1)))
        (unbound-param-2 t subs (+ i 1))))))

(defn mangle-suffix [typarams :- Sids subs :- &TyEnv adts :- AdtTab tab :- i64 acc :- Sids] :- str
  ; suffix per type parameter, in declaration order, joined with _
  (mangle-suffix-2 typarams subs adts tab 0 "" 0))

(defn mangle-suffix-2 [typarams :- Sids subs :- &TyEnv adts :- AdtTab tab :- i64 i :- i64 acc :- str first :- i64] :- str
  (match typarams
    (SNil [] acc)
    (SCons [h t]
      (let [arg (te-get subs i)
            suf (ty-mangle-str (clone adts) (clone tab) arg)
            acc2 (if (= first 0) (str acc suf) (str acc "_" suf))]
        (mangle-suffix-2 t subs adts (clone tab) (+ i 1) acc2 0)))))

(deftype SPRes (SPRes [tab :- i64 adts :- AdtTab params :- PList msg :- str]))

(defn subst-params [params :- PList subs :- &TyEnv tab :- i64 adts :- AdtTab acc :- PList] :- SPRes
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty pb]
          (let [r (subst-ty pty subs tab adts)]
            (match r
              (SRes [tab2 adts2 ty msg]
                (if (> (count msg) 0)
                  (SPRes tab2 adts2 (PNil) msg)
                  (subst-params prest subs tab2 adts2 (PCons (Param pname ty pb) acc)))))))))
    (PNil [] (SPRes tab adts (plist-rev acc (PNil)) ""))))

(defn binds-of-params [params :- PList] :- TyEnv
  (match params
    (PCons [p prest]
      (match p
        (Param [pname pty _pb] (te-put (binds-of-params prest) pname pty))))
    (PNil [] (TENil))))

; lower a raw defn body (implicit do when multiple forms) — the instance
; body path of the seed's `instantiate`.
(defn lower-body-raw [body :- Ast env :- TyEnv expected :- Ty
                     tab :- i64 adts :- AdtTab insts :- IMap
                     sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                     defs :- Defns raws :- &Raws] :- LRes
  (let [bt (ast-tag body)]
    (if (and (= bt 5) (= (asts-head-sid (ast-kids-of (clone body))) (s-do)))
      (lower-do (asts-tail (ast-kids-of (clone body))) env expected tab adts insts sigs lams rets ncached defs raws)
      (lower (clone body) env expected tab adts insts sigs lams rets ncached defs raws))))

; --- ascription resolution (resolve_ann_ty) -----------------------------------

; Scalars (five), concrete ADT names, or applied ADTs — instantiate.
; Note the seed's narrow scalar list here: i8 in a let ascription fails.
(defn mk-ps [tab :- i64 adts :- AdtTab sigs :- Sigs] :- PS
  (PS tab (DLNil) adts sigs (SNil) ""))

(defn resolve-ann-args [els :- Asts tab :- i64 adts :- AdtTab sigs :- Sigs] :- PArgsRes
  (match els
    (KCons [e rest]
      (let [r (resolve-ann-ty e (clone tab) (clone adts) (clone sigs))]
        (match r
          (PTyRes [ps2 ty]
            (if (ps-failed ps2)
              (PArgsRes ps2 (TyNil))
              (let [rr (resolve-ann-args rest (clone tab) adts sigs)]
                (match rr
                  (PArgsRes [ps3 args] (PArgsRes ps3 (TyCons ty args))))))))))
    (KNil [] (PArgsRes (mk-ps (clone tab) adts sigs) (TyNil)))))

(defn resolve-ann-applied [a :- Ast tab :- i64 adts :- AdtTab sigs :- Sigs] :- PTyRes
  (match a
    (AList [kids at]
      (let [h (asts-head-sid kids)]
        ; `(Vector el)` — the built-in generic (S8: loop-bind annotations
        ; carry full type forms, e.g. the reader's `tab :- i64`)
        (if (= h (s-vec))
          (match (asts-tail kids)
            (KCons [eln rest]
              (if (asts-null rest)
                (let [es (sym-str (clone tab) (ast-sid-of eln))]
                  (cond
                    (= es "i64") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-vec 0))
                    (= es "f64") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-vec 1))
                    (= es "str") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-vec 2))
                    (PTyRes (ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                    (str "(Vector " es ") element must be i64, f64 or str")) (t-none))))
                (PTyRes (ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                "(Vector expects exactly one element type") (t-none))))
            (KNil [] (PTyRes (ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                "(Vector expects exactly one element type") (t-none))))
          (resolve-ann-adt a tab adts sigs h))))
    (_ (PTyRes (ps-err (mk-ps (clone tab) (clone adts) (clone sigs)) "type annotation must be a symbol or applied ADT") (t-none)))))

; the declared-ADT application path of resolve-ann-applied
(defn resolve-ann-adt [a :- Ast tab :- i64 adts :- AdtTab sigs :- Sigs h :- i64] :- PTyRes
  (match a
    (AList [kids at]
      (let [hit (find-declared-adts (clone adts) h 0)]
        (if (< (ty-arg-of-info (clone hit)) 0)
          (PTyRes (ps-err (mk-ps (clone tab) adts sigs) (str "unknown type name " (sym-str (clone tab) h))) (t-none))
          (let [rargs (resolve-ann-args (asts-tail kids) (clone tab) adts sigs)]
            (match rargs
              (PArgsRes [ps2 args]
                (if (ps-failed ps2)
                  (PTyRes ps2 (t-none))
                  (let [ri (instantiate-adt (info-idx hit) args ps2)]
                    (match ri
                      (PIARes [ps3 idx] (PTyRes ps3 (t-adt idx))))))))))))
    (ANil [at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (ASym [sid at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (AInt [v at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (AF64 [v at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (ABool [v at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (AStr [v at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (AVec [ks at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (AMap [ks at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))
    (ASet [ks at] (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))))

(defn resolve-ann-ty [a :- Ast tab :- i64 adts :- AdtTab sigs :- Sigs] :- PTyRes
  (let [tag (ast-tag a)]
    (cond
      (= tag 1)
      (let [s (sym-str (clone tab) (ast-sid-of a))]
        (cond
          (= s "i64")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-i64))
          (= s "i32")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-i32))
          (= s "f64")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-f64))
          (= s "bool") (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-bool))
          (= s "str")  (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-str))
          (let [sid (ast-sid-of a)
                hit (find-declared-adts (clone adts) sid 0)]
            (if (>= (ty-arg-of-info (clone hit)) 0)
              (if (= (info-tparams (clone hit)) 0)
                (PTyRes (mk-ps (clone tab) (clone adts) (clone sigs)) (t-adt (info-idx hit)))
                (PTyRes (ps-err (mk-ps (clone tab) (clone adts) (clone sigs))
                                (str s " expects " (info-tparams hit) " type argument(s)")) (t-none)))
              (PTyRes (ps-err (mk-ps (clone tab) (clone adts) (clone sigs)) (str "unknown type name " s)) (t-none))))))
      (= tag 5)
      (resolve-ann-applied (clone a) (clone tab) (clone adts) (clone sigs))
      (PTyRes (ps-err (mk-ps (clone tab) adts sigs) "type annotation must be a symbol or applied ADT") (t-none)))))

; find a DECLARED (non-instance) ADT by name sid; info-idx carries the
; combined index, -1 when absent
(defn find-declared-adts [ts :- AdtTab sid :- i64 i :- i64] :- AdtInfo2
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [name typarams variants tpl tplargs]
          (if (and (= name sid) (= tpl -1))
            (AdtInfo2 i h)
            (find-declared-adts t sid (+ i 1))))))
    (ATNil [] (AdtInfo2 -1 (AdtInfo -1 (SNil) (VNil) -1 (TyNil))))))

(deftype AdtInfo2 (AdtInfo2 [idx :- i64 info :- AdtInfo]))

(defn info-idx [x :- AdtInfo2] :- i64
  (match x (AdtInfo2 [idx info] idx)))

(defn info-tparams [x :- AdtInfo2] :- i64
  (match x
    (AdtInfo2 [idx info]
      (match info
        (AdtInfo [name typarams variants tpl tplargs] (sids-depth typarams))))))

(defn ty-arg-of-info [x :- AdtInfo2] :- i64
  (info-idx x))

; the (Option T) instance for two-argument get / nth / parse-*
(deftype OIRes (OIRes [tab :- i64 adts :- AdtTab idx :- i64]))

(defn option-instance [ty :- Ty tab :- i64 adts :- AdtTab sigs :- Sigs] :- OIRes
  ; the prelude's (Option a) is pinned at combined-table index 0
  (let [ps (PS tab (DLNil) adts sigs (SNil) "")
        r (instantiate-adt 0 (TyCons ty (TyNil)) ps)]
    (match r
      (PIARes [ps2 idx]
        (match ps2
          (PS [tab2 d2 a2 s2 y2 e2] (OIRes tab2 a2 idx)))))))

; --- sequences, let, if --------------------------------------------------------

; (do form...) — one form collapses to the form itself.
(defn lower-do [forms :- Asts env :- TyEnv expected :- Ty tab :- i64
               adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
               rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (asts-null forms)
    (lok tab adts insts sigs lams rets ncached defs (HConstI64 0))
    (lower-do-2 forms (HENil) env expected tab adts insts sigs lams rets ncached defs raws)))

(defn lower-do-2 [forms :- Asts acc :- HExprs env :- TyEnv expected :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [kid (asts-idx (clone forms) 0)
        rest (asts-tail forms)
        lastq (asts-null rest)
        exp (if lastq (clone expected) (t-none))
        r (lower kid (clone env) exp tab adts insts sigs lams rets ncached defs raws)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 e2]
        (if lastq
          (if (hes-null acc)
            (lok tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 e2)
            (lok tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2
                 (HSeq (hes-rev (HECons e2 acc) (HENil)))))
          (lower-do-2 rest (HECons e2 acc) env expected tab2 adts2 insts2 sigs2 lams2 rets2 nc2 defs2 raws))))))

; lower a single child expression (no expected type)
(defn lower-1 [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
              insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
              ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower a env (t-none) tab adts insts sigs lams rets ncached defs raws))

; lower with an expected type
(defn lower-e [a :- Ast env :- TyEnv expected :- Ty tab :- i64
              adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
              rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower a env expected tab adts insts sigs lams rets ncached defs raws))

; --- if (forms.rs lower_if) -----------------------------------------------------

; does every path through e end in a recur? Such an expression never
; completes with a value, so an if with it on one side takes the other
; side's type (S8: the reader's scan wraps its recur continuations in
; match/let/if tails — a bare HRecur tag check is not enough).
(defn all-paths-recur [e :- HExpr] :- bool
  (let [tag (h-tag e)]
    (cond
      (= tag 32) true
      (= tag 22) (and (all-paths-recur (hv-b e))
                      (all-paths-recur (hv-c e)))
      (= tag 30) (all-paths-recur (hv-b e))
      (= tag 29) (seq-all-recur (hargs-of e))
      (= tag 34) (arms-all-recur (arms-of e))
      false)))

(defn seq-all-recur [es :- HExprs] :- bool
  (if (asts-null es)
    false
    (if (asts-null (asts-tail-hes es))
      (all-paths-recur (hes-head-hes es))
      (seq-all-recur (asts-tail-hes es)))))

(defn arms-all-recur [arms :- HArms] :- bool
  (match arms
    (HANil [] true)
    (HACons [variant binders body next]
      (and (all-paths-recur body) (arms-all-recur next)))))

(defn lower-if [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
               insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
               ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 4))
    (LErr "if expects (if cond then else)")
    (let [c (asts-idx (clone items) 1)
          rc (lower-1 c (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match rc
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 c2]
          (if (not (ty-eq (ty-of c2 env r1 s1) (t-bool)))
            (LErr "if condition must be boolean")
            (let [tthen (asts-idx (clone items) 2)
                  rt (lower-1 tthen (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
              (match rt
                (LErr [msg] (LErr msg))
                (LOk [t2 a2 i2 s2 l2 r2 n2 d2 then2]
                  (let [tels (asts-idx items 3)
                        re (lower-1 tels (clone env) t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                    (match re
                      (LErr [msg] (LErr msg))
                      (LOk [t3 a3 i3 s3 l3 r3 n3 d3 els2]
                        (let [tt (ty-of then2 env r3 s3)
                              et (ty-of els2 env r3 s3)
                              ; a branch whose every path recurs takes the
                              ; other branch's type
                              tt2 (if (all-paths-recur (clone then2)) (clone et) (clone tt))
                              et2 (if (all-paths-recur (clone els2)) tt et)]
                          (if (and (not (ty-eq (clone tt2) (clone et2)))
                                   (not (ty-eq (clone tt2) (t-f64)))
                                   (not (ty-eq (clone et2) (t-f64))))
                            (LErr (str "if branches must be the same type, got " (ty-name tt2) " and " (ty-name et2)))
                            (let [wf (or (ty-eq (clone tt2) (t-f64)) (ty-eq (clone et2) (t-f64)))
                                  ty (if wf (t-f64) (clone tt2))
                                  then3 (coerce-f64 (clone then2) (clone tt2) wf)
                                  els3 (coerce-f64 (clone els2) (clone et2) wf)]
                              (lok t3 a3 i3 (clone s3) l3 (clone r3) n3 d3 (HIf (clone c2) then3 els3 ty)))))))))))))))))

; --- let (forms.rs lower_let) ---------------------------------------------------

(defn lower-let [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (match items
    (KNil [] (LErr "let bindings must be a vector"))
    ; brest is the KCons tail: the chain of body forms AFTER the bindings
    ; vector — the second destructure name is a chain, not a form
    (KCons [bvec brest]
      (if (not (= (ast-tag bvec) 6))
        (LErr "let bindings must be a vector")
        (if (not (even? (asts-depth (ast-kids-of (clone bvec)))))
          (LErr "let bindings must be key/value pairs")
          (if (asts-null brest)
            (LErr "let body required")
            (let [rb (lower-let-binds (ast-kids-of (clone bvec)) 0 (clone env) env (BNil)
                                      tab adts insts sigs lams rets ncached defs raws)]
              (match rb
                (LBErr [msg] (LErr msg))
                (LBRes [t2 a2 i2 s2 l2 r2 n2 d2 env2 binds2]
                  ; multiple body forms form an implicit sequence
                  (let [body (asts-idx (clone brest) 0)
                        rbody (lower-body-1 (asts-tail brest) body env2 expected t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                    (match rbody
                      (LErr [msg] (LErr msg))
                      (LOk [t3 a3 i3 s3 l3 r3 n3 d3 e3]
                        (lok t3 a3 i3 s3 l3 r3 n3 d3 (HLet (binds-rev binds2 (BNil)) e3 (SNil)))))))))))))))

; the body after the bindings vector: one form, or an implicit Seq
(defn lower-body-1 [rest :- Asts body :- Ast env :- TyEnv expected :- Ty
                   tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                   lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (asts-null rest)
    (lower body env expected tab adts insts sigs lams rets ncached defs raws)
    (lower-body-seq (KCons body rest) (HENil) env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-body-seq [forms :- Asts acc :- HExprs env :- TyEnv
                     tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                     lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [kid (asts-idx (clone forms) 0)
        restq (asts-null (asts-tail (clone forms)))
        r (lower-1 kid (clone env) (clone tab) (clone adts) (clone insts) sigs lams rets ncached defs raws)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
        (if restq
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSeq (hes-rev (HECons e2 acc) (HENil))))
          (lower-body-seq (asts-tail forms) (HECons e2 acc) env (clone tab) adts insts s2 l2 r2 n2 d2 raws))))))

; returns env2 + accumulated binds (reversed); mirrors lower_let's three
; binding shapes: [a b] destructuring, [x :- ty value] ascription, plain.
(deftype LBRes (LBRes [tab :- i64 adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns env :- TyEnv binds :- Binds])
              (LBErr [msg :- str]))

(defn lower-let-binds [binds :- Asts i :- i64 env0 :- TyEnv env :- TyEnv
                      acc :- Binds tab :- i64 adts :- AdtTab
                      insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                      ncached :- i64 defs :- Defns raws :- &Raws] :- LBRes
  (lower-let-binds-impl (clone binds) i (asts-depth binds) env0 env acc
                        tab adts insts sigs lams rets ncached defs raws))

(defn lower-let-binds-impl [binds :- Asts i :- i64 n :- i64 env0 :- TyEnv env :- TyEnv
                           acc :- Binds tab :- i64 adts :- AdtTab
                           insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                           ncached :- i64 defs :- Defns raws :- &Raws] :- LBRes
  (if (>= i n)
    (LBRes tab adts insts sigs lams rets ncached defs (clone env) acc)
    (let [name-node (asts-idx (clone binds) i)
          nt (ast-tag name-node)]
      (cond
        ; [a b] destructuring pattern
        (= nt 6)
        (let [val-node (asts-idx (clone binds) (+ i 1))
              rv (lower-1 val-node (clone env) tab adts insts sigs lams rets ncached defs raws)]
          (match rv
            (LErr [msg] (LBErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
              (let [vt (ty-of value env r2 s2)]
                (if (not (= (ty-tag vt) 15))
                  (LBErr (str "destructured binding source must be a vector, got " (ty-name vt)))
                  (let [elc (ty-arg vt)
                        ; $d{ncached + resolved-so-far}
                        tmp-n (+ n2 (binds-depth acc))
                        rtmp (intern1 t2 (str "$d" tmp-n))]
                    (match rtmp
                      (I1Res [t3 tmp] 
                        (let [pat (ast-kids-of (clone name-node))
                              ; the temp binds FIRST (the seed pushes
                              ; (tmp, value, Vec elem) before the pattern)
                              env3 (te-put (clone env) tmp (t-vec elc))
                              acc3 (BCons tmp (clone value) (t-vec elc) (clone acc))
                              rp (destructure-binds pat 0 tmp elc env3 t3 a2 i2 (clone s2) l2 (clone r2) n2 d2 acc3)]
                          (match rp
                            (LBErr [msg] (LBErr msg))
                            (LBRes [t4 a4 i4 s4 l4 r4 n4 d4 env4 acc4]
                              (lower-let-binds-impl (clone binds) (+ i 2) n (clone env0) env4 acc4 t4 a4 i4 s4 l4 r4 n4 d4 raws))))))))))))
        ; [x :- ty value] ascription
        (and (= nt 1)
             (let [sep (asts-idx (clone binds) (+ i 1))]
               (and (= (ast-tag sep) 1) (= (ast-sid-of sep) (s-sep)))))
        (let [name-sid (ast-sid-of name-node)
              ann (asts-idx (clone binds) (+ i 2))
              val-node (asts-idx (clone binds) (+ i 3))
              ra (resolve-ann-ty ann tab (clone adts) (clone sigs))]
          (match ra
            (PTyRes [ps2 ty]
              (if (ps-failed ps2)
                (LBErr (ps-err-msg ps2))
                (match (clone ps2)
                  (PS [t d a sg y e]
                    (let [rv (lower-e val-node (clone env) ty t a (clone insts) sg (clone lams) (clone rets) ncached (clone defs) raws)]
                      (match rv
                        (LErr [msg] (LBErr msg))
                        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
                          (let [vt (ty-of value env r2 s2)
                                ok (or (ty-eq (clone vt) ty) (and (ty-eq ty (t-f64)) (ty-eq (clone vt) (t-i64))))]
                            (if (not ok)
                              (LBErr (str "let binding " (sym-str t2 name-sid) " ascribed " (ty-name ty) " but the value is " (ty-name vt)))
                              (lower-let-binds-impl (clone binds) (+ i 4) n (clone env0) (te-put (clone env) name-sid ty)
                                                    (BCons name-sid (clone value) ty (clone acc)) t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 raws))))))))))))
            ; plain [x value]
        (= nt 1)
        (let [name-sid (ast-sid-of name-node)
              val-node (asts-idx (clone binds) (+ i 1))
              rv (lower-1 val-node (clone env) tab adts insts sigs lams rets ncached defs raws)]
          (match rv
            (LErr [msg] (LBErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 value]
              (let [vt (ty-of value env r2 s2)]
                (lower-let-binds-impl binds (+ i 2) n env0 (te-put (clone env) name-sid (clone vt))
                                      (BCons name-sid (clone value) vt acc) t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 raws)))))
        (LBErr "let binding name must be a symbol or a [a b] pattern")))))

(defn ps-err-msg [ps :- &PS] :- str
  (match ps (PS [tab decls adts sigs typarams err] (clone err))))

; [a b] destructuring: bind a = (get tmp 0 default), b = (get tmp 1
; default); `_` skips. Scalar i64/f64 elements only (the seed's rule).
(defn destructure-binds [pat :- Asts k :- i64 tmp :- i64 elc :- i64
                        env :- TyEnv tab :- i64 adts :- AdtTab
                        insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                        ncached :- i64 defs :- Defns acc :- Binds] :- LBRes
  (if (>= k (asts-depth pat))
    (LBRes tab adts insts sigs lams rets ncached defs env acc)
    (let [p (asts-idx (clone pat) k)
          pt (ast-tag p)]
      (if (not (= pt 1))
        (LBErr "destructure pattern elements must be symbols or _")
        (let [pn (ast-sid-of p)]
          (if (= pn (s-wild))
            (destructure-binds pat (+ k 1) tmp elc env tab adts insts sigs lams rets ncached defs acc)
            (if (and (not (= elc 0)) (not (= elc 1)))
              (LBErr (str "destructuring supports i64/f64 vectors, got element " (ty-name (elem-ty elc))))
              (let [et (elem-ty elc)
                    zero (if (= elc 0) (HConstI64 0) (HConstF64 0.0))
                    getv (HGet (HVar tmp) (HConstI64 k) (HECons zero (HENil)) (clone et) (t-none))
                    acc2 (BCons pn getv (clone et) acc)]
                (destructure-binds pat (+ k 1) tmp elc (te-put env pn et) tab adts insts sigs lams rets ncached defs acc2)))))))))

; --- comparisons, not, abs, min/max, and/or (forms.rs) ----------------------------

(defn lower-cmp [op :- i64 items :- Asts env :- TyEnv tab :- i64
                adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr (str "comparison expects 2 operands"))
    (let [a (asts-idx (clone items) 1)
          b (asts-idx items 2)
          ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (let [at (ty-of e1 env r2 s2)
                      bt (ty-of e2 env r2 s2)]
                  (if (and (ty-eq (clone at) (t-str)) (ty-eq (clone bt) (t-str)))
                    ; string comparisons go through the runtime
                    (cond
                      (= op 0) (lok (clone t2) (clone a2) (clone i2) (clone s2) (clone l2) (clone r2) n2 (clone d2) (HStrCmp 1 (clone e1) (clone e2)))
                      (= op 1) (lok (clone t2) (clone a2) (clone i2) (clone s2) (clone l2) (clone r2) n2 (clone d2) (HStrCmp 0 (clone e1) (clone e2)))
                      (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HStrOrd op (clone e1) (clone e2))))
                    (if (and (ty-eq (clone at) (clone bt)) (is-numeric-ty (clone at)))
                      (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HCmpW op (clone e1) (clone e2) at))
                      (LErr (str "cannot compare " (ty-name at) " and " (ty-name bt)
                                 " — operands must share a width (cast explicitly)")))))))))))))

(defn lower-not [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "not expects 1 operand")
    (lower-1-bool (asts-idx items 1) env tab adts insts sigs lams rets ncached defs "not expects a boolean operand" 25 raws)))

(defn lower-abs [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "abs expects 1 operand")
    (let [r (lower-1 (asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [t (ty-of e2 env r2 s2)]
            (if (or (ty-eq (clone t) (t-i64)) (ty-eq (clone t) (t-f64)) (ty-eq (clone t) (t-i32)))
              (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HAbs (clone e2) t))
              (LErr "abs expects an i64, i32 or f64 operand"))))))))

(defn lower-minmax [op :- i64 items :- Asts env :- TyEnv tab :- i64
                   adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                   rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr (if (= op 0) "min expects 2 operands" "max expects 2 operands"))
    (let [a (asts-idx (clone items) 1)
          ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [b (asts-idx items 2)
                rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (match (promote-pair e1 e2 env r2 (clone s2))
                  (PResErr [msg] (LErr msg))
                  (PResOk [f1 f2]
                    (let [t (ty-of f1 env r2 s2)]
                      (if (or (ty-eq (clone t) (t-i64)) (ty-eq (clone t) (t-f64)) (ty-eq (clone t) (t-i32)))
                        (if (= op 0)
                          (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HMin f1 f2 t))
                          (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HMax f1 f2 t)))
                        (LErr (str "min/max expects i64/i32/f64 operands"))))))))))))))

(defn lower-1-bool [a :- Ast env :- TyEnv tab :- i64 adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns msg :- str kind :- i64 raws :- &Raws] :- LRes
  (let [r (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
    (match r
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
        (if (not (ty-eq (ty-of e2 env r2 s2) (t-bool)))
          (LErr msg)
          (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2
               (if (= kind 25) (HNot (clone e2)) (clone e2))))))))

; post-expansion and/or is strictly binary (the expander folded variadics)
(defn lower-andor [kind :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr "and/or expects 2 operands")
    (let [a (asts-idx (clone items) 1)
          b (asts-idx items 2)
          ra (lower-1-bool a (clone env) tab adts insts sigs lams rets ncached defs "and/or expects boolean operands" 0 raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [rb (lower-1-bool b env t1 a1 i1 s1 l1 r1 n1 d1 "and/or expects boolean operands" 0 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (if (= kind 0)
                  (lok t2 a2 i2 s2 l2 r2 n2 d2 (HAnd e1 e2))
                  (lok t2 a2 i2 s2 l2 r2 n2 d2 (HOr e1 e2)))))))))))

; --- captures (collect_captures: first-reference pre-order) ---------------------

(deftype CapsRes (CapsRes [caps :- Caps seen :- Sids]))

(defn hv-a [e :- &HExpr] :- HExpr
  (match e
    (HConstI64 [v] (HConstI64 0))
    (HConstF64 [v] (HConstI64 0))
    (HConstB [v] (HConstI64 0))
    (HVar [name] (HConstI64 0))
    (HStrLit [v] (HConstI64 0))
    (HVecLit [el vals] (HConstI64 0))
    (HBinW [op a b ty] (HConstI64 0))
    (HBinF [op a b] (HConstI64 0))
    (HCmpW [op a b ty] (HConstI64 0))
    (HStrCmp [pol a b] (HConstI64 0))
    (HStrOrd [op a b] (HConstI64 0))
    (HICast [e from to] (clone e))
    (HCount [e] (clone e))
    (HToStr [e ty] (clone e))
    (HStrCat [args] (HConstI64 0))
    (HSubs [s a b] (clone s))
    (HSplit [s sep] (clone s))
    (HJoin [sep xs] (clone sep))
    (HStrNth [s idx res] (clone s))
    (HCharStr [e] (clone e))
    (HGet [src idx dflt ty res] (clone src))
    (HConj [v x el inplace] (clone v))
    (HIf [c t e ty] (clone c))
    (HAnd [a b] (clone a))
    (HOr [a b] (clone a))
    (HNot [e] (clone e))
    (HAbs [e ty] (clone e))
    (HMin [a b ty] (clone a))
    (HMax [a b ty] (clone a))
    (HSeq [es] (HConstI64 0))
    (HLet [binds body frees] (HConstI64 0))
    (HLoop [binds ty body] (HConstI64 0))
    (HRecur [args] (HConstI64 0))
    (HCtor [adt variant args] (HConstI64 0))
    (HMatch [scrut arms ty] (clone scrut))
    (HClone [e] (clone e))
    (HDrop [e] (clone e))
    (HClosure [sig mangled params caps body] (HConstI64 0))
    (HClosureCall [f args sig] (clone f))
    (HCall [name args] (HConstI64 0))
    (HSlurp [p] (clone p))
    (HSpit [path data] (clone path))
    (HArgs [] (HConstI64 0))
    (HExit [e] (clone e))
    (HParseNum [s int res] (clone s))
))

