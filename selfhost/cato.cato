(defn hargs-of [e :- &HExpr] :- HExprs
  (match e
    (HConstI64 [_] (HENil))
    (HConstF64 [_] (HENil))
    (HConstB [_] (HENil))
    (HVar [_] (HENil))
    (HStrLit [_] (HENil))
    (HVecLit [_ _] (HENil))
    (HBinW [_ _ _ _] (HENil))
    (HBinF [_ _ _] (HENil))
    (HCmpW [_ _ _ _] (HENil))
    (HStrCmp [_ _ _] (HENil))
    (HStrOrd [_ _ _] (HENil))
    (HICast [_ _ _] (HENil))
    (HCount [_] (HENil))
    (HToStr [_ _] (HENil))
    (HStrCat [args] (clone args))
    (HSubs [_ _ _] (HENil))
    (HSplit [_ _] (HENil))
    (HJoin [_ _] (HENil))
    (HStrNth [_ _ _] (HENil))
    (HCharStr [_] (HENil))
    (HGet [_ _ _ _ _] (HENil))
    (HConj [_ _ _ _] (HENil))
    (HIf [_ _ _ _] (HENil))
    (HAnd [_ _] (HENil))
    (HOr [_ _] (HENil))
    (HNot [_] (HENil))
    (HAbs [_ _] (HENil))
    (HMin [_ _ _] (HENil))
    (HMax [_ _ _] (HENil))
    (HSeq [es] (clone es))
    (HLet [_ _ _] (HENil))
    (HLoop [_ _ _] (HENil))
    (HRecur [args] (clone args))
    (HCtor [_ _ args] (clone args))
    (HMatch [_ _ _] (HENil))
    (HClone [_] (HENil))
    (HDrop [_] (HENil))
    (HClosure [_ _ _ _ _] (HENil))
    (HClosureCall [_ _ _] (HENil))
    (HCall [_ args] (clone args))
    (HSlurp [_] (HENil))
    (HSpit [_ _] (HENil))
    (HArgs [] (HENil))
    (HExit [_] (HENil))
    (HParseNum [_ _ _] (HENil))))

(defn collect-caps [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [tag (h-tag e)]
    (cond
      (= tag 3)
      (let [v (name-of e)
            hit (or (sids-has params v) (sids-has seen v))]
        (if hit
          (CapsRes (clone caps) (clone seen))
          (if (te-has env v)
            (CapsRes (CCons v (te-get env v) 1 (clone caps)) (SCons v (clone seen)))
            (CapsRes (clone caps) (clone seen)))))
      (CapsRes caps seen))))

(defn cap-pair [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-2 (hv-a e) (hv-b e) env params seen caps))

(defn cap-2 [a :- HExpr b :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps a env (clone params) seen caps)]
    (match r1
      (CapsRes [c2 s2] (collect-caps b env params s2 c2)))))

(defn cap-un [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (collect-caps (hv-a e) env params seen caps))

(defn cap-kids [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-kids-2 (hargs-of e) env params seen caps))

(defn cap-kids-2 [es :- HExprs env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match es
    (HENil [] (CapsRes caps seen))
    (HECons [kid next]
      (let [r (collect-caps kid env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-kids-2 next env params s2 c2)))))))

(defn cap-f-args [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps (hv-a e) env (clone params) seen caps)]
    (match r1
      (CapsRes [c2 s2] (cap-kids-2 (hargs-of e) env params s2 c2)))))

(defn cap-triple [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (cap-3 (hv-a e) (hv-b e) (hv-c e) env params seen caps))

(defn cap-3 [a :- HExpr b :- HExpr c :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r1 (collect-caps a env (clone params) seen caps)]
    (match r1
      (CapsRes [c2 s2]
        (let [r2 (collect-caps b env (clone params) s2 c2)]
          (match r2
            (CapsRes [c3 s3] (collect-caps c env params s3 c3))))))))

(defn cap-binds [binds :- Binds body :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (match binds
    (BNil [] (collect-caps body env params seen caps))
    (BCons [name v ty next]
      (let [r (collect-caps v env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-binds next body env params s2 c2)))))))

(defn cap-arms [arms :- HArms caps :- Caps seen :- Sids env :- &TyEnv params :- Sids] :- CapsRes
  (match arms
    (HANil [] (CapsRes caps seen))
    (HACons [variant binders body next]
      (let [r (collect-caps body env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-arms next c2 s2 env params)))))))

; The full capture walk (collect_captures): dispatch on the node kind,
; recurse in the seed's field order, first-reference order preserved.
; Loop, Recur, VecLit, nested Closure and Args fall to the seed's `_` arm
; (skipped — nested closures collect their own captures).
(defn caps-of [e :- HExpr env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  ; exhaustive direct destructure — the seed's collect_captures field
  ; order; leaves, Loop, nested Closure and Args are the seed's `_` arm
  (match e
    (HVar [v] (collect-caps e env params seen caps))

    (HBinW [op a b ty] (cap-2 a b env params seen caps))
    (HBinF [op a b] (cap-2 a b env params seen caps))
    (HCmpW [op a b ty] (cap-2 a b env params seen caps))
    (HStrCmp [p a b] (cap-2 a b env params seen caps))
    (HStrOrd [op a b] (cap-2 a b env params seen caps))
    (HAnd [a b] (cap-2 a b env params seen caps))
    (HOr [a b] (cap-2 a b env params seen caps))
    (HMin [a b ty] (cap-2 a b env params seen caps))
    (HMax [a b ty] (cap-2 a b env params seen caps))
    (HConj [v x el ip] (cap-2 v x env params seen caps))
    (HSubs [s a b] (cap-2 s a env params seen caps))
    (HSplit [s sep] (cap-2 s sep env params seen caps))
    (HJoin [sep xs] (cap-2 sep xs env params seen caps))
    (HStrNth [s idx res] (cap-2 s idx env params seen caps))
    (HSpit [p d] (cap-2 p d env params seen caps))

    (HIf [c t2 e2 ty] (cap-3 c t2 e2 env params seen caps))

    (HICast [x from to] (collect-caps x env params seen caps))
    (HCount [x] (collect-caps x env params seen caps))
    (HNot [x] (collect-caps x env params seen caps))
    (HAbs [x ty] (collect-caps x env params seen caps))
    (HClone [x] (collect-caps x env params seen caps))
    (HDrop [x] (collect-caps x env params seen caps))
    (HCharStr [x] (collect-caps x env params seen caps))
    (HToStr [x ty] (collect-caps x env params seen caps))
    (HSlurp [p] (collect-caps p env params seen caps))
    (HExit [x] (collect-caps x env params seen caps))
    (HParseNum [s int res] (collect-caps s env params seen caps))

    (HStrCat [args] (cap-kids-2 args env params seen caps))
    (HSeq [es] (cap-kids-2 es env params seen caps))
    (HRecur [args] (cap-kids-2 args env params seen caps))
    (HCtor [adt variant args] (cap-kids-2 args env params seen caps))
    (HCall [name args] (cap-kids-2 args env params seen caps))

    (HGet [src idx dflt ty res]
      (let [r (cap-2 src idx env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-kids-2 dflt env params s2 c2)))))

    (HLet [binds body frees]
      (cap-binds binds body env params seen caps))

    (HMatch [scrut arms ty]
      (let [r (collect-caps scrut env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-arms-2 arms env params c2 s2)))))

    (HClosureCall [f args sig]
      (let [r (collect-caps f env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-kids-2 args env params s2 c2)))))

    ; the seed's `_` arm: constants, literals, Loop, nested Closure, Args
    (HConstI64 [v] (CapsRes caps seen))
    (HConstF64 [v] (CapsRes caps seen))
    (HConstB [v] (CapsRes caps seen))
    (HStrLit [v] (CapsRes caps seen))
    (HVecLit [el vals] (CapsRes caps seen))
    (HLoop [binds ty body] (CapsRes caps seen))
    (HClosure [sig mangled ps2 cs body] (CapsRes caps seen))
    (HArgs [] (CapsRes caps seen))))

(defn cap-match [scrut :- HExpr arms :- HArms env :- &TyEnv params :- Sids seen :- Sids caps :- Caps] :- CapsRes
  (let [r (collect-caps scrut env (clone params) seen caps)]
    (match r
      (CapsRes [c2 s2] (cap-arms-2 arms env params c2 s2)))))

(defn cap-arms-2 [arms :- HArms env :- &TyEnv params :- Sids caps :- Caps seen :- Sids] :- CapsRes
  (match arms
    (HANil [] (CapsRes caps seen))
    (HACons [variant binders body next]
      (let [r (collect-caps body env (clone params) seen caps)]
        (match r
          (CapsRes [c2 s2] (cap-arms-2 next env params c2 s2)))))))

; --- closures -------------------------------------------------------------------

; (fn [x :- ty ...] body) — params via the sym grammar with an EMPTY
; declared-ADT table (the seed's rule); captures by first reference.
(defn lower-closure [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                    insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                    ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr "fn expects (fn [params] <body>)")
    (let [pvec (asts-idx (clone items) 1)]
      (if (not (= (ast-tag pvec) 6))
        (LErr "fn params must be a vector")
        (let [rp (closure-params (ast-kids-of (clone pvec)) 0 (PNil) (PS tab (DLNil) adts sigs (SNil) "") (SNil))]
          (match rp
            (PParRes [ps2 params]
              (if (ps-failed ps2)
                (LErr (ps-err-msg ps2))
                (match (clone ps2)
                  (PS [t2 d2 a2 s2 y2 e2]
                    (let [body (asts-idx items 2)
                          ; the body lowers in the OUTER env extended with
                          ; the params (the seed's child = env + params);
                          ; captures are collected against the outer env
                          env2 (params-extend (clone env) (clone params))
                          rb (lower-1 body (clone env2) t2 a2 (clone insts) s2 (clone lams) rets ncached (clone defs) raws)]
                      (match rb
                        (LErr [msg] (LErr msg))
                        (LOk [t3 a3 i3 s3 l3 r3 n3 d3 body2]
                          (let [ret (ty-of body2 env2 r3 s3)
                                pnames (plist-names (clone params))
                                rc (caps-of (clone body2) env pnames (SNil) (CNil))]
                            (match rc
                              (CapsRes [caps seen]
                                ; dedup sig structurally; index = Ty::Fn payload
                                (let [ptys (plist-tys (clone params))
                                      rs (register-sig2 (clone s3) ptys (clone ret))]
                                  (match rs
                                    (SigRes [s4 sig]
                                      (let [midx (lams-depth lams)
                                            rm (intern1 t3 (str "lambda_" midx))]
                                        (match rm
                                          (I1Res [t5 mangled]
                                            (lok t5 a3 insts s4 (lams-append lams (Lam mangled (clone caps) (clone params) ret (clone body2)))
                                                 (clone r3) n3 defs
                                                 (HClosure sig mangled params caps (clone body2)))))))))))))))))))))))))

(defn plist-names [ps :- PList] :- Sids
  (match ps
    (PCons [h t]
      (match h
        (Param [name ty _pb] (SCons name (plist-names t)))))
    (PNil [] (SNil))))

; the outer env extended with the fn params, in order
(defn params-extend [env :- TyEnv ps :- PList] :- TyEnv
  (match ps
    (PCons [p rest]
      (match p
        (Param [name ty _pb] (params-extend (te-put env name ty) rest))))
    (PNil [] env)))

(defn plist-tys [ps :- PList] :- TyList
  (match ps
    (PCons [h t]
      (match h
        (Param [name ty _pb] (TyCons ty (plist-tys t)))))
    (PNil [] (TyNil))))

; register-sig over the plain tables; returns the table index
(deftype SigRes (SigRes [sigs :- Sigs idx :- i64]))

(defn register-sig2 [sigs :- Sigs params :- TyList ret :- Ty] :- SigRes
  (let [i (sigs-find sigs params (clone ret) 0)]
    (if (>= i 0)
      (SigRes sigs i)
      (SigRes (SGCons (Sig params ret) (clone sigs)) (sigs-depth sigs)))))

; a closure param annotation: parse_ty_sym with an empty ADT table —
; scalars, the vec/map/set spellings, or a fresh uppercase type parameter
(deftype CtyRes (CtyRes [tps :- Sids ty :- Ty msg :- str]))

(defn closure-ty-sym [s :- str tps :- Sids tab :- i64] :- CtyRes
  (cond
    (= s "i64")    (CtyRes tps (t-i64) "")
    (= s "i32")    (CtyRes tps (t-i32) "")
    (= s "i8")     (CtyRes tps (t-i8) "")
    (= s "i16")    (CtyRes tps (t-i16) "")
    (= s "u8")     (CtyRes tps (t-u8) "")
    (= s "u16")    (CtyRes tps (t-u16) "")
    (= s "u32")    (CtyRes tps (t-u32) "")
    (= s "u64")    (CtyRes tps (t-u64) "")
    (= s "usize")  (CtyRes tps (t-usize) "")
    (= s "f64")    (CtyRes tps (t-f64) "")
    (= s "f32")    (CtyRes tps (t-f32) "")
    (= s "vec")    (CtyRes tps (t-vec 0) "")
    (= s "bool")   (CtyRes tps (t-bool) "")
    (= s "str")    (CtyRes tps (t-str) "")
    (= s "string") (CtyRes tps (t-str) "")
    (= s "map")    (CtyRes tps (t-map) "")
    (= s "set")    (CtyRes tps (t-set) "")
    (if (is-upper s)
      (let [r (intern1 (clone tab) s)]
        (match r
          (I1Res [tab2 sid]
            (CtyRes (sids-append (clone tps) sid) (t-param (sids-depth tps)) ""))))
      (CtyRes tps (t-none) (str "unknown type name " s)))))

(defn closure-params [els :- Asts i :- i64 acc :- PList ps :- PS tps :- Sids] :- PParRes
  (if (>= i (asts-depth els))
    (PParRes ps (plist-rev acc (PNil)))
    (let [nm (asts-idx (clone els) i)
          sep (asts-idx (clone els) (+ i 1))]
      (if (not (= (ast-tag nm) 1))
        (PParRes (ps-err ps "fn param must be a symbol") (PNil))
        (if (not (and (= (ast-tag sep) 1) (= (ast-sid-of sep) (s-sep))))
          (PParRes (ps-err ps (str "fn param " (node-str (clone nm) (ps-tab ps)) " needs a type annotation in this slice (x :- i64)")) (PNil))
          (let [tyn (asts-idx (clone els) (+ i 2))
                rt (closure-ty-sym (node-str tyn (ps-tab ps)) tps (ps-tab ps))]
            (match rt
              (CtyRes [tps2 ty msg]
                (if (> (count msg) 0)
                  (PParRes (ps-err ps msg) (PNil))
                  (closure-params els (+ i 3) (PCons (Param (ast-sid-of nm) ty 0) acc) ps tps2))))))))))

; --- loop / recur -----------------------------------------------------------------

; loop binding values, sequential scoping
(defn lower-loop-binds [binds :- Asts i :- i64 n :- i64 env :- TyEnv acc :- Binds
                       tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                       lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LBRes
  (if (>= i n)
    (LBRes tab adts insts sigs lams rets ncached defs (clone env) acc)
    (let [nm (asts-idx (clone binds) i)
          sep (asts-idx (clone binds) (+ i 1))]
      (if (not (= (ast-tag nm) 1))
        (LBErr "loop binding name must be a symbol")
        (if (not (and (= (ast-tag sep) 1) (= (ast-sid-of sep) (s-sep))))
          (LBErr (str "loop binding " (node-str (clone nm) tab) " needs a type ascription (x :- ty init) — loop variables are typed, not inferred"))
          (let [tyn (asts-idx (clone binds) (+ i 2))
                initn (asts-idx (clone binds) (+ i 3))
                ra (resolve-ann-ty tyn tab (clone adts) (clone sigs))]
            (match ra
              (PTyRes [ps2 ty]
                (if (ps-failed ps2)
                  (LBErr (ps-err-msg ps2))
                  (match (clone ps2)
                    (PS [t2 d2 a2 s2 y2 e2]
                      ; S8: loop variables may also be boxed ADTs and
                      ; collection headers — the reader threads its frame
                      ; stack, children and intern table through one loop.
                      ; Loop variables are never freed and never moved, so
                      ; the recursion the loop replaces cannot double-free.
                      (if (and (not (is-copy-ty (clone ty)))
                               (not (or (= (ty-tag ty) 16)
                                        (= (ty-tag ty) 15)
                                        (= (ty-tag ty) 13)
                                        (= (ty-tag ty) 14))))
                        (LBErr (str "loop variable " (node-str (clone nm) t2) " has non-Copy type " (ty-name ty) " — loop variables are numeric/bool/str/ADT/collection in this slice"))
                        (let [ri (lower-e initn (clone env) ty t2 a2 (clone insts) s2 (clone lams) (clone rets) ncached (clone defs) raws)]
                          (match ri
                            (LErr [msg] (LBErr msg))
                            (LOk [t3 a3 i3 s3 l3 r3 n3 d3 init]
                              (let [it (ty-of init env r3 s3)
                                    empty-vec (and (= (ty-tag ty) 15) (= (h-tag init) 5) (= (vvals-depth-of (clone init)) 0))]
                                (if (and (not (ty-eq (clone it) ty)) (not (and (ty-eq ty (t-f64)) (ty-eq (clone it) (t-i64)))) (not empty-vec))
                                  (LBErr (str "loop binding " (node-str (clone nm) t3) " ascribed " (ty-name ty) " but the initial value is " (ty-name it)))
                                  (let [init2 (if (and (ty-eq ty (t-f64)) (ty-eq it (t-i64)))
                                                (HICast (clone init) (t-i64) (t-f64))
                                                (clone init))]
                                    (lower-loop-binds binds (+ i 4) n (te-put (clone env) (ast-sid-of nm) ty)
                                                      (BCons (ast-sid-of nm) init2 ty acc)
                                                      t3 a3 i3 (clone s3) l3 (clone r3) n3 d3 raws)))))))))))))))))))

(defn lower-loop [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (< (asts-depth items) 3)
    (LErr "loop expects (loop [x :- ty init ...] body...)")
    (let [bvec (asts-idx (clone items) 1)]
      (if (not (= (ast-tag bvec) 6))
        (LErr "loop bindings must be a vector")
        (let [bkids (ast-kids-of (clone bvec))
              rb (lower-loop-binds (clone bkids) 0 (asts-depth bkids) env (BNil)
                                   tab adts insts sigs lams rets ncached defs raws)]
          (match rb
            (LBErr [msg] (LErr msg))
            (LBRes [t2 a2 i2 s2 l2 r2 n2 d2 env2 binds2]
              ; multiple body forms form an implicit sequence; the last
              ; carries the loop's type. items includes the `loop` head
              ; and the bindings vector — the body starts at index 2.
              (let [body-forms (asts-drop items 2)
                    rb2 (lower-do body-forms (clone env2) (t-none) t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                (match rb2
                  (LErr [msg] (LErr msg))
                  (LOk [t3 a3 i3 s3 l3 r3 n3 d3 body2]
                    (let [ty (ty-of body2 env2 r3 s3)
                          rv (validate-recurs (clone body2) (binds-depth binds2))]
                      (match rv
                        (VErr [msg] (LErr (str "loop: " msg)))
                        (LOk2 [] (lok t3 a3 i3 (clone s3) l3 (clone r3) n3 d3 (HLoop (binds-rev binds2 (BNil)) ty (clone body2))))))))))))))))

; recur tail-position validation (validate_recurs); LOk2 is a unit-ok
(deftype VRes (LOk2) (VErr [msg :- str]))


 

(defn validate-recurs [e :- HExpr arity :- i64] :- VRes
  (validate-recurs-2 e arity true false))

(defn validate-recurs-2 [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [tag (h-tag e)]
    (cond
      (= tag 32)
      (v-recur-arm (clone e) arity inloop crossed)

      (= tag 22)
      (v-if-arm (clone e) arity inloop crossed)

      (= tag 30)
      (validate-let (binds-of (clone e)) (hv-b e) arity inloop crossed)

      (= tag 29)
      (validate-seq (hargs-of e) arity inloop crossed)

      (= tag 34)
      (v-match-arm (clone e) arity inloop crossed)

      (= tag 31)
      (LOk2)

      (v-default-arm (clone e) arity inloop crossed))))

(defn v-recur-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (if crossed
    (VErr "recur cannot cross a closure boundary")
    (if (not inloop)
      (VErr "recur in this position is not in tail position (recur may end the loop body, an if branch, a match arm, or a let/do tail)")
      (if (= (hes-depth (recur-args (clone e))) arity)
        (LOk2)
        (VErr (str "recur expects " arity " argument(s) to match the loop bindings, got " (hes-depth (recur-args e))))))))

(defn v-if-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [r1 (validate-recurs-2 (hv-a e) arity false crossed)]
    (match r1
      (VErr [msg] (VErr msg))
      (LOk2 []
        (let [r2 (validate-recurs-2 (hv-b e) arity inloop crossed)]
          (match r2
            (VErr [msg] (VErr msg))
            (LOk2 [] (validate-recurs-2 (hv-c e) arity inloop crossed))))))))

(defn v-match-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [r1 (validate-recurs-2 (hv-a e) arity false crossed)]
    (match r1
      (VErr [msg] (VErr msg))
      (LOk2 [] (validate-arms (arms-of e) arity inloop crossed)))))

(defn v-default-arm [e :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (if (contains-recur (clone e) 0)
    (if (= (h-tag e) 37)
      (VErr "recur cannot cross a closure boundary")
      (VErr "recur in this position is not in tail position (recur may end the loop body, an if branch, a match arm, or a let/do tail)"))
    (LOk2)))

(defn validate-let [binds :- Binds body :- HExpr arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (match binds
    (BNil [] (validate-recurs-2 body arity inloop crossed))
    (BCons [name v ty next]
      (let [r (validate-recurs-2 v arity false crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-let next body arity inloop crossed)))))))

(defn validate-seq [es :- HExprs arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (let [restq (asts-null (asts-tail-hes es))]
    (if restq
      (validate-recurs-2 (hes-head-hes es) arity inloop crossed)
      (let [r (validate-recurs-2 (hes-head-hes es) arity false crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-seq (asts-tail-hes es) arity inloop crossed)))))))

(defn validate-arms [arms :- HArms arity :- i64 inloop :- bool crossed :- bool] :- VRes
  (match arms
    (HANil [] (LOk2))
    (HACons [variant binders body next]
      (let [r (validate-recurs-2 body arity inloop crossed)]
        (match r
          (VErr [msg] (VErr msg))
          (LOk2 [] (validate-arms next arity inloop crossed)))))))

(defn contains-recur [e :- HExpr depth :- i64] :- bool
  (if (> depth 200)
    false
    (let [tag (h-tag e)]
      (cond
        (= tag 32) true
        (= tag 37) false
        (= tag 22) (or (contains-recur (hv-a e) (+ depth 1))
                       (or (contains-recur (hv-b e) (+ depth 1))
                           (contains-recur (hv-c e) (+ depth 1))))
        (= tag 30) (contains-recur (hv-b e) (+ depth 1))
        (= tag 29) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 34) (or (contains-recur (hv-a e) (+ depth 1))
                       (arms-contains-recur (arms-of e) (+ depth 1)))
        (= tag 39) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 33) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 14) (seq-contains-recur (hargs-of e) (+ depth 1))
        (= tag 23) (or (contains-recur (hv-a e) (+ depth 1)) (contains-recur (hv-b e) (+ depth 1)))
        (= tag 24) (or (contains-recur (hv-a e) (+ depth 1)) (contains-recur (hv-b e) (+ depth 1)))
        false))))

(defn seq-contains-recur [es :- HExprs depth :- i64] :- bool
  (match es
    (HENil [] false)
    (HECons [kid next] (or (contains-recur kid depth) (seq-contains-recur next depth)))))

(defn arms-contains-recur [arms :- HArms depth :- i64] :- bool
  (match arms
    (HANil [] false)
    (HACons [variant binders body next] (or (contains-recur body depth) (arms-contains-recur next depth)))))

(defn kids-contains-recur [es :- HExprs depth :- i64] :- bool
  (seq-contains-recur es depth))

; --- match (+ :when guards) ------------------------------------------------------

; The guard rewrite (match_lower.rs): an arm (V [b :when g] body) becomes
; (V [b] (if g body (match scrut rest...))) plus a routing (_ (match scrut
; rest...)) — the rest chain is the ORIGINAL Ast tail, so the rewrite
; re-enters lower-match.
(defn lower-match [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (< (asts-depth items) 3)
    (LErr "match expects a scrutinee and at least one arm")
    (match (find-guard (asts-tail (asts-tail (clone items))) 0)
      (GFound [gi garm] (lower-match-g items env expected tab adts insts sigs lams rets ncached defs gi garm raws))
      (GNone [] (lower-match-plain items env expected tab adts insts sigs lams rets ncached defs raws)))))

(deftype GRes (GFound [gi :- i64 garm :- Ast]) (GNone []))

; the first arm whose binders contain :when (index within the arm list)
(defn find-guard [arms :- Asts i :- i64] :- GRes
  (match arms
    (KNil [] (GNone))
    (KCons [arm rest]
      (if (arm-has-guard (clone arm))
        (GFound i arm)
        (find-guard rest (+ i 1))))))

(defn arm-has-guard [arm :- Ast] :- bool
  (let [kids (ast-kids-of arm)]
    (if (< (asts-depth kids) 2)
      false
      (let [bs (asts-idx kids 1)]
        (if (not (= (ast-tag bs) 6))
          false
          (binder-guard (ast-kids-of (clone bs))))))))

(defn binder-guard [bs :- Asts] :- bool
  (match bs
    (KNil [] false)
    (KCons [b rest]
      (or (and (= (ast-tag b) 1) (= (ast-sid-of b) (s-whenkw)))
          (binder-guard rest)))))

; index of :within the binder vector, or -1
(defn guard-pos [bs :- Asts i :- i64] :- i64
  (match bs
    (KNil [] -1)
    (KCons [b rest]
      (if (and (= (ast-tag b) 1) (= (ast-sid-of b) (s-whenkw)))
        i
        (guard-pos rest (+ i 1))))))

(defn mk-sp [] :- Span
  (Span 0 0 0))

(defn mk-match-call [scrut :- Ast rest :- Asts] :- Ast
  (AList (KCons (ASym (s-match) (mk-sp)) (KCons scrut rest)) (mk-sp)))

(defn mk-guard-if [g :- Ast body :- Ast else-ast :- Ast] :- Ast
  (AList (KCons (ASym (s-if) (mk-sp))
          (KCons g (KCons body (KCons else-ast (KNil)))))
         (mk-sp)))

(defn arm-head [arm :- Ast] :- Ast
  (asts-idx (ast-kids-of arm) 0))

(defn arm-binders [arm :- Ast] :- Ast
  (asts-idx (ast-kids-of arm) 1))

(defn arm-body [arm :- Ast] :- Ast
  (asts-idx (ast-kids-of arm) 2))

(defn mk-rewritten-arm [garm :- Ast if-body :- Ast] :- Ast
  (AList (KCons (arm-head (clone garm))
          (KCons (AVec (binder-pre (ast-kids-of (arm-binders garm))) (mk-sp))
          (KCons if-body (KNil))))
         (mk-sp)))

(defn mk-route-arm [match-ast :- Ast] :- Ast
  (AList (KCons (ASym (s-wild) (mk-sp)) (KCons match-ast (KNil))) (mk-sp)))

(defn lower-match-g [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                    adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                    rets :- TyEnv ncached :- i64 defs :- Defns
                    gi :- i64 garm :- Ast raws :- &Raws] :- LRes
  (if (not (guard-shape-ok (clone garm)))
    (LErr "guard arms expect (Variant [binders :when cond] body)")
    (let [scrut (asts-idx (clone items) 1)
          rp (lower-1 (clone scrut) (clone env) (clone tab) (clone adts) (clone insts) (clone sigs) (clone lams) (clone rets) ncached (clone defs) raws)]
      (match rp
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 probe]
          (let [pt (ty-of probe env r2 s2)]
            (if (not (= (ty-tag pt) 16))
              (LErr "guard arms require an ADT scrutinee")
              (let [vdef (adts-at a2 (ty-arg pt))
                    rest (asts-tail (asts-drop (clone items) (+ 2 gi)))
                    rest-heads (arm-heads (clone rest))
                    covered (or (sids-has rest-heads (s-wild))
                                (all-covered rest-heads vdef 0))]
                (if (not covered)
                  (LErr (str "guard arm " (sym-str (clone tab) (asts-head-sid (ast-kids-of garm))) " falls through, but the later arms do not cover every variant (add a _ arm)"))
                  (let [arms0 (asts-drop (clone items) 2)
                        before-g (match-asts-take arms0 gi (KNil))
                        inner (mk-match-call (asts-idx (clone items) 1) (clone rest))
                        if-body (mk-guard-if (binder-cond (ast-kids-of (arm-binders (clone garm))))
                                             (arm-body (clone garm))
                                             inner)
                        rewritten (mk-rewritten-arm garm if-body)
                        route (mk-route-arm (mk-match-call (asts-idx items 1) rest))
                        next-arms (asts-append (asts-append before-g rewritten) route)
                        next-items (KCons (ASym (s-match) (mk-sp)) (KCons scrut next-arms))]
                    (lower-match next-items (clone env) expected tab adts insts sigs lams rets ncached defs raws)))))))))))

(defn binder-pre [bs :- Asts] :- Asts
  ; binders before :when
  (match bs
    (KNil [] (KNil))
    (KCons [b rest]
      (if (and (= (ast-tag b) 1) (= (ast-sid-of b) (s-whenkw)))
        (KNil)
        (KCons (clone b) (binder-pre rest))))))

(defn binder-cond [bs :- Asts] :- Ast
  ; the condition right after :when
  (match bs
    (KNil [] (ANil (Span 0 0 0)))
    (KCons [b rest]
      (if (and (= (ast-tag b) 1) (= (ast-sid-of b) (s-whenkw)))
        (asts-idx rest 0)
        (binder-cond rest)))))

(defn match-asts-take [ks :- Asts n :- i64 acc :- Asts] :- Asts
  (if (<= n 0)
    (match-asts-rev acc (KNil))
    (match ks
      (KNil [] (match-asts-rev acc (KNil)))
      (KCons [kid rest] (match-asts-take rest (- n 1) (KCons kid acc))))))

(defn match-asts-rev [ks :- Asts acc :- Asts] :- Asts
  (match ks
    (KCons [kid rest] (match-asts-rev rest (KCons kid acc)))
    (KNil [] acc)))

(defn asts-drop-last-n [ks :- Asts n :- i64 acc :- i64] :- Asts
  ; drop everything after the first n elements
  (if (<= n 0)
    (KNil)
    (match ks
      (KNil [] (KNil))
      (KCons [kid rest]
        (if (= n 1)
          (KCons kid (KNil))
          (KCons kid (asts-drop-last-n rest (- n 1) 0)))))))

(defn guard-shape-ok [arm :- Ast] :- bool
  (if (not (= (ast-tag arm) 5))
    false
    (let [vitems (ast-kids-of (clone arm))]
      (and (= (asts-depth vitems) 3)
           (let [bs (asts-idx vitems 1)
                 bs-kids (ast-kids-of (clone bs))
                 wpos (guard-pos (clone bs-kids) 0)]
             (and (= (ast-tag bs) 6)
                  (not (= wpos -1))
                  (= (+ wpos 2) (asts-depth bs-kids))))))))

(defn arm-heads [arms :- Asts] :- Sids
  (match arms
    (KNil [] (SNil))
    (KCons [arm rest]
      (SCons (asts-head-sid (ast-kids-of arm)) (arm-heads rest)))))

(defn o-sids [] :- Sids
  (SNil))

(defn variant-count [info :- AdtInfo] :- i64
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (vlist-depth variants))))

(defn all-covered [heads :- Sids info :- AdtInfo i :- i64] :- bool
  (match info
    (AdtInfo [name typarams variants tpl tplargs]
      (if (>= i (vlist-depth variants))
        true
        (let [vn (varnt-name-at variants i)]
          (if (sids-has heads vn)
            (all-covered heads info (+ i 1))
            false))))))

; the non-guard path: build the HMatch
(defn lower-match-plain [items :- Asts env :- TyEnv expected :- Ty tab :- i64
                        adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                        rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [scrut (asts-idx (clone items) 1)
        rs (lower-1 scrut (clone env) (clone tab) adts insts sigs lams rets ncached defs raws)]
    (match rs
      (LErr [msg] (LErr msg))
      (LOk [t2 a2 i2 s2 l2 r2 n2 d2 scrut2]
        (let [pt (ty-of scrut2 env r2 s2)]
          (if (not (= (ty-tag pt) 16))
            (LErr "match scrutinee must be an ADT value")
            (let [adt (ty-arg pt)
                  vdef (adts-at a2 adt)
                  ra (match-arms (asts-tail (asts-tail items)) (clone vdef) adt (clone env) pt t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HANil) (TyNil) false 0 raws)]
              (match ra
                (MArr [msg] (LErr msg))
                (MRes [t3 a3 i3 s3 l3 r3 n3 d3 arms3 tys3 wildcard3 narms]
                  (match (finish-match (clone tys3) wildcard3 narms vdef tab)
                    (VErr [msg] (LErr msg))
                    (LOk2 []
                      (let [merged (merge-arm-tys (clone tys3))]
                        (lok t3 a3 i3 s3 l3 r3 n3 d3
                             (HMatch (clone scrut2)
                                     (arms-coerce (arms-rev arms3 (HANil)) (tys-rev tys3 (TyNil)) (clone merged))
                                     merged))))))))))))))

; arms accumulate: (reversed arms chain, arm types in order, wildcard flag)
(deftype MRes (MRes [tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                    lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                    arms :- HArms tys :- TyList wildcard :- bool narms :- i64])
             (MArr [msg :- str]))

(defn rms-rev [arms :- HArms acc :- HArms] :- HArms
  (match arms
    (HANil [] acc)
    (HACons [variant binders body next] (arms-rev next (HACons variant binders body acc)))))

(defn match-arms [arms :- Asts vdef :- AdtInfo adt :- i64 env :- TyEnv pt :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                 acc :- HArms tys :- TyList wildcard :- bool narms :- i64 raws :- &Raws] :- MRes
  (match arms
    (KNil [] (MRes tab adts insts sigs lams rets ncached defs acc tys wildcard narms))
    (KCons [arm rest]
      (let [head (asts-head-sid (ast-kids-of (clone arm)))]
        (if (= head (s-wild))
          ; wildcard arm: (_ body)
          (if wildcard
            (MArr "match has more than one wildcard arm")
            (if (not (= (asts-depth (ast-kids-of (clone arm))) 2))
              (MArr "wildcard arm expects (_ body)")
              (let [bodyn (asts-idx (ast-kids-of arm) 1)
                    rb (lower-e bodyn (clone env) (clone pt) (clone tab) (clone adts) (clone insts) (clone sigs) (clone lams) (clone rets) ncached defs raws)]
                (match rb
                  (LErr [msg] (MArr msg))
                  (LOk [t2 a2 i2 s2 l2 r2 n2 d2 body2]
                    (let [bt (ty-of body2 env r2 s2)]
                      ; same as the variant arm: the body's lowering hands the
                      ; definition list back, so it is threaded, not copied
                      (match-arms rest vdef adt (clone env) pt (clone tab) adts insts sigs lams rets ncached d2
                                  (HACons -1 (SNil) (clone body2) acc) (TyCons bt tys) true (+ 1 narms) raws)))))))
          ; variant arm: (V [b1 b2] body)
          (let [vi (variant-index (clone vdef) head 0)]
            (if (< vi 0)
              (MArr (str (sym-str (clone tab) head) " is not a variant of " (adts-name vdef (clone tab))))
              (let [fields (variant-fields vdef vi)]
                (match-variant-arm arm rest vdef adt vi fields (clone env) pt tab adts insts sigs lams rets ncached defs acc tys wildcard narms raws)))))))))

(defn adts-name [info :- AdtInfo tab :- i64] :- str
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (sym-str (clone tab) name))))

(defn variant-index [info :- AdtInfo name :- i64 i :- i64] :- i64
  (match info
    (AdtInfo [name2 typarams variants tpl tplargs]
      (if (>= i (vlist-depth variants))
        -1
        (let [vn (varnt-name-at variants i)]
          (if (= vn name) i (variant-index info name (+ i 1))))))))

; Borrowed: the caller keeps its AdtInfo (it used to clone the whole thing,
; which also meant a deep drop afterwards) and only the field list is copied.
(defn variant-fields [info :- &AdtInfo vi :- i64] :- TyList
  (match info
    (AdtInfo [name typarams variants tpl tplargs]
      (vlist-fields-at variants vi))))

(defn match-variant-arm [arm :- Ast rest :- Asts vdef :- AdtInfo adt :- i64 vi :- i64
                        fields :- TyList env :- TyEnv pt :- Ty tab :- i64
                        adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                        rets :- TyEnv ncached :- i64 defs :- Defns
                        acc :- HArms tys :- TyList wildcard :- bool narms :- i64 raws :- &Raws] :- MRes
  (if (not (= (ast-tag arm) 5))
    (MArr "match arm must be a list")
    (let [vitems (ast-kids-of (clone arm))]
      (if (not (= (asts-depth vitems) 3))
        (MArr (str "match arm " (sym-str (clone tab) (asts-head-sid vitems)) " expects (" (sym-str (clone tab) (asts-head-sid vitems)) " [binders...] body)"))
        (let [bs (asts-idx (clone vitems) 1)]
          (if (not (= (ast-tag bs) 6))
            (MArr (str "match arm " (sym-str (clone tab) (asts-head-sid vitems)) " binders must be a vector"))
            (if (not (= (asts-depth (ast-kids-of (clone bs))) (tys-depth fields)))
              (MArr (str "variant " (adts-name vdef (clone tab)) " has " (tys-depth fields) " field(s) but the arm binds " (asts-depth (ast-kids-of (clone bs)))))
              ; binders: wildcard `_` gets a gensym
              (let [rb (match-binders (ast-kids-of (clone bs)) fields 0 (clone env) (SNil) (SNil) (clone tab) ncached)]
                (match rb
                  (MBErr [msg] (MArr msg))
                  (MBRes [t3 n3 env3 binders3]
                    (let [bodyn (asts-idx vitems 2)
                          rb2 (lower-e bodyn (clone env3) (clone pt) t3 adts insts (clone sigs) (clone lams) (clone rets) n3 defs raws)]
                      (match rb2
                        (LErr [msg] (MArr msg))
                        (LOk [t4 a4 i4 s4 l4 r4 n4 d4 body2]
                          (let [bt (ty-of body2 env3 r4 s4)]
                            ; Thread the defs the body lowering handed back.
                            ; Expression lowering never adds a definition, so
                            ; d4 *is* defs — and cloning defs here (the whole
                            ; program's definition list, bodies included)
                            ; accounted for a third of the kernel's churn.
                            (match-arms rest vdef adt env pt (clone tab) a4 i4 sigs lams rets ncached d4
                                        (HACons vi binders3 (clone body2) acc) (TyCons bt tys) wildcard (+ 1 narms) raws))
)))))))))))))

; The table and instance map were threaded through this walk and returned
; untouched — callers cloned a whole AdtTab (and an IMap) per arm to satisfy
; the shape. Nothing here reads them, so they are gone.
(deftype MBRes (MBRes [tab :- i64 ncached :- i64 env :- TyEnv binders :- Sids])
              (MBErr [msg :- str]))

(defn match-binders [bs :- Asts fields :- TyList k :- i64 env :- TyEnv acc :- Sids
                    seen :- Sids tab :- i64 ncached :- i64] :- MBRes
  (if (>= k (asts-depth bs))
    (MBRes tab ncached env (sids-rev acc (SNil)))
    (let [b (asts-idx (clone bs) k)
          fty (tys-idx (clone fields) k)]
      (if (not (= (ast-tag b) 1))
        (MBErr (str "match arm binder must be a symbol"))
        (let [bn (ast-sid-of b)]
          (if (= bn (s-wild))
            ; unique gensym, never referenced by the arm body
            (let [g (intern1 tab (str "_wild" (+ k ncached)))]
              (match g
                (I1Res [tab2 gsid]
                  (match-binders bs fields (+ k 1) env (SCons gsid acc) (SCons gsid seen) tab2 ncached))))
            (match-binders bs fields (+ k 1) (te-put env bn fty) (SCons bn acc) (SCons bn seen) tab ncached)))))))

; exhaustiveness + the f64-promoting arm merge (finish_match)
; exhaustiveness: a wildcard arm present, or the arm count (each variant
; at most once — the seed's duplicate check is message-only here) covers
; every variant. Missing-variant NAMES in the diagnostic are a nicety the
; byte contract does not pin.
(defn finish-match [tys :- TyList wildcard :- bool narms :- i64 vdef :- AdtInfo tab :- i64] :- VRes
  (if (not wildcard)
    (if (< narms (vlist-depth-of (clone vdef)))
      (VErr (str "match on " (adts-name vdef tab) " does not cover: (add arms or a _ wildcard)"))
      (LOk2))
    (LOk2)))

(defn vlist-depth-of [info :- AdtInfo] :- i64
  (match info
    (AdtInfo [name typarams variants tpl tplargs] (vlist-depth variants))))

; the arm merge (the seed's f64 promotion): f64 wins over i64; all-else
; must agree exactly
(defn merge-arm-tys [tys :- TyList] :- Ty
  (if (tys-has-f64 (clone tys))
    (t-f64)
    (tys-idx tys 0)))

(defn tys-has-f64 [tys :- TyList] :- bool
  (match tys
    (TyNil [] false)
    (TyCons [h t] (or (ty-eq h (t-f64)) (tys-has-f64 t)))))



; coerce int arm bodies up when the merged match type is f64 (the seed's
; finish_match coercion walk, in arm order)
(defn arms-coerce [arms :- HArms tys :- TyList merged :- Ty] :- HArms
  (match arms
    (HANil [] (HANil))
    (HACons [variant binders body next]
      (match tys
        (TyNil [] (HANil))
        (TyCons [t trest]
          (HACons variant binders
                  (coerce-f64 body t (ty-eq (clone merged) (t-f64)))
                  (arms-coerce next trest merged)))))))

; --- constructor resolution ------------------------------------------------------

; find a variant constructor among DECLARED templates (instances share
; their template's ctors and are never resolved directly)
(defn find-variant [ts :- &AdtTab name :- i64] :- FVRes
  (find-variant-2 ts name 0 0))

(deftype FVRes (FVFound [adt :- i64 variant :- i64 fields :- TyList]) (FVMiss))

(defn find-variant-2 [ts :- &AdtTab name :- i64 ai :- i64 vi :- i64] :- FVRes
  (match ts
    (ATCons [h t]
      (match h
        (AdtInfo [aname typarams variants tpl tplargs]
          (if (not (= tpl -1))
            (find-variant-2 t name (+ ai 1) 0)
            (if (>= vi (vlist-depth variants))
              (find-variant-2 t name (+ ai 1) 0)
              (let [v (vlist-at variants vi)]
                (match v
                  (Varnt [vname fields]
                    (if (= vname name)
                      (FVFound ai vi fields)
                      (find-variant-2 ts name ai (+ vi 1)))))))))))
    (ATNil [] (FVMiss))))

; lower a ctor call: fields unify against the template; nullary ctors
; infer from the expected type's instance
(defn lower-ctor [fv :- FVRes items :- Asts env :- TyEnv expected :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (match fv
    (FVMiss [] (LErr "internal: ctor miss"))
    (FVFound [adt variant fields]
      (let [tpl-params (adts-tparams adts adt)
            ; expected pinning: an instance of this template takes its fields
            inst-exp (if (and (> tpl-params 0) (= (ty-tag expected) 16))
                       (instance-of-template adts (ty-arg expected) adt)
                       -1)]
        (if (>= inst-exp 0)
          ; the expected instance pins the ctor (the seed's inst_expected
          ; rule): its fields, its table index, no inference
          (lower-ctor-fields items inst-exp variant (instance-fields (clone adts) inst-exp variant)
                             env 0 (TENil)
                             tab adts insts sigs lams rets ncached defs 0 (HENil) raws)
          (lower-ctor-fields items adt variant fields
                             env tpl-params (TENil)
                             tab adts insts sigs lams rets ncached defs 0 (HENil) raws))))))

(defn index-sids [n :- i64 i :- i64] :- Sids
  (if (>= i n) (SNil) (SCons i (index-sids n (+ i 1)))))

(defn subs-collect [subs :- &TyEnv i :- i64 n :- i64] :- TyList
  (if (>= i n) (TyNil) (TyCons (te-get subs i) (subs-collect subs (+ i 1) n))))

(defn ctor-instantiate [adt :- i64 variant :- i64 args :- HExprs targs :- TyList
                       tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                       lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [r (instantiate-adt adt targs (PS tab (DLNil) adts sigs (SNil) ""))]
    (match r
      (PIARes [ps2 idx]
        (if (ps-failed ps2)
          (LErr (ps-err-msg ps2))
          (match (clone ps2)
            (PS [t2 d2 a2 s2 y2 e2]
              (lok t2 a2 insts s2 lams rets ncached defs
                   (HCtor idx variant args)))))))))

(defn ctor-finish [adt :- i64 variant :- i64 args :- HExprs nparams :- i64 subs :- TyEnv expected :- Ty
                  tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                  lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (= nparams 0)
    (lok tab adts insts sigs lams rets ncached defs
         (HCtor adt variant args))
    (let [miss (unbound-param (index-sids nparams 0) subs)]
      (if (= (sids-depth miss) 0)
        (ctor-instantiate adt variant args (subs-collect subs 0 nparams)
                          tab adts insts sigs lams rets ncached defs raws)
        ; unbound parameters: a nullary ctor of a generic ADT infers from
        ; the expected instance of the same template
        (if (not (= (ty-tag expected) 16))
          (LErr (str "cannot infer the type argument(s) of the constructor — ascribe the binding"))
          (let [ed (adts-at adts (ty-arg expected))]
            (match ed
              (AdtInfo [en etp ev etpl eargs]
                (if (not (= etpl adt))
                  (LErr (str "cannot infer the type argument(s) of the constructor for the expected type"))
                  (ctor-instantiate adt variant args eargs
                                    tab adts insts sigs lams rets ncached defs raws))))))))))

(defn lower-ctor-fields [items :- Asts adt :- i64 variant :- i64 fields :- TyList
                        env :- TyEnv nparams :- i64 subs :- TyEnv
                        tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                        lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns
                        k :- i64 acc :- HExprs raws :- &Raws] :- LRes
  (if (not (= (tys-depth fields) (- (asts-depth items) 1)))
    (LErr (str "constructor expects " (tys-depth fields) " argument(s), got " (- (asts-depth items) 1)))
    (if (>= k (tys-depth fields))
      (ctor-finish adt variant (hes-rev acc (HENil)) nparams subs (clone env)
                   tab adts insts sigs lams rets ncached defs raws)
      (let [argn (asts-idx (clone items) (+ k 1))
            fty (tys-idx (clone fields) k)
            ra (lower-e argn (clone env) (clone fty) tab adts insts sigs lams rets ncached defs raws)]
        (match ra
          (LErr [msg] (LErr msg))
          (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
            (let [at0 (ty-of e2 env r2 s2)
                  ; literal-friendly coercions: an i64 argument widens where
                  ; the field is f64; an empty vector literal satisfies any
                  ; vector field (the seed's rules)
                  emptv (and (= (ty-tag fty) 15)
                             (= (h-tag e2) 5)
                             (= (vvals-depth-of (clone e2)) 0))
                  widq (and (ty-eq (clone fty) (t-f64)) (ty-eq (clone at0) (t-i64)))
                  e3 (if widq (HICast (clone e2) (t-i64) (t-f64)) (clone e2))
                  at (if emptv (clone fty)
                       (if widq (t-f64) at0))]
              (match (unify (clone fty) (clone at) subs)
                (UResErr [] (LErr (str "constructor field expects " (ty-name fty) ", got " (ty-name at))))
                (UResOk [subs2]
                  (lower-ctor-fields items adt variant fields (clone env) nparams subs2
                                     t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (+ k 1) (HECons e3 acc) raws))))))))))

(defn adts-tparams [ts :- &AdtTab i :- i64] :- i64
  (match (adts-at ts i)
    (AdtInfo [name typarams variants tpl tplargs] (sids-depth typarams))))

; is instance j an instance of template tpl? -> j else -1
(defn instance-of-template [ts :- &AdtTab j :- i64 tpl :- i64] :- i64
  (match (adts-at ts j)
    (AdtInfo [name typarams variants vtpl tplargs]
      (if (= vtpl tpl) j -1))))

(defn instance-fields [ts :- AdtTab j :- i64 vi :- i64] :- TyList
  (match (adts-at ts j)
    (AdtInfo [name typarams variants vtpl tplargs]
      (match (vlist-at variants vi)
        (Varnt [vname fs] fs)))))

; --- the call arm ---------------------------------------------------------------
; The seed's dispatch order: (1) closure-value calls from env, (2)
; constructor resolution, (3) generic defn instantiation, (4) even? and
; known callees, (5) the unknown-function error.

(defn lower-call-args [items :- Asts i :- i64 env :- TyEnv tab :- i64
                      adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                      rets :- TyEnv ncached :- i64 defs :- Defns head :- i64
                      kind :- i64 sig :- i64 acc :- HExprs raws :- &Raws] :- LRes
  (if (>= i (asts-depth items))
    (lok tab adts insts sigs lams rets ncached defs
         (if (= kind 0)
           (HCall head (hes-rev acc (HENil)))
           (HClosureCall (HVar head) (hes-rev acc (HENil)) sig)))
    (let [a (asts-idx (clone items) i)
          r (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lower-call-args items (+ i 1) env t2 a2 i2 s2 l2 r2 n2 d2 head kind sig (HECons e2 acc) raws))))))

(defn call-argtys [args :- HExprs env :- &TyEnv rets :- &TyEnv sigs :- Sigs acc :- TyList] :- TyList
  ; the concrete argument types, in order (the seed maps ty_of over args)
  (match args
    (HENil [] (tys-rev acc (TyNil)))
    (HECons [kid next]
      (call-argtys next env rets (clone sigs) (TyCons (ty-of kid env rets sigs) acc)))))

(defn lower-call [head :- i64 items :- Asts env :- TyEnv expected :- Ty
                 tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                 lams :- Lams rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [ht (te-get env head)]
    (if (= (ty-tag ht) 17)
      (let [sig (ty-arg ht)]
        (match (sigs-at sigs sig)
          (Sig [want swant]
            (let [nargs (- (asts-depth items) 1)]
              (if (not (= nargs (tys-depth want)))
                (LErr (str "closure call expects " (tys-depth want) " argument(s), got " nargs))
                (lower-call-args items 1 (clone env) tab adts insts sigs lams rets ncached defs head 1 sig (HENil) raws))))))
      (match (find-variant adts head)
        (FVFound [adt variant fields]
          (lower-ctor (FVFound adt variant fields) items (clone env) expected
                      tab adts insts sigs lams rets ncached defs raws))
        (FVMiss []
          (let [raw (raws-find raws head)]
            (match raw
              (RawDefn [rname rp rret rtps rie rbody rb]
                (cond
                  (> (sids-depth rtps) 0)
                  (match (lower-call-args (clone items) 1 (clone env) tab adts insts sigs lams rets ncached defs head 0 -1 (HENil) raws)
                    (LErr [msg] (LErr msg))
                    (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                      (if (not (= (h-tag e2) 39))
                        (LErr "internal: call args shape")
                        (let [args (hargs-of e2)
                              argtys (call-argtys (clone args) env r2 (clone s2) (TyNil))
                              mi (instantiate head argtys t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                          (match mi
                            (MIRes [t3 a3 i3 s3 l3 r3 n3 d3 mangled mret msg]
                              (if (> (count msg) 0)
                                (LErr msg)
                                (lok t3 a3 i3 s3 l3 r3 n3 d3 (HCall mangled args)))))))))
                  (= rname -1)
                  (if (= head (s-evenq))
                    (lower-call-args (clone items) 1 (clone env) tab adts insts sigs lams rets ncached defs head 0 -1 (HENil) raws)
                    (LErr (str "unknown function " (sym-str (clone tab) head))))
                  (lower-call-args items 1 (clone env) tab adts insts sigs lams rets ncached defs head 0 -1 (HENil) raws))))))))))

(defn lower-list [a :- Ast env :- TyEnv expected :- Ty tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [kids (ast-kids-of a)
        h (asts-head-sid kids)]
    (cond
      (= h (s-do))
      (lower-do (asts-tail (clone kids)) (clone env) (clone expected) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-fn))
      (lower-closure (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-let))
      (lower-let (asts-tail (clone kids)) (clone env) (clone expected) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-if))
      (lower-if (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-notform))
      (lower-not (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-abs))
      (lower-abs (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-min))
      (lower-minmax 0 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-max))
      (lower-minmax 1 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-match))
      (lower-match (clone kids) (clone env) (clone expected) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-loop))
      (lower-loop (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-recur))
      (lower-recur (asts-tail (clone kids)) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-and))
      (lower-andor 0 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-or))
      (lower-andor 1 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (s-eq)) (= h (s-ne)) (= h (s-lt)) (= h (s-gt)) (= h (s-le)) (= h (s-ge)))
      (lower-cmp (cmp-op h) (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (s-add)) (= h (s-sub)) (= h (s-mul)) (= h (s-div)))
      (lower-arith (arith-op h) (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (s-f64)) (= h (s-f32)) (= h (s-i8)) (= h (s-i16)) (= h (s-i32)) (= h (s-i64))
          (= h (s-u8)) (= h (s-u16)) (= h (s-u32)) (= h (s-u64)) (= h (s-usize)))
      (lower-cast h (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-getform))
      (lower-get (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-conjform))
      (lower-conj (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-count))
      (lower-count (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-strform))
      (lower-str (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-subs))
      (lower-subs (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-split))
      (lower-split (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-join))
      (lower-join (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-nth))
      (lower-nth (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-charstr))
      (lower-charstr (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-clone))
      (lower-clone (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-dropform))
      (lower-drop (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-slurp))
      (lower-slurp (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-spit))
      (lower-spit (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-args))
      (lok tab adts insts sigs lams rets ncached defs (HArgs))

      (= h (s-exit))
      (lower-exit (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-parsei64))
      (lower-parse 1 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (= h (s-parsef64))
      (lower-parse 0 (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (s-printstr)) (= h (s-printstring)) (= h (s-printf64)) (= h (s-printi64)))
      (lower-print h (clone kids) (clone env) tab adts insts sigs lams rets ncached defs raws)

      (or (= h (s-veci64)) (= h (s-vecf64)))
      (lower-vec-builtin h (clone kids) tab adts insts sigs lams rets ncached defs)

      (or (= h (s-reduce)) (= h (s-for)) (= h (s-parallel)) (= h (s-map)) (= h (s-filter))
          (= h (s-doseq)))
      (LErr (str "unsupported form " (sym-str (clone tab) h)))

      (lower-call h kids env expected tab adts insts sigs lams rets ncached defs raws))))
; --- builtin arms -----------------------------------------------------------------

(defn lower-arith [op :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr "binary op expects 2 operands")
    (let [a (asts-idx (clone items) 1)
          ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match ra
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
          (let [b (asts-idx items 2)
                rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match rb
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
                (match (promote-bin op e1 e2 env r2 (clone s2))
                  (LRes1Err [msg] (LErr msg))
                  (LRes1Ok [e3] (lok t2 a2 i2 s2 l2 r2 n2 d2 e3)))))))))))

(defn cast-target [h :- i64] :- Ty
  (cond
    (= h (s-f64)) (t-f64)
    (= h (s-f32)) (t-f32)
    (= h (s-i8)) (t-i8)
    (= h (s-i16)) (t-i16)
    (= h (s-i32)) (t-i32)
    (= h (s-i64)) (t-i64)
    (= h (s-u8)) (t-u8)
    (= h (s-u16)) (t-u16)
    (= h (s-u32)) (t-u32)
    (= h (s-u64)) (t-u64)
    (t-usize)))

(defn lower-cast [h :- i64 items :- Asts env :- TyEnv tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "cast expects exactly 1 argument")
    (let [r (lower-1 (asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [src (ty-of e2 env r2 s2)
                target (cast-target h)]
            (cond
              (ty-eq (clone src) (clone target)) (lok (clone t2) (clone a2) (clone i2) (clone s2) (clone l2) (clone r2) n2 (clone d2) (clone e2))
              (is-numeric-ty (clone src)) (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HICast (clone e2) (clone src) target))
              (LErr (str "cast expects a numeric operand, got " (ty-name src))))))))))

(defn lower-recur [args :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower-recur-2 args (HENil) env tab adts insts sigs lams rets ncached defs raws))

(defn lower-recur-2 [args :- Asts acc :- HExprs env :- TyEnv tab :- i64
                    adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                    rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (asts-null args)
    (lok tab adts insts sigs lams rets ncached defs (HRecur (hes-rev acc (HENil))))
    (let [r (lower-1 (asts-idx (clone args) 0) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lower-recur-2 (asts-tail args) (HECons e2 acc) env t2 a2 i2 s2 l2 r2 n2 d2 raws))))))

(defn lower-count [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "count expects exactly 1 argument")
    (let [r (lower-1 (asts-idx items 1) env tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HCount e2)))))))

(defn lower-clone [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "clone expects 1 argument")
    (let [r (lower-1 (asts-idx items 1) env tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HClone e2)))))))

(defn lower-drop [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "drop expects 1 argument")
    (let [r (lower-1 (asts-idx items 1) env tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (lok t2 a2 i2 s2 l2 r2 n2 d2 (HDrop e2)))))))

(defn lower-charstr [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                    insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                    ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "char->str expects exactly 1 argument")
    (let [r (lower-1 (asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of e2 env r2 s2) (t-i64)))
            (LErr "char->str expects an i64 byte value")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HCharStr (clone e2)))))))))

(defn lower-slurp [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "slurp expects (slurp <path>)")
    (let [r (lower-1 (asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of e2 env r2 s2) (t-str)))
            (LErr "slurp path must be a string")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HSlurp (clone e2)))))))))

(defn lower-spit [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr "spit expects (spit <path> <content>)")
    (let [r1 (lower-1 (asts-idx (clone items) 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match (clone r1)
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 p]
          (let [r2 (lower-1 (asts-idx items 2) env t1 a1 i1 s1 l1 r1 n1 d1 raws)]
            (match (clone r2)
              (LErr [msg] (LErr msg))
              (LOk [t2 a2 i2 s2 l2 r2 n2 d2 d]
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSpit p d))))))))))

(defn lower-exit [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "exit expects (exit <status>)")
    (let [r (lower-1 (asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of e2 env r2 s2) (t-i64)))
            (LErr "exit status must be i64")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HExit (clone e2)))))))))

(defn lower-parse [intf :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "parse expects (parse <s>)")
    (let [r (lower-1 (asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (not (ty-eq (ty-of e2 env r2 s2) (t-str)))
            (LErr "parse expects a string")
            (let [want (if (= intf 1) (t-i64) (t-f64))
                  oi (option-instance want t2 a2 (clone s2))]
              (match oi
                (OIRes [t3 a3 idx]
                  (lok t3 a3 i2 (clone s2) l2 (clone r2) n2 d2 (HParseNum (clone e2) intf (t-adt idx))))))))))))

(defn lower-print [h :- i64 items :- Asts env :- TyEnv tab :- i64
                  adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                  rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 2))
    (LErr "print-* expects exactly 1 argument")
    (let [r (lower-1 (asts-idx items 1) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (if (and (= h (s-printstr)) (not (ty-eq (ty-of e2 env r2 s2) (t-str))))
            (LErr "print-str expects a string")
            (lok t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 (HCall h (HECons (clone e2) (HENil))))))))))

(defn lower-vec-builtin [h :- i64 items :- Asts tab :- i64 adts :- AdtTab
                        insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                        ncached :- i64 defs :- Defns] :- LRes
  (let [els (asts-tail items)]
    (if (= h (s-veci64))
      (if (kids-all-int (clone els))
        (lok tab adts insts sigs lams rets ncached defs (HVecLit 0 (kids-i64s els (VVNil))))
        (LErr "vec-i64 elements must be i64 literals"))
      (if (kids-all-num (clone els))
        (lok tab adts insts sigs lams rets ncached defs (HVecLit 1 (kids-f64s els (VVNil))))
        (LErr "vec-f64 elements must be numeric literals")))))

; --- (str ...) constant folding ---------------------------------------------------
; A single-argument (str x) is just x; an all-literal (str "a" "b" ...) folds to a
; single literal. Without this the kernel emits a runtime malloc+memcpy for every
; literal string fragment, of which the kernel source has very many.
(defn hs-lit-of [e :- &HExpr] :- bool
  (match e
    (HStrLit [_] true)
    (_ false)))

(defn hs-all-lit [es :- &HExprs] :- bool
  (match es
    (HENil [] true)
    (HECons [kid next] (if (hs-lit-of kid) (hs-all-lit next) false))))

(defn hs-join-lit [es :- &HExprs acc :- str] :- str
  (match es
    (HENil [] acc)
    (HECons [kid next]
      (match kid
        (HStrLit [s] (hs-join-lit next (str acc s)))
        (_ acc)))))

(defn hs-one [es :- &HExprs] :- bool
  (match es
    (HECons [_ next] (hes-null next))
    (HENil [] false)))

(defn lower-str [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (< (asts-depth items) 2)
    (LErr "str expects at least one argument")
    (lower-str-args (asts-tail items) (HENil) env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-str-args [els :- Asts acc :- HExprs env :- TyEnv tab :- i64
                     adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                     rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (asts-null els)
     (let [args (hes-rev acc (HENil))]
       (if (hs-one args)
         (lok tab adts insts sigs lams rets ncached defs (hes-head-hes args))
         (if (hs-all-lit args)
           (lok tab adts insts sigs lams rets ncached defs (HStrLit (hs-join-lit args "")))
           (lok tab adts insts sigs lams rets ncached defs (HStrCat (clone args))))))
    (let [r (lower-1 (asts-idx (clone els) 0) (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match r
        (LErr [msg] (LErr msg))
        (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
          (let [t (ty-of e2 env r2 s2)]
            (if (or (ty-eq (clone t) (t-str)) (is-numeric-ty (clone t)) (ty-eq (clone t) (t-bool)))
              (let [e3 (if (ty-eq (clone t) (t-str)) (clone e2) (HToStr (clone e2) t))]
                (lower-str-args (asts-tail els) (HECons e3 acc) (clone env) t2 a2 i2 (clone s2) l2 (clone r2) n2 d2 raws))
              (LErr (str "str arguments must be strings, numbers or bools, got " (ty-name t))))))))))

(defn lower-subs [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 4))
    (LErr "subs expects (subs <s> <start> <end>)")
    (lower-3-to items 0 env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-split [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                  insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                  ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr "split expects (split <s> <sep>)")
    (lower-2-to items 0 env tab adts insts sigs lams rets ncached defs "split" 16 raws)))

(defn lower-join [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr "join expects (join <sep> <strs>)")
    (lower-join-2 items env tab adts insts sigs lams rets ncached defs raws)))

(defn lower-get [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [n (asts-depth items)]
    (if (and (not (= n 3)) (not (= n 4)))
      (LErr "get expects (get <vec> <idx>) or (get <vec> <idx> <default>)")
      (let [src (asts-idx (clone items) 1)
            rs (lower-1 src (clone env) tab adts insts sigs lams rets ncached defs raws)]
        (match rs
          (LErr [msg] (LErr msg))
          (LOk [t1 a1 i1 s1 l1 r1 n1 d1 src2]
            (let [st (ty-of src2 env r1 s1)]
              (if (not (= (ty-tag st) 15))
                (LErr (str "get source must be a vector, got " (ty-name st)))
                (let [elc (ty-arg st)
                      et (elem-ty elc)
                      idx (asts-idx (clone items) 2)
                      ri (lower-1 idx (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
                  (match ri
                    (LErr [msg] (LErr msg))
                    (LOk [t2 a2 i2 s2 l2 r2 n2 d2 idx2]
                      (if (= n 4)
                        (let [dflt (asts-idx items 3)
                              rd (lower-1 dflt (clone env) t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                          (match rd
                            (LErr [msg] (LErr msg))
                            (LOk [t3 a3 i3 s3 l3 r3 n3 d3 d2]
                              (lok t3 a3 i3 s3 l3 r3 n3 d3 (HGet (clone src2) idx2 (HECons d2 (HENil)) et (t-none))))))
                        (if (= elc 2)
                          (LErr "Option get over (Vector str) is not supported — use (get v i default)")
                          (let [oi (option-instance (clone et) t2 a2 (clone s2))]
                            (match oi
                              (OIRes [t3 a3 opt]
                                (lok t3 a3 i2 s2 l2 r2 n2 d2 (HGet (clone src2) idx2 (HENil) et (t-adt opt)))))))))))))))))))

(defn vvals-append-i64 [ks :- VVals v :- i64] :- VVals
  (match ks
    (VVNil [] (VVI64 v (VVNil)))
    (VVI64 [w next] (VVI64 w (vvals-append-i64 next v)))
    (VVF64 [w next] (VVF64 w (vvals-append-i64 next v)))))

(defn vvals-append-f64 [ks :- VVals v :- f64] :- VVals
  (match ks
    (VVNil [] (VVF64 v (VVNil)))
    (VVI64 [w next] (VVI64 w (vvals-append-f64 next v)))
    (VVF64 [w next] (VVF64 w (vvals-append-f64 next v)))))

(defn vvals-promote [ks :- VVals] :- VVals
  ; an i64 literal promoted to an f64 literal (the conj fold rule)
  (match ks
    (VVNil [] (VVNil))
    (VVI64 [w next] (VVF64 (f64 w) (vvals-promote next)))
    (VVF64 [w next] (VVF64 w (vvals-promote next)))))

(defn lower-conj-plain [elc :- i64 v2 :- HExpr x2 :- HExpr env :- TyEnv
                       tab :- i64 adts :- AdtTab insts :- IMap
                       sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                       defs :- Defns] :- LRes
  (let [xt (ty-of x2 env rets sigs)
        want (elem-ty elc)
        wf64 (ty-eq (clone want) (t-f64))
        xi64 (ty-eq (clone xt) (t-i64))]
    (if (and (not (ty-eq (clone xt) (clone want))) (not (and wf64 xi64)))
      (LErr (str "conj element expects " (ty-name want) ", got " (ty-name xt)))
      (let [x3 (if (and wf64 xi64)
                 (HICast (clone x2) (t-i64) (t-f64))
                 (clone x2))]
        (lok tab adts insts sigs lams rets ncached defs
             (HConj v2 x3 elc 0))))))

(defn lower-conj-fold [elc :- i64 v2 :- HExpr x2 :- HExpr env :- TyEnv
                      tab :- i64 adts :- AdtTab insts :- IMap
                      sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64
                      defs :- Defns] :- LRes
  ; conj on a literal vector with a constant element folds to a new
  ; static literal (zero runtime cost) — the seed's three fold arms
  (let [xt (ty-of x2 env rets sigs)]
    (cond
      (and (= (h-tag v2) 5) (= (h-tag x2) 0) (= (hvec-el (clone v2)) 0))
      (lok tab adts insts sigs lams rets ncached defs
           (HVecLit 0 (vvals-append-i64 (hvec-vals (clone v2)) (hconst-i64-of (clone x2)))))

      (and (= (h-tag v2) 5) (= (h-tag x2) 1) (= (hvec-el (clone v2)) 1))
      (lok tab adts insts sigs lams rets ncached defs
           (HVecLit 1 (vvals-append-f64 (hvec-vals (clone v2)) (hconst-f64-of (clone x2)))))

      (and (= (h-tag v2) 5) (= (h-tag x2) 1) (= (hvec-el (clone v2)) 0))
      (lok tab adts insts sigs lams rets ncached defs
           (HVecLit 1 (vvals-append-f64 (vvals-promote (hvec-vals (clone v2))) (hconst-f64-of (clone x2)))))

      ; (F64 lit, i64 const) falls through to the runtime conj
      (lower-conj-plain elc v2 (clone x2) (clone env) tab (clone adts) (clone insts)
                        (clone sigs) (clone lams) (clone rets) ncached (clone defs)))))

(defn lower-conj [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                 insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                 ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (if (not (= (asts-depth items) 3))
    (LErr "conj expects (conj <vec> <x>)")
    (let [v (asts-idx (clone items) 1)
          rv (lower-1 v (clone env) tab adts insts sigs lams rets ncached defs raws)]
      (match rv
        (LErr [msg] (LErr msg))
        (LOk [t1 a1 i1 s1 l1 r1 n1 d1 v2]
          (let [vt (ty-of v2 env r1 s1)]
            (if (not (= (ty-tag vt) 15))
              (LErr (str "conj source must be a vector, got " (ty-name vt)))
              (let [elc (ty-arg vt)
                    x (asts-idx items 2)
                    rx (lower-1 x (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
                (match rx
                  (LErr [msg] (LErr msg))
                  (LOk [t2 a2 i2 s2 l2 r2 n2 d2 x2]
                    (lower-conj-fold elc (clone v2) x2 (clone env) t2 a2 i2 s2 l2 r2 n2 d2)))))))))))

(defn lower-nth [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  ; two-argument nth is (StrNth s idx (Option i64)); the explicit-default
  ; form desugars to a match over it with binder $b (the seed's rule)
  (let [n (asts-depth items)]
    (if (or (> n 4) (< n 3))
      (LErr "nth expects (nth <s> <idx>) or (nth <s> <idx> <default>)")
      (let [snode (asts-idx (clone items) 1)
            rs (lower-1 snode (clone env) tab adts insts sigs lams rets ncached defs raws)]
        (match rs
          (LErr [msg] (LErr msg))
          (LOk [t1 a1 i1 s1 l1 r1 n1 d1 sval]
            (if (not (ty-eq (ty-of sval env r1 s1) (t-str)))
              (LErr "nth source must be a string")
              (let [idxnode (asts-idx (clone items) 2)
                    ri (lower-1 idxnode (clone env) t1 a1 i1 (clone s1) l1 (clone r1) n1 d1 raws)]
                (match ri
                  (LErr [msg] (LErr msg))
                  (LOk [t2 a2 i2 s2 l2 r2 n2 d2 idxval]
                    (if (not (ty-eq (ty-of idxval env r2 s2) (t-i64)))
                      (LErr "nth index must be i64")
                      (let [oi (option-instance (t-i64) t2 a2 (clone s2))]
                        (match oi
                          (OIRes [t3 a3 opt]
                            (if (= n 3)
                              (lok t3 a3 i2 (clone s2) l2 (clone r2) n2 d2 (HStrNth (clone sval) (clone idxval) (t-adt opt)))
                              (let [dflt (asts-idx items 3)
                                    rd (lower-1 dflt (clone env) t3 a3 i2 (clone s2) l2 (clone r2) n2 d2 raws)]
                                (match rd
                                  (LErr [msg] (LErr msg))
                                  (LOk [t4 a4 i4 s4 l4 r4 n4 d4 dval]
                                    (lok t4 a4 i4 s4 l4 r4 n4 d4
                                         (HMatch (HStrNth (clone sval) (clone idxval) (t-adt opt))
                                                 (HACons 0 (SCons (s-binder) (SNil)) (HVar (s-binder))
                                                         (HACons -1 (SNil) dval (HANil)))
                                                 (t-i64)))))))))))))))))))))

; shared child-lowering shapes
(defn lower-3-to [items :- Asts mode :- i64 env :- TyEnv tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (let [a (asts-idx (clone items) 1)
        ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
    (match ra
      (LErr [msg] (LErr msg))
      (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
        (let [b (asts-idx (clone items) 2)
              rb (lower-1 b (clone env) t1 a1 i1 s1 l1 r1 n1 d1 raws)]
          (match rb
            (LErr [msg] (LErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
              (let [c (asts-idx items 3)
                    rc (lower-1 c env t2 a2 i2 s2 l2 r2 n2 d2 raws)]
                (match rc
                  (LErr [msg] (LErr msg))
                  (LOk [t3 a3 i3 s3 l3 r3 n3 d3 e3]
                    (lok t3 a3 i3 s3 l3 r3 n3 d3 (HSubs e1 e2 e3))))))))))))

(defn lower-2-to [items :- Asts mode :- i64 env :- TyEnv tab :- i64
                 adts :- AdtTab insts :- IMap sigs :- Sigs lams :- Lams
                 rets :- TyEnv ncached :- i64 defs :- Defns name :- str kind :- i64 raws :- &Raws] :- LRes
  (let [a (asts-idx (clone items) 1)
        ra (lower-1 a (clone env) tab adts insts sigs lams rets ncached defs raws)]
    (match ra
      (LErr [msg] (LErr msg))
      (LOk [t1 a1 i1 s1 l1 r1 n1 d1 e1]
        (let [b (asts-idx items 2)
              rb (lower-1 b env t1 a1 i1 s1 l1 r1 n1 d1 raws)]
          (match rb
            (LErr [msg] (LErr msg))
            (LOk [t2 a2 i2 s2 l2 r2 n2 d2 e2]
              (if (= kind 16)
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HSplit e1 e2))
                (lok t2 a2 i2 s2 l2 r2 n2 d2 (HJoin e1 e2))))))))))

(defn lower-join-2 [items :- Asts env :- TyEnv tab :- i64 adts :- AdtTab
                   insts :- IMap sigs :- Sigs lams :- Lams rets :- TyEnv
                   ncached :- i64 defs :- Defns raws :- &Raws] :- LRes
  (lower-2-to items 0 env tab adts insts sigs lams rets ncached defs "join" 17 raws))
; Call ret: the rets table (static non-generic + mono), else the seed's
; i64 fallback for the builtin print heads.
; Call ret: the rets table (static non-generic + mono), else the seed's
; i64 fallback for the builtin print heads.
(defn h-call-ty [rets :- &TyEnv name :- i64] :- Ty
  (let [r (te-get rets name)]
    (if (ty-noneq r) (t-i64) r)))


; --- program assembly (build.rs) -------------------------------------------------
; Pass 0a collects deftype headers (field types may reference any template,
; regardless of order), pass 0b parses variants, pass 1 parses
; defn/extern headers in form order — registering Fn signatures and
; instantiating applied ADTs eagerly, which is the creation order the
; dump pins. Then every plain defn lowers in source order, with mono
; instances gathered separately and appended after the externs, exactly
; like the seed's `out` list.

(deftype POut (POk [tab :- i64 adts :- AdtTab defs :- Defns
                   lams :- Lams sigs :- Sigs])
             (PErr [msg :- str]))

(deftype DeclRes (DeclRes [decls :- Decls ndecls :- i64 msg :- str]))

(defn dl-depth [e :- Decls] :- i64
  (match e
    (DLCons [k v next] (+ 1 (dl-depth next)))
    (DLNil [] 0)))

(defn form-head-sid [f :- &Ast] :- i64
  ; borrowed read: match the node, hand the kids chain to the borrowed
  ; head-sid query — no move, no clone
  (match f
    (AList [kids at] (asts-head-sid kids))
    (_ -1)))

; pass 0a: deftype headers, in form order
(defn collect-decls [forms :- Asts i :- i64 n :- i64 decls :- Decls ps :- PS] :- DeclRes
  ; ndecls starts at 1: adt 0 is the prelude's (Option a). The chain is
  ; consumed by match — an asts-idx per form deep-cloned the whole
  ; program per form and made the self-compile quadratic (S8).
  (match forms
    (KNil [] (DeclRes decls 1 ""))
    (KCons [f rest]
      (if (not (= (form-head-sid f) (s-deftype)))
        (collect-decls rest (+ i 1) n decls ps)
        (let [r (parse-deftype-header f (clone ps))]
          (match r
            (HDRRes [ps2 name typarams]
              (if (< name 0)
                (DeclRes (DLNil) 0 (ps-err-msg ps2))
                (if (dl-has decls name)
                  (DeclRes (DLNil) 0 (str "duplicate deftype " (sym-str (ps-tab ps) name)))
                  (match (collect-decls rest (+ i 1) n decls ps2)
                    (DeclRes [d nd msg]
                      (if (> (count msg) 0)
                        (DeclRes (DLNil) 0 msg)
                        (DeclRes (dl-put d name (Decl nd typarams)) (+ 1 nd) "")))))))))))))

(deftype VarRes (VarRes [adts :- AdtTab msg :- str]))

; pass 0b: variants, in declaration order; each deftype's own type
; parameters are in scope while its fields parse
(defn build-variants [forms :- Asts i :- i64 n :- i64 decls :- Decls adts :- AdtTab
                     tab :- i64 sigs :- Sigs] :- VarRes
  ; match-walk, as collect-decls (S8)
  (match forms
    (KNil [] (VarRes adts ""))
    (KCons [f rest]
      (if (not (= (form-head-sid f) (s-deftype)))
        (build-variants rest (+ i 1) n decls adts tab sigs)
        (let [f2 (clone f)
              rh (parse-deftype-header f (PS (clone tab) (clone decls) (clone adts) (clone sigs) (SNil) ""))]
          (match rh
            (HDRRes [ps1 name typarams]
              (if (< name 0)
                (VarRes (ATNil) (ps-err-msg ps1))
                (let [rv (parse-deftype-variants f2 (PS (clone tab) (clone decls) (clone adts) (clone sigs) (clone typarams) ""))]
                  (match rv
                    (PVRes2 [ps2 vs]
                      (if (ps-failed ps2)
                        (VarRes (ATNil) (ps-err-msg ps2))
                        (match (build-variants rest (+ i 1) n decls adts tab sigs)
                          (VarRes [restv msg]
                            (if (> (count msg) 0)
                              (VarRes (ATNil) msg)
                              (VarRes (adts-append-info restv (AdtInfo name typarams vs -1 (TyNil))) ""))))))))))))))))

(deftype RawsRes (RawsRes [ps :- PS raws :- Raws msg :- str]))

; pass 1: defn/extern headers, in form order
(defn build-raws [forms :- Asts i :- i64 n :- i64 ps :- PS acc :- Raws] :- RawsRes
  ; match-walk (S8): the chain is consumed, the per-form asts-idx with its
  ; whole-program clone is gone. The parse result raw is moved into the
  ; accumulator after the recursion — one move, no clone.
  (match forms
    (KNil [] (RawsRes ps acc ""))
    (KCons [f rest]
      (let [h (form-head-sid f)]
        (cond
          (= h (s-deftype))
          (build-raws rest (+ i 1) n ps acc)

          (= h (s-extern))
          (let [r (parse-defn f ps 1)]
            (match r
              (RawRes [ps2 raw]
                (if (ps-failed ps2)
                  (let [m (ps-err-msg ps2)] (RawsRes ps2 (RNil) m))
                  (match (build-raws rest (+ i 1) n ps2 acc)
                    (RawsRes [ps3 rs msg]
                      (if (> (count msg) 0)
                        (RawsRes ps3 (RNil) msg)
                        (RawsRes ps3 (RCons raw rs) ""))))))))

          (= h (s-defn))
          (let [r (parse-defn f ps 0)]
            (match r
              (RawRes [ps2 raw]
                (if (ps-failed ps2)
                  (let [m (ps-err-msg ps2)] (RawsRes ps2 (RNil) m))
                  (match (build-raws rest (+ i 1) n ps2 acc)
                    (RawsRes [ps3 rs msg]
                      (if (> (count msg) 0)
                        (RawsRes ps3 (RNil) msg)
                        (RawsRes ps3 (RCons raw rs) ""))))))))

          (let [m (str "cato1: unsupported form " (sym-str (ps-tab ps) h))]
            (RawsRes ps (RNil) m)))))))

; static (non-generic) callee rets, for ty_of's Call arm
(defn seed-rets [rs :- &Raws rets :- TyEnv] :- TyEnv
  (match rs
    (RCons [h t]
      (match h
        (RawDefn [name params ret typarams isextern body rb]
          (if (= (sids-depth typarams) 0)
            (seed-rets t (te-put rets name (clone ret)))
            (seed-rets t rets)))))
    (RNil [] rets)))

; the plain-defn lowering loop (source order); instances accumulate in
; their own chain and move behind the externs at assembly time
(deftype LLoopRes (LLoopRes [ps :- PS defs :- Defns instdefs :- Defns
                            tab :- i64 adts :- AdtTab insts :- IMap
                            sigs :- Sigs lams :- Lams rets :- TyEnv ncached :- i64])
             (LLoopErr [msg :- str]))

(defn build-lower [rs :- &Raws i :- i64 n :- i64 ps :- PS env-of :- i64] :- LLoopRes
  (build-lower-2 rs i n ps (DNil) (DNil)
                 (ps-tab ps) (ps-adts (clone ps)) (MNil)
                 (ps-sigs (clone ps)) (LMNil)
                 ; static non-generic callee rets, for ty_of's Call arm
                 (seed-rets rs (TENil)) 0))

; the accumulated tab/adts/insts/sigs/lams/rets/ncached persist across
; defns: interning during lowering (mangled names, $d/lambda gensyms),
; ADT instances, closure signatures and mono cache state must reach the
; next defn and the final dump — the seed's Ctx cells are program-global
(defn build-lower-2 [rs :- &Raws i :- i64 n :- i64 ps :- PS defs :- Defns instdefs :- Defns
                    tab :- i64 adts :- AdtTab insts :- IMap sigs :- Sigs
                    lams :- Lams rets :- TyEnv ncached :- i64] :- LLoopRes
  (if (>= i n)
    (match ps
      (PS [tab0 decls adts0 sigs0 typarams err]
        (if (> (count err) 0)
          (LLoopErr err)
          (LLoopRes ps defs instdefs tab adts insts sigs lams rets ncached))))
    (let [r (raws-at rs i)]
      (match r
        (RawDefn [name params ret typarams isextern body rb]
          (cond
            ; externs: no lowering; the seed appends the declaration with
            ; a (const 0) placeholder body, all params Shared
            (= isextern 1)
            ; Each branch is an alternative path and ends in the recursive
            ; call, so the state moves: cloning it here copied the whole
            ; parser state, definition chain and instance list per defn.
            (build-lower-2 rs (+ i 1) n ps
                           (defns-append defs (Defn name (clone params) (clone ret) 1 (HConstI64 0) 0))
                           instdefs
                           tab adts insts sigs lams rets ncached)

            (> (sids-depth typarams) 0)
            (build-lower-2 rs (+ i 1) n ps defs instdefs
                           tab adts insts sigs lams rets ncached)

            (let [env (binds-of-params (clone params))
                  ; the defs chain threads through lowering: instances
                  ; minted during this body append to it (the seed's
                  ; InstState::extra drain)
                  lr (lower-body-raw body env (clone ret) tab adts
                                     insts sigs lams rets ncached defs rs)]
              (match lr
                (LErr [msg] (LLoopErr msg))
                (LOk [t2 a2 i2 s2 l2 r2 n2 d2 body2]
                  ; the recursive call already gets the tables lowering
                  ; returned; the inputs are dead here
                  (build-lower-2 rs (+ i 1) n ps
                                 (defns-append d2 (Defn name params ret 0 body2 rb))
                                 instdefs
                                 t2 a2 i2 s2 l2 r2 n2))))))))))

(defn build-program [forms :- Asts tab :- i64] :- POut
  (let [n (asts-depth forms)
        ; the prelude: the (Option a) template seeded as adt 0, with its
        ; declaration registered so annotations resolve
        ps0 (ps-new (clone tab))
        decls0 (dl-put (DLNil) (s-option) (Decl 0 (SCons (s-aparam) (SNil))))
        ; user deftype indices start at 1: adt 0 is the prelude's Option
        dres (collect-decls (clone forms) 0 n decls0 (clone ps0))]
    (match dres
      (DeclRes [decls ndecls msg]
        (if (> (count msg) 0)
          (PErr msg)
          (match (build-variants (clone forms) 0 n (clone decls)
                                 (ps-adts (clone ps0)) (ps-tab ps0) (SGNil))
            (VarRes [adts vmsg]
              (if (> (count vmsg) 0)
                (PErr vmsg)
                (match (build-raws forms 0 n
                                   (PS (clone tab) decls adts (SGNil) (SNil) "") (RNil))
                  (RawsRes [ps1 raws rmsg]
                    (if (> (count rmsg) 0)
                      (PErr rmsg)
                      (match ps1
                        (PS [tab1 decls1 adts1 sigs1 typarams1 err1]
                          (if (> (count err1) 0)
                            (PErr err1)
                            (let [rn (raws-depth raws)
                                  rets (seed-rets raws (TENil))]
                              (match (build-lower raws 0 rn ps1 0)
                                (LLoopErr [msg2] (PErr msg2))
                                (LLoopRes [ps2 defs instdefs t2 a2 i2 s2 l2 r2 n2]
                                  ; the seed's out order: plain defns in
                                  ; source order, then externs, then mono
                                  ; instances
                                  (let [parts (partition-defns defs raws (DNil) (DNil) (DNil))]
                                    (match parts
                                      (PRes3 [plains exts insts2]
                                        (POk t2 a2 (defns-concat (defns-concat plains exts) insts2) l2 s2)))))))))))))))))))))

; the seed's out assembly: plain defns in source order, then externs,
; then mono instances. The lowering accumulates one chain (plain defns
; appended per defn, instances appended where minted); partitioning it
; preserves each group's relative order.
(deftype PRes3 (PRes3 [plains :- Defns exts :- Defns insts :- Defns]))

(defn partition-defns [ds :- Defns rs :- &Raws plains :- Defns exts :- Defns
                      insts :- Defns] :- PRes3
  (match ds
    (DNil [] (PRes3 plains exts insts))
    (DCons [h t]
      (if (= (h-defn-ext (clone h)) 1)
        (partition-defns t rs plains (defns-append exts h) insts)
        (if (raws-has rs (h-defn-name (clone h)))
          (partition-defns t rs (defns-append plains h) exts insts)
          (partition-defns t rs plains exts (defns-append insts h)))))))

(defn h-defn-ext [d :- Defn] :- i64
  (match d (Defn [name params ret ie body rb] ie)))

(defn h-defn-name [d :- Defn] :- i64
  (match d (Defn [name params ret ie body rb] name)))

(defn raws-has [rs :- &Raws name :- i64] :- bool
  (let [hit (raws-find rs name)]
    (match hit
      (RawDefn [hname hp hret htp hie hbody rb] (not (= hname -1))))))

(defn defns-concat [xs :- Defns ys :- Defns] :- Defns
  (match xs
    (DNil [] ys)
    (DCons [h t] (DCons h (defns-concat t ys)))))
; moveck.cato — S6: the move checker + drop planner.
;
; A port of the seed's `BCheck`/`plan_drops` over the kernel subset: per-
; name ownership states (0 Owned / 1 Moved), `rem` occurrence counts (a
; conj source at count 0 is a last use, so in-place update is
; unobservable), the tail-escape set, the shadowed-bindings pre-pass, the
; consumed set; the same merge rules for `if` branches and `match` arms
; (union of moved, union of not-owning); conj's in_place bit; closure
; captures consuming non-Copy vars with per-capture own bits; `let`'s
; transfer-on-Var-init ownership rule; scope-exit `frees` = heap-owning ∧
; still-owned ∧ not escaped ∧ not consumed ∧ not shadowed.
;
; The kernel has no borrows: every plain defn's parameters are Owned,
; externs are Shared (the seed's own convention). The checker REBUILDS
; nodes to fill the post-`plan_drops` annotations: HLet frees, HConj
; in_place, HClosure capture own-bits. `rem` and `cons` thread
; sequentially through branch walks (field mutations in the seed);
; `st`/`owns` restart from the pre-branch state per branch and merge.

; --- read-only context ---------------------------------------------------------

; callee name -> its parameter list, so a call can move only the args bound
; to owned (non-`&`) parameters (the seed's per-param borrow kinds). Extern
; parameters are recorded all-borrowed (externs never consume).
(deftype DParams (DPNil) (DPCons [name :- i64 ps :- PList next :- DParams]))

; callee name -> return-borrowed flag (1 when the defn's return is `&T`).
; A call to such a callee yields a borrow: the binding does not own it.
(deftype RBTable (RBNil) (RBCons [name :- i64 rb :- i64 next :- RBTable]))

(deftype BCtx (BCtx [escaped :- Sids shadowed :- Sids facts :- Facts
                    tab :- i64 shared :- Sids loopcopy :- Sids adts :- AdtTab
                    dparams :- DParams retb :- RBTable]))

(deftype BRes (BOk [st :- IMap owns :- IMap rem :- IMap cons :- IMap e :- HExpr])
             (BErr [msg :- str]))

(deftype BKRes (BKOk [st :- IMap owns :- IMap rem :- IMap cons :- IMap es :- HExprs])
              (BKErr [msg :- str]))

(deftype B4 (B4 [st :- IMap owns :- IMap rem :- IMap cons :- IMap])
           (B4Err [msg :- str]))

(deftype UseRes (UseRes [rem :- IMap msg :- str]))

; use_var: one occurrence consumed; a non-Copy read of a Moved value errors
(defn use-var [v :- i64 rem :- IMap tys :- &TyEnv st :- &IMap bcx :- &BCtx] :- UseRes
  (let [dec (- (im-get rem v 0) 1)
        rem2 (im-put rem v dec)
        t (te-get tys v)]
    (if (and (not (ty-noneq t))
             (is-non-copy-ty t)
             (= (im-get st v 0) 1))
      (match bcx
        (BCtx [escaped shadowed facts tab shared _lc _adts _dp _retb]
          (UseRes rem2 (str "use of moved value " (sym-str (clone tab) v)))))
      (UseRes rem2 ""))))

(deftype MoveRes (MoveRes [st :- IMap owns :- IMap cons :- IMap]))

; move_var: state goes Moved; the drop duty leaves the binding
(defn move-var [v :- i64 st :- IMap owns :- IMap cons :- IMap] :- MoveRes
  (MoveRes (im-put st v 1) (im-put owns v 0) (im-put cons v 1)))

; move_if_non_copy: the move sites (call args, conj sources, closure
; captures, drop, let-of-var)
(deftype MncRes (MncRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap])
               (MncErr [msg :- str]))

(defn move-if-nc [v :- i64 st :- IMap owns :- IMap rem :- IMap cons :- IMap
                 tys :- &TyEnv bcx :- &BCtx] :- MncRes
  (let [t (te-get tys v)]
    (if (and (not (ty-noneq t)) (is-non-copy-ty t))
      (match (use-var v rem tys st bcx)
        (UseRes [rem2 msg]
          (if (> (count msg) 0)
            (MncErr msg)
            (match bcx
              ; a non-Copy loop variable rides as Copy: calls and
              ; constructors borrow it, nothing moves (S8)
              (BCtx [escaped shadowed facts tab shared loopcopy _adts _dp _retb]
                (if (sids-has loopcopy v)
                  (MncRes st owns rem2 cons)
                  (match (move-var v st owns cons)
                    (MoveRes [st2 owns2 cons2] (MncRes st2 owns2 rem2 cons2)))))))))
      (MncRes st owns rem cons))))

(defn im-remove [m :- IMap k :- i64] :- IMap
  (match m
    (MNil [] (MNil))
    (MCons [ek ev next]
      (if (= ek k) (im-remove next k) (MCons ek ev (im-remove next k))))))

; --- merge rules (the if/match branch merges) --------------------------------------

; a value moved in any branch counts as moved afterwards
(defn b-merge-st [m1 :- IMap m2 :- IMap st :- IMap] :- IMap
  (match m1
    (MCons [k v next]
      (b-merge-st next m2 (if (= v 1) (im-put st k 1) st)))
    (MNil [] (b-merge-st-2 m2 st))))

(defn b-merge-st-2 [m2 :- IMap st :- IMap] :- IMap
  (match m2
    (MCons [k v next]
      (b-merge-st-2 next (if (= v 1) (im-put st k 1) st)))
    (MNil [] st)))

; a name that failed to own in any branch never owns afterwards
(defn b-merge-owns [m1 :- IMap m2 :- IMap owns :- IMap] :- IMap
  (match m1
    (MCons [k v next]
      (b-merge-owns next m2 (if (= v 0) (im-put owns k 0) owns)))
    (MNil [] (b-merge-owns-2 m2 owns))))

(defn b-merge-owns-2 [m2 :- IMap owns :- IMap] :- IMap
  (match m2
    (MCons [k v next]
      (b-merge-owns-2 next (if (= v 0) (im-put owns k 0) owns)))
    (MNil [] owns)))

; --- the seed's predicate helpers ---------------------------------------------------

(defn b-heap-owning [ty :- &Ty facts :- &Facts] :- bool
  (let [t (ty-tag ty)]
    (cond
      (= t 15) true
      (= t 12) true
      (= t 17) true
      (= t 13) true
      (= t 14) true
      (= t 16) (= (facts-owns-at facts (ty-arg ty)) 1)
      false)))

(defn b-param-moves [ty :- &Ty facts :- &Facts] :- bool
  ; boxed ADTs move by pointer; closures move their env
  (let [t (ty-tag ty)]
    (cond
      (= t 17) true
      (= t 16) (= (facts-boxed-at facts (ty-arg ty)) 1)
      false)))

; allocates: a fresh heap buffer the binding uniquely owns; aliases (Var),
; element loads and control-flow results are excluded (the seed's rule —
; control-flow merges leak as today until per-arm scratch drops exist)
(defn b-allocates [v :- &HExpr facts :- &Facts] :- bool
  (let [tag (h-tag v)]
    (cond
      ; subs/split/join/strcat/charstr/tostr: fresh strings
      (or (= tag 15) (= tag 16) (= tag 17) (= tag 14) (= tag 19) (= tag 13)) true
      ; conj/args: fresh collections
      (or (= tag 21) (= tag 42)) true
      ; a closure mints its owning env allocation
      (= tag 37) true
      ; a fresh collection from a call; an explicit deep copy
      (= tag 39) true
      (= tag 35) true
      (= tag 40) true
      ; a fresh box for an owning ADT; a fresh Option from parse-*
      (= tag 33) (= (facts-owns-at facts (hctor-adt v)) 1)
      (= tag 44) (let [res (hparse-res v)]
                   (and (= (ty-tag res) 16) (= (facts-owns-at facts (ty-arg res)) 1)))
      false)))

; --- pre-passes: occurrence counts, shadowing, tail escapes -------------------------

(defn cv-bump [name :- i64 counts :- IMap] :- IMap
  (let [c (+ 1 (im-get counts name 0))]
    (im-put counts name c)))

; count_vars: every name occurrence, all positions (closure capture names
; too — a missed occurrence would make in-place update unsound)
(defn b-count-vars [e :- &HExpr counts :- IMap] :- IMap
  (match e
    (HVar [name] (cv-bump name counts))

    (HBinW [_ a _ _] (b-count-vars a counts))
    (HBinF [_ a _] (b-count-vars a counts))
    (HCmpW [_ a _ _] (b-count-vars a counts))
    (HStrCmp [_ a _] (b-count-vars a counts))
    (HStrOrd [_ a _] (b-count-vars a counts))

    (HAnd [a b] (b-count-vars b (b-count-vars a counts)))
    (HOr [a b] (b-count-vars b (b-count-vars a counts)))
    (HMin [a b _] (b-count-vars b (b-count-vars a counts)))
    (HMax [a b _] (b-count-vars b (b-count-vars a counts)))
    (HConj [v x _ _] (b-count-vars x (b-count-vars v counts)))
    (HSubs [s a _] (b-count-vars a (b-count-vars s counts)))
    (HSplit [s sep] (b-count-vars sep (b-count-vars s counts)))
    (HJoin [sep xs] (b-count-vars xs (b-count-vars sep counts)))
    (HStrNth [s idx _] (b-count-vars idx (b-count-vars s counts)))
    (HSpit [path data] (b-count-vars data (b-count-vars path counts)))

    (HIf [c t e _] (b-count-vars e (b-count-vars t (b-count-vars c counts))))

    (HICast [e _ _] (b-count-vars e counts))
    (HAbs [e _] (b-count-vars e counts))
    (HNot [e] (b-count-vars e counts))
    (HClone [e] (b-count-vars e counts))
    (HDrop [e] (b-count-vars e counts))
    (HCount [e] (b-count-vars e counts))
    (HCharStr [e] (b-count-vars e counts))
    (HToStr [e _] (b-count-vars e counts))
    (HParseNum [s _ _] (b-count-vars s counts))
    (HSlurp [p] (b-count-vars p counts))
    (HExit [e] (b-count-vars e counts))

    (HStrCat [args] (b-count-vars-kids args counts))
    (HCall [_ args] (b-count-vars-kids args counts))
    (HCtor [_ _ args] (b-count-vars-kids args counts))
    (HSeq [es] (b-count-vars-kids es counts))
    (HRecur [args] (b-count-vars-kids args counts))

    (HGet [src idx dflt _ _]
      (b-count-vars-default dflt (b-count-vars idx (b-count-vars src counts))))

    (HClosure [_ _ _ caps body] (b-count-vars body (b-count-caps caps counts)))

    (HClosureCall [f args _] (b-count-vars-kids args (b-count-vars f counts)))

    (HMatch [scrut arms _] (b-count-vars-arms arms (b-count-vars scrut counts)))

    (HLoop [binds _ body] (b-count-vars body (b-count-vars-binds binds counts)))

    (HLet [binds body _] (b-count-vars body (b-count-vars-binds binds counts)))

    (_ counts)))

(defn b-count-vars-kids [es :- &HExprs counts :- IMap] :- IMap
  (match es
    (HENil [] counts)
    (HECons [kid next] (b-count-vars-kids next (b-count-vars kid counts)))))

(defn b-count-vars-binds [binds :- &Binds counts :- IMap] :- IMap
  (match binds
    (BNil [] counts)
    (BCons [name v ty next] (b-count-vars-binds next (b-count-vars v counts)))))

(defn b-count-vars-arms [arms :- &HArms counts :- IMap] :- IMap
  (match arms
    (HANil [] counts)
    (HACons [variant binders body next] (b-count-vars-arms next (b-count-vars body counts)))))

(defn b-count-caps [caps :- &Caps counts :- IMap] :- IMap
  (match caps
    (CNil [] counts)
    (CCons [name ty own next] (b-count-caps next (cv-bump name counts)))))

(defn b-count-vars-default [dflt :- &HExprs counts :- IMap] :- IMap
  (b-count-vars-kids dflt counts))

; count_binds: names bound by more than one `let` share a codegen slot, so
; their frees stay suppressed (the seed's known limitation). The walk
; visits the same node kinds as the seed's count_binds.
(defn b-count-binds [e :- &HExpr counts :- IMap] :- IMap
  (match e
    (HLet [binds body _] (b-count-binds body (b-count-binds-binds binds counts)))
    (HSeq [es] (b-count-binds-kids es counts))
    (HStrCat [args] (b-count-binds-kids args counts))
    (HRecur [args] (b-count-binds-kids args counts))
    (HLoop [binds _ body] (b-count-binds body (b-count-binds-binds binds counts)))
    (HIf [c t e _] (b-count-binds e (b-count-binds t (b-count-binds c counts))))
    (HToStr [e _] (b-count-binds e counts))
    (HParseNum [s _ _] (b-count-binds s counts))
    (HSlurp [p] (b-count-binds p counts))
    (HExit [e] (b-count-binds e counts))
    (HSpit [path data] (b-count-binds data (b-count-binds path counts)))
    (HAnd [a b] (b-count-binds b (b-count-binds a counts)))
    (HOr [a b] (b-count-binds b (b-count-binds a counts)))
    (_ counts)))

(defn b-count-binds-binds [binds :- &Binds counts :- IMap] :- IMap
  (match binds
    (BNil [] counts)
    (BCons [name v ty next] (b-count-binds-binds next (b-count-binds v (cv-bump name counts))))))

(defn b-count-binds-kids [es :- &HExprs counts :- IMap] :- IMap
  (match es
    (HENil [] counts)
    (HECons [kid next] (b-count-binds-kids next (b-count-binds kid counts)))))

(defn b-shadowed-of [counts :- &IMap acc :- Sids] :- Sids
  (match counts
    (MNil [] acc)
    (MCons [k v next] (b-shadowed-of next (if (> v 1) (SCons k acc) acc)))))

; tail_escape: vars referenced in tail (returned) position; branch results
; are tail positions too — a binding returned from an if/match arm
; transfers its drop duty to the result
(defn b-tail-escape [e :- &HExpr acc :- Sids] :- Sids
  (match e
    (HLet [_ body _] (b-tail-escape body acc))
    (HSeq [es] (b-tail-escape-last es acc))
    (HIf [_ t e _] (b-tail-escape e (b-tail-escape t acc)))
    (HMatch [_ arms _] (b-tail-escape-arms arms acc))
    (HVar [name] (SCons name acc))
    (_ acc)))

(defn b-tail-escape-last [es :- &HExprs acc :- Sids] :- Sids
  (match es
    (HENil [] acc)
    (HECons [kid next]
      (if (hes-null next)
        (b-tail-escape kid acc)
        (b-tail-escape-last next acc)))))

(defn b-tail-escape-arms [arms :- &HArms acc :- Sids] :- Sids
  (match arms
    (HANil [] acc)
    (HACons [variant binders body next] (b-tail-escape-arms next (b-tail-escape body acc)))))

; --- the checker -------------------------------------------------------------------

; sequential children
(defn b-kids [es :- HExprs st :- IMap owns :- IMap rem :- IMap cons :- IMap
             tys :- &TyEnv bcx :- &BCtx acc :- HExprs] :- BKRes
  (match es
    (HENil [] (BKOk st owns rem cons (hes-rev acc (HENil))))
    (HECons [kid next]
      (match (bcheck kid st owns rem cons (clone tys) bcx)
        (BErr [msg] (BKErr msg))
        (BOk [st2 owns2 rem2 cons2 c2]
          (b-kids next st2 owns2 rem2 cons2 tys bcx (HECons c2 acc)))))))

; a Get's optional default (absent = the empty chain)
(defn b-default [dflt :- HExprs st :- IMap owns :- IMap rem :- IMap cons :- IMap
                tys :- &TyEnv bcx :- &BCtx] :- BKRes
  (match dflt
    (HENil [] (BKOk st owns rem cons (HENil)))
    (HECons [kid next]
      (match (b-kids dflt st owns rem cons tys bcx (HENil))
        (BKErr [msg] (BKErr msg))
        (BKOk [st2 owns2 rem2 cons2 c2]
          (BKOk st2 owns2 rem2 cons2 c2))))))

; HCall's Owned-kind Var arguments: use + move after the plain child walk.
; Builtins never consume; for every other callee we consult the callee's
; parameter borrows (the seed's per-param kinds): an arg bound to an owned
; param moves, one bound to a borrowed (&) param stays with the caller.
(deftype DLook (DFound [ps :- PList]) (DMissing))

(defn dparams-get [dp :- &DParams name :- i64] :- DLook
  (match dp
    (DPNil [] (DMissing))
    (DPCons [n ps next]
      (if (= n name)
        (DFound (clone ps))
        (dparams-get next name)))))

; return-borrowed lookup: 1 when the callee's return is a `&T` borrow
(defn rb-get [rb :- &RBTable name :- i64] :- i64
  (match rb
    (RBNil [] 0)
    (RBCons [n v next]
      (if (= n name) v (rb-get next name)))))

(defn b-mark-borrowed [ps :- PList] :- PList
  (match ps
    (PNil [] (PNil))
    (PCons [h t]
      (match h
        (Param [pname pty pb]
          (PCons (Param pname pty 1) (b-mark-borrowed t)))))))

(defn b-dparams [defs :- &Defns acc :- DParams] :- DParams
  (match defs
    (DNil [] acc)
    (DCons [h t]
      (match (clone h)
        (Defn [name params ret isextern body rb]
          (b-dparams t
            (DPCons name
              (if (= isextern 1) (b-mark-borrowed params) params)
              acc)))))))

; callee name -> return-borrowed flag, collected once per program
(defn b-retb [defs :- &Defns acc :- RBTable] :- RBTable
  (match defs
    (DNil [] acc)
    (DCons [h t]
      (match (clone h)
        (Defn [name params ret isextern body rb]
          (b-retb t (RBCons name rb acc)))))))

(defn b-call-move [name :- i64 args :- HExprs st :- IMap owns :- IMap rem :- IMap
                  cons :- IMap tys :- &TyEnv bcx :- &BCtx] :- B4
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts dp _retb]
      (if (sids-has shared name)
        (B4 st owns rem cons)
        (match (dparams-get dp name)
          (DFound [ps] (b-call-move-ps args ps st owns rem cons tys bcx))
          (DMissing [] (b-call-move-walk args st owns rem cons tys bcx)))))))

(defn b-call-move-ps [args :- HExprs ps :- PList st :- IMap owns :- IMap rem :- IMap
                     cons :- IMap tys :- &TyEnv bcx :- &BCtx] :- B4
  (match args
    (HENil [] (B4 st owns rem cons))
    (HECons [kid next]
      (match ps
        (PNil [] (b-call-move-walk args st owns rem cons tys bcx))
        (PCons [h pt]
          (match h
            (Param [pname pty pb]
              (if (and (= pb 0) (= (h-tag kid) 3))
                (match (move-if-nc (name-of kid) st owns rem cons tys bcx)
                  (MncErr [msg] (B4Err msg))
                  (MncRes [st2 owns2 rem2 cons2]
                    (b-call-move-ps next pt st2 owns2 rem2 cons2 tys bcx)))
                (b-call-move-ps next pt st owns rem cons tys bcx)))))))))

(defn b-call-move-walk [args :- HExprs st :- IMap owns :- IMap rem :- IMap
                       cons :- IMap tys :- &TyEnv bcx :- &BCtx] :- B4
  (match args
    (HENil [] (B4 st owns rem cons))
    (HECons [kid next]
      (if (= (h-tag kid) 3)
        ; the seed's kinds loop: use + move only NON-COPY Var args
        (match (move-if-nc (name-of kid) st owns rem cons tys bcx)
          (MncErr [msg] (B4Err msg))
          (MncRes [st2 owns2 rem2 cons2]
            (b-call-move-walk next st2 owns2 rem2 cons2 tys bcx)))
        (b-call-move-walk next st owns rem cons tys bcx)))))

; let bindings: sequential; the transfer-on-Var-init ownership rule
(deftype BLRes (BLRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap
                      tys :- TyEnv binds :- Binds])
              (BLErr [msg :- str]))

(defn b-let-binds [binds :- Binds st :- IMap owns :- IMap rem :- IMap cons :- IMap
                  tys :- TyEnv bcx :- &BCtx acc :- Binds] :- BLRes
  (match binds
    (BNil [] (BLRes st owns rem cons tys acc))
    (BCons [name value ty next]
      (match (bcheck value st owns rem cons (clone tys) bcx)
        (BErr [msg] (BLErr msg))
        (BOk [st1 owns1 rem1 cons1 v2]
          (let [isv (= (h-tag v2) 3)
                vn (name-of (clone v2))
                ncopy (is-non-copy-ty ty)]
            (if (and isv ncopy)
              ; a non-Copy Var init moves the buffer: the drop duty
              ; transfers to the new binding (read the source's ownership
              ; before the move clears it)
              (let [src-owns (im-get owns1 vn 0)]
                (match (move-var vn st1 owns1 cons1)
                  (MoveRes [st2 owns2 cons2]
                    (b-let-binds next (im-put st2 name 0)
                                 (im-put owns2 name src-owns) rem1
                                 (im-remove cons2 name) (te-put tys name ty)
                                 bcx (BCons name v2 ty acc)))))
              ; a fresh binding starts unconsumed; a Copy Var alias never
              ; owns; a borrowed (`&T`) call result is a borrow the caller
              ; still owns, so it never owns; anything else owns iff it
              ; allocates
              (let [owns2 (if isv
                            (im-put owns1 name 0)
                            (im-put owns1 name (if (b-borrowed-call v2 (b-retb-of bcx))
                                                 0
                                                 (if (b-allocates-of v2 bcx) 1 0))))]
                (b-let-binds next (im-put st1 name 0) owns2 rem1
                             (im-remove cons1 name) (te-put tys name ty)
                             bcx (BCons name v2 ty acc))))))))))

(defn b-facts-of [bcx :- &BCtx] :- Facts
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp _retb] (clone facts))))

(defn b-retb-of [bcx :- &BCtx] :- RBTable
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp retb] (clone retb))))

; The accessors above hand back an owned field, so every read copied the
; ownership list (one cons per ADT in the program). The consumers of these
; only borrow, so the read happens inside the match instead.
(defn b-facts-owns-at [bcx :- &BCtx i :- i64] :- i64
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp _retb]
      (facts-owns-at facts i))))

(defn b-facts-boxed-at [bcx :- &BCtx i :- i64] :- i64
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp _retb]
      (facts-boxed-at facts i))))

(defn b-allocates-of [v :- &HExpr bcx :- &BCtx] :- bool
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp _retb]
      (b-allocates v facts))))

(defn b-arm-state-of [binders :- Sids fields :- TyList pst :- IMap powns :- IMap
                      tys :- TyEnv bcx :- &BCtx] :- BLRes
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp _retb]
      (b-arm-state binders fields pst powns tys facts))))

(defn b-arm-esc-of [binders :- Sids fields :- TyList st :- IMap escaped :- Sids
                    bcx :- &BCtx acc :- i64] :- i64
  (match bcx
    (BCtx [escaped0 shadowed facts tab shared _lc _adts _dp _retb]
      (b-arm-esc binders fields st escaped facts acc))))

; Is this an expression whose value is a borrow (a call to a `&T` callee)?
(defn b-borrowed-call [v :- &HExpr retb :- &RBTable] :- bool
  (match v
    (HCall [name args] (= (rb-get retb name) 1))
    (_ false)))

; scope-exit frees: heap-owning ∧ still-owned ∧ not escaped ∧ not
; consumed ∧ not shadowed, in binding order — the whole destruction rule
(defn b-frees [binds :- Binds st :- IMap owns :- IMap cons :- IMap bcx :- &BCtx] :- Sids
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc _adts _dp _retb]
      (b-frees-walk binds st owns cons escaped shadowed facts))))

(defn b-frees-walk [binds :- &Binds st :- &IMap owns :- &IMap cons :- &IMap
                   escaped :- &Sids shadowed :- &Sids facts :- &Facts] :- Sids
  (match binds
    (BNil [] (SNil))
    (BCons [name v ty next]
      (let [rest (b-frees-walk next st owns cons escaped shadowed facts)]
        (if (and (b-heap-owning ty facts)
                 (= (im-get owns name 0) 1)
                 (= (im-get st name 0) 0)
                 (not (sids-has escaped name))
                 (not (im-has cons name))
                 (not (sids-has shadowed name)))
          (SCons name rest)
          rest)))))

; loop bindings: Copy-typed; the init checks against the outer state, the
; binding shadows for the body, and the previous state restores after
(deftype BLoopRes (BLoopRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap
                            tys :- TyEnv binds :- Binds saved :- IMap])
                (BLoopErr [msg :- str]))

; S8: a non-Copy loop variable rides as Copy — reads and calls never
; move it, and no scope frees it. Non-Copy bind names collect into a set
; the body walk consults through the context.
(defn bcx-with-loopcopy [bcx :- &BCtx names :- Sids] :- BCtx
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc adts dp retb]
      (BCtx (clone escaped) (clone shadowed) (clone facts) (clone tab) (clone shared) names (clone adts) (clone dp) (clone retb)))))

(defn binds-loopcopy [binds :- Binds acc :- Sids] :- Sids
  (match binds
    (BNil [] acc)
    (BCons [name init ty next]
      (binds-loopcopy next
        (if (is-non-copy-ty ty) (SCons name acc) acc)))))

(defn b-loop-binds [binds :- Binds st :- IMap owns :- IMap rem :- IMap cons :- IMap
                   tys :- TyEnv bcx :- &BCtx acc :- Binds saved :- IMap] :- BLoopRes
  (match binds
    (BNil [] (BLoopRes st owns rem cons tys acc saved))
    (BCons [name init ty next]
      (match (bcheck init st owns rem cons (clone tys) bcx)
        (BErr [msg] (BLoopErr msg))
        (BOk [st1 owns1 rem1 cons1 init2]
          (let [sval (im-get st1 name 0)]
            (b-loop-binds next (im-put st1 name 0) owns1 rem1 cons1
                          (te-put tys name ty)
                          bcx (BCons name init2 ty acc)
                          (im-put saved name sval))))))))

(defn b-restore-st [saved :- IMap st :- IMap] :- IMap
  (match saved
    (MNil [] st)
    (MCons [k prev next] (b-restore-st next (im-put st k prev)))))

; The ADT index of a named match scrutinee for the boxed-alias analysis
; (the seed's scrutinee_adt); -1 when there is no binding to retire.
(defn fp-scrut-adt [s :- &HExpr tys :- &TyEnv] :- i64
  (match s
    (HVar [v]
      (let [t (te-get tys v)]
        (if (= (ty-tag t) 16) (ty-arg t) -1)))
    (HCtor [adt variant args] adt)
    (_ -1)))

; Does a match binder over field type fty alias the scrutinee's one heap
; box? str/vec/map/set/fn fields and boxed-ADT children do; scalars and
; inline-ADT children copy by value.
(defn fp-binder-alias [fty :- &Ty facts :- &Facts] :- i64
  (let [t (ty-tag fty)]
    (cond
      (= t 12) 1
      (= t 13) 1
      (= t 14) 1
      (= t 15) 1
      (= t 17) 1
      (= t 16) (facts-boxed-at facts (ty-arg fty))
      0)))

; Real field type for a binder whose field aliases the scrutinee's heap
; (vec/map/set or a boxed ADT child) so a move through it registers; other
; fields keep the I64 copy stand-in.
(defn fp-binder-type [fty :- Ty facts :- &Facts] :- Ty
  (let [t (ty-tag fty)]
    (if (and (or (= t 13) (= t 14) (= t 15) (= t 16))
             (= (fp-binder-alias fty facts) 1))
      fty
      (t-i64))))

; The variant's field list, read through the borrowed context: returning the
; table itself copied every ADT in the program.
(defn b-varnt-fields-at [bcx :- &BCtx t :- i64 vi :- i64] :- TyList
  (match bcx
    (BCtx [escaped shadowed facts tab shared _lc adts _dp _retb]
      (varnt-fields-at adts t vi))))

; Did any aliasing binder escape the arm (tail position) or get moved? If
; so the box's drop duty transfers and the scrutinee's scope free is
; suppressed (the seed's any_alias_escape).
(defn b-arm-esc [binders :- Sids fields :- TyList st :- IMap escaped :- Sids
                 facts :- &Facts acc :- i64] :- i64
  (match binders
    (SNil [] acc)
    (SCons [b rest]
      (let [fty (match fields (TyCons [h t2] (clone h)) (TyNil [] (t-i64)))
            frest (match fields (TyCons [h t2] t2) (TyNil [] (TyNil)))
            ; an inline ADT binder is materialized as the field's address
            ; inside the box, so it aliases too (the seed's `|| Adt`)
            hit (if (and (or (= (fp-binder-alias fty facts) 1)
                             (= (ty-tag fty) 16))
                         (or (sids-has escaped b)
                             (= (im-get st b 0) 1)))
                  1 acc)]
        (b-arm-esc rest frest st escaped facts hit)))))

; match arms: every arm starts from the same post-scrutinee state; a move
; in one arm must not poison the others — only one arm runs. Binders alias
; the scrutinee's fields, so they never own (I64 is the historical
; state-tracking stand-in).
(deftype BArmsRes (BArmsRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap arms :- HArms esc :- i64])
                (BArmsErr [msg :- str]))

(defn b-arm-state [binders :- Sids fields :- TyList pst :- IMap powns :- IMap
                   tys :- TyEnv facts :- &Facts] :- BLRes
  (match binders
    (SNil [] (BLRes pst powns (MNil) (MNil) tys (BNil)))
    (SCons [b rest]
      (let [fty (match fields (TyCons [h t2] (clone h)) (TyNil [] (t-i64)))
            frest (match fields (TyCons [h t2] t2) (TyNil [] (TyNil)))]
        (match (b-arm-state rest frest pst powns tys facts)
          (BLErr [msg] (BLErr msg))
          (BLRes [st1 owns1 rem1 cons1 tys1 binds1]
            (BLRes (im-put st1 b 0) (im-put owns1 b 0) rem1 cons1
                   (te-put tys1 b (fp-binder-type fty facts)) (BNil))))))))

(defn b-arms [arms :- HArms pst :- IMap powns :- IMap st :- IMap owns :- IMap
             rem :- IMap cons :- IMap tys :- &TyEnv bcx :- &BCtx acc :- HArms
             adtidx :- i64 boxed :- i64 esc :- i64] :- BArmsRes
  (match arms
    (HANil [] (BArmsRes st owns rem cons (hes-rev-arms acc (HANil)) esc))
    (HACons [variant binders body next]
      (let [fields (if (= boxed 1) (b-varnt-fields-at bcx adtidx variant) (TyNil))]
        (match (b-arm-state-of (clone binders) (clone fields) (clone pst) (clone powns) (clone tys) bcx)
          (BLErr [msg] (BArmsErr msg))
          (BLRes [st1 owns1 rem1 cons1 tys1 binds1]
            (match (bcheck body (clone st1) (clone owns1) rem1 cons1 tys1 bcx)
              (BErr [msg] (BArmsErr msg))
              (BOk [st2 owns2 rem2 cons2 body2]
                ; a value moved in any arm counts as moved and
                ; unconsumed-eligible afterwards
                (let [escaped (b-tail-escape body2 (SNil))
                      esc2 (b-arm-esc-of (clone binders) fields (clone st2) escaped bcx esc)
                      st3 (b-merge-st st1 st2 st)
                      owns3 (b-merge-owns owns1 owns2 owns)]
                  (b-arms next pst powns st3 owns3 rem2 cons2
                          tys bcx
                          (HACons variant binders body2 acc)
                          adtidx boxed esc2))))))))))

(defn hes-rev-arms [arms :- HArms acc :- HArms] :- HArms
  (match arms
    (HANil [] acc)
    (HACons [variant binders body next]
      (hes-rev-arms next (HACons variant binders body acc)))))

; closure captures: use, record the heap-ownership bit, then move the
; non-Copy ones (the env's drop glue frees only what it really owns)
(deftype BCapRes (BCapRes [st :- IMap owns :- IMap rem :- IMap cons :- IMap caps :- Caps])
                (BCapErr [msg :- str]))

(defn b-caps [caps :- Caps st :- IMap owns :- IMap rem :- IMap cons :- IMap
             tys :- &TyEnv bcx :- &BCtx] :- BCapRes
  (match caps
    (CNil [] (BCapRes st owns rem cons (CNil)))
    (CCons [name ty own next]
      (match (use-var name rem tys st bcx)
        (UseRes [rem2 msg]
          (if (> (count msg) 0)
            (BCapErr msg)
            (let [own2 (im-get owns name 0)]
              (if (is-non-copy-ty ty)
                (match (move-var name st owns cons)
                  (MoveRes [st2 owns2 cons2]
                    (match (b-caps next st2 owns2 rem2 cons2 tys bcx)
                      (BCapErr [msg] (BCapErr msg))
                      (BCapRes [st3 owns3 rem3 cons3 caps2]
                        (BCapRes st3 owns3 rem3 cons3 (CCons name ty own2 caps2))))))
                (match (b-caps next st owns rem2 cons tys bcx)
                  (BCapErr [msg] (BCapErr msg))
                  (BCapRes [st3 owns3 rem3 cons3 caps2]
                    (BCapRes st3 owns3 rem3 cons3 (CCons name ty own2 caps2))))))))))))

; --- the checker body ----------------------------------------------------------------

(defn bcheck [e :- HExpr st :- IMap owns :- IMap rem :- IMap cons :- IMap
             tys :- TyEnv bcx :- &BCtx] :- BRes
  (match e
    (HConstI64 [v]
    
      (BOk st owns rem cons e))

    (HConstF64 [v]
    
      (BOk st owns rem cons e))

    (HConstB [v]
    
      (BOk st owns rem cons e))

    (HStrLit [v]
    
      (BOk st owns rem cons e))

    (HVecLit [el vals]
    
      (BOk st owns rem cons e))

    (HArgs []
      (BOk st owns rem cons e))

    (HVar [name]
    (match (use-var name rem tys st bcx)
      (UseRes [rem2 msg]
        (if (> (count msg) 0) (BErr msg) (BOk st owns rem2 cons e)))))

    (HBinW [op a b ty]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HBinW op c1 c2 ty)))))))

    (HBinF [op a b]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HBinF op c1 c2)))))))

    (HCmpW [op a b ty]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HCmpW op c1 c2 ty)))))))

    (HStrCmp [p a b]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HStrCmp p c1 c2)))))))

    (HStrOrd [op a b]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HStrOrd op c1 c2)))))))

    (HAnd [a b]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HAnd c1 c2)))))))

    (HOr [a b]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HOr c1 c2)))))))

    (HMin [a b ty]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HMin c1 c2 ty)))))))

    (HMax [a b ty]
    (match (bcheck a st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck b st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HMax c1 c2 ty)))))))

    (HSplit [s sep]
    (match (bcheck s st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck sep st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HSplit c1 c2)))))))

    (HJoin [sep xs]
    (match (bcheck sep st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck xs st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HJoin c1 c2)))))))

    (HStrNth [s idx res]
    (match (bcheck s st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck idx st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HStrNth c1 c2 res)))))))

    (HSubs [s a b]
    (match (bcheck s st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck a st1 owns1 rem1 cons1 (clone tys) bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (match (bcheck b st2 owns2 rem2 cons2 tys bcx)
              (BErr [msg] (BErr msg))
              (BOk [st3 owns3 rem3 cons3 c3]
                (BOk st3 owns3 rem3 cons3 (HSubs c1 c2 c3)))))))))

    (HICast [x from to]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HICast c1 from to)))))

    (HCount [x]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HCount c1)))))

    (HToStr [x ty]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HToStr c1 ty)))))

    (HCharStr [x]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HCharStr c1)))))

    (HNot [x]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HNot c1)))))

    (HAbs [x ty]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HAbs c1 ty)))))

    (HClone [x]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HClone c1)))))

    (HSlurp [p]
    (match (bcheck p st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HSlurp c1)))))

    (HExit [x]
    (match (bcheck x st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HExit c1)))))

    (HParseNum [s intf res]
    (match (bcheck s st owns rem cons tys bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HParseNum c1 intf res)))))

    (HStrCat [args]
    (match (b-kids args st owns rem cons tys bcx (HENil))
      (BKErr [msg] (BErr msg))
      (BKOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HStrCat c1)))))

    (HSeq [es]
    (match (b-kids es st owns rem cons tys bcx (HENil))
      (BKErr [msg] (BErr msg))
      (BKOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HSeq c1)))))

    (HRecur [args]
    (match (b-kids args st owns rem cons tys bcx (HENil))
      (BKErr [msg] (BErr msg))
      (BKOk [st1 owns1 rem1 cons1 c1]
        (BOk st1 owns1 rem1 cons1 (HRecur c1)))))

    (HGet [src idx dflt ty res]
    (match (bcheck src st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck idx st1 owns1 rem1 cons1 (clone tys) bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (match (b-default dflt st2 owns2 rem2 cons2 tys bcx)
              (BKErr [msg] (BErr msg))
              (BKOk [st3 owns3 rem3 cons3 c3]
                (BOk st3 owns3 rem3 cons3 (HGet c1 c2 c3 ty res)))))))))

    (HConj [v x el inplace]
    (match (bcheck v st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
          (let [vn (name-of (clone c1))
              isv (= (h-tag c1) 3)
              t (te-get tys vn)
              lastq (and isv
                         (not (ty-noneq t))
                         (is-non-copy-ty t)
                         (= (im-get st1 vn 0) 0)
                         (= (im-get owns1 vn 0) 1)
                         (= (im-get rem1 vn 0) 0))]
          (if (not lastq)
            (match (bcheck x st1 owns1 rem1 cons1 tys bcx)
              (BErr [msg] (BErr msg))
              (BOk [st2 owns2 rem2 cons2 c2]
                (BOk st2 owns2 rem2 cons2 (HConj c1 c2 el 0))))
            (match (move-var vn st1 owns1 cons1)
              (MoveRes [st2 owns2 cons2]
                (match (bcheck x st2 owns2 rem1 cons2 tys bcx)
                  (BErr [msg] (BErr msg))
                  (BOk [st3 owns3 rem2 cons3 c2]
                    (BOk st3 owns3 rem2 cons3 (HConj c1 c2 el 1)))))))))))

    (HIf [c t2 e2 ty]
    (match (bcheck c st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck t2 (clone st1) (clone owns1) rem1 cons1 (clone tys) bcx)
          (BErr [msg] (BErr msg))
          (BOk [stT ownsT remT consT c2]
            (match (bcheck e2 (clone st1) (clone owns1) remT consT tys bcx)
              (BErr [msg] (BErr msg))
              (BOk [stE ownsE remE consE c3]
                (let [st4 (b-merge-st stT stE st1)
                      owns4 (b-merge-owns ownsT ownsE owns1)]
                  (BOk st4 owns4 remE consE (HIf c1 c2 c3 ty))))))))))

    (HLet [binds body frees]
    (match (b-let-binds binds st owns rem cons tys bcx (BNil))
      (BLErr [msg] (BErr msg))
      ; b-let-binds prepends while walking, so restore source order —
      ; frees are collected in binding order over the restored chain
      (BLRes [st1 owns1 rem1 cons1 tys1 binds2]
        (match (bcheck body st1 owns1 rem1 cons1 tys1 bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 body2]
            (let [binds3 (binds-rev binds2 (BNil))
                  frees2 (b-frees (clone binds3) (clone st2) (clone owns2) (clone cons2) bcx)]
              (BOk st2 owns2 rem2 cons2 (HLet binds3 body2 frees2))))))))

    (HLoop [binds ty body]
    (match (b-loop-binds binds st owns rem cons tys bcx (BNil) (MNil))
      (BLoopErr [msg] (BErr msg))
      (BLoopRes [st1 owns1 rem1 cons1 tys1 binds2 saved]
        (match (bcheck body st1 owns1 rem1 cons1 tys1
                       (bcx-with-loopcopy bcx (binds-loopcopy (binds-rev (clone binds2) (BNil)) (SNil))))
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 body2]
            (BOk (b-restore-st saved st2) owns2 rem2 cons2 (HLoop (binds-rev binds2 (BNil)) ty body2)))))))

    (HCtor [adt variant args]
    (match (b-kids args st owns rem cons tys bcx (HENil))
      (BKErr [msg] (BErr msg))
      (BKOk [st1 owns1 rem1 cons1 c1]
        (if (= (b-facts-owns-at bcx adt) 1)
          (match (b-ctor-move (clone c1) st1 owns1 rem1 cons1 tys bcx)
            (B4Err [msg] (BErr msg))
            (B4 [st2 owns2 rem2 cons2]
              (BOk st2 owns2 rem2 cons2 (HCtor adt variant c1))))
          (BOk st1 owns1 rem1 cons1 (HCtor adt variant c1))))))

    (HMatch [scrut arms ty]
    (let [adtidx (fp-scrut-adt scrut tys)
          boxed (if (and (>= adtidx 0) (= (b-facts-boxed-at bcx adtidx) 1)) 1 0)]
    (match (bcheck (clone scrut) st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (b-arms arms (clone st1) (clone owns1) st1 owns1 rem1 cons1 tys bcx (HANil) adtidx boxed 0)
          (BArmsErr [msg] (BErr msg))
          (BArmsRes [st2 owns2 rem2 cons2 arms2 esc2]
            ; An aliasing binder left the arm: the box's drop duty
            ; transfers, so the scrutinee's own scope free is suppressed.
            (if (and (= esc2 1) (= (h-tag scrut) 3))
              (match (move-var (name-of scrut) st2 owns2 cons2)
                (MoveRes [st3 owns3 cons3] (BOk st3 owns3 rem2 cons3 (HMatch c1 arms2 ty))))
              (BOk st2 owns2 rem2 cons2 (HMatch c1 arms2 ty)))))))))

    (HDrop [x]
    (match (bcheck x st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (if (= (h-tag c1) 3)
          (match (move-if-nc (name-of (clone c1)) st1 owns1 rem1 cons1 tys bcx)
            (MncErr [msg] (BErr msg))
            (MncRes [st2 owns2 rem2 cons2]
              (BOk st2 owns2 rem2 cons2 (HDrop c1))))
          (BOk st1 owns1 rem1 cons1 (HDrop c1))))))

    (HClosure [sig mangled params caps body]
    ; captures use+move here (non-Copy); the BODY is checked separately
    ; over the lambda table (check-lams) — the seed's split
    (match (b-caps caps st owns rem cons tys bcx)
      (BCapErr [msg] (BErr msg))
      (BCapRes [st1 owns1 rem1 cons1 caps2]
        (BOk st1 owns1 rem1 cons1 (HClosure sig mangled params caps2 body)))))

    (HClosureCall [f args sig]
    (match (bcheck f st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (b-kids args st1 owns1 rem1 cons1 tys bcx (HENil))
          (BKErr [msg] (BErr msg))
          (BKOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HClosureCall c1 c2 sig)))))))

    (HSpit [path data]
    (match (bcheck path st owns rem cons (clone tys) bcx)
      (BErr [msg] (BErr msg))
      (BOk [st1 owns1 rem1 cons1 c1]
        (match (bcheck data st1 owns1 rem1 cons1 tys bcx)
          (BErr [msg] (BErr msg))
          (BOk [st2 owns2 rem2 cons2 c2]
            (BOk st2 owns2 rem2 cons2 (HSpit c1 c2)))))))

    (HCall [name args]
    (match (b-kids args st owns rem cons tys bcx (HENil))
      (BKErr [msg] (BErr msg))
        (BKOk [st1 owns1 rem1 cons1 c1]
          (match (b-call-move name (clone c1) st1 owns1 rem1 cons1 tys bcx)
          (B4Err [msg] (BErr msg))
          (B4 [st2 owns2 rem2 cons2]
            (BOk st2 owns2 rem2 cons2 (HCall name c1)))))))
))(defn b-ctor-move [args :- HExprs st :- IMap owns :- IMap rem :- IMap cons :- IMap
                  tys :- &TyEnv bcx :- &BCtx] :- B4
  (match args
    (HENil [] (B4 st owns rem cons))
    (HECons [kid next]
      (if (= (h-tag kid) 3)
        (match (move-if-nc (name-of kid) st owns rem cons tys bcx)
          (MncErr [msg] (B4Err msg))
          (MncRes [st2 owns2 rem2 cons2]
            (b-ctor-move next st2 owns2 rem2 cons2 tys bcx)))
        (b-ctor-move next st owns rem cons tys bcx)))))

; --- plan_drops: the per-defn wrapper ------------------------------------------------

; precompute the Shared-kind callees: builtins and externs never consume
(defn plist-has-borrowed [ps :- PList] :- bool
  (match ps
    (PNil [] false)
    (PCons [h t]
      (match h
        (Param [pname pty pb]
          (if (= pb 1) true (plist-has-borrowed t)))))))

(defn b-shared-callees [defs :- &Defns acc :- Sids] :- Sids
  ; externs never consume; a defn with a borrowed (&) parameter never
  ; consumes either — its borrowed args stay with the caller (S8).
  ; The walk borrows: cloning the whole program per step made the
  ; self-compile quadratic.
  (match defs
    (DNil [] acc)
    (DCons [h t]
      ; one shallow destructure per defn: h is a binder of the borrowed
      ; walk, so the inner match consumes a clone of the box (the walk
      ; itself stays O(n))
      (match (clone h)
        (Defn [name params ret isextern body rb]
          (b-shared-callees t
            (if (or (= isextern 1) (plist-has-borrowed params))
              (SCons name acc) acc)))))))

(defn b-add-builtins [acc :- Sids] :- Sids
  (sids-append (sids-append (sids-append (sids-append (sids-append (sids-append
    (sids-append acc (s-count)) (s-evenq)) (s-printi64)) (s-printf64))
    (s-getform)) (s-clone)) (s-dropform)))

(deftype BPlan (BPlan [st :- IMap owns :- IMap e :- HExpr frees :- Sids])
              (BPlanErr [msg :- str]))

; --- borrowed-return preconditions ------------------------------------------

; the borrowed (pb != 0) parameter names of a defn
(defn b-borrowed-names [ps :- PList acc :- Sids] :- Sids
  (match ps
    (PNil [] acc)
    (PCons [h t]
      (match h
        (Param [pname pty pb]
          (b-borrowed-names t
            (if (= pb 1) (SCons pname acc) acc)))))))

; union src into dst
(defn sids-into [src :- &Sids dst :- Sids] :- Sids
  (match src
    (SNil [] dst)
    (SCons [h t] (sids-into t (SCons h dst)))))

; is the callee's return a borrow? Mirrors the seed's tail_borrow_ok. The
; test is conservative: an unmodelled form returns false (reject).
(defn b-tail-borrow-ok [e :- &HExpr borrows :- &Sids dparams :- &DParams retb :- &RBTable] :- bool
  (match e
    (HVar [v] (sids-has borrows v))
    (HCall [name args]
      (if (= (rb-get retb name) 1)
        (match (dparams-get dparams name)
          (DFound [ps] (b-tail-args-ok args ps borrows dparams retb))
          (DMissing [] false))
        false))
    (HClone [x] false)
    (HIf [c t f ty]
      (and (b-tail-borrow-ok t borrows dparams retb)
           (b-tail-borrow-ok f borrows dparams retb)))
    (HMatch [scrut arms ty]
      (let [sc (if (match scrut (HVar [v] (sids-has borrows v)) (_ false))
                 1
                 (if (b-tail-borrow-ok scrut borrows dparams retb) 1 0))]
        (b-tail-arms-ok arms borrows sc dparams retb)))
    (HLet [binds body frees]
      (b-tail-borrow-ok body (b-tail-let-fold binds borrows dparams retb) dparams retb))
    (HSeq [es] (b-tail-seq-ok es borrows dparams retb))
    (_ false)))

(defn b-tail-args-ok [args :- &HExprs ps :- &PList borrows :- &Sids dparams :- &DParams retb :- &RBTable] :- bool
  (match args
    (HENil [] true)
    (HECons [kid next]
      (match ps
        (PNil [] true)
        (PCons [h pt]
          (match h
            (Param [pname pty pb]
              (if (and (= pb 1) (not (b-tail-borrow-ok kid borrows dparams retb)))
                false
                (b-tail-args-ok next pt borrows dparams retb)))))))))

(defn b-tail-arms-ok [arms :- &HArms borrows :- &Sids sc :- i64 dparams :- &DParams retb :- &RBTable] :- bool
  (match arms
    (HANil [] true)
    (HACons [variant binders body next]
      (let [arb (if (= sc 1) (sids-into binders (clone borrows)) (clone borrows))]
        (if (b-tail-borrow-ok body arb dparams retb)
          (b-tail-arms-ok next borrows sc dparams retb)
          false)))))

(defn b-tail-let-fold [binds :- &Binds borrows :- &Sids dparams :- &DParams retb :- &RBTable] :- Sids
  (match binds
    (BNil [] (clone borrows))
    (BCons [name v ty next]
      (b-tail-let-fold next
        (if (b-tail-borrow-ok v borrows dparams retb) (SCons name (clone borrows)) borrows)
        dparams retb))))

(defn b-tail-seq-ok [es :- &HExprs borrows :- &Sids dparams :- &DParams retb :- &RBTable] :- bool
  (match es
    (HENil [] false)
    (HECons [kid next]
      (match next
        (HENil [] (b-tail-borrow-ok kid borrows dparams retb))
        (HECons [k2 n2] (b-tail-seq-ok next borrows dparams retb))))))

; Owned move-type parameters whose buffer is still held at body exit get a
; scope-exit free (mirrors the seed's param_frees wrapper). A moved or
; returned param has already transferred its drop duty (owns=0, or escaped).
(defn fp-frees [params :- PList st :- &IMap owns :- &IMap facts :- &Facts esc :- &Sids] :- Sids
  (match params
    (PNil [] (SNil))
    (PCons [p rest]
      (match p
        (Param [pname pty pb]
          (if (and (= pb 0)
                   (b-param-moves pty facts)
                   (= (im-get owns pname 0) 1)
                   (= (im-get st pname -1) 0)
                   (not (sids-has esc pname)))
            (SCons pname (fp-frees rest st owns facts esc))
            (fp-frees rest st owns facts esc)))))))

; A `&T` return is only a sound borrow for pointer-like values: a boxed
; (recursive/owning) ADT. The return index reads the template facts (the
; annotation names a template).
(defn b-borrowed-ret-boxed [ret :- &Ty facts :- &Facts] :- bool
  (if (= (ty-tag ret) 16)
    (= (facts-boxed-at facts (ty-arg ret)) 1)
    false))

; plan_drops over one body: the pre-passes, the param states, the walk
(deftype BPlanRes (BPlanRes [bcx :- BCtx plan :- BPlan]))

; The plan plus the context it ran in. The program-wide tables (facts, the
; symbol table, shared names, the ADT table, per-callee parameter borrows,
; return-borrows) are computed once per program and never change during the
; pass, so they are threaded *through* the planner and handed back rather
; than copied per definition — the `dparams` map alone has one entry per
; definition, and every definition copied it twice.
(defn fp-frees-of [params :- PList st :- &IMap owns :- &IMap bcx :- &BCtx] :- Sids
  (match bcx
    (BCtx [esc _sh facts _tab _shared _lc _adts _dp _retb]
      (fp-frees params st owns facts esc))))

(defn b-plan [name :- i64 params :- PList body :- HExpr ret :- Ty rb :- i64 facts :- Facts
             tab :- i64 shared :- Sids adts :- AdtTab dparams :- DParams retb :- RBTable] :- BPlanRes
  ; Borrowed-return preconditions fire first so the reported error is the
  ; return-shape problem, not a downstream symptom.
  (let [bn (b-borrowed-names (clone params) (SNil))]
    (if (= rb 1)
      (if (not (b-borrowed-ret-boxed ret facts))
        (BPlanRes (BCtx (SNil) (SNil) facts tab shared (SNil) adts dparams retb)
                  (BPlanErr "borrowed return: `&T` requires a boxed (recursive or owning) ADT return type"))
        (if (not (b-tail-borrow-ok body bn dparams retb))
          (BPlanRes (BCtx (SNil) (SNil) facts tab shared (SNil) adts dparams retb)
                    (BPlanErr "Borrowed return requires a borrowed value. A `&T` function may only return a value derived from its `&` parameters, never an owned or freshly-cloned value."))
          (b-plan-body name params body (BCtx (SNil) (SNil) facts tab shared (SNil) adts dparams retb))))
      (b-plan-body name params body (BCtx (SNil) (SNil) facts tab shared (SNil) adts dparams retb)))))

(defn b-plan-body [name :- i64 params :- PList body :- HExpr bcx :- BCtx] :- BPlanRes
  ; `shared` (builtins, which never consume) and `dparams` (per-callee
  ; parameter borrows) are computed once per program by check-program —
  ; computing them per defn walked the whole Defns chain 1000+ times.
  (match bcx
    (BCtx [_esc0 _sh0 facts tab shared _lc0 adts dparams retb]
      (let [escaped (b-tail-escape body (SNil))
            shadowed (b-shadowed-of (b-count-binds body (MNil)) (SNil))
            rem0 (b-count-vars body (MNil))
            r (b-init-params (clone params) (clone facts) (MNil) (MNil) (MNil) (MNil) (TENil))]
        (match r
          (BLErr [msg]
            (BPlanRes (BCtx escaped shadowed facts tab shared (SNil) adts dparams retb) (BPlanErr msg)))
          (BLRes [st0 owns0 rem0 cons0 tys0 binds0]
            (let [bcx2 (BCtx escaped shadowed facts tab shared (SNil) adts dparams retb)]
              (match (bcheck body st0 owns0 rem0 cons0 tys0 bcx2)
                (BErr [msg]
                  (BPlanRes bcx2
                            (BPlanErr (str "ownership check failed in " (sym-str tab name) ": " msg))))
                (BOk [st1 owns1 rem1 cons1 body2]
                  ; read through the context before it is handed back
                  (let [frees (fp-frees-of params st1 owns1 bcx2)]
                    (BPlanRes bcx2
                              (BPlan (clone st1) (clone owns1) body2 frees))))))))))))

(defn b-init-params [params :- PList facts :- Facts st :- IMap owns :- IMap
                    rem :- IMap cons :- IMap tys :- TyEnv] :- BLRes
  (match params
    (PNil [] (BLRes st owns rem cons tys (BNil)))
    (PCons [p rest]
      (match p
        (Param [pname pty pb]
          (b-init-params rest facts
                         (im-put st pname 0)
                         (im-put owns pname (if (and (= pb 0) (b-param-moves pty facts)) 1 0))
                         rem
                         cons
                         (te-put tys pname pty)))))))

; A user fn's returned str is owned by the caller (str results are
; caller-freed), so a borrowed-shape tail — a literal, or a str element
; load — must materialize an owned copy (strdup) at the return boundary.
; Mirrors the seed's own_str_return: recurse into the tail of Seq, both
; If branches, a Let's body, and every Match arm; wrap the borrowed
; leaves in clone and pass everything else through.
(defn own-str-return [e :- HExpr] :- HExpr
  (match e
    (HStrLit [_] (HClone e))
    (HGet [src idx dflt ty res]
      (if (= (ty-tag ty) 12)
        (HClone e)
        e))
    (HSeq [es] (HSeq (osr-seq es)))
    (HIf [c t f ty]
      (HIf c (own-str-return t) (own-str-return f) ty))
    (HLet [binds body frees]
      (HLet binds (own-str-return body) frees))
    (HMatch [scrut arms ty]
      (HMatch scrut (osr-arms arms) ty))
    (_ (clone e))))

(defn osr-seq [es :- HExprs] :- HExprs
  (match es
    (HENil [] (HENil))
    (HECons [kid next]
      (match next
        (HENil [] (HECons (own-str-return kid) (HENil)))
        (HECons [k2 n2] (HECons kid (osr-seq next)))))))

(defn osr-arms [as :- HArms] :- HArms
  (match as
    (HANil [] (HANil))
    (HACons [variant binders body next]
      (HACons variant binders (own-str-return body) (osr-arms next)))))

; --- whole-program check: rewrite every plain defn and lambda ---------------

(deftype CkRes (CKOk [defs :- Defns lams :- Lams])
              (CKErr [msg :- str]))

(defn check-defns [ds :- Defns acc :- Defns facts :- Facts tab :- i64
                  shared :- Sids adts :- AdtTab dparams :- DParams retb :- RBTable] :- CkRes
  ; the whole-program state threads by move — a per-step clone of facts/
  ; tab/alldefs made the self-compile quadratic (S8)
  (match ds
    (DNil [] (CKOk acc (LMNil)))
    (DCons [h t]
      (match h
        (Defn [name params ret ie body rb]
          (if (= ie 1)
            (check-defns t (defns-append acc h) facts tab shared adts dparams retb)
            (match (b-plan name (clone params) body (clone ret) rb facts tab shared adts dparams retb)
              (BPlanRes [bcx plan]
                (match bcx
                  (BCtx [_e _s facts2 tab2 shared2 _lc adts2 dp2 retb2]
                    (match plan
                      (BPlanErr [msg] (CKErr msg))
                      (BPlan [st owns body2 frees]
                        (let [body3 (if (sids-null frees)
                                      body2
                                      (HLet (BNil) body2 frees))]
                          (check-defns t
                                       (defns-append acc (Defn name params (clone ret) ie
                                                               (if (ty-eq ret (t-str))
                                                                 (own-str-return body3)
                                                                 body3)
                                                               rb))
                                       facts2 tab2 shared2 adts2 dp2 retb2))))))))))))))

(deftype LkRes (LOkL [lams :- Lams]) (LErrL [msg :- str]))

(defn check-lams [ls :- Lams acc :- Lams facts :- Facts tab :- i64
                 shared :- Sids adts :- AdtTab dparams :- DParams retb :- RBTable] :- LkRes
  (match ls
    (LMNil [] (LOkL acc))
    (LMCons [h t]
      (match h
        (Lam [mangled caps params ret body]
          (match (b-plan mangled (clone params) body (clone ret) 0 facts tab shared adts dparams retb)
            (BPlanRes [bcx plan]
              (match bcx
                (BCtx [_e _s facts2 tab2 shared2 _lc adts2 dp2 retb2]
                  (match plan
                    (BPlanErr [msg] (LErrL msg))
                    (BPlan [st owns body2 _frees]
                      (check-lams t (lams-append acc (Lam mangled caps params (clone ret)
                                                          (if (ty-eq ret (t-str))
                                                            (own-str-return body2)
                                                            body2)))
                                  facts2 tab2 shared2 adts2 dp2 retb2))))))))))))

(defn check-program [defs :- Defns lams :- Lams facts :- Facts
                    tab :- i64 adts :- AdtTab] :- CkRes
  (let [shared (b-add-builtins (SNil))
        dparams (b-dparams defs (DPNil))
        retb (b-retb defs (RBNil))
        ; the second stage re-reads the small program state: clone it
        ; before the first call moves it
        facts2 (clone facts)
        tab2 (clone tab)
        shared2 (clone shared)
        adts2 (clone adts)
        dparams2 (clone dparams)
        retb2 (clone retb)]
    (match (check-defns defs (DNil) facts tab shared adts dparams retb)
      (CKErr [msg] (CKErr msg))
      (CKOk [defs2 lams0]
        (match (check-lams lams (LMNil) facts2 tab2 shared2 adts2 dparams2 retb2)
          (LErrL [msg] (CKErr msg))
          (LOkL [lams2] (CKOk defs2 lams2)))))))

; dump.cato — S6: the typed-IR wire format.
;
; One line per record; bodies as compact s-expressions; names rendered
; through the symtab; f64 through the S3 `%g` contract (`(str f)`).
; Records: `(adt I NAME PARAMS VARIANTS)` for declared templates,
; `(adtinst I TPL NAME)` for instances, `(defn NAME [p:T ...] :- T EXT
; BODY)`, `(lambda MANGLED [c:T:OWN ...] [p:T ...] :- T BODY)`, `(fnsig
; [T ...] T)`. Ops render as the kernel's integer codes (binw: 0 add 1
; sub 2 mul 3 div; cmp: 0 = 1 /= 2 < 3 > 4 <= 5 >=).

; --- types ------------------------------------------------------------------

(defn d-ty [ty :- Ty] :- str
  (let [t (ty-tag ty)
        a (ty-arg ty)]
    (cond
      (= t 0) "i64"
      (= t 1) "i32"
      (= t 2) "i8"
      (= t 3) "i16"
      (= t 4) "u8"
      (= t 5) "u16"
      (= t 6) "u32"
      (= t 7) "u64"
      (= t 8) "usize"
      (= t 9) "f64"
      (= t 10) "f32"
      (= t 11) "bool"
      (= t 12) "str"
      (= t 13) "map"
      (= t 14) "set"
      (= t 15) (cond
                 (= a 0) "(Vector i64)"
                 (= a 1) "(Vector f64)"
                 (= a 2) "(Vector str)"
                 (str "(Vector " (d-ty (elem-ty (clone a))) ")"))
      (= t 16) (str "(Adt " a ")")
      (= t 17) (str "(Fn " a ")")
      (= t 18) (str "(Param " a ")")
      "none")))

(defn d-tys [tys :- TyList] :- str
  ; a bracket list of type words: [T T T]
  (let [parts (d-tys-parts tys)]
    (str "[" parts "]")))

(defn d-tys-parts [tys :- TyList] :- str
  (match tys
    (TyNil [] "")
    (TyCons [h t]
      (if (tys-null t)
        (d-ty h)
        (str (d-ty h) " " (d-tys-parts t))))))

; --- expressions --------------------------------------------------------------

(defn d-e [e :- HExpr tab :- i64] :- str
  (match e
    (HConstI64 [v] (str "(const " v ")"))
    (HConstF64 [v] (str "(f64lit " (str v) ")"))
    (HConstB [v] (str "(bool " v ")"))
    (HVar [name] (str "(var " (sym-str (clone tab) name) ")"))
    (HStrLit [v] (str "(str " (esc-str (clone v) 0 (count v) "") ")"))
    (HVecLit [el vals] (str "(veclit " el " " (d-vvals vals) ")"))
    (HBinW [op a b ty] (str "(binw " op " " (d-e a (clone tab)) " " (d-e b (clone tab)) " " (d-ty ty) ")"))
    (HBinF [op a b] (str "(binf " op " " (d-e a (clone tab)) " " (d-e b (clone tab)) ")"))
    (HCmpW [op a b ty] (str "(cmp " op " " (d-e a (clone tab)) " " (d-e b (clone tab)) " " (d-ty ty) ")"))
    (HStrCmp [p a b] (str "(strcmp " p " " (d-e a (clone tab)) " " (d-e b (clone tab)) ")"))
    (HStrOrd [op a b] (str "(strord " op " " (d-e a (clone tab)) " " (d-e b (clone tab)) ")"))
    (HICast [x from to] (str "(icast " (d-e x (clone tab)) " " (d-ty from) " " (d-ty to) ")"))
    (HCount [x] (str "(count " (d-e x (clone tab)) ")"))
    (HToStr [x ty] (str "(tostr " (d-e x (clone tab)) " " (d-ty ty) ")"))
    (HStrCat [args] (str "(strcat" (d-args args (clone tab)) ")"))
    (HSubs [s a b] (str "(subs " (d-e s (clone tab)) " " (d-e a (clone tab)) " " (d-e b (clone tab)) ")"))
    (HSplit [s sep] (str "(split " (d-e s (clone tab)) " " (d-e sep (clone tab)) ")"))
    (HJoin [sep xs] (str "(join " (d-e sep (clone tab)) " " (d-e xs (clone tab)) ")"))
    (HStrNth [s idx res] (str "(nth " (d-e s (clone tab)) " " (d-e idx (clone tab)) " " (d-ty res) ")"))
    (HCharStr [x] (str "(charstr " (d-e x (clone tab)) ")"))
    (HGet [src idx dflt ty res]
      (if (hes-null dflt)
        (str "(get " (d-e src (clone tab)) " " (d-e idx (clone tab)) " " (d-ty ty) " " (d-ty res) ")")
        (str "(get " (d-e src (clone tab)) " " (d-e idx (clone tab)) " " (d-e (hes-head-hes dflt) (clone tab)) " " (d-ty ty) " " (d-ty res) ")")))
    (HConj [v x el inplace] (str "(conj " (d-e v (clone tab)) " " (d-e x (clone tab)) " " el " " inplace ")"))
    (HIf [c t e2 ty] (str "(if " (d-e c (clone tab)) " " (d-e t (clone tab)) " " (d-e e2 (clone tab)) " " (d-ty ty) ")"))
    (HAnd [a b] (str "(and " (d-e a (clone tab)) " " (d-e b (clone tab)) ")"))
    (HOr [a b] (str "(or " (d-e a (clone tab)) " " (d-e b (clone tab)) ")"))
    (HNot [x] (str "(not " (d-e x (clone tab)) ")"))
    (HAbs [x ty] (str "(abs " (d-e x (clone tab)) " " (d-ty ty) ")"))
    (HMin [a b ty] (str "(min " (d-e a (clone tab)) " " (d-e b (clone tab)) " " (d-ty ty) ")"))
    (HMax [a b ty] (str "(max " (d-e a (clone tab)) " " (d-e b (clone tab)) " " (d-ty ty) ")"))
    (HSeq [es] (str "(seq" (d-args es (clone tab)) ")"))
    (HLet [binds body frees]
      (str "(let " (d-binds binds (clone tab)) " " (d-sids-list frees (clone tab)) " " (d-e body (clone tab)) ")"))
    (HLoop [binds ty body]
      (str "(loop " (d-loop-binds binds (clone tab)) " " (d-ty ty) " " (d-e body (clone tab)) ")"))
    (HRecur [args] (str "(recur" (d-args args (clone tab)) ")"))
    (HCtor [adt variant args] (str "(ctor " adt " " variant (d-args args (clone tab)) ")"))
    (HMatch [scrut arms ty] (str "(match " (d-e scrut (clone tab)) " " (d-ty ty) (d-arms arms (clone tab)) ")"))
    (HClone [x] (str "(clone " (d-e x (clone tab)) ")"))
    (HDrop [x] (str "(drop " (d-e x (clone tab)) ")"))
    (HClosure [sig mangled params caps body]
      (str "(closure " sig " " (sym-str (clone tab) mangled)
           " " (d-params params (clone tab))
           " " (d-caps caps (clone tab))
           " " (d-e body (clone tab)) ")"))
    (HClosureCall [f args sig]
      (str "(closurecall " (d-e f (clone tab)) " " sig (d-args args (clone tab)) ")"))
    (HCall [name args] (str "(call " (sym-str (clone tab) name) (d-args args (clone tab)) ")"))
    (HSlurp [p] (str "(slurp " (d-e p (clone tab)) ")"))
    (HSpit [path data] (str "(spit " (d-e path (clone tab)) " " (d-e data (clone tab)) ")"))
    (HArgs [] "(args)")
    (HExit [x] (str "(exit " (d-e x (clone tab)) ")"))
    (HParseNum [s intf res] (str "(parse " (d-e s (clone tab)) " " intf " " (d-ty res) ")"))))

(defn d-vvals [vals :- VVals] :- str
  ; a bracket list of raw literal numbers
  (match vals
    (VVNil [] "[]")
    (VVI64 [v next]
      (if (vvals-null (clone next))
        (str "[" v "]")
        (str "[" v (d-vvals-rest next) "]")))
    (VVF64 [v next]
      (if (vvals-null (clone next))
        (str "[" (str v) "]")
        (str "[" (str v) (d-vvals-rest next) "]")))))

(defn vvals-null [vals :- VVals] :- bool
  (match vals
    (VVNil [] true)
    (VVI64 [v next] false)
    (VVF64 [v next] false)))

(defn d-vvals-rest [vals :- VVals] :- str
  (match vals
    (VVNil [] "")
    (VVI64 [v next] (str " " v (d-vvals-rest next)))
    (VVF64 [v next] (str " " (str v) (d-vvals-rest next)))))

(defn d-args [es :- HExprs tab :- i64] :- str
  ; a space-separated run of child expressions: " e1 e2"
  (match es
    (HENil [] "")
    (HECons [kid next] (str " " (d-e kid (clone tab)) (d-args next (clone tab))))))

(defn d-binds [binds :- Binds tab :- i64] :- str
  ; bracket list of flattened triples: [n e T n e T ...]
  (str "[" (d-binds-parts binds (clone tab)) "]"))

(defn d-binds-parts [binds :- Binds tab :- i64] :- str
  (match binds
    (BNil [] "")
    (BCons [name v ty next]
      (let [piece (str (sym-str (clone tab) name) " " (d-e v (clone tab)) " " (d-ty ty))]
        (if (binds-null (clone next))
          piece
          (str piece " " (d-binds-parts next (clone tab))))))))

(defn binds-null [binds :- Binds] :- bool
  (match binds
    (BNil [] true)
    (BCons [name v ty next] false)))

(defn d-loop-binds [binds :- Binds tab :- i64] :- str
  ; bracket list of flattened triples: [n T e n T e ...]
  (str "[" (d-loop-binds-parts binds (clone tab)) "]"))

(defn d-loop-binds-parts [binds :- Binds tab :- i64] :- str
  (match binds
    (BNil [] "")
    (BCons [name v ty next]
      (let [piece (str (sym-str (clone tab) name) " " (d-ty ty) " " (d-e v (clone tab)))]
        (if (binds-null (clone next))
          piece
          (str piece " " (d-loop-binds-parts next (clone tab))))))))

(defn d-sids-list [ks :- Sids tab :- i64] :- str
  (str "[" (d-sids-parts ks (clone tab)) "]"))

(defn d-sids-parts [ks :- Sids tab :- i64] :- str
  (match ks
    (SNil [] "")
    (SCons [h t]
      (if (sids-null t)
        (sym-str (clone tab) h)
        (str (sym-str (clone tab) h) " " (d-sids-parts t (clone tab)))))))

(defn d-arms [arms :- HArms tab :- i64] :- str
  (match arms
    (HANil [] "")
    (HACons [variant binders body next]
      (let [vname (if (= variant -1) "_" (str variant))
            piece (str " (arm " vname " " (d-sids-list binders (clone tab)) " " (d-e body (clone tab)) ")")]
        (str piece (d-arms next (clone tab)))))))

(defn d-params [ps :- PList tab :- i64] :- str
  ; bracket list of named params: [p:T p:T]
  (str "[" (d-params-parts ps (clone tab)) "]"))

(defn d-params-parts [ps :- PList tab :- i64] :- str
  (match ps
    (PNil [] "")
    (PCons [h t]
      (match h
        (Param [name ty _pb]
          (let [piece (str (sym-str (clone tab) name) ":" (d-ty ty))]
            (if (plist-null (clone t))
              piece
              (str piece " " (d-params-parts t (clone tab))))))))))

(defn plist-null [ps :- PList] :- bool
  (match ps
    (PNil [] true)
    (PCons [h t] false)))

(defn d-caps [caps :- Caps tab :- i64] :- str
  ; bracket list of captures with ownership bits: [c:T:OWN c:T:OWN]
  (str "[" (d-caps-parts caps (clone tab)) "]"))

(defn d-caps-parts [caps :- Caps tab :- i64] :- str
  (match caps
    (CNil [] "")
    (CCons [name ty own next]
      (let [piece (str (sym-str (clone tab) name) ":" (d-ty ty) ":" own)]
        (if (caps-null (clone next))
          piece
          (str piece " " (d-caps-parts next (clone tab))))))))

(defn caps-null [caps :- Caps] :- bool
  (match caps
    (CNil [] true)
    (CCons [name ty own next] false)))

; --- records ------------------------------------------------------------------

(defn d-adt-variants [variants :- VList tab :- i64] :- str
  ; bracket list of (VName [T ...]) pairs
  (str "[" (d-variants-parts variants (clone tab)) "]"))

(defn d-variants-parts [variants :- VList tab :- i64] :- str
  (match variants
    (VNil [] "")
    (VCons [h t]
      (match h
        (Varnt [vname fields]
          (let [piece (str "(" (sym-str (clone tab) vname) " " (d-tys fields) ")")]
            (if (vlist-null (clone t))
              piece
              (str piece " " (d-variants-parts t (clone tab))))))))))

(defn vlist-null [vs :- VList] :- bool
  (match vs
    (VNil [] true)
    (VCons [h t] false)))

(defn d-adts [adts :- AdtTab tab :- i64 i :- i64 sb :- StrBuf] :- StrBuf
  (match adts
    (ATNil [] sb)
    (ATCons [h t]
      (match h
        (AdtInfo [name typarams variants tpl tplargs]
          (let [sb2 (if (= tpl -1)
                      (sb-add-line sb
                        (str "(adt " i " " (sym-str (clone tab) name)
                             " " (d-typarams typarams (clone tab))
                             " " (d-adt-variants variants (clone tab)) ")"))
                      (sb-add-line sb
                        (str "(adtinst " i " " tpl " " (sym-str (clone tab) name) ")")))]
            (d-adts t (clone tab) (+ i 1) sb2)))))))

(defn d-typarams [typarams :- Sids tab :- i64] :- str
  ; a bracket list of the header's type parameter NAMES: [a] or [a b]
  (str "[" (d-typarams-parts typarams (clone tab)) "]"))

(defn d-typarams-parts [ks :- Sids tab :- i64] :- str
  (match ks
    (SNil [] "")
    (SCons [h t]
      (if (sids-null t)
        (sym-str (clone tab) h)
        (str (sym-str (clone tab) h) " " (d-typarams-parts t (clone tab)))))))

(defn d-defn-line [d :- Defn tab :- i64] :- str
  (match d
    (Defn [name params ret isextern body rb]
      (str "(defn " (sym-str (clone tab) name)
           " " (d-params params (clone tab))
           " :- " (d-ty ret)
           " " isextern
           " " (d-e body (clone tab)) ")"))))

(defn d-defns [ds :- Defns tab :- i64 sb :- StrBuf] :- StrBuf
  (match ds
    (DNil [] sb)
    (DCons [h t] (d-defns t (clone tab) (sb-add-line sb (d-defn-line h (clone tab)))))))

(defn d-lams [ls :- Lams tab :- i64 sb :- StrBuf] :- StrBuf
  (match ls
    (LMNil [] sb)
    (LMCons [h t]
      (match h
        (Lam [mangled caps params ret body]
          (let [line (str "(lambda " (sym-str (clone tab) mangled)
                          " " (d-caps caps (clone tab))
                          " " (d-params params (clone tab))
                          " :- " (d-ty ret) " " (d-e body (clone tab)) ")")]
            (d-lams t (clone tab) (sb-add-line sb line))))))))

(defn d-sigs [ss :- Sigs sb :- StrBuf] :- StrBuf
  (match ss
    (SGNil [] sb)
    (SGCons [h t]
      (match h
        (Sig [params ret]
          (let [line (str "(fnsig " (d-tys params) " " (d-ty ret) ")")]
            (d-sigs t (sb-add-line sb line))))))))

; the whole program: adts (declared then instances, combined order),
; defns (plain in source order, then externs, then mono instances),
; lambdas, fn sigs
(defn dump-program [adts :- AdtTab defs :- Defns lams :- Lams sigs :- Sigs
                   tab :- i64] :- str
  (let [sb0 (d-adts adts (clone tab) 0 (sb-new))
        sb1 (d-defns defs (clone tab) sb0)
        sb2 (d-lams lams (clone tab) sb1)
        sb3 (d-sigs sigs sb2)]
    (sb-str sb3)))
; state.cato — S7: emitter state, module state, layout math, LLVM text
; helpers.
;
; A port of the seed emitter's `FnCtx` + `Mdl` under the kernel law:
; state threads as parameters and returns inside result ADTs. FnCtx
; carries the body and entry-prelude StrBufs (the prelude splices after
; `entry:` at function assembly — the seed's `with_prelude`), the temp
; and block counters, the current block label, and the binding
; environments: scalar registers (ints/floats/bool/str/ADT/closure
; slots), read-only vector pairs, growable collection header slots, and
; the innermost loop frame. Environments are sid-keyed `AList`s with
; prepend-on-bind; first-match reads reproduce the seed's
; map-overwrite-under-shadowing because each body is emitted strictly
; after its bind.
;
; Mdl carries the intern table (name rendering), the literal-global
; counter, the globals buffer, the deduplicated declare chain, the ADT
; table, and the full-table ownership facts (boxed = owns in the
; revised model).

; --- registers ---------------------------------------------------------------

(deftype RegVal (RegVal [r :- str ty :- Ty]))
(deftype VecVal (VecVal [p :- str l :- str el :- i64]))
(deftype GroVal (GroVal [slot :- str el :- i64]))

; slots: the loop variables' slots in source order (scalars.cato's
; EMLSlots); recur zips positionally.
(deftype LoopFr (LoopFr [slots :- EMLSlots head :- str]))

(deftype EScTab (EScNil) (EScCons [k :- i64 v :- RegVal t :- EScTab]))
(deftype EVcTab (EVcNil) (EVcCons [k :- i64 v :- VecVal t :- EVcTab]))
(deftype EGrTab (EGrNil) (EGrCons [k :- i64 v :- GroVal t :- EGrTab]))

(deftype FnCtx (FnCtx [tmpc :- i64 blkc :- i64 cur :- str
                       body :- StrBuf pre :- StrBuf
                       scalar :- EScTab
                       vecs :- EVcTab
                       grow :- EGrTab
                       lfr :- LoopFr]))

; Keyed chains: first match wins (prepend-on-bind = the seed's
; map-overwrite-under-shadowing).
(defn esc-get [t :- &EScTab k :- i64] :- RegVal
  (match t
    (EScCons [ek ev next] (if (= ek k) (clone ev) (esc-get next k)))
    (EScNil [] (RegVal "" (t-none)))))

(defn esc-has [t :- &EScTab k :- i64] :- bool
  (match t
    (EScCons [ek ev next] (if (= ek k) true (esc-has next k)))
    (EScNil [] false)))

(defn evc-get [t :- &EVcTab k :- i64] :- VecVal
  (match t
    (EVcCons [ek ev next] (if (= ek k) (clone ev) (evc-get next k)))
    (EVcNil [] (VecVal "" "" -1))))

(defn evc-has [t :- &EVcTab k :- i64] :- bool
  (match t
    (EVcCons [ek ev next] (if (= ek k) true (evc-has next k)))
    (EVcNil [] false)))

(defn egr-get [t :- &EGrTab k :- i64] :- GroVal
  (match t
    (EGrCons [ek ev next] (if (= ek k) (clone ev) (egr-get next k)))
    (EGrNil [] (GroVal "" -1))))

(defn egr-has [t :- &EGrTab k :- i64] :- bool
  (match t
    (EGrCons [ek ev next] (if (= ek k) true (egr-has next k)))
    (EGrNil [] false)))

(defn fn-new [] :- FnCtx
  (FnCtx 0 0 "entry" (sb-new) (sb-new)
         (EScNil) (EVcNil) (EGrNil) (LoopFr (ESlotsNil) "")))

; --- per-node results ---------------------------------------------------------

(deftype ESRes (ESRes [st :- Emit v :- str]))
(deftype EVRes (EVRes [st :- Emit p :- str l :- str el :- i64]))
(deftype HRes (HRes [st :- Emit p :- str l :- str cap :- str]))
(deftype EURes (EURes [st :- Emit]))
(deftype ETRes (ETRes [st :- Emit v :- str]))      ; minted temp
(deftype EBRes (EBRes [st :- Emit v :- str]))      ; minted block label
(deftype EMRes (EMRes [mdl :- Mdl v :- str]))      ; mdl-threading mint

; --- module state --------------------------------------------------------------

(deftype Strs (StrsNil) (StrsCons [h :- str t :- Strs]))

(defn strs-has [ss :- &Strs s :- str] :- bool
  (match ss
    (StrsCons [h t] (if (= h s) true (strs-has t (clone s))))
    (StrsNil [] false)))

(deftype Mdl (Mdl [tab :- i64 gctr :- i64 globals :- StrBuf
                   decls :- Strs adts :- AdtTab owns :- Sids
                   csigs :- Sigs]))

(defn md-new [tab :- i64 adts :- AdtTab owns :- Sids csigs :- Sigs] :- Mdl
  (Mdl (clone tab) 0 (sb-new) (StrsNil) adts owns csigs))

(defn md-tab [m :- &Mdl] :- i64
  (match m (Mdl [tab g globals decls adts owns csigs] tab)))

; The interned string for a sid, read straight off the borrowed module.
(defn md-sym [m :- &Mdl sid :- i64] :- str
  (match m (Mdl [tab g globals decls adts owns csigs] (stab-get tab sid))))

(defn md-adts [m :- &Mdl] :- AdtTab
  (match m (Mdl [tab g globals decls adts owns csigs] (clone adts))))

(defn md-owns [m :- &Mdl] :- Sids
  (match m (Mdl [tab g globals decls adts owns csigs] (clone owns))))

; Index the borrowed field directly: `(md-owns m)` clones the whole
; ownership list (one cons per ADT in the program) just to read slot i.
(defn md-owns-at [m :- &Mdl i :- i64] :- i64
  (match m (Mdl [tab g globals decls adts owns csigs] (sids-idx owns i))))

; `md-adts`/`md-owns`/`md-csigs` hand back an owned table (a deep copy),
; which is pure waste when the consumer only borrows it. These read the
; fields inside the match and return the *result* instead.
(defn md-fs-total [m :- &Mdl i :- i64] :- i64
  (match m (Mdl [tab g globals decls adts owns csigs] (fs-total adts owns i))))

(defn md-fs-off [m :- &Mdl ai :- i64 vi :- i64 k :- i64] :- i64
  (match m (Mdl [tab g globals decls adts owns csigs] (fs-off adts owns ai vi k))))

(defn md-fs-field-ty [m :- &Mdl ai :- i64 vi :- i64 k :- i64] :- Ty
  (match m (Mdl [tab g globals decls adts owns csigs] (fs-field-ty adts ai vi k))))

(defn md-esigs-at [m :- &Mdl i :- i64] :- ESig
  (match m (Mdl [tab g globals decls adts owns csigs] (esigs-at csigs i))))

(defn md-csigs [m :- &Mdl] :- Sigs
  (match m (Mdl [tab g globals decls adts owns csigs] (clone csigs))))

; Walk the borrowed table: `(md-adts m)` copied every ADT in the module
; (their variants and field lists included) just to index one of them.
(defn md-adt-name [m :- &Mdl i :- i64] :- str
  (match m
    (Mdl [tab g globals decls adts owns csigs]
      (match (adts-at adts i)
        (AdtInfo [name tps variants tpl tplargs]
          (stab-get tab name))))))

; --- declarations & globals -----------------------------------------------------

; Declare once per symbol (the seed's `declare` dedup by line).
(defn md-decl [m :- Mdl line :- str] :- Mdl
  (match m
    (Mdl [tab g globals decls adts owns csigs]
      (if (strs-has decls (clone line))
        (clone m)
        (Mdl (clone tab) (clone g) (clone globals)
             (StrsCons (clone line) (clone decls))
             (clone adts) (clone owns) (clone csigs))))))

(defn md-decls-lines [m :- &Mdl b :- StrBuf] :- StrBuf
  (match m
    (Mdl [tab g globals decls adts owns csigs] (md-decls-lines-1 (clone decls) b))))

(defn md-decls-lines-1 [ss :- Strs b :- StrBuf] :- StrBuf
  (match ss
    (StrsCons [h t] (md-decls-lines-1 t (sb-add-line b h)))
    (StrsNil [] b)))

(defn md-ensure [m :- Mdl line :- str] :- Mdl
  (match m
    (Mdl [tab g globals decls adts owns csigs]
      (if (strs-has decls (clone line))
        m
        (md-decl (clone m) (clone line))))))

; A private NUL-terminated [N x i8] global for a string literal.
(defn md-mint-str [m :- Mdl s :- str] :- EMRes
  (match m
    (Mdl [tab g globals decls adts owns csigs]
      (let [label (str "@g_str_" (clone g))
            n (count (clone s))
            bytes (md-str-bytes (clone s) 0 n (sb-new) true)
            line (str label " = private unnamed_addr constant [" (+ n 1) " x i8] ["
                      (sb-str bytes) "]")]
        (EMRes (Mdl tab (+ g 1)
                   (sb-add-line globals line)
                   decls adts owns csigs)
              label)))))

; The byte list of a global: `i8 b` per byte, then the NUL terminator.
(defn md-str-bytes [s :- str i :- i64 n :- i64 b :- StrBuf first :- bool] :- StrBuf
  (if (> i n)
    b
    (let [byte (if (= i n) 0 (str-byte s i))
          b2 (if first
               (sb-add b (str "i8 " byte))
               (sb-add b (str ", i8 " byte)))]
      (md-str-bytes (clone s) (+ i 1) n b2 false))))

; A private [N x i64/double] global for a vector literal; returns
; (label, len). el: 0 i64, 1 f64.
(deftype MVRes (MVRes [mdl :- Mdl label :- str len :- str]))

(defn md-mint-vec [m :- Mdl el :- i64 vals :- VVals] :- MVRes
  (match m
    (Mdl [tab g globals decls adts owns csigs]
      (let [label (str "@g_vec_" (clone g))
            n (vvals-depth vals)
            parts (md-vec-items vals (clone el) (sb-new) true)
            ty (if (= el 1) "double" "i64")
            line (str label " = private constant [" n " x " ty "] ["
                      (sb-str parts) "]")]
        (MVRes (Mdl tab (+ g 1)
                    (sb-add-line globals line)
                    decls adts owns csigs)
               label (str n))))))

(defn md-vec-items [vals :- VVals el :- i64 b :- StrBuf first :- bool] :- StrBuf
  (match vals
    (VVNil [] b)
    (VVI64 [v next]
      (let [b2 (if first
                 (sb-add b (str "i64 " v))
                 (sb-add b (str ", i64 " v)))]
        (md-vec-items next (clone el) b2 false)))
    (VVF64 [v next]
      (let [b2 (if first
                 (sb-add b (str "double " (llvm-f64 v)))
                 (sb-add b (str ", double " (llvm-f64 v))))]
        (md-vec-items next (clone el) b2 false)))))

; --- FnCtx primitives ------------------------------------------------------------

(deftype EFcT (EFcT [c :- FnCtx v :- str]))

(defn fc-temp [c :- FnCtx] :- EFcT
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (EFcT (FnCtx (+ tmpc 1) blkc cur body pre sc ve gr lfr)
            (str "%t" tmpc)))))

(deftype EFcB (EFcB [c :- FnCtx v :- str]))

(defn fc-block [c :- FnCtx] :- EFcB
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (EFcB (FnCtx tmpc (+ blkc 1) cur body pre sc ve gr lfr)
            (str "b" blkc)))))

(defn fc-line [c :- FnCtx s :- str] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (FnCtx tmpc blkc cur (sb-add-line body s) pre sc ve gr lfr))))

(defn fc-pre-line [c :- FnCtx s :- str] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (FnCtx tmpc blkc cur body (sb-add-line pre s) sc ve gr lfr))))

(defn fc-open [c :- FnCtx label :- str] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (FnCtx tmpc blkc label
             (sb-add-line body (str label ":"))
             pre sc ve gr lfr))))

(defn fc-sc-put [c :- FnCtx k :- i64 r :- str ty :- Ty] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (FnCtx tmpc blkc cur body pre (EScCons k (RegVal r ty) sc) ve gr lfr))))

(defn fc-sc-get [c :- &FnCtx k :- i64] :- RegVal
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (esc-get sc k))))

(defn fc-sc-has [c :- &FnCtx k :- i64] :- bool
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr] (esc-has sc k))))

(defn fc-vc-put [c :- FnCtx k :- i64 p :- str l :- str el :- i64] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (FnCtx tmpc blkc cur body pre sc (EVcCons k (VecVal p l el) ve) gr lfr))))

(defn fc-vc-get [c :- &FnCtx k :- i64] :- VecVal
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (evc-get ve k))))

(defn fc-vc-has [c :- &FnCtx k :- i64] :- bool
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr] (evc-has ve k))))

(defn fc-gr-put [c :- FnCtx k :- i64 slot :- str el :- i64] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (FnCtx tmpc blkc cur body pre sc ve (EGrCons k (GroVal slot el) gr) lfr))))

(defn fc-gr-get [c :- &FnCtx k :- i64] :- GroVal
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (egr-get gr k))))

(defn fc-gr-has [c :- &FnCtx k :- i64] :- bool
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr] (egr-has gr k))))

(defn fc-lfr [c :- &FnCtx] :- LoopFr
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr] (clone lfr))))

(defn fc-with-lfr [c :- FnCtx lfr :- LoopFr] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr l]
      (FnCtx tmpc blkc cur body pre sc ve gr lfr))))

; A snapshot of the three binding chains only (not the output state):
; `let` bodies, match arms and loop bodies must not leak their bindings
; past their extent, or a shadowed name's register is handed to code
; outside the scope (a dominance failure across sibling match arms, or a
; silently wrong read after a shadowing let).
(deftype EEnv (EEnv [sc :- EScTab ve :- EVcTab gr :- EGrTab]))

(defn fc-env-get [c :- &FnCtx] :- EEnv
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr] (EEnv (clone sc) (clone ve) (clone gr)))))

(defn fc-env-put [c :- FnCtx e :- EEnv] :- FnCtx
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (match e
        (EEnv [sc2 ve2 gr2] (FnCtx tmpc blkc cur body pre sc2 ve2 gr2 lfr))))))

; --- LLVM text helpers -----------------------------------------------------------

(defn mangle-raw [name :- str] :- str
  (if (= (count name) 0)
    ""
    (let [c (nth name 0 0)]
      (if (= c 45)
        (str "_" (mangle-raw (subs name 1 (count name))))
        (str (char->str c) (mangle-raw (subs name 1 (count name))))))))

; Number of leading ascii digits of s.
(defn digit-prefix-len [s :- str] :- i64
  (if (= (count s) 0)
    0
    (let [c (nth s 0 0)]
      (if (and (>= c 48) (<= c 57))
        (+ 1 (digit-prefix-len (subs s 1 (count s))))
        0))))

; True when tail is zero or more "_u" pairs then empty.
(defn reserved-u-tail [tail :- str] :- bool
  (if (= (count tail) 0)
    true
    (if (and (>= (count tail) 2) (= (nth tail 0 0) 95) (= (nth tail 1 0) 117))
      (reserved-u-tail (subs tail 2 (count tail)))
      false)))

; Does the - -> _ folded name collide with an emitter-minted local?
; Temps are t<n>, block labels are b<n>, the entry label is entry.
(defn reserved-local-shape [s :- str] :- bool
  (if (= s "entry")
    true
    (if (= (count s) 0)
      false
      (let [c (nth s 0 0)]
        (if (or (= c 116) (= c 98))
          (let [d (digit-prefix-len (subs s 1 (count s)))]
            (if (= d 0)
              false
              (reserved-u-tail (subs s (+ d 1) (count s)))))
          false)))))

(defn mangle [name :- str] :- str
  (let [m (mangle-raw (clone name))]
    (if (reserved-local-shape (clone m))
      (str (clone m) "_u")
      (clone m))))

(defn ll-scalar [t :- Ty] :- str
  (let [tag (ty-tag t)]
    (cond
      (= tag 0) "i64"
      (= tag 1) "i32"
      (= tag 2) "i8"
      (= tag 3) "i16"
      (= tag 4) "i8"
      (= tag 5) "i16"
      (= tag 6) "i32"
      (= tag 7) "i64"
      (= tag 8) "i64"
      (= tag 9) "double"
      (= tag 10) "float"
      (cg-fail-s "ll-scalar on non-scalar type"))))

(defn ll-ty [t :- Ty] :- str
  (let [tag (ty-tag t)]
    (cond
      (= tag 9) "double"
      (= tag 10) "float"
      (= tag 11) "i1"
      (= tag 12) "ptr"
      (= tag 15) (cg-fail-s "aggregate type in scalar position")
      (= tag 16) "ptr"
      (= tag 17) "ptr"
      (= tag 18) (cg-fail-s "unresolved type parameter")
      (< tag 12) (ll-scalar t)
      (cg-fail-s "ll-ty on map/set"))))

(defn elem-ll [el :- i64] :- str
  (if (= el 1) "double" "i64"))

(defn ll-loop-slot-ty [t :- Ty mdl :- &Mdl] :- str
  (let [tag (ty-tag t)]
    (cond
      (= tag 9) "double"
      (= tag 10) "float"
      (= tag 11) "i1"
      (= tag 12) "ptr"
      (< tag 12) (ll-scalar (clone t))
      ; S8: a boxed ADT loop variable's slot is the owning pointer; a
      ; vector's slot is the {ptr,len,cap} header
      (and (= tag 16) (= (md-owns-at mdl (ty-arg t)) 1)) "ptr"
      (= tag 15) "%VecI64"
      (cg-fail-s "loop variable of unsupported type"))))

; a vector loop variable's slot kind (the scalar path handles everything
; whose value is one machine word, including boxed ADT pointers)
(defn loop-slot-vec [t :- Ty] :- bool
  (= (ty-tag t) 15))

; --- ADT layout (the seed's field_slot_count / payload / offsets) ----------------

; Payload slots one field occupies: vectors 3; boxed (owning) ADT 1;
; inline ADT child its whole struct (1 + its payload); everything else 1.
(defn fs-count [f :- Ty owns :- &Sids adts :- &AdtTab] :- i64
  (let [tag (ty-tag f)]
    (cond
      (= tag 15) 3
      (= tag 16)
      (let [j (ty-arg f)]
        (if (= (sids-idx owns j) 1)
          1
          (+ 1 (fs-pay adts owns j))))
      1)))

(defn fs-pay [adts :- &AdtTab owns :- &Sids i :- i64] :- i64
  (fs-pay-vi adts owns i 0 0))

(defn fs-pay-vi [adts :- &AdtTab owns :- &Sids i :- i64 vi :- i64 best :- i64] :- i64
  (if (>= vi (vlist-depth (adts-variants-at adts i)))
    best
    (let [sum (fs-sum (varnt-fields-at adts i vi) owns adts 0)]
      (fs-pay-vi adts owns i (+ vi 1)
                 (if (> sum best) sum best)))))

(defn fs-sum [fs :- TyList owns :- &Sids adts :- &AdtTab acc :- i64] :- i64
  (match fs
    (TyCons [h rest]
      (fs-sum rest owns adts (+ acc (fs-count h owns adts))))
    (TyNil [] acc)))

; Total payload slots of ADT i (the [N x i64] of its struct).
(defn fs-total [adts :- &AdtTab owns :- &Sids i :- i64] :- i64
  (fs-pay adts owns i))

; Slot offset of field k in variant vi of ADT ai.
(defn fs-off [adts :- &AdtTab owns :- &Sids ai :- i64 vi :- i64 k :- i64] :- i64
  (fs-off-1 (varnt-fields-at adts ai vi) owns adts 0 k))

(defn fs-off-1 [fs :- TyList owns :- &Sids adts :- &AdtTab at :- i64 k :- i64] :- i64
  (if (= k 0)
    at
    (match fs
      (TyCons [h rest]
        ; k counts down the fields consumed; at accumulates their widths
        (fs-off-1 rest owns adts
                  (+ at (fs-count h owns adts)) (- k 1)))
      (TyNil [] at))))

; Slot count of field k in variant vi of ADT ai.
(defn fs-count-at [adts :- &AdtTab owns :- &Sids ai :- i64 vi :- i64 k :- i64] :- i64
  (fs-count (tys-idx (varnt-fields-at adts ai vi) k) owns adts))

(defn fs-field-ty [adts :- &AdtTab ai :- i64 vi :- i64 k :- i64] :- Ty
  (tys-idx (varnt-fields-at adts ai vi) k))

; --- f64 literals: shortest round-trip decimal ------------------------------------
;
; The seed formats Rust `{:e}`; the kernel computes a shortest decimal
; that `parse-f64`es back equal: fixed-point candidates with exact
; integer scaling for the common range, scientific candidates beyond
; it. LLVM requires the decimal point (else the constant reads as an
; integer).

(defn llvm-f64 [v :- f64] :- str
  (if (= v 0.0)
    "0.0"
    (let [a (abs v)
          fixed (f64-fixed a 0)]
      (if (> (count (clone fixed)) 0)
        (str (if (< v 0.0) "-" "") (clone fixed))
        (str (if (< v 0.0) "-" "") (f64-sci a))))))

; pow10 for small p (exact up to 10^22).
(defn f64-pow10 [p :- i64] :- f64
  (if (= p 0)
    1.0
    (* 10.0 (f64-pow10 (- p 1)))))

(defn f64-pow-i64 [p :- i64] :- i64
  (if (= p 0)
    1
    (* 10 (f64-pow-i64 (- p 1)))))

; Fixed-point: for p = 0.. the scaled floor/ceil are candidates; the
; first that parses back equal wins. Empty string = no hit before the
; i64 bound — fall through to scientific.
(defn f64-fixed [a :- f64 p :- i64] :- str
  (if (> p 17)
    ""
    (let [prod (* a (f64-pow10 p))]
      (if (> prod 9000000000000000000.0)
        ""
        (let [fl (i64 prod)
              lo (f64-fixed-try a p fl)
              hi (f64-fixed-try a p (+ fl 1))]
          (if (> (count (clone lo)) 0)
            (clone lo)
            (if (> (count (clone hi)) 0)
              (clone hi)
              (f64-fixed a (+ p 1)))))))))

(defn f64-fixed-try [a :- f64 p :- i64 m :- i64] :- str
  (let [text (f64-fixed-render m p)]
    (match (parse-f64 (clone text))
      (Some [back] (if (= back a) (clone text) ""))
      (None [] ""))))

; m with p decimal places, point placed p digits from the right; the
; digit run is padded so the integer part is never empty.
(defn f64-fixed-render [m :- i64 p :- i64] :- str
  (if (= p 0)
    (str m ".0")
    (let [digits (f64-digits m)
          padded (f64-pad (clone digits) (+ p 1))
          r (f64-rev (clone padded))
          n (count (clone r))]
      (str (subs (clone r) 0 (- n p)) "." (subs (clone r) (- n p) n)))))

; Decimal digits of m, low digit first ("0" renders "0").
(defn f64-digits [m :- i64] :- str
  (if (= m 0)
    "0"
    (str (char->str (+ 48 (- m (* 10 (/ m 10)))))
         (f64-digits (/ m 10)))))

; Right-extend a low-first digit run with zeros to at least width w
; (padding on the high end in reading order).
(defn f64-pad [digits :- str w :- i64] :- str
  (if (< (count (clone digits)) w)
    (f64-pad (str (clone digits) "0") w)
    (clone digits)))

(defn f64-rev [s :- str] :- str
  (if (= (count s) 0)
    ""
    (str (f64-rev (subs s 1 (count s))) (char->str (nth s 0 0)))))

; Scientific fallback for magnitudes outside the fixed-point window.
; Normalize by powers of ten, peel 17 significant digits, try
; truncation and round-up prefixes until one parses back equal.
(defn f64-sci [a :- f64] :- str
  (match (f64-norm a 0)
    (N2Res [m e] (f64-sci-try a m e 1 (f64-sci-digits m 0 17)))))

(deftype N2Res (N2Res [m :- f64 e :- i64]))

(defn f64-norm [a :- f64 e :- i64] :- N2Res
  (if (>= a 10.0)
    (f64-norm (/ a 10.0) (+ e 1))
    (if (< a 1.0)
      (f64-norm (* a 10.0) (- e 1))
      (N2Res a e))))

; The first `left` significant digits of m as an integer.
(defn f64-sci-digits [m :- f64 k :- i64 left :- i64] :- i64
  (if (= left 0)
    k
    (let [d (i64 m)
          frac (* (- m (f64 d)) 10.0)]
      (f64-sci-digits frac (+ (* k 10) d) (- left 1)))))

(defn f64-sci-try [a :- f64 m :- f64 e :- i64 n :- i64 all :- i64] :- str
  (if (> n 17)
    ; Best effort: the full 17-digit truncation.
    (f64-sci-render all e 17)
    (let [dv (f64-pow-i64 (- 17 n))
          pre (/ all dv)
          t1 (f64-sci-check a (f64-sci-render pre e n))
          t2 (f64-sci-check a (f64-sci-render (+ pre 1) e n))]
      (if (> (count (clone t1)) 0)
        (clone t1)
        (if (> (count (clone t2)) 0)
          (clone t2)
          (f64-sci-try a m e (+ n 1) all))))))

(defn f64-sci-check [a :- f64 text :- str] :- str
  (match (parse-f64 (clone text))
    (Some [back] (if (= back a) (clone text) ""))
    (None [] "")))

; digits = d1 d2 ... dn as an integer; value = d1.d2...dn e exponent.
(defn f64-sci-render [digits :- i64 e :- i64 n :- i64] :- str
  (let [s (f64-digits digits)
        head (char->str (nth (clone s) 0 0))
        rest (subs (clone s) 1 (count (clone s)))
        rest2 (if (= (count (clone rest)) 0) "0" rest)]
    (str head "." rest2 "e" e)))

; --- failure (the seed's panic, as a loud exit) -----------------------------------

(defn cg-fail-i [msg :- str] :- i64
  (do (print-string (str "cato1: codegen " msg)) (exit 70)))

(defn cg-fail-s [msg :- str] :- str
  (do (cg-fail-i (clone msg)) ""))

; --- call signature table -----------------------------------------------------------

; name sid -> (params, ret) for every callable defn: plain, extern, and
; mono instances. Prepending puts give last-defn-wins, the seed's map
; insert order.
(deftype ESig (ESig [params :- TyList ret :- Ty]))
(deftype ESigTab (ESTNil) (ESTCons [k :- i64 v :- ESig t :- ESigTab]))

(defn sigs-build [ds :- Defns acc :- ESigTab] :- ESigTab
  (match ds
    (DCons [h t]
      (match h
        (Defn [name params ret isextern body rb]
          (sigs-build t
                      (ESTCons name (ESig (pl-tylist params (TyNil)) ret) acc)))))
    (DNil [] (clone acc))))

(defn pl-tylist [ps :- PList acc :- TyList] :- TyList
  (match ps
    (PCons [h t]
      (match h
        (Param [name ty _pb] (pl-tylist t (TyCons ty acc)))))
    (PNil [] (tys-rev acc (TyNil)))))

(defn sigs-lookup [ss :- &ESigTab k :- i64] :- ESig
  (match ss
    (ESTCons [ek ev next] (if (= ek k) (clone ev) (sigs-lookup next k)))
    (ESTNil [] (ESig (TyNil) (t-none)))))

; --- the emission bundle ---------------------------------------------------------

; FnCtx + Mdl + the call-signature table thread together through every
; emitter call; results carry the bundle back out.
(deftype Emit (Emit [c :- FnCtx mdl :- Mdl sigs :- ESigTab]))

(defn em-new [tab :- i64 adts :- AdtTab owns :- Sids csigs :- Sigs
              sigs :- ESigTab] :- Emit
  (Emit (fn-new) (md-new tab adts owns csigs) sigs))

(defn em-env-get [st :- &Emit] :- EEnv
  (match st (Emit [c mdl sigs] (fc-env-get c))))

; Read through the emission bundle without copying the module. Matching an
; `Emit` and cloning its `Mdl` deep-copies the globals string buffer, the ADT
; table and the signature table to answer one name or one ownership bit.
(defn em-boxed-at [st :- &Emit adt :- i64] :- i64
  (match st (Emit [c m s] (md-owns-at m adt))))

(defn em-adt-name [st :- &Emit adt :- i64] :- str
  (match st (Emit [c m s] (md-adt-name m adt))))

(defn em-env-put [st :- Emit e :- EEnv] :- Emit
  (match st (Emit [c mdl sigs] (Emit (fc-env-put c e) mdl sigs))))



; --- multi-instruction minting ----------------------------------------------------
;
; `em-ins2/3/4` mint one temp per line and substitute placeholders:
; `~` = this line's temp, `^1`/`^2`/`^3` = the previous lines' temps
; (1 = immediately previous). One match per instruction GROUP instead
; of one per instruction.

(deftype ET2Res (ET2Res [st :- Emit a :- str b :- str]))
(deftype ET3Res (ET3Res [st :- Emit a :- str b :- str c :- str]))
(deftype ET4Res (ET4Res [st :- Emit a :- str b :- str c :- str d :- str]))

(defn sub-place [s :- str own :- str p1 :- str p2 :- str p3 :- str] :- str
  (if (= (count s) 0)
    ""
    (let [c (nth s 0 0)]
      (cond
        (= c 126) (str (char->str c) (sub-place (subs s 1 (count s)) own p1 p2 p3))
        (= c 94)
        (let [d (nth s 1 0)]
          (cond
            (= d 49) (str p1 (sub-place (subs s 2 (count s)) own p1 p2 p3))
            (= d 50) (str p2 (sub-place (subs s 2 (count s)) own p1 p2 p3))
            (= d 51) (str p3 (sub-place (subs s 2 (count s)) own p1 p2 p3))
            (str (char->str c) (sub-place (subs s 1 (count s)) own p1 p2 p3))))
        (str (char->str c) (sub-place (subs s 1 (count s)) own p1 p2 p3))))))

(defn em-ins2 [st :- Emit b1 :- str b2 :- str] :- ET2Res
  (match (em-ins st b1)
    (ETRes [st1 t1]
      (match (em-ins st1 (sub-place b2 "" t1 "" ""))
        (ETRes [st2 t2] (ET2Res st2 t1 t2))))))

(defn em-ins3 [st :- Emit b1 :- str b2 :- str b3 :- str] :- ET3Res
  (match (em-ins st b1)
    (ETRes [st1 t1]
      (match (em-ins st1 (sub-place b2 "" t1 "" ""))
        (ETRes [st2 t2]
          (match (em-ins st2 (sub-place b3 "" t2 t1 ""))
            (ETRes [st3 t3] (ET3Res st3 t1 t2 t3))))))))

(defn em-ins4 [st :- Emit b1 :- str b2 :- str b3 :- str b4 :- str] :- ET4Res
  (match (em-ins st b1)
    (ETRes [st1 t1]
      (match (em-ins st1 (sub-place b2 "" t1 "" ""))
        (ETRes [st2 t2]
          (match (em-ins st2 (sub-place b3 "" t2 t1 ""))
            (ETRes [st3 t3]
              (match (em-ins st3 (sub-place b4 "" t3 t2 t1))
                (ETRes [st4 t4] (ET4Res st4 t1 t2 t3 t4))))))))))
; scalars.cato — S7: int/float/bool emission contexts, casts, if/match,
; loop/recur — the port of the seed emitter's exprs.rs (emit_int),
; exprs_flow.rs (emit_float, loop/recur) and the bool halves. Dispatch
; and instruction selection mirror the seed arm for arm.
;
; Instruction groups mint through em-ins/em-ins2/3/4 (state.cato): one
; match per group instead of one per instruction; `~` is a line's own
; temp, `^1`/`^2`/`^3` the previous lines' temps. Void instructions
; (stores, br, calls) go through em-line — never em-ins.

; --- failures (impossible states; loud exit) ---------------------------------

(defn sf [st :- Emit msg :- str] :- ESRes
  (do (cg-fail-i (clone msg)) (ESRes st "")))

(defn vf [st :- Emit msg :- str] :- EVRes
  (do (cg-fail-i (clone msg)) (EVRes st "" "" -1)))

(defn uf [st :- Emit msg :- str] :- EURes
  (do (cg-fail-i (clone msg)) (EURes st)))

; --- Emit plumbing ---------------------------------------------------------------

(defn em-temp [st :- Emit] :- ETRes
  (match st
    (Emit [c mdl sigs]
      (match (fc-temp c)
        (EFcT [c2 v] (ETRes (Emit c2 mdl sigs) v))))))

(defn em-blk [st :- Emit] :- ETRes
  (match st
    (Emit [c mdl sigs]
      (match (fc-block c)
        (EFcB [c2 v] (ETRes (Emit c2 mdl sigs) v))))))

(defn em-blk2 [st :- Emit] :- ET2Res
  (match (em-blk st)
    (ETRes [st1 b1]
      (match (em-blk st1)
        (ETRes [st2 b2] (ET2Res st2 b1 b2))))))

(defn em-blk3 [st :- Emit] :- ET3Res
  (match (em-blk st)
    (ETRes [st1 b1]
      (match (em-blk st1)
        (ETRes [st2 b2]
          (match (em-blk st2)
            (ETRes [st3 b3] (ET3Res st3 b1 b2 b3))))))))

(defn em-line [st :- Emit s :- str] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit (fc-line c s) mdl sigs))))

(defn em-open [st :- Emit label :- str] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit (fc-open c label) mdl sigs))))

(defn em-decl [st :- Emit line :- str] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit c (md-ensure mdl line) sigs))))

(defn em-decl-line [st :- Emit line :- str decl :- str] :- Emit
  (em-decl (em-line st line) decl))

(defn em-cur [st :- &Emit] :- str
  (match st
    (Emit [c mdl sigs] (fc-cur-of c))))

(defn em-sc-put [st :- Emit k :- i64 r :- str ty :- Ty] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit (fc-sc-put c k r ty) mdl sigs))))

(defn em-gr-put [st :- Emit k :- i64 slot :- str el :- i64] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit (fc-gr-put c k slot el) mdl sigs))))

(defn em-vc-put [st :- Emit k :- i64 p :- str l :- str el :- i64] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit (fc-vc-put c k p l el) mdl sigs))))

(defn em-pre [st :- Emit s :- str] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit (fc-pre-line c s) mdl sigs))))

(defn em-with-lfr [st :- Emit lfr :- LoopFr] :- Emit
  (match st
    (Emit [c mdl sigs] (Emit (fc-with-lfr c lfr) mdl sigs))))

(defn fc-cur-of [c :- &FnCtx] :- str
  (match c (FnCtx [tmpc blkc cur body pre sc ve gr lfr] (clone cur))))

(defn str-rep [s :- str t :- str] :- str
  (if (= (count s) 0)
    ""
    (if (= (nth s 0 0) 126)
      (str t (str-rep (subs s 1 (count s)) t))
      (str (char->str (nth s 0 0)) (str-rep (subs s 1 (count s)) t)))))

(defn em-ins [st :- Emit body :- str] :- ETRes
  (match (em-temp st)
    (ETRes [st2 t]
      (ETRes (em-line st2 (str-rep body t)) t))))

; --- chains -----------------------------------------------------------------------

; Cold path: the caller wants the element as an owned expression, so a
; borrowed list has to hand back a copy.
(defn hes-first [ks :- HExprs] :- HExpr
  (match ks
    (HECons [kid next] kid)
    (HENil [] (HConstI64 0))))

(defn hes-rest [ks :- HExprs] :- HExprs
  (match ks
    (HECons [kid next] next)
    (HENil [] (HENil))))

(defn hes-last [es :- HExprs] :- HExpr
  (match es
    (HECons [kid next]
      (if (hes-null next) kid (hes-last next)))
    (HENil [] (HConstI64 0))))

; --- typed dispatch --------------------------------------------------------------

(defn emit-typed [e :- HExpr ty :- Ty st :- Emit] :- ESRes
  (let [tag (ty-tag ty)]
    (cond
      (= tag 9) (emit-float e st)
      (= tag 10) (emit-float e st)
      (= tag 11) (emit-bool e st)
      (= tag 12) (emit-str-val e st)
      (= tag 16) (emit-adt e st)
      (= tag 15)
      (match (emit-vec-pair e st)
        (EVRes [st1 p l el]
          (match (em-ins3 st1
                   (str "~ = insertvalue %VecI64 undef, ptr " p ", 0")
                   (str "~ = insertvalue %VecI64 ^1, i64 " l ", 1")
                   (str "~ = insertvalue %VecI64 ^1, i64 " l ", 2"))
            (ET3Res [st2 s0 s1 s2] (ESRes st2 s2)))))
      (= tag 17) (sf st "control flow cannot produce an aggregate")
      (= tag 13) (sf st "control flow cannot produce an aggregate")
      (= tag 14) (sf st "control flow cannot produce an aggregate")
      (< tag 12) (emit-int e st)
      (sf st "emit-typed on unresolved type"))))

; --- casts -------------------------------------------------------------------------

(defn is-int-tag [tag :- i64] :- bool (< tag 9))
(defn is-uint-tag [tag :- i64] :- bool (and (>= tag 4) (< tag 9)))
(defn is-float-tag [tag :- i64] :- bool (or (= tag 9) (= tag 10)))

(defn int-bits [tag :- i64] :- i64
  (cond
    (= tag 1) 32
    (= tag 2) 8
    (= tag 3) 16
    (= tag 4) 8
    (= tag 5) 16
    (= tag 6) 32
    64))

(defn emit-cast [r :- str from :- Ty to :- Ty st :- Emit] :- ESRes
  (let [ft (ty-tag from)
        dt (ty-tag to)]
    (if (= ft dt)
      (ESRes st (clone r))
      (if (and (is-int-tag ft) (is-int-tag dt))
        (cond
          (= (int-bits ft) (int-bits dt)) (ESRes st (clone r))
          (> (int-bits ft) (int-bits dt))
          (match (em-ins st (str "  ~ = trunc " (ll-scalar from) " " r " to " (ll-scalar to)))
            (ETRes [st2 t] (ESRes st2 t)))
          (is-uint-tag ft)
          (match (em-ins st (str "  ~ = zext " (ll-scalar from) " " r " to " (ll-scalar to)))
            (ETRes [st2 t] (ESRes st2 t)))
          (match (em-ins st (str "  ~ = sext " (ll-scalar from) " " r " to " (ll-scalar to)))
            (ETRes [st2 t] (ESRes st2 t))))
        (if (and (is-int-tag ft) (is-float-tag dt))
          (match (em-ins st (str "  ~ = " (if (is-uint-tag ft) "uitofp" "sitofp") " "
                                  (ll-scalar from) " " r " to " (ll-scalar to)))
            (ETRes [st2 t] (ESRes st2 t)))
          (if (and (is-float-tag ft) (is-int-tag dt))
            (match (em-ins st (str "  ~ = " (if (is-uint-tag dt) "fptoui" "fptosi") " "
                                    (ll-scalar from) " " r " to " (ll-scalar to)))
              (ETRes [st2 t] (ESRes st2 t)))
            (match (em-ins st (str "  ~ = " (if (= dt 10) "fptrunc" "fpext") " "
                                    (ll-scalar from) " " r " to " (ll-scalar to)))
              (ETRes [st2 t] (ESRes st2 t)))))))))

; --- static width (the seed's static_int_width) ---------------------------------

(defn static-int-width [e :- &HExpr st :- Emit] :- Ty
  (match e
    (HConstI64 [v] (t-i64))
    (HConstF64 [v] (t-f64))
    (HConstB [v] (t-bool))
    ; Ty is a flat two-word value: cloning a borrowed field costs nothing.
    (HICast [x from to] (clone to))
    (HBinW [op a b ty] (clone ty))
    (HBinF [op a b] (t-f32))
    (HAbs [x ty] (clone ty))
    (HMin [a b ty] (clone ty))
    (HMax [a b ty] (clone ty))
    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c v)]
            (match rv
              (RegVal [r ty]
                (if (= (ty-tag ty) 19) (t-i64) ty)))))))
    (HCall [name args]
      (match st
        (Emit [c mdl sigs]
          (let [sg (sigs-lookup sigs name)]
            (match sg
              (ESig [params ret]
                (if (= (ty-tag ret) 19) (t-i64) ret)))))))
    (_ (t-i64))))

; --- pin (the seed's pin_value: fresh register for constants) ---------------------

(defn em-pin [v :- str llty :- str st :- Emit] :- ESRes
  (if (= (nth v 0 0) 37)
    (ESRes st v)
    (cond
      (= llty "double")
      (match (em-ins st (str "  ~ = fadd double " v ", 0.000000e+00"))
        (ETRes [st2 t] (ESRes st2 t)))
      (= llty "i1")
      (match (em-ins st (str "  ~ = xor i1 " v ", false"))
        (ETRes [st2 t] (ESRes st2 t)))
      (match (em-ins st (str "  ~ = add i64 " v ", 0"))
        (ETRes [st2 t] (ESRes st2 t))))))

; --- small int-context helpers ------------------------------------------------------

(defn zext-i64 [b :- str st :- Emit] :- ESRes
  (match (em-ins st (str "  ~ = zext i1 " b " to i64"))
    (ETRes [st2 t] (ESRes st2 t))))

(defn abs-em [v :- str llty :- str st :- Emit] :- ESRes
  (match (em-ins3 st
           (str "  ~ = sub " llty " 0, " v)
           (str "  ~ = icmp slt " llty " " v ", 0")
           (str "  ~ = select i1 ^1, " llty " ^2, " llty " " v))
    (ET3Res [st1 neg lt sel] (ESRes st1 sel))))

(defn minmax-int [a :- HExpr b :- HExpr cmp :- str llty :- str st :- Emit] :- ESRes
  (match (emit-int a st)
    (ESRes [st1 av]
      (match (emit-int b st1)
        (ESRes [st2 bv]
          (match (em-ins2 st2
                   (str "  ~ = icmp " cmp " " llty " " av ", " bv)
                   (str "  ~ = select i1 ^1, " llty " " av ", " llty " " bv))
            (ET2Res [st3 lt sel] (ESRes st3 sel) )))))))

(defn minmax-f64 [a :- HExpr b :- HExpr cmp :- str st :- Emit] :- ESRes
  (match (emit-float a st)
    (ESRes [st1 av]
      (match (emit-float b st1)
        (ESRes [st2 bv]
          (match (em-ins2 st2
                   (str "  ~ = fcmp " cmp " double " av ", " bv)
                   (str "  ~ = select i1 ^1, double " av ", double " bv))
            (ET2Res [st3 lt sel] (ESRes st3 sel) )))))))

(defn print-f64-stmt [arg :- &HExpr st :- Emit ret :- str] :- ESRes
  (match (emit-float (clone arg) st)
    (ESRes [st1 v]
      (let [w (static-int-width arg (clone st1))]
        (if (= (ty-tag w) 10)
          (match (em-ins st1 (str "  ~ = fpext float " v " to double"))
            (ETRes [st2 vd]
              (ESRes (em-line st2 (str "  call void @cato_print_f64(double " vd ")")) ret)))
          (ESRes (em-line st1 (str "  call void @cato_print_f64(double " v ")")) ret))))))

; The seed widens print-i64's arg from its static width; same-width and
; bool cases reuse the register as-is (the bool read already widened).
(defn emit-int-widened [e :- HExpr st :- Emit] :- ESRes
  (let [w (static-int-width e (clone st))
        tag (ty-tag w)]
    (if (or (= tag 9) (= tag 10))
      (match (emit-float e st)
        (ESRes [st1 v]
          (match (em-ins st1 (str "  ~ = fptosi " (ll-scalar w) " " v " to i64"))
            (ETRes [st2 t] (ESRes st2 t)))))
      (match (emit-int e st)
        (ESRes [st1 v]
          (cond
            (or (= tag 0) (= tag 7) (= tag 8) (= tag 11)) (ESRes st1 v)
            (is-uint-tag tag)
            (match (em-ins st1 (str "  ~ = zext " (ll-scalar w) " " v " to i64"))
              (ETRes [st2 t] (ESRes st2 t)))
            (match (em-ins st1 (str "  ~ = sext " (ll-scalar w) " " v " to i64"))
              (ETRes [st2 t] (ESRes st2 t)))))))))

; --- comparison op names ------------------------------------------------------------

(defn cmp-op-name [op :- i64 ty :- Ty f :- bool] :- str
  (if f
    (cond
      (= op 0) "oeq"
      (= op 1) "une"
      (= op 2) "olt"
      (= op 3) "ogt"
      (= op 4) "ole"
      "oge")
    (cond
      (= op 0) "eq"
      (= op 1) "ne"
      (and (= op 2) (is-uint-tag (ty-tag ty))) "ult"
      (and (= op 3) (is-uint-tag (ty-tag ty))) "ugt"
      (and (= op 4) (is-uint-tag (ty-tag ty))) "ule"
      (and (= op 5) (is-uint-tag (ty-tag ty))) "uge"
      (= op 2) "slt"
      (= op 3) "sgt"
      (= op 4) "sle"
      "sge")))

; --- int context -----------------------------------------------------------------

(defn emit-int [e :- HExpr st :- Emit] :- ESRes
  (match e
    (HConstI64 [v] (ESRes st (str v)))

    (HConstF64 [v] (sf st "ConstF64 in i64 context"))

    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c v)]
            (match rv
              (RegVal [r ty]
                (cond
                  (= (ty-tag ty) 19)
                  (if (fc-vc-has c v)
                    (match (fc-vc-get c v)
                      (VecVal [p l el] (ESRes st l)))
                    (sf st "unknown var in int context"))
                  (= (ty-tag ty) 11)
                  (match (em-ins st (str "  ~ = zext i1 " r " to i64"))
                    (ETRes [st2 t] (ESRes st2 t)))
                  (ESRes st r))))))))

    (HConstB [v] (match (emit-bool e st) (ESRes [st1 b] (zext-i64 b st1))))
    (HCmpW [op a b ty] (match (emit-bool e st) (ESRes [st1 b] (zext-i64 b st1))))
    (HAnd [a b] (match (emit-bool e st) (ESRes [st1 b] (zext-i64 b st1))))
    (HOr [a b] (match (emit-bool e st) (ESRes [st1 b] (zext-i64 b st1))))
    (HNot [x] (match (emit-bool e st) (ESRes [st1 b] (zext-i64 b st1))))
    (HStrCmp [pol a b] (match (emit-bool e st) (ESRes [st1 b] (zext-i64 b st1))))
    (HStrOrd [op a b] (match (emit-bool e st) (ESRes [st1 b] (zext-i64 b st1))))

    (HBinW [op a b ty]
      (match (emit-int (clone a) st)
        (ESRes [st1 av]
          (match (emit-int (clone b) st1)
            (ESRes [st2 bv]
              (let [opn (cond
                          (= op 0) "add"
                          (= op 1) "sub"
                          (= op 2) "mul"
                          (if (is-uint-tag (ty-tag ty)) "udiv" "sdiv"))]
                (match (em-ins st2 (str "  ~ = " opn " " (ll-scalar ty) " " av ", " bv))
                  (ETRes [st3 t] (ESRes st3 t)))))))))

    (HICast [x from to]
      (match (emit-typed (clone x) (clone from) st)
        (ESRes [st1 v] (emit-cast v (clone from) (clone to) st1))))

    (HIf [c t e ty] (emit-if-node (clone c) (clone t) (clone e) (clone ty) st))

    (HSeq [es]
      (let [st2 (emit-stmts (clone es) st)]
        (ESRes st2 "0")))

    (HLet [binds body frees]
      (match (emit-let (clone binds) st)
        (EURes [st2]
          (match (emit-int (clone body) st2)
            (ESRes [st3 v]
              (match (emit-frees (clone frees) st3)
                (EURes [st4] (ESRes st4 v))))))))

    (HAbs [x ty]
      (match (emit-int (clone x) st)
        (ESRes [st1 v]
          (if (= (ty-tag ty) 1)
            (abs-em v "i32" st1)
            (abs-em v "i64" st1)))))

    (HMin [a b ty]
      (if (= (ty-tag ty) 1)
        (minmax-int (clone a) (clone b) "slt" "i32" st)
        (minmax-int (clone a) (clone b) "slt" "i64" st)))

    (HMax [a b ty]
      (if (= (ty-tag ty) 1)
        (minmax-int (clone a) (clone b) "sgt" "i32" st)
        (minmax-int (clone a) (clone b) "sgt" "i64" st)))

    (HLoop [binds ty body] (emit-loop-node (clone binds) (clone ty) (clone body) st))

    (HMatch [scrut arms ty] (emit-match-node scrut (clone arms) (clone ty) st))

    (HCtor [adt variant args]
      (match (emit-adt e st)
        (ESRes [st2 v] (ESRes st2 "0"))))

    (HClone [x] (emit-int (clone x) st))

    (HDrop [x] (ESRes st "0"))

    (HCount [x] (emit-count (clone x) st))

    (HStrNth [s idx res]
      (if (= (ty-tag res) 19)
        (emit-strnth-raw (clone s) (clone idx) st)
        (sf st "Option nth in i64 context")))

    (HGet [src idx dflt ty res]
      (if (and (= (ty-tag ty) 0) (= (ty-tag res) 19))
        (emit-get (clone src) (clone idx) (clone dflt) (clone ty) st)
        (sf st "get returning non-i64 in i64 context")))

    (HSpit [path data]
      (match (emit-str-val (clone path) st)
        (ESRes [st1 pv]
          (match (emit-str-val (clone data) st1)
            (ESRes [st2 dv]
              (ESRes (em-decl-line st2 (str "  call void @cato_spit(ptr " pv ", ptr " dv ")")
                    "declare void @cato_spit(ptr, ptr)")
                    "0"))))))

    (HExit [x]
      (match (emit-int (clone x) st)
        (ESRes [st2 v]
          (ESRes (em-decl-line st2 (str "  call void @cato_exit(i64 " v ")")
                "declare void @cato_exit(i64)")
                "0"))))

    (HCall [name args]
      (cond
        (= name (s-printf64)) (print-f64-stmt (asts-first (clone args)) st "0")
        (= name (s-printi64))
        (match (emit-int-widened (asts-first (clone args)) st)
          (ESRes [st1 v64]
            (ESRes (em-line st1 (str "  call void @cato_print_i64(i64 " v64 ")")) "0")))
        (= name (s-printstring))
        (match (emit-str-val (asts-first (clone args)) st)
          (ESRes [st1 v]
            (ESRes (em-line st1 (str "  call void @cato_print_string(ptr " v ")")) "0")))
        (match (call-user name (clone args) st)
          (ESRes [st2 v]
            (match st2
              (Emit [c2 mdl2 sigs2]
                (let [sg (sigs-lookup sigs2 name)]
                  (match sg
                    (ESig [params ret]
                      (if (= (ty-tag ret) 11)
                        (match (em-ins st2 (str "  ~ = zext i1 " v " to i64"))
                          (ETRes [st3 t] (ESRes st3 t)))
                        (ESRes st2 v)))))))))))

    (HClosureCall [f args sig] (emit-closure-call f (clone args) sig st))

    (HRecur [_] (sf st "recur outside loop (validation bug)"))
    (HVecLit [el vals] (sf st "vec literal in i64 context"))
    (HStrLit [v] (sf st "string literal in i64 context"))
    (HStrCat [args] (sf st "str result must be bound with let"))
    (HSubs [s a b] (sf st "heap value must be bound with let"))
    (HSplit [s sep] (sf st "heap value must be bound with let"))
    (HJoin [sep xs] (sf st "heap value must be bound with let"))
    (HCharStr [e] (sf st "heap value must be bound with let"))
    (HToStr [e ty] (sf st "string result must be bound with let"))
    (HSlurp [p] (sf st "string result must be bound with let"))
    (HArgs [] (sf st "args must be bound with let"))
    (HParseNum [s int res] (sf st "Option result must be bound with let"))
    (HConj [v x el inplace] (sf st "heap vector value must be bound with let"))
    (HClosure [sig mangled params caps body] (sf st "closure value must be bound with let"))
    (HBinF [op a b] (sf st "f32 arithmetic in i64 context"))))

; --- float context -----------------------------------------------------------------

(defn emit-float [e :- HExpr st :- Emit] :- ESRes
  (match e
    (HConstF64 [v] (ESRes st (llvm-f64 v)))

    (HConstI64 [v]
      (match (em-ins st (str "  ~ = sitofp i64 " v " to double"))
        (ETRes [st2 t] (ESRes st2 t))))

    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c v)]
            (match rv (RegVal [r ty] (ESRes st r)))))))

    (HBinW [op a b ty]
      (match (emit-float (clone a) st)
        (ESRes [st1 av]
          (match (emit-float (clone b) st1)
            (ESRes [st2 bv]
              (let [opn (cond
                          (= op 0) "fadd"
                          (= op 1) "fsub"
                          (= op 2) "fmul"
                          "fdiv")]
                (match (em-ins st2 (str "  ~ = " opn " " (ll-scalar ty) " " av ", " bv))
                  (ETRes [st3 t] (ESRes st3 t)))))))))

    (HBinF [op a b]
      (match (emit-typed (clone a) (t-f32) st)
        (ESRes [st1 av]
          (match (emit-typed (clone b) (t-f32) st1)
            (ESRes [st2 bv]
              (let [opn (cond
                          (= op 0) "fadd"
                          (= op 1) "fsub"
                          (= op 2) "fmul"
                          "fdiv")]
                (match (em-ins st2 (str "  ~ = " opn " float " av ", " bv))
                  (ETRes [st3 t] (ESRes st3 t)))))))))

    (HICast [x from to]
      (match (emit-typed (clone x) (clone from) st)
        (ESRes [st1 v] (emit-cast v (clone from) (clone to) st1))))

    (HIf [c t e ty] (emit-if-node (clone c) (clone t) (clone e) (clone ty) st))

    (HSeq [es]
      (match (emit-stmts-ex-last (clone es) st)
        (ELRes [st2 last] (emit-float last st2))))

    (HLet [binds body frees]
      (match (emit-let (clone binds) st)
        (EURes [st2]
          (match (emit-float (clone body) st2)
            (ESRes [st3 v]
              (match (emit-frees (clone frees) st3)
                (EURes [st4] (ESRes st4 v))))))))

    (HAbs [x ty]
      (match (emit-float (clone x) st)
        (ESRes [st1 v]
          (match (em-ins3 st1
                   (str "  ~ = fneg double " v)
                   (str "  ~ = fcmp olt double " v ", 0.000000e+00")
                   (str "  ~ = select i1 ^1, double ^2, double " v))
            (ET3Res [st2 neg lt sel] (ESRes st2 sel))))))

    (HMin [a b ty] (minmax-f64 (clone a) (clone b) "olt" st))
    (HMax [a b ty] (minmax-f64 (clone a) (clone b) "ogt" st))

    (HMatch [scrut arms ty] (emit-match-node scrut (clone arms) (clone ty) st))

    (HCtor [adt variant args]
      (match (emit-adt e st)
        (ESRes [st2 v] (ESRes st2 "0.0"))))

    (HClone [x] (emit-float (clone x) st))

    (HGet [src idx dflt ty res]
      (if (= (ty-tag ty) 9)
        (emit-get (clone src) (clone idx) (clone dflt) (clone ty) st)
        (sf st "get returning non-f64 in f64 context")))

    (HCall [name args]
      (if (= name (s-printf64))
        (print-f64-stmt (asts-first (clone args)) st "0.0")
        (call-user name (clone args) st)))

    (HLoop [binds ty body] (emit-loop-node (clone binds) (clone ty) (clone body) st))

    (_ (sf st "unsupported node in f64 context"))))

; --- bool context ------------------------------------------------------------------

(defn emit-bool [e :- HExpr st :- Emit] :- ESRes
  (match e
    (HConstB [v] (ESRes st (if (= v 1) "true" "false")))

    (HCmpW [op a b ty]
      (let [f (is-float-tag (ty-tag ty))]
        (match (if f (emit-float a st) (emit-int a st))
          (ESRes [st1 av]
            (match (if f (emit-float b st1) (emit-int b st1))
              (ESRes [st2 bv]
                (match (em-ins st2 (str "  ~ = " (if f "fcmp" "icmp") " "
                                        (cmp-op-name op ty f) " " (ll-scalar ty) " " av ", " bv))
                  (ETRes [st3 t] (ESRes st3 t)))))))))

    (HStrCmp [pol a b]
      (match (emit-str-val a st)
        (ESRes [st1 av]
          (match (emit-str-val b st1)
            (ESRes [st2 bv]
              (match (em-ins2 st2
                       (str "  ~ = call i32 @strcmp(ptr " av ", ptr " bv ")")
                       (str "  ~ = icmp " (if (= pol 1) "eq" "ne") " i32 ^1, 0"))
                (ET2Res [st3 sc t]
                  (ESRes (em-decl st3 "declare i32 @strcmp(ptr, ptr)") t) )))))))

    (HStrOrd [op a b]
      (match (emit-str-val a st)
        (ESRes [st1 av]
          (match (emit-str-val b st1)
            (ESRes [st2 bv]
              (match (em-ins2 st2
                       (str "  ~ = call i32 @strcmp(ptr " av ", ptr " bv ")")
                       (str "  ~ = icmp " (cond
                                            (= op 2) "slt"
                                            (= op 3) "sgt"
                                            (= op 4) "sle"
                                            "sge") " i32 ^1, 0"))
                (ET2Res [st3 sc t]
                  (ESRes (em-decl st3 "declare i32 @strcmp(ptr, ptr)") t) )))))))

    (HAnd [a b] (andor-node a b true st))
    (HOr [a b] (andor-node a b false st))

    (HNot [x]
      (match (emit-bool x st)
        (ESRes [st1 v]
          (match (em-ins st1 (str "  ~ = xor i1 " v ", true"))
            (ETRes [st2 t] (ESRes st2 t))))))

    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c v)]
            (match rv (RegVal [r ty] (ESRes st r)))))))

    (HIf [c t e ty] (emit-if-node c t e ty st))

    (HMatch [scrut arms ty] (emit-match-node scrut arms ty st))

    (HLoop [binds ty body] (emit-loop-node binds ty body st))

    (HLet [binds body frees]
      (match (emit-let binds st)
        (EURes [st2]
          (match (emit-bool body st2)
            (ESRes [st3 v]
              (match (emit-frees frees st3)
                (EURes [st4] (ESRes st4 v))))))))

    (HSeq [es]
      (match (emit-stmts-ex-last es st)
        (ELRes [st2 last] (emit-bool last st2))))

    (HCall [name args]
      (if (= name (s-evenq))
        (match (emit-int (asts-first args) st)
          (ESRes [st1 v]
            (match (em-ins2 st1
                     (str "  ~ = and i64 " v ", 1")
                     (str "  ~ = icmp eq i64 ^1, 0"))
              (ET2Res [st2 p t] (ESRes st2 t) ))))
        (call-user name args st)))

    (_ (sf st "expected a boolean expression"))))

; Short-circuit: the parent block phis the neutral constant; the rhs
; block computes the other operand.
(defn andor-node [a :- HExpr b :- HExpr is-and :- bool st :- Emit] :- ESRes
  (match (emit-bool a st)
    (ESRes [st1 la]
      (let [parent (em-cur st1)]
        (match (em-blk2 st1)
          (ET2Res [st2 rhs merged]
            (let [st3 (em-line st2
                        (if is-and
                          (str "  br i1 " la ", label %" rhs ", label %" merged)
                          (str "  br i1 " la ", label %" merged ", label %" rhs)))
                  st4 (em-open st3 rhs)]
              (match (emit-bool b st4)
                (ESRes [st5 rb]
                  (let [bp (em-cur st5)
                        st6 (em-line st5 (str "  br label %" merged))
                        st7 (em-open st6 merged)]
                    (match (em-ins st7 (str "  ~ = phi i1 [ " (if is-and "false" "true") ", %" parent " ], [ " rb ", %" bp " ]"))
                      (ETRes [st8 res] (ESRes st8 res))))))) ))))))

; --- statement walks ------------------------------------------------------------------

(deftype ELRes (ELRes [st :- Emit last :- HExpr]))

(defn emit-stmts [es :- HExprs st :- Emit] :- Emit
  (match es
    (HENil [] st)
    (HECons [kid next]
      (match (emit-stmt kid st)
        (EURes [st2] (emit-stmts next st2))))))

(defn emit-stmts-ex-last [es :- HExprs st :- Emit] :- ELRes
  (match es
    (HECons [kid next]
      (if (hes-null next)
        (ELRes st kid)
        (match (emit-stmt kid st)
          (EURes [st2] (emit-stmts-ex-last next st2)))))
    (HENil [] (do (cg-fail-i "empty seq") (ELRes st (HConstI64 0))))))

; --- if node -------------------------------------------------------------------------

(defn emit-if-node [cond :- HExpr then :- HExpr els :- HExpr ty :- Ty st :- Emit] :- ESRes
  (let [env0 (em-env-get st)]
  (match (emit-bool cond st)
    (ESRes [st1 lc]
      (match (em-blk3 st1)
        (ET3Res [st2 bt be bm]
          (let [st3 (em-line st2 (str "  br i1 " lc ", label %" bt ", label %" be))
                st4 (em-open st3 bt)]
            (match (emit-typed then (clone ty) st4)
              (ESRes [st5 tv]
                (let [tp (em-cur st5)
                      st6 (em-line st5 (str "  br label %" bm))
                      st7 (em-open (em-env-put st6 env0) be)]
                  (match (emit-typed els (clone ty) st7)
                    (ESRes [st8 ev]
                      (let [ep (em-cur st8)
                            st9 (em-line st8 (str "  br label %" bm))
                            st10 (em-open st9 bm)
                            lty (cond
                                  (= (ty-tag ty) 9) "double"
                                  (= (ty-tag ty) 10) "float"
                                  (= (ty-tag ty) 11) "i1"
                                  (or (= (ty-tag ty) 12)
                                      (= (ty-tag ty) 16)) "ptr"
                                  "i64")]
                        (match (em-ins st10 (str "  ~ = phi " lty " [ " tv ", %" tp " ], [ " ev ", %" ep " ]"))
                          (ETRes [st11 res] (ESRes st11 res))))))))))))))))

; --- match node ------------------------------------------------------------------------

(deftype EMLS (EMLSNil) (EMLSCons [variant :- i64 lbl :- str next :- EMLS]))
(deftype EMPS (MPSNil) (MPSCons [v :- str pred :- str next :- EMPS]))
(deftype EArmsRes (ARes [st :- Emit labels :- EMLS]))
(deftype EBodiesRes (BRRes [st :- Emit vals :- EMPS]))
(deftype EPinRes (EPinRes [st :- Emit v :- str]))

(defn pin-arm [v :- str ty :- Ty st :- Emit] :- EPinRes
  (let [tag (ty-tag ty)]
    (if (or (= tag 16) (= tag 15))
      (EPinRes st v)
      (let [llty (cond
                   (= tag 9) "double"
                   (= tag 11) "i1"
                   "i64")]
        (match (em-pin v llty st)
          (ESRes [st2 v2] (EPinRes st2 v2)))))))

(defn emit-match-node [scrut :- &HExpr arms :- HArms ty :- Ty st :- Emit] :- ESRes
  (match (emit-adt (clone scrut) st)
    (ESRes [st1 sptr]
      (let [ai (adt-of scrut st1)
            name (em-adt-name st1 ai)]
        (match (em-ins2 st1
                 (str "~ = getelementptr inbounds %" name ", ptr " sptr ", i32 0, i32 0")
                 (str "~ = load i64, ptr ^1, align 8"))
          (ET2Res [st2 tg ttag]
            (match (em-blk2 st2)
              (ET2Res [st3 merged fail]
                (match (arm-labels-mint (arms-rev (clone arms) (EMLSNil)) st3 (ESlotsNil))
                  (ARes [st4 labels]
                      (let [dflt (mls-default (clone labels) fail)
                          st5 (em-line st4 (str "  switch i64 " ttag ", label %" dflt " ["))
                          st6 (mls-switch (clone labels) st5)
                          st7 (em-line st6 "]")
                          st8 (em-open st7 fail)
                          st9 (em-line st8 "  unreachable")]
                      (match (arm-bodies arms labels st9 merged sptr ai name (clone ty) (em-env-get st9) (MPSNil))
                        (BRRes [st10 vals]
                          (match-phi vals (em-open st10 merged) ty)))))) )) ))))))

; labels: minted walking the REVERSED arm list, prepending — the chain
; ends in source order.
(defn arm-labels-mint [cur :- HArms st :- Emit acc :- EMLS] :- EArmsRes
  (match cur
    (HANil [] (ARes st acc))
    (HACons [variant binders body next]
      (match (em-blk st)
        (ETRes [st2 lbl]
          (arm-labels-mint next st2 (EMLSCons variant lbl acc)))))))

(defn mls-default [ls :- EMLS dflt :- str] :- str
  (match ls
    (EMLSCons [variant lbl next]
      (if (= variant -1) lbl (mls-default next dflt)))
    (EMLSNil [] dflt)))

(defn mls-switch [ls :- EMLS st :- Emit] :- Emit
  (match ls
    (EMLSNil [] st)
    (EMLSCons [variant lbl next]
      (if (= variant -1)
        (mls-switch next st)
        (mls-switch next (em-line st (str "    i64 " variant ", label %" lbl)))))))

(defn arm-bodies [arms :- HArms labels :- EMLS st :- Emit merged :- str
                  scrut :- str ai :- i64 name :- str ty :- Ty env :- EEnv acc :- EMPS] :- EBodiesRes
  (match arms
    (HANil [] (BRRes st acc))
    (HACons [variant binders body next]
      (match labels
        (EMLSCons [lvar lbl lrest]
          (let [st0 (em-env-put st (clone env))
                st1 (em-open st0 lbl)
                st2 (if (= variant -1)
                      st1
                      (arm-field-loads binders ai variant 0 st1 scrut name))]
            (match (emit-typed body (clone ty) st2)
              (ESRes [st3 v]
                (match (pin-arm v (clone ty) st3)
                  (EPinRes [st4 pv]
                    (let [pred (em-cur st4)
                          st5 (em-line st4 (str "  br label %" merged))]
                      (arm-bodies next lrest st5 merged scrut ai name ty env
                                  (MPSCons pv pred acc)))))))))
        (_ (BRRes st acc)))))); Binder k of variant vi: load per its field type (adt.cato).

(defn arm-field-loads [binders :- Sids ai :- i64 vi :- i64 k :- i64 st :- Emit
                       scrut :- str name :- str] :- Emit
  (if (sids-null binders)
    st
    (let [b (sids-idx binders 0)]
      (match (emit-field-load b ai vi k st scrut name)
        (EURes [st2]
          (arm-field-loads (sids-drop binders 1) ai vi (+ k 1) st2 scrut name))))))

; Loop-tail arm bodies: each arm body is emitted with emit-loop-tail, so a
; `recur` in an arm branches to the loop head instead of erroring. Arms that
; recur (done=false) have already terminated their block; only arms that fall
; through with a value contribute a phi incoming and a `br merged`.
(deftype LMBRes (LMBRes [st :- Emit vals :- EMPS anydone :- bool]))

(defn loop-arm-bodies [arms :- HArms labels :- EMLS st :- Emit merged :- str
                       scrut :- str ai :- i64 name :- str ty :- Ty env :- EEnv acc :- EMPS
                       anydone :- bool] :- LMBRes
  (match arms
    (HANil [] (LMBRes st acc anydone))
    (HACons [variant binders body next]
      (match labels
        (EMLSCons [lvar lbl lrest]
          (let [st0 (em-env-put st (clone env))
                st1 (em-open st0 lbl)
                st2 (if (= variant -1)
                      st1
                      (arm-field-loads binders ai variant 0 st1 scrut name))]
            (match (emit-loop-tail body (clone ty) st2)
              (ETRRes [st3 v done]
                (if done
                  (match (pin-arm v (clone ty) st3)
                    (EPinRes [st4 pv]
                      (let [pred (em-cur st4)
                            st5 (em-line st4 (str "  br label %" merged))]
                        (loop-arm-bodies next lrest st5 merged scrut ai name ty env
                                         (MPSCons pv pred acc) true))))
                  (loop-arm-bodies next lrest st3 merged scrut ai name ty env
                                   acc anydone))))))
        (_ (LMBRes st acc anydone))))))

(defn match-phi [vals :- EMPS st :- Emit ty :- Ty] :- ESRes
    (let [lty (let [tag (ty-tag ty)]
              (cond
                (= tag 16) "ptr"
                (= tag 15) "%VecI64"
                (= tag 12) "ptr"
                (= tag 9) "double"
                (= tag 10) "float"
                (= tag 11) "i1"
                "i64"))]
    (match (em-temp st)
      (ETRes [st2 res]
        (let [st3 (em-line st2 (str res " = phi " lty (mps-items (mps-rev vals (MPSNil)) true)))]
          (ESRes st3 res))))))

(defn mps-items [ps :- EMPS first :- bool] :- str
  (match ps
    (MPSNil [] "")
    (MPSCons [v pred next]
      (str (if first " " ", ") "[ " v ", %" pred " ]" (mps-items next false)))))

(defn mps-rev [ps :- EMPS acc :- EMPS] :- EMPS
  (match ps
    (MPSNil [] acc)
    (MPSCons [v pred next] (mps-rev next (MPSCons v pred acc)))))

; --- loop / recur -----------------------------------------------------------------------

(deftype EMLSlots (ESlotsNil) (ESlots2 [name :- i64 slot :- str ty :- Ty next :- EMLSlots]))
(deftype SlotsRes (ESLRes [st :- Emit slots :- EMLSlots]))
(deftype TailRes (ETRRes [st :- Emit v :- str done :- bool]))

(defn slots-rev [ss :- EMLSlots st :- Emit acc :- EMLSlots] :- SlotsRes
  (match ss
    (ESlotsNil [] (ESLRes st acc))
    (ESlots2 [name slot ty next] (slots-rev next st (ESlots2 name slot ty acc)))))

(defn emit-loop-node [binds :- Binds ty :- Ty body :- HExpr st :- Emit] :- ESRes
  ; Slots hoisted to the entry prelude (the loop may run any number of
  ; times); inits emit in source order. loop-slots conses each binding
  ; onto the accumulator while the HLoop binds arrive reversed, so the
  ; slot list needs one reversal back into source order — the recur zip
  ; is positional, and a swapped pair mis-types an argument.
  (match (loop-slots binds st (ESlotsNil))
    (ESLRes [st1 slots0]
      (match (slots-rev slots0 st1 (ESlotsNil))
        (ESLRes [st2 slots]
          (match (em-blk st2)
            (ETRes [st3 head]
              (let [st4 (em-line st3 (str "  br label %" head))
                    st5 (em-open st4 head)
                    st6 (loop-load-slots (clone slots) st5)]
                (match st6
                  (Emit [c6 m6 s6]
                    (let [saved (fc-lfr c6)
                          st7 (em-with-lfr st6 (LoopFr slots head))]
                      (match (emit-loop-tail body ty st7)
                        (ETRRes [st8 v done]
                          (let [st9 (em-with-lfr st8 saved)]
                            (match (em-blk st9)
                              (ETRes [st10 after]
                                (if done
                                  (let [st11 (em-line st10 (str "  br label %" after))
                                        st12 (em-open st11 after)]
                                    (ESRes st12 v))
                                  (let [st11 (em-open st10 after)
                                        st12 (em-line st11 "  unreachable")]
                                    (ESRes st12 "undef")))))))))))))))))))

; One alloca (prelude) + init store per binding, in source order
(defn loop-slot-vec-init [d :- str l :- str st :- Emit] :- ESRes
  ; assemble {ptr d, i64 l, i64 l} — value-form headers carry cap=len.
  ; em-ins3's markers: ^1 is the previous instruction, ^2 the one before,
  ; so the chain is undef -> ^1 -> ^1 again.
  (match (em-ins3 st
           (str "~ = insertvalue %VecI64 undef, ptr " d ", 0")
           (str "~ = insertvalue %VecI64 ^1, i64 " l ", 1")
           (str "~ = insertvalue %VecI64 ^1, i64 " l ", 2"))
    (ET3Res [st1 s0 s1 s2] (ESRes st1 s2))))

(defn loop-slots [binds :- Binds st :- Emit acc :- EMLSlots] :- SlotsRes
  (match binds
    (BNil [] (ESLRes st acc))
    (BCons [name v ty next]
      (match st
        (Emit [c mdl sigs]
          (if (loop-slot-vec ty)
            (match (em-temp st)
              (ETRes [st1 slot]
                (let [st2 (em-pre st1 (str slot " = alloca %VecI64, align 8"))]
                  (match (emit-vec-pair v st2)
                    (EVRes [st3 d l el]
                      (match (loop-slot-vec-init d l st3)
                        (ESRes [st4 hdr]
                          (let [st5 (em-line st4 (str "  store %VecI64 " hdr ", ptr " slot ", align 8"))]
                            (loop-slots next st5 (ESlots2 name slot (clone ty) acc))))))))))
            (match (em-temp st)
              (ETRes [st1 slot]
                (match st1
                  (Emit [c mdl sigs]
                    (let [st2 (em-pre st1 (str slot " = alloca " (ll-loop-slot-ty ty mdl) ", align 8"))]
                      (match (emit-typed v (clone ty) st2)
                        (ESRes [st3 init]
                          (match st3
                            (Emit [c3 m3 s3]
                              (let [st4 (em-line st3 (str "  store " (ll-loop-slot-ty ty m3) " " init ", ptr " slot ", align 8"))]
                                (loop-slots next st4 (ESlots2 name slot (clone ty) acc))))))))))))))))))

; Fresh registers for every variable at the loop head.
(defn loop-load-slots [slots :- EMLSlots st :- Emit] :- Emit
  (match slots
    (ESlotsNil [] st)
    (ESlots2 [name slot ty next]
      (if (loop-slot-vec ty)
        (match (em-ins3 st
                 (str "~ = load %VecI64, ptr " slot ", align 8")
                 (str "~ = extractvalue %VecI64 ^1, 0")
                 (str "~ = extractvalue %VecI64 ^2, 1"))
          (ET3Res [st1 _h d l]
            (loop-load-slots next (em-vc-put st1 name d l (ty-arg ty)))))
        (match (em-temp st)
          (ETRes [st1 r]
            (match st1
              (Emit [c mdl sigs]
                (let [st2 (em-line st1 (str r " = load " (ll-loop-slot-ty ty mdl) ", ptr " slot ", align 8"))]
                  (loop-load-slots next (em-sc-put st2 name r ty)))))))))))

(defn emit-loop-tail [e :- HExpr ty :- Ty st :- Emit] :- TailRes
  (match e
    (HRecur [args]
      (match st
        (Emit [c mdl sigs]
          (let [lfr (fc-lfr c)]
            (match lfr
              (LoopFr [slots head]
                (match (recur-stores args slots st)
                  (EURes [st2]
                    (ETRRes (em-line st2 (str "  br label %" head)) "" false)))))))))

    (HIf [cond then els ity]
      (match (emit-bool cond st)
        (ESRes [st1 lc]
          (match (em-blk3 st1)
            (ET3Res [st2 bt be bm]
              (let [st3 (em-line st2 (str "  br i1 " lc ", label %" bt ", label %" be))
                    st4 (em-open st3 bt)]
                (match (emit-loop-tail then (clone ity) st4)
                  (ETRRes [st5 tv tdone]
                    (let [tp (if tdone (em-cur st5) "")
                          st6 (if tdone (em-line st5 (str "  br label %" bm)) st5)
                          st7 (em-open st6 be)]
                      (match (emit-loop-tail els (clone ity) st7)
                        (ETRRes [st8 ev edone]
                          (let [ep (if edone (em-cur st8) "")
                                st9 (if edone (em-line st8 (str "  br label %" bm)) st8)
                                st10 (em-open st9 bm)]
                            (cond
                              (and tdone edone)
                              (match st10
                                (Emit [c10 m10 s10]
                                  (match (em-ins st10 (str "  ~ = phi " (ll-loop-slot-ty ity m10) " [ " tv ", %" tp " ], [ " ev ", %" ep " ]"))
                                    (ETRes [st11 r] (ETRRes st11 r true)))))
                              tdone (ETRRes st10 tv true)
                              edone (ETRRes st10 ev true)
                              (let [st11 (em-line st10 "  unreachable")]
                                (ETRRes st11 "" false)))))))))))))))

    (HLet [binds body frees]
      (match (emit-let binds st)
        (EURes [st2]
          (match (emit-loop-tail body ty st2)
            (ETRRes [st3 v done]
              (if done
                (match (emit-frees frees st3)
                  (EURes [st4] (ETRRes st4 v true)))
                (ETRRes st3 v done)))))))

    (HSeq [es]
      (match (emit-stmts-ex-last es st)
        (ELRes [st2 last] (emit-loop-tail last ty st2))))

    (HMatch [scrut arms mty]
      (match (emit-adt (clone scrut) st)
        (ESRes [st1 sptr]
          (let [ai (adt-of scrut st1)
                name (em-adt-name st1 ai)]
            (match (em-ins2 st1
                     (str "~ = getelementptr inbounds %" name ", ptr " sptr ", i32 0, i32 0")
                     (str "~ = load i64, ptr ^1, align 8"))
              (ET2Res [st2 tg ttag]
                (match (em-blk2 st2)
                  (ET2Res [st3 merged fail]
                    (match (arm-labels-mint (arms-rev (clone arms) (EMLSNil)) st3 (ESlotsNil))
                      (ARes [st4 labels]
                        (let [dflt (mls-default (clone labels) fail)
                              st5 (em-line st4 (str "  switch i64 " ttag ", label %" dflt " ["))
                              st6 (mls-switch (clone labels) st5)
                              st7 (em-line st6 "]")
                              st8 (em-open st7 fail)
                              st9 (em-line st8 "  unreachable")]
                          (match (loop-arm-bodies arms labels st9 merged sptr ai name mty (em-env-get st9) (MPSNil) false)
                            (LMBRes [st10 vals anydone]
                              (if anydone
                                (match (match-phi vals (em-open st10 merged) (clone mty))
                                  (ESRes [st11 r] (ETRRes st11 r true)))
                                (ETRRes st10 "" false)))))))))))))))

    (_
      (match (emit-typed (clone e) (clone ty) st)
        (ESRes [st2 v] (ETRRes st2 v true))))))

; Positional zip: the k-th recur arg stores into the k-th slot.
; Positional zip: the k-th recur arg stores into the k-th slot.
(defn recur-store-vec [d :- str l :- str slot :- str st :- Emit] :- EURes
  (match (loop-slot-vec-init d l st)
    (ESRes [st1 hdr] (EURes (em-line st1 (str "  store %VecI64 " hdr ", ptr " slot ", align 8"))))))

(defn recur-stores [args :- HExprs slots :- EMLSlots st :- Emit] :- EURes
  (match args
    (HENil [] (EURes st))
    (HECons [kid next]
      (match slots
        (ESlots2 [name slot sty snext]
          (if (loop-slot-vec sty)
            (match (emit-vec-pair kid st)
              (EVRes [st1 d l el]
                (match (recur-store-vec d l slot st1)
                  (EURes [st2] (recur-stores2 next snext st2)))))
            (match (emit-typed kid (clone sty) st)
              (ESRes [st1 v]
                (match st1
                  (Emit [c1 m1 _s1]
                    (match (recur-stores2 next snext (em-line st1 (str "  store " (ll-loop-slot-ty sty m1) " " v ", ptr " slot ", align 8")))
                      (EURes [st2] (EURes st2)))))))))
        (_ (EURes (do (cg-fail-i "recur arg/slot mismatch") st)))))))

; The tail walk after the first store (state already carries the store).
(defn recur-stores2 [args :- HExprs slots :- EMLSlots st :- Emit] :- EURes
  (match args
    (HENil [] (EURes st))
    (HECons [kid next]
      (match slots
        (ESlots2 [name slot sty snext]
          (if (loop-slot-vec sty)
            (match (emit-vec-pair kid st)
              (EVRes [st1 d l el]
                (match (recur-store-vec d l slot st1)
                  (EURes [st2] (recur-stores2 next snext st2)))))
            (match (emit-typed kid (clone sty) st)
              (ESRes [st1 v]
                (match st1
                  (Emit [c1 m1 _s1]
                    (match (recur-stores2 next snext (em-line st1 (str "  store " (ll-loop-slot-ty sty m1) " " v ", ptr " slot ", align 8")))
                      (EURes [st2] (EURes st2)))))))))
        (_ (EURes (do (cg-fail-i "recur arg/slot mismatch") st)))))))

; heap.cato — S7: string/vector value emission, count, get, options,
; conj — the port of the seed emitter's exprs_val.rs and heap_vec.rs
; for the subset. ADT emission, lets, frees and calls live in adt.cato.

(defn em-malloc [st :- Emit nbytes :- str] :- ETRes
  (match (em-ins st (str "  ~ = call ptr @malloc(i64 " nbytes ")"))
    (ETRes [st2 t] (ETRes (em-decl st2 "declare ptr @malloc(i64)") t))))

(defn adt-of [e :- &HExpr st :- &Emit] :- i64
  (match e
    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c v)]
            (match rv
              (RegVal [r ty]
                (if (= (ty-tag ty) 16)
                  (ty-arg ty)
                  (do (cg-fail-i (str "not an ADT binding name=" (md-sym mdl v) " sctag=" (ty-tag ty))) -1))))))))
    (HCtor [adt variant args] adt)
    (HMatch [scrut arms ty]
      (if (= (ty-tag ty) 16) (ty-arg ty)
        (do (cg-fail-i "match of non-ADT") -1)))
    (HIf [c t e ty]
      (if (= (ty-tag ty) 16) (ty-arg ty)
        (do (cg-fail-i "if of non-ADT") -1)))
    (HClone [x] (adt-of x st))
    (HCall [name args]
      (match st
        (Emit [c mdl sigs]
          (let [sg (sigs-lookup sigs name)]
            (match sg
              (ESig [params ret]
                (if (= (ty-tag ret) 16)
                  (ty-arg ret)
                  (do (cg-fail-i "call does not return an ADT") -1))))))))
    (HGet [src idx dflt ty res]
      (if (= (ty-tag res) 16) (ty-arg res)
        (do (cg-fail-i "get without Option result") -1)))
    (HStrNth [s idx res]
      (if (= (ty-tag res) 16) (ty-arg res)
        (do (cg-fail-i "nth without Option result") -1)))
    (HConstI64 [v] (do (cg-fail-i "expected an ADT value") -1))
    (HConstF64 [v] (do (cg-fail-i "expected an ADT value") -1))
    (HConstB [v] (do (cg-fail-i "expected an ADT value") -1))
    (HStrLit [v] (do (cg-fail-i "expected an ADT value") -1))
    (HVecLit [el vals] (do (cg-fail-i "expected an ADT value") -1))
    (HBinW [op a b ty] (do (cg-fail-i "expected an ADT value") -1))
    (HBinF [op a b] (do (cg-fail-i "expected an ADT value") -1))
    (HCmpW [op a b ty] (do (cg-fail-i "expected an ADT value") -1))
    (HStrCmp [pol a b] (do (cg-fail-i "expected an ADT value") -1))
    (HStrOrd [op a b] (do (cg-fail-i "expected an ADT value") -1))
    (HICast [x from to] (do (cg-fail-i "expected an ADT value") -1))
    (HCount [x] (do (cg-fail-i "expected an ADT value") -1))
    (HToStr [x ty] (do (cg-fail-i "expected an ADT value") -1))
    (HStrCat [args] (do (cg-fail-i "expected an ADT value") -1))
    (HSubs [s a b] (do (cg-fail-i "expected an ADT value") -1))
    (HSplit [s sep] (do (cg-fail-i "expected an ADT value") -1))
    (HJoin [sep xs] (do (cg-fail-i "expected an ADT value") -1))
    (HCharStr [x] (do (cg-fail-i "expected an ADT value") -1))
    (HConj [v x el inplace] (do (cg-fail-i "expected an ADT value") -1))
    (HAnd [a b] (do (cg-fail-i "expected an ADT value") -1))
    (HOr [a b] (do (cg-fail-i "expected an ADT value") -1))
    (HNot [x] (do (cg-fail-i "expected an ADT value") -1))
    (HAbs [x ty] (do (cg-fail-i "expected an ADT value") -1))
    (HMin [a b ty] (do (cg-fail-i "expected an ADT value") -1))
    (HMax [a b ty] (do (cg-fail-i "expected an ADT value") -1))
    (HSeq [es] (do (cg-fail-i "expected an ADT value") -1))
    (HLet [binds body frees] (do (cg-fail-i "expected an ADT value") -1))
    (HLoop [binds ty body] (do (cg-fail-i "expected an ADT value") -1))
    (HRecur [args] (do (cg-fail-i "expected an ADT value") -1))
    (HDrop [x] (do (cg-fail-i "expected an ADT value") -1))
    (HClosure [sig mangled params caps body] (do (cg-fail-i "expected an ADT value") -1))
    (HClosureCall [f args sig] (do (cg-fail-i "expected an ADT value") -1))
    (HSlurp [p] (do (cg-fail-i "expected an ADT value") -1))
    (HSpit [path data] (do (cg-fail-i "expected an ADT value") -1))
    (HArgs [] (do (cg-fail-i "expected an ADT value") -1))
    (HExit [e] (do (cg-fail-i "expected an ADT value") -1))
    (HParseNum [s int res]
      (if (= (ty-tag res) 16) (ty-arg res)
        (do (cg-fail-i "parse-num without Option result") -1)))))

(defn emit-str-val [e :- HExpr st :- Emit] :- ESRes
  (match e
    (HStrLit [s]
      (match st
        (Emit [c mdl sigs]
          (match (md-mint-str mdl s)
            (EMRes [m2 label]
              (match (em-ins (Emit c m2 sigs)
                       (str "  ~ = getelementptr inbounds [" (+ (count s) 1) " x i8], ptr " label ", i32 0, i32 0"))
                (ETRes [st2 t] (ESRes st2 t))))))))
    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c v)]
            (match rv
              (RegVal [r ty] (ESRes st r)))))))
    (HSubs [s a b] (emit-subs s a b st))
    (HStrCat [args] (emit-strcat args st))
    (HJoin [sep xs] (emit-join sep xs st))
    (HToStr [x ty] (emit-tostr x ty st))
    (HSlurp [p]
      (match (emit-str-val p st)
        (ESRes [st1 pv]
          (match (em-ins st1 (str "  ~ = call ptr @cato_slurp(ptr " pv ")"))
            (ETRes [st2 t]
              (ESRes (em-decl st2 "declare ptr @cato_slurp(ptr)") t))))))
    (HCharStr [x]
      (match (emit-int x st)
        (ESRes [st1 cv]
          (match (em-malloc st1 "2")
            (ETRes [st2 p]
              (match (em-ins2 st2
                       (str "  ~ = trunc i64 " cv " to i8")
                       (str "  ~ = getelementptr inbounds i8, ptr " p ", i64 1"))
                (ET2Res [st3 b np]
                  (let [st4 (em-line st3 (str "  store i8 " b ", ptr " p))
                        st5 (em-line st4 (str "  store i8 0, ptr " np))]
                    (ESRes st5 p)) )))))))
    (HIf [c t e ty] (emit-if-node c t e ty st))
    (HMatch [scrut arms ty] (emit-match-node scrut arms ty st))
    (HLoop [binds ty body] (emit-loop-node binds ty body st))
    (HLet [binds body frees]
      (match (emit-let binds st)
        (EURes [st2]
          (match (emit-str-val body st2)
            (ESRes [st3 v]
              (match (emit-frees frees st3)
                (EURes [st4] (ESRes st4 v))))))))
    (HSeq [es]
      (match (emit-stmts-ex-last es st)
        (ELRes [st2 last] (emit-str-val last st2))))
    (HGet [src idx dflt ty res]
      (if (= (ty-tag ty) 12)
        (emit-get-str src idx dflt st)
        (sf st "get returning non-str in str context")))
    (HCall [name args] (call-user name args st))
    (HClone [x]
      (match (emit-str-val x st)
        (ESRes [st1 p]
          (match (em-ins st1 (str "  ~ = call ptr @strdup(ptr " p ")"))
            (ETRes [st2 t] (ESRes (em-decl st2 "declare ptr @strdup(ptr)") t))))))
    (HConstI64 [v] (sf st "expected a string expression"))
    (HConstF64 [v] (sf st "expected a string expression"))
    (HConstB [v] (sf st "expected a string expression"))
    (HVecLit [el vals] (sf st "vec literal in str context"))
    (HBinW [op a b ty] (sf st "expected a string expression"))
    (HBinF [op a b] (sf st "expected a string expression"))
    (HCmpW [op a b ty] (sf st "expected a string expression"))
    (HStrCmp [pol a b] (sf st "expected a string expression"))
    (HStrOrd [op a b] (sf st "expected a string expression"))
    (HICast [x from to] (sf st "expected a string expression"))
    (HCount [x] (sf st "expected a string expression"))
    (HSplit [s sep] (sf st "heap value must be bound with let"))
    (HStrNth [s idx res] (sf st "expected a string expression"))
    (HConj [v x el inplace] (sf st "heap vector value must be bound with let"))
    (HAnd [a b] (sf st "expected a string expression"))
    (HOr [a b] (sf st "expected a string expression"))
    (HNot [x] (sf st "expected a string expression"))
    (HAbs [x ty] (sf st "expected a string expression"))
    (HMin [a b ty] (sf st "expected a string expression"))
    (HMax [a b ty] (sf st "expected a string expression"))
    (HRecur [args] (sf st "recur outside loop"))
    (HCtor [adt variant args] (sf st "expected a string expression"))
    (HDrop [x] (sf st "expected a string expression"))
    (HClosure [sig mangled params caps body] (sf st "closure value must be bound with let"))
    (HClosureCall [f args sig] (sf st "expected a string expression"))
    (HSpit [path data] (sf st "expected a string expression"))
    (HArgs [] (sf st "args must be bound with let"))
    (HExit [x] (sf st "expected a string expression"))
    (HParseNum [s int res] (sf st "Option result must be bound with let"))))

(defn emit-tostr [x :- HExpr ty :- Ty st :- Emit] :- ESRes
  (let [tag (ty-tag ty)]
    (cond
      (= tag 9)
      (match (emit-float (clone x) st)
        (ESRes [st1 f]
          (match (em-ins st1 (str "  ~ = call ptr @cato_f64_to_str(double " f ")"))
            (ETRes [st2 t] (ESRes (em-decl st2 "declare ptr @cato_f64_to_str(double)") t)))))
      (= tag 11)
      (match (emit-bool (clone x) st)
        (ESRes [st1 b]
          (match (em-ins st1 (str "  ~ = zext i1 " b " to i64"))
            (ETRes [st2 z]
              (match (em-ins st2 (str "  ~ = call ptr @cato_num_to_str(i64 " z ")"))
                (ETRes [st3 t] (ESRes (em-decl st3 "declare ptr @cato_num_to_str(i64)") t)))))))
      (is-uint-tag tag)
      (match (emit-int (clone x) st)
        (ESRes [st1 i]
          (match (em-ins st1 (str "  ~ = call ptr @cato_u64_to_str(i64 " i ")"))
            (ETRes [st2 t] (ESRes (em-decl st2 "declare ptr @cato_u64_to_str(i64)") t)))))
      (match (emit-int x st)
        (ESRes [st1 i]
          (match (em-ins st1 (str "  ~ = call ptr @cato_num_to_str(i64 " i ")"))
            (ETRes [st2 t] (ESRes (em-decl st2 "declare ptr @cato_num_to_str(i64)") t))))))))

(deftype ESPart (ESPart [p :- str l :- str]))
(deftype ESPs (SPNil) (SPCons [h :- ESPart t :- ESPs]))
(deftype ESPCol (ESPCol [st :- Emit parts :- ESPs]))
(deftype ECPRes (ECPRes [st :- Emit endptr :- str]))

(defn emit-strcat [args :- HExprs st :- Emit] :- ESRes
  (match (strcat-parts args st (SPNil))
    (ESPCol [st1 parts]
      (match (strcat-total (clone parts) st1 "")
        (ETRes [st2 tot]
          (match (em-ins st2 (str "  ~ = add i64 " tot ", 1"))
            (ETRes [st3 nb]
              (match (em-malloc st3 nb)
                (ETRes [st4 dst]
                  (match (strcat-copies parts dst st4 "")
                    (ECPRes [st5 end]
                      (let [st6 (em-line st5 (str "  store i8 0, ptr " end))]
                        (ESRes st6 dst)))))))))))))

(defn strcat-parts [args :- HExprs st :- Emit acc :- ESPs] :- ESPCol
  (match args
    (HENil [] (ESPCol st (sps-rev acc (SPNil))))
    (HECons [kid next]
      (match (emit-str-val (clone kid) st)
        (ESRes [st1 p]
          (match kid
            (HStrLit [s]
              (let [sl (str (count s))]
                (strcat-parts (hes-rest args) st1 (SPCons (ESPart p sl) acc))))
            (_
              (match (em-ins st1 (str "  ~ = call i64 @strlen(ptr " p ")"))
                (ETRes [st2 l]
                  (strcat-parts (hes-rest args) st2 (SPCons (ESPart p l) acc)))))))))))

(defn sps-rev [ps :- ESPs acc :- ESPs] :- ESPs
  (match ps
    (SPNil [] acc)
    (SPCons [h t] (sps-rev t (SPCons h acc)))))

(defn strcat-total [parts :- ESPs st :- Emit acc :- str] :- ETRes
  (match parts
    (SPNil []
      (if (= (count acc) 0)
        (match (em-ins st (str "  ~ = add i64 0, 0"))
          (ETRes [st2 t] (ETRes st2 t)))
        (ETRes st acc)))
    (SPCons [h t]
      (match h
        (ESPart [p l]
          (if (= (count acc) 0)
            (strcat-total t st l)
            (match (em-ins st (str "  ~ = add i64 " acc ", " l))
              (ETRes [st2 t2]
                (strcat-total t st2 t2)))))))))

(defn strcat-copies [parts :- ESPs dst :- str st :- Emit off :- str] :- ECPRes
  (match parts
    (SPNil []
      (if (= (count off) 0)
        (ECPRes st dst)
        (match (em-ins st (str "  ~ = getelementptr inbounds i8, ptr " dst ", i64 " off))
          (ETRes [st2 t] (ECPRes st2 t)))))
    (SPCons [h t]
      (match h
        (ESPart [p l]
          (let [at (if (= (count off) 0)
                     (ET2Res st dst off)
                     (match (em-ins st (str "  ~ = getelementptr inbounds i8, ptr " dst ", i64 " off))
                       (ETRes [st2 t2] (ET2Res st2 t2 off))))]
            (match at
              (ET2Res [st3 atp atoff]
                (let [st4 (em-line st3 (str "  call void @llvm.memcpy.p0.p0.i64(ptr " atp ", ptr " p ", i64 " l ", i1 false, i1 false)"))]
                  (if (= (count atoff) 0)
                    (strcat-copies t dst st4 l)
                    (match (em-ins st4 (str "  ~ = add i64 " atoff ", " l))
                      (ETRes [st5 off2]
                        (strcat-copies t dst st5 off2))))) ))))))))

(defn emit-subs [s :- HExpr a :- HExpr b :- HExpr st :- Emit] :- ESRes
  (match (emit-str-val s st)
    (ESRes [st1 sp]
      (match (emit-int a st1)
        (ESRes [st2 stv]
          (match (emit-int b st2)
            (ESRes [st3 env]
              (match (em-ins4 st3
                       (str "  ~ = sub i64 " env ", " stv)
                       (str "  ~ = icmp slt i64 ^1, 0")
                       (str "  ~ = select i1 ^1, i64 0, i64 ^2")
                       (str "  ~ = add i64 ^1, 1"))
                (ET4Res [st4 diff neg len one]
                  (match (em-malloc st4 one)
                    (ETRes [st5 np]
                      (match (em-ins2 st5
                               (str "  ~ = getelementptr inbounds i8, ptr " sp ", i64 " stv)
                               (str "  ~ = getelementptr inbounds i8, ptr " np ", i64 " len))
                        (ET2Res [st6 spoff tail]
                          (let [st7 (em-line st6 (str "  call void @llvm.memcpy.p0.p0.i64(ptr " np ", ptr " spoff ", i64 " len ", i1 false, i1 false)"))
                                st8 (em-line st7 (str "  store i8 0, ptr " tail ", align 1"))]
                            (ESRes st8 np)) )))))))))))))

(defn emit-split [s :- HExpr sep :- HExpr st :- Emit] :- EVRes
  (match (emit-str-val s st)
    (ESRes [st1 sp]
      (match (emit-str-val sep st1)
        (ESRes [st2 sepp]
          (match (em-temp st2)
            (ETRes [st3 out]
              (let [st4 (em-pre st3 (str out " = alloca i64, align 8"))]
                (match (em-ins2 st4
                         (str "  ~ = call ptr @cato_str_split(ptr " sp ", ptr " sepp ", ptr " out ")")
                         (str "  ~ = load i64, ptr " out ", align 8"))
                  (ET2Res [st5 arr l]
                    (EVRes (em-decl st5 "declare ptr @cato_str_split(ptr, ptr, ptr)") arr l 2) ))))))))))

(defn emit-join [sep :- HExpr xs :- HExpr st :- Emit] :- ESRes
  (match (emit-str-val sep st)
    (ESRes [st1 sepp]
      (match (vec-arg xs st1)
        (EVRes [st2 d l el]
          (match (em-ins st2 (str "  ~ = call ptr @cato_str_join(ptr " d ", i64 " l ", ptr " sepp ")"))
            (ETRes [st3 t]
              (ESRes (em-decl st3 "declare ptr @cato_str_join(ptr, i64, ptr)") t))))))))

(defn emit-count [x :- HExpr st :- Emit] :- ESRes
  (match (clone x)
    (HVar [s]
      (match (clone st)
        (Emit [c mdl sigs]
          (cond
            (fc-gr-has c s)
            (match (fc-gr-get c s)
              (GroVal [slot el] (gr-slot-len slot st)))
            (fc-vc-has c s)
            (match (fc-vc-get c s)
              (VecVal [p l el] (ESRes st l)))
            (match (fc-sc-get c s)
              (RegVal [r ty]
                (if (= (ty-tag ty) 12)
                  (emit-strlen r st)
                  (sf st "count of non-vector/non-string"))))))))
    (HStrLit [s]
      (match (emit-str-val x (clone st))
        (ESRes [st1 p] (emit-strlen p st1))))
    (HVecLit [el vals]
      (match (vec-arg x st)
        (EVRes [st1 p l el2] (ESRes st1 l))))
    (_
      (if (count-expr-is-vec (clone x) (clone st))
        (match (vec-arg (clone x) (clone st))
          (EVRes [st1 p l el] (ESRes st1 l)))
        (match (emit-str-val (clone x) (clone st))
          (ESRes [st1 p] (emit-strlen p st1)))))))

(defn emit-strlen [p :- str st :- Emit] :- ESRes
  (match (em-ins st (str "  ~ = call i64 @strlen(ptr " p ")"))
    (ETRes [st2 t] (ESRes (em-decl st2 "declare i64 @strlen(ptr)") t))))

(defn count-expr-is-vec [e :- HExpr st :- Emit] :- bool
  (match e
    (HCall [name args]
      (match st
        (Emit [c mdl sigs]
          (let [sg (sigs-lookup sigs name)]
            (match sg
              (ESig [params ret] (= (ty-tag ret) 15)))))))
    (HIf [c t e2 ty] (= (ty-tag ty) 15))
    (HMatch [scrut arms ty] (= (ty-tag ty) 15))
    (HSplit [s sep] true)
    (HConj [v x el inplace] true)
    (HVecLit [el vals] true)
    (HLet [binds body frees]
      (match body
        (HVar [v] (let-has-vec binds v))
        (_ (count-expr-is-vec (clone body) st))))
    (HSeq [es] (count-expr-is-vec (hes-last es) st))
    (HClone [inner] (count-expr-is-vec inner st))
    (HVar [v]
      (match st
        (Emit [c mdl sigs] (or (fc-vc-has c v) (fc-gr-has c v)))))
    (_ false)))

(defn let-has-vec [binds :- Binds v :- i64] :- bool
  (match binds
    (BNil [] false)
    (BCons [name val ty next]
      (if (and (= name v) (= (ty-tag ty) 15))
        true
        (let-has-vec next v)))))

(defn gr-slot-len [slot :- str st :- Emit] :- ESRes
  (match (em-ins2 st
           (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 1")
           (str "  ~ = load i64, ptr ^1, align 8"))
    (ET2Res [st1 lf l] (ESRes st1 l) )))

(defn gr-slot-pl [slot :- str st :- Emit] :- ET2Res
  (match (em-ins4 st
           (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 0")
           (str "  ~ = load ptr, ptr ^1, align 8")
           (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 1")
           (str "  ~ = load i64, ptr ^1, align 8"))
    (ET4Res [st1 pf p lf l] (ET2Res st1 p l))))

(defn vec-arg [e :- HExpr st :- Emit] :- EVRes
  (match e
    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (if (fc-gr-has c v)
            (match (fc-gr-get c v)
              (GroVal [slot el]
                (match (gr-slot-pl slot st)
                  (ET2Res [st1 p l] (EVRes st1 p l el) ))))
            (if (fc-vc-has c v)
              (match (fc-vc-get c v)
                (VecVal [p l el] (EVRes st p l el)))
              (vf st "not a vector binding"))))))
    (HVecLit [el vals]
      (match st
        (Emit [c mdl sigs]
          (match (md-mint-vec mdl el vals)
            (MVRes [m2 label len]
              (match (em-temp (Emit c m2 sigs))
                (ETRes [st1 slot]
                  (let [st1a (em-pre st1 (str slot " = alloca %VecI64, align 8"))
                        st2 (em-line st1a (str "  store %VecI64 { ptr " label ", i64 " len ", i64 " len " }, ptr " slot ", align 8"))]
                    (match (em-ins3 st2
                             (str "~ = load %VecI64, ptr " slot ", align 8")
                             (str "~ = extractvalue %VecI64 ^1, 0")
                             (str "~ = extractvalue %VecI64 ^2, 1"))
                      (ET3Res [st3 lv td tl] (EVRes st3 td tl el)))))))))))
    (_ (emit-vec-pair e st))))

(defn vec-elem-of [ty :- Ty] :- i64
  (if (= (ty-tag ty) 15)
    (ty-arg ty)
    (do (cg-fail-i "vector value annotated") -1)))

(defn elem-ty-of [el :- i64] :- Ty
  (if (= el 0) (t-i64)
    (if (= el 1) (t-f64)
      (t-str))))

(defn vec-clone-buf [p :- str l :- str el :- i64 st :- Emit] :- ETRes
  (if (= el 2)
    (match (em-ins st (str "  ~ = call ptr @cato_str_vec_copy(ptr " p ", i64 " l ", i64 " l ")"))
      (ETRes [st1 t] (ETRes (em-decl st1 "declare ptr @cato_str_vec_copy(ptr, i64, i64)") t)))
    (match (em-ins st (str "  ~ = mul i64 " l ", 8"))
      (ETRes [st1 nb]
        (match (em-malloc st1 nb)
          (ETRes [st2 npm]
            (ETRes (em-line st2 (str "  call void @llvm.memcpy.p0.p0.i64(ptr " npm ", ptr " p ", i64 " nb ", i1 false, i1 false)")) npm)))))))

(defn vec-slot-store [slot :- str v :- str k :- i64 st :- Emit] :- Emit
  (match (em-temp st)
    (ETRes [st1 f]
      (let [st2 (em-line st1 (str f " = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 " k))]
        (if (= k 0)
          (em-line st2 (str "  store ptr " v ", ptr " f ", align 8"))
          (em-line st2 (str "  store i64 " v ", ptr " f ", align 8")))))))

(defn emit-vec-pair [e :- HExpr st :- Emit] :- EVRes
  (match e
    (HVar [v] (vec-arg e st))
    (HVecLit [el vals] (vec-arg e st))
    (HCall [name args]
      (match st
        (Emit [c mdl sigs]
          (let [sg (sigs-lookup sigs name)]
            (match sg
              (ESig [params ret]
                (if (= (ty-tag ret) 15)
                  (match (call-user name (clone args) st)
                    (ESRes [st1 v]
                      (match (em-ins2 st1
                               (str "  ~ = extractvalue %VecI64 " v ", 0")
                               (str "  ~ = extractvalue %VecI64 " v ", 1"))
                        (ET2Res [st2 p l] (EVRes st2 p l (ty-arg ret)) ))))
                  (vf st "call does not return a vector"))))))))
    (HSplit [s sep] (emit-split (clone s) (clone sep) st))
    (HConj [v x el inplace]
      (match (emit-conj (clone v) (clone x) el inplace st)
        (ETRes [st1 slot]
          (match (gr-slot-pl slot st1)
            (ET2Res [st2 p l] (EVRes st2 p l el) )))))
    (HClone [inner]
      (match (vec-arg (clone inner) st)
        (EVRes [st1 p l el]
          (match (vec-clone-buf p l el st1)
            (ETRes [st4 npm]
              (match (em-temp st4)
                (ETRes [st5 slot]
                  (let [st6 (em-pre st5 (str slot " = alloca %VecI64, align 8"))
                        st7 (vec-slot-store slot npm 0 st6)
                        st8 (vec-slot-store slot l 1 st7)
                        st9 (vec-slot-store slot l 2 st8)]
                    (EVRes st9 npm l el)))))))))
    (HIf [c t e2 ty]
      (let [env0 (em-env-get st)]
      (match (emit-bool (clone c) st)
        (ESRes [st1 lc]
          (match (em-blk3 st1)
            (ET3Res [st2 bt be bm]
              (let [st3 (em-line st2 (str "  br i1 " lc ", label %" bt ", label %" be))
                    st4 (em-open st3 bt)]
                (match (emit-vec-pair (clone t) st4)
                  (EVRes [st5 tp tl t-el]
                    (let [tbr (em-cur st5)
                          st6 (em-line st5 (str "  br label %" bm))
                          st7 (em-open (em-env-put st6 env0) be)]
                      (match (emit-vec-pair (clone e2) st7)
                        (EVRes [st8 ep el2 el3]
                          (let [ebr (em-cur st8)
                                st9 (em-line st8 (str "  br label %" bm))
                                st10 (em-open st9 bm)]
                            (match (em-ins2 st10
                                     (str "  ~ = phi ptr [ " tp ", %" tbr " ], [ " ep ", %" ebr " ]")
                                     (str "  ~ = phi i64 [ " tl ", %" tbr " ], [ " el2 ", %" ebr " ]"))
                              (ET2Res [st11 mp ml] (EVRes st11 mp ml (vec-elem-of ty)) )))))))))))))))
    (HMatch [scrut arms ty]
      (match-vec-pair scrut (clone arms) (vec-elem-of ty) st))
    (HLet [binds body frees]
      (match (emit-let (clone binds) st)
        (EURes [st2]
          (match (emit-vec-pair (clone body) st2)
            (EVRes [st3 p l el]
              (match (emit-frees (clone frees) st3)
                (EURes [st4] (EVRes st4 p l el))))))))

    (HSeq [es]
      (match (emit-stmts-ex-last (clone es) st)
        (ELRes [st2 last] (emit-vec-pair last st2))))

    (HConstI64 [v] (vf st (str "unsupported vector value site1 tag " (h-tag e))))
    (HConstF64 [v] (vf st (str "unsupported vector value site2 tag " (h-tag e))))
    (HConstB [v] (vf st (str "unsupported vector value site3 tag " (h-tag e))))
    (HStrLit [v] (vf st (str "unsupported vector value site4 tag " (h-tag e))))
    (HBinW [op a b ty] (vf st (str "unsupported vector value site5 tag " (h-tag e))))
    (HBinF [op a b] (vf st (str "unsupported vector value site6 tag " (h-tag e))))
    (HCmpW [op a b ty] (vf st (str "unsupported vector value site7 tag " (h-tag e))))
    (HStrCmp [pol a b] (vf st (str "unsupported vector value site8 tag " (h-tag e))))
    (HStrOrd [op a b] (vf st (str "unsupported vector value site9 tag " (h-tag e))))
    (HICast [x from to] (vf st (str "unsupported vector value site10 tag " (h-tag e))))
    (HCount [x] (vf st (str "unsupported vector value site11 tag " (h-tag e))))
    (HToStr [x ty] (vf st (str "unsupported vector value site12 tag " (h-tag e))))
    (HStrCat [args] (vf st (str "unsupported vector value site13 tag " (h-tag e))))
    (HSubs [s a b] (vf st (str "unsupported vector value site14 tag " (h-tag e))))
    (HJoin [sep xs] (vf st (str "unsupported vector value site15 tag " (h-tag e))))
    (HStrNth [s idx res] (vf st (str "unsupported vector value site16 tag " (h-tag e))))
    (HCharStr [x] (vf st (str "unsupported vector value site17 tag " (h-tag e))))
    (HGet [src idx dflt ty res] (vf st (str "unsupported vector value site18 tag " (h-tag e))))
    (HAnd [a b] (vf st (str "unsupported vector value site19 tag " (h-tag e))))
    (HOr [a b] (vf st (str "unsupported vector value site20 tag " (h-tag e))))
    (HNot [x] (vf st (str "unsupported vector value site21 tag " (h-tag e))))
    (HAbs [x ty] (vf st (str "unsupported vector value site22 tag " (h-tag e))))
    (HMin [a b ty] (vf st (str "unsupported vector value site23 tag " (h-tag e))))
    (HMax [a b ty] (vf st (str "unsupported vector value site24 tag " (h-tag e))))
    (HLoop [binds lty body]
      (match (emit-loop-node (clone binds) (clone lty) (clone body) st)
        (ESRes [st1 v]
          (match (em-ins2 st1
                   (str "  ~ = extractvalue %VecI64 " v ", 0")
                   (str "  ~ = extractvalue %VecI64 " v ", 1"))
            (ET2Res [st2 p l] (EVRes st2 p l (vec-elem-of lty)))))))
    (HRecur [args] (vf st (str "unsupported vector value site26 tag " (h-tag e))))
    (HCtor [adt variant args] (vf st (str "unsupported vector value site27 tag " (h-tag e))))
    (HDrop [x] (vf st (str "unsupported vector value site28 tag " (h-tag e))))
    (HClosure [sig mangled params caps body] (vf st (str "unsupported vector value site29 tag " (h-tag e))))
    (HClosureCall [f args sig] (vf st (str "unsupported vector value site30 tag " (h-tag e))))
    (HSlurp [p] (vf st (str "unsupported vector value site31 tag " (h-tag e))))
    (HSpit [path data] (vf st (str "unsupported vector value site32 tag " (h-tag e))))
    (HArgs [] (vf st (str "unsupported vector value site33 tag " (h-tag e))))
    (HExit [x] (vf st (str "unsupported vector value site34 tag " (h-tag e))))
    (HParseNum [s int res] (vf st (str "unsupported vector value site35 tag " (h-tag e))))))

(deftype EVPRes (EVPRes [st :- Emit ps :- EMPS ls :- EMPS]))

(defn match-vec-pair [scrut :- &HExpr arms :- HArms el :- i64 st :- Emit] :- EVRes
  (match (emit-adt (clone scrut) st)
    (ESRes [st1 sptr]
      (let [ai (adt-of scrut st1)
            name (em-adt-name st1 ai)]
        (match (em-ins2 st1
                 (str "~ = getelementptr inbounds %" name ", ptr " sptr ", i32 0, i32 0")
                 (str "~ = load i64, ptr ^1, align 8"))
          (ET2Res [st2 tg ttag]
            (match (em-blk2 st2)
              (ET2Res [st3 merged fail]
                (match (arm-labels-mint (arms-rev (clone arms) (EMLSNil)) st3 (ESlotsNil))
                  (ARes [st4 labels]
                    (let [dflt (mls-default (clone labels) fail)
                          st5 (em-line st4 (str "  switch i64 " ttag ", label %" dflt " ["))
                          st6 (mls-switch (clone labels) st5)
                          st7 (em-line st6 "]")
                            st8 (em-open st7 fail)
                            st9 (em-line st8 "  unreachable")]
                        (match (arm-vec-bodies arms labels st9 merged sptr ai name (em-env-get st9) (MPSNil) (MPSNil))
                          (EVPRes [st11 ps ls]
                            (let [st12 (em-open st11 merged)]
                            (match (em-ins2 st12
                                     (str "  ~ = phi ptr" (mps-items (mps-rev ps (MPSNil)) true))
                                     (str "  ~ = phi i64" (mps-items (mps-rev ls (MPSNil)) true)))
                              (ET2Res [st13 mp ml] (EVRes st13 mp ml el) )))))))) )) ))))))

; Vector-typed match arms: open the arm block, load fields, emit the
; vec pair, branch to merge, accumulate both phi chains.
; Vector-typed match arms: walk arms + labels together; each step
; opens the arm's block via arm-vec-one.
(defn arm-vec-bodies [arms :- HArms labels :- EMLS st :- Emit merged :- str
                      scrut :- str ai :- i64 name :- str env :- EEnv acc-p :- EMPS acc-l :- EMPS] :- EVPRes
  (match arms
    (HANil [] (EVPRes st acc-p acc-l))
    (HACons [variant binders body next]
      (match labels
        (EMLSCons [lvar lbl lrest]
          (match (arm-vec-one variant binders body next
                              lrest lbl st merged scrut ai name env acc-p acc-l)
            (EVPRes [st2 ps ls] (EVPRes st2 ps ls))))
        (_ (EVPRes st acc-p acc-l))))))

; One arm: opens its block, loads fields (non-wildcard only), emits the
; pair, branches, recurses.
(defn arm-vec-one [variant :- i64 binders :- Sids body :- HExpr next :- HArms
                   lrest :- EMLS lbl :- str st :- Emit merged :- str scrut :- str
                   ai :- i64 name :- str env :- EEnv acc-p :- EMPS acc-l :- EMPS] :- EVPRes
  (let [st0 (em-env-put st (clone env))
        st1 (em-open st0 lbl)
        st2 (if (= variant -1)
              st1
              (arm-field-loads binders ai variant 0 st1 scrut name))]
    (match (emit-vec-pair body st2)
      (EVRes [st3 p l el]
        (let [pred (em-cur st3)
              st4 (em-line st3 (str "  br label %" merged))]
          (match (arm-vec-bodies next lrest st4 merged scrut ai name env
                                  (MPSCons p pred acc-p) (MPSCons l pred acc-l))
            (EVPRes [st5 ps ls] (EVPRes st5 ps ls))))))))
(defn emit-get [src :- HExpr idx :- HExpr dflt :- HExprs ty :- Ty st :- Emit] :- ESRes
  (match (vec-arg src st)
    (EVRes [st1 d l el]
      (match (emit-int idx st1)
        (ESRes [st2 iv]
          (match (em-ins4 st2
                   (str "  ~ = icmp ult i64 " iv ", " l)
                   (str "  ~ = select i1 ^1, i64 " iv ", i64 0")
                   (str "  ~ = getelementptr inbounds " (elem-ll el) ", ptr " d ", i64 ^1")
                   (str "  ~ = load " (elem-ll el) ", ptr ^1, align 8"))
            (ET4Res [st3 inb safe p v]
              (if (hes-null dflt)
                (if (= (ty-tag ty) 0)
                  (match (em-ins st3 (str "  ~ = select i1 " inb ", " (elem-ll el) " " v ", " (elem-ll el) " 0"))
                    (ETRes [st4 r] (ESRes st4 r)))
                  (ESRes st3 v))
                (match (emit-typed (hes-first dflt) ty st3)
                  (ESRes [st4 dv]
                    (match (em-ins st4 (str "  ~ = select i1 " inb ", " (elem-ll el) " " v ", " (elem-ll el) " " dv))
                      (ETRes [st5 r] (ESRes st5 r)))))))))))))

(defn emit-get-str [src :- HExpr idx :- HExpr dflt :- HExprs st :- Emit] :- ESRes
  (match (vec-arg src st)
    (EVRes [st1 d l el]
      (match (emit-int idx st1)
        (ESRes [st2 iv]
          (match (em-ins4 st2
                   (str "  ~ = icmp ult i64 " iv ", " l)
                   (str "  ~ = select i1 ^1, i64 " iv ", i64 0")
                   (str "  ~ = getelementptr inbounds ptr, ptr " d ", i64 ^1")
                   (str "  ~ = load ptr, ptr ^1, align 8"))
            (ET4Res [st3 inb safe p v]
              (if (hes-null dflt)
                (match (em-ins st3 (str "  ~ = select i1 " inb ", ptr " v ", ptr null"))
                  (ETRes [st4 r] (ESRes st4 r)))
                (match (emit-str-val (hes-first dflt) st3)
                  (ESRes [st4 dv]
                    (match (em-ins st4 (str "  ~ = select i1 " inb ", ptr " v ", ptr " dv))
                      (ETRes [st5 r] (ESRes st5 r)))))))))))))

(defn emit-get-opt [src :- HExpr idx :- HExpr adt :- i64 st :- Emit] :- ESRes
  (match (vec-arg src st)
    (EVRes [st1 d l el]
      (match (emit-int idx st1)
        (ESRes [st2 iv]
          (match (em-ins4 st2
                   (str "  ~ = icmp ult i64 " iv ", " l)
                   (str "  ~ = select i1 ^1, i64 " iv ", i64 0")
                   (str "  ~ = getelementptr inbounds " (elem-ll el) ", ptr " d ", i64 ^1")
                   (str "  ~ = load " (elem-ll el) ", ptr ^1, align 8"))
            (ET4Res [st3 inb safe p payload]
              (materialize-option inb payload adt st3))))))))

(defn materialize-option [found :- str payload :- str adt :- i64 st :- Emit] :- ESRes
  (match st
    (Emit [c mdl sigs]
      (let [name (md-adt-name mdl adt)]
        (match (em-temp st)
          (ETRes [st1 slot]
            (let [st2 (em-pre st1 (str slot " = alloca %" name ", align 8"))]
              (match (em-ins2 st2
                       (str "~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 0")
                       (str "~ = select i1 " found ", i64 0, i64 1"))
                (ET2Res [st3 tf tag]
                  (let [st4 (em-line st3 (str "  store i64 " tag ", ptr " tf ", align 8"))]
                    (match (em-ins2 st4
                             (str "~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 0")
                             (str "~ = select i1 " found ", i64 " payload ", i64 0"))
                      (ET2Res [st5 pf pv]
                        (let [st6 (em-line st5 (str "  store i64 " pv ", ptr " pf ", align 8"))]
                          (ESRes st6 slot)) ))) )))))))))

(defn emit-strnth-raw [s :- HExpr idx :- HExpr st :- Emit] :- ESRes
  (match (emit-str-val s st)
    (ESRes [st1 sp]
      (match (emit-strlen sp st1)
        (ESRes [st2 len]
          (match (emit-int idx st2)
            (ESRes [st3 iv]
              (match (em-ins4 st3
                       (str "  ~ = icmp ult i64 " iv ", " len)
                       (str "  ~ = select i1 ^1, i64 " iv ", i64 0")
                       (str "  ~ = getelementptr inbounds i8, ptr " sp ", i64 ^1")
                       (str "  ~ = load i8, ptr ^1, align 1"))
                (ET4Res [st4 inb safe p b]
                  (match (em-ins2 st4
                           (str "  ~ = zext i8 " b " to i64")
                           (str "  ~ = select i1 " inb ", i64 ^2, i64 0"))
                    (ET2Res [st5 z r] (ESRes st5 r) )))))))))))

(defn emit-strnth-opt [s :- HExpr idx :- HExpr adt :- i64 st :- Emit] :- ESRes
  (match (emit-str-val s st)
    (ESRes [st1 sp]
      (match (emit-strlen sp st1)
        (ESRes [st2 len]
          (match (emit-int idx st2)
            (ESRes [st3 iv]
              (match (em-ins4 st3
                       (str "  ~ = icmp ult i64 " iv ", " len)
                       (str "  ~ = select i1 ^1, i64 " iv ", i64 0")
                       (str "  ~ = getelementptr inbounds i8, ptr " sp ", i64 ^1")
                       (str "  ~ = load i8, ptr ^1, align 1"))
                (ET4Res [st4 inb safe p b]
                  (match (em-ins st4 (str "  ~ = zext i8 " b " to i64"))
                    (ETRes [st5 z]
                      (materialize-option inb z adt st5))))))))))))

(deftype ECJRes (ECJRes [st :- Emit p :- str l :- str cp :- str freeable :- i64]))

(defn conj-source [v :- HExpr st :- Emit] :- ECJRes
  (match v
    (HVar [name]
      (match st
        (Emit [c mdl sigs]
          (if (fc-gr-has c name)
            (match (fc-gr-get c name)
              (GroVal [slot gel]
                (match (em-ins4 st
                         (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 0")
                         (str "  ~ = load ptr, ptr ^1, align 8")
                         (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 1")
                         (str "  ~ = load i64, ptr ^1, align 8"))
                  (ET4Res [st1 pf p lf l]
                    (match (em-ins2 st1
                             (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 2")
                             (str "  ~ = load i64, ptr ^1, align 8"))
                      (ET2Res [st2 cf cp] (ECJRes st2 p l cp 1) ))))))
            (match (vec-arg v st)
              (EVRes [st1 p l gel]
                (match (em-ins st1 (str "  ~ = add i64 " l ", 0"))
                  (ETRes [st2 cp] (ECJRes st2 p l cp 0)))))))))
    (_
      (match (vec-arg v st)
        (EVRes [st1 p l gel]
          (match (em-ins st1 (str "  ~ = add i64 " l ", 0"))
            (ETRes [st2 cp] (ECJRes st2 p l cp 0))))))))

(defn emit-conj [v :- HExpr x :- HExpr el :- i64 inplace :- i64 st :- Emit] :- ETRes
  (let [ll (elem-ll el)]
    (match (conj-source v st)
      (ECJRes [st1 p l cp freeable]
        (let [xr (if (= el 2)
                   (match (emit-str-val x st1)
                     (ESRes [st2 sv]
                       (match (em-ins st2 (str "  ~ = call ptr @strdup(ptr " sv ")"))
                         (ETRes [st3 t] (ETRes (em-decl st3 "declare ptr @strdup(ptr)") t)))))
                   (match (emit-typed x (elem-ty-of el) st1)
                     (ESRes [st2 xv] (ETRes st2 xv))))]
          (match xr
            (ETRes [st4 xv]
              (match (em-ins st4 (str "  ~ = add i64 " l ", 1"))
                (ETRes [st5 one]
                  (match (em-temp st5)
                    (ETRes [st6 slot]
                      (let [st7 (em-pre st6 (str slot " = alloca %VecI64, align 8"))]
                        (match (conj-branch inplace l cp st7)
                          (EH3Res [st8 bf bg bm]
                            (match (conj-fast st8 slot ll p l cp one xv bm el bf)
                              (EURes [st9]
                                (match (conj-grow st9 slot ll p l cp one xv el
                                                  (if (= inplace 1) freeable 0) bm bg)
                                  (EURes [st10]
                                    (ETRes (em-open st10 bm) slot)))))))))))))))))))

(deftype EH3Res (EH3Res [st :- Emit b1 :- str b2 :- str b3 :- str]))

(defn conj-branch [inplace :- i64 l :- str cp :- str st :- Emit] :- EH3Res
  (match (em-blk3 st)
    (ET3Res [st1 bf bg bm]
      (if (= inplace 1)
        (match (em-temp st1)
          (ETRes [st2 hr]
            (let [st3 (em-line st2 (str hr " = icmp ult i64 " l ", " cp))
                  st4 (em-line st3 (str "  br i1 " hr ", label %" bf ", label %" bg))]
              (EH3Res st4 bf bg bm)))) 
        (let [st2 (em-line st1 (str "  br i1 0, label %" bf ", label %" bg))]
          (EH3Res st2 bf bg bm))))))

(defn conj-fast [st :- Emit slot :- str ll :- str p :- str l :- str cp :- str
                 one :- str xv :- str bm :- str el :- i64 bf :- str] :- EURes
  (let [st0 (em-open st bf)]
  (match (em-ins st0 (str "  ~ = getelementptr inbounds " ll ", ptr " p ", i64 " l))
    (ETRes [st1 tail]
      (let [st2 (if (= el 2)
                  (em-line st1 (str "  store ptr " xv ", ptr " tail ", align 8"))
                  (em-line st1 (str "  store " ll " " xv ", ptr " tail ", align 8")))
            st3 (vec-slot-store slot p 0 st2)
            st4 (vec-slot-store slot one 1 st3)
            st5 (vec-slot-store slot cp 2 st4)
            st6 (em-line st5 (str "  br label %" bm))]
        (EURes st6))))))

(defn conj-grow [st :- Emit slot :- str ll :- str p :- str l :- str cp :- str
                 one :- str xv :- str el :- i64 freeable :- i64 bm :- str bg :- str] :- EURes
  (let [st0 (em-open st bg)]
  (match (em-ins3 st0
           (str "  ~ = mul i64 " cp ", 2")
           (str "  ~ = icmp uge i64 ^1, " one)
           (str "  ~ = select i1 ^1, i64 ^2, i64 " one))
    (ET3Res [st1 dbl ge newcap]
      (let [npr (if (and (= el 2) (= freeable 0))
                  (match (em-ins st1 (str "  ~ = call ptr @cato_str_vec_copy(ptr " p ", i64 " l ", i64 " newcap ")"))
                    (ETRes [st2 t] (ETRes (em-decl st2 "declare ptr @cato_str_vec_copy(ptr, i64, i64)") t)))
                  (match (em-ins st1 (str "  ~ = mul i64 " newcap ", 8"))
                    (ETRes [st2 nb]
                      (match (em-malloc st2 nb)
                        (ETRes [st3 npm]
                          (match (em-ins st3 (str "  ~ = mul i64 " l ", 8"))
                            (ETRes [st4 cb]
                              (ETRes (em-line st4 (str "  call void @llvm.memcpy.p0.p0.i64(ptr " npm ", ptr " p ", i64 " cb ", i1 false, i1 false)")) npm))))))))]
        (match npr
          (ETRes [st5 npm]
            (match (em-ins st5 (str "  ~ = getelementptr inbounds " ll ", ptr " npm ", i64 " l))
              (ETRes [st6 gp]
                (let [st7 (if (= el 2)
                            (em-line st6 (str "  store ptr " xv ", ptr " gp ", align 8"))
                            (em-line st6 (str "  store " ll " " xv ", ptr " gp ", align 8")))
                      st8 (if (= freeable 1)
                            (em-line st7 (str "  call void @free(ptr " p ")"))
                            st7)
                      st9 (vec-slot-store slot npm 0 st8)
                      st10 (vec-slot-store slot one 1 st9)
                      st11 (vec-slot-store slot newcap 2 st10)
                      st12 (em-line st11 (str "  br label %" bm))]
              (EURes st12)))))))))))
; adt.cato — S7: ADT value emission (constructors, field loads/stores,
; clone), the let-binding ladder, scope-exit frees, statements, and user
; calls — the port of the seed emitter's adt.rs, exprs_val.rs's
; emit_let, heap_vec.rs's free paths and calls.rs.

(defn ctor-tag-store [args :- HExprs adt :- i64 variant :- i64
                            name :- str slot :- str st :- Emit] :- ESRes
  (match (em-ins st (str "~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 0"))
    (ETRes [st1 tg]
      (let [st2 (em-line st1 (str "  store i64 " variant ", ptr " tg ", align 8"))]
        (match (ctor-store-args args adt variant 0 slot st2)
          (EURes [st3] (ESRes st3 slot)))))))

(defn emit-ctor [adt :- i64 variant :- i64 args :- HExprs st :- Emit] :- ESRes
  (match st
    (Emit [c mdl sigs]
      ; several reads of the module tables: the accessors consume their
      ; Mdl, so each read takes a fresh copy (per-ctor cost, not per-line)
      (let [name (md-adt-name mdl adt)
            boxed (md-owns-at mdl adt)
            slots (md-fs-total mdl adt)]
        (if (= boxed 1)
          (match (em-malloc st (str (* 8 (+ slots 1))))
            (ETRes [st1 slot] (ctor-tag-store args adt variant name slot st1)))
          (match (em-temp st)
            (ETRes [st1 slot]
              (let [st2 (em-pre st1 (str slot " = alloca %" name ", align 8"))]
                (ctor-tag-store args adt variant name slot st2)))))))))

(defn emit-clone-adt [x :- HExpr st :- Emit] :- ESRes
  (let [ai (adt-of x st)
        boxed (em-boxed-at st ai)
        name (em-adt-name st ai)]
    (if (= boxed 1)
      (match (emit-adt x st)
        (ESRes [st1 v]
          (match (em-ins st1 (str "  ~ = call ptr @clone__" name "(ptr " v ")"))
            (ETRes [st2 r] (ESRes st2 r)))))
      (match (emit-adt x st)
        (ESRes [st1 v]
          (match (em-temp st1)
            (ETRes [st2 slot]
              (let [st2a (em-pre st2 (str slot " = alloca %" name ", align 8"))]
                (match (em-ins st2a (str "~ = load %" name ", ptr " v ", align 8"))
                  (ETRes [st3 lv]
                    (let [st4 (em-line st3 (str "  store %" name " " lv ", ptr " slot ", align 8"))]
                      (ESRes st4 slot))))))))))))

(defn emit-adt [e :- HExpr st :- Emit] :- ESRes
  (match e
    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c v)]
            (match rv (RegVal [r ty] (ESRes st r)))))))
    (HCtor [adt variant args] (emit-ctor adt variant args st))
    (HClone [x] (emit-clone-adt x st))
    (HIf [c t e2 ty] (emit-if-node c t e2 ty st))
    (HMatch [scrut arms ty] (emit-match-node scrut arms ty st))
    (HLet [binds body frees]
      (match (emit-let binds st)
        (EURes [st2]
          (match (emit-adt body st2)
            (ESRes [st3 v]
              (match (emit-frees frees st3)
                (EURes [st4] (ESRes st4 v))))))))
    (HSeq [es]
      (match (emit-stmts-ex-last es st)
        (ELRes [st2 last] (emit-adt last st2))))
    (HStrNth [s idx res]
      (emit-strnth-opt s idx (ty-arg res) st))
    (HGet [src idx dflt ty res]
      (emit-get-opt src idx (ty-arg res) st))
    (HCall [name args] (call-user name args st))
    (HConstI64 [v] (sf st "expected an ADT expression"))
    (HConstF64 [v] (sf st "expected an ADT expression"))
    (HConstB [v] (sf st "expected an ADT expression"))
    (HStrLit [v] (sf st "expected an ADT expression"))
    (HVecLit [el vals] (sf st "expected an ADT expression"))
    (HBinW [op a b ty] (sf st "expected an ADT expression"))
    (HBinF [op a b] (sf st "expected an ADT expression"))
    (HCmpW [op a b ty] (sf st "expected an ADT expression"))
    (HStrCmp [pol a b] (sf st "expected an ADT expression"))
    (HStrOrd [op a b] (sf st "expected an ADT expression"))
    (HICast [x from to] (sf st "expected an ADT expression"))
    (HCount [x] (sf st "expected an ADT expression"))
    (HToStr [x ty] (sf st "expected an ADT expression"))
    (HStrCat [args] (sf st "expected an ADT expression"))
    (HSubs [s a b] (sf st "expected an ADT expression"))
    (HSplit [s sep] (sf st "expected an ADT expression"))
    (HJoin [sep xs] (sf st "expected an ADT expression"))
    (HCharStr [x] (sf st "expected an ADT expression"))
    (HConj [v x el inplace] (sf st "expected an ADT expression"))
    (HAnd [a b] (sf st "expected an ADT expression"))
    (HOr [a b] (sf st "expected an ADT expression"))
    (HNot [x] (sf st "expected an ADT expression"))
    (HAbs [x ty] (sf st "expected an ADT expression"))
    (HMin [a b ty] (sf st "expected an ADT expression"))
    (HMax [a b ty] (sf st "expected an ADT expression"))
    ; a loop completing with a boxed ADT (the reader's scan returns the
    ; RRes from its loop): the loop machinery's completing register
    (HLoop [binds ty body] (emit-loop-node binds ty body st))
    (HRecur [args] (sf st "recur outside loop"))
    (HDrop [x] (sf st "drop produces no ADT value"))
    (HClosure [sig mangled params caps body] (sf st "closure value must be bound with let"))
    (HClosureCall [f args sig] (sf st "expected an ADT expression"))
    (HSlurp [p] (sf st "expected an ADT expression"))
    (HSpit [path data] (sf st "expected an ADT expression"))
    (HArgs [] (sf st "expected an ADT expression"))
    (HExit [x] (sf st "expected an ADT expression"))
    ; parse-i64/parse-f64 in value position (e.g. a match scrutinee):
    ; the runtime's 16-byte Option box, a ptr the match consumes.
    (HParseNum [s int res]
      (match (emit-str-val s st)
        (ESRes [st1 sv]
          (let [helper (if (= int 1) "cato_parse_i64" "cato_parse_f64")
                decl (if (= int 1)
                       "declare ptr @cato_parse_i64(ptr)"
                       "declare ptr @cato_parse_f64(ptr)")]
            (match (em-ins st1 (str "  ~ = call ptr @" helper "(ptr " sv ")"))
              (ETRes [st2 p] (ESRes (em-decl st2 decl) p)))))))
    ))

; Destructure the argument chain directly: taking the head through
; `hes-first` retires the chain box, so reading the tail afterwards needed a
; copy of the whole remaining list per field.
(defn ctor-store-args [args :- HExprs adt :- i64 variant :- i64 k :- i64
                       slot :- str st :- Emit] :- EURes
  (match args
    (HENil [] (EURes st))
    (HECons [head tail]
      (match st
        (Emit [c mdl sigs]
          (let [fty (md-fs-field-ty mdl adt variant k)
                off (md-fs-off mdl adt variant k)]
            (match (emit-field-store head fty off adt slot st)
              (EURes [st2]
                (ctor-store-args tail adt variant (+ k 1) slot st2)))))))))

(defn emit-field-store [arg :- HExpr fty :- Ty off :- i64 ai :- i64
                        slot :- str st :- Emit] :- EURes
  (match st
    (Emit [c mdl sigs]
      (let [name (md-adt-name mdl ai)
            tg (ty-tag fty)]
        (cond
          (= tg 0)
          (match (emit-int (clone arg) st)
            (ESRes [st1 v]
              (match (em-ins2 st1
                       (str "  ~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off)
                       (str "  store i64 " v ", ptr ^1, align 8"))
                (ET2Res [st2 f s2] (EURes st2) ))))

          (= tg 1)
          (match (emit-int (clone arg) st)
            (ESRes [st1 v]
              (match (em-ins3 st1
                       (str "  ~ = sext i32 " v " to i64")
                       (str "  ~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off)
                       (str "  store i64 ^2, ptr ^1, align 8"))
                (ET3Res [st2 x f s2] (EURes st2)))))

          (= tg 9)
          (match (emit-float (clone arg) st)
            (ESRes [st1 v]
              (match (em-ins3 st1
                       (str "  ~ = bitcast double " v " to i64")
                       (str "  ~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off)
                       (str "  store i64 ^2, ptr ^1, align 8"))
                (ET3Res [st2 b f s2] (EURes st2)))))

          (= tg 11)
          (match (emit-bool (clone arg) st)
            (ESRes [st1 v]
              (match (em-ins3 st1
                       (str "  ~ = zext i1 " v " to i64")
                       (str "  ~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off)
                       (str "  store i64 ^2, ptr ^1, align 8"))
                (ET3Res [st2 z f s2] (EURes st2)))))

          (= tg 12)
          (match (emit-str-val (clone arg) st)
            (ESRes [st1 v]
              (match (em-ins st1 (str "  ~ = call ptr @strdup(ptr " v ")"))
                (ETRes [st2 copy]
                  (match (em-ins2 (em-decl st2 "declare ptr @strdup(ptr)")
                           (str "  ~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off)
                           (str "  ~ = ptrtoint ptr " copy " to i64"))
                    (ET2Res [st3 f x]
                      (EURes (em-line st3 (str "  store i64 " x ", ptr " f ", align 8"))) ))))))

          (= tg 15)
          (match (emit-vec-header (clone arg) st)
            (HRes [st1 p l cap]
              (match (em-ins st1 (str "  ~ = mul i64 " l ", 8"))
                (ETRes [st2 nlen]
                  (match (em-malloc st2 nlen)
                    (ETRes [st3 np]
                      (let [st4 (em-line st3 (str "  call void @llvm.memcpy.p0.p0.i64(ptr " np ", ptr " p ", i64 " nlen ", i1 false, i1 false)"))
                            st5 (vec-field-word name slot off 0 np st4)
                            st6 (vec-field-word name slot (+ off 1) 1 l st5)
                            st7 (vec-field-word name slot (+ off 2) 1 l st6)]
                        (EURes st7))))))))

          (= tg 16)
          (let [j (ty-arg fty)
                jboxed (md-owns-at mdl j)
                child (md-adt-name mdl j)]
            (match (emit-adt arg st)
              (ESRes [st1 v]
                (if (= jboxed 1)
                  (match (em-ins2 st1
                           (str "  ~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off)
                           (str "  ~ = ptrtoint ptr " v " to i64"))
                    (ET2Res [st2 f x]
                      (EURes (em-line st2 (str "  store i64 " x ", ptr " f ", align 8"))) ))
                  (match (em-ins2 st1
                           (str "  ~ = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off)
                           (str "  ~ = load %" child ", ptr " v ", align 8"))
                    (ET2Res [st2 f lv]
                      (EURes (em-line st2 (str "  store %" child " " lv ", ptr " f ", align 8"))) ))))))

          (EURes (do (cg-fail-i "unsupported ADT field type") st)))))))

(defn vec-field-word [name :- str slot :- str off :- i64 k :- i64 v :- str
                      st :- Emit] :- Emit
  (match (em-temp st)
    (ETRes [st1 f]
      (let [st2 (em-line st1 (str f " = getelementptr inbounds %" name ", ptr " slot ", i32 0, i32 1, i32 " off))]
        (if (= k 0)
          (match (em-ins st2 (str "~ = ptrtoint ptr " v " to i64"))
            (ETRes [st3 x] (em-line st3 (str "  store i64 " x ", ptr " f ", align 8"))))
          (em-line st2 (str "  store i64 " v ", ptr " f ", align 8")))))))

(defn emit-vec-header [arg :- HExpr st :- Emit] :- HRes
  (match arg
    (HVar [v]
      (match st
        (Emit [c mdl sigs]
          (if (fc-gr-has c v)
            (match (fc-gr-get c v)
              (GroVal [slot gel]
                (match (gr-slot-pl slot st)
                  (ET2Res [st1 p l] (HRes st1 p l l) ))))
            (match (fc-vc-get c v)
              (VecVal [p l el] (HRes st p l l)))))))
    (_
      (match (vec-arg arg st)
        (EVRes [st1 p l el]
          (match (vec-clone-buf p l el st1)
            (ETRes [st2 dp] (HRes st2 dp l l))))))))

(defn emit-field-load [binder :- i64 ai :- i64 vi :- i64 k :- i64 st :- Emit
                       scrut :- str name :- str] :- EURes
  (match st
    (Emit [c mdl sigs]
      (let [fty (md-fs-field-ty mdl ai vi k)
            off (md-fs-off mdl ai vi k)
            tg (ty-tag fty)]
        (cond
          (= tg 0)
          (match (em-ins2 st
                   (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off)
                   (str "~ = load i64, ptr ^1, align 8"))
            (ET2Res [st2 f v] (EURes (em-sc-put st2 binder v (t-i64))) ))

          (= tg 1)
          (match (em-ins3 st
                   (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off)
                   (str "~ = load i64, ptr ^1, align 8")
                   (str "~ = trunc i64 ^1 to i32"))
            (ET3Res [st3 f v t] (EURes (em-sc-put st3 binder t (t-i32)))))

          (= tg 9)
          (match (em-ins3 st
                   (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off)
                   (str "~ = load i64, ptr ^1, align 8")
                   (str "~ = bitcast i64 ^1 to double"))
            (ET3Res [st3 f v d] (EURes (em-sc-put st3 binder d (t-f64)))))

          (= tg 11)
          (match (em-ins3 st
                   (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off)
                   (str "~ = load i64, ptr ^1, align 8")
                   (str "~ = trunc i64 ^1 to i1"))
            (ET3Res [st3 f v b] (EURes (em-sc-put st3 binder b (t-bool)))))

          (= tg 12)
          (match (em-ins3 st
                   (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off)
                   (str "~ = load i64, ptr ^1, align 8")
                   (str "~ = inttoptr i64 ^1 to ptr"))
            (ET3Res [st3 f v p] (EURes (em-sc-put st3 binder p (t-str)))))

          (= tg 15)
          (match (em-temp st)
            (ETRes [st2 slot]
              (let [st3 (em-pre st2 (str slot " = alloca %VecI64, align 8"))]
                (match (field-load-vec-word off 0 slot scrut name st3)
                  (EURes [st4]
                    (match (field-load-vec-word (+ off 1) 1 slot scrut name st4)
                      (EURes [st5]
                        (match (field-load-vec-word (+ off 2) 2 slot scrut name st5)
                          (EURes [st6]
                            (EURes (em-gr-put st6 binder slot (ty-arg fty))))))))))))

          (= tg 16)
          (let [j (ty-arg fty)
                jboxed (md-owns-at mdl j)]
            (if (= jboxed 1)
              (match (em-ins3 st
                       (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off)
                       (str "~ = load i64, ptr ^1, align 8")
                       (str "~ = inttoptr i64 ^1 to ptr"))
                (ET3Res [st3 f v p] (EURes (em-sc-put st3 binder p (t-adt j)))))
              (match (em-ins st (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off))
                (ETRes [st2 f] (EURes (em-sc-put st2 binder f (t-adt j)))))))

          (EURes (do (cg-fail-i "unsupported ADT field type") st)))))))

(defn field-load-vec-word [off :- i64 k :- i64 slot :- str scrut :- str
                           name :- str st :- Emit] :- EURes
  (match (em-ins3 st
           (str "~ = getelementptr inbounds %" name ", ptr " scrut ", i32 0, i32 1, i32 " off)
           (str "~ = load i64, ptr ^1, align 8")
           (str "~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 " k))
    (ET3Res [st1 f raw dst]
      (if (= k 0)
        (match (em-ins st1 (str "~ = inttoptr i64 " raw " to ptr"))
          (ETRes [st2 p]
            (EURes (em-line st2 (str "  store ptr " p ", ptr " dst ", align 8")))))
        (EURes (em-line st1 (str "  store i64 " raw ", ptr " dst ", align 8")))))))

(defn emit-let [binds :- Binds st :- Emit] :- EURes
  (match binds
    (BNil [] (EURes st))
    (BCons [name value ty next]
      (match (emit-one-bind name value ty st)
        (EURes [st2] (emit-let next st2))))))

; Bind one name to one value: the seed's emit_let decision ladder.
(defn emit-one-bind [name :- i64 value :- HExpr ty :- Ty st :- Emit] :- EURes
  (let [vtag (h-tag value)
        ttag (ty-tag ty)]
    (cond
      (and (= vtag 39) (= ttag 15))
      (match (emit-vec-pair value st)
        (EVRes [st1 p l el] (EURes (em-vc-put st1 name p l el))))

      (= vtag 44)
      (match value
        (HParseNum [s int res]
          (match (emit-str-val (clone s) st)
            (ESRes [st1 sv]
              (let [helper (if (= int 1) "cato_parse_i64" "cato_parse_f64")
                    decl (if (= int 1)
                           "declare ptr @cato_parse_i64(ptr)"
                           "declare ptr @cato_parse_f64(ptr)")]
                (match (em-ins st1 (str "  ~ = call ptr @" helper "(ptr " sv ")"))
                  (ETRes [st2 p]
                    (EURes (em-sc-put (em-decl st2 decl) name p ty))))))))
        (_ (EURes st)))

      (= vtag 42)
      (match st
        (Emit [c mdl sigs]
          (match (em-temp st)
            (ETRes [st1 lptr]
              (let [st2 (em-pre st1 (str lptr " = alloca i64, align 8"))]
                (match (em-ins2 st2
                         (str "  ~ = call ptr @cato_args(ptr " lptr ")")
                         (str "  ~ = load i64, ptr " lptr ", align 8"))
                  (ET2Res [st3 arr l]
                    (EURes (em-vc-put (em-decl st3 "declare ptr @cato_args(ptr)")
                                      name arr l 2)) )))))))

      (and (= vtag 20) (= (ty-tag (hget-res (clone value))) 16))
      (match value
        (HGet [src idx dflt ty2 res]
          (match (emit-get-opt (clone src) (clone idx) (ty-arg res) st)
            (ESRes [st1 slot] (EURes (em-sc-put st1 name slot res)))))
        (_ (EURes st)))

      (and (= vtag 18) (= (ty-tag (hget-res (clone value))) 16))
      (match value
        (HStrNth [s idx res]
          (match (emit-strnth-opt (clone s) (clone idx) (ty-arg res) st)
            (ESRes [st1 slot] (EURes (em-sc-put st1 name slot res)))))
        (_ (EURes st)))

      (= vtag 21)
      (match value
        (HConj [v x el inplace]
          (match (emit-conj (clone v) (clone x) el inplace st)
            (ETRes [st1 slot] (EURes (em-gr-put st1 name slot el)))))
        (_ (EURes st)))

      (= vtag 14)
      (match value
        (HStrCat [args]
          (match (emit-strcat (clone args) st)
            (ESRes [st1 p] (EURes (em-sc-put st1 name p (t-str))))))
        (_ (EURes st)))

      (= vtag 15)
      (match value
        (HSubs [s a b]
          (match (emit-subs (clone s) (clone a) (clone b) st)
            (ESRes [st1 p] (EURes (em-sc-put st1 name p (t-str))))))
        (_ (EURes st)))

      (= vtag 16)
      (match value
        (HSplit [s sep]
          (match (emit-split (clone s) (clone sep) st)
            (EVRes [st1 arr l el] (EURes (em-vc-put st1 name arr l el)))))
        (_ (EURes st)))

      (= vtag 17)
      (match value
        (HJoin [sep xs]
          (match (emit-join (clone sep) (clone xs) st)
            (ESRes [st1 p] (EURes (em-sc-put st1 name p (t-str))))))
        (_ (EURes st)))

      (= ttag 17)
      (match (emit-closure-val value st)
        (ESRes [st1 v] (EURes (em-sc-put st1 name v ty))))

      (= ttag 15)
      (if (= vtag 3)
        (match value
          (HVar [src]
            (match st
              (Emit [c mdl sigs]
                (cond
                  (fc-gr-has c src)
                  (match (fc-gr-get c src)
                    (GroVal [slot el] (EURes (em-gr-put st name slot el))))
                  (fc-vc-has c src)
                  (match (fc-vc-get c src)
                    (VecVal [p l el] (EURes (em-vc-put st name p l el))))
                  (EURes (do (cg-fail-i "alias of unknown vector") st))))))
          (_ (EURes st)))
        (match (emit-vec-pair value st)
          (EVRes [st1 p l el] (EURes (em-vc-put st1 name p l el)))))

      (= ttag 16)
      (match (emit-adt value st)
        (ESRes [st1 v] (EURes (em-sc-put st1 name v ty))))

      (= ttag 9)  (match (emit-float value st)  (ESRes [st1 v] (EURes (em-sc-put st1 name v ty))))
      (= ttag 10) (match (emit-float value st)  (ESRes [st1 v] (EURes (em-sc-put st1 name v ty))))
      (= ttag 11) (match (emit-bool value st)   (ESRes [st1 v] (EURes (em-sc-put st1 name v ty))))
      (= ttag 12)
      ; a literal bind OWNS its string: strdup the constant (the free
      ; list frees the binding at scope exit / drop); non-literal values
      ; already produce an owned register.
      (match value
        (HStrLit [sv]
          (match (emit-str-val value st)
            (ESRes [st1 gep]
              (match (em-ins st1 (str "  ~ = call ptr @strdup(ptr " gep ")"))
                (ETRes [st2 sd] (EURes (em-sc-put st2 name sd ty)))))))
        (_
          (match (emit-str-val value st)
            (ESRes [st1 v] (EURes (em-sc-put st1 name v ty))))))
      (< ttag 12)
      (match (emit-int value st)
        (ESRes [st1 v] (EURes (em-sc-put st1 name v ty))))
      (EURes (do (cg-fail-i "unbound let type") st)))))

(defn hget-res [e :- HExpr] :- Ty
  (match e
    (HGet [src idx dflt ty res] res)
    (HStrNth [s idx res] res)
    (HParseNum [s int res] res)
    (HConstI64 [v] (t-none))
    (HConstF64 [v] (t-none))
    (HConstB [v] (t-none))
    (HVar [name] (t-none))
    (HStrLit [v] (t-none))
    (HVecLit [el vals] (t-none))
    (HBinW [op a b ty] (t-none))
    (HBinF [op a b] (t-none))
    (HCmpW [op a b ty] (t-none))
    (HStrCmp [pol a b] (t-none))
    (HStrOrd [op a b] (t-none))
    (HICast [x from to] (t-none))
    (HCount [x] (t-none))
    (HToStr [x ty] (t-none))
    (HStrCat [args] (t-none))
    (HSubs [s a b] (t-none))
    (HSplit [s sep] (t-none))
    (HJoin [sep xs] (t-none))
    (HCharStr [x] (t-none))
    (HConj [v x el inplace] (t-none))
    (HIf [c t e2 ty] (t-none))
    (HAnd [a b] (t-none))
    (HOr [a b] (t-none))
    (HNot [x] (t-none))
    (HAbs [x ty] (t-none))
    (HMin [a b ty] (t-none))
    (HMax [a b ty] (t-none))
    (HSeq [es] (t-none))
    (HLet [binds body frees] (t-none))
    (HLoop [binds ty body] (t-none))
    (HRecur [args] (t-none))
    (HCtor [adt variant args] (t-none))
    (HMatch [scrut arms ty] (t-none))
    (HClone [x] (t-none))
    (HDrop [x] (t-none))
    (HClosure [sig mangled params caps body] (t-none))
    (HClosureCall [f args sig] (t-none))
    (HCall [name args] (t-none))
    (HSlurp [p] (t-none))
    (HSpit [path data] (t-none))
    (HArgs [] (t-none))
    (HExit [x] (t-none))))

(defn emit-frees [frees :- Sids st :- Emit] :- EURes
  (if (sids-null frees)
    (EURes st)
    (match (free-binding-storage (sids-idx frees 0) st)
      (EURes [st2]
        (emit-frees (sids-drop frees 1) st2)))))

(defn free-binding-storage [k :- i64 st :- Emit] :- EURes
  (match st
    (Emit [c mdl sigs]
      (let [rv (fc-sc-get c k)]
        (match rv
          (RegVal [r ty]
            (let [tg (ty-tag ty)]
              (cond
                (= tg 12)
                (EURes (em-decl-line st (str "  call void @free(ptr " r ")")
                      "declare void @free(ptr)"))

                (= tg 16)
                (let [i (ty-arg ty)]
                  (if (= (md-owns-at mdl i) 1)
                    (let [nm (md-adt-name mdl i)]
                      (EURes (em-line st (str "  call void @drop__" nm "(ptr " r ")"))))
                    (fallthrough-free k st)))

                (= tg 17)
                (match (em-ins4 st
                         (str "  ~ = getelementptr inbounds %Closure, ptr " r ", i32 0, i32 1")
                         (str "  ~ = load ptr, ptr ^1, align 8")
                         (str "  ~ = getelementptr inbounds %Closure, ptr " r ", i32 0, i32 2")
                         (str "  ~ = load ptr, ptr ^1, align 8"))
                  (ET4Res [st2 ef env df dfn]
                    (EURes (em-line st2 (str "  call void " dfn "(ptr " env ")")))))

                (fallthrough-free k st))))
          (_ (fallthrough-free k st)))))))

(defn fallthrough-free [k :- i64 st :- Emit] :- EURes
  (match st
    (Emit [c mdl sigs]
      (if (fc-gr-has c k)
        (match (fc-gr-get c k)
          (GroVal [slot el]
            (match (em-ins2 st
                     (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 0")
                     (str "  ~ = load ptr, ptr ^1, align 8"))
              (ET2Res [st1 pf p]
                (EURes (em-decl-line st1 (str "  call void @free(ptr " p ")")
                      "declare void @free(ptr)")) ))))
        (EURes st)))))

(defn emit-stmt [e :- HExpr st :- Emit] :- EURes
  (match e
    (HCall [name args]
      (if (= name (s-printstr))
        (match args
          (HECons [harg hrest]
            (match (emit-str-val harg st)
              (ESRes [st1 v]
                (EURes (em-decl-line st1 (str "  call void @cato_print_str_raw(ptr " v ")")
                      "declare void @cato_print_str_raw(ptr)")))))
          (HENil [] (EURes st)))
        (match (emit-int e st)
          (ESRes [st1 v] (EURes st1)))))
    (HSpit [path data]
      (match (emit-str-val (clone path) st)
        (ESRes [st1 pv]
          (match (emit-str-val (clone data) st1)
            (ESRes [st2 dv]
              (EURes (em-decl-line st2 (str "  call void @cato_spit(ptr " pv ", ptr " dv ")")
                    "declare void @cato_spit(ptr, ptr)")))))))
    (HExit [x]
      (match (emit-int (clone x) st)
        (ESRes [st1 v]
          (EURes (em-decl-line st1 (str "  call void @cato_exit(i64 " v ")")
                "declare void @cato_exit(i64)")))))
    (HDrop [inner]
      (match inner
        (HVar [v] (free-binding-storage v st))
        (_ (EURes st))))
    (_
      (match (emit-int e st)
        (ESRes [st1 v] (EURes st1))))))

(deftype ECalls (CSNil) (CSCons [h :- str t :- ECalls]))
(deftype ECARes (ECARes [st :- Emit items :- ECalls]))

(defn call-user [name :- i64 args :- HExprs st :- Emit] :- ESRes
  (match st
    (Emit [c mdl sigs]
      (let [sg (sigs-lookup sigs name)]
        (match sg
          (ESig [params ret]
            ; everything the call line needs out of `mdl` is extracted
            ; before `st` moves into call-marshal: after that move the
            ; binders alias a box whose ownership left this arm
            (let [retag (ty-tag ret)
                  an (ty-arg ret)
                  boxed-ret (if (= retag 16)
                              (md-owns-at mdl an)
                              0)
                  anm (md-adt-name mdl an)
                  fname (md-sym mdl name)
                  ret-ll (cond
                           (= retag 11) "i1"
                           (< retag 12) (ll-scalar ret)
                           (= retag 12) "ptr"
                           (= retag 15) "%VecI64"
                           (= retag 16)
                           (if (= boxed-ret 1)
                             "ptr"
                             (str "%" anm))
                           "i64")]
              (match (call-marshal args params st (CSNil))
                (ECARes [st1 items]
                  (let [rev (cs-rev items (CSNil))]
                    (match (em-ins st1 (str "  ~ = call " ret-ll " @" (mangle fname)
                                            "(" (cs-join rev true) ")"))
                      (ETRes [st2 v]
                        (if (and (= retag 16) (= boxed-ret 0))
                          (match (em-temp st2)
                            (ETRes [st3 slot]
                              (let [st4 (em-pre st3 (str slot " = alloca %" anm ", align 8"))]
                                (ESRes (em-line st4 (str "  store %" anm " " v ", ptr " slot ", align 8")) slot))))
                          (ESRes st2 v))))))))))))))

(defn call-marshal [args :- HExprs params :- TyList st :- Emit acc :- ECalls] :- ECARes
  (match args
    (HENil [] (ECARes st acc))
    (HECons [kid next]
      (match params
        (TyCons [pty prest]
          (let [tg (ty-tag pty)]
            (cond
              (= tg 15)
              (match (emit-vec-pair (clone kid) st)
                (EVRes [st1 p l el]
                  (call-marshal (hes-rest args) prest st1
                                (CSCons (str "i64 " l) (CSCons (str "ptr " p) acc)))))

              (= tg 9)
              (match (emit-float (clone kid) st)
                (ESRes [st1 v] (call-marshal (hes-rest args) prest st1 (CSCons (str "double " v) acc))))

              (= tg 10)
              (match (emit-float (clone kid) st)
                (ESRes [st1 v] (call-marshal (hes-rest args) prest st1 (CSCons (str "float " v) acc))))

              (= tg 11)
              (match (emit-bool (clone kid) st)
                (ESRes [st1 v] (call-marshal (hes-rest args) prest st1 (CSCons (str "i1 " v) acc))))

              (= tg 12)
              (match (emit-str-val (clone kid) st)
                (ESRes [st1 v] (call-marshal (hes-rest args) prest st1 (CSCons (str "ptr " v) acc))))

              (= tg 17)
              (match kid
                (HVar [v]
                  (match st
                    (Emit [c mdl sigs]
                      (let [rv (fc-sc-get c v)]
                        (match rv
                          (RegVal [r rty]
                            (match (em-ins st (str "  ~ = load %Closure, ptr " r ", align 8"))
                              (ETRes [st1 lv]
                                (call-marshal (hes-rest args) prest st1 (CSCons (str "%Closure " lv) acc))))))))))
                (_ (ECARes (do (cg-fail-i "closure arg must be a var") st) acc)))
              (= tg 16)
              (match st
                (Emit [c mdl sigs]
                  ; the ADT name and boxedness come out of `mdl` before
                  ; `st` moves into emit-adt — the binders retire at the
                  ; move and are not readable after it
                  (let [j (ty-arg pty)
                        jboxed (md-owns-at mdl j)
                        nm (md-adt-name mdl j)]
                    (match (emit-adt (clone kid) st)
                      (ESRes [st1 v]
                        (if (= jboxed 1)
                          (call-marshal (hes-rest args) prest st1 (CSCons (str "ptr " v) acc))
                          (match (em-ins st1 (str "  ~ = load %" nm ", ptr " v ", align 8"))
                            (ETRes [st2 lv]
                              (call-marshal (hes-rest args) prest st2 (CSCons (str "%" nm " " lv) acc))))))))))

              (< tg 12)
              (match (emit-int (clone kid) st)
                (ESRes [st1 v]
                  (call-marshal (hes-rest args) prest st1
                                (CSCons (str (ll-scalar pty) " " v) acc))))

              (ECARes (do (cg-fail-i "unresolved type parameter in call args") st) acc))))
        (_ (ECARes (do (cg-fail-i "arg/param mismatch") st) acc))))))

(defn cs-rev [cs :- ECalls acc :- ECalls] :- ECalls
  (match cs
    (CSNil [] acc)
    (CSCons [h t] (cs-rev t (CSCons h acc)))))

(defn cs-join [cs :- ECalls first :- bool] :- str
  (match cs
    (CSNil [] "")
    (CSCons [h t]
      (if first
        (str h (cs-join t false))
        (str ", " h (cs-join t false))))))


; closures.cato — S7: first-class closures — the port of the seed
; emitter's closures.rs. A closure value is a %Closure {code, env, drop}
; alloca; the env block is one ownership-bitmap word plus the captures
; in slot order (1 slot for scalars/str/boxed ADT, 3 for collections
; and captured closures). @lambda_N loads captures back out of the env;
; @drop__lambda_N frees the owned ones per the bitmap, then the env.

(defn emit-closure-val [e :- HExpr st :- Emit] :- ESRes
  (match e
    (HClosure [sig mangled params caps body]
      (emit-closure-creation sig mangled caps st))
    (HLet [binds body frees]
      (match (emit-let binds st)
        (EURes [st2]
          (match (emit-closure-val body st2)
            (ESRes [st3 v]
              (match (emit-frees frees st3)
                (EURes [st4] (ESRes st4 v))))))))
    (HSeq [es]
      (match (emit-stmts-ex-last es st)
        (ELRes [st2 last] (emit-closure-val last st2))))
    (_ (sf st "expected a closure value"))))

; Env slots a capture occupies: collections and closures take 3.
(defn capture-slots [ty :- Ty] :- i64
  (let [tg (ty-tag ty)]
    (if (or (= tg 15) (= tg 17)) 3 1)))

(defn caps-slot-sum [cs :- Caps] :- i64
  (match cs
    (CNil [] 0)
    (CCons [name ty own next] (+ (capture-slots ty) (caps-slot-sum next)))))

(defn caps-bitmap [cs :- Caps i :- i64 acc :- i64] :- i64
  (match cs
    (CNil [] acc)
    (CCons [name ty own next]
      (caps-bitmap next (+ i 1)
                   (if (= own 1) (+ acc (shl1 i)) acc)))))

(defn shl1 [i :- i64] :- i64
  (if (= i 0) 1 (* 2 (shl1 (- i 1)))))

(defn clo-header-word [slot :- str k :- i64 v :- str st :- Emit] :- EURes
  (match (em-temp st)
    (ETRes [st1 f]
      (let [st2 (em-line st1 (str f " = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 " k))]
        (EURes (em-line st2 (str "  store ptr " v ", ptr " f ", align 8")))))))

(defn clo-header [slot :- str mname :- str env :- str st :- Emit] :- EURes
  (match (clo-header-word slot 0 (str "@" mname) st)
    (EURes [st1]
      (match (clo-header-word slot 1 env st1)
        (EURes [st2]
          (match (clo-header-word slot 2 (str "@drop__" mname) st2)
            (EURes [st3] (EURes st3))))))))

(defn capture-word [env :- str at :- i64 v :- str st :- Emit] :- EURes
  (match (em-temp st)
    (ETRes [st1 g]
      (let [st2 (em-line st1 (str g " = getelementptr inbounds i64, ptr " env ", i64 " at))]
        (EURes (em-line st2 (str "  store i64 " v ", ptr " g ", align 8")))))))

; ptr captures ride the i64 env words via ptrtoint (the load side
; inttoptrs them back out — the seed's phase-14 convention).
(defn capture-word-ptr [env :- str at :- i64 v :- str st :- Emit] :- EURes
  (match (em-ins st (str "  ~ = ptrtoint ptr " v " to i64"))
    (ETRes [st1 n] (capture-word env at n st1))))

(defn capture-header [name :- i64 ty :- Ty st :- Emit] :- ET3Res
  (match st
    (Emit [c mdl sigs]
      (if (fc-gr-has c name)
        (match (fc-gr-get c name)
          (GroVal [slot gel]
            (match (em-ins4 st
                     (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 0")
                     (str "  ~ = load ptr, ptr ^1, align 8")
                     (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 1")
                     (str "  ~ = load i64, ptr ^1, align 8"))
              (ET4Res [st1 f0 p f1 l]
                (match (em-ins2 st1
                         (str "  ~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 2")
                         (str "  ~ = load i64, ptr ^1, align 8"))
                  (ET2Res [st2 f2 cp] (ET3Res st2 p l cp) ))))))
          (match (fc-vc-get c name)
            (VecVal [p l el]
              (ET3Res st p l l)))))))

(defn store-captures [cs :- Caps env :- str at :- i64 st :- Emit] :- EURes
  (match cs
    (CNil [] (EURes st))
    (CCons [name ty own next]
      (match (store-one-capture name ty env at st)
        (EURes [st2]
          (store-captures next env (+ at (capture-slots ty)) st2))))))

(defn store-one-capture [name :- i64 ty :- Ty env :- str at :- i64 st :- Emit] :- EURes
  (let [tg (ty-tag ty)]
    (cond
      (= tg 15)
      (match (capture-header name ty st)
        (ET3Res [st1 p l cp]
          (match (capture-word-ptr env at p st1)
            (EURes [st2]
              (match (capture-word env (+ at 1) l st2)
                (EURes [st3]
                  (match (capture-word env (+ at 2) cp st3)
                    (EURes [st4] (EURes st4)))))))))

      (= tg 17)
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c name)]
            (match rv
              (RegVal [slot rty]
                (match (em-ins st (str "  ~ = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 0"))
                  (ETRes [st1 f0]
                    (match (em-ins st1 (str "  ~ = load ptr, ptr " f0 ", align 8"))
                      (ETRes [st2 w0]
                        (match (capture-word-ptr env at w0 st2)
                          (EURes [st3]
                            (match (em-ins st3 (str "  ~ = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 1"))
                              (ETRes [st4 f1]
                                (match (em-ins st4 (str "  ~ = load ptr, ptr " f1 ", align 8"))
                                  (ETRes [st5 w1]
                                    (match (capture-word-ptr env (+ at 1) w1 st5)
                                      (EURes [st6]
                                        (match (em-ins st6 (str "  ~ = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 2"))
                                          (ETRes [st7 f2]
                                            (match (em-ins st7 (str "  ~ = load ptr, ptr " f2 ", align 8"))
                                              (ETRes [st8 w2]
                                                (match (capture-word-ptr env (+ at 2) w2 st8)
                                                  (EURes [st9] (EURes st9))))))))))))))))))))))))

      (= tg 11)
      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c name)]
            (match rv
              (RegVal [v vty]
                (match (em-ins st (str "  ~ = zext i1 " v " to i8"))
                  (ETRes [st1 z]
                    (match (capture-word env at z st1)
                      (EURes [st2] (EURes st2))))))))))

      (match st
        (Emit [c mdl sigs]
          (let [rv (fc-sc-get c name)]
            (match rv
              (RegVal [v vty]
                (match (capture-word env at v st)
                  (EURes [st2] (EURes st2)))))))))))

(defn emit-closure-creation [sig :- i64 mangled :- i64 caps :- Caps
                             st :- Emit] :- ESRes
  (match st
    (Emit [c mdl sigs]
      (let [n (+ 1 (caps-slot-sum (clone caps)))
            mname (md-sym mdl mangled)]
        (match (em-ins2 st
                 (str "~ = add i64 " n ", 0")
                 (str "~ = mul i64 ^1, 8"))
          (ET2Res [st1 nreg nbytes]
            (match (em-malloc st1 nbytes)
              (ETRes [st2 env]
                (match (em-ins st2 (str "~ = getelementptr inbounds i64, ptr " env ", i64 0"))
                  (ETRes [st3 bw]
                    (let [st4 (em-line st3 (str "  store i64 " (caps-bitmap (clone caps) 0 0) ", ptr " bw ", align 8"))]
                      (match (store-captures caps env 1 st4)
                        (EURes [st5]
                          (match (em-temp st5)
                            (ETRes [st6 slot]
                              (let [st7 (em-pre st6 (str slot " = alloca %Closure, align 8"))]
                                (match (clo-header slot mname env st7)
                                  (EURes [st8] (ESRes st8 slot))))))))))))) ))))))

(defn clo-code-env [slot :- str st :- Emit] :- ET4Res
  (match (em-ins4 st
           (str "  ~ = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 0")
           (str "  ~ = load ptr, ptr ^1, align 8")
           (str "  ~ = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 1")
           (str "  ~ = load ptr, ptr ^1, align 8"))
    (ET4Res [st1 cf code ef env] (ET4Res st1 code env "" ""))))

(defn emit-closure-call [f :- &HExpr args :- HExprs sig :- i64 st :- Emit] :- ESRes
  (match st
    (Emit [c mdl sigs]
      (let [sg (md-esigs-at mdl sig)]
        (match sg
          (ESig [ptys ret]
            (match f
              (HVar [v]
                (match st
                  (Emit [c2 mdl2 sigs2]
                    (let [rv (fc-sc-get c2 v)]
                      (match rv
                        (RegVal [fslot fty]
                          (match (clo-code-env fslot st)
                            (ET4Res [st1 code env x y]
                              (match (cc-marshal args (clone ptys) st1 (CSCons (str "ptr " env) (CSNil)))
                                (ECARes [st2 items]
                                  (let [rev (cs-rev items (CSNil))
                                        pl (str "ptr" (cc-param-list ptys))
                                        retag (ty-tag ret)
                                        ret-ll (cond
                                                 (= retag 11) "i1"
                                                 (= retag 12) "ptr"
                                                 (= retag 9) "double"
                                                 (= retag 10) "float"
                                                 (< retag 12) (ll-scalar ret)
                                                 "i64")]
                                    (match (em-ins st2 (str "  ~ = call " ret-ll " (" pl ") " code "(" (cs-join rev true) ")"))
                                      (ETRes [st3 r] (ESRes st3 r))))))))))))))
              (_ (sf st "closure callee must be a var")))))))))

; The Mdl parameter was never read; dropping it lets a borrowed Mdl be
; searched without copying the whole signature table first.
(defn esigs-at [ss :- &Sigs i :- i64] :- ESig
  (match ss
    (SGCons [h t]
      (match h
        (Sig [params ret]
          (if (= i 0)
            (ESig (clone params) (clone ret))
            (esigs-at t (- i 1))))))
    (SGNil [] (ESig (TyNil) (t-none)))))

(defn cc-marshal [args :- HExprs ptys :- TyList st :- Emit acc :- ECalls] :- ECARes
  (match args
    (HENil [] (ECARes st acc))
    (HECons [kid next]
      (match ptys
        (TyCons [pty prest]
          (let [tg (ty-tag pty)]
            (cond
              (= tg 9)
              (match (emit-float (clone kid) st)
                (ESRes [st1 v] (cc-marshal (hes-rest args) (clone prest) st1 (CSCons (str "double " v) acc))))
              (= tg 10)
              (match (emit-float (clone kid) st)
                (ESRes [st1 v] (cc-marshal (hes-rest args) (clone prest) st1 (CSCons (str "float " v) acc))))
              (= tg 11)
              (match (emit-bool (clone kid) st)
                (ESRes [st1 v] (cc-marshal (hes-rest args) (clone prest) st1 (CSCons (str "i1 " v) acc))))
              (= tg 12)
              (match (emit-str-val (clone kid) st)
                (ESRes [st1 v] (cc-marshal (hes-rest args) (clone prest) st1 (CSCons (str "ptr " v) acc))))
              (< tg 12)
              (match (emit-int (clone kid) st)
                (ESRes [st1 v]
                  (cc-marshal (hes-rest args) prest st1 (CSCons (str (ll-scalar pty) " " v) acc))))
              (ECARes (do (cg-fail-i "closure arg type not supported") st) acc))))
        (_ (ECARes (do (cg-fail-i "closure arg/param mismatch") st) acc))))))

(defn cc-param-list [ptys :- TyList] :- str
  (match ptys
    (TyNil [] "")
    (TyCons [h t]
      (let [tg (ty-tag h)]
        (str ", " (cond
                    (= tg 9) "double"
                    (= tg 10) "float"
                    (= tg 11) "i1"
                    (= tg 12) "ptr"
                    (< tg 12) (ll-scalar h)
                    "i64")
             (cc-param-list t))))))


; emit.cato — S7: module assembly — the port of the seed emitter's
; mod.rs + funcs.rs + the adt.rs glue generators. Output shape: header,
; %VecI64/%Closure/ADT types, the deduplicated declare chain (fixed
; runtime declares are seeded before emission), literal globals,
; clone/drop glue, plain defns (main keeps the i32 ABI with argv
; plumbing), extern declares, lambda bodies + their drop glue.

(defn facts-owns-of [adts :- AdtTab] :- Sids
  (match (facts-compute adts)
    (Facts [owns] owns)))

(defn md-seed-decls [m :- Mdl] :- Mdl
  (md-decl
    (md-decl
      (md-decl
        (md-decl
          (md-decl
            (md-decl
              (md-decl
                (md-decl
                  (md-decl
                    (md-decl
                      (md-decl
                        (md-decl
                          (md-decl
                            (md-decl (md-decl (md-decl m "declare void @cato_args_init(i32, ptr)") "declare ptr @cato_args(ptr)") "declare ptr @malloc(i64)")
                            "declare void @free(ptr)")
                          "declare ptr @strdup(ptr)")
                        "declare ptr @cato_str_vec_copy(ptr, i64, i64)")
                      "declare void @cato_str_vec_free(ptr, i64)")
                    "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1, i1)")
                  "declare i64 @strlen(ptr)")
                "declare i32 @strcmp(ptr, ptr)")
              "declare void @cato_print_f64(double)")
            "declare void @cato_print_i64(i64)")
          "declare void @cato_print_string(ptr)")
        "declare void @cato_print_str_raw(ptr)")
      "declare ptr @cato_slurp(ptr)")
    "declare void @cato_spit(ptr, ptr)"))

(defn md-globals [m :- &Mdl] :- StrBuf
  (match m (Mdl [tab g globals decls adts owns csigs] (clone globals))))

(defn adt-name-at [adts :- AdtTab i :- i64 tab :- i64] :- str
  (match (adts-at adts i)
    (AdtInfo [name tps variants tpl tplargs] (sym-str (clone tab) name))))

(defn adt-type-lines [adts :- AdtTab owns :- Sids i :- i64 tab :- i64
                      sb :- StrBuf] :- StrBuf
  (if (>= i (adts-depth adts))
    sb
    (let [nm (adt-name-at (clone adts) i (clone (clone tab)))
          n (fs-total adts owns i)]
      (adt-type-lines adts owns (+ i 1) tab
                      (sb-add-line sb (str "%" nm " = type { i64, [" n " x i64] }"))))))

(defn adt-glue [adts :- AdtTab owns :- Sids i :- i64 tab :- i64
                sb :- StrBuf] :- StrBuf
  (if (>= i (adts-depth adts))
    sb
    (let [sb1 (if (= (sids-idx owns i) 1)
                (sb-add-line
                  (sb-add-line
                    (sb-add-line
                      (sb-add-line sb (adt-clone-text (clone adts) (clone owns) i (clone (clone tab))))
                      (adt-drop-text (clone adts) (clone owns) i (clone (clone tab))))
                    "")
                  "")
                sb)]
      (adt-glue adts owns (+ i 1) (clone tab) sb1))))

(defn glue-switch [adts :- AdtTab i :- i64 vi :- i64 dflt :- str] :- str
  (if (>= vi (vlist-depth (adts-variants-at adts i)))
    (if (> vi 0)
      (str "  ]\n")
      "")
    (str (if (= vi 0)
           (str "  switch i64 %tag, label %" dflt " [\n")
           "")
         "    i64 " vi ", label %v" vi "\n"
         (glue-switch adts i (+ vi 1) dflt))))

(defn adt-clone-text [adts :- AdtTab owns :- Sids i :- i64 tab :- i64] :- str
  (let [nm (adt-name-at (clone adts) i (clone (clone tab)))
        slots (fs-total adts owns i)
        nv (vlist-depth (adts-variants-at adts i))]
    (str "define ptr @clone__" nm "(ptr %src) {\n"
         "entry:\n"
         "  %box = call ptr @malloc(i64 " (* 8 (+ slots 1)) ")\n"
         "  %tag = load i64, ptr %src\n"
         "  store i64 %tag, ptr %box\n"
         (glue-switch (clone adts) i 0 "merge")
         (if (> nv 0)
           "bad:\n  unreachable\n\n"
           "")
         (adt-clone-variants adts owns i 0 (clone (clone tab)))
         "merge:\n  ret ptr %box\n}\n")))

(defn adt-clone-variants [adts :- AdtTab owns :- Sids i :- i64 vi :- i64
                          tab :- i64] :- str
  (if (>= vi (vlist-depth (adts-variants-at adts i)))
    ""
    (str "v" vi ":\n"
         (adt-clone-fields (clone adts) (clone owns) i vi 0 0 (clone tab) "")
         "  br label %merge\n\n"
         (adt-clone-variants adts owns i (+ vi 1) (clone tab)))))

(defn adt-clone-fields [adts :- AdtTab owns :- Sids i :- i64 vi :- i64 k :- i64
                        serial :- i64 tab :- i64 acc :- str] :- str
  (if (>= k (tys-depth (varnt-fields-at adts i vi)))
    acc
    (let [fty (fs-field-ty adts i vi k)
          off (fs-off adts owns i vi k)
          nm (adt-name-at (clone adts) i (clone tab))
          tg (ty-tag fty)]
      (adt-clone-fields (clone adts) (clone owns) i vi (+ k 1) (+ serial 1) (clone tab)
                        (str acc (clone-field-text fty off nm adts owns vi serial tg (clone tab)))))))

(defn clone-field-text [fty :- Ty off :- i64 nm :- str adts :- AdtTab
                        owns :- Sids vi :- i64 serial :- i64 tg :- i64 tab :- i64] :- str
  (let [u (str "v" vi "f" serial)]
    (cond
      (= tg 12)
      (str "  %sp" u " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " off "\n"
           "  %sl" u " = load i64, ptr %sp" u "\n"
           "  %sptr" u " = inttoptr i64 %sl" u " to ptr\n"
           "  %sdup" u " = call ptr @strdup(ptr %sptr" u ")\n"
           "  %dp" u " = getelementptr inbounds %" nm ", ptr %box, i32 0, i32 1, i32 " off "\n"
           "  %ni" u " = ptrtoint ptr %sdup" u " to i64\n"
           "  store i64 %ni" u ", ptr %dp" u "\n")

      (= tg 15)
      (let [el (ty-arg fty)
            cp (if (= el 2)
                 (str "  %vcp" u " = call ptr @cato_str_vec_copy(ptr %vptr" u ", i64 %vl" u "k1, i64 %vl" u "k2)\n")
                 (str "  %vnb" u " = mul i64 %vl" u "k2, 8\n"
                      "  %vcp" u " = call ptr @malloc(i64 %vnb" u ")\n"
                      "  %vcb" u " = mul i64 %vl" u "k1, 8\n"
                      "  call void @llvm.memcpy.p0.p0.i64(ptr %vcp" u ", ptr %vptr" u ", i64 %vcb" u ", i1 false, i1 false)\n"))]
        (str "  %vp" u " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " off "\n"
             "  %vl" u "k0 = load i64, ptr %vp" u "\n"
             "  %vf" u "k1 = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " (+ off 1) "\n"
             "  %vl" u "k1 = load i64, ptr %vf" u "k1\n"
             "  %vf" u "k2 = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " (+ off 2) "\n"
             "  %vl" u "k2 = load i64, ptr %vf" u "k2\n"
             "  %vptr" u " = inttoptr i64 %vl" u "k0 to ptr\n"
             cp
             "  %vd" u "k0 = getelementptr inbounds %" nm ", ptr %box, i32 0, i32 1, i32 " off "\n"
             "  %vni" u "k0 = ptrtoint ptr %vcp" u " to i64\n"
             "  store i64 %vni" u "k0, ptr %vd" u "k0\n"
             "  %vd" u "k1 = getelementptr inbounds %" nm ", ptr %box, i32 0, i32 1, i32 " (+ off 1) "\n"
             "  store i64 %vl" u "k1, ptr %vd" u "k1\n"
             "  %vd" u "k2 = getelementptr inbounds %" nm ", ptr %box, i32 0, i32 1, i32 " (+ off 2) "\n"
             "  store i64 %vl" u "k2, ptr %vd" u "k2\n"))

      (= tg 16)
      (let [j (ty-arg fty)]
        (if (= (sids-idx owns j) 1)
          (let [child (adt-name-at (clone adts) j (clone tab))]
            (str "  %sp" u " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " off "\n"
                 "  %sl" u " = load i64, ptr %sp" u "\n"
                 "  %sc" u " = inttoptr i64 %sl" u " to ptr\n"
                 "  %nc" u " = call ptr @clone__" child "(ptr %sc" u ")\n"
                 "  %dp" u " = getelementptr inbounds %" nm ", ptr %box, i32 0, i32 1, i32 " off "\n"
                 "  %ni" u " = ptrtoint ptr %nc" u " to i64\n"
                 "  store i64 %ni" u ", ptr %dp" u "\n"))
          (adt-clone-words nm off (fs-count (clone fty) owns adts) u)))

      (adt-clone-words nm off (fs-count fty owns adts) u))))

(defn adt-clone-words [nm :- str off :- i64 cnt :- i64 u :- str] :- str
  (if (= cnt 0)
    ""
    (str "  %sp" u "k" (- cnt 1) " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " (+ off (- cnt 1)) "\n"
         "  %sl" u "k" (- cnt 1) " = load i64, ptr %sp" u "k" (- cnt 1) "\n"
         "  %dp" u "k" (- cnt 1) " = getelementptr inbounds %" nm ", ptr %box, i32 0, i32 1, i32 " (+ off (- cnt 1)) "\n"
         "  store i64 %sl" u "k" (- cnt 1) ", ptr %dp" u "k" (- cnt 1) "\n"
         (adt-clone-words nm off (- cnt 1) u))))

(defn adt-drop-text [adts :- AdtTab owns :- Sids i :- i64 tab :- i64] :- str
  (let [nm (adt-name-at (clone adts) i (clone tab))]
    (str "define void @drop__" nm "(ptr %src) {\n"
         "entry:\n"
         "  %tag = load i64, ptr %src\n"
         (glue-switch (clone adts) i 0 "bad")
         "bad:\n  unreachable\n\n"
         (adt-drop-variants adts owns i 0 (clone tab))
         "freebox:\n  call void @free(ptr %src)\n  ret void\n"
         "done:\n  ret void\n"
         "}\n")))

(defn adt-drop-variants [adts :- AdtTab owns :- Sids i :- i64 vi :- i64
                         tab :- i64] :- str
  (if (>= vi (vlist-depth (adts-variants-at adts i)))
    ""
    (let [tail (if (> (vlist-depth (adts-variants-at adts i)) 0) "freebox" "done")]
      (str "v" vi ":\n"
           (adt-drop-fields (clone adts) (clone owns) i vi 0 0 (clone tab) "")
           "  br label %" tail "\n\n"
           (adt-drop-variants adts owns i (+ vi 1) (clone tab))))))

(defn adt-drop-fields [adts :- AdtTab owns :- Sids i :- i64 vi :- i64 k :- i64
                       serial :- i64 tab :- i64 acc :- str] :- str
  (if (>= k (tys-depth (varnt-fields-at adts i vi)))
    acc
    (let [fty (fs-field-ty adts i vi k)
          off (fs-off adts owns i vi k)
          nm (adt-name-at (clone adts) i (clone tab))
          tg (ty-tag fty)]
      (adt-drop-fields (clone adts) (clone owns) i vi (+ k 1) (+ serial 1) (clone tab)
                       (str acc (drop-field-text fty off nm adts owns vi serial tg (clone tab)))))))

(defn drop-field-text [fty :- Ty off :- i64 nm :- str adts :- AdtTab
                       owns :- Sids vi :- i64 serial :- i64 tg :- i64 tab :- i64] :- str
  (let [u (str "v" vi "f" serial)]
    (cond
      (= tg 12)
      (str "  %fp" u " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " off "\n"
           "  %fl" u " = load i64, ptr %fp" u "\n"
           "  %fv" u " = inttoptr i64 %fl" u " to ptr\n"
           "  call void @free(ptr %fv" u ")\n")

      (= tg 15)
      (let [el (ty-arg fty)]
        (str "  %vp" u " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " off "\n"
             "  %vl" u " = load i64, ptr %vp" u "\n"
             "  %vv" u " = inttoptr i64 %vl" u " to ptr\n"
             (if (= el 2)
               (str "  %vn" u " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " (+ off 1) "\n"
                    "  %vc" u " = load i64, ptr %vn" u "\n"
                    "  call void @cato_str_vec_free(ptr %vv" u ", i64 %vc" u ")\n")
               (str "  call void @free(ptr %vv" u ")\n"))))

      (= tg 16)
      (let [j (ty-arg fty)]
        (if (= (sids-idx owns j) 1)
          (let [child (adt-name-at adts j (clone tab))]
            (str "  %cp" u " = getelementptr inbounds %" nm ", ptr %src, i32 0, i32 1, i32 " off "\n"
                 "  %cl" u " = load i64, ptr %cp" u "\n"
                 "  %cv" u " = inttoptr i64 %cl" u " to ptr\n"
                 "  call void @drop__" child "(ptr %cv" u ")\n"))
          ""))

      "")))

(deftype EOut (EOut [sb :- StrBuf]))
(deftype EORes (EORes [st :- Emit out :- EOut]))

(defn emit-program [adts :- AdtTab defs :- Defns lams :- Lams csigs :- Sigs
                    tab :- i64] :- str
  (do
  (let [owns (facts-owns-of (clone adts))
        sigs (sigs-build (clone defs) (ESTNil))
        st0 (match (em-new (clone tab) (clone adts) (clone owns) csigs sigs)
              (Emit [c m s] (Emit c (md-seed-decls m) s)))]
    (match (emit-defns defs st0 (EOut (sb-new)))
      (EORes [st1 out1]
        (do
        (match (emit-lams lams st1 out1)
          (EORes [st2 out2]
            (do
            (let [mdl (match st2 (Emit [c m s] m))
                  sb1 (sb-add-line (sb-new) "; cato: kernel LLVM IR (S7)")
                  sb2 (sb-add-line sb1 "%VecI64 = type { ptr, i64, i64 }")
                  sb3 (sb-add-line sb2 "%Closure = type { ptr, ptr, ptr }")
                  sb4 (adt-type-lines (clone adts) (clone owns) 0 (clone tab) sb3)
                  sb5 (md-decls-lines mdl sb4)
                  sb6 (sb-add-line sb5 (sb-str (md-globals mdl)))
                  sb7 (adt-glue adts owns 0 (clone tab) sb6)]
              (do
              (sb-str (sb-add-line sb7 (sb-str (out2-sb out2)))))))))))))))

(defn out2-sb [o :- EOut] :- StrBuf
  (match o (EOut [sb] sb)))

(defn extern-ret-ll [ret :- Ty] :- str
  (let [tg (ty-tag ret)]
    (cond
      (= tg 0) "i64"
      (= tg 9) "double"
      (= tg 11) "i1"
      (= tg 12) "ptr"
      (do (cg-fail-i "extern return must be i64, f64, bool or str") "i64"))))

(defn extern-params [params :- PList] :- str
  (match params
    (PNil [] "")
    (PCons [h t]
      (match h
        (Param [name ty _pb]
          (let [tg (ty-tag ty)]
            (cond
              (= tg 15) (extern-params-rest (clone t) "ptr noalias nocapture readonly %data, i64 %len")
              (= tg 9) (extern-params-rest (clone t) "double")
              (= tg 11) (extern-params-rest (clone t) "i1")
              (= tg 12) (extern-params-rest (clone t) "ptr")
              (< tg 12) (extern-params-rest t (ll-scalar ty))
              (do (cg-fail-i "extern params must be scalars, strings or vectors") ""))))))))

(defn extern-params-rest [params :- PList acc :- str] :- str
  (match params
    (PNil [] acc)
    (PCons [h t]
      (match h
        (Param [name ty _pb]
          (let [tg (ty-tag ty)]
            (cond
              (= tg 15) (extern-params-rest (clone t) (str acc ", ptr noalias nocapture readonly %data, i64 %len"))
              (= tg 9) (extern-params-rest (clone t) (str acc ", double"))
              (= tg 11) (extern-params-rest (clone t) (str acc ", i1"))
              (= tg 12) (extern-params-rest (clone t) (str acc ", ptr"))
              (< tg 12) (extern-params-rest t (str acc ", " (ll-scalar ty)))
              (do (cg-fail-i "extern params must be scalars, strings or vectors") acc))))))))

(deftype EDRes (EDRes [st :- Emit text :- str]))
(deftype ELPR (ELPR [mdl :- Mdl text :- str drop-text :- str]))

(defn fn-text [header :- str c :- FnCtx tail :- str] :- str
  (match c
    (FnCtx [tmpc blkc cur body pre sc ve gr lfr]
      (str header "entry:\n"
           (sb-str pre)
           (sb-str body)
           tail))))

(defn emit-defns [ds :- Defns st :- Emit out :- EOut] :- EORes
  (match ds
    (DNil [] (EORes st out))
    (DCons [h t]
      (match h
        (Defn [name params ret isextern body rb]
          (match st
            (Emit [c mdl sigs]
              (if (= isextern 1)
                ; externs join the deduplicated up-front declares block
                ; (the seed's Vec::contains chain), not the function text.
                (let [line (str "declare " (extern-ret-ll ret) " @"
                                (mangle (md-sym mdl name))
                                "(" (extern-params params) ")")]
                  (emit-defns t (em-decl st line) out))
                (match (emit-plain name params (clone ret) body
                                   (Emit (fn-new) mdl sigs))
                  (EDRes [st2 text]
                    (emit-defns t st2
                                (EOut (sb-add-line
                                       (sb-add-line (out2-sb out) text)
                                       "")))))))))))))

(defn param-scalar [t :- PList pname :- i64 pty :- Ty r :- str ll :- str
                    acc :- str st :- Emit] :- ET2Res
  (let [p2 (if (> (count acc) 0)
             (str acc ", " ll " " r)
             (str acc ll " " r))]
    (match (defn-params t (em-sc-put st pname r pty) p2)
      (ET2Res [st2 acc2 _] (ET2Res st2 acc2 "") ))))

(defn defn-params [ps :- PList st :- Emit acc :- str] :- ET2Res
  (match ps
    (PNil [] (ET2Res st acc ""))
    (PCons [h t]
      (match h
        (Param [pname pty _pb]
          (match st
            (Emit [c mdl sigs]
              (let [nstr (md-sym mdl pname)
                    r (str "%" (mangle nstr))
                    tg (ty-tag pty)]
                (cond
                  (= tg 15)
                  (let [el (ty-arg pty)
                        d (str "%" (mangle nstr) "_data")
                        l (str "%" (mangle nstr) "_len")
                        p2 (if (> (count acc) 0)
                             (str acc ", ptr noalias nocapture readonly " d ", i64 " l)
                             (str acc "ptr noalias nocapture readonly " d ", i64 " l))]
                    (match (defn-params (clone t) (em-vc-put st pname d l el) p2)
                      (ET2Res [st2 acc2 _] (ET2Res st2 acc2 ""))))

                  (= tg 17)
                  (let [p2 (if (> (count acc) 0)
                             (str acc ", %Closure " r)
                             (str acc "%Closure " r))]
                    (match (em-temp st)
                      (ETRes [st1 slot]
                        (match (em-ins st1 (str "~ = alloca %Closure, align 8"))
                          (ETRes [st2 slot2]
                            (let [st3 (em-line st2 (str "  store %Closure " r ", ptr " slot2 ", align 8"))]
                              (match (defn-params (clone t) (em-sc-put st3 pname slot2 pty) p2)
                                (ET2Res [st4 acc2 _] (ET2Res st4 acc2 "")))))))))

                  (= tg 16)
                  (let [boxed (md-owns-at mdl (ty-arg pty))]
                    (if (= boxed 1)
                      (let [p2 (if (> (count acc) 0)
                                 (str acc ", ptr " r)
                                 (str acc "ptr " r))]
                        (match (defn-params (clone t) (em-sc-put st pname r pty) p2)
                          (ET2Res [st2 acc2 _] (ET2Res st2 acc2 ""))))
                      (let [nm (md-adt-name mdl (ty-arg pty))
                            p2 (if (> (count acc) 0)
                                 (str acc ", %" nm " " r)
                                 (str acc "%" nm " " r))]
                        (match (em-temp st)
                          (ETRes [st1 slot]
                            (let [st2 (em-pre st1 (str slot " = alloca %" nm ", align 8"))
                                  st3 (em-line st2 (str "  store %" nm " " r ", ptr " slot ", align 8"))]
                              (match (defn-params (clone t) (em-sc-put st3 pname slot pty) p2)
                                (ET2Res [st4 acc2 _] (ET2Res st4 acc2 "")))))))))

                  (= tg 9) (param-scalar (clone t) pname pty r "double" acc st)
                  (= tg 10) (param-scalar (clone t) pname pty r "float" acc st)
                  (= tg 11) (param-scalar (clone t) pname pty r "i1" acc st)
                  (= tg 12) (param-scalar (clone t) pname pty r "ptr" acc st)
                  (< tg 12) (param-scalar t pname pty r (ll-scalar pty) acc st)
                  (ET2Res (do (cg-fail-i "unresolved type parameter in params") st) "" ""))))))))))

(defn defn-ret-ll [ret :- Ty mdl :- &Mdl] :- str
  (let [tg (ty-tag ret)]
    (cond
      (= tg 9) "double"
      (= tg 10) "float"
      (= tg 11) "i1"
      (= tg 12) "ptr"
      (= tg 15) "%VecI64"
      (= tg 16)
      (if (= (md-owns-at mdl (ty-arg ret)) 1)
        "ptr"
        (str "%" (md-adt-name mdl (ty-arg ret))))
      (< tg 12) (ll-scalar ret)
      "i64")))

(defn emit-plain [name :- i64 params :- PList ret :- Ty body :- HExpr
                  st :- Emit] :- EDRes
  (match st
    (Emit [c mdl sigs]
      (let [nm-str (md-sym mdl name)
            fname (mangle nm-str)
            ismain (= nm-str "main")]
        (match (defn-params params st "")
          (ET2Res [st1 pstr _]
            (let [ps2 (if ismain
                        (if (> (count pstr) 0)
                          (str pstr ", i32 %argc, ptr %argv")
                          (str pstr "i32 %argc, ptr %argv"))
                        pstr)]
              (match (defn-body ismain (clone ret) body st1)
                (ET2Res [st2 bres _]
                  (match st2
                    (Emit [c2 m2 s2]
                      (let [ret-ll (if ismain
                                     "i32"
                                     (defn-ret-ll ret m2))
                            header (str "define " ret-ll " @" fname "(" ps2 ") {\n")
                            tail (if ismain "\n  ret i32 0\n}\n" "\n}\n")]
                        (EDRes (Emit (fn-new) m2 s2)
                              (fn-text header c2 tail))))) ))) ))))))

(defn defn-body [ismain :- bool ret :- Ty body :- HExpr st :- Emit] :- ET2Res
  (if ismain
    (let [st1 (em-line st "  call void @cato_args_init(i32 %argc, ptr %argv)")
          forms (match body
                  (HSeq [es] es)
                  (_ (HECons (clone body) (HENil))))]
      (ET2Res (emit-stmts forms st1) "" ""))
    (let [tg (ty-tag ret)]
      (cond
        (= tg 15)
        (match (emit-vec-pair body st)
          (EVRes [st1 p l el]
            (match (em-ins2 st1
                     (str "~ = insertvalue %VecI64 undef, ptr " p ", 0")
                     (str "~ = insertvalue %VecI64 ^1, i64 " l ", 1"))
              (ET2Res [st2 s0 s1]
                (let [st3 (em-line st2 (str "  ret %VecI64 " s1))]
                  (ET2Res st3 "" "")) ))))

        (= tg 16)
        (let [ai (ty-arg ret)
              boxed (em-boxed-at st ai)]
          (match (emit-adt body st)
            (ESRes [st1 v]
              (if (= boxed 1)
                (let [st2 (em-line st1 (str "  ret ptr " v))]
                  (ET2Res st2 "" ""))
                (let [nm (em-adt-name st1 ai)]
                  (match (em-ins st1 (str "~ = load %" nm ", ptr " v ", align 8"))
                    (ETRes [st2 lv]
                      (let [st3 (em-line st2 (str "  ret %" nm " " lv))]
                        (ET2Res st3 "" "")))))))))

        (match (emit-typed body (clone ret) st)
            (ESRes [st1 v]
              (let [ret-ll (cond
                             (= tg 11) "i1"
                             (= tg 12) "ptr"
                             (< tg 12) (ll-scalar ret)
                             "i64")
                    st2 (em-line st1 (str "  ret " ret-ll " " v))]
                (ET2Res st2 "" ""))))))))

(defn lambda-ll [ty :- Ty] :- str
  (let [tg (ty-tag ty)]
    (cond
      (= tg 9) "double"
      (= tg 10) "float"
      (= tg 11) "i1"
      (= tg 12) "ptr"
      (< tg 12) (ll-scalar ty)
      (do (cg-fail-i "lambda param type not supported") "i64"))))

(defn lambda-ret-ll [ret :- Ty] :- str
  (let [tg (ty-tag ret)]
    (cond
      (= tg 9) "double"
      (= tg 10) "float"
      (= tg 11) "i1"
      (= tg 12) "ptr"
      (< tg 12) (ll-scalar ret)
      (do (cg-fail-i "lambda ret type not supported") "i64"))))

(defn lambda-params [ps :- PList mdl :- &Mdl] :- str
  (match ps
    (PNil [] "")
    (PCons [h t]
      (match h
        (Param [pname pty _pb]
          (str ", " (lambda-ll pty) " %" (mangle (md-sym mdl pname))
               (lambda-params t mdl)))))))

(defn lambda-bind-params [ps :- PList st :- Emit] :- EURes
  (match ps
    (PNil [] (EURes st))
    (PCons [h t]
      (match h
        (Param [pname pty _pb]
          (match st
            (Emit [c mdl sigs]
              (let [r (str "%" (mangle (md-sym mdl pname)))]
                (match (lambda-bind-params t (em-sc-put st pname r pty))
                  (EURes [st2] (EURes st2)))))))))))

(defn lambda-cap-vec-word [at :- i64 k :- i64 slot :- str st :- Emit] :- EURes
  (match (em-ins3 st
           (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
           (str "~ = load i64, ptr ^1, align 8")
           (str "~ = getelementptr inbounds %VecI64, ptr " slot ", i32 0, i32 " k))
    (ET3Res [st1 f raw dst]
      (if (= k 0)
        (match (em-ins st1 (str "~ = inttoptr i64 " raw " to ptr"))
          (ETRes [st2 p]
            (EURes (em-line st2 (str "  store ptr " p ", ptr " dst ", align 8")))))
        (EURes (em-line st1 (str "  store i64 " raw ", ptr " dst ", align 8")))))))

(defn lambda-cap-clo-word [at :- i64 k :- i64 slot :- str st :- Emit] :- EURes
  (match (em-ins4 st
           (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
           (str "~ = load i64, ptr ^1, align 8")
           (str "~ = getelementptr inbounds %Closure, ptr " slot ", i32 0, i32 " k)
           (str "~ = inttoptr i64 ^2 to ptr"))
    (ET4Res [st1 f raw dst p]
      (EURes (em-line st1 (str "  store ptr " p ", ptr " dst ", align 8"))))))

(deftype EPR2 (EPR2 [st :- Emit v :- str]))

(defn lambda-load-caps [cs :- Caps at :- i64 st :- Emit] :- ET2Res
  (match cs
    (CNil [] (ET2Res st (str at) ""))
    (CCons [cname ty own next]
      (match st
        (Emit [c mdl sigs]
          (let [tg (ty-tag ty)]
            (cond
              (= tg 15)
              (match (em-temp st)
                (ETRes [st1 slot]
                  (let [st2 (em-pre st1 (str slot " = alloca %VecI64, align 8"))]
                    (match (lambda-cap-vec-word at 0 slot st2)
                      (EURes [st3]
                        (match (lambda-cap-vec-word (+ at 1) 1 slot st3)
                          (EURes [st4]
                            (match (lambda-cap-vec-word (+ at 2) 2 slot st4)
                              (EURes [st5]
                                (match (lambda-load-caps (clone next) (+ at 3) (em-gr-put st5 cname slot (vec-elem-of ty)))
                                  (ET2Res [st6 at6 _] (ET2Res st6 at6 "") )))))))))))

              (= tg 17)
              (match (em-temp st)
                (ETRes [st1 slot]
                  (let [st2 (em-pre st1 (str slot " = alloca %Closure, align 8"))]
                    (match (lambda-cap-clo-word at 0 slot st2)
                      (EURes [st3]
                        (match (lambda-cap-clo-word (+ at 1) 1 slot st3)
                          (EURes [st4]
                            (match (lambda-cap-clo-word (+ at 2) 2 slot st4)
                              (EURes [st5]
                                (match (lambda-load-caps (clone next) (+ at 3) (em-sc-put st5 cname slot ty))
                                  (ET2Res [st6 at6 _] (ET2Res st6 at6 "") )))))))))))

              (= tg 11)
              (match (em-ins2 st
                       (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
                       (str "~ = load i8, ptr ^1, align 8"))
                (ET2Res [st1 f v]
                  (match (em-ins st1 (str "~ = trunc i8 " v " to i1"))
                    (ETRes [st2 b]
                      (match (lambda-load-caps (clone next) (+ at 1) (em-sc-put st2 cname b ty))
                        (ET2Res [st3 at3 _] (ET2Res st3 at3 "") )))) ))

              (match (em-ins2 st
                         (str "~ = getelementptr inbounds i64, ptr %env, i64 " at)
                         (str "~ = load i64, ptr ^1, align 8"))
                  (ET2Res [st1 f raw]
                    (let [r2 (cond
                               (= tg 12)
                               (match (em-ins st1 (str "~ = inttoptr i64 " raw " to ptr"))
                                 (ETRes [st3 p] (EPR2 st3 p)))
                               (= tg 16)
                               (match (em-ins st1 (str "~ = inttoptr i64 " raw " to ptr"))
                                 (ETRes [st3 p] (EPR2 st3 p)))
                               (EPR2 st1 raw))]
                      (match r2
                        (EPR2 [st3 v]
                          (match (lambda-load-caps next (+ at (capture-slots ty)) (em-sc-put st3 cname v ty))
                            (ET2Res [st4 at4 _] (ET2Res st4 at4 "") ))))) )))))))))

(defn lambda-body [mname :- str caps :- Caps params :- PList ret :- Ty
                   body :- HExpr st :- Emit] :- ET2Res
  (match (lambda-bind-params params st)
    (EURes [st1]
      (match (lambda-load-caps caps 1 st1)
        (ET2Res [st2 at2 _]
          (match (emit-typed body (clone ret) st2)
            (ESRes [st3 v]
              (let [ll (lambda-ret-ll ret)
                    st4 (if (= ll "double")
                          (em-line st3 (str "  %retv = fadd double " v ", 0.000000e+00"))
                          (if (= ll "i1")
                            (em-line st3 (str "  %retv = xor i1 " v ", false"))
                            (em-line st3 (str "  %retv = add " ll " " v ", 0"))))]
                (ET2Res st4 "" "")))) )))))

(defn emit-lambda-pair [mangled :- i64 caps :- Caps params :- PList ret :- Ty
                        body :- HExpr mdl :- Mdl sigs :- ESigTab] :- ELPR
  (let [mname (md-sym mdl mangled)
        st0 (Emit (fn-new) mdl sigs)]
    (match (lambda-body mname (clone caps) (clone params) (clone ret)
                        body st0)
      (ET2Res [st1 btext _]
        (match st1
          (Emit [c1 m1 s1]
            (let [ret-ll (lambda-ret-ll ret)
                  header (str "define " ret-ll " @" mname
                              "(ptr noalias nocapture readonly %env"
                              (lambda-params params m1) ") {\n")
                  text (fn-text header c1 (str "\n  ret " ret-ll " %retv\n}\n"))
                  dt (lambda-drop-text mname caps (clone m1))]
              (ELPR m1 text dt)))) ))))

(defn emit-lams [ls :- Lams st :- Emit out :- EOut] :- EORes
  (match ls
    (LMNil [] (EORes st out))
    (LMCons [h t]
      (match h
        (Lam [mangled caps params ret body]
          (match st
            (Emit [c mdl sigs]
              (match (emit-lambda-pair mangled caps params
                                       ret body mdl (clone sigs))
                (ELPR [mdl2 text drop-text]
                  (emit-lams t (Emit (fn-new) mdl2 sigs)
                             (EOut (sb-add-line
                                    (sb-add-line
                                      (sb-add-line (out2-sb out) text)
                                      drop-text)
                                    ""))))))))))))

(deftype ECapSlot (ECapSlot [ty :- Ty own :- i64 off :- i64 bit :- i64]))
(deftype ECapSlots (CSxNil) (CSxCons [h :- ECapSlot t :- ECapSlots]))

(defn caps-with-slots [cs :- Caps at :- i64 bit :- i64] :- ECapSlots
  (match cs
    (CNil [] (CSxNil))
    (CCons [name ty own next]
      (CSxCons (ECapSlot ty own at bit)
               (caps-with-slots next (+ at (capture-slots ty)) (+ bit 1))))))

(defn lambda-drop-one [ty :- Ty off :- i64 mdl :- &Mdl] :- str
  (let [tg (ty-tag ty)]
    (cond
      (= tg 12)
      (str "  %fp" off " = getelementptr inbounds i64, ptr %env, i64 " off "\n"
           "  %fv" off " = load ptr, ptr %fp" off ", align 8\n"
           "  call void @free(ptr %fv" off ")\n")

      (= tg 15)
      (str "  %vp" off " = getelementptr inbounds i64, ptr %env, i64 " off "\n"
           "  %vv" off " = load ptr, ptr %vp" off ", align 8\n"
           (if (= (ty-arg ty) 2)
             (str "  %vn" off " = getelementptr inbounds i64, ptr %env, i64 " (+ off 1) "\n"
                  "  %vc" off " = load i64, ptr %vn" off ", align 8\n"
                  "  call void @cato_str_vec_free(ptr %vv" off ", i64 %vc" off ")\n")
             (str "  call void @free(ptr %vv" off ")\n")))

      (= tg 16)
      (let [j (ty-arg ty)]
        (if (= (md-owns-at mdl j) 1)
          (let [nm (md-adt-name mdl j)]
            (str "  %cp" off " = getelementptr inbounds i64, ptr %env, i64 " off "\n"
                 "  %cv" off " = load ptr, ptr %cp" off ", align 8\n"
                 "  call void @drop__" nm "(ptr %cv" off ")\n"))
          ""))

      (= tg 17)
      (str "  %ep" off " = getelementptr inbounds i64, ptr %env, i64 " (+ off 1) "\n"
           "  %ev" off " = load ptr, ptr %ep" off ", align 8\n"
           "  %dp" off " = getelementptr inbounds i64, ptr %env, i64 " (+ off 2) "\n"
           "  %dv" off " = load ptr, ptr %dp" off ", align 8\n"
           "  call void %dv" off "(ptr %ev" off ")\n")

      "")))

(defn lambda-drop-caps [slots :- ECapSlots label :- i64 mdl :- &Mdl] :- str
  (match slots
    (CSxNil [] "")
    (CSxCons [h t]
      (match h
        (ECapSlot [ty own off bit]
          (let [mask (str "%m" label)
                cond (str "%c" label)
                free-l (str "own" label)
                done-l (str "done" label)
                own-blk (lambda-drop-one ty off mdl)]
            (str "  " mask " = and i64 %bm, " (shl1 bit) "\n"
                 "  " cond " = icmp ne i64 " mask ", 0\n"
                 "  br i1 " cond ", label %" free-l ", label %" done-l "\n"
                 free-l ":\n"
                 own-blk
                 "  br label %" done-l "\n"
                 done-l ":\n"
                 (lambda-drop-caps t (+ label 1) mdl))))))))

(defn lambda-drop-text [mname :- str caps :- Caps mdl :- Mdl] :- str
  (let [head (str "define void @drop__" mname "(ptr %env) {\nentry:\n  %bm = load i64, ptr %env\n")]
    (str head
         (lambda-drop-caps (caps-with-slots caps 1 0) 0 mdl)
         "  call void @free(ptr %env)\n  ret void\n}\n")))
; cli.cato — S8 kernel CLI.
;
; Concatenated after the lib, reader, hir and emit files (one namespace;
; this file defines the only `main`). The skeleton per the roadmap:
;
;   cato1 build <file.cato> [out] [runtime.c]
;
; read → compile → write <out>.ll → spawn cc → native binary, with real
; exit codes: 0 success, 1 compile error or cc failure, 2 usage error.
; The output path defaults to the input's stem ("slice.cato" → "slice")
; and the runtime to `runtime/runtime.c` relative to the working
; directory. Both are positional (no flag parsing in the skeleton); the
; C compiler runs through the `system` extern with the wait status
; decoded by an arithmetic shift — the interp models system with the
; same convention, so the driver runs identically under `cato run`
; (the bootstrap's engine room until the seed's emitter is fixed) and
; natively once cato1 exists.

(extern system [cmd :- str] :- i64)

; The exit code of a libc system() wait status (-1 means the shell did
; not run at all, which must not decode to success).
(defn exit-of [status :- i64] :- i64
  (if (= status -1) -1 (/ status 256)))

; The reader entry shared with the S6/S7 drivers (the _ref files are not
; part of this concat): the scan is seeded with the pre-interned table.
(defn read-all-with [src :- str tab :- i64] :- RRes
  (scan src 0 1 0 0 1 0 (RSNil) (KNil) tab))

(defn usage [] :- i64
  (do
    (print-str "cato1: usage: cato1 build <file.cato> [out] [runtime.c]")
    2))

; "slice.cato" -> "slice" (the seed's default_stem for the .cato suffix).
(defn stem-of [p :- str] :- str
  (if (and (> (count p) 5)
           (= (subs p (- (count p) 5) (count p)) ".cato"))
    (subs p 0 (- (count p) 5))
    p))

; The compile pipeline through the emitted LLVM IR text: an empty result
; means the pipeline failed and the message is on stdout already.
(defn compile-to-ir [path :- str] :- str
  (let [src (slurp path)
        r (read-all-with src (magic-table))]
    (match r
      (ROk [forms tab]
        (match (expand-all forms (KNil))
          (EOk [xforms] (compile-build tab xforms))
          (EErr [msg at]
            (do (print-string (str "err " (spat at) " " msg)) ""))))
      (RErr [msg at]
        (do (print-string (str "err " (spat at) " " msg)) "")))))

(defn compile-build [tab :- i64 forms :- Asts] :- str
  (match (build-program forms tab)
    (PErr [msg] (do (print-string (str "err " msg)) ""))
    (POk [tab2 adts defs lams sigs]
      (let [facts (do (facts-compute (adts-templates (clone adts))))]
        (match (check-program defs lams facts (clone tab2) (clone adts))
          (CKErr [msg] (do (print-string (str "err " msg)) ""))
          (CKOk [defs2 lams2]
            (emit-program adts defs2 lams2 sigs tab2)))))))

(defn build-cmd [a :- (Vector str)] :- i64
  (if (< (count a) 2)
    (usage)
    (let [path (get a 1 "")
          out (if (> (count a) 2) (get a 2 "") (stem-of path))
          rt (if (> (count a) 3) (get a 3 "") "runtime/runtime.c")
          ir (compile-to-ir path)]
      (if (= (count ir) 0)
        1
        (let [ll (str out ".ll")]
          (do
            (spit ll ir)
            (let [status (system (str "clang -O2 " ll " " rt " -o " out))]
              (if (= (exit-of status) 0)
                0
                (do (print-string (str "cato1: cc failed (exit " (exit-of status) ")")) 1)))))))))

(defn main []
  (let [a (args)
        cmd (get a 0 "")]
    (exit (if (= cmd "build")
      (build-cmd a)
      (usage)))))
