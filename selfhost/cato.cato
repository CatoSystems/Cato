    (HNot [_] (HENil))
    (HAbs [_ _] (HENil))
    (HMin [_ _ _] (HENil))
    (HMax [_ _ _] (HENil))
    (HSeq [_] (HENil))
    (HLet [_ _ _] (HENil))
    (HLoop [_ _ _] (HENil))
    (HCtor [_ _ _] (HENil))
    (HMatch [_ _ _] (HENil))
    (HClone [_] (HENil))
    (HDrop [_] (HENil))
    (HClosure [_ _ _ _ _] (HENil))
    (HClosureCall [_ _ _] (HENil))
    (HCall [_ _] (HENil))
    (HSlurp [_] (HENil))
    (HSpit [_ _] (HENil))
    (HArgs [] (HENil))
    (HExit [_] (HENil))
    (HParseNum [_ _ _] (HENil))))

